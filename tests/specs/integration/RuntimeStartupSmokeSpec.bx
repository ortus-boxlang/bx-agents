/**
 * M13 - Runtime Startup Smoke Test (End-to-End).
 *
 * No new production code here - this is the integration harness proving the
 * generated app actually works: build -> load the generated
 * GeneratedAgentFactory.bx directly (the same mechanism the `chat` CLI verb
 * uses) -> aiModel()/aiAgent() construction -> a real agent.run() call
 * against bx-ai's built-in "mock" provider (no network, no API key).
 *
 * Scope note: the full plan called for booting under a real ColdBox +
 * MiniServer and hitting an HTTP route. Neither is available in this
 * sandbox - `boxlang-miniserver` isn't on PATH and has no downloadable
 * artifact (confirmed this session; building it from source pulls in a
 * BoxLang 1.17.0 dependency chain this module doesn't otherwise need), and
 * a real ColdBox boot needs `coldbox.system.Bootstrap` on the classpath,
 * which this module's own build doesn't fetch. What IS verified here, live,
 * is everything up to that boundary: the generated code genuinely runs
 * against real bx-ai BIFs, not just structurally-correct-looking source
 * text. The "boots under MiniServer" / "same WireBox singleton serves both
 * chat and HTTP" / "scheduled task fires" assertions are deferred - see the
 * skipped specs below for exactly what's still open and why.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "Runtime startup smoke test (slow/e2e lane)", function() {

			beforeEach( function() {
				variables.pipeline = new bxagents.models.build.BuildPipeline( "e2e-test" );
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempProject( required string fixtureName ) {
				var dir = createTempDirectory( prefix = "bxagents-e2e-" );
				directoryCopy( fixtures & "/" & arguments.fixtureName, dir, true );
				tempDirs.append( dir );
				return dir;
			}

			private function loadFactory( required string appDir ) {
				var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext();
				return createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
					.instantiate( arguments.appDir & "/agent/GeneratedAgentFactory.bx", context );
			}

			it( "builds a real agent via the generated factory and gets a live (mock-provider) response - no network call", function() {
				var projectRoot = newTempProject( "e2e-smoke" );
				var result = pipeline.build( projectRoot );

				// Loaded via DynamicClassLoader (same mechanism as the `chat` CLI
				// verb) rather than through Application.bx - deliberately: the
				// generated Application.bx unconditionally boots ColdBox on any
				// template execution in its directory, which isn't available here.
				var factory = loadFactory( result.appDir );
				var agent = factory.buildAgent();

				expect( len( agent.getName() ) ).toBeGT( 0 );

				var response = agent.run( "Hello there!" );
				expect( len( response ) ).toBeGT( 0 );
			} );

			it( "resolves a model provider's API key from an env var at runtime only - it never appears in the packaged .bxa", function() {
				var projectRoot = newTempProject( "full-project" );
				var envVarName = "OPENAI_API_KEY";
				var secretValue = "sk-test-#createUUID()#";

				// getSystemSetting() (used by bx-ai's own aiService.bx convention
				// key lookup) checks Java system properties before OS env vars -
				// a real OS env var can't be planted from inside a running JVM,
				// but a system property is read the exact same way.
				var javaSystem = createObject( "java", "java.lang.System" );
				var previousValue = javaSystem.getProperty( envVarName );

				try {
					javaSystem.setProperty( envVarName, secretValue );

					var result = pipeline.build( projectRoot );
					var factory = loadFactory( result.appDir );
					var agent = factory.buildAgent();

					expect( len( agent.getName() ) ).toBeGT( 0 );

					var packager = new bxagents.models.build.PackagerService();
					var packageResult = packager.package(
						projectRoot = projectRoot,
						appDir      = result.appDir,
						distDir     = projectRoot & "/dist",
						manifest    = result.manifest,
						baseName    = "e2e-secret-test-1.0.0"
					);

					var bxaBytes = fileRead( packageResult.bxa, "iso-8859-1" );
					expect( bxaBytes ).notToInclude( secretValue );
				} finally {
					if ( isNull( previousValue ) ) {
						javaSystem.clearProperty( envVarName );
					} else {
						javaSystem.setProperty( envVarName, previousValue );
					}
				}
			} );

			xit( "boots the generated app under boxlang-miniserver and gets a 200 on a health/gateway route - SKIPPED: boxlang-miniserver isn't installed and has no downloadable artifact in this environment (confirmed this session against forgebox/ortussolutions downloads; building it from source needs a BoxLang 1.17.0 dependency chain this module doesn't otherwise pull in)", function() {} );

			xit( "a sub-minute test-cron schedule actually fires within a short poll window - SKIPPED: needs a live ColdBox Scheduler running under a real ColdBox boot, which needs coldbox-platform on the classpath (not fetched by this module's build)", function() {} );

			xit( "the CLI chat REPL and a serve-launched HTTP route reach the same underlying agent singleton via WireBox - SKIPPED: needs a live ColdBox+WireBox container, same constraint as above", function() {} );

		} );
	}

}
