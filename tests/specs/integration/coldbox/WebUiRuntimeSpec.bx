/**
 * Real-boot integration coverage for the web UI's SQLite store and its qb
 * wiring.
 *
 * Everything else about the web UI is asserted against GENERATED SOURCE TEXT.
 * That proves the right characters were written; it cannot prove the app
 * boots, that WireBox resolves ChatDb, that qb is a registered ColdBox module,
 * that bx-sqlite's driver is real, or that the schema lands in an actual
 * database file. This file closes exactly that gap - it runs inside a request
 * served by the generated app's own Application.bx, so every assertion below
 * is against a genuinely booted ColdBox instance backed by real SQLite.
 *
 * Deliberately does NOT drive the routes over loopback HTTP. An earlier
 * revision did, and it deadlocked: this spec is itself executing inside a
 * request served by the same single miniserver, so calling back into
 * 127.0.0.1 waits on a worker that this very request is occupying. CI showed
 * it as `runner-coldbox.bxm never responded: HTTP 408` while the app was
 * demonstrably up (its scheduler was ticking throughout). Handler actions are
 * therefore exercised through the controller's own event execution, and the
 * store through its real object - neither needs a second connection.
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll(){
		variables.controller = application.cbController;
	}

	function run() {
		describe( "The web UI's store and wiring, against a real ColdBox boot", function() {

			it( "registered qb as a real module and resolves its builders", function() {
				// A bare class-path mapping is not enough - these aliases only
				// exist once ColdBox has ACTIVATED qb as a module. If the
				// integration runner failed to install it, this is where it shows.
				var binder = controller.getWireBox().getBinder();
				expect( binder.mappingExists( "SchemaBuilder@qb" ) ).toBeTrue();
				expect( binder.mappingExists( "QueryBuilder@qb" ) ).toBeTrue();
			} );

			it( "built ChatDb through WireBox and migrated at startup", function() {
				// The generated WebUiSchema interceptor builds ChatDb during
				// afterConfigurationLoad. Reaching this line at all means boot did
				// not blow up on a missing driver or an unresolvable mapping.
				expect( controller.getWireBox().getBinder().mappingExists( "ChatDb" ) ).toBeTrue();

				var db = controller.getWireBox().getInstance( "ChatDb" );
				expect( db.getDatasource() ).toBe( "bxagentse2e" );
				// migrate() is idempotent: it reports the current version rather
				// than re-running or throwing
				expect( db.migrate() ).toBeGTE( 1 );
				expect( db.migrate() ).toBeGTE( 1 );
			} );

			it( "created the real tables through qb's SchemaBuilder", function() {
				var db     = controller.getWireBox().getInstance( "ChatDb" );
				var schema = controller.getWireBox().getInstance( "SchemaBuilder@qb" );
				var opts   = { datasource: db.getDatasource() };

				expect( schema.hasTable( name: "conversations", options: opts ) ).toBeTrue();
				expect( schema.hasTable( name: "preferences", options: opts ) ).toBeTrue();
				expect( schema.hasTable( name: "bxagents_schema_version", options: opts ) ).toBeTrue();
			} );

			it( "round-trips a conversation through the real database", function() {
				var db     = controller.getWireBox().getInstance( "ChatDb" );
				var userId = "e2e-user-" & createUUID();
				var convId = "e2e-conv-" & createUUID();

				expect( db.touchConversation( userId, convId, "First message wins", 2 ) ).toBeTrue();

				var mine = db.listConversations( userId );
				expect( mine.len() ).toBe( 1 );
				expect( mine[ 1 ].title ).toBe( "First message wins" );
				expect( mine[ 1 ].messageCount ).toBe( 2 );

				// A later turn bumps the count but must NOT overwrite a title
				db.touchConversation( userId, convId, "should not replace", 2 );
				expect( db.getConversation( userId, convId ).title ).toBe( "First message wins" );
				expect( db.getConversation( userId, convId ).messageCount ).toBe( 4 );

				expect( db.renameConversation( userId, convId, "Renamed" ) ).toBeTrue();
				expect( db.getConversation( userId, convId ).title ).toBe( "Renamed" );

				db.resetConversationCount( userId, convId );
				expect( db.getConversation( userId, convId ).messageCount ).toBe( 0 );

				expect( db.deleteConversation( userId, convId ) ).toBeTrue();
				expect( db.listConversations( userId ).len() ).toBe( 0 );
			} );

			it( "refuses to let one user take over another's conversation", function() {
				// touchConversation() is deliberately not a qb upsert: an upsert
				// targets the primary key alone, so a guessed conversationId would
				// rewrite that row's userId. Proven here against real SQLite.
				var db     = controller.getWireBox().getInstance( "ChatDb" );
				var owner  = "owner-" & createUUID();
				var thief  = "thief-" & createUUID();
				var convId = "shared-" & createUUID();

				db.touchConversation( owner, convId, "Owned", 2 );

				expect( db.touchConversation( thief, convId, "Stolen", 2 ) ).toBeFalse();
				expect( db.renameConversation( thief, convId, "Stolen" ) ).toBeFalse();
				expect( db.deleteConversation( thief, convId ) ).toBeFalse();

				expect( db.getConversation( owner, convId ).title ).toBe( "Owned" );
				expect( db.listConversations( thief ).len() ).toBe( 0 );
			} );

			it( "upserts a preference instead of duplicating it", function() {
				// setPreference() CAN upsert safely - its target is the
				// ( userId, prefKey ) composite key, so the caller's own identity
				// is part of what it matches on.
				var db     = controller.getWireBox().getInstance( "ChatDb" );
				var userId = "prefs-" & createUUID();

				db.setPreference( userId, "theme", "dark" );
				expect( db.getPreferences( userId ).theme ).toBe( "dark" );

				db.setPreference( userId, "theme", "light" );
				expect( db.getPreferences( userId ).theme ).toBe( "light" );
				// Overwritten, not duplicated
				expect( db.getPreferences( userId ).count() ).toBe( 1 );

				db.deletePreference( userId, "theme" );
				expect( db.getPreferences( userId ) ).toBeEmpty();
			} );

			it( "runs the generated ChatUi handler through the real controller", function() {
				// Proves the handler class resolves and executes under a real boot -
				// not just that the right source text was generated. /health and
				// /info are used because they read no request body.
				var health = controller.runEvent( event: "ChatUi.health", prePostExempt: true );
				expect( isNull( health ) ).toBeFalse();

				var info = controller.runEvent( event: "ChatUi.info", prePostExempt: true );
				expect( isNull( info ) ).toBeFalse();
			} );

			it( "generated the static chat shell with every placeholder substituted", function() {
				// Read from disk rather than fetched over HTTP - see this file's
				// docblock on why loopback requests deadlock here.
				var shell = expandPath( "/" ) & "chat/index.html";
				expect( fileExists( shell ) ).toBeTrue();

				var html = fileRead( shell );
				expect( html ).toInclude( "/chat/api" );
				expect( html ).notToInclude( "__API_BASE__" );
				expect( html ).notToInclude( "__WELCOME__" );
			} );

		} );
	}

}
