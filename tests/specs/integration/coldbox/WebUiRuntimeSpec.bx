/**
 * Real-boot integration coverage for the web UI's own API, its SQLite store,
 * and qb.
 *
 * Everything else about the web UI is asserted against GENERATED SOURCE TEXT -
 * useful, but it can only prove the right characters were written, never that
 * the app boots, that WireBox resolves ChatDb/qb, that bx-sqlite's driver is
 * real, or that a route actually answers. This file closes that gap: it runs
 * inside a request served by the generated app's own Application.bx, so every
 * assertion below is against a genuinely booted ColdBox instance backed by a
 * real SQLite file.
 *
 * Runs over real HTTP against the same miniserver the sibling
 * ColdBoxRuntimeSpec.bx uses (see runColdBoxIntegrationTests.bxs), because the
 * point is to exercise the ROUTES, not the handler class in isolation.
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll(){
		variables.controller = application.cbController;
		// Same port runColdBoxIntegrationTests.bxs launches on. Requests loop
		// back into this very server, which is what makes them real.
		variables.base = "http://127.0.0.1:39280/chat/api";
	}

	private struct function callJson( required string path, string method = "GET", any body ) {
		var target = variables.base & arguments.path;
		var raw    = "";
		if ( arguments.method == "POST" ) {
			bx:http url=target method="POST" result="httpResult" timeout=30 {
				bx:httpparam type="header" name="Content-Type" value="application/json";
				bx:httpparam type="body" value=isNull( arguments.body ) ? "{}" : jsonSerialize( arguments.body );
			}
		} else {
			bx:http url=target method="GET" result="httpResult" timeout=30 {}
		}
		raw = httpResult.fileContent ?: "";
		return {
			status : httpResult.status_code ?: 0,
			body   : isJSON( raw ) ? jsonDeserialize( raw ) : {},
			raw    : raw
		};
	}

	function run() {
		describe( "The web UI's API, against a real ColdBox boot", function() {

			it( "resolves ChatDb through WireBox and migrated its schema at startup", function() {
				// The generated WebUiSchema interceptor builds ChatDb during
				// afterConfigurationLoad. If qb were not a registered ColdBox
				// module, or bx-sqlite's driver were missing, boot itself would
				// have failed - so reaching this line at all is part of the proof.
				expect( controller.getWireBox().getBinder().mappingExists( "ChatDb" ) ).toBeTrue();

				var db = controller.getWireBox().getInstance( "ChatDb" );
				expect( db.getDatasource() ).toBe( "bxagentse2e" );
				// migrate() is idempotent - it should report the current version,
				// not re-run or throw
				expect( db.migrate() ).toBeGTE( 1 );
			} );

			it( "created the real tables through qb's SchemaBuilder", function() {
				var db = controller.getWireBox().getInstance( "ChatDb" );
				var schema = controller.getWireBox().getInstance( "SchemaBuilder@qb" );
				var opts = { datasource: db.getDatasource() };

				expect( schema.hasTable( name: "conversations", options: opts ) ).toBeTrue();
				expect( schema.hasTable( name: "preferences", options: opts ) ).toBeTrue();
				expect( schema.hasTable( name: "bxagents_schema_version", options: opts ) ).toBeTrue();
			} );

			it( "answers /health and /info over a real route", function() {
				var health = callJson( "/health" );
				expect( health.status ).toBe( 200 );
				expect( health.body.success ?: false ).toBeTrue();

				var info = callJson( "/info" );
				expect( info.status ).toBe( 200 );
				expect( info.body.capabilities.conversations ?: false ).toBeTrue();
				expect( info.body.capabilities.preferences ?: false ).toBeTrue();
			} );

			it( "runs a real turn and records it in the conversation index", function() {
				var conversationId = "e2e-" & createUUID();

				var turn = callJson(
					path  : "/invoke",
					method: "POST",
					body  : { input: "Hello from the integration suite", options: { conversationId: conversationId } }
				);
				expect( turn.status ).toBe( 200 );

				// The turn should have created the conversation row AND titled it
				// from the first message
				var list = callJson( "/conversations" );
				expect( list.status ).toBe( 200 );

				var mine = list.body.conversations.filter( ( c ) => c.id == conversationId );
				expect( mine.len() ).toBe( 1 );
				expect( mine[ 1 ].title ).toInclude( "Hello from the integration suite" );
				expect( mine[ 1 ].messageCount ).toBeGT( 0 );
			} );

			it( "creates, renames and deletes a conversation over HTTP", function() {
				var created = callJson( path: "/conversations/create", method: "POST", body: { title: "Created by CI" } );
				expect( created.status ).toBe( 200 );

				var id = created.body.conversationId ?: "";
				expect( len( id ) ).toBeGT( 0 );

				var renamed = callJson( path: "/conversations/rename", method: "POST", body: { conversationId: id, title: "Renamed by CI" } );
				expect( renamed.status ).toBe( 200 );

				var afterRename = callJson( "/conversations" ).body.conversations.filter( ( c ) => c.id == id );
				expect( afterRename.len() ).toBe( 1 );
				expect( afterRename[ 1 ].title ).toBe( "Renamed by CI" );

				var deleted = callJson( path: "/conversations/delete", method: "POST", body: { conversationId: id } );
				expect( deleted.status ).toBe( 200 );

				var afterDelete = callJson( "/conversations" ).body.conversations.filter( ( c ) => c.id == id );
				expect( afterDelete.len() ).toBe( 0 );
			} );

			it( "404s a conversation that does not exist rather than pretending", function() {
				var missing = callJson(
					path  : "/conversations/rename",
					method: "POST",
					body  : { conversationId: "does-not-exist-" & createUUID(), title: "nope" }
				);
				expect( missing.status ).toBe( 404 );
			} );

			it( "round-trips a preference through the real store", function() {
				var saved = callJson( path: "/preferences/set", method: "POST", body: { key: "theme", value: "dark" } );
				expect( saved.status ).toBe( 200 );

				expect( callJson( "/preferences" ).body.preferences.theme ?: "" ).toBe( "dark" );

				// Upsert, not a second row - setting it again must overwrite
				callJson( path: "/preferences/set", method: "POST", body: { key: "theme", value: "light" } );
				expect( callJson( "/preferences" ).body.preferences.theme ?: "" ).toBe( "light" );

				callJson( path: "/preferences/delete", method: "POST", body: { key: "theme" } );
				expect( structKeyExists( callJson( "/preferences" ).body.preferences, "theme" ) ).toBeFalse();
			} );

			it( "serves history for the caller's own conversation", function() {
				var conversationId = "e2e-hist-" & createUUID();
				callJson(
					path  : "/invoke",
					method: "POST",
					body  : { input: "Remember this", options: { conversationId: conversationId } }
				);

				var history = callJson( "/history?conversationId=" & conversationId );
				expect( history.status ).toBe( 200 );
				expect( history.body.messages.len() ).toBeGT( 0 );
			} );

			it( "reports compaction honestly instead of claiming success", function() {
				// The fixture configures no summary model, so summarize() is a
				// no-op. The route must say so with real counts rather than
				// returning success and changing nothing - and must NOT 501,
				// which is what it did before bx-ai scoped summarize().
				var compact = callJson(
					path  : "/compact",
					method: "POST",
					body  : { options: { conversationId: "e2e-compact-" & createUUID() } }
				);
				expect( compact.status ).toBe( 200 );
				expect( compact.body ).toHaveKey( "compacted" );
				expect( compact.body ).toHaveKey( "before" );
				expect( compact.body ).toHaveKey( "after" );
			} );

			it( "serves the static chat shell itself", function() {
				bx:http url="http://127.0.0.1:39280/chat/index.html" method="GET" result="shell" timeout=30 {}
				expect( shell.status_code ).toBe( 200 );
				expect( shell.fileContent ).toInclude( "/chat/api" );
				// Every placeholder must have been substituted at generation time
				expect( shell.fileContent ).notToInclude( "__API_BASE__" );
			} );

		} );
	}

}
