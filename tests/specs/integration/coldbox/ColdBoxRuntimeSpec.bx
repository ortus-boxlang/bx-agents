/**
 * Real ColdBox integration tests for a generated BX Agents app - per
 * https://coldbox.ortusbooks.com/the-basics/testing-quick-start/integration-testing/http-testing-methods
 * and the reference tests/Application.bx at
 * https://github.com/coldbox-templates/boxlang/blob/development/tests/Application.bx.
 *
 * MUST be served from WITHIN the generated app's own webroot (the
 * `testColdBoxIntegration` Gradle task copies this bundle's runner
 * alongside a pre-built fixture and boots boxlang-miniserver pointed
 * directly at it), not via the CLI runTests.bxs/`testBx` task - confirmed
 * empirically this session: ColdBox's RoutingService needs a genuine `cgi`
 * scope even to load the router at startup, and BoxLang's CLI mode has no
 * `cgi` scope at all (only a real web request does).
 *
 * Deliberately does NOT use coldbox.system.testing.BaseTestCase's own
 * VirtualApp (a second, independently-mapped ColdBox instance) - tried
 * that first, but BaseTestCase's `appMapping` metadata only works cleanly
 * for a true-root app; pointed at a non-root mapping alias (needed since
 * the fixture lives at a fixed path outside the test webroot), WireBox's
 * own dotted-class-path resolution for `to("agent.GeneratedAgentFactory")`
 * couldn't find the class, a self-inflicted complication distinct from
 * anything BX Agents' generated code controls. Instead, this spec runs
 * INSIDE the request already-booted by the real app's own generated
 * Application.bx (the exact same one `serve` launches in production), and
 * just reads `application.cbController` - the real ColdBox controller
 * `Bootstrap.loadColdBox()` stores there - directly. More faithful to a
 * real deployment anyway: no second ColdBox instance, no mapping tricks.
 *
 * This one file's testing, done for real, caught three genuine bugs in
 * ColdBoxAppGenerator.bx - see the fixed-bugs note in each relevant test
 * below.
 *
 * Also closes two of the three RuntimeStartupSmokeSpec.bx `xit()`s that were
 * originally deferred for "needs coldbox-platform" reasons (which stopped
 * being true the moment this file's harness - a real ColdBox/miniserver
 * boot - existed): schedules/* registering with a live ColdBox Scheduler,
 * and chat's direct-load path being behaviorally equivalent to WireBox's
 * singleton. See those tests below, and RuntimeStartupSmokeSpec.bx's own
 * updated notes on all three.
 */
class extends="testbox.system.BaseSpec" {

	/**
	 * Bundle-level hook (BDDRunner.cfc checks `structKeyExists(target, "beforeAll")`
	 * on the class ITSELF, separately from any describe()-scoped
	 * `beforeAll(function(){...})` DSL call) - confirmed empirically this
	 * session that inside a real ColdBox request, relying on the
	 * describe()-scoped one alone left `variables.controller` unset by the
	 * time it() ran; setting it here directly is what actually works.
	 */
	function beforeAll(){
		variables.controller = application.cbController;
	}

	function run() {
		describe( "Real ColdBox boot of a generated BX Agents app", function() {

			/**
			 * Regression #1: config/WireBox.bx generated with no `extends`
			 * clause, so `map()` inside its configure() threw "Function
			 * [map] not found" the moment WireBox tried to load it - fixed
			 * by adding `extends="coldbox.system.ioc.config.Binder"` to the
			 * generated class (see ColdBoxAppGenerator.bx's renderWireBox()).
			 */
			it( "boots ColdBox for real and configures WireBox with the generated mappings", function() {
				expect( isObject( controller ) ).toBeTrue();
				expect( controller.getWireBox().getBinder().mappingExists( "GeneratedAgentFactory" ) ).toBeTrue();
				expect( controller.getWireBox().getBinder().mappingExists( "GeneratedAgent" ) ).toBeTrue();
			} );

			/**
			 * Regression #2: the generated Application.bx called
			 * `new coldbox.system.Bootstrap( COLDBOX_APP_ROOT_PATH, COLDBOX_APP_MAPPING, COLDBOX_CONFIG_MAPPING, COLDBOX_APP_KEY )`
			 * - positional arguments in the WRONG order relative to
			 * Bootstrap's real
			 * `init(COLDBOX_CONFIG_FILE, COLDBOX_APP_ROOT_PATH, COLDBOX_APP_KEY, COLDBOX_APP_MAPPING, ...)`
			 * signature. The app root path silently became the config-file
			 * override, so ColdBox tried to instantiate the literal
			 * filesystem path as a dotted class name the moment it loaded
			 * configuration - fixed by switching to named arguments in
			 * renderApplication().
			 *
			 * Regression #3: config/WireBox.bx's `GeneratedAgent` provider
			 * closure called a bare `getInstance(...)`, assumed (never
			 * source-verified before this session) to be a WireBox delegate
			 * the same way it is on `coldbox.system.web.routing.Router`.
			 * `coldbox.system.ioc.config.Binder` has no such delegate or
			 * method at all - confirmed against real source. It only failed
			 * once WireBox actually invoked the closure (lazily, building
			 * the singleton) with "Function [getInstance] not found", not
			 * at configure() time, which is why it was easy to miss. Fixed
			 * by calling `injector.getInstance(...)` instead - `injector`
			 * is the real WireBox Injector reference `Binder` itself uses
			 * internally for the exact same purpose.
			 */
			it( "builds the real GeneratedAgent singleton and gets a live (mock-provider) response", function() {
				var agent = controller.getWireBox().getInstance( "GeneratedAgent" );
				expect( len( agent.getName() ) ).toBeGT( 0 );

				var response = agent.run( "Hello there!" );
				expect( len( response ) ).toBeGT( 0 );
			} );

			/**
			 * Confirms schedules/* is wired into a REAL, live ColdBox Scheduler
			 * under a real boot - not just that config/Scheduler.bx contains the
			 * expected generated source text (SchedulerGeneratorSpec.bx already
			 * covers that). ColdBox's SchedulerService always registers the
			 * app's config/Scheduler.bx-derived scheduler under the fixed name
			 * "appScheduler@coldbox" (confirmed against real ColdBox source -
			 * coldbox/system/web/services/SchedulerService.cfc's
			 * loadGlobalScheduler()) - hasTask() there proves the "heartbeat"
			 * schedule (src/test/resources/fixtures/e2e-coldbox-route/schedules/heartbeat.bx,
			 * cron "* * * * *") is actually registered and live, not merely
			 * generated as text. Doesn't wait out a real minute-granularity fire
			 * (the coarsest interval schedules/ can express) - that would add a
			 * real ~60s+ tax to every CI run for marginal extra proof once the
			 * task is confirmed live and registered here.
			 */
			it( "registers the schedules/ entry with a live ColdBox Scheduler", function() {
				var schedulerService = controller.getSchedulerService();
				var appScheduler = schedulerService.getSchedulers()[ "appScheduler@coldbox" ];

				expect( appScheduler.hasTask( "heartbeat" ) ).toBeTrue();
			} );

			/**
			 * `chat` deliberately never boots ColdBox/WireBox at all - it loads
			 * agent/GeneratedAgentFactory.bx directly via the Java
			 * DynamicClassLoader helper (see Chat.bx), so it can never
			 * literally share WireBox's "GeneratedAgent" singleton OBJECT with
			 * an HTTP route. What actually has to hold - and what this proves
			 * for real - is that instantiating GeneratedAgentFactory OUTSIDE of
			 * WireBox produces a behaviorally equivalent agent (same name, a
			 * real response to the same prompt) to WireBox's own singleton, so
			 * `chat` and `serve` can never quietly diverge.
			 *
			 * Uses BoxLang's own `new` operator here rather than the
			 * DynamicClassLoader Java class `chat` itself uses - confirmed
			 * empirically this session that DynamicClassLoader (a bx-agents
			 * MODULE Java class) genuinely isn't on the classpath from inside
			 * a request served by a real `boxlang-miniserver` process:
			 * MiniServerLauncher.launch() spawns miniserver as `java -jar
			 * boxlang-miniserver-*.jar <config>` - its OWN separate JVM/
			 * classpath, not this module's. `chat` only has DynamicClassLoader
			 * available because it runs inside the SAME JVM as the bx-agents
			 * module (`boxlang module:bxAgents chat`). The property under test
			 * - instantiating the generated factory outside WireBox's
			 * singleton lifecycle still yields an equivalent agent - holds
			 * regardless of which mechanism performs that instantiation.
			 */
			it( "instantiating GeneratedAgentFactory outside of WireBox (the way chat's direct-load path does) builds a behaviorally-equivalent agent to WireBox's singleton", function() {
				var wireboxAgent = controller.getWireBox().getInstance( "GeneratedAgent" );

				var factory = new "agent.GeneratedAgentFactory"();
				var directAgent = factory.buildAgent();

				expect( directAgent.getName() ).toBe( wireboxAgent.getName() );
				expect( len( directAgent.run( "Hello there!" ) ) ).toBeGT( 0 );
			} );

			// NOTE: a real HTTP request against the /api/chat/invoke route
			// (registered by toAi()) is checked separately, in
			// runColdBoxIntegrationTests.bxs, not here - a request made
			// from *inside* this already-running request, against this
			// same single miniserver instance, risks deadlocking its
			// worker thread pool (confirmed empirically this session: the
			// whole suite timed out hard when tried this way). That check
			// only succeeds reliably because the test above already forced
			// WireBox to build the "GeneratedAgent" singleton first - the
			// very first request to a toAi() route on a freshly booted app
			// (nothing has built that singleton yet) can transiently fail
			// with "Function [getInstance] not found", a ColdBox/WireBox
			// lazy-injection race on the Router's own `getInstance`
			// delegate, not anything BX Agents' generated code controls.

		} );
	}

}
