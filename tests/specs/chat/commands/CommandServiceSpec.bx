/**
 * Commands run for a client with no terminal: the web page and anything over HTTP. On a real bx-ai agent
 * with memory and a real conversation list, the way the server builds them.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "CommandService", function() {

			beforeEach( function() {
				variables.dir = createTempDirectory( prefix = "bxagents-commands-" );
				variables.store = bxagents.models.store.ChatStore::forFile( dir & "/chat.db" );
				variables.sessions = new bxagents.models.store.SessionStore( store );
				variables.agent = aiAgent( name : "helper", model : aiModel( provider : "mock" ), memory : aiMemory( "cache" ) );
				variables.service = new bxagents.models.chat.commands.CommandService( agent, sessions );
			} );

			afterEach( function() {
				if ( directoryExists( dir ) ) {
					directoryDelete( dir, true );
				}
			} );

			function texts( required struct answer ) {
				return answer.blocks.filter( b => b.type == "text" ).map( b => b.text );
			}

			it( "offers the web commands, without the terminal-only ones", function() {
				var names = service.menu( "web" ).map( c => c.name );
				expect( names ).toInclude( "/info" );
				expect( names ).toInclude( "/fork" );
				expect( names ).notToInclude( "/copy" );
				expect( names ).notToInclude( "/exit" );
			} );

			it( "answers /info as a table about the agent, the caller and the conversation", function() {
				var answer = service.execute( "alice", "c-1", "/info" );

				expect( answer.success ).toBeTrue();
				expect( answer.conversationId ).toBe( "c-1" );
				var table = answer.blocks[ 1 ];
				expect( table.type ).toBe( "table" );
				expect( table.layout ).toBe( "keyvalue" );
				var rows = {};
				table.rows.each( r => rows[ r[ 1 ] ] = r[ 2 ] );
				expect( rows.Agent ).toBe( "helper" );
				expect( rows.Mode ).toBe( "server" );
				expect( rows.User ).toBe( "alice" );
				expect( rows.Conversation ).toBe( "c-1" );
				// where the database file is stays on the server
				expect( rows.keyExists( "Database" ) ).toBeFalse();
			} );

			it( "answers with data that goes through JSON unchanged", function() {
				var answer = service.execute( "alice", "c-1", "/info" );
				var again = jsonDeserialize( jsonSerialize( answer ) );
				expect( again.blocks[ 1 ].type ).toBe( "table" );
				expect( again.conversationId ).toBe( "c-1" );
			} );

			it( "starts a new conversation on /new and says which one to carry on in", function() {
				var answer = service.execute( "alice", "c-1", "/new" );

				expect( answer.conversationId ).notToBe( "c-1" );
				expect( answer.effects.map( e => e.type ) ).toBe( [ "reset", "conversation" ] );
				expect( answer.effects[ 2 ].id ).toBe( answer.conversationId );
			} );

			it( "lists the caller's conversations on /sessions and opens one on /resume", function() {
				sessions.touch( "alice", "c-1", "first question" );
				sessions.touch( "alice", "c-2", "second question" );
				sessions.touch( "bob", "c-3", "not alice's" );

				var listed = service.execute( "alice", "", "/sessions" );
				var rows = listed.blocks[ 1 ].rows;
				expect( rows ).toHaveLength( 2 );
				expect( rows.map( r => r[ 2 ] ).sort( "text" ) ).toBe( [ "first question", "second question" ] );

				var opened = service.execute( "alice", "", "/resume c-1" );
				expect( opened.conversationId ).toBe( "c-1" );
				expect( texts( opened )[ 1 ] ).toInclude( "Resumed: first question" );
			} );

			it( "will not open another person's conversation", function() {
				sessions.touch( "bob", "c-3", "not alice's" );
				var answer = service.execute( "alice", "", "/resume c-3" );
				expect( texts( answer )[ 1 ] ).toInclude( "There is no conversation" );
			} );

			it( "lists the notes in place on /notes, and keeps a note on /remember", function() {
				var noNotes = service.execute( "alice", "c-1", "/notes" );
				expect( texts( noNotes )[ 1 ] ).toInclude( "notes" );
			} );

			it( "does not run a terminal-only command, and says so", function() {
				var answer = service.execute( "alice", "c-1", "/copy" );
				expect( texts( answer )[ 1 ] ).toInclude( "not available here" );
			} );

			it( "will not switch the shared agent's model from a server", function() {
				var answer = service.execute( "alice", "c-1", "/profile fast" );
				expect( texts( answer )[ 1 ] ).toInclude( "not available here" );
				var model = service.execute( "alice", "c-1", "/model" );
				expect( texts( model )[ 1 ] ).toInclude( "Model:" );
				expect( texts( model ).filter( t => t.startsWith( "Type /profile" ) ) ).toBeEmpty();
			} );

			describe( "naming, forking and exporting a conversation", function() {

				beforeEach( function() {
					agent.run( "plan the launch", {}, { userId : "alice", conversationId : "c-1" } );
					sessions.touch( "alice", "c-1", "plan the launch" );
				} );

				it( "names a conversation on /name, in the list", function() {
					var answer = service.execute( "alice", "c-1", "/name Launch plan" );
					expect( texts( answer )[ 1 ] ).toBe( "Named: Launch plan" );
					expect( sessions.byId( "alice", "c-1" ).title ).toBe( "Launch plan" );
				} );

				it( "gives a conversation nobody spoke in yet its row when it is named", function() {
					var answer = service.execute( "alice", "c-new", "/name Draft" );
					expect( texts( answer )[ 1 ] ).toBe( "Named: Draft" );
					expect( sessions.byId( "alice", "c-new" ).title ).toBe( "Draft" );
				} );

				it( "asks for a name when /name has none, and will not rename somebody else's conversation", function() {
					expect( texts( service.execute( "alice", "c-1", "/name" ) )[ 1 ] ).toInclude( "Give it a name" );
					sessions.touch( "bob", "c-bob", "private" );
					expect( texts( service.execute( "alice", "c-bob", "/name Mine now" ) )[ 1 ] ).toBe( "That conversation belongs to someone else." );
					expect( sessions.byId( "bob", "c-bob" ).title ).toBe( "private" );
				} );

				it( "copies the whole conversation on /fork and moves to the copy, leaving the original as it was", function() {
					var before = agent.getMemoryMessages( "alice", "c-1" ).len();
					var answer = service.execute( "alice", "c-1", "/fork Other approach" );

					expect( answer.conversationId ).notToBe( "c-1" );
					expect( answer.effects[ 1 ] ).toBe( { type : "conversation", id : answer.conversationId, title : "Other approach" } );
					expect( agent.getMemoryMessages( "alice", answer.conversationId ) ).toHaveLength( before );
					expect( agent.getMemoryMessages( "alice", "c-1" ) ).toHaveLength( before );
					expect( sessions.byId( "alice", answer.conversationId ).title ).toBe( "Other approach" );

					// they carry on independently
					agent.run( "only in the copy", {}, { userId : "alice", conversationId : answer.conversationId } );
					expect( agent.getMemoryMessages( "alice", "c-1" ) ).toHaveLength( before );
				} );

				it( "names a fork after the original when no name is given, and has nothing to fork in an empty conversation", function() {
					var named = service.execute( "alice", "c-1", "/fork" );
					expect( sessions.byId( "alice", named.conversationId ).title ).toBe( "Fork of plan the launch" );

					var empty = service.execute( "alice", "c-empty", "/fork" );
					expect( texts( empty )[ 1 ] ).toInclude( "nothing to fork" );
					expect( empty.conversationId ).toBe( "c-empty" );
				} );

				it( "hands the conversation back as a file on /export, Markdown or HTML", function() {
					var md = service.execute( "alice", "c-1", "/export" );
					var file = md.blocks.filter( b => b.type == "file" )[ 1 ];
					expect( file.name ).toMatch( "^chat-\d{8}-\d{6}\.md$" );
					expect( file.mime ).toBe( "text/markdown" );
					expect( file.text ).toInclude( "plan the launch" );

					var html = service.execute( "alice", "c-1", "/export ../../secret/talk.html" ).blocks.filter( b => b.type == "file" )[ 1 ];
					expect( html.name ).toBe( "talk.html" );
					expect( html.mime ).toBe( "text/html" );
					expect( html.text ).toInclude( "<!doctype html>" );
				} );

				it( "has nothing to export in an empty conversation", function() {
					expect( texts( service.execute( "alice", "c-empty", "/export" ) ) ).toBe( [ "Nothing to export yet." ] );
				} );

			} );

			describe( "/ping", function() {

				beforeEach( function() {
					variables.settings = getModuleInfo( "bxai" ).settings;
					variables.saved = { profiles : settings.profiles ?: {}, provider : settings.provider ?: "" };
					settings.provider = "mock";
					settings.profiles = { fast : { provider : "mock", params : { model : "fast-model" } }, secret : { provider : "mock", params : { model : "secret-model" } } };
				} );

				afterEach( function() {
					settings.profiles = saved.profiles;
					settings.provider = saved.provider;
				} );

				it( "tests the server's own model", function() {
					expect( texts( service.execute( "alice", "c-1", "/ping" ) )[ 1 ] ).toMatch( "answered in \d+ ms" );
				} );

				it( "tests a profile the app offers, and refuses one it does not", function() {
					var offering = new bxagents.models.chat.commands.CommandService( agent : agent, sessions : sessions, offered : [ "fast" ] );
					var ok = offering.execute( "alice", "c-1", "/ping fast" ).blocks[ 1 ];
					expect( ok.style ).toBe( "ok" );
					expect( ok.text ).toInclude( "mock/fast-model answered" );

					var refused = offering.execute( "alice", "c-1", "/ping secret" ).blocks[ 1 ];
					expect( refused.style ).toBe( "warn" );
					expect( refused.text ).toInclude( "That profile is not offered here." );
				} );

			} );

			it( "works without a list of conversations", function() {
				var bare = new bxagents.models.chat.commands.CommandService( agent );
				expect( texts( bare.execute( "alice", "c-1", "/sessions" ) ) ).toBe( [ "No conversations yet." ] );
			} );

		} );
	}

}
