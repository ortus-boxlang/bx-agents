/**
 * A command only an admin may run, for the registry spec.
 */
class extends="bxagents.models.chat.commands.BaseCommand" {

	string function name() {
		return "secret"
	}

	string function permission() {
		return "admin"
	}

	any function run( required any context, required string args ) {
		return arguments.context.reply().text( "ran" )
	}

}
