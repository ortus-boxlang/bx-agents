class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.New", function() {

			beforeEach( function() {
				variables.verb = new bxagents.models.cli.New();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTargetDir() {
				var parent = createTempDirectory( prefix = "bxagents-cli-new-" );
				tempDirs.append( parent );
				return parent & "/my-agent";
			}

			it( "scaffolds a project and returns exitCode 0", function() {
				var dir = newTargetDir();
				var result = verb.run( { projectRoot : dir, model : "openai/gpt-5", skipInstall : true } );

				expect( result.exitCode ).toBe( 0 );
				expect( fileExists( dir & "/Agent.yaml" ) ).toBeTrue();
				expect( fileExists( dir & "/Agent.bx" ) ).toBeFalse();
			} );

			it( "scaffolds a class-based Agent.bx instead when --class is passed", function() {
				var dir = newTargetDir();
				var result = verb.run( { projectRoot : dir, model : "openai/gpt-5", skipInstall : true, "class" : true } );

				expect( result.exitCode ).toBe( 0 );
				expect( fileExists( dir & "/Agent.bx" ) ).toBeTrue();
				expect( fileExists( dir & "/Agent.yaml" ) ).toBeFalse();
			} );

			it( "derives the agent name from the target directory name when --name is omitted", function() {
				var dir = newTargetDir();
				verb.run( { projectRoot : dir, model : "openai/gpt-5", skipInstall : true } );

				var content = fileRead( dir & "/Agent.yaml" );
				expect( content ).toInclude( "name: my-agent" );

				var classDir = newTargetDir() & "-class";
				verb.run( { projectRoot : classDir, model : "openai/gpt-5", skipInstall : true, "class" : true } );
				var classContent = fileRead( classDir & "/Agent.bx" );
				expect( classContent ).toInclude( 'name        : "my-agent-class"' );
				expect( classContent ).toInclude( 'extends="bxModules.bxai.models.runnables.AiAgent"' );
			} );

			it( "throws clearly when --model is missing", function() {
				var dir = newTargetDir();
				expect( function() {
					verb.run( { projectRoot : dir, skipInstall : true } );
				} ).toThrow( "BxAgents.MissingModel" );
			} );

			it( "throws clearly when projectRoot is missing", function() {
				expect( function() {
					verb.run( { model : "openai/gpt-5", skipInstall : true } );
				} ).toThrow( "BxAgents.MissingProjectRoot" );
			} );

			/**
			 * Regression: a real bug this closed - `new` never installed the
			 * `testbox` devDependency its own box.json declares, so `bxAgents
			 * test` failed with "TestBox not found" on every freshly
			 * scaffolded project until the user manually ran `box install`
			 * themselves first. Verified here via `skipInstall` (fast,
			 * network-independent) rather than a real `box install` call,
			 * which is a genuine network operation this suite can't rely on
			 * in CI/sandboxes, like ftp/ssh/digitalocean's own real network
			 * calls.
			 */
			it( "skips the box install step entirely when --skipInstall is passed", function() {
				var dir = newTargetDir();
				var result = verb.run( { projectRoot : dir, model : "openai/gpt-5", skipInstall : true } );

				expect( result.message ).notToInclude( "box install" );
			} );

			it( "passes --template through to ProjectScaffolder", function() {
				var dir = newTargetDir();
				verb.run( { projectRoot : dir, model : "openai/gpt-5", template : "webui-chat", skipInstall : true } );

				expect( fileExists( dir & "/gateways/webui.bx" ) ).toBeTrue();
			} );

			it( "builds the features the flags ask for and prints what is left to do", function() {
				var dir = newTargetDir();
				var result = verb.run( {
					projectRoot : dir, model : "claude", skipInstall : true,
					with : "time,search", search : "brave", mcp : "github", channels : "telegram", memory : "file"
				} );

				expect( result.exitCode ).toBe( 0 );
				var agent = fileRead( dir & "/Agent.yaml" );
				expect( agent ).toInclude( "- now@bxai" );
				expect( agent ).toInclude( "- webSearch@bxai" );
				expect( agent ).toInclude( "memory: file" );
				expect( fileExists( dir & "/gateways/telegram.bx" ) ).toBeTrue();
				expect( fileRead( dir & "/.env" ) ).toInclude( "BRAVE_API_KEY=" );
				expect( result.message ).toInclude( "Fill in .env" );
				expect( result.message ).toInclude( "Set up Telegram" );
				expect( result.message ).toInclude( "BotFather" );
			} );

			it( "keeps the old one-line message when no feature flag is used", function() {
				var dir = newTargetDir();
				var result = verb.run( { projectRoot : dir, model : "openai/gpt-5", skipInstall : true } );

				expect( result.message ).toBe( "Created new BX Agents project [my-agent] at #dir#" );
			} );

			it( "says which flag is wrong and what it accepts", function() {
				expect( function() {
					verb.run( { projectRoot : newTargetDir(), model : "openai", with : "telepathy", skipInstall : true } );
				} ).toThrow( type = "BxAgents.InvalidNewOption", regex = "--with .* Use:" );
			} );

			it( "refuses feature flags together with --class", function() {
				expect( function() {
					verb.run( { projectRoot : newTargetDir(), model : "openai", with : "time", "class" : true, skipInstall : true } );
				} ).toThrow( type = "BxAgents.FeaturesNeedYaml" );
			} );

			it( "asks questions when a terminal is attached and no model was given, then scaffolds the answers", function() {
				var dir = newTargetDir();
				var prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( [
					"helper", "Helps out", "minimal", "claude", "", [ "time" ], "cache", [], [ "web" ],
					"key", "flag", "none", "create"
				] );

				var result = verb.run( { projectRoot : dir, skipInstall : true, _interactive : true, _prompter : prompter } );

				expect( result.exitCode ).toBe( 0 );
				var agent = fileRead( dir & "/Agent.yaml" );
				expect( agent ).toInclude( "name: helper" );
				expect( agent ).toInclude( "model: claude" );
				expect( agent ).toInclude( "- now@bxai" );
				expect( agent ).toInclude( "enabled: true" );
				expect( fileRead( dir & "/gateways/webui.bx" ) ).toInclude( 'apiKeyEnvVar : "CHAT_UI_API_KEY"' );
				expect( fileRead( dir & "/.env" ) ).toMatch( "CHAT_UI_API_KEY=[a-f0-9]{32,}" );
				expect( result.message ).toInclude( "Created helper" );
				expect( result.message ).toInclude( "bxAgents chat" );
				expect( result.message ).toInclude( "The same project without questions" );
			} );

			it( "creates nothing when the wizard is cancelled", function() {
				var dir = newTargetDir();
				var prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( [ "helper", "<cancel>" ] );

				var result = verb.run( { projectRoot : dir, skipInstall : true, _interactive : true, _prompter : prompter } );

				expect( result.exitCode ).toBe( 1 );
				expect( result.message ).toInclude( "Nothing was created" );
				expect( directoryExists( dir ) ).toBeFalse();
			} );

			it( "does not ask when --no-wizard, --yes or a model is given", function() {
				for ( var options in [ { wizard : false, model : "" }, { yes : true, model : "" }, { model : "openai" } ] ) {
					options.projectRoot = newTargetDir();
					options.skipInstall = true;
					options._interactive = true;
					options._prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( [] );
					if ( !len( options.model ) ) {
						expect( function() {
							verb.run( options );
						} ).toThrow( "BxAgents.MissingModel" );
					} else {
						expect( verb.run( options ).exitCode ).toBe( 0 );
					}
					expect( options._prompter.asked() ).toBeEmpty();
				}
			} );

			it( "asks even with a model when --wizard is passed, and shows the model as given", function() {
				var dir = newTargetDir();
				var prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( [
					"x", "minimal", [], "cache", [], [], "off", "none", "create"
				] );

				verb.run( { projectRoot : dir, model : "openai", name : "named", wizard : true, skipInstall : true, _prompter : prompter } );

				expect( prompter.recorded().model.value ).toInclude( "from a flag" );
				expect( fileRead( dir & "/Agent.yaml" ) ).toInclude( "name: named" );
			} );

			it( "throws BxAgents.ConflictingProjectSource when --repo and --forgebox are both passed", function() {
				var dir = newTargetDir();

				expect( function() {
					verb.run( { projectRoot : dir, repo : "someOwner/some-repo", forgebox : "some-slug" } );
				} ).toThrow( "BxAgents.ConflictingProjectSource" );
			} );

			it( "throws BxAgents.ConflictingProjectSource when --template is combined with --repo", function() {
				var dir = newTargetDir();

				expect( function() {
					verb.run( { projectRoot : dir, repo : "someOwner/some-repo", template : "webui-chat" } );
				} ).toThrow( "BxAgents.ConflictingProjectSource" );
			} );

			it( "throws BxAgents.ConflictingProjectSource when --template is combined with --forgebox", function() {
				var dir = newTargetDir();

				expect( function() {
					verb.run( { projectRoot : dir, forgebox : "some-slug", template : "webui-chat" } );
				} ).toThrow( "BxAgents.ConflictingProjectSource" );
			} );

			/**
			 * --model is only required in --template mode - a cloned/installed
			 * project defines its own. Proven without a real network call: a
			 * pre-populated non-empty target dir makes RepoCloner fail its own
			 * precondition check instantly, so the error surfaced is provably
			 * clone-related, never BxAgents.MissingModel.
			 */
			it( "does not require --model when --repo is passed", function() {
				var dir = newTargetDir();
				directoryCreate( path = dir, createPath = true, ignoreExists = true );
				fileWrite( dir & "/already-here.txt", "x" );

				expect( function() {
					verb.run( { projectRoot : dir, repo : "someOwner/some-repo" } );
				} ).toThrow( "BxAgents.RepoCloneFailed" );
			} );

			it( "does not require --model when --forgebox is passed", function() {
				var dir = newTargetDir();
				directoryCreate( path = dir, createPath = true, ignoreExists = true );
				fileWrite( dir & "/already-here.txt", "x" );

				expect( function() {
					verb.run( { projectRoot : dir, forgebox : "some-slug" } );
				} ).toThrow( "BxAgents.ForgeboxInstallFailed" );
			} );

		} );
	}

}
