class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.Chat", function() {

			beforeEach( function() {
				variables.chatVerb = new bxagents.models.cli.Chat();
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			// Only the pre-flight checks are exercised here: MiniConsole (used
			// once past them) sets up a raw-mode terminal via `stty`, which
			// requires a real interactive TTY this test harness doesn't have -
			// the interactive loop itself isn't something a headless spec can
			// safely drive.

			it( "throws clearly when projectRoot is missing", function() {
				expect( function() {
					chatVerb.run( {} );
				} ).toThrow( "BxAgents.MissingProjectRoot" );
			} );

			it( "errors cleanly if build hasn't run yet", function() {
				var dir = createTempDirectory( prefix = "bxagents-cli-chat-" );
				directoryCopy( fixtures & "/full-project", dir, true );
				tempDirs.append( dir );

				expect( function() {
					chatVerb.run( { projectRoot : dir } );
				} ).toThrow( "BxAgents.NotBuilt" );
			} );

			it( "rejects --server and --connect together rather than silently honoring one", function() {
				// They are opposite instructions: one says "start a server for
				// me", the other "do not, talk to this one". Picking either
				// would mean ignoring what the other asked for.
				//
				// The project here is deliberately UNBUILT: the conflict is
				// checked before the build gate, so someone who typed both
				// flags hears about the flags rather than being sent to run
				// `build` only to hit the same wall afterwards.
				var dir = createTempDirectory( prefix = "bxagents-cli-chat-" );
				directoryCopy( fixtures & "/full-project", dir, true );
				tempDirs.append( dir );

				expect( function() {
					chatVerb.run( { projectRoot : dir, server : true, connect : "http://127.0.0.1:9999" } );
				} ).toThrow( "BxAgents.ConflictingChatTarget" );
			} );

			it( "does NOT require a local build for --connect", function() {
				// --connect talks to a server someone else is running, which may
				// be a deployment on another machine entirely, so demanding a
				// local .build/ would be wrong. An unbuilt project must
				// therefore get past the build gate - it fails later, on the
				// terminal or the connection, not on BxAgents.NotBuilt.
				var dir = createTempDirectory( prefix = "bxagents-cli-chat-" );
				directoryCopy( fixtures & "/full-project", dir, true );
				tempDirs.append( dir );

				var threw = "";
				try {
					chatVerb.run( { projectRoot : dir, connect : "http://127.0.0.1:1" } );
				} catch ( any e ) {
					threw = e.type;
				}

				expect( threw ).notToBe( "BxAgents.NotBuilt" );
			} );


			// ---------------------------------------------------------------
			// Lifecycle over HTTP: a scripted server in this process answers like an agent's
			// run-control routes, and a stand-in screen types one line and leaves.
			// ---------------------------------------------------------------

			function startScriptedServer( required array seen, array headers = [] ) {
				var srv = createObject( "java", "com.sun.net.httpserver.HttpServer" ).create(
					createObject( "java", "java.net.InetSocketAddress" ).init( "127.0.0.1", 0 ), 0
				);
				srv.createContext( "/", ( exchange ) => {
					seen.append( exchange.getRequestMethod() & " " & exchange.getRequestURI().getPath() );
					headers.append( exchange.getRequestHeaders().getFirst( "x-bxagents-token" ) ?: "" );
					var out = exchange.getResponseBody();
					var path = exchange.getRequestURI().getPath();
					if ( path == "/__bxagents/events" ) {
						exchange.getResponseHeaders().add( "Content-Type", "text/event-stream" );
						exchange.sendResponseHeaders( 200, 0 );
						for ( var frame in [
							'event: thread' & char( 10 ) & 'data: {"threadId":"t-1"}',
							'event: chunk' & char( 10 ) & 'data: {"choices":[{"delta":{"content":"Hi there"}}]}',
							'event: done' & char( 10 ) & 'data: [DONE]'
						] ) {
							out.write( ( frame & char( 10 ) & char( 10 ) ).getBytes( "UTF-8" ) );
							out.flush();
						}
					} else {
						var body = path == "/__bxagents/agent" ? '{"success":true,"name":"scripted","model":"mock/m"}' : '{"success":true,"tools":[]}';
						var bytes = body.getBytes( "UTF-8" );
						exchange.getResponseHeaders().add( "Content-Type", "application/json" );
						exchange.sendResponseHeaders( 200, bytes.len() );
						out.write( bytes );
					}
					out.close();
				} );
				srv.start();
				return srv;
			}

			function scriptedScreen( required array log ) {
				var s = { inputs : [ "hello" ] };
				s.readInput = () => {
					if ( !s.inputs.len() ) { return nullValue(); }
					var next = s.inputs[ 1 ];
					s.inputs.deleteAt( 1 );
					return next;
				};
				s.banner = ( agent, model, mode ) => log.append( "banner:" & agent & "|" & model & "|" & mode );
				s.printUser = ( text ) => {};
				s.print = ( style, text ) => {};
				s.printMarkdown = ( text ) => log.append( "markdown:" & text );
				s.beginTurn = () => {};
				s.endTurn = () => {};
				s.push = ( event ) => {};
				s.cancelRequested = () => false;
				s.takeSteer = () => nullValue();
				s.choose = ( title, lines, choices ) => "reject";
				s.isRecording = () => false;
				s.recordingFile = () => "";
				s.recordingError = () => "";
				s.startRecording = ( file, title ) => {};
				s.stopRecording = () => "";
				s.copy = ( text ) => {};
				s.setStatus = ( text ) => {};
				s.setImagesAllowed = ( allowed, reason ) => {};
				s.bindKeys = ( overrides ) => [];
				s.keyTable = () => [];
				s.takeImages = () => [];
				s.close = () => log.append( "screen closed" );
				return s;
			}

			it( "chats over run control with --connect and leaves that server alone", function() {
				var seen = [];
				var log = [];
				var srv = startScriptedServer( seen );
				try {
					var result = chatVerb.run( {
						projectRoot : createTempDirectory( prefix = "bxagents-cli-chat-" ),
						connect     : "http://127.0.0.1:" & srv.getAddress().getPort(),
						_screen     : scriptedScreen( log )
					} );
				} finally {
					srv.stop( 0 );
				}

				expect( result.exitCode ).toBe( 0 );
				expect( log[ 1 ] ).toBe( "banner:scripted|mock/m|over http" );
				expect( seen ).toInclude( "POST /__bxagents/events" );
				// nothing but the agent's own routes was called: no shutdown, no build
				expect( seen.filter( r => !r.find( "/__bxagents/" ) ) ).toBeEmpty();
				expect( seen.filter( r => r.findNoCase( "stop" ) || r.findNoCase( "shutdown" ) ) ).toBeEmpty();
			} );

			it( "sends the token of --token on every request of --connect", function() {
				var seen = [];
				var headers = [];
				var log = [];
				var srv = startScriptedServer( seen, headers );
				try {
					chatVerb.run( {
						projectRoot : createTempDirectory( prefix = "bxagents-cli-chat-" ),
						connect     : "http://127.0.0.1:" & srv.getAddress().getPort(),
						token       : "bxa_example",
						_screen     : scriptedScreen( log )
					} );
				} finally {
					srv.stop( 0 );
				}

				expect( seen ).notToBeEmpty();
				expect( headers.filter( h => h != "bxa_example" ) ).toBeEmpty();
			} );

			it( "stops the throwaway server of --server when the chat ends", function() {
				var seen = [];
				var log = [];
				var calls = [];
				var srv = startScriptedServer( seen );
				try {
					var client = new LifecycleClient().configure( "http://127.0.0.1:" & srv.getAddress().getPort(), calls );
					var dir = createTempDirectory( prefix = "bxagents-cli-chat-" );
					directoryCreate( dir & "/.build/app/agent", true, true );
					fileWrite( dir & "/.build/app/agent/GeneratedAgentFactory.bx", "class {}" );
					tempDirs.append( dir );
					chatVerb.run( { projectRoot : dir, server : true, _client : client, _screen : scriptedScreen( log ) } );
				} finally {
					srv.stop( 0 );
				}

				expect( calls ).toBe( [ "start", "stop:the-process" ] );
				expect( seen ).toInclude( "POST /__bxagents/events" );
			} );

			it( "stops the throwaway server of --server even when the chat fails", function() {
				var calls = [];
				var client = new LifecycleClient().configure( "http://127.0.0.1:1", calls );
				var dir = createTempDirectory( prefix = "bxagents-cli-chat-" );
				directoryCreate( dir & "/.build/app/agent", true, true );
					fileWrite( dir & "/.build/app/agent/GeneratedAgentFactory.bx", "class {}" );
				tempDirs.append( dir );
				var broken = { readInput : () => { throw( type = "Test.Boom", message = "screen broke" ); }, banner : () => {}, setStatus : () => {}, setImagesAllowed : () => {}, bindKeys : () => [], keyTable : () => [], takeImages : () => [], close : () => {}, isRecording : () => false };

				expect( function() {
					chatVerb.run( { projectRoot : dir, server : true, _client : client, _screen : broken } );
				} ).toThrow( "Test.Boom" );
				expect( calls ).toBe( [ "start", "stop:the-process" ] );
			} );

		} );
	}

}
