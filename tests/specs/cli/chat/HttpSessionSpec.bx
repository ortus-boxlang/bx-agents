/**
 * The HTTP session turns the run-control stream into the chat screen's events, and uses the
 * server's cancel, steer and resume routes. The client is a fake that plays scripted events.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "HttpSession", function() {

			beforeEach( function() {
				variables.calls = [];
				variables.script = { events : [], tools : [], about : { name : "support", model : "claude/sonnet" }, missing : false, legacy : [] };
				variables.fake = {
					events : ( baseUrl, route, payload, onEvent ) => {
						calls.append( { call : "events", route : route, payload : duplicate( payload ) } );
						if ( script.missing ) {
							throw( type = "BxAgents.AgentRouteMissing", message = "404" );
						}
						for ( var event in script.events ) {
							onEvent( event );
						}
						return { output : "", threadId : "t-1", suspended : false, pending : [], error : "" };
					},
					stream : ( baseUrl, message, threadId, onDelta ) => {
						calls.append( { call : "stream", message : message, threadId : threadId } );
						for ( var delta in script.legacy ) {
							onDelta( delta );
						}
						return { output : script.legacy.toList( "" ), threadId : "t-legacy", suspended : false };
					},
					getJson : ( baseUrl, route, query = {} ) => {
						calls.append( { call : "get", route : route } );
						if ( route == "tools" ) { return { tools : script.tools }; }
						if ( route == "agent" ) { return script.about; }
						if ( route == "profiles" ) {
							if ( !script.keyExists( "profiles" ) ) {
								throw( type = "BxAgents.AgentRouteMissing", message = "404" );
							}
							return { profiles : script.profiles };
						}
						throw( type = "Test.Unexpected", message = route );
					},
					postJson : ( baseUrl, route, body = {} ) => {
						calls.append( { call : "post", route : route, body : duplicate( body ) } );
						if ( route == "ping" ) {
							return script.keyExists( "noList" ) ? throw( type = "BxAgents.AgentNotFound" ) : { success : true, ok : true, model : "openai/gpt-5", ms : 90, reply : "pong", asked : body.profile };
						}
						if ( route == "sessions/rename" ) {
							return script.keyExists( "noList" ) ? throw( type = "BxAgents.AgentNotFound" ) : { success : true, ok : true, title : body.title };
						}
						if ( route == "sessions/fork" ) {
							return script.keyExists( "noList" ) ? throw( type = "BxAgents.AgentNotFound" ) : { success : true, ok : true, id : "forked-1", title : len( body.title ) ? body.title : "Fork of x", messages : 6 };
						}
						return { success : true };
					}
				};
				variables.session = new bxagents.models.cli.chat.HttpSession( "http://h:1/", new FakeClient( fake ) );
				variables.pushed = [];
				variables.controls = { cancel : false, steer : [] };
				variables.hooks = {
					push            : ( event ) => pushed.append( event ),
					cancelRequested : () => controls.cancel,
					takeSteer       : () => controls.steer.len() ? controls.steer.shift() : nullValue()
				};
			} );

			private function events( list ) {
				script.events = arguments.list;
			}

			describe( "testing the model and what is known about it", function() {

				it( "asks the server to ping, for the profile in use unless one is named", function() {
					var outcome = session.ping();
					expect( outcome.ok ).toBeTrue();
					expect( calls.filter( c => c.call == "post" )[ 1 ] ).toBe( { call : "post", route : "ping", body : { profile : "" } } );

					session.ping( "planner" );
					expect( calls.filter( c => c.call == "post" )[ 2 ].body ).toBe( { profile : "planner" } );
				} );

				it( "says so when the server could not be asked", function() {
					script.noList = true;
					var outcome = session.ping();
					expect( outcome.ok ).toBeFalse();
					expect( outcome.reason ).toInclude( "could not be asked" );
				} );

				it( "reads the facts of the server's model from /agent and of a profile from /profiles", function() {
					script.about = { name : "helper", model : "openai/gpt-5", contextWindow : 128000, vision : "yes" };
					script.profiles = [ { name : "fast", provider : "openai", model : "gpt-5-mini", isDefault : false, contextWindow : 400000, vision : "no" } ];
					var fresh = new bxagents.models.cli.chat.HttpSession( "http://h:1/", new FakeClient( fake ) );

					expect( fresh.modelFacts() ).toBe( { contextWindow : 128000, vision : "yes" } );
					fresh.useProfile( "fast" );
					expect( fresh.modelFacts() ).toBe( { contextWindow : 400000, vision : "no" } );
					expect( fresh.info().map( r => r[ 1 ] ) ).toInclude( "Context" );
				} );

			} );

			describe( "naming and forking", function() {

				it( "names the conversation on the server", function() {
					var outcome = session.rename( "Launch plan" );
					expect( outcome.ok ).toBeTrue();
					expect( outcome.title ).toBe( "Launch plan" );
					var post = calls.filter( c => c.call == "post" )[ 1 ];
					expect( post.route ).toBe( "sessions/rename" );
					expect( post.body ).toBe( { conversationId : session.conversationId(), title : "Launch plan" } );
				} );

				it( "forks on the server and carries on in the copy, on a new thread", function() {
					var before = session.conversationId();
					var outcome = session.fork( "Other approach" );

					expect( outcome.ok ).toBeTrue();
					expect( session.conversationId() ).toBe( "forked-1" );
					expect( session.conversationId() ).notToBe( before );
					expect( calls.filter( c => c.call == "post" )[ 1 ].body ).toBe( { conversationId : before, title : "Other approach" } );
				} );

				it( "says so when the server keeps no list of conversations, and stays where it is", function() {
					script.noList = true;
					var before = session.conversationId();

					expect( session.rename( "x" ).reason ).toInclude( "no list of conversations" );
					expect( session.fork( "x" ).reason ).toInclude( "no list of conversations" );
					expect( session.conversationId() ).toBe( before );
				} );

			} );

			describe( "profiles", function() {

				beforeEach( function() {
					script.profiles = [
						{ name : "fast", description : "Quick", provider : "openai", model : "gpt-5-mini", isDefault : false },
						{ name : "planner", description : "", provider : "claude", model : "claude-opus-4", isDefault : false }
					];
				} );

				it( "can switch only when the server lists profiles, and says how to offer them otherwise", function() {
					expect( session.switchable().ok ).toBeTrue();

					script.delete( "profiles" );
					var older = new bxagents.models.cli.chat.HttpSession( "http://h:1/", new FakeClient( fake ) );

					expect( older.switchable().ok ).toBeFalse();
					expect( older.switchable().reason ).toInclude( "agentApi.profiles" );
					expect( older.profiles() ).toBeEmpty();
				} );

				it( "lists what the server offers and marks the one in use", function() {
					session.useProfile( "planner" );

					var list = session.profiles();

					expect( list.map( p => p.name ) ).toBe( [ "fast", "planner" ] );
					expect( list.filter( p => p.isCurrent ).map( p => p.name ) ).toBe( [ "planner" ] );
					expect( session.modelInfo().model ).toBe( "claude/claude-opus-4" );
				} );

				it( "sends the chosen profile with every turn until it goes back to the default", function() {
					events( [ { type : "delta", text : "hi" } ] );

					session.send( "before", hooks );
					session.useProfile( "fast" );
					session.send( "during", hooks );
					session.useDefault();
					session.send( "after", hooks );

					var sent = calls.filter( c => c.call == "events" ).map( c => c.payload );
					expect( sent[ 1 ] ).notToHaveKey( "options" );
					expect( sent[ 2 ].options ).toBe( { profile : "fast" } );
					expect( sent[ 3 ] ).notToHaveKey( "options" );
				} );

				it( "refuses a profile the server does not offer", function() {
					var outcome = session.useProfile( "secret" );

					expect( outcome.ok ).toBeFalse();
					expect( outcome.reason ).toInclude( "offers: fast, planner" );
				} );

			} );

			it( "describes the agent from the server, and falls back when it cannot say", function() {
				expect( session.agentName() ).toBe( "support" );
				expect( session.modelName() ).toBe( "claude/sonnet" );
				expect( session.mode() ).toBe( "over http" );

				script.about = {};
				var bare = new bxagents.models.cli.chat.HttpSession( "http://h:1", new FakeClient( fake ) );
				expect( bare.agentName() ).toBe( "agent" );
				expect( bare.modelName() ).toBe( "http://h:1" );
			} );

			it( "lists the agent's tools by name", function() {
				script.tools = [ { name : "now", description : "x" }, "plain" ];

				expect( session.tools() ).toBe( [ "now", "plain" ] );
			} );

			it( "turns stream events into screen events and returns the whole answer", function() {
				events( [
					{ type : "thread", threadId : "t-1" },
					{ type : "reasoning", text : "hmm" },
					{ type : "delta", text : "It is " },
					{ type : "tool", id : "now##1", name : "now", arguments : { zone : "UTC", _chatRequest : "x" }, status : "running", ms : 0 },
					{ type : "tool", id : "now##1", name : "now", arguments : { zone : "UTC" }, status : "ok", ms : 7 },
					{ type : "delta", text : "noon." }
				] );

				var result = session.send( "time?", hooks );

				expect( result.status ).toBe( "done" );
				expect( result.text ).toBe( "It is noon." );
				expect( pushed.map( e => e.type ) ).toBe( [ "reasoning", "delta", "tool", "tool", "delta" ] );
				expect( pushed[ 3 ].summary ).toBe( "zone=UTC" );
				expect( pushed[ 3 ].status ).toBe( "running" );
				expect( pushed[ 4 ].status ).toBe( "ok" );
				expect( pushed[ 4 ].ms ).toBe( 7 );
				expect( calls.filter( c => c.call == "events" )[ 1 ].route ).toBe( "events" );
			} );

			it( "keeps the thread from one turn to the next, and starts over on /new", function() {
				events( [ { type : "thread", threadId : "t-1" }, { type : "delta", text : "a" } ] );

				session.send( "one", hooks );
				session.send( "two", hooks );
				session.newThread();
				session.send( "three", hooks );

				var sent = calls.filter( c => c.call == "events" ).map( c => c.payload.threadId );
				expect( sent ).toBe( [ "", "t-1", "" ] );
			} );

			it( "stops the run on the server when the user pressed Esc, and leaves the turn", function() {
				events( [ { type : "thread", threadId : "t-1" }, { type : "delta", text : "a" }, { type : "delta", text : "b" } ] );
				controls.cancel = true;

				var result = session.send( "go", hooks );

				expect( result.status ).toBe( "cancelled" );
				var posts = calls.filter( c => c.call == "post" );
				expect( posts ).toHaveLength( 1 );
				expect( posts[ 1 ].route ).toBe( "cancel" );
				expect( posts[ 1 ].body.threadId ).toBe( "t-1" );
			} );

			it( "sends a message typed during the turn to the server's steer route", function() {
				events( [ { type : "thread", threadId : "t-1" }, { type : "delta", text : "a" } ] );
				controls.steer = [ "and be brief" ];

				var result = session.send( "go", hooks );

				expect( result.status ).toBe( "done" );
				var posts = calls.filter( c => c.call == "post" );
				expect( posts[ 1 ].route ).toBe( "steer" );
				expect( posts[ 1 ].body.input ).toBe( "and be brief" );
				expect( posts[ 1 ].body.threadId ).toBe( "t-1" );
			} );

			it( "returns a run that waits for approval with what it waits on, and resume answers it", function() {
				events( [
					{ type : "thread", threadId : "t-9" },
					{ type : "suspended", threadId : "t-9", pendingActions : [ { toolName : "deleteFile", toolArgs : { path : "x" } } ] }
				] );

				var first = session.send( "clean up", hooks );

				expect( first.status ).toBe( "suspended" );
				expect( first.pending[ 1 ].toolName ).toBe( "deleteFile" );

				script.events = [ { type : "delta", text : "Done." } ];
				var second = session.resume( "approve", hooks );

				expect( second.status ).toBe( "done" );
				expect( second.text ).toBe( "Done." );
				var resumed = calls.filter( c => c.call == "events" )[ 2 ];
				expect( resumed.route ).toBe( "resume" );
				expect( resumed.payload.threadId ).toBe( "t-9" );
				expect( resumed.payload.decision ).toBe( "approve" );
			} );

			it( "shows an error the server reports", function() {
				events( [ { type : "error", message : "model offline" } ] );

				session.send( "go", hooks );

				expect( pushed ).toHaveLength( 1 );
				expect( pushed[ 1 ].type ).toBe( "error" );
				expect( pushed[ 1 ].text ).toBe( "model offline" );
			} );

			it( "falls back to the plain text stream, once and with a notice, on a server without run control", function() {
				script.missing = true;
				script.legacy = [ "Hel", "lo" ];

				var first = session.send( "hi", hooks );
				var second = session.send( "again", hooks );

				expect( first.text ).toBe( "Hello" );
				expect( first.status ).toBe( "done" );
				expect( pushed.filter( e => e.type == "notice" ) ).toHaveLength( 1 );
				expect( calls.filter( c => c.call == "events" ) ).toHaveLength( 1 );
				expect( calls.filter( c => c.call == "stream" ) ).toHaveLength( 2 );
				expect( calls.filter( c => c.call == "stream" )[ 2 ].threadId ).toBe( "t-legacy" );
			} );

			it( "stops the plain text stream of an older server when the user pressed Esc", function() {
				script.missing = true;
				script.legacy = [ "a", "b", "c" ];
				controls.cancel = true;

				var result = session.send( "hi", hooks );

				expect( result.status ).toBe( "cancelled" );
			} );

			it( "says where to answer an approval on an older server, which the plain stream cannot carry", function() {
				script.missing = true;
				fake.stream = ( baseUrl, message, threadId, onDelta ) => ( { output : "", threadId : "t", suspended : true } );

				session.send( "hi", hooks );

				var notices = pushed.filter( e => e.type == "notice" );
				expect( notices.last().text ).toInclude( "http://h:1/gateways/interactions/" );
			} );

		} );
	}

}
