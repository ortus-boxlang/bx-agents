/**
 * The in-process session against a real bx-ai agent on the mock provider: the events it
 * produces from the stream, from tool calls, and the cancel and steer calls it makes.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "InProcessSession", function() {

			beforeEach( function() {
				variables.agent = aiAgent( name : "helper", model : aiModel( provider : "mock" ) )
				variables.session = new bxagents.models.cli.chat.InProcessSession( agent )
				variables.events = []
				variables.controls = { cancel : false, steer : [], onChunk : () => {} }
				variables.hooks = {
					push            : ( event ) => events.append( event ),
					cancelRequested : () => { controls.onChunk(); return controls.cancel },
					takeSteer       : () => controls.steer.len() ? controls.steer[ 1 ] : nullValue()
				}
			} );

			afterEach( function() {
				session.close()
			} );

			it( "describes the agent", function() {
				expect( session.agentName() ).toBe( "helper" );
				expect( session.mode() ).toBe( "in-process" );
				expect( session.modelName() ).notToBeEmpty();
				expect( session.tools() ).toBeArray();
			} );

			it( "turns the stream into delta events and returns the whole answer", function() {
				var result = session.send( "hello", hooks )

				expect( result.status ).toBe( "done" );
				expect( events.len() ).toBeGTE( 1 );
				expect( events.every( e => e.type == "delta" ) ).toBeTrue();
				expect( events.map( e => e.text ).toList( "" ) ).toBe( result.text );
				expect( result.text ).notToBeEmpty();
			} );

			describe( "images", function() {

				beforeEach( function() {
					variables.dir = createTempDirectory( prefix = "bxagents-session-images-" );
					fileWrite( dir & "/shot.png", toBinary( "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/q842iQAAAABJRU5ErkJggg==" ) );
					variables.settings = getModuleInfo( "bxai" ).settings;
					variables.saved = settings.bxagents ?: {};
				} );

				afterEach( function() {
					settings.bxagents = saved;
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				} );

				it( "sends an image with the message as an image part, and the agent remembers it as one", function() {
					var result = session.send( "what is this?", hooks, [ { path : dir & "/shot.png" } ] )

					expect( result.status ).toBe( "done" );
					var remembered = agent.getMemoryMessages( session.userId(), session.conversationId() ).filter( m => m.role == "user" )
					expect( remembered ).toHaveLength( 1 );
					expect( remembered[ 1 ].content ).toBeArray();
					expect( remembered[ 1 ].content.filter( p => p.type == "image_url" ) ).toHaveLength( 1 );
					// the conversation shows it as text and a marker, not as base64
					expect( session.history()[ 1 ].text ).toBe( "what is this?" & char( 10 ) & "[image]" );
				} );

				it( "refuses an image for a model the project says cannot see, and sends nothing", function() {
					settings.bxagents = { default : { vision : false } }
					var before = agent.getMemoryMessages( session.userId(), session.conversationId() ).len()
					var result = session.send( "what is this?", hooks, [ { path : dir & "/shot.png" } ] )

					expect( result.status ).toBe( "stopped" );
					expect( result.reason ).toInclude( "cannot see images" );
					expect( agent.getMemoryMessages( session.userId(), session.conversationId() ) ).toHaveLength( before );
				} );

				it( "counts a message's images apart from its text in the size of the context", function() {
					session.send( "what is this?", hooks, [ { path : dir & "/shot.png" } ] )
					var memory = session.contextReport().parts.filter( p => p.key == "memory" )[ 1 ]
					expect( memory.detail ).toInclude( "1 image not counted" );
					expect( memory.tokens ).toBeLT( 50 );
				} );

			} );

			it( "reports tool calls as running, then ok with the time it took", function() {
				var tool = aiTool( "lookup", "lookup", ( topic ) => "found " & topic, false )
				controls.onChunk = () => {
					if ( !events.some( e => e.type == "tool" ) ) {
						tool.invoke( { topic : "bx" } )
					}
				}

				session.send( "hello", hooks )

				var calls = events.filter( e => e.type == "tool" )
				expect( calls ).toHaveLength( 2 );
				expect( calls[ 1 ].status ).toBe( "running" );
				expect( calls[ 1 ].name ).toBe( "lookup" );
				expect( calls[ 1 ].summary ).toBe( "topic=bx" );
				expect( calls[ 2 ].status ).toBe( "ok" );
				expect( calls[ 2 ].id ).toBe( calls[ 1 ].id );
				expect( calls[ 2 ].ms ).toBeGTE( 0 );
			} );

			it( "leaves bx-ai's underscore arguments out of the tool summary", function() {
				var tool = aiTool( "lookup", "lookup", ( topic ) => "found " & topic, false )
				controls.onChunk = () => {
					if ( !events.some( e => e.type == "tool" ) ) {
						tool.invoke( { topic : "bx", _chatRequest : { logRequest : false } } )
					}
				}

				session.send( "hello", hooks )

				var calls = events.filter( e => e.type == "tool" )
				expect( calls ).notToBeEmpty();
				for ( var call in calls ) {
					expect( call.summary ).toBe( "topic=bx" );
				}
			} );

			it( "does not report tool calls made when no turn is running", function() {
				aiTool( "lonely", "lonely", () => "x", false ).invoke( {} )

				expect( events ).toBeEmpty();
			} );

			it( "asks bx-ai to cancel the run when the user pressed Esc", function() {
				controls.cancel = true

				var result = session.send( "hello", hooks )

				expect( result.status ).toBe( "cancelled" );
			} );

			it( "passes a message typed during the turn to the run", function() {
				controls.steer = [ "and be brief" ]

				var result = session.send( "hello", hooks )

				expect( result.status ).toBe( "done" );
			} );

			it( "starts the next conversation on a new thread", function() {
				session.send( "one", hooks )
				session.newThread()

				expect( session.send( "two", hooks ).status ).toBe( "done" );
			} );

			describe( "profiles", function() {

				beforeEach( function() {
					variables.settings = getModuleInfo( "bxai" ).settings
					variables.saved = { profiles : settings.profiles ?: {}, defaultProfile : settings.defaultProfile ?: "" }
					settings.profiles = {
						slow : { provider : "mock", params : { model : "slow-model" } },
						fast : { description : "Cheap and quick", provider : "mock", params : { model : "fast-model" } }
					}
					settings.defaultProfile = ""
				} );

				afterEach( function() {
					settings.profiles = saved.profiles
					settings.defaultProfile = saved.defaultProfile
				} );

				it( "lists the default first, then the named ones by name whatever order they were declared in, with who is default and who is in use", function() {
					var list = session.profiles()

					expect( list.map( p => p.name ) ).toBe( [ "default", "fast", "slow" ] );
					expect( list[ 1 ].isDefault ).toBeTrue();
					expect( list[ 2 ].description ).toBe( "Cheap and quick" );
					expect( list[ 2 ].model ).toBe( "fast-model" );
					// mock has no key to set, so it is never reported as missing one
					expect( list.every( p => p.hasApiKey ) ).toBeTrue();
				} );

				it( "switches the agent's model to a profile and keeps answering", function() {
					var outcome = session.useProfile( "fast" )

					expect( outcome.ok ).toBeTrue();
					expect( outcome.profile ).toBe( "fast" );
					expect( session.modelName() ).toBe( "mock/fast-model" );
					expect( session.modelInfo().profile ).toBe( "fast" );
					expect( session.profiles().filter( p => p.isCurrent ).map( p => p.name ) ).toBe( [ "fast" ] );
					expect( session.send( "hello", hooks ).status ).toBe( "done" );
				} );

				it( "goes back to the app's default with useDefault, which is the defaultProfile when there is one", function() {
					session.useProfile( "fast" )
					expect( session.useDefault().profile ).toBe( "default" );

					settings.defaultProfile = "slow"
					session.useProfile( "fast" )

					expect( session.useDefault().profile ).toBe( "slow" );
					expect( session.modelName() ).toBe( "mock/slow-model" );
				} );

				it( "refuses a profile that does not exist and names the ones that do", function() {
					var outcome = session.useProfile( "nope" )

					expect( outcome.ok ).toBeFalse();
					expect( outcome.reason ).toInclude( "no profile [nope]" );
					expect( outcome.reason ).toInclude( "fast" );
				} );

			} );

			it( "stops reporting tool calls once closed", function() {
				session.close()
				aiTool( "late", "late", () => "x", false ).invoke( {} )
				session.send( "hello", hooks )

				expect( events.filter( e => e.type == "tool" ) ).toBeEmpty();
				// afterEach closes again: closing twice must be harmless
			} );

		} );
	}

}
