/**
 * Stands in for AgentClient in HttpSessionSpec: every call goes to a function the spec supplies.
 */
class {

	function init( required struct behavior ) {
		variables.behavior = arguments.behavior
		return this
	}

	function events( required string baseUrl, string route = "events", required struct payload, numeric timeoutSeconds = 600, any onEvent ) {
		return variables.behavior.events( arguments.baseUrl, arguments.route, arguments.payload, arguments.onEvent )
	}

	function stream( required string baseUrl, required string message, numeric timeoutSeconds = 120, string threadId = "", any onDelta ) {
		return variables.behavior.stream( arguments.baseUrl, arguments.message, arguments.threadId, arguments.onDelta )
	}

	function getJson( required string baseUrl, required string route, struct query = {} ) {
		return variables.behavior.getJson( arguments.baseUrl, arguments.route, arguments.query )
	}

	function postJson( required string baseUrl, required string route, struct body = {} ) {
		return variables.behavior.postJson( arguments.baseUrl, arguments.route, arguments.body )
	}

}
