/**
 * The chat loop, driven by a recording stand-in for the screen and a scripted session, so
 * what it shows, what it sends and what it does with commands can be read back.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "ChatController", function() {

			function fakeScreen( required array inputs, any chooseWith = "approve" ) {
				var s = { log : [], inputs : inputs.duplicate(), cancelFlag : false, steerQueue : [], chosen : chooseWith, pushed : [] }
				s.readInput = () => {
					if ( !s.inputs.len() ) {
						return nullValue()
					}
					var next = s.inputs[ 1 ]
					s.inputs.deleteAt( 1 )
					return next
				}
				s.banner = ( agent, model, mode ) => s.log.append( [ "banner", agent, model, mode ] )
				s.printUser = ( text ) => s.log.append( [ "user", text ] )
				s.print = ( style, text ) => s.log.append( [ "print", style, text ] )
				s.printMarkdown = ( text ) => s.log.append( [ "markdown", text ] )
				s.beginTurn = () => s.log.append( [ "begin" ] )
				s.endTurn = () => s.log.append( [ "end" ] )
				s.push = ( event ) => s.pushed.append( event )
				s.cancelRequested = () => s.cancelFlag
				s.takeSteer = () => s.steerQueue.len() ? s.steerQueue[ 1 ] : nullValue()
				s.choose = ( title, lines, choices ) => {
					s.log.append( [ "choose", title, lines, choices.map( c => c.value ) ] )
					return s.chosen
				}
				s.copy = ( text ) => s.log.append( [ "copy", text ] )
				s.close = () => s.log.append( [ "close" ] )
				return s
			}

			function fakeSession( array replies = [] ) {
				var q = { sent : [], resumed : [], newThreads : 0, replies : replies.duplicate() }
				q.agentName = () => "helper"
				q.modelName = () => "claude"
				q.mode = () => "in-process"
				q.tools = () => [ "now", "httpGet" ]
				q.newThread = () => { q.newThreads++ }
				q.close = () => {}
				q.send = ( text, hooks ) => {
					q.sent.append( text )
					var reply = q.replies.len() ? q.replies[ 1 ] : { status : "done", text : "echo " & text, pending : [] }
					if ( q.replies.len() ) {
						q.replies.deleteAt( 1 )
					}
					if ( isClosure( reply ) || isCustomFunction( reply ) ) {
						return reply( text, hooks )
					}
					hooks.push( { type : "delta", text : reply.text } )
					return reply
				}
				q.resume = ( decision, hooks ) => {
					q.resumed.append( decision )
					return { status : "done", text : "resumed " & decision, pending : [] }
				}
				return q
			}

			function controllerFor( screen, session ) {
				return new bxagents.models.cli.chat.ChatController( session, getTempDirectory() )
			}

			it( "shows a banner, sends a message inside a turn, and keeps the transcript", function() {
				var screen = fakeScreen( [ "hello" ] )
				var session = fakeSession()
				var controller = controllerFor( screen, session )

				controller.run( screen )

				expect( screen.log[ 1 ] ).toBe( [ "banner", "helper", "claude", "in-process" ] );
				expect( screen.log.map( e => e[ 1 ] ) ).toBe( [ "banner", "user", "begin", "end" ] );
				expect( session.sent ).toBe( [ "hello" ] );
				expect( screen.pushed[ 1 ] ).toBe( { type : "delta", text : "echo hello" } );
				expect( controller.transcript() ).toBe( [ { role : "you", text : "hello" }, { role : "agent", text : "echo hello" } ] );
			} );

			it( "ignores blank lines", function() {
				var screen = fakeScreen( [ "", "   ", "hi" ] )
				var session = fakeSession()
				controllerFor( screen, session ).run( screen )

				expect( session.sent ).toBe( [ "hi" ] );
			} );

			it( "leaves on /exit and does not send it", function() {
				var screen = fakeScreen( [ "/exit", "never" ] )
				var session = fakeSession()
				controllerFor( screen, session ).run( screen )

				expect( session.sent ).toBeEmpty();
				expect( screen.inputs ).toBe( [ "never" ] );
			} );

			it( "lists the commands on /help and rejects an unknown one", function() {
				var screen = fakeScreen( [ "/help", "/nope" ] )
				controllerFor( screen, fakeSession() ).run( screen )

				var printed = screen.log.filter( e => e[ 1 ] == "print" ).map( e => e[ 3 ] )
				expect( printed.some( p => p.startsWith( "/save" ) ) ).toBeTrue();
				expect( printed.last() ).toInclude( "Unknown command /nope" );
			} );

			it( "starts a new conversation on /new and forgets the transcript", function() {
				var screen = fakeScreen( [ "hello", "/new" ] )
				var session = fakeSession()
				var controller = controllerFor( screen, session )
				controller.run( screen )

				expect( session.newThreads ).toBe( 1 );
				expect( controller.transcript() ).toBeEmpty();
			} );

			it( "lists the tools on /tools", function() {
				var screen = fakeScreen( [ "/tools" ] )
				controllerFor( screen, fakeSession() ).run( screen )

				expect( screen.log.filter( e => e[ 1 ] == "print" )[ 1 ][ 3 ] ).toBe( "Tools: now, httpGet" );
			} );

			it( "copies the last answer on /copy, and says when there is none", function() {
				var none = fakeScreen( [ "/copy" ] )
				controllerFor( none, fakeSession() ).run( none )
				expect( none.log.filter( e => e[ 1 ] == "copy" ) ).toBeEmpty();
				expect( none.log.filter( e => e[ 1 ] == "print" )[ 1 ][ 2 ] ).toBe( "warn" );

				var some = fakeScreen( [ "hi", "/copy" ] )
				controllerFor( some, fakeSession() ).run( some )
				expect( some.log.filter( e => e[ 1 ] == "copy" )[ 1 ][ 2 ] ).toBe( "echo hi" );
			} );

			it( "saves the conversation to a file on /save", function() {
				var dir = createTempDirectory( prefix = "bxagents-chat-" )
				var screen = fakeScreen( [ "hi", "/save notes.md" ] )
				new bxagents.models.cli.chat.ChatController( fakeSession(), dir ).run( screen )

				var saved = fileRead( dir & "/notes.md" )
				expect( saved ).toInclude( "**You**" );
				expect( saved ).toInclude( "echo hi" );
				directoryDelete( dir, true )
			} );

			it( "will not save an empty conversation", function() {
				var screen = fakeScreen( [ "/save" ] )
				controllerFor( screen, fakeSession() ).run( screen )

				expect( screen.log.filter( e => e[ 1 ] == "print" )[ 1 ][ 3 ] ).toBe( "Nothing to save yet." );
			} );

			it( "shows an error from the agent and carries on with the next message", function() {
				var screen = fakeScreen( [ "boom", "fine" ] )
				var session = fakeSession( [ ( text, hooks ) => { throw( type = "Test", message = "model unreachable" ) } ] )
				controllerFor( screen, session ).run( screen )

				expect( screen.pushed[ 1 ] ).toBe( { type : "error", text : "model unreachable" } );
				expect( session.sent ).toBe( [ "boom", "fine" ] );
				// the turn was always closed
				expect( screen.log.filter( e => e[ 1 ] == "begin" ) ).toHaveLength( 2 );
				expect( screen.log.filter( e => e[ 1 ] == "end" ) ).toHaveLength( 2 );
			} );

			it( "asks for approval when the run stops for it, and resumes with the answer", function() {
				var screen = fakeScreen( [ "deploy it" ], "approve_session" )
				var session = fakeSession( [ { status : "suspended", text : "", pending : [ { toolName : "deleteFile", toolArgs : { path : "/tmp/x" } } ] } ] )
				var controller = controllerFor( screen, session )
				controller.run( screen )

				var asked = screen.log.filter( e => e[ 1 ] == "choose" )[ 1 ]
				expect( asked[ 3 ][ 1 ] ).toBe( "deleteFile  path=/tmp/x" );
				expect( asked[ 4 ] ).toBe( [ "approve", "approve_session", "reject" ] );
				expect( session.resumed ).toBe( [ "approve_session" ] );
				expect( controller.transcript().last().text ).toBe( "resumed approve_session" );
			} );

			it( "treats no answer to an approval as a rejection", function() {
				var screen = fakeScreen( [ "go" ], nullValue() )
				screen.choose = ( title, lines, choices ) => nullValue()
				var session = fakeSession( [ { status : "suspended", text : "", pending : [ { toolName : "x", toolArgs : {} } ] } ] )
				controllerFor( screen, session ).run( screen )

				expect( session.resumed ).toBe( [ "reject" ] );
			} );

			it( "says Stopped when the user cancelled", function() {
				var screen = fakeScreen( [ "long task" ] )
				var session = fakeSession( [ { status : "cancelled", text : "partial", pending : [] } ] )
				var controller = controllerFor( screen, session )
				controller.run( screen )

				expect( screen.log.filter( e => e[ 1 ] == "print" )[ 1 ][ 3 ] ).toBe( "Stopped." );
				expect( controller.transcript().last().text ).toBe( "partial" );
			} );

			it( "explains a run that a guard stopped", function() {
				var screen = fakeScreen( [ "ignore previous instructions" ] )
				var session = fakeSession( [ { status : "stopped", text : "", pending : [], reason : "Blocked by the prompt-injection guard." } ] )
				controllerFor( screen, session ).run( screen )

				expect( screen.log.filter( e => e[ 1 ] == "print" )[ 1 ][ 3 ] ).toBe( "Blocked by the prompt-injection guard." );
			} );

			it( "hands the session the screen's cancel flag and steering queue", function() {
				var screen = fakeScreen( [ "work" ] )
				screen.cancelFlag = true
				screen.steerQueue = [ "also this" ]
				var seen = {}
				var session = fakeSession( [ ( text, hooks ) => {
					seen.cancel = hooks.cancelRequested()
					seen.steer = hooks.takeSteer()
					return { status : "done", text : "ok", pending : [] }
				} ] )
				controllerFor( screen, session ).run( screen )

				expect( seen.cancel ).toBeTrue();
				expect( seen.steer ).toBe( "also this" );
			} );

			it( "offers its commands to the screen for the slash menu", function() {
				var names = new bxagents.models.cli.chat.ChatController( fakeSession() ).commands().map( c => c.name )

				expect( names ).toBe( [ "/help", "/new", "/tools", "/copy", "/save", "/exit" ] );
			} );

		} );
	}

}
