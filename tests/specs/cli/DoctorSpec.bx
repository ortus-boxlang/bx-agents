class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.Doctor", function() {

			beforeEach( function() {
				variables.doctorVerb = new bxagents.models.cli.Doctor();
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempProject( required string fixtureName ) {
				var dir = createTempDirectory( prefix = "bxagents-cli-doctor-" );
				directoryCopy( fixtures & "/" & arguments.fixtureName, dir, true );
				tempDirs.append( dir );
				return dir;
			}

			private function countOccurrences( required string haystack, required string needle ) {
				var count = 0;
				var pos = haystack.find( needle );
				var searchFrom = 1;

				while ( pos > 0 ) {
					count++;
					searchFrom = pos + len( needle );
					pos = haystack.find( needle, searchFrom );
				}

				return count;
			}

			it( "fails cleanly with no Agent.bx found, rather than throwing", function() {
				var dir = createTempDirectory( prefix = "bxagents-cli-doctor-" );
				tempDirs.append( dir );

				var result = doctorVerb.run( { projectRoot : dir } );

				expect( result.exitCode ).toBe( 1 );
				expect( result.message ).toInclude( "No Agent.yaml or Agent.bx found" );
			} );

			it( "reports the running BoxLang version and bx-ai as loaded", function() {
				var result = doctorVerb.run( { projectRoot : newTempProject( "valid-minimal" ) } );

				expect( result.message ).toInclude( "BoxLang " & server.boxlang.version );
				expect( result.message ).toInclude( "bx-ai " );
				expect( result.message ).toInclude( "loaded" );
			} );

			it( "warns when a stdio MCP server's program is not on the PATH, and says where a found one lives", function() {
				var result = doctorVerb.run( { projectRoot : newTempProject( "doctor-mcp-programs" ) } );

				expect( result.message ).toInclude( "MCP server [absent] starts [bxa-no-such-program-xyz], which is not on the PATH" );
				if ( !server.os.name.findNoCase( "win" ) ) {
					expect( result.message ).toInclude( "MCP server [present] starts [sh]" );
				}
				expect( result.checks.filter( c => c.message.findNoCase( "absent" ) )[ 1 ].status ).toBe( "warn" );
			} );

			it( "returns exit code 0 and a clean validation report for a valid project", function() {
				// the fixture's model needs its provider key, so it is set for the run
				var system = createObject( "java", "java.lang.System" );
				var had = len( getSystemSetting( "OPENAI_API_KEY", "" ) ) > 0;
				if ( !had ) {
					system.setProperty( "OPENAI_API_KEY", "k" );
				}
				try {
					var result = doctorVerb.run( { projectRoot : newTempProject( "full-project" ) } );
				} finally {
					if ( !had ) {
						system.clearProperty( "OPENAI_API_KEY" );
					}
				}

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).toInclude( "Everything checks out." );
			} );

			it( "returns exit code 1 and surfaces the real validation error for an invalid project", function() {
				var result = doctorVerb.run( { projectRoot : newTempProject( "validation/duplicate-tool-names" ) } );

				expect( result.exitCode ).toBe( 1 );
				expect( result.message ).toInclude( "[FAIL]" );
			} );

			it( "warns when a gateway's own *EnvVar is not set, and stops warning once it is", function() {
				var projectRoot = newTempProject( "gateways-telegram" );

				var before = doctorVerb.run( { projectRoot : projectRoot } );
				expect( before.exitCode ).toBe( 0 );
				expect( before.message ).toInclude( "[WARN] MY_TELEGRAM_BOT_TOKEN is not set" );

				createObject( "java", "java.lang.System" ).setProperty( "MY_TELEGRAM_BOT_TOKEN", "a-real-token" );
				try {
					var after = doctorVerb.run( { projectRoot : projectRoot } );
					expect( after.message ).toInclude( "[ OK ] MY_TELEGRAM_BOT_TOKEN is set" );
					expect( after.message ).notToInclude( "MY_TELEGRAM_BOT_TOKEN is not set" );
				} finally {
					createObject( "java", "java.lang.System" ).clearProperty( "MY_TELEGRAM_BOT_TOKEN" );
				}
			} );

			it( "warns for a profile's key variable that is not set, names who needs it, and stops once it is set", function() {
				var root = createTempDirectory( prefix = "bxagents-cli-doctor-" );
				tempDirs.append( root );
				var nl = char( 10 );
				fileWrite( root & "/Agent.yaml", "name: keyed" & nl & "model: mock/mock-model" & nl & "profiles:" & nl
					& "  fast:" & nl & "    provider: openai" & nl & "    apiKeyEnv: DOCTOR_FAST_KEY" & nl
					& "  planner:" & nl & "    provider: claude" & nl & "    apiKeyEnv: DOCTOR_PLANNER_KEY" & nl
					& "speech:" & nl & "  provider: mock" & nl );
				fileWrite( root & "/instructions.md", "Be helpful." );

				var before = doctorVerb.run( { projectRoot : root } );
				expect( before.exitCode ).toBe( 0 );
				expect( before.message ).toInclude( "[WARN] DOCTOR_FAST_KEY is not set in the environment (profile fast)" );
				expect( before.message ).toInclude( "[WARN] DOCTOR_PLANNER_KEY is not set in the environment (profile planner)" );

				createObject( "java", "java.lang.System" ).setProperty( "DOCTOR_FAST_KEY", "k" );
				try {
					var after = doctorVerb.run( { projectRoot : root } );
					expect( after.message ).toInclude( "[ OK ] DOCTOR_FAST_KEY is set (profile fast)" );
					expect( after.message ).toInclude( "DOCTOR_PLANNER_KEY is not set" );
				} finally {
					createObject( "java", "java.lang.System" ).clearProperty( "DOCTOR_FAST_KEY" );
				}
			} );

			it( "asks for no key when every model is the mock provider", function() {
				var root = createTempDirectory( prefix = "bxagents-cli-doctor-" );
				tempDirs.append( root );
				fileWrite( root & "/Agent.yaml", "name: mocked" & char( 10 ) & "model: mock/mock-model" & char( 10 ) );
				fileWrite( root & "/instructions.md", "Be helpful." );

				expect( doctorVerb.run( { projectRoot : root } ).message ).notToInclude( "API_KEY" );
			} );

			it( "checks the same *EnvVar only once even when several entries declare it", function() {
				var result = doctorVerb.run( { projectRoot : newTempProject( "gateways-webui-users" ) } );

				expect( countOccurrences( result.message, "ACME_ADA_PASSWORD" ) ).toBe( 1 );
			} );

			it( "does not check qb/cbauth/cbsecurity - they are bundled with the module, not installed by the project", function() {
				var webUi = doctorVerb.run( { projectRoot : newTempProject( "gateways-webui-users" ) } );
				expect( webUi.message ).notToInclude( "qb module" );
				expect( webUi.message ).notToInclude( "cbauth module" );
				expect( webUi.message ).notToInclude( "cbsecurity module" );
			} );

			it( "reports findings as a real JSON array via --json", function() {
				var result = doctorVerb.run( { projectRoot : newTempProject( "full-project" ), json : true } );

				var parsed = jsonDeserialize( result.message );
				expect( isArray( parsed ) ).toBeTrue();
				expect( parsed.len() ).toBeGT( 0 );
				expect( parsed[ 1 ] ).toHaveKey( "status" );
				expect( parsed[ 1 ] ).toHaveKey( "message" );
			} );

		} );
	}

}
