class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.Install", function() {

			beforeEach( function() {
				variables.verb = new bxagents.models.cli.Install();
				variables.dir = createTempDirectory( prefix = "bxagents-cli-install-" );
			} );

			afterEach( function() {
				directoryDelete( dir, true );
			} );

			it( "says there is nothing to install for a project with no box.json, and succeeds", function() {
				var result = verb.run( { projectRoot : dir } );

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).toInclude( "No box.json" );
				expect( result.message ).toInclude( "bundles" );
			} );

			it( "says so when box.json lists no dependencies", function() {
				fileWrite( dir & "/box.json", '{ "name": "x" }' );

				var result = verb.run( { projectRoot : dir } );

				expect( result.exitCode ).toBe( 0 );
				expect( result.message ).toInclude( "lists no dependencies" );
			} );

			it( "treats devDependencies as nothing to install under --production", function() {
				fileWrite( dir & "/box.json", '{ "devDependencies": { "testbox": "*" } }' );

				var result = verb.run( { projectRoot : dir, production : true } );

				expect( result.message ).toInclude( "lists no dependencies" );
			} );

			it( "fails clearly for an invalid box.json", function() {
				fileWrite( dir & "/box.json", '{ "dependencies": { "a": "https://example.com/a.zip" } }' );

				expect( function() {
					verb.run( { projectRoot : dir } );
				} ).toThrow( type = "BxAgents.InvalidBoxJson" );
			} );

			it( "requires a project root", function() {
				expect( function() {
					verb.run( {} );
				} ).toThrow( type = "BxAgents.MissingProjectRoot" );
			} );

		} );
	}

}
