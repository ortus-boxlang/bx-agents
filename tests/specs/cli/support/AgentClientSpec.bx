class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.support.AgentClient", function() {

			beforeEach( function() {
				variables.client = new bxagents.models.cli.support.AgentClient();
			} );

			it( "addresses the reserved agent route, not a user-declared exposure", function() {
				expect( client.agentUrl( "http://127.0.0.1:8080" ) ).toBe( "http://127.0.0.1:8080/__bxagents/invoke" );
			} );

			it( "tolerates a trailing slash on the base URL rather than producing a double slash", function() {
				// A doubled separator ("...//invoke") does not match the route
				// that was actually registered, so it would 404 - and someone
				// pasting a URL from a browser bar will have the slash.
				expect( client.agentUrl( "http://127.0.0.1:8080/" ) ).toBe( "http://127.0.0.1:8080/__bxagents/invoke" );
			} );

			it( "can address the other toAi() sub-routes on the same reserved path", function() {
				expect( client.agentUrl( "http://h:1", "stream" ) ).toBe( "http://h:1/__bxagents/stream" );
				expect( client.agentUrl( "http://h:1", "info" ) ).toBe( "http://h:1/__bxagents/info" );
			} );

			it( "hands out a real, free, unprivileged port", function() {
				var port = client.findFreePort();
				expect( port ).toBeNumeric();
				expect( port ).toBeGT( 1024 );
				expect( port ).toBeLT( 65536 );
			} );

			it( "treats stopServer( null ) as a no-op so a finally block never has to guard it", function() {
				expect( function() {
					client.stopServer( nullValue() );
				} ).notToThrow();
			} );

			describe( "SSE frame parsing", function() {

				// These cases are written from REAL bytes captured off ColdBox's
				// own toAi() /stream route, not from the SSE spec - the two
				// differ, and the differences are the whole reason this parser
				// is a separate, testable method.

				it( "joins a JSON payload split across many data: lines", function() {
					// The emitter PRETTY-PRINTS its JSON, so one logical event
					// arrives as a dozen data: lines. Treating one data: line as
					// one event yields nothing but unparseable fragments.
					var frames = client.parseSseLines( [
						"event: thread",
						"data: {",
						"data:   ""threadId"" : ""abc-123""",
						"data: }"
					] );

					expect( frames.len() ).toBe( 1 );
					expect( frames[ 1 ].event ).toBe( "thread" );
					expect( jsonDeserialize( frames[ 1 ].data ).threadId ).toBe( "abc-123" );
				} );

				it( "delimits frames on the next event: line, since the emitter sends no blank lines", function() {
					// Confirmed on the wire: zero blank lines in the whole
					// response. A strictly spec-compliant parser - one that only
					// dispatches on a blank line - buffers forever and prints
					// nothing at all.
					var frames = client.parseSseLines( [
						"event: chunk",
						"data: {""a"":1}",
						"event: chunk",
						"data: {""a"":2}",
						"event: done",
						"data: [DONE]"
					] );

					expect( frames.len() ).toBe( 3 );
					expect( frames[ 1 ].data ).toBe( '{"a":1}' );
					expect( frames[ 2 ].data ).toBe( '{"a":2}' );
					expect( frames[ 3 ].event ).toBe( "done" );
				} );

				it( "still works if blank-line terminators ever appear", function() {
					// Flushing on event: AND at end-of-input means a
					// spec-compliant stream parses identically, so this does not
					// break if the emitter is fixed upstream.
					var frames = client.parseSseLines( [
						"event: chunk",
						"data: {""a"":1}",
						"",
						"event: chunk",
						"data: {""a"":2}",
						""
					] );

					expect( frames.len() ).toBe( 2 );
					expect( frames[ 2 ].data ).toBe( '{"a":2}' );
				} );

				it( "ignores ':' comment lines, which is how keep-alives arrive", function() {
					var frames = client.parseSseLines( [
						":hi",
						":keep-alive",
						"event: chunk",
						"data: {""a"":1}"
					] );

					expect( frames.len() ).toBe( 1 );
					expect( frames[ 1 ].data ).toBe( '{"a":1}' );
				} );

				it( "strips exactly one framing space after 'data:' and keeps the rest", function() {
					// Pretty-printed JSON is all indentation; eating more than
					// the single framing space would corrupt every payload.
					var frames = client.parseSseLines( [ "event: chunk", "data:     ""x""" ] );
					expect( frames[ 1 ].data ).toBe( '    "x"' );
				} );

				it( "returns nothing for an empty stream rather than an empty frame", function() {
					expect( client.parseSseLines( [] ).len() ).toBe( 0 );
					expect( client.parseSseLines( [ ":keep-alive" ] ).len() ).toBe( 0 );
				} );

			} );

			it( "gives up with a clear error when nothing is listening", function() {
				// Port 1 is privileged and never served by this process, so the
				// connection is refused immediately. A 1-second deadline keeps
				// the spec fast while still exercising the real retry/timeout
				// path rather than a stubbed one.
				expect( function() {
					client.send( baseUrl : "http://127.0.0.1:1", message : "hi", timeoutSeconds : 1 );
				} ).toThrow( "BxAgents.AgentServerNeverReady" );
			} );

		} );
	}

}
