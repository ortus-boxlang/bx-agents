class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.Add", function() {

			beforeEach( function() {
				variables.addVerb = new bxagents.models.cli.Add();
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempProject( required string fixtureName ) {
				var dir = createTempDirectory( prefix = "bxagents-cli-add-" );
				directoryCopy( fixtures & "/" & arguments.fixtureName, dir, true );
				tempDirs.append( dir );
				return dir;
			}

			private function addTool( required string root, struct flags = {}, array positionals = [ "tool", "Greeter2" ] ) {
				var options = { projectRoot : root, _positionals : positionals, yes : true };
				options.append( flags );
				return addVerb.run( options );
			}

			describe( "add tool, by flags", function() {

				it( "writes tools/<Name>.bx in bx-ai's shape", function() {
					var root = newTempProject( "full-project" );

					var result = addTool( root, { function : "greet", description : "Say hello", args : "name, times:numeric" } );
					var source = fileRead( root & "/tools/Greeter2.bx" );

					expect( result.exitCode ).toBe( 0 );
					expect( source ).toInclude( '@AITool( "Say hello" )' );
					expect( source ).toInclude( "public string function greet( required string name, required numeric times )" );
					expect( source ).toInclude( "@name TODO: describe name" );
					expect( result.message ).toInclude( "tools/Greeter2.bx" );
				} );

				it( "is found by the next build and by inspect", function() {
					var root = newTempProject( "full-project" );
					addTool( root, { function : "greet", description : "Say hello" } );

					new bxagents.models.cli.Build().run( { projectRoot : root } );
					var report = new bxagents.models.report.ProjectReport().build( root );

					expect( report.agent.tools.own.map( t => t.name ) ).toInclude( "greet" );
					expect( report.validation.errors ).toBeEmpty();
				} );

				it( "defaults the function name from the file name", function() {
					var root = newTempProject( "full-project" );

					addTool( root, { description : "d" }, [ "tool", "WeatherNow" ] );

					expect( fileRead( root & "/tools/WeatherNow.bx" ) ).toInclude( "function weatherNow(" );
				} );

				it( "escapes quotes and hash signs in the description so the file still compiles", function() {
					var root = newTempProject( "full-project" );

					var hash = char( 35 );
					addTool( root, { description : 'Find the "best" ' & hash & '1 result' } );
					var source = fileRead( root & "/tools/Greeter2.bx" );

					expect( source ).toInclude( '@AITool( "Find the ""best"" ' & hash & hash & '1 result" )' );
					expect( function() {
						new bxagents.models.report.ProjectReport().build( root );
					} ).notToThrow();
				} );

				it( "leaves a TODO description when none is given and nothing can be asked", function() {
					var root = newTempProject( "full-project" );

					var result = addTool( root );

					expect( fileRead( root & "/tools/Greeter2.bx" ) ).toInclude( "TODO: say what this tool does" );
					expect( result.message ).toInclude( "Replace the TODO description" );
				} );

				it( "refuses a name already used by a tool of that agent, even in a subfolder", function() {
					var root = newTempProject( "full-project" );

					expect( function() {
						addTool( root, {}, [ "tool", "Search" ] );
					} ).toThrow( "BxAgents.ToolExists" );
				} );

				it( "refuses to overwrite an existing file and changes nothing", function() {
					var root = newTempProject( "full-project" );
					addTool( root, { description : "first" } );

					expect( function() {
						addTool( root, { description : "second" }, [ "tool", "Greeter2" ] );
					} ).toThrow( "BxAgents.ToolExists" );
					expect( fileRead( root & "/tools/Greeter2.bx" ) ).toInclude( "first" );
				} );

				it( "writes nothing on --dry-run and shows the file", function() {
					var root = newTempProject( "full-project" );

					var result = addTool( root, { description : "d", "dry-run" : true } );

					expect( fileExists( root & "/tools/Greeter2.bx" ) ).toBeFalse();
					expect( result.message ).toInclude( "Would create tools/Greeter2.bx" );
					expect( result.message ).toInclude( "@AITool" );
				} );

				it( "rejects a bad name, a bad argument type and a duplicate argument", function() {
					var root = newTempProject( "full-project" );

					expect( function() {
						addTool( root, { description : "d" }, [ "tool", "9bad" ] );
					} ).toThrow( "BxAgents.InvalidAnswer" );
					expect( function() {
						addTool( root, { description : "d", args : "x:widget" } );
					} ).toThrow( "BxAgents.InvalidAnswer" );
					expect( function() {
						addTool( root, { description : "d", args : "x, x" } );
					} ).toThrow( "BxAgents.InvalidAnswer" );
				} );

				it( "puts the tool in a subagent's own tools/ folder with --agent", function() {
					var root = newTempProject( "subagents-chain" );

					addTool( root, { description : "d", agent : "a" } );

					expect( fileExists( root & "/subagents/a/tools/Greeter2.bx" ) ).toBeTrue();
					expect( fileExists( root & "/tools/Greeter2.bx" ) ).toBeFalse();
				} );

				it( "rejects an --agent that is not a subagent", function() {
					var root = newTempProject( "subagents-chain" );

					expect( function() {
						addTool( root, { description : "d", agent : "nope" } );
					} ).toThrow( "BxAgents.InvalidAnswer" );
				} );

			} );

			describe( "add interceptor", function() {

				private function addInterceptor( required string root, struct flags = {}, array positionals = [ "interceptor", "AuditLogger2" ] ) {
					var options = { projectRoot : root, _positionals : positionals, yes : true };
					options.append( flags );
					return addVerb.run( options );
				}

				it( "writes interceptors/<Name>.bx with a method per point and the scope in the docblock", function() {
					var root = newTempProject( "full-project" );

					var result = addInterceptor( root, { points : "preProcess,onException", description : "Log every request" } );
					var source = fileRead( root & "/interceptors/AuditLogger2.bx" );

					expect( result.exitCode ).toBe( 0 );
					expect( source ).toInclude( " * Log every request" );
					expect( source ).toInclude( " * @scope agent" );
					expect( source ).toInclude( "function preProcess( event, interceptData, rc, prc )" );
					expect( source ).toInclude( "function onException( event, interceptData, rc, prc )" );
				} );

				it( "is split to the scope it declares by the next build, in both scopes", function() {
					var root = newTempProject( "full-project" );
					addInterceptor( root, { points : "preProcess" } );
					addInterceptor( root, { scope : "runtime", points : "beforeAIModelInvoke,onAIError" }, [ "interceptor", "AiWatch" ] );

					var result = new bxagents.models.build.BuildPipeline( "test" ).build( root );
					var report = new bxagents.models.report.ProjectReport().build( root );

					expect( fileExists( result.appDir & "/interceptors/AuditLogger2.bx" ) ).toBeTrue();
					expect( fileExists( root & "/.build/runtime-interceptors/AiWatch.bx" ) ).toBeTrue();
					expect( fileExists( result.appDir & "/interceptors/AiWatch.bx" ) ).toBeFalse();
					expect( report.interceptors.filter( i => i.name == "AiWatch" )[ 1 ].scope ).toBe( "runtime" );
					expect( report.validation.errors ).toBeEmpty();
				} );

				it( "uses bx-ai's event data argument for runtime scope", function() {
					var root = newTempProject( "full-project" );

					addInterceptor( root, { scope : "runtime", points : "onAIError" } );

					expect( fileRead( root & "/interceptors/AuditLogger2.bx" ) ).toInclude( "function onAIError( data )" );
				} );

				it( "compiles and can be instantiated", function() {
					var root = newTempProject( "full-project" );
					addInterceptor( root, { points : "preProcess,postProcess" } );

					var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext();
					var instance = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
						.instantiate( root & "/interceptors/AuditLogger2.bx", context );

					expect( isObject( instance ) ).toBeTrue();
				} );

				it( "defaults to the agent scope and the preProcess point", function() {
					var root = newTempProject( "full-project" );

					addInterceptor( root );

					var source = fileRead( root & "/interceptors/AuditLogger2.bx" );
					expect( source ).toInclude( "@scope agent" );
					expect( source ).toInclude( "function preProcess(" );
				} );

				it( "refuses a name already used, a point that does not exist for the scope, and an unknown scope", function() {
					var root = newTempProject( "full-project" );

					expect( function() {
						addInterceptor( root, {}, [ "interceptor", "AuditLogger" ] );
					} ).toThrow( "BxAgents.InterceptorExists" );
					expect( function() {
						addInterceptor( root, { points : "beforeAIModelInvoke" } );
					} ).toThrow( "BxAgents.InvalidAnswer" );
					expect( function() {
						addInterceptor( root, { scope : "global" } );
					} ).toThrow( "BxAgents.InvalidAnswer" );
				} );

				it( "asks for the name, where it runs, the points and a description", function() {
					var root = newTempProject( "full-project" );
					var prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( [ "Watcher", "runtime", [ "beforeAIModelInvoke", "onAIError" ], "Watches calls", "create" ] );

					var result = addVerb.run( { projectRoot : root, _positionals : [ "interceptor" ], _prompter : prompter, _interactive : true } );

					expect( prompter.remaining() ).toBe( 0 );
					expect( result.exitCode ).toBe( 0 );
					expect( fileRead( root & "/interceptors/Watcher.bx" ) ).toInclude( "function onAIError( data )" );
				} );

			} );

			describe( "add schedule", function() {

				private function addSchedule( required string root, struct flags = {}, array positionals = [ "schedule" ] ) {
					var options = { projectRoot : root, _positionals : positionals, yes : true, prompt : "Say hi" };
					options.append( flags );
					return addVerb.run( options );
				}

				it( "creates schedules/Scheduler.bx when there is none, naming the agent by its declared name", function() {
					var root = newTempProject( "valid-minimal" );

					var result = addSchedule( root, { when : "daily 09:00", name : "morning" } );
					var source = fileRead( root & "/schedules/Scheduler.bx" );

					expect( result.exitCode ).toBe( 0 );
					expect( source ).toInclude( 'extends="coldbox.system.web.tasks.ColdBoxScheduler"' );
					expect( source ).toInclude( 'task( "morning" )' );
					expect( source ).toInclude( '.everyDayAt( "09:00" )' );
					expect( source ).toInclude( ".withNoOverlaps()" );
					expect( source ).toInclude( 'getInstance( "' & new bxagents.models.report.ProjectReport().build( root ).agent.name & '" ).run( "Say hi" )' );
				} );

				it( "adds a task to an existing scheduler, keeping what is there and its layout", function() {
					var root = newTempProject( "full-project" );
					var before = fileRead( root & "/schedules/Scheduler.bx" );

					addSchedule( root, { when : "weekly mon 08:00", name : "monday" } );
					var after = fileRead( root & "/schedules/Scheduler.bx" );

					expect( after ).toInclude( 'task( "monday" )' );
					expect( after ).toInclude( ".everyWeekOn( 1, ""08:00"" )".replace( '""', '"', "all" ) );
					expect( after.find( "nightly" ) ).toBeGT( 0 );
					expect( after.find( "nightly" ) ).toBeLT( after.find( "monday" ) );
					expect( after ).toMatch( "\n\t\}\n\n\}\n$" );
					expect( after ).toInclude( before.listToArray( char( 10 ) )[ 1 ] );
				} );

				it( "is read back by inspect, with the task name", function() {
					var root = newTempProject( "valid-minimal" );
					addSchedule( root, { when : "hourly", name : "tick" } );

					var report = new bxagents.models.report.ProjectReport().build( root );

					expect( report.schedule.tasks ).toInclude( "tick" );
					expect( report.validation.errors ).toBeEmpty();
				} );

				it( "puts a hash sign, quotes and braces in the prompt through safely", function() {
					var root = newTempProject( "valid-minimal" );
					var hash = char( 35 );

					addSchedule( root, { when : "hourly", name : "tricky", prompt : 'Report "the" {top} ' & hash & '1' } );

					expect( fileRead( root & "/schedules/Scheduler.bx" ) ).toInclude( 'run( "Report ""the"" {top} ' & hash & hash & '1" )' );
				} );

				it( "finds the end of configure() past braces in strings and comments", function() {
					var root = newTempProject( "valid-minimal" );
					directoryCreate( root & "/schedules" );
					fileWrite( root & "/schedules/Scheduler.bx", 'class extends="coldbox.system.web.tasks.ColdBoxScheduler" {' & char( 10 ) & char( 10 ) & char( 9 ) & '// a } in a comment' & char( 10 ) & char( 9 ) & 'function configure() {' & char( 10 ) & char( 9 ) & char( 9 ) & 'task( "odd" ).call( () => getInstance( "x" ).run( "a } and ""q}""" ) ).everyHour()' & char( 10 ) & char( 9 ) & '}' & char( 10 ) & char( 10 ) & '}' & char( 10 ) );

					addSchedule( root, { when : "hourly :30", name : "next" } );
					var after = fileRead( root & "/schedules/Scheduler.bx" );

					expect( after.find( 'task( "next" )' ) ).toBeGT( after.find( 'task( "odd" )' ) );
					expect( after.find( 'task( "next" )' ) ).toBeLT( after.find( "everyHourAt" ) );
					expect( after ).toMatch( "\n\t\}\n\n\}\n$" );
				} );

				it( "will not guess when there is no configure(), and hands over the text to paste", function() {
					var root = newTempProject( "valid-minimal" );
					directoryCreate( root & "/schedules" );
					fileWrite( root & "/schedules/Scheduler.bx", "class {" & char( 10 ) & "}" & char( 10 ) );

					expect( function() {
						addSchedule( root, { when : "daily 09:00", name : "x" } );
					} ).toThrow( "BxAgents.SchedulerNotEditable" );
					expect( fileRead( root & "/schedules/Scheduler.bx" ) ).toBe( "class {" & char( 10 ) & "}" & char( 10 ) );
				} );

				it( "refuses a task name already in the scheduler, a bad phrase and a missing --when", function() {
					var root = newTempProject( "full-project" );

					expect( function() {
						addSchedule( root, { when : "daily 09:00", name : "nightly" } );
					} ).toThrow( "BxAgents.InvalidAnswer" );
					expect( function() {
						addSchedule( root, { when : "daily 25:00", name : "x" } );
					} ).toThrow( "BxAgents.InvalidAnswer" );
					expect( function() {
						addSchedule( root, { name : "x" } );
					} ).toThrow( "BxAgents.MissingAnswer" );
				} );

				it( "targets a subagent by its declared name, not its folder", function() {
					var root = newTempProject( "subagents-chain" );

					addSchedule( root, { when : "daily 09:00", name : "sub", agent : "a" } );

					expect( fileRead( root & "/schedules/Scheduler.bx" ) ).toInclude( 'getInstance( "a" )' );
				} );

				it( "shows the new task and writes nothing on --dry-run", function() {
					var root = newTempProject( "full-project" );
					var before = fileRead( root & "/schedules/Scheduler.bx" );

					var result = addSchedule( root, { when : "daily 09:00", name : "dry", "dry-run" : true } );

					expect( result.message ).toInclude( "Would update schedules/Scheduler.bx" );
					expect( result.message ).toInclude( 'task( "dry" )' );
					expect( fileRead( root & "/schedules/Scheduler.bx" ) ).toBe( before );
				} );

				it( "builds the phrase from questions: how often, then the details, a name, what to say", function() {
					var root = newTempProject( "valid-minimal" );
					var prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( [ "weekly", "fri", "16:00", "friday-report", "Write the weekly report", "create" ] );

					var result = addVerb.run( { projectRoot : root, _positionals : [ "schedule" ], _prompter : prompter, _interactive : true } );

					expect( prompter.remaining() ).toBe( 0 );
					expect( result.exitCode ).toBe( 0 );
					expect( fileRead( root & "/schedules/Scheduler.bx" ) ).toInclude( '.everyWeekOn( 5, "16:00" )' );
				} );

				it( "offers the name a person would choose from the phrase", function() {
					var root = newTempProject( "valid-minimal" );
					var prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( [ "daily", "09:30", "", "Check in", "create" ] );

					// an empty answer to the name question takes its default
					prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( [ "daily", "09:30", "every-day-at-09-30", "Check in", "create" ] );
					addVerb.run( { projectRoot : root, _positionals : [ "schedule" ], _prompter : prompter, _interactive : true } );

					expect( prompter.asked().filter( q => q.title == "Task name" ) ).toHaveLength( 1 );
					expect( fileRead( root & "/schedules/Scheduler.bx" ) ).toInclude( 'task( "every-day-at-09-30" )' );
				} );

			} );

			describe( "add mcp client", function() {

				private function addMcp( required string root, struct flags = {}, array positionals = [ "mcp", "client" ] ) {
					var options = { projectRoot : root, _positionals : positionals, yes : true };
					options.append( flags );
					return addVerb.run( options );
				}

				it( "adds a catalog server to Agent.yaml with its token as an environment placeholder, and a .env stub", function() {
					var root = newTempProject( "yaml-minimal" );

					var result = addMcp( root, {}, [ "mcp", "client", "github" ] );
					var yaml = fileRead( root & "/Agent.yaml" );

					expect( result.exitCode ).toBe( 0 );
					expect( yaml ).toInclude( "mcpServers:" );
					expect( yaml ).toInclude( "name: github" );
					expect( yaml ).toInclude( 'url: "https://api.githubcopilot.com/mcp/"' );
					expect( yaml ).toInclude( 'token: "${env.GITHUB_PERSONAL_ACCESS_TOKEN}"' );
					expect( fileRead( root & "/.env" ) ).toInclude( "GITHUB_PERSONAL_ACCESS_TOKEN=" );
					expect( result.message ).toInclude( "Read this before you let an agent use it" );
				} );

				it( "adds to an mcpServers list that exists and keeps what was there", function() {
					var root = newTempProject( "with-mcp-credentials" );
					var before = fileRead( root & "/Agent.yaml" );

					addMcp( root, { url : "https://new.example.com/mcp", name : "fresh" } );
					var after = fileRead( root & "/Agent.yaml" );

					expect( after.find( before.rtrim() ) ).toBe( 1 );
					expect( after ).toInclude( "name: fresh" );
					expect( new bxagents.models.report.ProjectReport().build( root ).agent.mcpServers.map( m => m.name ) ).toInclude( "fresh" );
				} );

				it( "builds a custom server's entry from the sign-in method chosen", function() {
					var root = newTempProject( "yaml-minimal" );
					addMcp( root, { url : "https://a.example.com/mcp", name : "keyed", auth : "header", header : "X-Api-Key", env : "KEYED_KEY", timeout : "20000" } );
					addMcp( root, { url : "https://b.example.com/mcp", name : "basic", auth : "basic", user : "ada", env : "BASIC_PASS" } );
					addMcp( root, { url : "https://c.example.com/mcp", name : "open" } );

					var yaml = fileRead( root & "/Agent.yaml" );

					expect( yaml ).toInclude( 'X-Api-Key: "${env.KEYED_KEY}"' );
					expect( yaml ).toInclude( "timeout: 20000" );
					expect( yaml ).toInclude( "user: ada" );
					expect( yaml ).toInclude( 'password: "${env.BASIC_PASS}"' );
					expect( new bxagents.models.report.ProjectReport().build( root ).validation.errors ).toBeEmpty();
				} );

				it( "refuses an address that carries a key or a password, so Agent.yaml stays free of secrets", function() {
					var root = newTempProject( "yaml-minimal" );

					expect( function() {
						addMcp( root, { url : "https://x.example.com/mcp?api_key=abc", name : "x" } );
					} ).toThrow( "BxAgents.InvalidAnswer" );
					expect( function() {
						addMcp( root, { url : "https://ada:hunter2@x.example.com/mcp", name : "x" } );
					} ).toThrow( "BxAgents.InvalidAnswer" );
					expect( fileRead( root & "/Agent.yaml" ) ).notToInclude( "hunter2" );
				} );

				it( "refuses a server the agent already uses, by name or address", function() {
					var root = newTempProject( "with-mcp-credentials" );

					expect( function() {
						addMcp( root, {}, [ "mcp", "client", "github" ] );
					} ).toThrow( "BxAgents.McpExists" );
					expect( function() {
						addMcp( root, { url : "https://other.example.com/mcp", name : "again" } );
					} ).toThrow( "BxAgents.McpExists" );
				} );

				it( "does not edit a class-based Agent.bx, and hands over the entry to paste", function() {
					var root = newTempProject( "full-project" );
					var before = fileRead( root & "/Agent.bx" );

					expect( function() {
						addMcp( root, {}, [ "mcp", "client", "github" ] );
					} ).toThrow( "BxAgents.AgentNotEditable" );
					expect( fileRead( root & "/Agent.bx" ) ).toBe( before );
				} );

				it( "will not guess a server when none is named and nothing can be asked", function() {
					var root = newTempProject( "yaml-minimal" );

					expect( function() {
						addMcp( root );
					} ).toThrow( "BxAgents.MissingAnswer" );
				} );

				it( "says a server that needs a local program is not available yet", function() {
					var root = newTempProject( "yaml-minimal" );

					expect( function() {
						addMcp( root, {}, [ "mcp", "client", "git" ] );
					} ).toThrow( "BxAgents.InvalidAnswer" );
				} );

				it( "writes into a subagent's own Agent.yaml with --agent", function() {
					var root = createTempDirectory( prefix = "bxagents-cli-add-" );
					tempDirs.append( root );
					fileWrite( root & "/Agent.yaml", "name: top" & char( 10 ) & "model: mock/mock-model" & char( 10 ) & "subAgents: [ helper ]" & char( 10 ) );
					fileWrite( root & "/instructions.md", "Be helpful." );
					directoryCreate( root & "/subagents/helper" );
					fileWrite( root & "/subagents/helper/Agent.yaml", "name: helper" & char( 10 ) & "model: mock/mock-model" & char( 10 ) );
					fileWrite( root & "/subagents/helper/instructions.md", "Help." );

					addMcp( root, { agent : "helper" }, [ "mcp", "client", "github" ] );

					expect( fileRead( root & "/subagents/helper/Agent.yaml" ) ).toInclude( "name: github" );
					expect( fileRead( root & "/Agent.yaml" ) ).notToInclude( "github" );
				} );

				it( "asks which server, how it signs in and for a name, then writes it after a review", function() {
					var root = newTempProject( "yaml-minimal" );
					var prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( [ "custom", "https://mcp.acme.dev/mcp", "acme", "bearer", "ACME_TOKEN", "", "create" ] );

					var result = addVerb.run( { projectRoot : root, _positionals : [ "mcp", "client" ], _prompter : prompter, _interactive : true } );

					expect( prompter.remaining() ).toBe( 0 );
					expect( result.exitCode ).toBe( 0 );
					expect( fileRead( root & "/Agent.yaml" ) ).toInclude( 'token: "${env.ACME_TOKEN}"' );
				} );

				it( "asks which way when the positional does not say", function() {
					var root = newTempProject( "yaml-minimal" );
					var prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( [ "client", "github", "", "", "create" ] );

					addVerb.run( { projectRoot : root, _positionals : [ "mcp" ], _prompter : prompter, _interactive : true } );

					expect( prompter.asked()[ 1 ].title ).toBe( "Which way?" );
					expect( fileRead( root & "/Agent.yaml" ) ).toInclude( "name: github" );
				} );

			} );

			describe( "add mcp server", function() {

				private function projectWithTools() {
					var root = newTempProject( "yaml-minimal" );
					addTool( root, { description : "Weather", function : "getWeather" }, [ "tool", "Weather" ] );
					addTool( root, { description : "Time", function : "getTime" }, [ "tool", "Clock" ] );
					return root;
				}

				private function addServer( required string root, struct flags = {}, array positionals = [ "mcp", "server" ] ) {
					var options = { projectRoot : root, _positionals : positionals, yes : true };
					options.append( flags );
					return addVerb.run( options );
				}

				it( "writes mcp/<name>.bx offering all the project's tools, and the gateways entry that serves it", function() {
					var root = projectWithTools();

					var result = addServer( root, { description : "Weather and time", cors : "*" }, [ "mcp", "server", "tools" ] );
					var source = fileRead( root & "/mcp/tools.bx" );

					expect( result.exitCode ).toBe( 0 );
					expect( source ).toInclude( 'description : "Weather and time"' );
					expect( source ).toInclude( 'cors        : "*"' );
					expect( source ).toInclude( '"getWeather"' );
					expect( source ).toInclude( '"getTime"' );
					expect( fileRead( root & "/gateways/toolsMcp.bx" ) ).toInclude( 'target  : "tools"' );
					expect( fileRead( root & "/gateways/toolsMcp.bx" ) ).toInclude( 'path    : "/mcp/tools"' );
					expect( result.message ).toInclude( "no authentication of its own" );
				} );

				it( "validates and builds, and inspect shows the server and where it is served", function() {
					var root = projectWithTools();
					addServer( root, {}, [ "mcp", "server", "tools" ] );

					new bxagents.models.cli.Build().run( { projectRoot : root } );
					var report = new bxagents.models.report.ProjectReport().build( root );

					expect( report.validation.errors ).toBeEmpty();
					expect( report.mcpHosted[ 1 ].name ).toBe( "tools" );
					expect( report.mcpHosted[ 1 ].tools ).toBe( [ "getTime", "getWeather" ] );
					expect( report.gateways.filter( g => g.kind == "mcp" )[ 1 ].path ).toBe( "/mcp/tools" );
					expect( fileRead( root & "/.build/app/Application.bx" ) ).toInclude( 'mcpServer( "tools"' );
				} );

				it( "can offer only some tools, and skip the HTTP entry", function() {
					var root = projectWithTools();

					addServer( root, { tools : "getTime", expose : false }, [ "mcp", "server", "clock" ] );

					expect( fileRead( root & "/mcp/clock.bx" ) ).notToInclude( "getWeather" );
					expect( fileExists( root & "/gateways/clockMcp.bx" ) ).toBeFalse();
				} );

				it( "refuses when the project has no tools to host, and says what to run", function() {
					var root = newTempProject( "yaml-minimal" );

					expect( function() {
						addServer( root );
					} ).toThrow( "BxAgents.NoToolsToHost" );
				} );

				it( "refuses a tool that is not in the project, a name in use and a path in use", function() {
					var root = projectWithTools();
					addServer( root, {}, [ "mcp", "server", "tools" ] );

					expect( function() {
						addServer( root, { tools : "nope" }, [ "mcp", "server", "other" ] );
					} ).toThrow( "BxAgents.InvalidAnswer" );
					expect( function() {
						addServer( root, {}, [ "mcp", "server", "tools" ] );
					} ).toThrow( "BxAgents.InvalidAnswer" );
					expect( function() {
						addServer( root, { path : "/mcp/tools" }, [ "mcp", "server", "other" ] );
					} ).toThrow( "BxAgents.InvalidAnswer" );
				} );

				it( "asks for the name, description, version, tools, origins, whether to serve it, and the path", function() {
					var root = projectWithTools();
					var prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( [ "helpers", "Helpers", "2.0.0", [ "getTime" ], "", true, "/mcp/helpers", "create" ] );

					var result = addVerb.run( { projectRoot : root, _positionals : [ "mcp", "server" ], _prompter : prompter, _interactive : true } );

					expect( prompter.remaining() ).toBe( 0 );
					expect( result.exitCode ).toBe( 0 );
					expect( fileRead( root & "/mcp/helpers.bx" ) ).toInclude( 'version     : "2.0.0"' );
				} );

			} );

			describe( "the verb", function() {

				it( "refuses a folder that is not an agent project", function() {
					var dir = createTempDirectory( prefix = "bxagents-cli-add-" );
					tempDirs.append( dir );

					expect( function() {
						addTool( dir );
					} ).toThrow( "BxAgents.NotAnAgentProject" );
				} );

				it( "says what it can add when asked for an unknown kind or none", function() {
					var root = newTempProject( "full-project" );

					expect( function() {
						addTool( root, {}, [ "widget" ] );
					} ).toThrow( "BxAgents.UnknownAddKind" );
					expect( function() {
						addTool( root, {}, [] );
					} ).toThrow( "BxAgents.MissingAddKind" );
				} );

			} );

			describe( "add tool, by questions", function() {

				function askWith( required string root, required array answers, struct flags = {}, array positionals = [ "tool" ] ) {
					variables.prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( answers );
					var options = { projectRoot : root, _positionals : positionals, _prompter : prompter, _interactive : true };
					options.append( flags );
					return addVerb.run( options );
				}

				it( "asks for the name, function, description and arguments, reviews, then writes", function() {
					var root = newTempProject( "full-project" );

					var result = askWith( root, [ "Pinger", ".", "ping", "Pings a host", "host", "create" ] );

					expect( prompter.remaining() ).toBe( 0 );
					expect( fileRead( root & "/tools/Pinger.bx" ) ).toInclude( "public string function ping( required string host )" );
					expect( result.exitCode ).toBe( 0 );
				} );

				it( "does not ask what a flag or the positional name already answered", function() {
					var root = newTempProject( "full-project" );

					askWith( root, [ ".", "Pings a host", "", "create" ], { function : "ping" }, [ "tool", "Pinger" ] );

					expect( prompter.asked().map( q => q.title ) ).notToInclude( "Tool name" );
					expect( prompter.asked().map( q => q.title ) ).notToInclude( "Function name" );
				} );

				it( "asks which agent when the project has subagents", function() {
					var root = newTempProject( "subagents-chain" );

					askWith( root, [ "Pinger", "a", "ping", "Pings", "", "create" ] );

					expect( fileExists( root & "/subagents/a/tools/Pinger.bx" ) ).toBeTrue();
				} );

				it( "writes nothing when the review is cancelled", function() {
					var root = newTempProject( "full-project" );

					var result = askWith( root, [ "Pinger", ".", "ping", "Pings", "", "cancel" ] );

					expect( result.exitCode ).toBe( 1 );
					expect( fileExists( root & "/tools/Pinger.bx" ) ).toBeFalse();
				} );

				it( "writes nothing when a question is cancelled", function() {
					var root = newTempProject( "full-project" );

					var result = askWith( root, [ "<cancel>" ] );

					expect( result.exitCode ).toBe( 1 );
					expect( result.message ).toInclude( "Nothing was changed" );
				} );

				it( "offers a picker of kinds when none is given", function() {
					var root = newTempProject( "full-project" );

					askWith( root, [ "tool", "Pinger", ".", "ping", "Pings", "", "create" ], {}, [] );

					expect( prompter.asked()[ 1 ].title ).toBe( "What do you want to add?" );
					expect( fileExists( root & "/tools/Pinger.bx" ) ).toBeTrue();
				} );

				it( "asks again after a bad typed name instead of failing", function() {
					var root = newTempProject( "full-project" );

					askWith( root, [ "9bad", "Pinger", ".", "ping", "Pings", "", "create" ] );

					expect( fileExists( root & "/tools/Pinger.bx" ) ).toBeTrue();
				} );

			} );

		} );
	}

}
