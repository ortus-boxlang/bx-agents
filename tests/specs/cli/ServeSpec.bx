class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "cli.Serve", function() {

			beforeEach( function() {
				variables.buildVerb = new bxagents.models.cli.Build();
				variables.serveVerb = new bxagents.models.cli.Serve();
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempProject( required string fixtureName ) {
				var dir = createTempDirectory( prefix = "bxagents-cli-serve-" );
				directoryCopy( fixtures & "/" & arguments.fixtureName, dir, true );
				tempDirs.append( dir );
				return dir;
			}

			it( "errors cleanly if build hasn't run yet", function() {
				var projectRoot = newTempProject( "full-project" );

				expect( function() {
					serveVerb.run( { projectRoot : projectRoot } );
				} ).toThrow( "BxAgents.NotBuilt" );
			} );

			it( "errors clearly when boxlang-miniserver is not installed", function() {
				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );

				// This sandbox doesn't have boxlang-miniserver on PATH - a real
				// deployment target would, so this specifically exercises the
				// "not found" failure path rather than skipping it.
				expect( function() {
					serveVerb.run( { projectRoot : projectRoot } );
				} ).toThrow( "BxAgents.MiniServerNotFound" );
			} );

			/**
			 * Regression: a real bug this closed - the generated
			 * miniserver.json never set `serverHome` at all, so every served
			 * BX Agents project on a machine defaulted to sharing the same
			 * global `~/.boxlang` (compiled class cache, and any machine-level
			 * `~/.boxlang/config/boxlang.json` override applying to every
			 * served project equally). `serve` checks `findExecutable()`
			 * BEFORE writing the config, so this can't be proven up to a
			 * thrown `BxAgents.MiniServerNotFound` in this sandbox - skipped
			 * (rather than failed) when `boxlang-miniserver` isn't on PATH,
			 * same idiom `RuntimeStartupSmokeSpec.bx`/`InvokeSpec.bx` already
			 * use for their own real-binary-dependent proofs.
			 */
			it( "scopes the server's own BoxLang home to .build/runtime, not the shared ~/.boxlang default", function() {
				var executable = createObject( "java", "ortus.boxlang.bxagents.build.MiniServerLauncher" ).findExecutable();
				if ( isNull( executable ) ) {
					return;
				}

				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );

				var result = serveVerb.run( { projectRoot : projectRoot } );
				result.process.destroy();

				expect( result.serverHome ).toBe( projectRoot & "/.build/runtime" );

				var config = jsonDeserialize( fileRead( result.configPath ) );
				expect( config.serverHome ).toBe( projectRoot & "/.build/runtime" );
				expect( directoryExists( projectRoot & "/.build/runtime" ) ).toBeTrue();
			} );

			/**
			 * Regression: a real bug this closed - `serve` used to default to
			 * binding `0.0.0.0`, putting the served agent (and whatever
			 * provider API key it's driving) in reach of everyone on the
			 * network by default. Same skip idiom as the `serverHome` test
			 * above: the config write this asserts on happens AFTER the
			 * `findExecutable()` check, so it can't be proven up to a thrown
			 * `BxAgents.MiniServerNotFound` in a sandbox with no real binary.
			 */
			it( "binds to 127.0.0.1 by default, not every interface", function() {
				var executable = createObject( "java", "ortus.boxlang.bxagents.build.MiniServerLauncher" ).findExecutable();
				if ( isNull( executable ) ) {
					return;
				}

				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );

				var result = serveVerb.run( { projectRoot : projectRoot } );
				result.process.destroy();

				expect( result.host ).toBe( "127.0.0.1" );
				expect( result.message ).toInclude( "bound to 127.0.0.1 only" );

				var config = jsonDeserialize( fileRead( result.configPath ) );
				expect( config.host ).toBe( "127.0.0.1" );
			} );

			it( "binds to every interface when --host=0.0.0.0 is passed explicitly", function() {
				var executable = createObject( "java", "ortus.boxlang.bxagents.build.MiniServerLauncher" ).findExecutable();
				if ( isNull( executable ) ) {
					return;
				}

				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );

				var result = serveVerb.run( { projectRoot : projectRoot, host : "0.0.0.0" } );
				result.process.destroy();

				expect( result.host ).toBe( "0.0.0.0" );
				expect( result.message ).toInclude( "bound to ALL network interfaces" );

				var config = jsonDeserialize( fileRead( result.configPath ) );
				expect( config.host ).toBe( "0.0.0.0" );
			} );

		} );
	}

}
