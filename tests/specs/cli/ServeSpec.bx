class extends="testbox.system.BaseSpec" {

	/**
	 * A served app carries the bxagents module in its own runtime, copied from the installed module. A source checkout has none, so the
	 * specs that start a server name a stand-in folder: they only check what `serve` writes and starts, and stop the process at once.
	 */
	function beforeAll() {
		variables.stubModule = createTempDirectory( prefix = "bxagents-serve-module-" );
		fileWrite( stubModule & "/ModuleConfig.bx", "class {}" );
		variables.savedModule = new bxagents.models.util.Env().get( "BXAGENTS_MODULE_DIR" );
		createObject( "java", "java.lang.System" ).setProperty( "BXAGENTS_MODULE_DIR", stubModule );
	}

	function afterAll() {
		if ( len( variables.savedModule ) ) {
			createObject( "java", "java.lang.System" ).setProperty( "BXAGENTS_MODULE_DIR", variables.savedModule );
		} else {
			createObject( "java", "java.lang.System" ).clearProperty( "BXAGENTS_MODULE_DIR" );
		}
		directoryDelete( variables.stubModule, true );
	}

	function run() {
		describe( "cli.Serve", function() {

			beforeEach( function() {
				variables.buildVerb = new bxagents.models.cli.Build();
				variables.serveVerb = new bxagents.models.cli.Serve();
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempProject( required string fixtureName ) {
				var dir = createTempDirectory( prefix = "bxagents-cli-serve-" );
				directoryCopy( fixtures & "/" & arguments.fixtureName, dir, true );
				tempDirs.append( dir );
				return dir;
			}

			it( "errors cleanly if build hasn't run yet", function() {
				var projectRoot = newTempProject( "full-project" );

				expect( function() {
					serveVerb.run( { projectRoot : projectRoot } );
				} ).toThrow( "BxAgents.NotBuilt" );
			} );

			it( "errors clearly when boxlang-miniserver is not installed", function() {
				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );

				// Search an empty folder instead of the machine's PATH: a machine that has boxlang-miniserver installed (a CI runner
				// does) would otherwise never reach the "not found" failure path this exercises.
				var nowhere = createTempDirectory( prefix = "bxagents-cli-serve-nowhere-" );
				tempDirs.append( nowhere );
				expect( function() {
					serveVerb.run( { projectRoot : projectRoot, _path : nowhere } );
				} ).toThrow( "BxAgents.MiniServerNotFound" );
			} );

			/**
			 * Regression: a real bug this closed - the generated
			 * miniserver.json never set `serverHome` at all, so every served
			 * BX Agents project on a machine defaulted to sharing the same
			 * global `~/.boxlang` (compiled class cache, and any machine-level
			 * `~/.boxlang/config/boxlang.json` override applying to every
			 * served project equally). `serve` checks `findExecutable()`
			 * BEFORE writing the config, so this can't be proven up to a
			 * thrown `BxAgents.MiniServerNotFound` in this sandbox - skipped
			 * (rather than failed) when `boxlang-miniserver` isn't on PATH,
			 * same idiom `RuntimeStartupSmokeSpec.bx`/`InvokeSpec.bx` already
			 * use for their own real-binary-dependent proofs.
			 */
			it( "scopes the server's own BoxLang home to .build/runtime, not the shared ~/.boxlang default", function() {
				var executable = createObject( "java", "ortus.boxlang.bxagents.build.MiniServerLauncher" ).findExecutable();
				if ( isNull( executable ) ) {
					return;
				}

				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );

				var result = serveVerb.run( { projectRoot : projectRoot } );
				result.process.destroy();

				expect( result.serverHome ).toBe( projectRoot & "/.build/runtime" );

				// by a path relative to .build, where the server runs (see the next spec): the same file serves a packaged copy anywhere
				var config = jsonDeserialize( fileRead( result.configPath ) );
				expect( config.serverHome ).toBe( "runtime" );
				expect( directoryExists( projectRoot & "/.build/runtime" ) ).toBeTrue();
			} );

			it( "serves public/ with the template's engine config, by relative paths, from .build", function() {
				var executable = createObject( "java", "ortus.boxlang.bxagents.build.MiniServerLauncher" ).findExecutable();
				if ( isNull( executable ) ) {
					return;
				}

				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );

				var result = serveVerb.run( { projectRoot : projectRoot } );
				try {
					expect( result.configPath ).toBe( projectRoot & "/.build/miniserver.json" );
					var config = jsonDeserialize( fileRead( result.configPath ) );
					expect( config.webRoot ).toBe( "public" );
					expect( config.configPath ).toBe( "runtime/boxlang.json" );
					expect( config.rewrites ).toBeTrue();
					expect( config.rewriteFileName ).toBe( "index.bxm" );
					expect( config.healthCheck ).toBeTrue();
					expect( result.publicDir ).toBe( projectRoot & "/.build/public" );

					// the working folder of the server is .build, which is what `${user-dir}` means in runtime/boxlang.json (Linux only: /proc)
					var proc = createObject( "java", "java.io.File" ).init( "/proc/" & result.process.pid() & "/cwd" );
					if ( proc.exists() ) {
						expect( createObject( "java", "java.nio.file.Files" ).readSymbolicLink( proc.toPath() ).toString() ).toBe( projectRoot & "/.build" );
					}
				} finally {
					result.process.destroy();
				}
			} );

			it( "never names the machine's own module directory: no modulesDirectory, no config under the runtime home", function() {
				var executable = createObject( "java", "ortus.boxlang.bxagents.build.MiniServerLauncher" ).findExecutable();
				if ( isNull( executable ) ) {
					return;
				}

				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );
				var result = serveVerb.run( { projectRoot : projectRoot } );
				result.process.destroy();

				expect( fileRead( result.configPath ) ).notToInclude( "modulesDirectory" );
				expect( fileExists( projectRoot & "/.build/runtime/config/boxlang.json" ) ).toBeFalse();
				// the one module is the copy in the app's own runtime
				expect( directoryList( projectRoot & "/.build/runtime/modules", false, "name" ) ).toBe( [ "bxagents" ] );
			} );

			it( "stops with a clear error when the build has no bxagents module to load", function() {
				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );
				directoryDelete( projectRoot & "/.build/runtime/modules/bxagents", true );
				var saved = new bxagents.models.util.Env().get( "BXAGENTS_MODULE_DIR" );
				// "none": no module to copy, even though this suite runs from a built one
				createObject( "java", "java.lang.System" ).setProperty( "BXAGENTS_MODULE_DIR", "none" );
				try {
					expect( function() {
						serveVerb.run( { projectRoot : projectRoot } );
					} ).toThrow( "BxAgents.NoModuleInBuild" );
				} finally {
					createObject( "java", "java.lang.System" ).setProperty( "BXAGENTS_MODULE_DIR", saved );
				}
			} );

			it( "tells a build made before the app/public layout to build again", function() {
				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );
				directoryDelete( projectRoot & "/.build/public", true );
				expect( function() {
					serveVerb.run( { projectRoot : projectRoot } );
				} ).toThrow( "BxAgents.NotBuilt" );
			} );

			/**
			 * Regression: a real bug this closed - `serve` used to default to
			 * binding `0.0.0.0`, putting the served agent (and whatever
			 * provider API key it's driving) in reach of everyone on the
			 * network by default. Same skip idiom as the `serverHome` test
			 * above: the config write this asserts on happens AFTER the
			 * `findExecutable()` check, so it can't be proven up to a thrown
			 * `BxAgents.MiniServerNotFound` in a sandbox with no real binary.
			 */
			it( "binds to 127.0.0.1 by default, not every interface", function() {
				var executable = createObject( "java", "ortus.boxlang.bxagents.build.MiniServerLauncher" ).findExecutable();
				if ( isNull( executable ) ) {
					return;
				}

				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );

				var result = serveVerb.run( { projectRoot : projectRoot } );
				result.process.destroy();

				expect( result.host ).toBe( "127.0.0.1" );
				expect( result.message ).toInclude( "bound to 127.0.0.1 only" );

				var config = jsonDeserialize( fileRead( result.configPath ) );
				expect( config.host ).toBe( "127.0.0.1" );
			} );

			it( "binds to every interface when --host=0.0.0.0 is passed explicitly", function() {
				var executable = createObject( "java", "ortus.boxlang.bxagents.build.MiniServerLauncher" ).findExecutable();
				if ( isNull( executable ) ) {
					return;
				}

				var projectRoot = newTempProject( "full-project" );
				buildVerb.run( { projectRoot : projectRoot } );

				var result = serveVerb.run( { projectRoot : projectRoot, host : "0.0.0.0" } );
				result.process.destroy();

				expect( result.host ).toBe( "0.0.0.0" );
				expect( result.message ).toInclude( "bound to ALL network interfaces" );

				var config = jsonDeserialize( fileRead( result.configPath ) );
				expect( config.host ).toBe( "0.0.0.0" );
			} );

		} );
	}

}
