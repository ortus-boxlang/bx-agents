class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "api.IpAllowList", function() {

			it( "lets everyone in when the list is empty", function() {
				expect( new bxagents.models.api.IpAllowList( [] ).allows( "198.51.100.9" ) ).toBeTrue();
				expect( new bxagents.models.api.IpAllowList().allows( "" ) ).toBeTrue();
			} );

			it( "matches single addresses and networks", function() {
				var list = new bxagents.models.api.IpAllowList( [ "203.0.113.7", "10.0.0.0/8", "192.168.1.128/25" ] );

				expect( list.allows( "203.0.113.7" ) ).toBeTrue();
				expect( list.allows( "203.0.113.8" ) ).toBeFalse();
				expect( list.allows( "10.200.3.4" ) ).toBeTrue();
				expect( list.allows( "11.0.0.1" ) ).toBeFalse();
				expect( list.allows( "192.168.1.200" ) ).toBeTrue();
				expect( list.allows( "192.168.1.100" ) ).toBeFalse();
			} );

			it( "matches IPv6 addresses and networks, and keeps the two families apart", function() {
				var list = new bxagents.models.api.IpAllowList( [ "::1", "fd00::/8" ] );

				expect( list.allows( "::1" ) ).toBeTrue();
				expect( list.allows( "fd12:3456::1" ) ).toBeTrue();
				expect( list.allows( "fe80::1" ) ).toBeFalse();
				expect( list.allows( "127.0.0.1" ) ).toBeFalse();
			} );

			it( "refuses an address it cannot read, rather than letting it in", function() {
				var list = new bxagents.models.api.IpAllowList( [ "10.0.0.0/8" ] );

				expect( list.allows( "" ) ).toBeFalse();
				expect( list.allows( "not-an-ip" ) ).toBeFalse();
			} );

			it( "says what is wrong with a configured list", function() {
				expect( bxagents.models.api.IpAllowList::problems( [ "10.0.0.0/8", "::1" ] ) ).toBeEmpty();
				expect( bxagents.models.api.IpAllowList::problems( "10.0.0.0/8" ) ).toHaveLength( 1 );
				expect( bxagents.models.api.IpAllowList::problems( [ "example.com" ] ) ).toHaveLength( 1 );
				expect( bxagents.models.api.IpAllowList::problems( [ "10.0.0.0/33" ] ) ).toHaveLength( 1 );
				expect( bxagents.models.api.IpAllowList::problems( [ "999.1.1.1" ] ) ).toHaveLength( 1 );
			} );

		} );
	}

}
