import bxModules.bxagents.models.api.AccessMode;

class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "api.AccessMode", function() {

			it( "is open with nothing set, and token when a secret or issued tokens are set", function() {
				expect( AccessMode::of( {} ) ).toBe( "open" );
				expect( AccessMode::of( { tokenEnvVar : "AGENT_TOKEN" } ) ).toBe( "token" );
				expect( AccessMode::of( { tokens : true } ) ).toBe( "token" );
				expect( AccessMode::of( { tokens : false, tokenEnvVar : " " } ) ).toBe( "open" );
			} );

			it( "lets access say it outright", function() {
				expect( AccessMode::of( { access : "open" } ) ).toBe( "open" );
				expect( AccessMode::of( { access : "TOKEN", tokens : true } ) ).toBe( "token" );
			} );

			it( "finds a setting that contradicts itself", function() {
				expect( AccessMode::problems( {} ) ).toBeEmpty();
				expect( AccessMode::problems( { access : "open" } ) ).toBeEmpty();
				expect( AccessMode::problems( { access : "token", tokens : true } ) ).toBeEmpty();
				expect( AccessMode::problems( { access : "closed" } )[ 1 ] ).toInclude( "open or token" );
				expect( AccessMode::problems( { access : "open", tokens : true } )[ 1 ] ).toInclude( "Remove one or the other" );
				expect( AccessMode::problems( { access : "token" } )[ 1 ] ).toInclude( "which token" );
			} );

		} );

		describe( "api.Authenticator", function() {

			beforeEach( function() {
				variables.dir = createTempDirectory( prefix = "bxagents-auth-" );
				variables.store = bxagents.models.store.ChatStore::forFile( dir & "/chat.db" );
				variables.tokens = new bxagents.models.store.TokenService( store );
			} );

			afterEach( function() {
				if ( directoryExists( dir ) ) {
					directoryDelete( dir, true );
				}
			} );

			it( "lets nobody in who sends no token", function() {
				var auth = new bxagents.models.api.Authenticator( tokens = true, tokenService = tokens );

				expect( isNull( auth.authenticate( {} ) ) ).toBeTrue();
			} );

			it( "lets an issued token in as its owner, with its scope, and the surface it says", function() {
				var made = tokens.create( "laptop", "chat" );
				var auth = new bxagents.models.api.Authenticator( tokens = true, tokenService = tokens );

				var who = auth.authenticate( { "x-bxagents-token" : made.token, "x-bxagents-source" : "terminal" } );
				expect( who.id() ).toBe( "laptop" );
				expect( who.isAdmin() ).toBeFalse();
				expect( who.source() ).toBe( "terminal" );
			} );

			it( "refuses a made-up, a revoked and an expired token", function() {
				var auth = new bxagents.models.api.Authenticator( tokens = true, tokenService = tokens );
				var made = tokens.create( "gone" );
				tokens.revoke( "gone" );

				expect( isNull( auth.authenticate( { "x-bxagents-token" : "bxa_nope" } ) ) ).toBeTrue();
				expect( isNull( auth.authenticate( { "x-bxagents-token" : made.token } ) ) ).toBeTrue();
			} );

			it( "does not look at issued tokens when they are not turned on", function() {
				var made = tokens.create( "laptop" );
				var auth = new bxagents.models.api.Authenticator( tokenEnvVar = "", tokens = false, tokenService = tokens );

				expect( isNull( auth.authenticate( { "x-bxagents-token" : made.token } ) ) ).toBeTrue();
			} );

			it( "takes the shared secret from the environment variable, and never when it is unset", function() {
				var auth = new bxagents.models.api.Authenticator( tokenEnvVar = "BXAGENTS_SPEC_UNSET_VARIABLE" );

				expect( isNull( auth.authenticate( { "x-bxagents-token" : "" } ) ) ).toBeTrue();
				// an unset variable matches nothing, not even an empty guess
				expect( isNull( auth.authenticate( { "x-bxagents-token" : "anything" } ) ) ).toBeTrue();
			} );

			it( "compares the shared secret in constant time", function() {
				var source = fileRead( expandPath( "/bxagents/models/api/Authenticator.bx" ) );

				expect( source ).toInclude( "MessageDigest" );
				expect( source ).toInclude( "isEqual(" );
				// an unset or blank variable matches nothing
				expect( source ).toInclude( "len( expected ) &&" );
			} );

			describe( "the middleware", function() {

				it( "refuses a request that proves nothing with a 401, and stops the action", function() {
					var event = new FakeEvent();
					var auth = new bxagents.models.api.Authenticator( tokens = true, tokenService = tokens );

					expect( auth.guard( event, {} ) ).toBeTrue();
					expect( event.stopped() ).toBeTrue();
					expect( event.rendered().statusCode ).toBe( 401 );
					expect( event.rendered().data.code ).toBe( "unauthorized" );
				} );

				it( "names the caller on the request for a good token, and needs no csrf header for it", function() {
					var event = new FakeEvent( "POST" );
					var made = tokens.create( "laptop" );
					var auth = new bxagents.models.api.Authenticator( tokens = true, tokenService = tokens );

					expect( auth.guard( event, { "x-bxagents-token" : made.token } ) ).toBeFalse();
					expect( event.caller().id() ).toBe( "laptop" );
				} );

				it( "lets a page that is signed in read, as the web user, with its account as the caller", function() {
					var event = new FakeEvent( "GET", true, "ada-id" );
					var auth = new bxagents.models.api.Authenticator( accounts = true, tokenService = tokens );

					expect( auth.guard( event, {} ) ).toBeFalse();
					expect( event.caller().id() ).toBe( "ada-id" );
					expect( event.caller().source() ).toBe( "web" );
				} );

				it( "wants the csrf header from a signed-in page that changes something, and refuses a form from another site", function() {
					var auth = new bxagents.models.api.Authenticator( accounts = true, tokenService = tokens );

					var without = new FakeEvent( "POST", true );
					expect( auth.guard( without, {} ) ).toBeTrue();
					expect( without.rendered().statusCode ).toBe( 403 );
					expect( without.rendered().data.code ).toBe( "csrf" );

					var withHeader = new FakeEvent( "POST", true );
					expect( auth.guard( withHeader, { "x-bxagents-csrf" : "1" } ) ).toBeFalse();
				} );

				it( "keeps out an address that is not on agentApi.allowedIPs, before it asks for a token", function() {
					var auth = new bxagents.models.api.Authenticator( tokens = true, tokenService = tokens, allowedIPs = [ "10.0.0.0/8", "203.0.113.7" ] );
					var made = tokens.create( "laptop" );

					var outside = new FakeEvent( "POST" );
					expect( auth.guard( outside, { "x-bxagents-token" : made.token }, "198.51.100.9" ) ).toBeTrue();
					expect( outside.rendered().statusCode ).toBe( 403 );
					expect( outside.rendered().data.code ).toBe( "forbidden" );

					expect( auth.guard( new FakeEvent( "POST" ), { "x-bxagents-token" : made.token }, "10.4.5.6" ) ).toBeFalse();
					expect( auth.guard( new FakeEvent( "POST" ), { "x-bxagents-token" : made.token }, "203.0.113.7" ) ).toBeFalse();
				} );

				it( "counts a caller against agentApi.rateLimit and answers 429 with Retry-After once it is over", function() {
					var auth = new bxagents.models.api.Authenticator( tokens = true, tokenService = tokens, rateLimit = { requests : 2, perSeconds : 60 } );
					var made = tokens.create( "limited-" & createUUID().left( 8 ) );
					var headers = { "x-bxagents-token" : made.token };

					expect( auth.guard( new FakeEvent( "POST" ), headers, "1.1.1.1" ) ).toBeFalse();
					expect( auth.guard( new FakeEvent( "POST" ), headers, "1.1.1.1" ) ).toBeFalse();
					var third = new FakeEvent( "POST" );
					expect( auth.guard( third, headers, "1.1.1.1" ) ).toBeTrue();
					expect( third.rendered().statusCode ).toBe( 429 );
					expect( third.rendered().data.code ).toBe( "rate_limited" );
					expect( val( third.header( "Retry-After" ) ) ).toBeGTE( 1 );
				} );

				it( "on an open API only keeps the addresses and the limit, and asks nobody for a token", function() {
					var auth = new bxagents.models.api.Authenticator( open = true, allowedIPs = [ "127.0.0.1" ], rateLimit = { requests : 1, perSeconds : 60 } );
					var address = "127.0.0.1";

					var first = new FakeEvent();
					expect( auth.guard( first, {}, address ) ).toBeFalse();
					expect( first.privateValueExists( "bxagentsCaller" ) ).toBeFalse();
					expect( auth.guard( new FakeEvent(), {}, address ) ).toBeTrue();
					expect( auth.guard( new FakeEvent(), {}, "8.8.8.8" ) ).toBeTrue();
				} );

				it( "refuses a page that is not signed in", function() {
					var auth = new bxagents.models.api.Authenticator( accounts = true, tokenService = tokens );

					expect( auth.guard( new FakeEvent( "GET", false ), {} ) ).toBeTrue();
				} );

				it( "ignores the page's sign-in when the API does not take accounts", function() {
					var auth = new bxagents.models.api.Authenticator( accounts = false, tokenService = tokens );

					expect( auth.guard( new FakeEvent( "GET", true ), {} ) ).toBeTrue();
				} );

			} );

			it( "ignores a surface name that is not a plain name", function() {
				var made = tokens.create( "laptop" );
				var auth = new bxagents.models.api.Authenticator( tokens = true, tokenService = tokens );

				expect( auth.authenticate( { "x-bxagents-token" : made.token, "x-bxagents-source" : "Web Page!" } ).source() ).toBe( "api" );
			} );

		} );
	}

}
