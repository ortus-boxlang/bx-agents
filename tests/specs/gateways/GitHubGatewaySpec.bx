import bxModules.bxai.models.gateway.contracts.GatewayContext;
import bxModules.bxai.models.gateway.contracts.GatewayEvent;
import bxModules.bxai.models.gateway.contracts.HumanInteractionRequest;

class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "GitHubGateway", function() {

			beforeEach( function() {
				variables.gateway = new bxagents.models.gateways.GitHubGateway();
				variables.gateway.configure( {
					token        : "ghp_test",
					webhookSecret: "shh-webhook-secret",
					botName      : "mybot"
				} );
			} );

			private function computeSignature( required string secret, required string body ) {
				var keySpec = createObject( "java", "javax.crypto.spec.SecretKeySpec" ).init( charsetDecode( secret, "UTF-8" ), "HmacSHA256" )
				var mac = createObject( "java", "javax.crypto.Mac" ).getInstance( "HmacSHA256" )
				mac.init( keySpec )
				var digest = mac.doFinal( charsetDecode( body, "UTF-8" ) )
				return "sha256=" & binaryEncode( digest, "hex" ).lCase()
			}

			private function issueCommentPayload( string body = "@mybot help me out", string login = "octocat", string authorType = "User", numeric issueNumber = 42, string commentId = "555" ) {
				return {
					action: "created",
					comment: { id: arguments.commentId, body: arguments.body, user: { login: arguments.login, type: arguments.authorType } },
					issue: { number: arguments.issueNumber },
					repository: { name: "myrepo", owner: { login: "myorg" } }
				}
			}

			private function stubApi( required struct response ) {
				var calls = []
				gateway.setApiCaller( function( path, method, body ) {
					calls.append( { path: path, method: method, body: body } )
					return response
				} )
				return calls
			}

			it( "declares inboundMessages/outboundMessages/threads/humanApproval but NOT interactiveActions/streaming", function() {
				var capabilities = gateway.getDeclaredCapabilities()
				expect( capabilities ).toInclude( "inboundMessages" )
				expect( capabilities ).toInclude( "outboundMessages" )
				expect( capabilities ).toInclude( "threads" )
				expect( capabilities ).toInclude( "humanApproval" )
				expect( capabilities ).notToInclude( "interactiveActions" )
				expect( capabilities ).notToInclude( "streaming" )
			} );

			it( "start() throws GitHubGateway.MissingConfig when token/botName are missing", function() {
				var unconfigured = new bxagents.models.gateways.GitHubGateway()
				expect( function() {
					unconfigured.start()
				} ).toThrow( "GitHubGateway.MissingConfig" )
			} );

			it( "start() does not throw once token/botName are present", function() {
				expect( function() {
					gateway.start()
				} ).notToThrow()
				expect( gateway.isRunning() ).toBeTrue()
			} );

			describe( "handleWebhook()", function() {

				it( "returns 503 when webhookSecret was never configured", function() {
					var unconfigured = new bxagents.models.gateways.GitHubGateway()
					var result = unconfigured.handleWebhook( "{}", "sha256=whatever", "issue_comment", "d1" )
					expect( result.status ).toBe( 503 )
				} );

				it( "returns 401 and does not dispatch when the signature is invalid", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var raw = jsonSerialize( issueCommentPayload() )
					var result = gateway.handleWebhook( raw, "sha256=deadbeef", "issue_comment", "d1" )

					expect( result.status ).toBe( 401 )
					expect( dispatched.len() ).toBe( 0 )
				} );

				it( "cross-verifies against a hand-computed HMAC-SHA256 signature - accepts a correctly-signed @mention comment, returns 200, dispatches with the mention stripped", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var raw = jsonSerialize( issueCommentPayload( "@mybot please help me with this" ) )
					var sig = computeSignature( "shh-webhook-secret", raw )

					var result = gateway.handleWebhook( raw, sig, "issue_comment", "d1" )

					expect( result.status ).toBe( 200 )
					expect( dispatched.len() ).toBe( 1 )
					expect( dispatched[ 1 ].getText() ).toBe( "please help me with this" )
					expect( dispatched[ 1 ].getContext().getConversationID() ).toBe( "repo:myorg/myrepo:issue:42" )
				} );

				it( "does not dispatch a comment that never @mentions the bot", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var raw = jsonSerialize( issueCommentPayload( "just a regular comment" ) )
					var sig = computeSignature( "shh-webhook-secret", raw )
					var result = gateway.handleWebhook( raw, sig, "issue_comment", "d1" )

					expect( result.status ).toBe( 200 )
					expect( dispatched.len() ).toBe( 0 )
				} );

				it( "does not match a longer bot name as a substring (@mybot2 must not trigger @mybot)", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var raw = jsonSerialize( issueCommentPayload( "@mybot2 hello" ) )
					var sig = computeSignature( "shh-webhook-secret", raw )
					gateway.handleWebhook( raw, sig, "issue_comment", "d1" )

					expect( dispatched.len() ).toBe( 0 )
				} );

				it( "ignores a comment authored by any Bot-type user, even with a mention", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var raw = jsonSerialize( issueCommentPayload( "@mybot echo", "some-other-bot", "Bot" ) )
					var sig = computeSignature( "shh-webhook-secret", raw )
					gateway.handleWebhook( raw, sig, "issue_comment", "d1" )

					expect( dispatched.len() ).toBe( 0 )
				} );

				it( "ignores a comment containing this gateway's own loop-guard marker", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var raw = jsonSerialize( issueCommentPayload( "@mybot some text" & char( 10 ) & "<!-- bxagents:posted -->" ) )
					var sig = computeSignature( "shh-webhook-secret", raw )
					gateway.handleWebhook( raw, sig, "issue_comment", "d1" )

					expect( dispatched.len() ).toBe( 0 )
				} );

				it( "dedups by X-GitHub-Delivery - the same delivery id delivered twice only dispatches once", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var raw = jsonSerialize( issueCommentPayload( "@mybot hi" ) )
					var sig = computeSignature( "shh-webhook-secret", raw )

					gateway.handleWebhook( raw, sig, "issue_comment", "same-delivery-id" )
					gateway.handleWebhook( raw, sig, "issue_comment", "same-delivery-id" )

					expect( dispatched.len() ).toBe( 1 )
				} );

				it( "ignores non-created actions (edited/deleted) on issue_comment", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var payload = issueCommentPayload( "@mybot hi" )
					payload.action = "edited"
					var raw = jsonSerialize( payload )
					var sig = computeSignature( "shh-webhook-secret", raw )
					gateway.handleWebhook( raw, sig, "issue_comment", "d1" )

					expect( dispatched.len() ).toBe( 0 )
				} );

				it( "acknowledges (200) but ignores unrecognized event kinds", function() {
					var raw = jsonSerialize( { zen: "Keep it logically awesome." } )
					var sig = computeSignature( "shh-webhook-secret", raw )
					var result = gateway.handleWebhook( raw, sig, "ping", "d1" )
					expect( result.status ).toBe( 200 )
				} );

				it( "threads a pull_request_review_comment reply on the root comment id (in_reply_to_id), not the reply's own id", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var payload = {
						action: "created",
						comment: { id: 700, body: "@mybot what does this mean?", user: { login: "octocat", type: "User" }, in_reply_to_id: 650 },
						pull_request: { number: 10 },
						repository: { name: "myrepo", owner: { login: "myorg" } }
					}
					var raw = jsonSerialize( payload )
					var sig = computeSignature( "shh-webhook-secret", raw )
					var result = gateway.handleWebhook( raw, sig, "pull_request_review_comment", "d1" )

					expect( result.status ).toBe( 200 )
					expect( dispatched.len() ).toBe( 1 )
					expect( dispatched[ 1 ].getContext().getConversationID() ).toBe( "repo:myorg/myrepo:review-comment:650" )
				} );

			} );

			describe( "human-in-the-loop reply correlation (degraded - @mention-to-reply, keyed by conversationID)", function() {

				it( "requestHumanInteraction() posts a comment with reply instructions, then a matching @mention reply routes to the decision path instead of ordinary dispatch", function() {
					stubApi( { status: 201, body: { id: 900 } } )
					var humanRequest = new HumanInteractionRequest(
						title: "Approve?", message: "delete_file(x)", allowedDecisions: [ "approve", "reject" ]
					)
					var context = new GatewayContext( conversationID: "repo:myorg/myrepo:issue:42", metadata: { owner: "myorg", repo: "myrepo", issueNumber: 42, conversationKind: "issue" } )
					gateway.requestHumanInteraction( humanRequest, context )

					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var raw = jsonSerialize( issueCommentPayload( "@mybot approve" ) )
					var sig = computeSignature( "shh-webhook-secret", raw )
					var result = gateway.handleWebhook( raw, sig, "issue_comment", "d-reply-1" )

					expect( result.status ).toBe( 200 )
					expect( dispatched.len() ).toBe( 0 )
				} );

			} );

			describe( "deliver()", function() {

				it( "posts a comment to the issue's own comments endpoint, with the loop-guard marker appended", function() {
					var calls = stubApi( { status: 201, body: { id: 901 } } )
					var event = new GatewayEvent( type: "response.completed", data: { text: "Here is your answer." } )
					var context = new GatewayContext( conversationID: "repo:myorg/myrepo:issue:42", metadata: { owner: "myorg", repo: "myrepo", issueNumber: 42, conversationKind: "issue" } )

					var result = gateway.deliver( event, context )

					expect( calls.len() ).toBe( 1 )
					expect( calls[ 1 ].path ).toBe( "repos/myorg/myrepo/issues/42/comments" )
					expect( calls[ 1 ].body.body ).toInclude( "Here is your answer." )
					expect( calls[ 1 ].body.body ).toInclude( "<!-- bxagents:posted -->" )
					expect( result.getSuccess() ).toBeTrue()
					expect( result.getDeliveryID() ).toBe( "901" )
				} );

				it( "posts a review-thread reply to the pulls/comments/{id}/replies endpoint when conversationKind is review_thread", function() {
					var calls = stubApi( { status: 201, body: { id: 902 } } )
					var event = new GatewayEvent( type: "response.completed", data: { text: "Good point." } )
					var context = new GatewayContext(
						conversationID: "repo:myorg/myrepo:review-comment:650",
						metadata      : { owner: "myorg", repo: "myrepo", pullRequestNumber: 10, conversationKind: "review_thread", reviewCommentId: 650 }
					)

					gateway.deliver( event, context )

					expect( calls[ 1 ].path ).toBe( "repos/myorg/myrepo/pulls/10/comments/650/replies" )
				} );

				it( "returns a failure result when the GitHub API rejects the send", function() {
					stubApi( { status: 403, body: { message: "Resource not accessible by integration" } } )
					var event = new GatewayEvent( type: "response.completed", data: { text: "hi" } )
					var context = new GatewayContext( conversationID: "repo:myorg/myrepo:issue:42", metadata: { owner: "myorg", repo: "myrepo", issueNumber: 42, conversationKind: "issue" } )

					var result = gateway.deliver( event, context )

					expect( result.getSuccess() ).toBeFalse()
					expect( result.getError() ).toInclude( "Resource not accessible by integration" )
				} );

			} );

			it( "parseHumanDecision() reads requestID/decision/decidedBy from a GatewayEvent's data", function() {
				var event = new GatewayEvent( type: "interaction.decision", data: { requestID: "req-1", decision: "reject", decidedBy: "octocat" } )

				var decision = gateway.parseHumanDecision( event )

				expect( decision.getRequestID() ).toBe( "req-1" )
				expect( decision.getDecision() ).toBe( "reject" )
				expect( decision.getDecidedBy() ).toBe( "octocat" )
			} );

		} )
	}

}
