import bxModules.bxai.models.gateway.contracts.GatewayContext;
import bxModules.bxai.models.gateway.contracts.GatewayEvent;
import bxModules.bxai.models.gateway.contracts.HumanInteractionRequest;

class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "TwilioGateway", function() {

			beforeEach( function() {
				variables.gateway = new bxagents.models.gateways.TwilioGateway();
				variables.gateway.configure( {
					accountSid: "AC-test-account",
					authToken : "shh-auth-token",
					from      : "+15559998888"
				} );
			} );

			private function computeSignature( required string authToken, required string url, required struct params ) {
				var sortedKeys = arguments.params.keyArray().sort( "text" )
				var base = arguments.url
				for ( var key in sortedKeys ) {
					base &= key & arguments.params[ key ]
				}
				var keySpec = createObject( "java", "javax.crypto.spec.SecretKeySpec" ).init( charsetDecode( arguments.authToken, "UTF-8" ), "HmacSHA1" )
				var mac = createObject( "java", "javax.crypto.Mac" ).getInstance( "HmacSHA1" )
				mac.init( keySpec )
				var digest = mac.doFinal( charsetDecode( base, "UTF-8" ) )
				return binaryEncode( digest, "base64" )
			}

			private string function formEncode( required struct params ) {
				var pairs = []
				for ( var key in arguments.params.keyArray().sort( "text" ) ) {
					pairs.append( key & "=" & urlEncodedFormat( arguments.params[ key ] ) )
				}
				return pairs.toList( "&" )
			}

			private function stubApi( required struct response ) {
				var calls = []
				gateway.setApiCaller( function( body ) {
					calls.append( { body: body } )
					return response
				} )
				return calls
			}

			it( "declares inboundMessages/outboundMessages/humanApproval but NOT interactiveActions/threads/streaming", function() {
				var capabilities = gateway.getDeclaredCapabilities()
				expect( capabilities ).toInclude( "inboundMessages" )
				expect( capabilities ).toInclude( "outboundMessages" )
				expect( capabilities ).toInclude( "humanApproval" )
				expect( capabilities ).notToInclude( "interactiveActions" )
				expect( capabilities ).notToInclude( "threads" )
				expect( capabilities ).notToInclude( "streaming" )
			} );

			it( "start() throws TwilioGateway.MissingConfig when accountSid/authToken/from are missing", function() {
				var unconfigured = new bxagents.models.gateways.TwilioGateway()
				expect( function() {
					unconfigured.start()
				} ).toThrow( "TwilioGateway.MissingConfig" )
			} );

			it( "start() does not throw once accountSid/authToken/from are present", function() {
				expect( function() {
					gateway.start()
				} ).notToThrow()
				expect( gateway.isRunning() ).toBeTrue()
			} );

			describe( "handleWebhook()", function() {

				it( "returns 503 when authToken was never configured", function() {
					var unconfigured = new bxagents.models.gateways.TwilioGateway()
					var result = unconfigured.handleWebhook( "https://example.com/webhooks/twilio", "whatever", "Body=hi" )
					expect( result.status ).toBe( 503 )
				} );

				it( "returns 401 and does not dispatch when the signature is invalid", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var params = { AccountSid: "AC-test-account", Body: "hello", From: "+15551234567" }
					var rawBody = formEncode( params )
					var result = gateway.handleWebhook( "https://example.com/webhooks/twilio", "sha1=deadbeef", rawBody )

					expect( result.status ).toBe( 401 )
					expect( dispatched.len() ).toBe( 0 )
				} );

				it( "cross-verifies against a hand-computed HMAC-SHA1 signature - accepts a correctly-signed payload, returns TwiML 200, and dispatches a normalized inbound message", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var url = "https://example.com/webhooks/twilio"
					var params = { AccountSid: "AC-test-account", Body: "hello there", From: "+15551234567" }
					var sig = computeSignature( "shh-auth-token", url, params )
					var rawBody = formEncode( params )

					var result = gateway.handleWebhook( url, sig, rawBody )

					expect( result.status ).toBe( 200 )
					expect( result.body ).toBe( "<Response></Response>" )
					expect( result.contentType ).toBe( "text/xml" )
					expect( dispatched.len() ).toBe( 1 )
					expect( dispatched[ 1 ].getText() ).toBe( "hello there" )
					expect( dispatched[ 1 ].getContext().getConversationID() ).toBe( "+15551234567" )
				} );

				it( "uses the publicUrl override (not the passed-in requestUrl) for signature verification when configured", function() {
					var overridden = new bxagents.models.gateways.TwilioGateway()
					overridden.configure( { accountSid: "AC-test-account", authToken: "shh-auth-token", from: "+15559998888", publicUrl: "https://public.example.com/webhooks/twilio" } )

					var params = { AccountSid: "AC-test-account", Body: "hi", From: "+15551234567" }
					var sig = computeSignature( "shh-auth-token", "https://public.example.com/webhooks/twilio", params )
					var rawBody = formEncode( params )

					// A totally different requestUrl is passed in, but the publicUrl override should still verify correctly.
					var result = overridden.handleWebhook( "https://internal-proxy:8080/some/other/path", sig, rawBody )
					expect( result.status ).toBe( 200 )
				} );

				it( "URL-decodes form-encoded values, including a literal '+' encoded as %2B", function() {
					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var url = "https://example.com/webhooks/twilio"
					var params = { AccountSid: "AC-test-account", Body: "hi", From: "+15551234567" }
					var sig = computeSignature( "shh-auth-token", url, params )
					var rawBody = "AccountSid=AC-test-account&Body=hi&From=%2B15551234567"

					var result = gateway.handleWebhook( url, sig, rawBody )
					expect( result.status ).toBe( 200 )
					expect( dispatched[ 1 ].getContext().getConversationID() ).toBe( "+15551234567" )
				} );

			} );

			describe( "human-in-the-loop reply correlation (degraded - plain text, keyed by phone number)", function() {

				it( "requestHumanInteraction() sends a plain-text SMS listing allowed decisions, then a matching reply routes to the decision path instead of ordinary dispatch", function() {
					stubApi( { status: 200, body: { sid: "SM-out-1" } } )
					var humanRequest = new HumanInteractionRequest(
						title: "Approve?", message: "delete_file(x)", allowedDecisions: [ "approve", "reject" ]
					)
					var context = new GatewayContext( conversationID: "+15551234567", threadID: "thread-1" )
					gateway.requestHumanInteraction( humanRequest, context )

					var dispatched = []
					gateway.onMessage( function( m ) { dispatched.append( m ); } )

					var url = "https://example.com/webhooks/twilio"
					var params = { AccountSid: "AC-test-account", Body: "approve", From: "+15551234567" }
					var sig = computeSignature( "shh-auth-token", url, params )
					var result = gateway.handleWebhook( url, sig, formEncode( params ) )

					expect( result.status ).toBe( 200 )
					// The reply was consumed as a decision, not dispatched as an ordinary message.
					expect( dispatched.len() ).toBe( 0 )
				} );

			} );

			describe( "deliver()", function() {

				it( "sends a text message via the Messages API with To/Body/From", function() {
					var calls = stubApi( { status: 201, body: { sid: "SM-out-1" } } )
					var event = new GatewayEvent( type: "response.completed", data: { text: "Your order shipped." } )
					var context = new GatewayContext( conversationID: "+15551234567" )

					var result = gateway.deliver( event, context )

					expect( calls.len() ).toBe( 1 )
					expect( calls[ 1 ].body.To ).toBe( "+15551234567" )
					expect( calls[ 1 ].body.Body ).toBe( "Your order shipped." )
					expect( calls[ 1 ].body.From ).toBe( "+15559998888" )
					expect( result.getSuccess() ).toBeTrue()
					expect( result.getDeliveryID() ).toBe( "SM-out-1" )
				} );

				it( "uses MessagingServiceSid instead of From when configured", function() {
					var withMsgService = new bxagents.models.gateways.TwilioGateway()
					withMsgService.configure( { accountSid: "AC-test-account", authToken: "shh-auth-token", from: "+15559998888", messagingServiceSid: "MG-test-service" } )
					var calls = []
					withMsgService.setApiCaller( function( body ) { calls.append( { body: body } ); return { status: 200, body: { sid: "SM-1" } } } )

					var event = new GatewayEvent( type: "response.completed", data: { text: "hi" } )
					var context = new GatewayContext( conversationID: "+15551234567" )
					withMsgService.deliver( event, context )

					expect( calls[ 1 ].body.keyExists( "MessagingServiceSid" ) ).toBeTrue()
					expect( calls[ 1 ].body.MessagingServiceSid ).toBe( "MG-test-service" )
					expect( calls[ 1 ].body.keyExists( "From" ) ).toBeFalse()
				} );

				it( "splits text longer than the 1600-char limit into multiple sends", function() {
					var calls = stubApi( { status: 201, body: { sid: "SM-out-1" } } )
					var longText = repeatString( "a", 2000 )
					var event = new GatewayEvent( type: "response.completed", data: { text: longText } )
					var context = new GatewayContext( conversationID: "+15551234567" )

					gateway.deliver( event, context )

					expect( calls.len() ).toBeGT( 1 )
				} );

				it( "returns a failure result when the Messages API rejects the send", function() {
					stubApi( { status: 400, body: { message: "Invalid 'To' Phone Number" } } )
					var event = new GatewayEvent( type: "response.completed", data: { text: "hi" } )
					var context = new GatewayContext( conversationID: "not-a-number" )

					var result = gateway.deliver( event, context )

					expect( result.getSuccess() ).toBeFalse()
					expect( result.getError() ).toInclude( "Invalid 'To' Phone Number" )
				} );

			} );

			it( "parseHumanDecision() reads requestID/decision/decidedBy from a GatewayEvent's data", function() {
				var event = new GatewayEvent( type: "interaction.decision", data: { requestID: "req-1", decision: "reject", decidedBy: "+15551234567" } )

				var decision = gateway.parseHumanDecision( event )

				expect( decision.getRequestID() ).toBe( "req-1" )
				expect( decision.getDecision() ).toBe( "reject" )
				expect( decision.getDecidedBy() ).toBe( "+15551234567" )
			} );

		} )
	}

}
