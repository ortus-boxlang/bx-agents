/**
 * A command that answers with a pick-one, for the gateway session spec. Choosing runs /shade with the colour.
 */
class extends="bxagents.models.chat.commands.BaseCommand" {

	string function name() {
		return "pick"
	}

	any function run( required any context, required string args ) {
		if ( len( arguments.args ) ) {
			return arguments.context.reply().text( "Picked " & arguments.args )
		}
		return arguments.context.reply().choose( "Pick a colour", [
			{ label : "red", hint : "warm", line : "/pick red" },
			{ label : "blue", hint : "cool", line : "/pick blue" }
		] )
	}

}
