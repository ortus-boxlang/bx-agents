/**
 * Commands in front of the agent on a gateway: a command the session offers is answered by the command
 * layer through the gateway the message came from; anything else still reaches the agent.
 */
import bxModules.bxai.models.gateway.contracts.GatewayContext;
import bxModules.bxai.models.gateway.contracts.GatewayMessage;

class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "CommandGatewaySession", function() {

			function message( required string text, string user = "u-1", string conversation = "chat-1" ) {
				var context = new GatewayContext( gateway : "mock", conversationID : conversation, userID : user );
				return new GatewayMessage( text : text, context : context );
			}

			function replies() {
				return mock.getDeliveredEvents().map( e => e.getData().content );
			}

			beforeEach( function() {
				variables.mock = aiGateway( "mock" );
				variables.agent = aiAgent( name : "helper", model : aiModel( provider : "mock" ), memory : aiMemory( "cache" ) );
			} );

			it( "answers /help itself, with the commands it offers, and never calls the agent", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ] );
				var done = session.handleInbound( message( "/help" ), mock );

				expect( isNull( done ) ).toBeTrue();
				expect( replies() ).toHaveLength( 1 );
				expect( replies()[ 1 ] ).toInclude( "/info" );
				expect( replies()[ 1 ] ).notToInclude( "/copy" );
				expect( session.getActiveThreadIds() ).toBeEmpty();
			} );

			it( "reads the prefix a gateway was given instead of the session's", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { prefixes : { mock : "!" } } );
				session.handleInbound( message( "!info" ), mock );
				expect( replies()[ 1 ] ).toInclude( "Agent: helper" );

				var done = session.handleInbound( message( "/info" ), mock );
				expect( isNull( done ) ).toBeFalse();
				done.get();
			} );

			it( "hands its menu to a gateway that can show one, once, on the first message", function() {
				var shown = [];
				mock.publishCommands = ( menu ) => { shown.append( menu.map( c => c.name ) ); return true; };
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ] );
				session.handleInbound( message( "/help" ), mock );
				session.handleInbound( message( "/help" ), mock );

				expect( shown ).toHaveLength( 1 );
				expect( shown[ 1 ] ).toBe( [ "/help", "/tools", "/model", "/ping", "/info", "/remember", "/notes" ] );
			} );

			it( "keeps answering when a gateway fails to take the menu", function() {
				mock.publishCommands = ( menu ) => { throw( message = "boom" ); };
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ] );
				session.handleInbound( message( "/help" ), mock );
				expect( replies() ).toHaveLength( 1 );
			} );

			it( "answers /info with the caller and the conversation", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ] );
				session.handleInbound( message( "/info", "u-7", "chat-9" ), mock );

				expect( replies()[ 1 ] ).toInclude( "Agent: helper" );
				expect( replies()[ 1 ] ).toInclude( "User: u-7" );
				expect( replies()[ 1 ] ).toInclude( "mock:chat-9" );
			} );

			it( "reads /info@botname as /info, as Telegram sends it in a group", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ] );
				session.handleInbound( message( "/info@helperbot" ), mock );
				expect( replies()[ 1 ] ).toInclude( "Agent: helper" );
			} );

			it( "passes a message that is not a command to the agent", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ] );
				var done = session.handleInbound( message( "hello there" ), mock );

				expect( isNull( done ) ).toBeFalse();
				done.get();
				expect( replies()[ 1 ] ).notToInclude( "Agent: helper" );
			} );

			it( "passes an unknown slash word to the agent instead of swallowing it", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ] );
				var done = session.handleInbound( message( "/whatever you like" ), mock );
				expect( isNull( done ) ).toBeFalse();
				done.get();
			} );

			it( "does not offer a command outside its safe set, such as /clear", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ] );
				expect( session.commandMenu().map( c => c.name ) ).toBe( [ "/help", "/tools", "/model", "/ping", "/info", "/remember", "/notes" ] );
				var done = session.handleInbound( message( "/clear" ), mock );
				expect( isNull( done ) ).toBeFalse();
				done.get();
			} );

			it( "can be widened or switched off in the project's config", function() {
				var wide = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { allow : [ "help", "clear" ] } );
				expect( wide.commandMenu().map( c => c.name ) ).toBe( [ "/help", "/clear" ] );

				var off = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ aiGateway( "mock" ) ], commands : { enabled : false } );
				var done = off.handleInbound( message( "/help" ), mock );
				expect( isNull( done ) ).toBeFalse();
				done.get();
			} );

			it( "uses another prefix when configured", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { prefix : "!" } );
				session.handleInbound( message( "!info" ), mock );
				expect( replies()[ 1 ] ).toInclude( "Agent: helper" );
			} );

			it( "keeps the conversation commands off unless asked for, since they act on the chat's one conversation", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ] );
				expect( session.commandMenu().map( c => c.name ) ).notToInclude( "/new" );
				var on = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { conversation : true } );
				expect( on.commandMenu().map( c => c.name ) ).toInclude( "/new" );
				expect( on.commandMenu().map( c => c.name ) ).toInclude( "/sessions" );
				expect( on.commandMenu().map( c => c.name ) ).toInclude( "/resume" );
			} );

			it( "/new moves the chat to a fresh thread and /resume brings the earlier one back", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { conversation : true } );
				var first = session.resolveThreadId( message( "hello" ), mock );
				session.handleInbound( message( "hello" ), mock ).get();

				session.handleInbound( message( "/new" ), mock );
				var second = session.resolveThreadId( message( "hello" ), mock );
				expect( second ).notToBe( first );
				expect( replies().filter( r => r.find( "New conversation" ) ) ).toHaveLength( 1 );

				// another chat is not moved
				expect( session.resolveThreadId( message( "hello", "u-1", "chat-2" ), mock ) ).toBe( "mock:chat-2" );

				// the first conversation is on the list once it had a message
				session.handleInbound( message( "/resume " & first ), mock );
				expect( replies().filter( r => r.find( "Resumed" ) ) ).toHaveLength( 1 );
				expect( session.resolveThreadId( message( "hello" ), mock ) ).toBe( first );
			} );

			it( "/sessions lists the chats the person has had here, most recent first", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { conversation : true } );
				var done = session.handleInbound( message( "plan the launch" ), mock );
				done.get();
				session.handleInbound( message( "/new" ), mock );
				var done2 = session.handleInbound( message( "second topic" ), mock );
				done2.get();
				session.handleInbound( message( "/sessions" ), mock );

				var listing = replies()[ replies().len() ];
				expect( listing ).toInclude( "plan the launch" );
				expect( listing.find( "second topic" ) ).toBeLT( listing.find( "plan the launch" ) );
			} );

			it( "/clear and /compact act on the chat's current thread", function() {
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { conversation : true } );
				session.handleInbound( message( "/clear" ), mock );
				expect( replies()[ 1 ] ).toInclude( "Cleared" );
			} );

			it( "lists a pick-one as numbers, and a lone number right after it picks that option", function() {
				var registry = new bxagents.models.chat.commands.CommandRegistry().register( new PickCommand() );
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { registry : registry } );
				session.handleInbound( message( "/pick" ), mock );
				expect( replies()[ 1 ] ).toInclude( "1. red" );
				expect( replies()[ 1 ] ).toInclude( "Reply with a number to pick one." );

				session.handleInbound( message( "2" ), mock );
				expect( replies()[ 2 ] ).toBe( "Picked blue" );
			} );

			it( "forgets the list after any other message, so a later number is just a message", function() {
				var registry = new bxagents.models.chat.commands.CommandRegistry().register( new PickCommand() );
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { registry : registry } );
				session.handleInbound( message( "/pick" ), mock );
				session.handleInbound( message( "/pick red" ), mock );
				var done = session.handleInbound( message( "2" ), mock );
				expect( isNull( done ) ).toBeFalse();
				done.get();
				expect( replies() ).toHaveLength( 3 );
			} );

			it( "keeps one person's list from answering another's number", function() {
				var registry = new bxagents.models.chat.commands.CommandRegistry().register( new PickCommand() );
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { registry : registry } );
				session.handleInbound( message( "/pick", "u-1" ), mock );
				var done = session.handleInbound( message( "1", "u-2" ), mock );
				expect( isNull( done ) ).toBeFalse();
				done.get();
			} );

			it( "shows a pick-one natively on a gateway that has buttons, and not as a list", function() {
				var sent = [];
				mock.deliverChoices = ( title, options, context ) => { sent.append( { title: title, lines: options.map( o => o.line ) } ); return true; };
				var registry = new bxagents.models.chat.commands.CommandRegistry().register( new PickCommand() );
				var session = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { registry : registry } );
				session.handleInbound( message( "/pick" ), mock );

				expect( sent ).toHaveLength( 1 );
				expect( sent[ 1 ].lines ).toBe( [ "/pick red", "/pick blue" ] );
				expect( replies() ).toBeEmpty();
			} );

			it( "tells the person when a command fails, instead of throwing into the gateway", function() {
				var registry = new bxagents.models.chat.commands.CommandRegistry().register( new BrokenCommand() );
				var broken = new bxagents.models.gateways.CommandGatewaySession( agent : agent, gateways : [ mock ], commands : { registry : registry } );
				broken.handleInbound( message( "/broken" ), mock );
				expect( replies()[ 1 ] ).toBe( "That command did not work: it broke" );
			} );

		} );
	}

}
