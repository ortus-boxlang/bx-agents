/**
 * The wizard's questions, driven by scripted answers so no terminal is needed.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "NewWizard", function() {

			function wizardFor( required array answers ) {
				variables.prompter = new bxagents.models.wizard.prompters.ScriptedPrompter( answers );
				return new bxagents.models.wizard.NewWizard( prompter );
			}

			it( "asks every stage in order and ends with a plan and the command that rebuilds it", function() {
				var wizard = wizardFor( [
					"support-bot", "Answers customers", "minimal",
					"claude", "",
					[ "time", "search", "files" ], "brave",
					"pick", [ "readFile", "writeFile" ], [ "tmp", "custom" ], "/data/docs", "",
					"file",
					[ "github" ], "ok",
					[ "web", "telegram" ],
					"users", "ada", "pw", "pw", "Ada Lovelace", false,
					"flag",
					"docker", "ghcr", "me/support-bot",
					"create"
				] );

				var result = wizard.run( {}, "ignored", "support-bot" );
				var plan = result.plan;

				expect( prompter.remaining() ).toBe( 0 );
				expect( plan.name ).toBe( "support-bot" );
				expect( plan.model ).toBe( "claude" );
				expect( plan.with ).toBe( [ "time", "search", "files" ] );
				expect( plan.search ).toBe( "brave" );
				expect( plan.files.tools ).toBe( [ "readFile", "writeFile" ] );
				expect( plan.files.folders ).toBe( [ "tmp", "/data/docs" ] );
				expect( plan.memory ).toBe( "file" );
				expect( plan.mcp ).toBe( [ "github" ] );
				expect( plan.channels ).toBe( [ "web", "telegram" ] );
				expect( plan.web.auth ).toBe( "users" );
				expect( plan.web.users ).toHaveLength( 1 );
				expect( plan.web.users[ 1 ].passwordHash ).toMatch( "^pbkdf2\$210000\$" );
				expect( plan.web.users[ 1 ].displayName ).toBe( "Ada Lovelace" );
				expect( plan.guard ).toBe( "flag" );
				expect( plan.deploy.registry ).toBe( "ghcr:me/support-bot" );
				expect( result.command ).toInclude( "--files=readFile,writeFile" );
				expect( result.command ).toInclude( "--web-auth=users" );
			} );

			it( "never keeps a plain password", function() {
				var wizard = wizardFor( [
					"bot", "", "minimal", "openai", "", [], "cache", [], [ "web" ],
					"users", "ada", "s3cret-pw", "s3cret-pw", "", false, "off", "none", "create"
				] );

				var plan = wizard.run().plan;

				expect( jsonSerialize( plan ) ).notToInclude( "s3cret-pw" );
			} );

			it( "puts a failed password confirmation back to the same question", function() {
				var wizard = wizardFor( [
					"bot", "", "minimal", "openai", "", [], "cache", [], [ "web" ],
					"users", "ada", "one", "two", "ok", "pw", "pw", "", false, "off", "none", "create"
				] );

				var plan = wizard.run().plan;

				expect( plan.web.users ).toHaveLength( 1 );
				expect( prompter.asked().filter( q => q.kind == "note" ).map( q => q.title ) ).toInclude( "The passwords did not match" );
			} );

			it( "skips the stages whose flag was given and shows them as answered", function() {
				var wizard = wizardFor( [ "create" ] );

				var flags = {
					name : "bot", description : "Does things", template : "minimal", model : "openai", with : "time", memory : "cache",
					mcp : "", channels : "", guard : "off", deploy : ""
				};
				// the stages that are not skipped by those flags: only the review
				var plan = wizard.run( flags ).plan;

				expect( prompter.asked().map( q => q.kind ) ).toBe( [ "review" ] );
				expect( prompter.recorded().name.value ).toInclude( "(from a flag)" );
				expect( plan.model ).toBe( "openai" );
			} );

			it( "goes back to the previous question on Esc and asks it again", function() {
				var wizard = wizardFor( [
					"first", "<back>", "second", "", "minimal", "openai", "", [], "cache", [], [], "off", "none", "create"
				] );

				var plan = wizard.run().plan;

				expect( plan.name ).toBe( "second" );
				var titles = prompter.asked().map( q => q.title );
				expect( titles.filter( t => t == "What do you want to call your agent?" ) ).toHaveLength( 2 );
			} );

			it( "stays on the first question when there is nothing to go back to", function() {
				var wizard = wizardFor( [
					"<back>", "bot", "", "minimal", "openai", "", [], "cache", [], [], "off", "none", "create"
				] );

				expect( wizard.run().plan.name ).toBe( "bot" );
			} );

			it( "cancels without a plan", function() {
				var wizard = wizardFor( [ "bot", "<cancel>" ] );

				expect( function() {
					wizard.run();
				} ).toThrow( type = "BxAgents.WizardCancelled" );
			} );

			it( "starts over when the review says so", function() {
				var wizard = wizardFor( [
					"one", "", "minimal", "openai", "", [], "cache", [], [], "off", "none", "restart",
					"two", "", "minimal", "openai", "", [], "cache", [], [], "off", "none", "create"
				] );

				expect( wizard.run().plan.name ).toBe( "two" );
			} );

			it( "refuses a bad name and asks again", function() {
				var wizard = wizardFor( [
					"1bad name", "ok", "good", "", "minimal", "openai", "", [], "cache", [], [], "off", "none", "create"
				] );

				expect( wizard.run().plan.name ).toBe( "good" );
			} );

			it( "does not let the file tools run without a folder", function() {
				var wizard = wizardFor( [
					"bot", "", "minimal", "openai", "", [ "files" ],
					"read", [], [ "tmp" ],
					"cache", [], [], "off", "none", "create"
				] );

				var plan = wizard.run().plan;

				expect( plan.files.folders ).toBe( [ "tmp" ] );
				expect( prompter.asked().filter( q => q.title == "Which folders may they use?" ) ).toHaveLength( 2 );
			} );

			it( "offers only MCP servers that work today and says which do not", function() {
				var wizard = wizardFor( [ "bot", "", "minimal", "openai", "", [], "cache", [], [], "off", "none", "create" ] );
				wizard.run();
				var mcp = prompter.asked().filter( q => q.title == "Connect any MCP servers?" )[ 1 ];

				expect( mcp.choices.map( c => c.value ) ).toInclude( "github" );
				expect( mcp.choices.map( c => c.value ) ).notToInclude( "git" );
			} );

		} );
	}

}
