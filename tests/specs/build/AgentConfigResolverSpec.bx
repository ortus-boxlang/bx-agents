class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "AgentConfigResolver", function() {

			beforeEach( function() {
				variables.resolver = new bxagents.models.build.AgentConfigResolver();
				variables.fixtures = expandPath( "/fixtures" );
			} );

			it( "merges configure() with defaults and stamps the resolved environment", function() {
				var config = resolver.resolve( projectRoot = fixtures & "/valid-minimal" );

				expect( config.name ).toBe( "minimal-agent" );
				expect( config.model ).toBe( "openai/gpt-5" );
				expect( config.environment ).toBe( "development" );
			} );

			it( "resolves an Agent.yml the same way as a descriptor Agent.bx", function() {
				var config = resolver.resolve( projectRoot = fixtures & "/yaml-minimal" );

				expect( config.name ).toBe( "yaml-agent" );
				expect( config.model ).toBe( "openai/gpt-5" );
				expect( config.description ).toBe( "A test agent defined in YAML" );
				expect( config.environment ).toBe( "development" );
				expect( config.classBasedAgent ).toBeFalse();
			} );

			it( "applies the matching environments: block of an Agent.yml", function() {
				var dev = resolver.resolve( projectRoot = fixtures & "/yaml-environments" );
				var prod = resolver.resolve( projectRoot = fixtures & "/yaml-environments", cliEnvironment = "production" );

				expect( dev.model ).toBe( "openai/gpt-5" );
				expect( prod.model ).toBe( "openai/gpt-5-mini" );
				expect( prod.environment ).toBe( "production" );
				expect( prod.keyExists( "environments" ) ).toBeFalse();
			} );

			describe( "the person's files", function() {

				beforeEach( function() {
					variables.nl = char( 10 )
					variables.scratch = createTempDirectory( prefix = "bxagents-person-" )
					variables.home = scratch & "/home"
					directoryCreate( home )
					variables.project = scratch & "/project"
					directoryCreate( project )
					fileWrite(
						project & "/Agent.yml",
						[
							"name: layered",
							"model: openai/gpt-5",
							"tools: [ now@bxai ]",
							"data:",
							"  home: " & home,
							"environments:",
							"  production:",
							"    model: openai/gpt-5-mini"
						].toList( nl ) & nl
					)
					variables.globalFile = scratch & "/global.yml"
				} );

				afterEach( function() {
					if ( directoryExists( scratch ) ) {
						directoryDelete( scratch, true )
					}
				} );

				it( "leaves the author's settings alone unless asked for the person's files", function() {
					fileWrite( globalFile, "model: ollama/qwen3" & nl )
					var config = resolver.resolve( projectRoot = project, globalFile = globalFile )
					expect( config.model ).toBe( "openai/gpt-5" )
					expect( config.keyExists( "personLayers" ) ).toBeFalse()
				} );

				it( "puts the global file over the project, over its environment override, and the agent's own file over both", function() {
					fileWrite( globalFile, [ "model: global/m", "tools+: [ extra@bxai ]" ].toList( nl ) & nl )
					var withGlobal = resolver.resolve( projectRoot = project, cliEnvironment = "production", withPerson = true, globalFile = globalFile )
					expect( withGlobal.model ).toBe( "global/m" )
					expect( withGlobal.tools ).toBe( [ "now@bxai", "extra@bxai" ] )

					fileWrite( home & "/Agent.yml", "model: ollama/qwen3" & nl )
					var withAgent = resolver.resolve( projectRoot = project, withPerson = true, globalFile = globalFile )
					expect( withAgent.model ).toBe( "ollama/qwen3" )
					expect( withAgent.tools ).toBe( [ "now@bxai", "extra@bxai" ] )
				} );

				it( "says which settings came from which file", function() {
					fileWrite( globalFile, "tools-: [ now@bxai ]" & nl )
					fileWrite( home & "/Agent.yml", [ "agentApi:", "  enabled: false" ].toList( nl ) & nl )
					var config = resolver.resolve( projectRoot = project, withPerson = true, globalFile = globalFile )
					expect( config.tools ).toBeEmpty()
					expect( config.personLayers.changed.map( e => e.path & "@" & e.layer ) ).toBe( [ "agentApi@agent", "tools@global" ] )
					expect( config.personLayers.buildOnly.map( e => e.path ) ).toBe( [ "agentApi" ] )
					expect( config.personLayers.files.map( e => e.file ) ).toBe( [ globalFile, home & "/Agent.yml" ] )
				} );

				it( "reads the model the person set like any other, so a profile of theirs is normalized", function() {
					fileWrite( globalFile, "model: anthropic/claude-sonnet-4-5" & nl )
					var config = resolver.resolve( projectRoot = project, withPerson = true, globalFile = globalFile )
					expect( config.model ).toBe( "anthropic/claude-sonnet-4-5" )
				} );

				it( "refuses a bad person's file and names it", function() {
					fileWrite( globalFile, "modle: x" & nl )
					expect( function() {
						resolver.resolve( projectRoot = project, withPerson = true, globalFile = globalFile )
					} ).toThrow( regex = "global\.yml" );
				} );

			} );

			it( "refuses a folder with both an Agent.yml and an Agent.bx", function() {
				expect( function() {
					resolver.resolve( projectRoot = fixtures & "/yaml-and-bx" );
				} ).toThrow( type = "BxAgents.AmbiguousAgentDefinition" );
			} );

			it( "carries Agent.bx's security {} block through unchanged, including under an environment override", function() {
				var config = resolver.resolve( projectRoot = fixtures & "/with-security" );
				expect( config.security.inputSanitizer ).toBeTrue();
				expect( config.security.outputGuard.blockPatterns ).toBe( [ "ssn", "creditCard" ] );

				var prodConfig = resolver.resolve( projectRoot = fixtures & "/with-security", cliEnvironment = "production" );
				expect( prodConfig.model ).toBe( "openai/gpt-5-mini" );
				expect( prodConfig.security.inputSanitizer ).toBeTrue();
				expect( prodConfig.security.outputGuard.blockPatterns ).toBe( [ "ssn", "creditCard" ] );
			} );

			it( "flags a class-based Agent.bx and makes configure() optional there", function() {
				// No configure() at all on this fixture - legal only because the
				// class IS the agent and configures itself in its own init().
				var config = resolver.resolve( projectRoot = fixtures & "/class-based-minimal" );

				expect( config.classBasedAgent ).toBeTrue();
				expect( config.classHasCheckpointer ).toBeFalse();
				expect( config.keyExists( "model" ) ).toBeFalse();
			} );

			it( "still reads configure() when a class-based Agent.bx declares one", function() {
				var config = resolver.resolve( projectRoot = fixtures & "/class-based-declared" );

				expect( config.classBasedAgent ).toBeTrue();
				expect( config.name ).toBe( "FromConfig" );
				expect( config.model ).toBe( "mock/mock-model" );
			} );

			it( "reports a checkpointer the class set itself", function() {
				var config = resolver.resolve( projectRoot = fixtures & "/class-based-own-checkpointer" );
				expect( config.classHasCheckpointer ).toBeTrue();
			} );

			it( "marks a plain descriptor Agent.bx as NOT class-based", function() {
				var config = resolver.resolve( projectRoot = fixtures & "/valid-minimal" );
				expect( config.classBasedAgent ).toBeFalse();
			} );

			it( "throws a descriptive error when Agent.bx is missing", function() {
				expect( function() {
					resolver.resolve( projectRoot = "/tmp/bx-agents-does-not-exist" );
				} ).toThrow( "BxAgents.MissingAgentDescriptor" );
			} );

			it( "throws when Agent.bx's configure() throws", function() {
				expect( function() {
					resolver.resolve( projectRoot = fixtures & "/malformed-agent" );
				} ).toThrow( "BxAgents.InvalidAgentDescriptor" );
			} );

			it( "applies environment() overrides on top of configure() base", function() {
				var base = resolver.resolve( projectRoot = fixtures & "/with-environment-override" );
				expect( base.model ).toBe( "openai/gpt-5" );
				expect( base.tags ).toBe( [ "base1", "base2" ] );
				expect( base.environment ).toBe( "development" );

				var prod = resolver.resolve(
					projectRoot   = fixtures & "/with-environment-override",
					cliEnvironment = "production"
				);
				expect( prod.model ).toBe( "openai/gpt-5-mini" );
				expect( prod.environment ).toBe( "production" );
			} );

			it( "array-valued settings are replaced, not appended, by environment overrides", function() {
				var prod = resolver.resolve(
					projectRoot   = fixtures & "/with-environment-override",
					cliEnvironment = "production"
				);

				// The override array [ "prod1" ] fully replaces [ "base1", "base2" ] - it is
				// not merged/concatenated with the base array.
				expect( prod.tags ).toBe( [ "prod1" ] );
			} );

			it( "merges boxlang.json over configure(), and boxlang-{env}.json over boxlang.json", function() {
				var base = resolver.resolve( projectRoot = fixtures & "/with-boxlang-json" );
				expect( base.modelDefaults.temperature ).toBe( 0.7 );
				expect( base.modelDefaults.maxTokens ).toBe( 1000 );

				var prod = resolver.resolve(
					projectRoot   = fixtures & "/with-boxlang-json",
					cliEnvironment = "production"
				);
				// production json only overrides temperature - maxTokens survives from the base json
				expect( prod.modelDefaults.temperature ).toBe( 0.2 );
				expect( prod.modelDefaults.maxTokens ).toBe( 1000 );
			} );

			it( "falls back to development when no environment is specified", function() {
				var config = resolver.resolve( projectRoot = fixtures & "/valid-minimal" );
				expect( config.environment ).toBe( "development" );
			} );

			it( "an explicit cliEnvironment takes precedence over the default", function() {
				var config = resolver.resolve(
					projectRoot   = fixtures & "/valid-minimal",
					cliEnvironment = "staging"
				);
				expect( config.environment ).toBe( "staging" );
			} );

		} );
	}

}
