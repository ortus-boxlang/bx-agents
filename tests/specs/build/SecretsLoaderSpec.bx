/**
 * The encrypted secrets file: reading, decrypting into what getSystemSetting() sees, and every
 * way it refuses. Names only ever appear in messages; the specs check that no value does.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "SecretsLoader", function() {

			beforeEach( function() {
				variables.loader = new bxagents.models.build.SecretsLoader();
				variables.utility = createObject( "java", "ortus.boxlang.runtime.util.ConfigSecretUtil" );
				variables.system = createObject( "java", "java.lang.System" );
				variables.seed = generateSecretKey( "AES", 256 );
				variables.file = getTempDirectory() & "bxa-secrets-" & createUUID() & ".json";
				variables.names = [];
			} );

			afterEach( function() {
				for ( var name in names ) {
					system.clearProperty( name );
				}
				if ( fileExists( file ) ) {
					fileDelete( file );
				}
			} );

			private function name( required string tag ) {
				var n = "BXA_SECRET_" & tag & "_" & replace( createUUID(), "-", "", "all" );
				names.append( n );
				return n;
			}

			private function seal( required string plain, string withSeed = seed ) {
				return utility.SECURE_VALUE_PREFIX & utility.encrypt( plain, withSeed );
			}

			private function write( required struct data ) {
				fileWrite( file, jsonSerialize( data ) );
			}

			it( "does nothing when there is no file", function() {
				expect( loader.load( file & ".missing", seed ) ).toBe( { loaded : [], skipped : [] } );
			} );

			it( "decrypts each value and publishes it where getSystemSetting() looks", function() {
				var key = name( "A" );
				write( { "#key#" : seal( "alpha-value" ) } );

				var result = loader.load( file, seed );

				expect( result.loaded ).toBe( [ key ] );
				expect( getSystemSetting( key, "MISSING" ) ).toBe( "alpha-value" );
			} );

			it( "leaves a variable the environment already has alone", function() {
				var key = name( "B" );
				system.setProperty( key, "from-the-deployment" );
				write( { "#key#" : seal( "committed" ) } );

				var result = loader.load( file, seed );

				expect( result.skipped ).toBe( [ key ] );
				expect( getSystemSetting( key, "MISSING" ) ).toBe( "from-the-deployment" );
			} );

			it( "ignores the note and the seed check", function() {
				var key = name( "C" );
				write( { "_note" : "hello", "_seedCheck" : loader.canary( seed ), "#key#" : seal( "v" ) } );

				expect( loader.load( file, seed ).loaded ).toBe( [ key ] );
				expect( loader.names( file ) ).toBe( [ key ] );
			} );

			it( "recognises the wrong seed from the canary, before touching any secret", function() {
				var key = name( "D" );
				write( { "_seedCheck" : loader.canary( seed ), "#key#" : seal( "secret-d" ) } );

				try {
					loader.load( file, generateSecretKey( "AES", 256 ) );
					fail( "should have thrown" );
				} catch ( BxAgents.SecretsUnreadable e ) {
					expect( e.message ).toInclude( "BOXLANG_SECURITY_SECRETSEED" );
					expect( e.message ).notToInclude( "secret-d" );
				}
				expect( getSystemSetting( key, "MISSING" ) ).toBe( "MISSING" );
			} );

			it( "names the variable it cannot decrypt, without a canary", function() {
				var key = name( "E" );
				write( { "#key#" : seal( "x", generateSecretKey( "AES", 256 ) ) } );

				try {
					loader.load( file, seed );
					fail( "should have thrown" );
				} catch ( BxAgents.SecretsUnreadable e ) {
					// a wrong key almost always fails to decrypt; if it ever decrypts to junk the canary is the guard
					expect( e.message ).toInclude( key );
				} catch ( any e ) {
					rethrow;
				}
			} );

			it( "refuses a plain value, since that would be a secret committed in the clear", function() {
				write( { "OPENAI_API_KEY" : "sk-this-must-not-be-here" } );

				try {
					loader.load( file, seed );
					fail( "should have thrown" );
				} catch ( BxAgents.SecretsUnreadable e ) {
					expect( e.message ).toInclude( "OPENAI_API_KEY" );
					expect( e.message ).toInclude( "not encrypted" );
					expect( e.message ).notToInclude( "sk-this-must-not-be-here" );
				}
			} );

			it( "refuses a name that is not an environment variable name, and a file that is not an object", function() {
				write( { "not valid" : seal( "x" ) } );
				expect( function() {
					loader.read( file );
				} ).toThrow( type = "BxAgents.SecretsUnreadable", regex = "not a valid environment variable name" );

				fileWrite( file, "[1,2]" );
				expect( function() {
					loader.read( file );
				} ).toThrow( type = "BxAgents.SecretsUnreadable", regex = "must be a JSON object" );

				fileWrite( file, "{ nope" );
				expect( function() {
					loader.read( file );
				} ).toThrow( type = "BxAgents.SecretsUnreadable", regex = "not valid JSON" );
			} );

			it( "reads the seed from BOXLANG_SECURITY_SECRETSEED when none is passed", function() {
				var key = name( "F" );
				write( { "_seedCheck" : loader.canary( seed ), "#key#" : seal( "via-env-seed" ) } );
				system.setProperty( "BOXLANG_SECURITY_SECRETSEED", seed );
				try {
					loader.load( file );
				} finally {
					system.clearProperty( "BOXLANG_SECURITY_SECRETSEED" );
				}

				expect( getSystemSetting( key, "MISSING" ) ).toBe( "via-env-seed" );
			} );

			it( "makes values in BoxLang's own bxsecret: format (compatible with boxlang generatesecret)", function() {
				var sealed = seal( "interoperable" );
				expect( utility.isEncrypted( sealed ) ).toBeTrue();
				expect( utility.decrypt( sealed.replace( utility.SECURE_VALUE_PREFIX, "" ), seed ) ).toBe( "interoperable" );
			} );

		} );
	}

}
