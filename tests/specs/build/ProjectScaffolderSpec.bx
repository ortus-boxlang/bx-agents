class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "ProjectScaffolder", function() {

			beforeEach( function() {
				variables.scaffolder = new bxagents.models.build.ProjectScaffolder();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTargetDir() {
				var parent = createTempDirectory( prefix = "bxagents-scaffold-" );
				tempDirs.append( parent );
				return parent & "/my-new-agent";
			}

			it( "scaffolds a class-based Agent.bx and instructions.md with the given name/model/description", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "my-agent", "openai/gpt-5", "A helpful test agent" );

				expect( fileExists( result.agentBx ) ).toBeTrue();
				expect( fileExists( result.instructions ) ).toBeTrue();

				var content = fileRead( result.agentBx );
				expect( content ).toInclude( 'extends="bxModules.bxai.models.runnables.AiAgent"' );
				expect( content ).toInclude( 'name        : "my-agent"' );
				expect( content ).toInclude( 'description : "A helpful test agent"' );
				expect( content ).toInclude( 'aiModel( provider : "openai", params : { model : "gpt-5" } )' );

				expect( fileRead( result.instructions ) ).toInclude( "my-agent" );
			} );

			it( "renders a bare provider (no slash) model slug as aiModel() with no params", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "my-agent", "mock" );

				var content = fileRead( result.agentBx );
				expect( content ).toInclude( 'aiModel( provider : "mock" )' );
			} );

			it( "creates every empty convention folder", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, "my-agent", "openai/gpt-5" );

				for ( var folder in [ "tools", "skills", "subagents", "gateways", "schedules", "mcp", "interceptors", "models", "modules" ] ) {
					expect( directoryExists( dir & "/" & folder ) ).toBeTrue();
				}
			} );

			it( "refuses to scaffold over an existing Agent.bx", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, "my-agent", "openai/gpt-5" );

				expect( function() {
					scaffolder.scaffold( dir, "another-agent", "openai/gpt-5" );
				} ).toThrow( "BxAgents.ProjectAlreadyExists" );
			} );

			it( "produces a class-based Agent.bx that AgentConfigResolver recognizes, with identity set on the class itself", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, "my-agent", "openai/gpt-5", "A helpful test agent" );

				var resolver = new bxagents.models.build.AgentConfigResolver();
				var config = resolver.resolve( projectRoot = dir );

				// Nothing to override outside the class - name/model/description
				// are set in the class's own init(), not redeclared in a config
				// struct, so the resolved config carries neither.
				expect( config.classBasedAgent ).toBeTrue();

				var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext();
				var instance = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
					.instantiate( dir & "/Agent.bx", context );
				expect( instance.getAgentName() ).toBe( "my-agent" );
				expect( instance.getDescription() ).toBe( "A helpful test agent" );
			} );

			it( "scaffolds Agent.bx with a test() override defaulting to the mock provider", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, "my-agent", "openai/gpt-5" );

				var resolver = new bxagents.models.build.AgentConfigResolver();
				var config = resolver.resolve( projectRoot = dir, cliEnvironment = "test" );

				expect( config.model ).toBe( "mock/mock-model" );
			} );

			it( "scaffolds a ready-to-run tests/ folder", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "my-agent", "openai/gpt-5" );

				expect( fileExists( result.testsBoxJson ) ).toBeTrue();
				expect( fileExists( result.agentSpec ) ).toBeTrue();

				var boxJson = jsonDeserialize( fileRead( result.testsBoxJson ) );
				expect( boxJson.devDependencies ).toHaveKey( "testbox" );

				var specContent = fileRead( result.agentSpec );
				expect( specContent ).toInclude( 'extends="bxModules.bxagents.models.testing.BaseAgentSpec"' );
				expect( specContent ).toInclude( "mockResponses(" );
			} );

			/**
			 * Regression: mirrors `ortus-boxlang/bx-ai-intro`'s own
			 * `.env`/`BOXLANG_HOME` convention - confirmed empirically against
			 * the real BoxLang runtime jar that `BOXLANG_HOME` is a genuine
			 * environment variable `BoxRunner` itself reads (relative paths
			 * resolve against the CWD, same as an absolute path would), not
			 * something specific to `serve`'s own miniserver config. Points at
			 * the SAME `.build/runtime` path `serve`'s own `serverHome`
			 * already uses (see `Serve.bx`), so both mechanisms agree on one
			 * canonical location.
			 */
			it( "scaffolds a .env declaring BOXLANG_HOME=.build/runtime, matching serve's own serverHome path", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "my-agent", "openai/gpt-5" );

				expect( fileExists( result.env ) ).toBeTrue();
				expect( fileRead( result.env ) ).toInclude( "BOXLANG_HOME=.build/runtime" );
			} );

			it( "scaffolds a .gitignore excluding .build/, dist/, and .env", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "my-agent", "openai/gpt-5" );

				expect( fileExists( result.gitignore ) ).toBeTrue();
				var content = fileRead( result.gitignore );
				expect( content ).toInclude( ".build/" );
				expect( content ).toInclude( "dist/" );
				expect( content ).toInclude( ".env" );
			} );

			it( "never overwrites an existing .env or .gitignore in the target directory", function() {
				var dir = newTargetDir();
				directoryCreate( path = dir, createPath = true, ignoreExists = true );
				fileWrite( dir & "/.env", "CUSTOM_VAR=already-here" );
				fileWrite( dir & "/.gitignore", "custom-ignore-line" );

				var result = scaffolder.scaffold( dir, "my-agent", "openai/gpt-5" );

				expect( fileRead( result.env ) ).toBe( "CUSTOM_VAR=already-here" );
				expect( fileRead( result.gitignore ) ).toBe( "custom-ignore-line" );
			} );

			it( "defaults to the 'minimal' template when --template is omitted", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "my-agent", "openai/gpt-5" );

				expect( result.template ).toBe( "minimal" );
				expect( fileExists( dir & "/gateways/webui.bx" ) ).toBeFalse();
				expect( fileExists( dir & "/schedules/Scheduler.bx" ) ).toBeFalse();
			} );

			it( "rejects an unrecognized --template", function() {
				var dir = newTargetDir();

				expect( function() {
					scaffolder.scaffold( dir, "my-agent", "openai/gpt-5", "", "not-a-real-template" );
				} ).toThrow( "BxAgents.UnknownTemplate" );
			} );

			it( "the webui-chat template adds a gateways/webui.bx exposing a chat UI at /chat", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, "my-agent", "openai/gpt-5", "", "webui-chat" );

				var path = dir & "/gateways/webui.bx";
				expect( fileExists( path ) ).toBeTrue();
				var content = fileRead( path );
				expect( content ).toInclude( 'exposes : "webui"' );
				expect( content ).toInclude( 'path    : "/chat"' );
			} );

			it( "the slack-bot template adds a gateways/slack.bx and matching .env stub lines", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "my-agent", "openai/gpt-5", "", "slack-bot" );

				var gatewayPath = dir & "/gateways/slack.bx";
				expect( fileExists( gatewayPath ) ).toBeTrue();
				var gatewayContent = fileRead( gatewayPath );
				expect( gatewayContent ).toInclude( 'type           : "slack"' );
				expect( gatewayContent ).toInclude( 'botTokenEnvVar : "SLACK_BOT_TOKEN"' );
				expect( gatewayContent ).toInclude( 'appTokenEnvVar : "SLACK_APP_TOKEN"' );

				var envContent = fileRead( result.env );
				expect( envContent ).toInclude( "SLACK_BOT_TOKEN=" );
				expect( envContent ).toInclude( "SLACK_APP_TOKEN=" );
				// The base .env content is still there too - stubs are appended, not replacing it
				expect( envContent ).toInclude( "BOXLANG_HOME=.build/runtime" );
			} );

			it( "the telegram-bot template adds a gateways/telegram.bx and matching .env stub line", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "my-agent", "openai/gpt-5", "", "telegram-bot" );

				var gatewayPath = dir & "/gateways/telegram.bx";
				expect( fileExists( gatewayPath ) ).toBeTrue();
				var gatewayContent = fileRead( gatewayPath );
				expect( gatewayContent ).toInclude( 'type           : "telegram"' );
				expect( gatewayContent ).toInclude( 'botTokenEnvVar : "TELEGRAM_BOT_TOKEN"' );

				var envContent = fileRead( result.env );
				expect( envContent ).toInclude( "TELEGRAM_BOT_TOKEN=" );
				expect( envContent ).toInclude( "BOXLANG_HOME=.build/runtime" );
			} );

			it( "the github-bot template adds a gateways/github.bx and matching .env stub lines", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "my-agent", "openai/gpt-5", "", "github-bot" );

				var gatewayPath = dir & "/gateways/github.bx";
				expect( fileExists( gatewayPath ) ).toBeTrue();
				var gatewayContent = fileRead( gatewayPath );
				expect( gatewayContent ).toInclude( 'type                : "github"' );
				expect( gatewayContent ).toInclude( 'tokenEnvVar         : "GITHUB_TOKEN"' );
				expect( gatewayContent ).toInclude( 'webhookSecretEnvVar : "GITHUB_WEBHOOK_SECRET"' );
				expect( gatewayContent ).toInclude( 'botNameEnvVar       : "GITHUB_BOT_NAME"' );

				var envContent = fileRead( result.env );
				expect( envContent ).toInclude( "GITHUB_TOKEN=" );
				expect( envContent ).toInclude( "GITHUB_WEBHOOK_SECRET=" );
				expect( envContent ).toInclude( "GITHUB_BOT_NAME=" );
			} );

			it( "the mcp-server template adds an example mcp/ tool and a gateways/ entry exposing it", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, "my-agent", "openai/gpt-5", "", "mcp-server" );

				expect( fileExists( dir & "/mcp/exampleServer.bx" ) ).toBeTrue();

				var gatewayPath = dir & "/gateways/mcpExpose.bx";
				expect( fileExists( gatewayPath ) ).toBeTrue();
				var content = fileRead( gatewayPath );
				expect( content ).toInclude( 'exposes : "mcp"' );
				expect( content ).toInclude( 'target  : "exampleServer"' );
			} );

			it( "the scheduled template adds a real schedules/Scheduler.bx calling the scaffolded agent by name", function() {
				var dir = newTargetDir();
				scaffolder.scaffold( dir, "my-agent", "openai/gpt-5", "", "scheduled" );

				var path = dir & "/schedules/Scheduler.bx";
				expect( fileExists( path ) ).toBeTrue();
				var content = fileRead( path );
				expect( content ).toInclude( 'extends="coldbox.system.web.tasks.ColdBoxScheduler"' );
				expect( content ).toInclude( 'getInstance( "my-agent" )' );
			} );

			it( "the multi-agent template declares subAgents on the root Agent.bx and scaffolds two real subagent folders", function() {
				var dir = newTargetDir();
				var result = scaffolder.scaffold( dir, "my-agent", "openai/gpt-5", "", "multi-agent" );

				var rootContent = fileRead( result.agentBx );
				expect( rootContent ).toInclude( "function configure()" );
				expect( rootContent ).toInclude( 'subAgents : [ "researcher", "writer" ]' );

				for ( var subAgentName in [ "researcher", "writer" ] ) {
					var subAgentDir = dir & "/subagents/" & subAgentName;
					expect( fileExists( subAgentDir & "/Agent.bx" ) ).toBeTrue();
					expect( fileExists( subAgentDir & "/instructions.md" ) ).toBeTrue();

					var subAgentContent = fileRead( subAgentDir & "/Agent.bx" );
					expect( subAgentContent ).toInclude( 'extends="bxModules.bxai.models.runnables.AiAgent"' );
					expect( subAgentContent ).toInclude( 'name        : "#subAgentName#"' );
				}
			} );

			it( "every non-minimal template validates cleanly with ProjectValidator", function() {
				var discoverer = new bxagents.models.build.ProjectDiscoverer();
				var resolver = new bxagents.models.build.AgentConfigResolver();
				var validator = new bxagents.models.build.ProjectValidator();

				for ( var template in [ "webui-chat", "slack-bot", "telegram-bot", "github-bot", "mcp-server", "scheduled", "multi-agent" ] ) {
					var dir = newTargetDir();
					scaffolder.scaffold( dir, "my-agent", "openai/gpt-5", "", template );

					var discovery = discoverer.discover( dir );
					var config = resolver.resolve( projectRoot = dir );
					var result = validator.validate( dir, discovery, config );

					expect( result.errors ).toBeArray();
					expect( result.errors.len() ).toBe( 0 );
				}
			} );

		} );
	}

}
