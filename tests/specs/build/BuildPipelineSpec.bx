class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "BuildPipeline", function() {

			beforeEach( function() {
				variables.pipeline = new bxagents.models.build.BuildPipeline( "1.2.3" );
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempProject( required string fixtureName ) {
				var dir = createTempDirectory( prefix = "bxagents-pipeline-" );
				directoryCopy( fixtures & "/" & arguments.fixtureName, dir, true );
				tempDirs.append( dir );
				return dir;
			}

			it( "builds a project defined only by an Agent.yaml", function() {
				var projectRoot = newTempProject( "yaml-inline-instructions" );
				var result = pipeline.build( projectRoot );

				expect( fileExists( result.appDir & "/Application.bx" ) ).toBeTrue();
				expect( result.manifest.agent.name ).toBe( "yaml-inline-agent" );
				expect( result.manifest.agent.model ).toBe( "mock/mock-model" );
			} );

			it( "copies a project's boxlang_modules/ into the app so serve and a .bxa carry them", function() {
				var projectRoot = newTempProject( "yaml-inline-instructions" );
				directoryCreate( projectRoot & "/boxlang_modules/bxfake" );
				fileWrite( projectRoot & "/boxlang_modules/bxfake/ModuleConfig.bx", "class {}" );

				var result = pipeline.build( projectRoot );

				expect( fileExists( result.appDir & "/boxlang_modules/bxfake/ModuleConfig.bx" ) ).toBeTrue();
			} );

			it( "leaves a devDependency module out of the app", function() {
				var projectRoot = newTempProject( "yaml-inline-instructions" );
				fileWrite( projectRoot & "/box.json", '{ "dependencies": { "bx-keep": "*" }, "devDependencies": { "bx-dev": "*" } }' );
				for ( var folder in [ "bxkeep", "bxdev" ] ) {
					directoryCreate( path = projectRoot & "/boxlang_modules/" & folder, createPath = true );
					fileWrite( projectRoot & "/boxlang_modules/#folder#/ModuleConfig.bx", "class {}" );
				}
				fileWrite( projectRoot & "/boxlang_modules/bxkeep/box.json", '{ "slug": "bx-keep" }' );
				fileWrite( projectRoot & "/boxlang_modules/bxdev/box.json", '{ "slug": "bx-dev" }' );

				var result = pipeline.build( projectRoot );

				expect( directoryExists( result.appDir & "/boxlang_modules/bxkeep" ) ).toBeTrue();
				expect( directoryExists( result.appDir & "/boxlang_modules/bxdev" ) ).toBeFalse();
			} );

			it( "builds a full project end-to-end, producing .build/app and .build/manifest.json", function() {
				var projectRoot = newTempProject( "full-project" );
				var result = pipeline.build( projectRoot );

				expect( directoryExists( result.appDir ) ).toBeTrue();
				expect( fileExists( result.appDir & "/Application.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/config/ColdBox.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/config/WireBox.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/config/Router.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/agent/GeneratedAgentFactory.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/tools/Weather.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/skills/my-skill/SKILL.md" ) ).toBeTrue();

				expect( fileExists( result.manifestPath ) ).toBeTrue();
				expect( result.manifest.manifestVersion ).toBe( "1.0.0" );
				expect( result.manifest.generator.version ).toBe( "1.2.3" );
			} );

			/**
			 * `onProgress` (what `build --verbose` wires to a real println())
			 * defaults to a no-op, so every OTHER test in this file (none of
			 * which pass one) is proof the feature costs nothing when unused.
			 * Passing a collecting closure instead of asserting on captured
			 * stdout is what makes this reliably testable at all.
			 */
			it( "reports one progress line per build phase via onProgress, in order, when one is supplied", function() {
				var projectRoot = newTempProject( "full-project" );
				var messages = [];

				pipeline.build( projectRoot, "", function( required string message ) { messages.append( arguments.message ) } );

				var joined = messages.toList( char( 10 ) );
				expect( joined ).toInclude( "Resolving the agent config" );
				expect( joined ).toInclude( "Discovering project source" );
				expect( joined ).toInclude( "Validating project" );
				expect( joined ).toInclude( "Generating core ColdBox app skeleton" );
				expect( joined ).toInclude( "agents registered in WireBox" );
				expect( joined ).toInclude( "full-project-agent" );
				expect( joined ).toInclude( "Copying schedules/ (Nightly)" );
				expect( joined ).toInclude( "Build completed in" );

				// "Resolving..." must be reported before "Discovering...", which
				// must be reported before "Validating..." - proves these are
				// live, in-order phase markers, not just a bag of strings.
				var resolveIndex = messages.find( function( m ) { return m.findNoCase( "Resolving the agent config" ) > 0 } );
				var discoverIndex = messages.find( function( m ) { return m.findNoCase( "Discovering project source" ) > 0 } );
				var validateIndex = messages.find( function( m ) { return m.findNoCase( "Validating project" ) > 0 } );
				expect( resolveIndex ).toBeLT( discoverIndex );
				expect( discoverIndex ).toBeLT( validateIndex );
			} );

			it( "onProgress is never called when the caller doesn't supply one - build --verbose costs nothing when unused", function() {
				var projectRoot = newTempProject( "full-project" );
				// No onProgress arg at all - if the default weren't a true no-op
				// (e.g. it printed by default), this would be indistinguishable
				// from a bug since println() has no return value to assert on;
				// the real proof is simply that this call, and every OTHER test
				// in this file that never passes onProgress either, succeeds
				// without needing to suppress or capture any output.
				var result = pipeline.build( projectRoot );
				expect( result.appDir ).notToBeNull();
			} );

			it( 'wires an agent-exposure gateway to the agent API routes without any adapter subclass', function() {
				var projectRoot = newTempProject( "full-project" );
				var result = pipeline.build( projectRoot );

				expect( fileExists( result.appDir & "/agent/GeneratedAgentRunnable.bx" ) ).toBeFalse();

				var routerContent = fileRead( result.appDir & "/config/Router.bx" );
				expect( routerContent ).toInclude( 'post( "/api/chat/invoke" ).toHandler( "AgentApi.invoke" )' );
			} );

			it( "builds a project's schedulers into the app, registered by the base Application and extending the scheduler base", function() {
				var projectRoot = newTempProject( "full-project" );
				var result = pipeline.build( projectRoot );

				var scheduler = fileRead( result.appDir & "/schedules/Nightly.bx" );
				expect( scheduler ).toInclude( 'class extends="bxagents.Scheduler" {' );
				expect( scheduler ).toInclude( '.cron( "0 0 * * *" )' );
				expect( fileExists( result.appDir & "/bxagents/Scheduler.bx" ) ).toBeTrue();
				expect( fileRead( result.appDir & "/bxagents/Application.bx" ) ).toInclude( '"schedules.Nightly"' );
				// the old ColdBox scheduler path is gone
				expect( fileExists( result.appDir & "/config/Scheduler.bx" ) ).toBeFalse();
			} );

			it( "tracks every scheduler in the manifest", function() {
				var projectRoot = newTempProject( "full-project" );
				var result = pipeline.build( projectRoot );

				var schedules = result.manifest.files.filter( f => f.category == "schedules" );
				expect( schedules ).toHaveLength( 1 );
				expect( schedules[ 1 ].name ).toBe( "Nightly" );
				expect( schedules[ 1 ].path ).toBe( "schedules/Nightly.bx" );
			} );

			it( "copies the project's own root Application.bx into the app as it is, and generates one when there is none", function() {
				var projectRoot = newTempProject( "full-project" );
				var own = 'class extends="bxagents.Application" {' & char( 10 ) & "	// mine" & char( 10 ) & "}" & char( 10 );
				fileWrite( projectRoot & "/Application.bx", own );

				var result = pipeline.build( projectRoot );
				expect( fileRead( result.appDir & "/Application.bx" ) ).toBe( own );

				fileDelete( projectRoot & "/Application.bx" );
				var rebuilt = pipeline.build( projectRoot );
				expect( fileRead( rebuilt.appDir & "/Application.bx" ) ).toInclude( 'class extends="bxagents.Application" {' );
				expect( fileRead( rebuilt.appDir & "/Application.bx" ) ).notToInclude( "mine" );
			} );

			it( "wipes a scheduler the project no longer has on rebuild", function() {
				var projectRoot = newTempProject( "full-project" );
				pipeline.build( projectRoot );
				fileDelete( projectRoot & "/schedules/Nightly.bx" );

				var rebuilt = pipeline.build( projectRoot );
				expect( fileExists( rebuilt.appDir & "/schedules/Nightly.bx" ) ).toBeFalse();
				expect( fileRead( rebuilt.appDir & "/bxagents/Application.bx" ) ).notToInclude( "this.schedulers" );
			} );

			it( "puts a project's agent-scope interceptor where the generated Application.bx looks it up", function() {
				var projectRoot = newTempProject( "full-project" );
				var result = pipeline.build( projectRoot );

				// Registered through ColdBox's class registration, which WireBox resolves to
				// <appDir>/interceptors/AuditLogger.bx. One folder deeper and the app fails to start
				// with "Instance not found" (measured by booting examples/advanced-agent).
				expect( fileRead( result.appDir & "/bxagents/Application.bx" ) ).toInclude( 'registerInterceptor( interceptorClass: "interceptors.AuditLogger", interceptorName: "AuditLogger" )' );
				expect( fileExists( result.appDir & "/interceptors/AuditLogger.bx" ) ).toBeTrue();
				expect( directoryExists( result.appDir & "/interceptors/interceptors" ) ).toBeFalse();
			} );

			it( "does not hand a project interceptor to WireBox's getInstance(), which reads its @scope agent as an object scope", function() {
				var projectRoot = newTempProject( "full-project" );
				var result = pipeline.build( projectRoot );

				// `@scope agent` is also WireBox's own scope annotation: getInstance() on such a class
				// died with "The key [agent] was not found in the struct" on a real boot.
				expect( fileRead( result.appDir & "/bxagents/Application.bx" ) ).notToInclude( 'getInstance( "interceptors.AuditLogger" )' );
			} );

			it( "generates the web chat UI on the agent API: no handler or key gate of its own", function() {
				var projectRoot = newTempProject( "gateways-webui" );
				var result = pipeline.build( projectRoot );

				expect( fileExists( result.appDir & "/chat/index.html" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/interceptors/WebUiAuthGate.bx" ) ).toBeFalse();
				expect( fileExists( result.appDir & "/handlers/ChatUi.bx" ) ).toBeFalse();
				expect( fileExists( result.appDir & "/handlers/AgentApi.bx" ) ).toBeTrue();

				var routerContent = fileRead( result.appDir & "/config/Router.bx" );
				expect( routerContent ).toInclude( 'post( "/__bxagents/stream" )' );
				expect( routerContent ).toInclude( "AgentApi.extensionFile" );

				// the entry's apiKeyEnvVar is the API's secret now
				expect( fileRead( result.appDir & "/config/Router.bx" ) ).toInclude( "CHAT_API_KEY" );
			} );

			it( 'calls aiToolRegistry().scan("tools") at startup only when the project declares tools', function() {
				var withTools = newTempProject( "full-project" );
				var withToolsResult = pipeline.build( withTools );
				expect( fileRead( withToolsResult.appDir & "/bxagents/Application.bx" ) ).toInclude( 'aiToolRegistry().scan( "tools" )' );

				var withoutTools = newTempProject( "valid-minimal" );
				var withoutToolsResult = pipeline.build( withoutTools );
				expect( fileRead( withoutToolsResult.appDir & "/bxagents/Application.bx" ) ).notToInclude( "aiToolRegistry().scan(" );
			} );

			it( "throws BxAgents.BuildValidationFailed and produces no .build/app for an invalid project", function() {
				var projectRoot = newTempProject( "validation/duplicate-tool-names" );

				expect( function() {
					pipeline.build( projectRoot );
				} ).toThrow( "BxAgents.BuildValidationFailed" );

				expect( directoryExists( projectRoot & "/.build/app" ) ).toBeFalse();
			} );

			it( "wipes stale .build/app content on rebuild rather than merging", function() {
				var projectRoot = newTempProject( "full-project" );
				var firstResult = pipeline.build( projectRoot );
				fileWrite( firstResult.appDir & "/StaleLeftover.bx", "class {}" );

				var secondResult = pipeline.build( projectRoot );

				expect( fileExists( secondResult.appDir & "/StaleLeftover.bx" ) ).toBeFalse();
			} );

			it( "registers local mcp servers and gateway channel adapters into Application.bx", function() {
				var projectRoot = newTempProject( "gateways-mixed" );
				var result = pipeline.build( projectRoot );

				var content = fileRead( result.appDir & "/bxagents/Application.bx" );
				expect( content ).toInclude( 'aiGatewayRegistry().register( aiGateway( "http"' );
				expect( content ).toInclude( 'aiGatewayRegistry().register( aiGateway( "mock"' );
				expect( content ).toInclude( "mcpServer(" );
			} );

			/**
			 * Regression: a real bug this review closed - each subagent's own
			 * config used to be resolved via `AgentConfigResolver.resolve(
			 * projectRoot = subPath )` with NO `cliEnvironment` passed, so a
			 * subagent's own environment-specific overrides always resolved
			 * against ITS default environment, silently ignoring whatever
			 * `--environment` the whole build was actually invoked with. A
			 * `--environment=production` build could generate a subagent still
			 * wired to its dev-environment config.
			 */
			it( "applies the build's --environment to every subagent's own environment overrides, not just the root project's", function() {
				var projectRoot = newTempProject( "subagent-environment-override" );

				var defaultResult = pipeline.build( projectRoot );
				var defaultContent = fileRead( defaultResult.appDir & "/agent/GeneratedAgentFactory.bx" );
				expect( defaultContent ).toInclude( 'model : "gpt-5"' );
				expect( defaultContent ).notToInclude( 'model : "gpt-5-mini"' );

				var prodResult = pipeline.build( projectRoot, "production" );
				var prodContent = fileRead( prodResult.appDir & "/agent/GeneratedAgentFactory.bx" );
				expect( prodContent ).toInclude( 'model : "gpt-5-mini"' );
			} );


			describe( "skills installed from the registry", function() {

				// An in-memory registry that answers like the real one: a miss is HTTP 200 with
				// error:true in the body (measured against skills.boxlang.io), not a 404.
				private function fakeRegistry( required struct skills ) {
					var store = new bxagents.models.skills.SkillStore();
					var calls = [];
					var transport = function( method, url, params ) {
						calls.append( method & " " & url.reReplace( "^https?://[^/]+", "" ) );
						var path = url.reReplace( "^https?://[^/]+", "" );
						var rows = skills.keyArray().map( function( key ) {
							var s = skills[ key ];
							return { owner : s.owner, repo : s.repo, skill_name : s.name, skill_slug : s.slug, skill_dir : s.path, description : s.description ?: "", audit_status : s.audit ?: "trusted", install_count : 3, file_sha : store.blobSha( s.content ) };
						} );
						if ( method == "POST" ) {
							var hit = rows.filter( function( r ) {
								return r.owner == params.owner && r.repo == params.repo && r.skill_slug == params.skill;
							} );
							if ( !hit.len() ) {
								return { status : 200, body : jsonSerialize( { error : true, statusCode : 404, messages : [ "Skill not found" ], data : {} } ) };
							}
							if ( hit[ 1 ].audit_status == "block" ) {
								return { status : 403, body : jsonSerialize( { error : true, statusCode : 403, messages : [ "This skill failed security audit and cannot be installed" ], data : {} } ) };
							}
							return { status : 200, body : jsonSerialize( { error : false, data : { skill : hit[ 1 ], content : skills[ hit[ 1 ].skill_name ].content, audit : { status : hit[ 1 ].audit_status } } } ) };
						}
						if ( path.reFind( "^/api/skills/[^/]+/[^/?]+$" ) ) {
							return { status : 200, body : jsonSerialize( { error : false, data : rows.map( function( r ) {
								return { owner : r.owner, repo : r.repo, name : r.skill_name, slug : r.skill_slug, path : r.skill_dir, description : r.description, audit_status : r.audit_status, sha : r.file_sha };
							} ) } ) };
						}
						var q = ( params.search ?: "" ).lcase();
						return { status : 200, body : jsonSerialize( { error : false, data : { data : rows.filter( function( r ) {
							return !len( q ) || r.skill_name.lcase().find( q ) || r.description.lcase().find( q );
						} ) } } ) };
					};
					return { transport : transport, calls : calls };
				}

				private struct function catalog() {
					return {
						"release-notes" : { owner : "acme", repo : "skills", name : "release-notes", slug : "writing~release-notes", path : "writing/release-notes", description : "Use this skill when writing release notes", content : "---" & char( 10 ) & "name: release-notes" & char( 10 ) & "description: Use this skill when writing release notes" & char( 10 ) & "---" & char( 10 ) & "Write them." & char( 10 ) },
						"triage" : { owner : "acme", repo : "skills", name : "triage", slug : "ops~triage", path : "ops/triage", description : "Use this skill when sorting bugs", content : "---" & char( 10 ) & "name: triage" & char( 10 ) & "description: Use this skill when sorting bugs" & char( 10 ) & "---" & char( 10 ) & "Sort them." & char( 10 ) },
						"shady" : { owner : "acme", repo : "skills", name : "shady", slug : "x~shady", path : "x/shady", description : "A blocked one", audit : "block", content : "bad" & char( 10 ) }
					};
				}

				it( "restores what the lock lists and the disk lacks, then bundles it", function() {
					var projectRoot = newTempProject( "yaml-inline-instructions" );
					var reg = fakeRegistry( catalog() );
					var client = new bxagents.models.skills.RegistryClient( "https://r.example", reg.transport );
					new bxagents.models.skills.SkillInstaller( client ).install( projectRoot, [ "acme/skills/ops~triage" ] );
					directoryDelete( projectRoot & "/.agents/skills", true );
					reg.calls.clear();

					var result = pipeline.setSkillsClient( client ).build( projectRoot );

					expect( reg.calls ).toHaveLength( 1 );
					expect( fileExists( result.appDir & "/skills/triage/SKILL.md" ) ).toBeTrue();
				} );

				it( "fetches nothing when everything the lock lists is already there", function() {
					var projectRoot = newTempProject( "yaml-inline-instructions" );
					var reg = fakeRegistry( catalog() );
					var client = new bxagents.models.skills.RegistryClient( "https://r.example", reg.transport );
					new bxagents.models.skills.SkillInstaller( client ).install( projectRoot, [ "acme/skills/ops~triage" ] );
					reg.calls.clear();

					pipeline.setSkillsClient( client ).build( projectRoot );

					expect( reg.calls ).toBeEmpty();
				} );

				it( "fails the build, naming the skill, when a locked skill cannot be restored", function() {
					var projectRoot = newTempProject( "yaml-inline-instructions" );
					var client = new bxagents.models.skills.RegistryClient( "https://r.example", fakeRegistry( catalog() ).transport );
					new bxagents.models.skills.SkillInstaller( client ).install( projectRoot, [ "acme/skills/ops~triage" ] );
					directoryDelete( projectRoot & "/.agents/skills", true );
					var empty = new bxagents.models.skills.RegistryClient( "https://r.example", fakeRegistry( {} ).transport );

					var message = "";
					try {
						pipeline.setSkillsClient( empty ).build( projectRoot );
					} catch ( BxAgents.SkillRestoreFailed e ) {
						message = e.message;
					}

					expect( message ).toInclude( "Skill triage" );
					expect( message ).toInclude( "skills remove triage" );
				} );

				it( "lets a skill of your own with the same name win over an installed one", function() {
					var projectRoot = newTempProject( "yaml-inline-instructions" );
					var client = new bxagents.models.skills.RegistryClient( "https://r.example", fakeRegistry( catalog() ).transport );
					new bxagents.models.skills.SkillInstaller( client ).install( projectRoot, [ "acme/skills/ops~triage" ] );
					directoryCreate( projectRoot & "/skills/triage" );
					fileWrite( projectRoot & "/skills/triage/SKILL.md", "---" & char( 10 ) & "name: triage" & char( 10 ) & "description: mine" & char( 10 ) & "---" & char( 10 ) );

					var result = pipeline.setSkillsClient( client ).build( projectRoot );
					var discovered = new bxagents.models.build.ProjectDiscoverer().discover( projectRoot ).skills;

					expect( fileRead( result.appDir & "/skills/triage/SKILL.md" ) ).toInclude( "description: mine" );
					expect( discovered ).toHaveLength( 1 );
					expect( discovered[ 1 ].source ).toBe( "project" );
				} );

				it( "marks installed skills as coming from the registry", function() {
					var projectRoot = newTempProject( "yaml-inline-instructions" );
					var client = new bxagents.models.skills.RegistryClient( "https://r.example", fakeRegistry( catalog() ).transport );
					new bxagents.models.skills.SkillInstaller( client ).install( projectRoot, [ "acme/skills/ops~triage" ] );

					var discovered = new bxagents.models.build.ProjectDiscoverer().discover( projectRoot ).skills;

					expect( discovered.map( s => s.name & ":" & s.source ) ).toBe( [ "triage:registry" ] );
				} );

			} );

		} );
	}

}
