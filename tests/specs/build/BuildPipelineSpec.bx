class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "BuildPipeline", function() {

			beforeEach( function() {
				variables.pipeline = new bxagents.models.build.BuildPipeline( "1.2.3" );
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempProject( required string fixtureName ) {
				var dir = createTempDirectory( prefix = "bxagents-pipeline-" );
				directoryCopy( fixtures & "/" & arguments.fixtureName, dir, true );
				tempDirs.append( dir );
				return dir;
			}

			it( "builds a full project end-to-end, producing .build/app and .build/manifest.json", function() {
				var projectRoot = newTempProject( "full-project" );
				var result = pipeline.build( projectRoot );

				expect( directoryExists( result.appDir ) ).toBeTrue();
				expect( fileExists( result.appDir & "/Application.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/config/ColdBox.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/config/WireBox.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/config/Router.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/agent/GeneratedAgentFactory.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/tools/Weather.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/skills/my-skill/SKILL.md" ) ).toBeTrue();

				expect( fileExists( result.manifestPath ) ).toBeTrue();
				expect( result.manifest.manifestVersion ).toBe( "1.0.0" );
				expect( result.manifest.generator.version ).toBe( "1.2.3" );
			} );

			it( 'wires an agent-exposure gateway to route(path).toAi("GeneratedAgent") without any adapter subclass', function() {
				var projectRoot = newTempProject( "full-project" );
				var result = pipeline.build( projectRoot );

				expect( fileExists( result.appDir & "/agent/GeneratedAgentRunnable.bx" ) ).toBeFalse();

				var routerContent = fileRead( result.appDir & "/config/Router.bx" );
				expect( routerContent ).toInclude( 'route( "/api/chat" ).toAi( "GeneratedAgent" )' );
			} );

			it( 'calls aiToolRegistry().scan("tools") at startup only when the project declares tools', function() {
				var withTools = newTempProject( "full-project" );
				var withToolsResult = pipeline.build( withTools );
				expect( fileRead( withToolsResult.appDir & "/Application.bx" ) ).toInclude( 'aiToolRegistry().scan( "tools" )' );

				var withoutTools = newTempProject( "valid-minimal" );
				var withoutToolsResult = pipeline.build( withoutTools );
				expect( fileRead( withoutToolsResult.appDir & "/Application.bx" ) ).notToInclude( "aiToolRegistry().scan(" );
			} );

			it( "throws BxAgents.BuildValidationFailed and produces no .build/app for an invalid project", function() {
				var projectRoot = newTempProject( "validation/duplicate-tool-names" );

				expect( function() {
					pipeline.build( projectRoot );
				} ).toThrow( "BxAgents.BuildValidationFailed" );

				expect( directoryExists( projectRoot & "/.build/app" ) ).toBeFalse();
			} );

			it( "wipes stale .build/app content on rebuild rather than merging", function() {
				var projectRoot = newTempProject( "full-project" );
				var firstResult = pipeline.build( projectRoot );
				fileWrite( firstResult.appDir & "/StaleLeftover.bx", "class {}" );

				var secondResult = pipeline.build( projectRoot );

				expect( fileExists( secondResult.appDir & "/StaleLeftover.bx" ) ).toBeFalse();
			} );

			it( "registers local mcp servers and gateway channel adapters into Application.bx", function() {
				var projectRoot = newTempProject( "gateways-mixed" );
				var result = pipeline.build( projectRoot );

				var content = fileRead( result.appDir & "/Application.bx" );
				expect( content ).toInclude( 'gatewayRegistry().register( aiGateway( "http"' );
				expect( content ).toInclude( 'gatewayRegistry().register( aiGateway( "mock"' );
				expect( content ).toInclude( "mcpServer(" );
			} );

			/**
			 * Regression: a real bug this review closed - each subagent's own
			 * config used to be resolved via `AgentConfigResolver.resolve(
			 * projectRoot = subPath )` with NO `cliEnvironment` passed, so a
			 * subagent's own environment-specific overrides always resolved
			 * against ITS default environment, silently ignoring whatever
			 * `--environment` the whole build was actually invoked with. A
			 * `--environment=production` build could generate a subagent still
			 * wired to its dev-environment config.
			 */
			it( "applies the build's --environment to every subagent's own environment overrides, not just the root project's", function() {
				var projectRoot = newTempProject( "subagent-environment-override" );

				var defaultResult = pipeline.build( projectRoot );
				var defaultContent = fileRead( defaultResult.appDir & "/agent/GeneratedAgentFactory.bx" );
				expect( defaultContent ).toInclude( 'model : "gpt-5"' );
				expect( defaultContent ).notToInclude( 'model : "gpt-5-mini"' );

				var prodResult = pipeline.build( projectRoot, "production" );
				var prodContent = fileRead( prodResult.appDir & "/agent/GeneratedAgentFactory.bx" );
				expect( prodContent ).toInclude( 'model : "gpt-5-mini"' );
			} );

		} );
	}

}
