/**
 * The two shapes of public/Application.bx:
 *
 *   template: the ColdBox BoxLang template's own file, byte for byte, with four fenced insertions; the wiring is app/bxagents/Wiring.bx
 *   stub:     a thin class extending the generated base app/bxagents/Application.bx, which boots ColdBox itself
 *
 * The template is the default. Both carry the same wiring and the same hooks (before(), after(), beforeRequest()).
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		variables.system = createObject( "java", "java.lang.System" );
		variables.savedVariant = new bxagents.models.util.Env().get( "BXAGENTS_APPLICATION_VARIANT" );
		system.clearProperty( "BXAGENTS_APPLICATION_VARIANT" );
	}

	function afterAll() {
		if ( len( variables.savedVariant ) ) {
			system.setProperty( "BXAGENTS_APPLICATION_VARIANT", variables.savedVariant );
		}
	}

	function run() {
		describe( "ColdBoxAppGenerator's public/Application.bx variants", function() {

			beforeEach( function() {
				variables.resolver = new bxagents.models.build.AgentConfigResolver();
				variables.generator = new bxagents.models.build.generators.ColdBoxAppGenerator();
				variables.fixtures = expandPath( "/fixtures" );
				variables.template = expandPath( "/bxagents/templates/coldbox-boxlang/public/Application.bx" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
				system.clearProperty( "BXAGENTS_APPLICATION_VARIANT" );
			} );

			private function newAppDir() {
				var root = createTempDirectory( prefix = "bxagents-variants-" );
				tempDirs.append( root );
				directoryCreate( root & "/app" );
				return root & "/app";
			}

			private function build( required string variant, string fixture = "full-project", string userApplication = "", array startup = [], boolean webUi = false ) {
				var appDir = newAppDir();
				var result = generator.generate(
					projectRoot            = fixtures & "/" & arguments.fixture,
					buildDir               = appDir,
					resolvedConfig         = resolver.resolve( projectRoot = fixtures & "/" & arguments.fixture ),
					extraStartupStatements = arguments.startup,
					userApplicationPath    = arguments.userApplication,
					applicationVariant     = arguments.variant,
					hasWebUi               = arguments.webUi,
					webUiDatabase          = arguments.webUi ? { datasource : "bxagents", path : "./data/chat.db" } : {}
				);
				result.appDir = appDir;
				return result;
			}

			private function userClass( required string source ) {
				var file = createTempDirectory( prefix = "bxagents-userapp-" ) & "/Application.bx";
				tempDirs.append( getDirectoryFromPath( file ) );
				fileWrite( file, arguments.source );
				return file;
			}

			it( "defaults to the template variant", function() {
				expect( generator.defaultVariant() ).toBe( "template" );
				expect( build( "" ).variant ).toBe( "template" );
			} );

			it( "takes the stub variant from BXAGENTS_APPLICATION_VARIANT, and ignores a value it does not know", function() {
				system.setProperty( "BXAGENTS_APPLICATION_VARIANT", "stub" );
				expect( generator.defaultVariant() ).toBe( "stub" );
				system.setProperty( "BXAGENTS_APPLICATION_VARIANT", "bogus" );
				expect( generator.defaultVariant() ).toBe( "template" );
			} );

			it( "refuses a variant it does not know", function() {
				expect( function() {
					build( "bogus" );
				} ).toThrow( "BxAgents.UnknownApplicationVariant" );
			} );

			describe( "template", function() {

				it( "is the template's own public/Application.bx plus fenced blocks: not one template line is changed or removed", function() {
					var result = build( "template" );
					var source = fileRead( result.applicationBx );
					var upstream = fileRead( template );

					expect( source ).notToBe( upstream );
					expect( new bxagents.models.build.generators.TemplateApplication().withoutBlocks( source ) ).toBe( upstream );
				} );

				it( "adds exactly four blocks, each fenced, at the four moments the wiring needs", function() {
					var source = fileRead( build( "template" ).applicationBx );
					expect( source.listToArray( char( 10 ) ).filter( l => trim( l ).startsWith( "// >>> BXAGENTS" ) ) ).toHaveLength( 4 );
					expect( source.listToArray( char( 10 ) ).filter( l => trim( l ) == "// <<< BXAGENTS" ) ).toHaveLength( 4 );
					expect( source ).toInclude( "_bx = new app.bxagents.Wiring()" );
					expect( source ).toInclude( "_bx.before()" );
					expect( source ).toInclude( "_bx.after()" );
					expect( source ).toInclude( "_bx.beforeRequest()" );
					// in order: constructor, before, after, request
					expect( source.find( "_bx = new" ) ).toBeLT( source.find( "_bx.before()" ) );
					expect( source.find( "_bx.before()" ) ).toBeLT( source.find( "new coldbox.system.Bootstrap" ) );
					expect( source.find( "loadColdbox()" ) ).toBeLT( source.find( "_bx.after()" ) );
					expect( source.find( "_bx.beforeRequest()" ) ).toBeLT( source.find( "return application.cbBootstrap.onRequestStart" ) );
				} );

				it( "puts the wiring in app/bxagents/Wiring.bx, with the settings, the three hooks and the startup statements", function() {
					var result = build( "template", "full-project", "", [ "STARTUP_MARKER()" ] );
					expect( result.baseApplicationBx ).toBe( result.appDir & "/bxagents/Wiring.bx" );
					expect( fileExists( result.appDir & "/bxagents/Application.bx" ) ).toBeFalse();
					var wiring = fileRead( result.baseApplicationBx );
					for ( var member in [ "this.name", "function settings()", "function before()", "function after()", "function beforeRequest()" ] ) {
						expect( wiring ).toInclude( member );
					}
					expect( wiring ).notToInclude( "coldbox.system.Bootstrap" );
					expect( wiring ).notToInclude( "function onApplicationStart" );
					expect( wiring.find( "function after()" ) ).toBeLT( wiring.find( "STARTUP_MARKER()" ) );
				} );

				it( "gives an app with no store of its own no default datasource, instead of the template's MySQL one", function() {
					// a project whose agents all chose their own memory type declares no datasource at all
					var dir = createTempDirectory( prefix = "bxagents-variants-nostore-" );
					tempDirs.append( dir );
					fileWrite( dir & "/instructions.md", "Be helpful." );
					fileWrite( dir & "/Agent.yml", "name: keeper" & char( 10 ) & "model: mock/mock-model" & char( 10 ) & "memory:" & char( 10 ) & "  type: window" & char( 10 ) );
					var appDir = newAppDir();
					var result = generator.generate( projectRoot = dir, buildDir = appDir, resolvedConfig = resolver.resolve( projectRoot = dir ), applicationVariant = "template" );
					expect( fileRead( result.baseApplicationBx ) ).toInclude( 'this.datasource = ""' );
				} );

				it( "keeps the project's own Application.bx as a class that extends the wiring, which the template's file creates", function() {
					var own = userClass( 'class extends="bxagents.Application" {' & char( 10 ) & "	this.sessionTimeout = 5" & char( 10 ) & "	function after() { super.after() }" & char( 10 ) & "}" & char( 10 ) );
					var result = build( "template", "full-project", own );

					expect( fileRead( result.appDir & "/bxagents/UserApplication.bx" ) ).toInclude( 'class extends="app.bxagents.Wiring" {' );
					expect( fileRead( result.appDir & "/bxagents/UserApplication.bx" ) ).toInclude( "this.sessionTimeout = 5" );
					expect( fileRead( result.applicationBx ) ).toInclude( "_bx = new app.bxagents.UserApplication()" );
					expect( fileRead( result.applicationBx ) ).notToInclude( "new app.bxagents.Wiring()" );
					expect( result.warnings ).toBeEmpty();
				} );

				it( "says so when the project's Application.bx overrides a lifecycle method the template's file owns", function() {
					var own = userClass( 'class extends="bxagents.Application" {' & char( 10 ) & "	function onApplicationStart() { return super.onApplicationStart() }" & char( 10 ) & "}" & char( 10 ) );
					var result = build( "template", "full-project", own );

					expect( result.warnings ).toHaveLength( 1 );
					expect( result.warnings[ 1 ] ).toInclude( "onApplicationStart" );
					expect( result.warnings[ 1 ] ).toInclude( "before(), after() or beforeRequest()" );
				} );

				it( "does not mistake a lifecycle name in a comment for an override", function() {
					var own = userClass( 'class extends="bxagents.Application" {' & char( 10 ) & "	// function onApplicationStart() would replace the wiring" & char( 10 ) & "}" & char( 10 ) );
					expect( build( "template", "full-project", own ).warnings ).toBeEmpty();
				} );

				it( "stops, naming the line, when a refreshed template no longer has a line the blocks are put after", function() {
					var changed = replace( fileRead( template ), 'this.datasource = "coldbox"', 'this.datasource = "elsewhere"' );
					expect( function() {
						new bxagents.models.build.generators.TemplateApplication().insert( changed );
					} ).toThrow( "BxAgents.TemplateChanged" );
				} );

			} );

			describe( "stub", function() {

				it( "is a thin class extending the generated base", function() {
					var result = build( "stub" );
					var source = fileRead( result.applicationBx );
					expect( source ).toInclude( 'class extends="app.bxagents.Application" {' );
					expect( source ).notToInclude( "coldbox.system.Bootstrap" );
					expect( result.baseApplicationBx ).toBe( result.appDir & "/bxagents/Application.bx" );
					expect( fileExists( result.appDir & "/bxagents/Wiring.bx" ) ).toBeFalse();
				} );

				it( "boots ColdBox from the base, with the app and the web mapping the template names", function() {
					var base = fileRead( build( "stub" ).baseApplicationBx );
					expect( base ).toInclude( 'COLDBOX_APP_ROOT_PATH  = expandPath( "/app" )' );
					expect( base ).toInclude( 'COLDBOX_APP_MAPPING    = "/app"' );
					expect( base ).toInclude( 'COLDBOX_WEB_MAPPING    = "/"' );
					expect( base ).toInclude( "COLDBOX_WEB_MAPPING   = COLDBOX_WEB_MAPPING" );
					expect( base ).toInclude( "function onApplicationStart()" );
				} );

				it( "puts the project's own Application.bx in the web root, extending the generated base", function() {
					var own = userClass( 'class extends="bxagents.Application" {' & char( 10 ) & "	function onApplicationStart() { var started = super.onApplicationStart(); return started }" & char( 10 ) & "}" & char( 10 ) );
					var result = build( "stub", "full-project", own );

					expect( fileRead( result.applicationBx ) ).toInclude( 'class extends="app.bxagents.Application" {' );
					expect( fileRead( result.applicationBx ) ).toInclude( "super.onApplicationStart()" );
					expect( fileExists( result.appDir & "/bxagents/UserApplication.bx" ) ).toBeFalse();
					// the stub's class IS the Application: overriding its lifecycle methods is what it is for
					expect( result.warnings ).toBeEmpty();
				} );

			} );

			describe( "both", function() {

				it( "carry the same wiring: the same settings and the same startup statements", function() {
					var statements = [ 'STARTUP_ONE()', 'STARTUP_TWO()' ];
					var template = fileRead( build( "template", "gateways-webui", "", statements, true ).baseApplicationBx );
					var stub = fileRead( build( "stub", "gateways-webui", "", statements, true ).baseApplicationBx );

					for ( var shared in [ 'this.name              = "', "this.sessionManagement = true", 'this.datasources[ "', "STARTUP_ONE()", "STARTUP_TWO()", "function before()", "function after()", "function beforeRequest()", 'new "models.logs.Logger@bxagents"()', 'appPath( "config/bxai-settings.json" )', "RequestBody@bxagents" ] ) {
						expect( template ).toInclude( shared );
						expect( stub ).toInclude( shared );
					}
				} );

				it( "write the same config and handlers into the app", function() {
					for ( var variant in [ "template", "stub" ] ) {
						var result = build( variant );
						var app = result.appDir;
						var config = fileRead( app & "/config/Coldbox.bx" );
						// `variables.`: a bare `coldbox = {` is local to configure() in BoxLang, so ColdBox never saw it
						expect( config ).toInclude( "variables.coldbox = {" );
						expect( config ).toInclude( "variables.moduleSettings = {" );
						expect( config ).toInclude( 'modulesExternalLocation : [ "/modules" ]' );
						expect( config ).toInclude( 'defaultEvent : "NotFound.index"' );
						expect( config ).toInclude( 'invalidEventHandler : "NotFound.index"' );
						expect( fileExists( app & "/config/ColdBox.bx" ) && !fileExists( app & "/config/Coldbox.bx" ) ).toBeFalse();
						expect( fileRead( app & "/config/WireBox.bx" ) ).toInclude( '.to( "app.agent.GeneratedAgentFactory" )' );
						expect( fileRead( app & "/handlers/NotFound.bx" ) ).toInclude( "statusCode = 404" );
					}
				} );

			} );

		} );
	}

}
