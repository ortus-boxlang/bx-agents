/**
 * The run-control handler written into the generated app.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "AgentApiGenerator", function() {

			beforeEach( function() {
				variables.generator = new bxagents.models.build.generators.AgentApiGenerator();
				variables.dirs = [];
			} );

			afterEach( function() {
				for ( var dir in dirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newAppDir() {
				var dir = createTempDirectory( prefix = "bxagents-agentapi-" );
				dirs.append( dir );
				return dir;
			}

			it( "writes handlers/AgentApi.bx with every run-control action", function() {
				var dir = newAppDir();
				var result = generator.generate( dir, {} );
				var source = fileRead( result.path );

				expect( result.written ).toBeTrue();
				expect( result.path ).toBe( dir & "/handlers/AgentApi.bx" );
				for ( var action in [ "invoke", "stream", "batch", "info", "health", "events", "cancel", "steer", "pending", "resume", "tools", "about", "notes", "sessions", "history", "clear", "compact", "updateNote", "removeNote", "profiles", "commands", "command", "renameSession", "forkSession", "deleteSession", "export", "whoami", "preferences", "setPreference", "deletePreference", "ping", "context", "status", "slots" ] ) {
					expect( source ).toInclude( "function #action#( event, rc, prc )" );
				}
				// every action starts by checking the token (a preHandler cannot stop the action)
				expect( source.reMatch( "if \( refused\( event \) \)" ) ).toHaveLength( 33 );
				expect( source ).notToInclude( "function preHandler(" );
				// the work is the service's: the handler holds no copy of the turn, picture or conversation logic
				expect( source ).toInclude( "models.api.AgentService@bxagents" );
				expect( source ).notToInclude( "MessageBuilder@bxagents" );
				expect( source ).notToInclude( "BoxRegisterInterceptor" );
			} );

			it( "stamps agentApi.profiles in as the list a caller may ask for, none by default", function() {
				var none = fileRead( generator.generate( newAppDir(), {} ).path );
				var some = fileRead( generator.generate( newAppDir(), { profiles : [ "fast", "planner" ] } ).path );

				expect( none ).toInclude( 'jsonDeserialize( "[]" )' );
				expect( some ).toInclude( 'jsonDeserialize( "[""fast"",""planner""]" )' );
				expect( some ).notToInclude( "__PROFILES__" );
				// the profile check itself is the turn runner's, given the same list
				expect( some ).toInclude( "OfferedProfiles@bxagents" );
			} );

			it( "stamps the access mode in: open unless a secret or issued tokens are set, or access says so", function() {
				expect( fileRead( generator.generate( newAppDir(), {} ).path ) ).toInclude( 'return "open"' );
				expect( fileRead( generator.generate( newAppDir(), { tokens : true } ).path ) ).toInclude( 'return "token"' );
				expect( fileRead( generator.generate( newAppDir(), { tokenEnvVar : "MY_AGENT_TOKEN" } ).path ) ).toInclude( 'return "token"' );
				expect( fileRead( generator.generate( newAppDir(), { access : "open" } ).path ) ).toInclude( 'return "open"' );
			} );

			it( "does not carry the token variable or any token check: the route middleware decides who may call", function() {
				var source = fileRead( generator.generate( newAppDir(), { tokenEnvVar : "MY_AGENT_TOKEN", tokens : true } ).path );

				expect( source ).notToInclude( "MY_AGENT_TOKEN" );
				expect( source ).notToInclude( "__ACCESS__" );
				expect( source ).notToInclude( "TokenService" );
			} );

			it( "writes nothing when agentApi.enabled is false", function() {
				var dir = newAppDir();
				var result = generator.generate( dir, { enabled : false } );

				expect( result.written ).toBeFalse();
				expect( directoryExists( dir & "/handlers" ) ).toBeFalse();
			} );

			it( "writes a class BoxLang can compile", function() {
				var dir = newAppDir();
				generator.generate( dir, { tokenEnvVar : "T" } );

				var handler = createObject( "component", "bxagents.models.build.generators.agentapi.AgentApi" );

				expect( isObject( handler ) ).toBeTrue();
			} );

		} );
	}

}
