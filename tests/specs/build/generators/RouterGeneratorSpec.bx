class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "RouterGenerator", function() {

			beforeEach( function() {
				variables.discoverer = new bxagents.models.build.ProjectDiscoverer();
				variables.generator = new bxagents.models.build.generators.RouterGenerator();
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newAppDir() {
				var dir = createTempDirectory( prefix = "bxagents-router-" );
				tempDirs.append( dir );
				return dir & "/app";
			}

			it( "emits the four turn routes, served by handlers/AgentApi, per agent-exposure entry", function() {
				var discovery = discoverer.discover( fixtures & "/full-project" );
				var result = generator.generate( discovery, newAppDir() );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'post( "/api/chat/invoke" ).toHandler( "AgentApi.invoke" )' );
				expect( content ).toInclude( 'post( "/api/chat/stream" ).toHandler( "AgentApi.stream" )' );
				expect( content ).toInclude( 'post( "/api/chat/batch" ).toHandler( "AgentApi.batch" )' );
				expect( content ).toInclude( 'get( "/api/chat/info" ).toHandler( "AgentApi.info" )' );
				expect( content ).notToInclude( ".toAi(" );
			} );

			it( "routes a webui entry to the extension files and nothing else: the page calls the agent API", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var result = generator.generate( discovery, newAppDir() );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'get( "/chat/ext/:extension/:file-regex:(.+)" ).toHandler( "AgentApi.extensionFile" )' );
				// the page's own calls go to the reserved path, behind the one gate, so no second set of routes exists
				expect( content ).notToInclude( "ChatUi" );
				expect( content ).notToInclude( "/chat/api" );
				expect( content ).notToInclude( 'route( "/chat" ).toAi( "GeneratedAgent" )' );
			} );

			it( "emits one route(path).toMCP(target) per mcp-exposure entry", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir() );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'route( "/mcp/tools" ).toMCP( "toolServer" )' );
				expect( content ).toInclude( 'post( "/api/chat/invoke" ).toHandler( "AgentApi.invoke" )' );
				expect( content ).toInclude( 'post( "/api/chat/stream" ).toHandler( "AgentApi.stream" )' );
				expect( content ).toInclude( 'post( "/api/chat/batch" ).toHandler( "AgentApi.batch" )' );
				expect( content ).toInclude( 'get( "/api/chat/info" ).toHandler( "AgentApi.info" )' );
				expect( content ).notToInclude( ".toAi(" );
			} );

			it( "orders exposure routes deterministically by path", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir() );

				var content = fileRead( result.router );
				var apiPos = content.find( "/api/chat" );
				var mcpPos = content.find( "/mcp/tools" );

				expect( apiPos > 0 ).toBeTrue();
				expect( mcpPos > 0 ).toBeTrue();
				expect( apiPos < mcpPos ).toBeTrue();
			} );

			it( "emits the native toAiGateway() terminator when a channel gateway exists", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), true );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'route( "/gateways" ).toAiGateway()' );
				// The old hand-wired surface: three routes into a generated passthrough handler
				expect( content ).notToInclude( "Gateway.process" );
			} );

			it( "does not emit the gateway terminator when the project declares no channel gateway at all", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false );

				var content = fileRead( result.router );
				expect( content ).notToInclude( "toAiGateway" );
			} );

			it( "mounts the gateway surface for a PUSH-only project, not just an http one", function() {
				// The regression this closes: the mount used to be gated on
				// `type: "http"` specifically, so a Telegram/Slack/Discord-only
				// project got no /gateways mount - and therefore no
				// /interactions/:requestID routes, which are how a human answers
				// a pending human-in-the-loop approval. Such an agent could pause
				// for an approval it had no endpoint to receive. `http` is one
				// gateway among many and must not gate the others.
				var discovery = discoverer.discover( fixtures & "/gateways-telegram" );
				var content = fileRead( generator.generate( discovery, newAppDir(), true ).router );

				expect( content ).toInclude( 'route( "/gateways" ).toAiGateway()' );
			} );

			it( "serves the whole agent API on agentApi.path when one is set, and nowhere else", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var content = fileRead( generator.generate( discovery, newAppDir(), false, false, false, false, false, { path : "/agent-api" } ).router );

				expect( content ).toInclude( 'post( "/agent-api/invoke" )' );
				expect( content ).toInclude( 'post( "/agent-api/events" )' );
				expect( content ).toInclude( 'route( "/agent-api/sessions" )' );
				expect( content ).notToInclude( "/__bxagents" );
			} );

			it( "puts the gate in front of an open API that keeps addresses out or limits use, and passes the settings to it", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var open = fileRead( generator.generate( discovery, newAppDir() ).router );
				var guarded = fileRead( generator.generate( discovery, newAppDir(), false, false, false, false, false, { allowedIPs : [ "10.0.0.0/8" ], rateLimit : { requests : 30, perSeconds : 60 } } ).router );

				expect( open ).notToInclude( "var auth" );
				expect( open ).notToInclude( ".middleware( auth )" );
				expect( guarded ).toInclude( "var auth" );
				expect( guarded ).toInclude( 'post( "/__bxagents/invoke" ).middleware( auth )' );
				expect( guarded ).toInclude( "10.0.0.0/8" );
				expect( guarded ).toInclude( "open : true" );
				// ... but the health probe stays open to anyone
				expect( guarded ).toInclude( 'get( "/__bxagents/health" ).toHandler' );
			} );

			it( "emits the WhatsApp Cloud GET/POST webhook routes when hasWhatsAppCloudGateway is true", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, true );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'get( "/webhooks/whatsapp-cloud" ).toHandler( "WhatsAppCloud.verify" )' );
				expect( content ).toInclude( 'post( "/webhooks/whatsapp-cloud" ).toHandler( "WhatsAppCloud.process" )' );
			} );

			it( "does not emit WhatsApp Cloud webhook routes when hasWhatsAppCloudGateway is false", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false );

				var content = fileRead( result.router );
				expect( content ).notToInclude( "WhatsAppCloud" );
			} );

			it( "emits the Teams POST webhook route when hasTeamsGateway is true", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, true );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'post( "/webhooks/teams" ).toHandler( "Teams.process" )' );
			} );

			it( "does not emit the Teams webhook route when hasTeamsGateway is false", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, false );

				var content = fileRead( result.router );
				expect( content ).notToInclude( "Teams.process" );
			} );

			it( "emits the Twilio POST webhook route when hasTwilioGateway is true", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, false, true );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'post( "/webhooks/twilio" ).toHandler( "Twilio.process" )' );
			} );

			it( "does not emit the Twilio webhook route when hasTwilioGateway is false", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, false, false );

				var content = fileRead( result.router );
				expect( content ).notToInclude( "Twilio.process" );
			} );

			it( "emits the GitHub POST webhook route when hasGitHubGateway is true", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, false, false, true );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'post( "/webhooks/github" ).toHandler( "GitHub.process" )' );
			} );

			it( "does not emit the GitHub webhook route when hasGitHubGateway is false", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, false, false, false );

				var content = fileRead( result.router );
				expect( content ).notToInclude( "GitHub.process" );
			} );

			it( "reports hasAgentExposure=true only when an agent-exposure entry exists", function() {
				var withAgent = discoverer.discover( fixtures & "/full-project" );
				var withAgentResult = generator.generate( withAgent, newAppDir() );
				expect( withAgentResult.hasAgentExposure ).toBeTrue();

				var withoutAgent = discoverer.discover( fixtures & "/valid-minimal" );
				var withoutAgentResult = generator.generate( withoutAgent, newAppDir() );
				expect( withoutAgentResult.hasAgentExposure ).toBeFalse();
			} );

			it( "writes a valid router carrying only the reserved agent route when there is nothing else to expose", function() {
				// The reserved route is unconditional, so even a project that
				// declares no gateways at all now produces a router with one
				// route in it - which is the whole point of it being always-on.
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var result = generator.generate( discovery, newAppDir() );

				expect( fileExists( result.router ) ).toBeTrue();
				expect( result.hasRoutes ).toBeTrue();
				expect( result.hasAgentExposure ).toBeFalse();
				expect( fileRead( result.router ) ).toInclude( "function configure()" );
			} );

			it( "always emits the reserved /__bxagents agent route, even with zero gateways", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var result = generator.generate( discovery, newAppDir() );

				expect( fileRead( result.router ) ).toInclude( 'post( "/__bxagents/invoke" ).toHandler( "AgentApi.invoke" )' );
			} );

			it( "emits the reserved route ALONGSIDE a project's own exposures, not instead of them", function() {
				var discovery = discoverer.discover( fixtures & "/full-project" );
				var content = fileRead( generator.generate( discovery, newAppDir() ).router );

				expect( content ).toInclude( 'post( "/__bxagents/invoke" ).toHandler( "AgentApi.invoke" )' );
				expect( content ).toInclude( 'post( "/api/chat/invoke" ).toHandler( "AgentApi.invoke" )' );
				expect( content ).toInclude( 'post( "/api/chat/stream" ).toHandler( "AgentApi.stream" )' );
				expect( content ).toInclude( 'post( "/api/chat/batch" ).toHandler( "AgentApi.batch" )' );
				expect( content ).toInclude( 'get( "/api/chat/info" ).toHandler( "AgentApi.info" )' );
				expect( content ).notToInclude( ".toAi(" );
			} );

			it( "omits the reserved route entirely when agentApi.enabled is false", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var result = generator.generate(
					discovery,
					newAppDir(),
					false, false, false, false, false,
					{ enabled : false }
				);

				var content = fileRead( result.router );
				expect( content ).notToInclude( "__bxagents" );
				expect( result.hasRoutes ).toBeFalse();
			} );

			it( "routes the conversation, preference, export and whoami actions, the specific paths before the ones that would match them", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var content = fileRead( generator.generate( discovery, newAppDir() ).router );

				// one route lists (GET) and starts (POST), so a GET can never land on the creating action
				expect( content ).toInclude( 'route( "/__bxagents/sessions" ).toHandler( "AgentApi.sessions" )' );
				expect( content ).notToInclude( "createSession" );
				expect( content ).toInclude( 'post( "/__bxagents/sessions/delete" ).toHandler( "AgentApi.deleteSession" )' );
				expect( content ).toInclude( 'get( "/__bxagents/export" ).toHandler( "AgentApi.export" )' );
				expect( content ).toInclude( 'get( "/__bxagents/whoami" ).toHandler( "AgentApi.whoami" )' );
				expect( content ).toInclude( 'get( "/__bxagents/preferences" ).toHandler( "AgentApi.preferences" )' );
				expect( content.find( "sessions/delete" ) ).toBeLT( content.find( 'route( "/__bxagents/sessions" )' ) );
				expect( content.find( "preferences/set" ) ).toBeLT( content.find( 'get( "/__bxagents/preferences" )' ) );
			} );

			it( "puts every route of an API that needs a token behind route middleware", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var content = fileRead( generator.generate(
					discovery,
					newAppDir(),
					false, false, false, false, false,
					{ tokenEnvVar : "BXAGENTS_API_TOKEN" }
				).router );

				// the gate asks the Authenticator, and names the variable, never the secret
				expect( content ).toInclude( 'var auth = ( event, rc, prc ) => new "models.api.Authenticator@bxagents"( tokenEnvVar : "BXAGENTS_API_TOKEN", tokens : false, accounts : false,' );
				expect( content ).toInclude( 'post( "/__bxagents/invoke" ).middleware( auth ).toHandler( "AgentApi.invoke" )' );
				expect( content ).toInclude( 'post( "/__bxagents/stream" ).middleware( auth ).toHandler( "AgentApi.stream" )' );
				expect( content ).toInclude( 'post( "/__bxagents/events" ).middleware( auth ).toHandler( "AgentApi.events" )' );
				expect( content ).toInclude( 'route( "/__bxagents/notes" ).middleware( auth ).toHandler( "AgentApi.notes" )' );
				// every route of the API has it, none is left out
				var routes = content.listToArray( char( 10 ) ).filter( ( line ) => line.find( '( "/__bxagents' ) );
				expect( routes.len() ).toBeGT( 20 );
				// health is the one route that is open to anyone: it says only that the server is up
				expect( routes.filter( ( r ) => !r.find( ".middleware( auth )" ) ).map( ( r ) => reReplace( r, "^[[:space:]]+", "" ) ) ).toBe( [ 'get( "/__bxagents/health" ).toHandler( "AgentApi.health" )' ] );
				// the old gate and its catch-all are gone: the middleware answers 401 itself
				expect( content ).notToInclude( "withCondition" );
				expect( content ).notToInclude( ":subroute?" );
				expect( content ).notToInclude( ".toAi(" );
			} );

			it( "gates the agent routes a gateway exposes by the same switch", function() {
				var discovery = discoverer.discover( fixtures & "/full-project" );
				var content = fileRead( generator.generate(
					discovery,
					newAppDir(),
					false, false, false, false, false,
					{ tokens : true }
				).router );

				expect( content ).toInclude( 'post( "/api/chat/invoke" ).middleware( auth ).toHandler( "AgentApi.invoke" )' );
				expect( content ).toInclude( 'get( "/api/chat/info" ).middleware( auth ).toHandler( "AgentApi.info" )' );
			} );

			it( "defines the gate before the first route that uses it", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var content = fileRead( generator.generate( discovery, newAppDir(), false, false, false, false, false, { tokens : true } ).router );

				expect( content.find( "var auth =" ) ).toBeGT( 0 );
				expect( content.find( "var auth =" ) ).toBeLT( content.find( ".middleware( auth )" ) );
			} );

			it( "puts no gate on an open API, even with agentApi.access spelled out", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var content = fileRead( generator.generate( discovery, newAppDir(), false, false, false, false, false, { access : "open" } ).router );

				expect( content ).notToInclude( "middleware" );
				expect( content ).notToInclude( "auth" );
			} );

			it( "closes the API behind the page's sign-in when the web UI lists users, and tells the gate to accept it", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var content = fileRead( generator.generate( discovery, newAppDir(), false, false, false, false, false, { webAccounts : true } ).router );

				expect( content ).toInclude( 'Authenticator@bxagents"( tokenEnvVar : "", tokens : false, accounts : true,' );
				expect( content ).toInclude( 'post( "/__bxagents/events" ).middleware( auth )' );
			} );

			it( "gates on access: token with issued tokens alone", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var content = fileRead( generator.generate( discovery, newAppDir(), false, false, false, false, false, { access : "token", tokens : true } ).router );

				expect( content ).toInclude( 'Authenticator@bxagents"( tokenEnvVar : "", tokens : true, accounts : false,' );
			} );

			it( "adds the run-control routes beside the turn routes, served by handlers/AgentApi", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var content = fileRead( generator.generate( discovery, newAppDir() ).router );

				expect( content ).toInclude( 'post( "/__bxagents/events" ).toHandler( "AgentApi.events" )' );
				expect( content ).toInclude( 'post( "/__bxagents/cancel" ).toHandler( "AgentApi.cancel" )' );
				expect( content ).toInclude( 'post( "/__bxagents/steer" ).toHandler( "AgentApi.steer" )' );
				expect( content ).toInclude( 'post( "/__bxagents/resume" ).toHandler( "AgentApi.resume" )' );
				expect( content ).toInclude( 'get( "/__bxagents/pending" ).toHandler( "AgentApi.pending" )' );
				expect( content ).toInclude( 'get( "/__bxagents/tools" ).toHandler( "AgentApi.tools" )' );
				expect( content ).toInclude( 'get( "/__bxagents/agent" ).toHandler( "AgentApi.about" )' );
				expect( content ).toInclude( 'route( "/__bxagents/sessions" ).toHandler( "AgentApi.sessions" )' );
				expect( content ).toInclude( 'post( "/__bxagents/sessions/rename" ).toHandler( "AgentApi.renameSession" )' );
				expect( content ).toInclude( 'post( "/__bxagents/sessions/fork" ).toHandler( "AgentApi.forkSession" )' );
				// the specific routes come before the list route, which would otherwise match what follows it
				expect( content.find( "sessions/rename" ) ).toBeLT( content.find( 'route( "/__bxagents/sessions" )' ) );
				expect( content ).toInclude( 'get( "/__bxagents/history" ).toHandler( "AgentApi.history" )' );
				expect( content ).toInclude( 'post( "/__bxagents/clear" ).toHandler( "AgentApi.clear" )' );
				expect( content ).toInclude( 'post( "/__bxagents/compact" ).toHandler( "AgentApi.compact" )' );
				expect( content ).toInclude( 'post( "/__bxagents/ping" ).toHandler( "AgentApi.ping" )' );
				expect( content ).toInclude( 'get( "/__bxagents/context" ).toHandler( "AgentApi.context" )' );
				expect( content ).toInclude( 'get( "/__bxagents/commands" ).toHandler( "AgentApi.commands" )' );
				expect( content ).toInclude( 'post( "/__bxagents/command" ).toHandler( "AgentApi.command" )' );
				expect( content ).toInclude( 'route( "/__bxagents/notes" ).toHandler( "AgentApi.notes" )' );
				expect( content ).toInclude( 'post( "/__bxagents/notes/update" ).toHandler( "AgentApi.updateNote" )' );
				expect( content ).toInclude( 'post( "/__bxagents/notes/remove" ).toHandler( "AgentApi.removeNote" )' );
			} );

		} );
	}

}
