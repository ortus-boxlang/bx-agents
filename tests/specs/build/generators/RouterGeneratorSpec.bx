class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "RouterGenerator", function() {

			beforeEach( function() {
				variables.discoverer = new bxagents.models.build.ProjectDiscoverer();
				variables.generator = new bxagents.models.build.generators.RouterGenerator();
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newAppDir() {
				var dir = createTempDirectory( prefix = "bxagents-router-" );
				tempDirs.append( dir );
				return dir & "/app";
			}

			it( 'emits one route(path).toAi("GeneratedAgent") per agent-exposure entry', function() {
				var discovery = discoverer.discover( fixtures & "/full-project" );
				var result = generator.generate( discovery, newAppDir() );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'route( "/api/chat" ).toAi( "GeneratedAgent" )' );
			} );

			it( 'routes a webui entry to its own ChatUi handler, not toAi(), so userId comes from the session', function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var result = generator.generate( discovery, newAppDir() );

				var content = fileRead( result.router );
				// Deliberately NOT toAi(). ColdBox 8.1's toAi() now derives context
				// itself, but lets a caller-supplied userId WIN over the session -
				// right for a trusted server-to-server caller, wrong for a browser
				// behind one shared API key. ChatUi derives it server-side only.
				expect( content ).toInclude( 'post( "/chat/api/stream" ).toHandler( "ChatUi.stream" )' );
				expect( content ).toInclude( 'post( "/chat/api/invoke" ).toHandler( "ChatUi.invoke" )' );
				expect( content ).toInclude( 'post( "/chat/api/batch" ).toHandler( "ChatUi.batch" )' );
				expect( content ).toInclude( 'get( "/chat/api/info" ).toHandler( "ChatUi.info" )' );

				// Conversations and preferences, both backed by the SQLite store
				expect( content ).toInclude( 'get( "/chat/api/conversations" ).toHandler( "ChatUi.conversations" )' );
				expect( content ).toInclude( 'post( "/chat/api/conversations/create" ).toHandler( "ChatUi.conversationCreate" )' );
				expect( content ).toInclude( 'post( "/chat/api/conversations/rename" ).toHandler( "ChatUi.conversationRename" )' );
				expect( content ).toInclude( 'post( "/chat/api/conversations/delete" ).toHandler( "ChatUi.conversationDelete" )' );
				expect( content ).toInclude( 'get( "/chat/api/preferences" ).toHandler( "ChatUi.preferences" )' );
				expect( content ).toInclude( 'post( "/chat/api/preferences/set" ).toHandler( "ChatUi.preferenceSet" )' );
				expect( content ).toInclude( 'post( "/chat/api/preferences/delete" ).toHandler( "ChatUi.preferenceDelete" )' );
				expect( content ).notToInclude( 'route( "/chat" ).toAi( "GeneratedAgent" )' );
				expect( content ).notToInclude( 'route( "/chat/api" ).toAi( "GeneratedAgent" )' );
			} );

			it( "emits one route(path).toMCP(target) per mcp-exposure entry", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir() );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'route( "/mcp/tools" ).toMCP( "toolServer" )' );
				expect( content ).toInclude( 'route( "/api/chat" ).toAi( "GeneratedAgent" )' );
			} );

			it( "orders exposure routes deterministically by path", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir() );

				var content = fileRead( result.router );
				var apiPos = content.find( "/api/chat" );
				var mcpPos = content.find( "/mcp/tools" );

				expect( apiPos > 0 ).toBeTrue();
				expect( mcpPos > 0 ).toBeTrue();
				expect( apiPos < mcpPos ).toBeTrue();
			} );

			it( "emits the native toAiGateway() terminator when hasHttpGateway is true", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), true );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'route( "/gateways" ).toAiGateway()' );
				// The old hand-wired surface: three routes into a generated passthrough handler
				expect( content ).notToInclude( "Gateway.process" );
			} );

			it( "does not emit the gateway terminator when hasHttpGateway is false", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false );

				var content = fileRead( result.router );
				expect( content ).notToInclude( "toAiGateway" );
			} );

			it( "emits the WhatsApp Cloud GET/POST webhook routes when hasWhatsAppCloudGateway is true", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, true );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'get( "/webhooks/whatsapp-cloud" ).toHandler( "WhatsAppCloud.verify" )' );
				expect( content ).toInclude( 'post( "/webhooks/whatsapp-cloud" ).toHandler( "WhatsAppCloud.process" )' );
			} );

			it( "does not emit WhatsApp Cloud webhook routes when hasWhatsAppCloudGateway is false", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false );

				var content = fileRead( result.router );
				expect( content ).notToInclude( "WhatsAppCloud" );
			} );

			it( "emits the Teams POST webhook route when hasTeamsGateway is true", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, true );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'post( "/webhooks/teams" ).toHandler( "Teams.process" )' );
			} );

			it( "does not emit the Teams webhook route when hasTeamsGateway is false", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, false );

				var content = fileRead( result.router );
				expect( content ).notToInclude( "Teams.process" );
			} );

			it( "emits the Twilio POST webhook route when hasTwilioGateway is true", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, false, true );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'post( "/webhooks/twilio" ).toHandler( "Twilio.process" )' );
			} );

			it( "does not emit the Twilio webhook route when hasTwilioGateway is false", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, false, false );

				var content = fileRead( result.router );
				expect( content ).notToInclude( "Twilio.process" );
			} );

			it( "emits the GitHub POST webhook route when hasGitHubGateway is true", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, false, false, true );

				var content = fileRead( result.router );
				expect( content ).toInclude( 'post( "/webhooks/github" ).toHandler( "GitHub.process" )' );
			} );

			it( "does not emit the GitHub webhook route when hasGitHubGateway is false", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir(), false, false, false, false, false );

				var content = fileRead( result.router );
				expect( content ).notToInclude( "GitHub.process" );
			} );

			it( "reports hasAgentExposure=true only when an agent-exposure entry exists", function() {
				var withAgent = discoverer.discover( fixtures & "/full-project" );
				var withAgentResult = generator.generate( withAgent, newAppDir() );
				expect( withAgentResult.hasAgentExposure ).toBeTrue();

				var withoutAgent = discoverer.discover( fixtures & "/valid-minimal" );
				var withoutAgentResult = generator.generate( withoutAgent, newAppDir() );
				expect( withoutAgentResult.hasAgentExposure ).toBeFalse();
			} );

			it( "writes a valid router carrying only the reserved agent route when there is nothing else to expose", function() {
				// The reserved route is unconditional, so even a project that
				// declares no gateways at all now produces a router with one
				// route in it - which is the whole point of it being always-on.
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var result = generator.generate( discovery, newAppDir() );

				expect( fileExists( result.router ) ).toBeTrue();
				expect( result.hasRoutes ).toBeTrue();
				expect( result.hasAgentExposure ).toBeFalse();
				expect( fileRead( result.router ) ).toInclude( "function configure()" );
			} );

			it( "always emits the reserved /__bxagents agent route, even with zero gateways", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var result = generator.generate( discovery, newAppDir() );

				expect( fileRead( result.router ) ).toInclude( 'route( "/__bxagents" ).toAi( "GeneratedAgent" )' );
			} );

			it( "emits the reserved route ALONGSIDE a project's own exposures, not instead of them", function() {
				var discovery = discoverer.discover( fixtures & "/full-project" );
				var content = fileRead( generator.generate( discovery, newAppDir() ).router );

				expect( content ).toInclude( 'route( "/__bxagents" ).toAi( "GeneratedAgent" )' );
				expect( content ).toInclude( 'route( "/api/chat" ).toAi( "GeneratedAgent" )' );
			} );

			it( "omits the reserved route entirely when agentApi.enabled is false", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var result = generator.generate(
					discovery,
					newAppDir(),
					false, false, false, false, false,
					{ enabled : false }
				);

				var content = fileRead( result.router );
				expect( content ).notToInclude( "__bxagents" );
				expect( result.hasRoutes ).toBeFalse();
			} );

			it( "gates the reserved route behind a fail-closed withCondition when agentApi.tokenEnvVar is set", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var content = fileRead( generator.generate(
					discovery,
					newAppDir(),
					false, false, false, false, false,
					{ tokenEnvVar : "BXAGENTS_API_TOKEN" }
				).router );

				expect( content ).toInclude( 'route( "/__bxagents" )' );
				expect( content ).toInclude( '.withCondition(' );
				expect( content ).toInclude( 'getSystemSetting( "BXAGENTS_API_TOKEN", "" )' );

				// The env var NAME is emitted; the secret itself never is.
				expect( content ).toInclude( 'headers[ "x-bxagents-token" ]' );

				// Fails closed: a blank/unset env var returns false outright
				// rather than collapsing to "" == "" and admitting everyone.
				expect( content ).toInclude( "if ( !len( expected ) ) {" );

				// RoutingService invokes the condition as condition( requestString ) -
				// ONE argument. A ( route, params, event ) closure would blow up on
				// an event that is never passed.
				expect( content ).toInclude( ".withCondition( ( requestString ) =>" );

				// A refused request must land on a deliberate 401, not fall
				// through to ColdBox's default main.index event - which a
				// generated app never defines, so that path renders a 500
				// error page instead of a refusal.
				expect( content ).toInclude( 'route( "/__bxagents/:subroute?" )' );
				expect( content ).toInclude( "}, 401 )" );
			} );

			it( "registers no 401 fallback when the reserved route is ungated - there is nothing to turn away", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var content = fileRead( generator.generate( discovery, newAppDir() ).router );

				expect( content ).notToInclude( ":subroute?" );
				expect( content ).notToInclude( "401" );
			} );

		} );
	}

}
