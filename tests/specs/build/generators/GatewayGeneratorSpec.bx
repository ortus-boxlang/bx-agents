class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "GatewayGenerator", function() {

			beforeEach( function() {
				variables.discoverer = new bxagents.models.build.ProjectDiscoverer();
				variables.generator = new bxagents.models.build.generators.GatewayGenerator();
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newAppDir() {
				var dir = createTempDirectory( prefix = "bxagents-gateway-" );
				tempDirs.append( dir );
				return dir & "/app";
			}

			it( "emits one aiGatewayRegistry().register() call per channel-adapter entry, ordered by name", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir() );

				expect( result.registrationStatements.len() ).toBe( 2 );

				var httpPos = -1;
				var mockPos = -1;
				for ( var i = 1; i <= result.registrationStatements.len(); i++ ) {
					if ( result.registrationStatements[ i ].findNoCase( '"http"' ) ) {
						httpPos = i;
					}
					if ( result.registrationStatements[ i ].findNoCase( '"mock"' ) ) {
						mockPos = i;
					}
				}
				// "httpChannel" < "mockChannel" alphabetically
				expect( httpPos ).toBeGT( 0 );
				expect( mockPos ).toBeGT( 0 );
				expect( httpPos < mockPos ).toBeTrue();
			} );

			it( "never registers agent/mcp exposure entries as channel adapters", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir() );

				for ( var statement in result.registrationStatements ) {
					expect( statement ).notToInclude( "toolServer" );
					expect( statement ).notToInclude( "/api/chat" );
				}
			} );

			it( "renders gateway options as correctly-typed BoxLang literals (strings stay quoted)", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir() );

				var httpStatement = result.registrationStatements.filter( s => s.findNoCase( '"http"' ) )[ 1 ];
				expect( httpStatement ).toInclude( '"secret" : getSystemSetting( "MY_WEBHOOK_SECRET", "" )' );
			} );

			it( "never embeds an http gateway's secretEnvVar NAME as a raw literal secret - only a live getSystemSetting() lookup", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var result = generator.generate( discovery, newAppDir() );

				var httpStatement = result.registrationStatements.filter( s => s.findNoCase( '"http"' ) )[ 1 ];
				expect( httpStatement ).notToInclude( "secretEnvVar" );
				expect( httpStatement ).toInclude( "getSystemSetting(" );
			} );

			it( "writes handlers/Gateway.bx and reports hasHttpGateway=true when an http-type channel exists", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir );

				expect( result.hasHttpGateway ).toBeTrue();
				expect( result.keyExists( "handlerPath" ) ).toBeTrue();
				expect( fileExists( result.handlerPath ) ).toBeTrue();

				var content = fileRead( result.handlerPath );
				expect( content ).toInclude( "function process( event, rc, prc )" );
				expect( content ).toInclude( "GatewayRequestProcessor::processHttp()" );
				expect( content ).toInclude( "noRender()" );
			} );

			it( "writes no handler and reports hasHttpGateway=false when there is no http-type channel", function() {
				var discovery = discoverer.discover( fixtures & "/full-project" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir );

				expect( result.hasHttpGateway ).toBeFalse();
				expect( result.keyExists( "handlerPath" ) ).toBeFalse();
				expect( fileExists( appDir & "/handlers/Gateway.bx" ) ).toBeFalse();
			} );

			it( "reports hasPushGateway=false and writes no session interceptor for http/cli/mock-only projects", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-mixed" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir );

				expect( result.hasPushGateway ).toBeFalse();
				expect( result.keyExists( "sessionInterceptorName" ) ).toBeFalse();
				expect( fileExists( appDir & "/interceptors/GatewaySessionBootstrap.bx" ) ).toBeFalse();
			} );

			it( "registers a telegram gateway via its bare class path, not the bare type name", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-telegram" );
				var result = generator.generate( discovery, newAppDir() );

				expect( result.registrationStatements.len() ).toBe( 1 );
				expect( result.registrationStatements[ 1 ] ).toInclude( '"bxModules.bxagents.models.gateways.TelegramGateway"' );
				expect( result.registrationStatements[ 1 ] ).notToInclude( '"telegram"' );
			} );

			it( "never embeds a telegram gateway's botTokenEnvVar NAME as a raw literal token - only a live getSystemSetting() lookup", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-telegram" );
				var result = generator.generate( discovery, newAppDir() );

				var statement = result.registrationStatements[ 1 ];
				expect( statement ).notToInclude( "botTokenEnvVar" );
				expect( statement ).toInclude( 'getSystemSetting( "MY_TELEGRAM_BOT_TOKEN", "" )' );
			} );

			it( "registers a slack gateway via its bare class path, resolving both botToken and appToken live", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-slack" );
				var result = generator.generate( discovery, newAppDir() );

				expect( result.registrationStatements.len() ).toBe( 1 );
				var statement = result.registrationStatements[ 1 ];
				expect( statement ).toInclude( '"bxModules.bxagents.models.gateways.SlackGateway"' );
				expect( statement ).notToInclude( "botTokenEnvVar" );
				expect( statement ).notToInclude( "appTokenEnvVar" );
				expect( statement ).toInclude( 'getSystemSetting( "MY_SLACK_BOT_TOKEN", "" )' );
				expect( statement ).toInclude( 'getSystemSetting( "MY_SLACK_APP_TOKEN", "" )' );
			} );

			it( "registers a discord gateway via its bare class path, not the bare type name", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-discord" );
				var result = generator.generate( discovery, newAppDir() );

				expect( result.registrationStatements.len() ).toBe( 1 );
				var statement = result.registrationStatements[ 1 ];
				expect( statement ).toInclude( '"bxModules.bxagents.models.gateways.DiscordGateway"' );
				expect( statement ).notToInclude( '"discord"' );
				expect( statement ).notToInclude( "botTokenEnvVar" );
				expect( statement ).toInclude( 'getSystemSetting( "MY_DISCORD_BOT_TOKEN", "" )' );
			} );

			it( "reports hasPushGateway=true and writes interceptors/GatewaySessionBootstrap.bx for a telegram gateway", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-telegram" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir, { name: "gateways-telegram-agent", model: "openai/gpt-5" } );

				expect( result.hasPushGateway ).toBeTrue();
				expect( result.sessionInterceptorName ).toBe( "GatewaySessionBootstrap" );

				var interceptorPath = appDir & "/interceptors/GatewaySessionBootstrap.bx";
				expect( fileExists( interceptorPath ) ).toBeTrue();

				var content = fileRead( interceptorPath );
				expect( content ).toInclude( "function afterConfigurationLoad( event, interceptData )" );
				expect( content ).toInclude( 'getController().getWireBox()' );
				expect( content ).toInclude( 'wirebox.getInstance( "GeneratedAgent" )' );
				expect( content ).toInclude( "aiGatewaySession(" );
				expect( content ).toInclude( 'aiGatewayRegistry().get( "telegramChannel" )' );
				expect( content ).toInclude( '"queue"' );
				expect( content ).toInclude( "gatewaySession.start()" );
				expect( content ).toInclude( "application.bxaiGatewaySession = gatewaySession" );
				// "session" is a reserved BoxLang/ColdBox scope - the generated
				// local variable must never be named exactly that.
				expect( content ).notToInclude( "var session " );
			} );

			it( "honors a resolvedConfig.gatewaySession policy/maxQueueDepth override", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-telegram" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir, { gatewaySession: { policy: "interrupt", maxQueueDepth: 10 } } );

				var content = fileRead( appDir & "/interceptors/GatewaySessionBootstrap.bx" );
				expect( content ).toInclude( '"interrupt"' );
				expect( content ).toInclude( "maxQueueDepth: 10" );
			} );

		} );
	}

}
