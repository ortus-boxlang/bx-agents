class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "WebUiGenerator", function() {

			beforeEach( function() {
				variables.discoverer = new bxagents.models.build.ProjectDiscoverer();
				variables.generator = new bxagents.models.build.generators.WebUiGenerator();
				variables.fixtures = expandPath( "/fixtures" );
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newAppDir() {
				var dir = createTempDirectory( prefix = "bxagents-webui-" );
				tempDirs.append( dir );
				return dir & "/app";
			}

			it( "reports hasWebUi=false and writes nothing when no webui exposure entry exists", function() {
				var discovery = discoverer.discover( fixtures & "/valid-minimal" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir );

				expect( result.hasWebUi ).toBeFalse();
				expect( result.webUiAuthInterceptorName ).toBe( "" );
				expect( directoryExists( appDir & "/chat" ) ).toBeFalse();
			} );

			it( "writes a templated index.html at <appDir><path>/index.html for a webui exposure entry", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir );

				expect( result.hasWebUi ).toBeTrue();

				var indexPath = appDir & "/chat/index.html";
				expect( fileExists( indexPath ) ).toBeTrue();

				var html = fileRead( indexPath );
				expect( html ).toInclude( "/__bxagents" );
				expect( html ).notToInclude( "__API_BASE__" );
				expect( html ).notToInclude( "__APP_TITLE__" );
			} );

			describe( "profiles", function() {

				private function webUiProject( string profiles ) {
					var dir = createTempDirectory( prefix = "bxagents-webui-profiles-" );
					tempDirs.append( dir );
					var nl = char( 10 );
					fileWrite( dir & "/Agent.yaml", "name: p" & nl & "model: mock/mock-model" & nl );
					fileWrite( dir & "/instructions.md", "Be helpful." );
					directoryCreate( dir & "/gateways" );
					fileWrite( dir & "/gateways/chat.bx", "class {" & nl & "	function configure() {" & nl & "		return { exposes : ""webui"", path : ""/chat""" & arguments.profiles & " };" & nl & "	}" & nl & "}" & nl );
					return dir;
				}

				it( "gives the page a profile picker; the offer itself is the agent API's (agentApi.profiles)", function() {
					var appDir = newAppDir();
					generator.generate( discoverer.discover( webUiProject( ', profiles : [ "fast" ]' ) ), appDir );
					var html = fileRead( appDir & "/chat/index.html" );

					expect( html ).toInclude( 'id="profileSelect"' );
					expect( html ).toInclude( "payload.options.profile = chosenProfile" );
				} );

				it( "writes no handler of its own: the page calls the agent API", function() {
					var appDir = newAppDir();
					generator.generate( discoverer.discover( webUiProject( "" ) ), appDir );

					expect( fileExists( appDir & "/handlers/ChatUi.bx" ) ).toBeFalse();
					expect( fileExists( appDir & "/interceptors/WebUiAuthGate.bx" ) ).toBeFalse();
				} );

			} );

			it( "parses the REAL bx-ai chunk envelope, not a {token} wrapper", function() {
				// ColdBox's toAi() /stream forwards each bx-ai chunk verbatim
				// (Router.cfc: `emitter.send( chunk, "chunk" )`), so the page must read
				// choices[].delta.*. Its published AI Routing docs show a {"token":"..."}
				// shape that its own source never produces - the v1 page believed the
				// docs and therefore rendered nothing at all against a live agent.
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "delta.content" );
				expect( html ).toInclude( "parsed.choices" );
				expect( html ).notToInclude( "parsed.token" );
			} );

			it( "renders reasoning and tool-call handling from the same envelope", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "delta.reasoning" );
				expect( html ).toInclude( "delta.tool_calls" );
				// Defaults are ON - both were already on the wire and being discarded
				expect( html ).toInclude( "var SHOW_REASONING = true;" );
				expect( html ).toInclude( "var SHOW_TOOLS = true;" );
			} );

			it( "renders branding: title, subtitle, icon, favicon, welcome, placeholder and footer", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-themed" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				// Title is HTML-escaped, not injected raw
				expect( html ).toInclude( "Acme &amp; Co &lt;Support&gt;" );
				expect( html ).notToInclude( "Acme & Co <Support>" );
				expect( html ).toInclude( "Orders and returns" );
				expect( html ).toInclude( 'class="subtitle"' );
				expect( html ).toInclude( 'rel="icon"' );
				expect( html ).toInclude( "data:image/svg+xml" );
				expect( html ).toInclude( "Ask away..." );
				expect( html ).toInclude( "Generated answers may be wrong." );
				expect( html ).notToInclude( "__PLACEHOLDER__" );
				expect( html ).notToInclude( "__FOOTER__" );
				expect( html ).notToInclude( "__FAVICON__" );
			} );

			it( "escapes the welcome text into a safe JavaScript string literal", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-themed" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				// A raw newline or quote would terminate the literal and break the page.
				// Backslash built via char( 92 ) so the assertion does not itself depend
				// on whether BoxLang treats "\" as an escape character.
				var slash = char( 92 );
				expect( html ).toInclude( "var WELCOME = " );
				expect( html ).toInclude( "Hi there!" & slash & "n" );
				expect( html ).toInclude( slash & '"anything' & slash & '"' );
				expect( html ).notToInclude( 'Ask "anything".' );
			} );

			it( "renders theme tokens, normalizing bare hex that BoxLang cannot express with a leading hash", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-themed" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				// "0f766e" in config -> a real CSS color
				expect( html ).toInclude( "--accent: ##0f766e;" );
				expect( html ).toInclude( "--radius: 10px;" );
				expect( html ).toInclude( "--font: Inter, system-ui, sans-serif;" );
				// Dark overrides land on the data-theme rule, not :root
				expect( html ).toInclude( '[data-theme="dark"]' );
				expect( html ).toInclude( "--accent: rgb(45, 212, 191);" );
				expect( html ).notToInclude( "__THEME_TOKENS__" );
			} );

			it( "honors showToolCalls:false while leaving reasoning on", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-themed" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "var SHOW_TOOLS = false;" );
				expect( html ).toInclude( "var SHOW_REASONING = true;" );
			} );

			it( "inlines resources/webui/theme.css last so the project override wins", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-themed" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "Project override - must be inlined last and win." );
				expect( html ).notToInclude( "__CUSTOM_CSS__" );

				// It has to come after the generated tokens, or "wins" is a lie
				expect( html.find( "Project override" ) ).toBeGT( html.find( "--accent: ##0f766e;" ) );
			} );

			it( "leaves the override placeholder empty when the project has no theme.css", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).notToInclude( "__CUSTOM_CSS__" );
				expect( html ).notToInclude( "__THEME_TOKENS__" );
			} );

			it( "sends a per-visitor conversationId so visitors don't share one memory bucket", function() {
				// Without options.conversationId, AiAgent.stream() falls back to "" for
				// BOTH userId and conversationId, and loadMemoryMessages( "", "" ) then
				// reads one bucket shared by every visitor to the page.
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "conversationId: getConversationId()" );
				expect( html ).toInclude( "bxagents_webui_conversation" );
				expect( html ).toInclude( "randomUUID" );
			} );

			it( "renders markdown with marked, sanitized, with the model's own HTML escaped and no images", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).notToInclude( "__MARKDOWN_SCRIPTS__" );
				// the libraries ship inside the page, so it works offline
				expect( html ).toInclude( "globalThis.marked" );
				expect( html ).toInclude( "DOMPurify" );
				expect( html ).toInclude( "hljs" );
				// raw HTML is escaped by the renderer, then the result is sanitized
				expect( html ).toInclude( "DOMPurify.sanitize( marked.parse(" );
				expect( html ).toInclude( "html: function ( token ) {" );
				expect( html ).toInclude( 'FORBID_TAGS: [ "img"' );
				expect( html ).toInclude( 'rel", "noopener noreferrer"' );
				expect( html ).notToInclude( "https://cdn" );
				expect( html ).notToInclude( "unpkg.com" );
			} );

			it( "colours BoxLang and CFML code from the same word lists as the terminal", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "registerBoxLangGrammars( hljs, {" );
				expect( html ).toInclude( '"boxlang.keywords":"' );
				expect( html ).toInclude( '"cfml.scopes":"' );
				expect( html ).toInclude( "cfscript" );
			} );

			it( "ships a real composer: textarea, stop control, and accessible transcript", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "<textarea" );
				expect( html ).notToInclude( '<input type="text"' );
				expect( html ).toInclude( "AbortController" );
				expect( html ).toInclude( 'id="stopBtn"' );
				expect( html ).toInclude( 'aria-live="polite"' );
				expect( html ).toInclude( 'class="visually-hidden" for="input"' );
				// Autoscroll must be conditional, or reading back mid-stream yanks you down
				expect( html ).toInclude( "isPinnedToBottom" );
			} );

			it( "sends a threadId with every turn and cancels that same run server-side", function() {
				// Aborting the fetch only stops the browser listening - the server
				// keeps running the turn and spending tokens. Real cancellation needs
				// the threadId to reach agent.cancelRun().
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "threadId      : activeThreadId" );
				expect( html ).toInclude( 'apiPost( "/cancel"' );
				// And it must still abort locally, or Stop would not stop the UI
				expect( html ).toInclude( "activeController.abort()" );
			} );

			it( "always generates the SQLite store, with no opt-in required", function() {
				// The agent's own IAiMemory has no enumeration API, so anything
				// that needs to ask "which conversations does this user have"
				// needs a real database. It is infrastructure, not a feature
				// flag - a webui project always gets one.
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir );

				expect( fileExists( appDir & "/models/ChatDb.bx" ) ).toBeTrue();
				// A bare onApplicationStart() statement, not an interceptor file -
				// an afterConfigurationLoad interceptor here never actually fires
				// on a real ColdBox boot (see BuildPipeline.bx's own comment).
				expect( result.webUiWarmStatement ).toInclude( 'getInstance( "ChatDb" )' );
				// Zero config still yields a usable store
				expect( result.webUiDatabase.datasource ).toBe( "bxagents" );
				expect( result.webUiDatabase.path ).toBe( "./data/chat.db" );
			} );

			it( "leaves the schema to the module's shared ChatStore, which is versioned and forward-only", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var src = fileRead( appDir & "/models/ChatDb.bx" );
				expect( src ).toInclude( 'new "models.store.ChatStore@bxagents"( static.DATASOURCE ).migrate()' );
				// the schema code moved out: nothing here builds tables any more
				expect( src ).notToInclude( "SchemaBuilder" );
				expect( src ).notToInclude( "applyV1" );
				expect( src ).notToInclude( "schemaOptions" );
				// queries still go through qb, naming the datasource on every builder
				expect( src ).toInclude( 'getInstance( "QueryBuilder@qb" )' );
				expect( src ).toInclude( "mergeDefaultOptions( { datasource : static.DATASOURCE } )" );
			} );

			it( "honours a configured datasource name and database path", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-themed" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir );

				expect( result.webUiDatabase.datasource ).toBe( "acmechat" );
				expect( result.webUiDatabase.path ).toBe( "./data/acme.db" );
				expect( fileRead( appDir & "/models/ChatDb.bx" ) ).toInclude( 'final DATASOURCE     = "acmechat"' );
			} );

			it( "hands out a fresh QueryBuilder per call", function() {
				// qb's builders accumulate their WHERE/ORDER clauses, so a shared
				// one leaks the previous query's conditions into the next.
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var src = fileRead( appDir & "/models/ChatDb.bx" );
				expect( src ).toInclude( "any function query() {" );
				expect( src ).toInclude( 'wirebox.getInstance( "QueryBuilder@qb" )' );
				// Every builder names its own datasource. Leaving this to
				// moduleSettings.qb.defaultOptions looked correct and was not:
				// in a real ColdBox boot the setting never reached QueryBuilder
				// and every query failed with "No default datasource defined".
				expect( src ).toInclude( "mergeDefaultOptions( { datasource : static.DATASOURCE } )" );
			} );

			it( "ships a conversation sidebar wired to the conversations API", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( 'id="sidebar"' );
				expect( html ).toInclude( 'id="convList"' );
				expect( html ).toInclude( "function loadConversations()" );
				expect( html ).toInclude( "function selectConversation(" );
				expect( html ).toInclude( "function startConversation( agent )" );
				expect( html ).toInclude( '"/sessions/rename"' );
				expect( html ).toInclude( '"/sessions/delete"' );
				// A title is whatever the user typed first, so it must never be
				// parsed as markup
				expect( html ).toInclude( "name.textContent = conv.title" );
			} );

			it( "shapes itself to GET /info instead of assuming every capability", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "function loadInfo()" );
				expect( html ).toInclude( "capabilities = payload.capabilities" );
				// Compact is hidden unless a summary model is actually configured,
				// or the button would do nothing at all
				expect( html ).toInclude( "compactBtn.hidden = !capabilities.compact" );
				expect( html ).toInclude( "modelMetaEl.textContent = payload.model" );
			} );

			it( "joins an SSE event's data: lines before parsing, because the native emitter pretty-prints each chunk over several of them", function() {
				// Measured against a live /chat/api/stream: each chunk arrives as
				//   event: chunk / data: { / data:   "choices" : [ { ... / data: }
				// Parsing line by line JSON.parse'd `{` on its own, dropped every
				// token, and left the live reply as "(no response)" until a reload.
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "dataLines.push(" );
				expect( html ).toInclude( 'dataLines.join( "\n" )' );
				// One JSON.parse per EVENT, never per line
				expect( html ).notToInclude( "var payload = line.slice( 5 ).trim()" );
			} );

			it( "keeps an SSE event that is split across network chunks buffered until its blank-line terminator arrives", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				// The old code handed the UNterminated tail to the parser and then
				// threw it away, losing the first half of a split event
				expect( html ).notToInclude( "var completeChunk = lastBreak >= 0 ? buffer.slice( 0, lastBreak ) : buffer" );
				expect( html ).toInclude( "if ( lastBreak < 0 )" );
				// CRLF framing is normalised, and a final unterminated event is flushed
				expect( html ).toInclude( '.replace( /\r\n?/g, "\n" )' );
				expect( html ).toInclude( "handleSseChunk( buffer, handlers )" );
			} );

			it( "starts with the sidebar closed on a phone, where it is a full-height overlay", function() {
				// Measured at 390x844: open-by-default hid the composer and the
				// Chats toggle behind the conversation list
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "function isNarrowScreen()" );
				expect( html ).toInclude( 'window.matchMedia( "(max-width: 40rem)" ).matches' );
				expect( html ).toInclude( "if ( isNarrowScreen() ) {" );
				// And the title block can shrink, so it truncates instead of running
				// underneath the header buttons
				expect( html ).toInclude( "header .brand > div { min-width: 0; }" );
			} );

			it( "turns Send into Steer while a turn is running, rather than disabling the composer", function() {
				// Steering mid-run is the point of /steer - a disabled composer
				// would make it unreachable
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "if ( isBusy && activeThreadId )" );
				expect( html ).toInclude( 'apiPost( "/steer"' );
				expect( html ).toInclude( 'sendBtn.setAttribute( "aria-label", busy ? "Steer" : "Send" )' );
				// isBusy must be a real variable - a disabled button could not be
				// clicked to steer
				expect( html ).notToInclude( "sendBtn.disabled = busy" );
			} );

			describe( "appearance", function() {

				it( "has a panel for mode, accent, text size and density, kept in the browser", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );
					var html = fileRead( appDir & "/chat/index.html" );

					expect( html ).toInclude( 'id="appearanceBtn"' );
					expect( html ).toInclude( 'id="appearancePanel"' );
					expect( html ).toInclude( "bxagents_webui_appearance" );
					expect( html ).toInclude( "function applyAppearance" );
					expect( html ).toInclude( "function contrastRatio" );
					// the operator's accent is only replaced while the visitor has picked one
					expect( html ).toInclude( 'removeProperty( "--accent" )' );
				} );

			} );

			describe( "icons", function() {

				it( "inlines the Phosphor sprite, and every icon the page names is in it", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );
					var html = fileRead( appDir & "/chat/index.html" );

					expect( html ).notToInclude( "__ICON_SPRITE__" );
					expect( html ).toInclude( "Phosphor Icons" );
					var defined = {};
					for ( var match in reMatch( 'id="i-([a-z0-9-]+)"', html ) ) {
						defined[ reReplace( match, '^id="i-|"$', "", "all" ) ] = true;
					}
					expect( defined.count() ).toBeGT( 20 );
					var used = {};
					for ( var match in reMatch( 'href="##i-([a-z0-9-]+)"', html ) ) {
						used[ reReplace( match, '^href="##i-|"$', "", "all" ) ] = true;
					}
					for ( var match in reMatch( 'icon\( "([a-z0-9-]+)" \)', html ) ) {
						used[ reReplace( match, '^icon\( "|" \)$', "", "all" ) ] = true;
					}
					expect( used.count() ).toBeGT( 10 );
					for ( var name in used ) {
						expect( defined.keyExists( name ) ).toBeTrue( "the page uses the icon [#name#] but the sprite has no such symbol" );
					}
				} );

				it( "labels every icon-only button, so it has a name for a screen reader", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );
					var html = fileRead( appDir & "/chat/index.html" );

					for ( var id in [ "sidebarBtn", "forkBtn", "exportBtn", "clearBtn", "compactBtn", "notesBtn", "keyBtn", "themeBtn", "attachBtn", "commandsBtn", "sendBtn", "stopBtn", "notesClose" ] ) {
						var tag = reMatch( '<button[^>]*id="#id#"[^>]*>', html );
						expect( tag ).toHaveLength( 1, id );
						expect( tag[ 1 ] ).toInclude( "aria-label=", "#id# has no aria-label" );
					}
				} );

				it( "offers up to four suggestions on the empty page, from the entry's suggestions", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var dir = newAppDir();
					generator.generate( discovery, dir );
					var page = fileRead( dir & "/chat/index.html" );
					expect( page ).toInclude( 'var SUGGESTIONS = JSON.parse( "[]" )' );
					expect( page ).toInclude( 'chips.className = "suggestions"' );
				} );

				it( "draws a code block with its language and a Copy button, and a tool card with a status", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var dir = newAppDir();
					generator.generate( discovery, dir );
					var page = fileRead( dir & "/chat/index.html" );
					expect( page ).toInclude( 'class="copy-code"' );
					expect( page ).toInclude( 'class="codehead"' );
					expect( page ).toInclude( 'status.className = "status running"' );
					expect( page ).toInclude( 'className = "ext-badge"' );
				} );

				it( "has a panel for access tokens that shows only when the server offers them, and shows a secret once", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );
					var html = fileRead( appDir & "/chat/index.html" );

					expect( html ).toInclude( 'id="tokensPanel"' );
					expect( reMatch( '<button[^>]*id="tokensBtn"[^>]*>', html )[ 1 ] ).toInclude( "aria-label=" );
					expect( html ).toInclude( "tokensBtn.hidden = !capabilities.tokens" );
					expect( html ).toInclude( 'apiPost( "/tokens/revoke"' );
					expect( html ).toInclude( "Copy this token now. It is not shown again." );
				} );

				it( "asks for a shared password in the page, not in a browser prompt, and opens by itself when refused", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );
					var html = fileRead( appDir & "/chat/index.html" );

					expect( html ).toInclude( 'id="keyPanel"' );
					expect( html ).toInclude( 'type="password"' );
					expect( html ).notToInclude( "Token (sent as" );
					expect( html ).toInclude( "askForPassword(" );
					// a page with accounts goes to the sign-in form instead
					expect( html ).toInclude( "window.location.href = LOGIN_URL" );
				} );

				it( "shows the context as a ring that fills, and opens the breakdown when it is clicked", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );
					var html = fileRead( appDir & "/chat/index.html" );

					expect( html ).toInclude( 'id="contextChip"' );
					expect( html ).toInclude( 'aria-haspopup="dialog"' );
					expect( html ).toInclude( 'id="contextPanel"' );
					expect( html ).toInclude( 'class="fill"' );
					expect( html ).toInclude( "function drawContextRing" );
					expect( html ).toInclude( "function drawContextPanel" );
					// the breakdown is drawn from the /context report, not by typing /context into the conversation
					expect( html ).notToInclude( 'runCommand( "/context" )' );
				} );

				it( "takes a phosphor:<name> icon from the page's own icon set, for the header and the tab, and ignores a name it does not have", function() {
					var discovery = discoverer.discover( fixtures & "/valid-minimal" );
					var dir = createTempDirectory( prefix = "bxagents-webui-icon-" );
					tempDirs.append( dir );
					directoryCopy( fixtures & "/gateways-webui", dir, true );
					var gateway = dir & "/gateways/chatUi.bx";
					var written = fileRead( gateway );
					fileWrite( gateway, written.replace( "path        : ""/chat"",", "path : ""/chat"", icon : ""phosphor:lightning"", suggestions : [ ""What can you do?"", ""Summarize my notes"" ]," ) );
					var appDir = newAppDir();
					generator.generate( discoverer.discover( dir ), appDir );
					var html = fileRead( appDir & "/chat/index.html" );

					expect( html ).toInclude( '<span class="icon"><svg class="i" aria-hidden="true"><use href="##i-lightning"/></svg></span>' );
					expect( html ).toInclude( 'rel="icon" href="data:image/svg+xml,' );
					expect( html ).toInclude( 'JSON.parse( "[\"What can you do?\",\"Summarize my notes\"]" )' );

					fileWrite( gateway, written.replace( "path        : ""/chat"",", "path : ""/chat"", icon : ""phosphor:nope""," ) );
					var other = newAppDir();
					generator.generate( discoverer.discover( dir ), other );
					expect( fileRead( other & "/chat/index.html" ) ).toInclude( "phosphor:nope" );
				} );

				it( "shows a robot as the brand mark when no icon is configured", function() {
					var discovery = discoverer.discover( fixtures & "/valid-minimal" );
					var dir = createTempDirectory( prefix = "bxagents-webui-icon-" );
					tempDirs.append( dir );
					directoryCopy( fixtures & "/gateways-webui", dir, true );
					var gateway = dir & "/gateways/chatUi.bx";
					var withoutIcon = fileRead( gateway ).reReplace( "icon\s*:\s*""[^""]*""\s*,?", "", "all" );
					fileWrite( gateway, withoutIcon );
					var appDir = newAppDir();
					generator.generate( discoverer.discover( dir ), appDir );

					expect( fileRead( appDir & "/chat/index.html" ) ).toInclude( '<span class="icon"><svg class="i" aria-hidden="true"><use href="##i-robot"/></svg></span>' );
				} );

			} );

			it( "exposes Clear and Compact, and reports what compaction actually did", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( 'id="clearBtn"' );
				expect( html ).toInclude( 'id="compactBtn"' );
				expect( html ).toInclude( 'apiPost( "/clear"' );
				expect( html ).toInclude( 'apiPost( "/compact"' );
				// A no-op compaction is not an error - say so rather than claiming success
				expect( html ).toInclude( "if ( !payload.compacted )" );
			} );

			it( "stores the theme server-side so it follows the identity, not the browser", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "function loadPreferences()" );
				expect( html ).toInclude( 'apiPost( "/preferences/set", { key: "theme"' );
				// localStorage stays as the immediate/offline copy
				expect( html ).toInclude( "localStorage.setItem( THEME_STORAGE, next )" );
			} );

			it( "lays out for narrow screens and honours reduced motion", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "@media ( max-width: 40rem )" );
				expect( html ).toInclude( "prefers-reduced-motion" );
			} );

			describe( "shell", function() {

				it( "wraps the page in a skip link, a labelled left menu and a main region that holds the chat and the page host", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );

					var html = fileRead( appDir & "/chat/index.html" );
					expect( html ).toInclude( 'class="skip-link" href="##content"' );
					expect( html ).toInclude( '<nav id="mainNav" aria-label="Main">' );
					expect( html ).toInclude( '<main id="content" tabindex="-1">' );
					expect( html ).toInclude( 'id="page-chat"' );
					expect( html ).toInclude( 'id="pageView" hidden' );
					// the hamburger drives the phone drawer
					expect( html ).toInclude( 'id="navBtn"' );
					expect( html ).toInclude( 'aria-controls="mainNav"' );
				} );

				it( "joins the shell styles and script in, leaving no placeholder behind", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );

					var html = fileRead( appDir & "/chat/index.html" );
					expect( html ).notToInclude( "__SHELL_STYLES__" );
					expect( html ).notToInclude( "__SHELL_SCRIPT__" );
					expect( html ).toInclude( "##mainNav a.nav-item[aria-current=""page""]" );
					expect( html ).toInclude( "function registerPage(" );
					expect( html ).toInclude( "function shellStart()" );
				} );

				it( "routes by hash, keeps the chat in the document, and sends a page the server does not offer to the chat", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );

					var html = fileRead( appDir & "/chat/index.html" );
					expect( html ).toInclude( "window.addEventListener( ""hashchange""" );
					expect( html ).toInclude( "history.replaceState( null, """", ""##/chat"" )" );
					// a member's menu is built from the capabilities, never from the address
					expect( html ).toInclude( "function pageAvailable( def )" );
					expect( html ).toInclude( "function buildNav()" );
				} );

				it( "folds the menu to icons, remembers it, and makes it a drawer on a phone", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );

					var html = fileRead( appDir & "/chat/index.html" );
					expect( html ).toInclude( "body[data-nav=""folded""]" );
					expect( html ).toInclude( "body[data-drawer=""open""]" );
					expect( html ).toInclude( "localStorage.setItem( NAV_STORAGE" );
					// Escape closes the drawer and Tab stays inside it
					expect( html ).toInclude( "function closeDrawer()" );
					expect( html ).toInclude( "evt.key === ""Tab""" );
				} );

				it( "shows the count of logged errors on the Logs item", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );

					var html = fileRead( appDir & "/chat/index.html" );
					expect( html ).toInclude( "function shellBadge( id, count )" );
					expect( html ).toInclude( "shellBadge( ""logs"", count )" );
				} );

			} );

			describe( "pages", function() {

				it( "registers a page per area, in the Main and Admin groups, each shown by a capability", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );

					var html = fileRead( appDir & "/chat/index.html" );
					for ( var id in [ "routines", "registry", "memory", "vault", "settings", "gateways", "logs", "access" ] ) {
						expect( html ).toInclude( "id: ""#id#""," );
					}
					expect( html ).toInclude( "group: ""admin""" );
					// an admin page is not offered to a member: it needs a capability the server only grants an admin
					expect( html ).toInclude( "cap: function ( caps ) { return !!caps.gateways; }" );
					expect( html ).toInclude( "cap: function ( caps ) { return !!caps.logs; }" );
				} );

				it( "says gateways, not chat apps, and keeps every item of the Settings menu", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );

					var html = fileRead( appDir & "/chat/index.html" );
					expect( html ).toInclude( "title: ""Gateways""" );
					expect( html ).toInclude( '<h2 id="gatewaysTitle">Gateways</h2>' );
					expect( html ).toInclude( 'aria-label="Gateways"' );
					expect( html ).notToInclude( "Chat apps" );
					// Notes, Vault, Routines, Access tokens, Logs and Gateways stay in the menu, next to their pages
					for ( var buttonId in [ "notesBtn", "vaultBtn", "routinesBtn", "tokensBtn", "logsBtn", "gatewaysBtn", "appearanceBtn", "themeBtn", "keyBtn" ] ) {
						expect( html ).toInclude( 'id="#buttonId#"' );
					}
					expect( html ).notToInclude( "legacy.hidden = true" );
				} );

				it( "keeps both routine dialogs and sends the agent's vault ask to the Vault page", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );

					var html = fileRead( appDir & "/chat/index.html" );
					expect( html ).toInclude( 'id="routineEditor"' );
					expect( html ).toInclude( 'id="routineReports"' );
					expect( html ).toInclude( "var routinesHook = null;" );
					expect( html ).toInclude( "shellGo( ""vault"" )" );
				} );

				it( "has a Conversations page that asks the server for a page at a time with its filters and facets", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );

					var html = fileRead( appDir & "/chat/index.html" );
					expect( html ).toInclude( "id: ""conversations""," );
					expect( html ).toInclude( """/sessions?limit="" + state.limit + ""&offset="" + state.offset + ""&facets=1""" );
					for ( var param in [ "&q=", "&source=", "&agent=", "&since=", "&before=", "&all=1" ] ) {
						expect( html ).toInclude( param );
					}
					// every row can be opened, renamed, forked, exported and deleted, and several deleted at once
					expect( html ).toInclude( "/sessions/fork" );
					expect( html ).toInclude( "Delete selected" );
				} );

				it( "shows 25 conversations in the sidebar, with Show more and a quick filter, and trusts a remembered one further down", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );

					var html = fileRead( appDir & "/chat/index.html" );
					expect( html ).toInclude( "var CONV_PAGE = 25;" );
					expect( html ).toInclude( 'id="convFilter"' );
					expect( html ).toInclude( 'id="convMoreBtn"' );
					expect( html ).notToInclude( "/sessions?limit=100" );
					expect( html ).toInclude( "conversationsTotal > conversations.length" );
				} );

				it( "draws the Appearance controls in the Settings page as well as in the popup", function() {
					var discovery = discoverer.discover( fixtures & "/gateways-webui" );
					var appDir = newAppDir();
					generator.generate( discovery, appDir );

					var html = fileRead( appDir & "/chat/index.html" );
					expect( html ).toInclude( "function drawAppearanceInto( el, inPage )" );
					expect( html ).toInclude( ".appearance-ui.in-page" );
				} );

			} );

			it( "recovers when the remembered conversation no longer exists", function() {
				// Deleted from another tab, or a fresh store - rehydrating to
				// nothing would leave the sidebar with no active row
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "if ( !known && conversations.length )" );
			} );

			it( "has a notes panel that only appears when the agent keeps notes", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( 'id="notesBtn"' );
				expect( html ).toInclude( 'id="notesPanel"' );
				expect( html ).toInclude( "notesBtn.hidden = !capabilities.notes" );
				expect( html ).toInclude( 'apiGet( "/notes" )' );
				expect( html ).toInclude( 'apiPost( "/notes"' );
				expect( html ).toInclude( 'apiPost( "/notes/update"' );
				expect( html ).toInclude( 'apiPost( "/notes/remove"' );
				// the agent's notes get no Remove button
				expect( html ).toInclude( 'if ( notesScope === "user" )' );
				// text from a note goes in with textContent, never as markup
				expect( html ).toInclude( "text.textContent = note.text" );
			} );

			it( "no longer claims the approval UI is missing", function() {
				// The page shipped an approval card two revisions ago; the fallback
				// notice still said v1 had none.
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).notToInclude( "no approval UI yet" );
			} );

			it( "rehydrates the transcript from /history on load", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var html = fileRead( appDir & "/chat/index.html" );
				expect( html ).toInclude( "function rehydrate()" );
				expect( html ).toInclude( '"/history?conversationId="' );
				// Boot order matters: capabilities decide which controls exist at
				// all, so /info comes first, then preferences, then the list, then
				// the transcript
				expect( html ).toInclude( "loadInfo()" );
				expect( html ).toInclude( ".then( loadPreferences )" );
				expect( html ).toInclude( ".then( loadConversations )" );
			} );

			/**
			 * The generator builds BoxLang source out of BoxLang string
			 * literals, where a literal double quote is written "" - so an
			 * empty-string literal needs FOUR quotes ( """" ), and writing the
			 * natural-looking two emits a single stray quote that opens a
			 * string and swallows the rest of the line.
			 *
			 * That shipped. `?: ""` in the ChatDb template emitted `?: "`, and
			 * every generated project's ChatDb.bx failed to compile. No spec
			 * here caught it because they all assert on substrings of the
			 * output; only a real ColdBox boot in CI ever tried to compile it.
			 *
			 * A line of generated code with an odd number of double quotes is
			 * always this bug (nothing here emits a string spanning lines), so
			 * assert the invariant over the whole file rather than pinning the
			 * two lines that happened to be wrong.
			 */
			/**
			 * Every other action derives the caller from the session, but /pending
			 * and /resume were addressed purely by threadId - so a visitor holding
			 * another visitor's threadId could read their pending tool calls and
			 * their arguments, and approve or reject on their behalf. Deriving
			 * decidedBy server-side stopped a caller lying about WHO decided; it
			 * did not stop them deciding on a run that was not theirs.
			 *
			 * Ownership needs no new storage: resolveOptions() stamps the
			 * session-derived userId into the run options, and the agent
			 * checkpoints those options alongside the suspension.
			 */
			it( "generates sign-in wiring only when a webui entry declares users", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-users" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir );

				expect( result.webUiHasUsers ).toBeTrue();
				// A startup statement, NOT an interceptor. As an interceptor it
				// silently never ran, and ChatDb migrating in its own init made
				// the users table appear anyway - which looked like success.
				expect( result.webUiSeedStatement ).toInclude( 'getInstance( "UserSeeder" ).seed()' );
				// Never fatal: seeding runs on the boot path, and a failure there
				// must degrade to "cannot sign in", not "the app is down"
				expect( result.webUiSeedStatement ).toInclude( "catch ( any e )" );
				expect( result.webUiLoginGateName ).toBe( "WebUiLoginGate" );

				for ( var generated in [
					"/models/PasswordHasher.bx", "/models/UserService.bx", "/models/User.bx",
					"/models/UserSeeder.bx", "/handlers/ChatAuth.bx",
					"/interceptors/WebUiLoginGate.bx", "/chat/login.html"
				] ) {
					expect( fileExists( appDir & generated ) ).toBeTrue( "expected #generated# to be generated" );
				}
			} );

			/**
			 * Only found once the login gate was actually registered for real
			 * (see ColdBoxAppGenerator/BuildPipeline): runColdBoxIntegrationTests.bxs
			 * probes GET <path>/api/health UNAUTHENTICATED to prove the app is up
			 * at all - a latent bug invisible while the gate never fired at all.
			 */
			it( "leaves the agent API out of the login gate: it answers its own callers", function() {
				var appDir = newAppDir();
				generator.generate( discoverer.discover( fixtures & "/gateways-webui-users" ), appDir );
				var gate = fileRead( appDir & "/interceptors/WebUiLoginGate.bx" );

				expect( gate ).toInclude( 'path.startsWith( "/__bxagents" )' );
				expect( gate ).notToInclude( "Not signed in" );
			} );

			it( "sends a visitor without a sign-in to the form, and only when there are accounts", function() {
				var withUsers = newAppDir();
				generator.generate( discoverer.discover( fixtures & "/gateways-webui-users" ), withUsers );
				var without = newAppDir();
				generator.generate( discoverer.discover( fixtures & "/gateways-webui" ), without );

				expect( fileRead( withUsers & "/chat/index.html" ) ).toInclude( 'var LOGIN_URL = "/chat/login.html";' );
				expect( fileRead( without & "/chat/index.html" ) ).toInclude( 'var LOGIN_URL = "";' );
			} );

			it( "gives the sign-in page the same theme tokens and mark as the chat page", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-users" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var login = fileRead( appDir & "/chat/login.html" );
				expect( login ).notToInclude( "__THEME_TOKENS__" );
				expect( login ).toInclude( "--accent-soft" );
				expect( login ).toInclude( 'class="mark"' );
			} );

			it( "never writes a password into generated source, only env var names and hashes", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-users" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var seeder = fileRead( appDir & "/models/UserSeeder.bx" );
				// The env-var user: the NAME is embedded, the value is read at runtime
				expect( seeder ).toInclude( "ACME_ADA_PASSWORD" );
				expect( seeder ).toInclude( 'getSystemSetting( "ACME_ADA_PASSWORD"' );
				// The pre-hashed user needs no environment at all
				expect( seeder ).toInclude( "pbkdf2$210000$" );
				// Missing env var must fail CLOSED - never seed an empty password
				expect( seeder ).toInclude( "if ( !len( plaintext ) ) {" );
				// Removing a user from config revokes access on the next boot
				expect( seeder ).toInclude( "deactivateUsersNotIn( configured )" );
			} );

			it( "seeds the admin flag from config only for a new account or when nobody is an admin yet", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-users" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var seeder = fileRead( appDir & "/models/UserSeeder.bx" );
				// ada is declared admin, grace is not
				expect( seeder ).toInclude( "admin        : true" );
				expect( seeder ).toInclude( "admin        : false" );
				expect( seeder ).toInclude( 'db.bootstrapAdmin( "ada" )' );
				expect( seeder ).notToInclude( 'db.bootstrapAdmin( "grace" )' );

				// the store only uses the flag on insert, and hands it to the signed-in user
				var store = fileRead( appDir & "/models/ChatDb.bx" );
				expect( store ).toInclude( '"isAdmin"      : arguments.admin ? 1 : 0' );
				expect( store ).toInclude( "boolean function hasActiveAdmin()" );
				expect( fileRead( appDir & "/models/User.bx" ) ).toInclude( "boolean function isAdmin()" );
				expect( fileRead( appDir & "/models/UserService.bx" ) ).toInclude( "admin       : ( arguments.record.isAdmin ?: 0 ) == 1" );
			} );

			it( "hashes with a per-user salt and compares in constant time", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-users" );
				var appDir = newAppDir();
				generator.generate( discovery, appDir );

				var hasher = fileRead( appDir & "/models/PasswordHasher.bx" );
				expect( hasher ).toInclude( "PBKDF2WithHmacSHA256" );
				// A fresh salt per hash, so equal passwords never collide
				expect( hasher ).toInclude( 'generateSecretKey( "AES", 128 )' );
				// Iterations travel with the hash so they can be raised later
				expect( hasher ).toInclude( 'static.PREFIX & "$" & static.ITERATIONS' );
				// Timing-safe compare, same discipline as the API-key gate
				expect( hasher ).toInclude( "MessageDigest" );
			} );

			it( "points identifierProvider at the signed-in account so every scope re-keys", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui-users" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir );

				// The generator reports it; ColdBoxAppGenerator emits it. Without
				// this the accounts would exist but nothing would be scoped BY them.
				expect( result.webUiHasUsers ).toBeTrue();
			} );

			/**
			 * An open web UI is ONE shared workspace. Every visitor reads and
			 * writes the same conversations, preferences and agent memory - that
			 * is the point of running without accounts, not an oversight, and it
			 * is why there is no per-visitor identity to get wrong.
			 */
			it( "leaves a project without users completely ungated", function() {
				var discovery = discoverer.discover( fixtures & "/gateways-webui" );
				var appDir = newAppDir();
				var result = generator.generate( discovery, appDir );

				expect( result.webUiHasUsers ).toBeFalse();
				expect( result.webUiSeedStatement ).toBe( "" );
				expect( result.webUiLoginGateName ).toBe( "" );
				expect( fileExists( appDir & "/interceptors/WebUiLoginGate.bx" ) ).toBeFalse();
				expect( fileExists( appDir & "/handlers/ChatAuth.bx" ) ).toBeFalse();
				// No sign-in form for a project that gates nothing
				expect( fileExists( appDir & "/chat/login.html" ) ).toBeFalse();
			} );

		} );
	}

}
