class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "ProjectValidator", function() {

			beforeEach( function() {
				variables.discoverer = new bxagents.models.build.ProjectDiscoverer();
				variables.resolver = new bxagents.models.build.AgentConfigResolver();
				variables.validator = new bxagents.models.build.ProjectValidator();
				variables.fixtures = expandPath( "/fixtures/validation" );
			} );

			private function validateFixture( required string name ) {
				var projectRoot = fixtures & "/" & arguments.name;
				var discovery = discoverer.discover( projectRoot );
				var config = resolver.resolve( projectRoot = projectRoot );
				return validator.validate( projectRoot, discovery, config );
			}

			private function newProject( required string fixture ) {
				var dir = createTempDirectory( prefix = "bxagents-validate-" );
				directoryCopy( expandPath( "/fixtures/" & arguments.fixture ), dir, true );
				return dir;
			}

			private function validateRoot( required string projectRoot ) {
				var discovery = discoverer.discover( arguments.projectRoot );
				var config = resolver.resolve( projectRoot = arguments.projectRoot );
				return validator.validate( arguments.projectRoot, discovery, config );
			}

			it( "rejects a gateway exposure claiming a path under the reserved /__bxagents prefix", function() {
				// The always-on agent route is registered there unconditionally,
				// so an exposure on the same mount would look declared and never
				// actually answer.
				var result = validateFixture( "reserved-gateway-path" );
				var reserved = result.errors.filter( e => e.findNoCase( "__bxagents" ) );
				expect( reserved.len() ).toBeGT( 0 );
				expect( reserved[ 1 ] ).toInclude( "where the agent API is served" );
			} );

			it( "rejects a malformed agentApi block - unknown key, non-boolean enabled, and a tokenEnvVar that is a secret rather than a variable name", function() {
				var result = validateFixture( "bad-agent-api" );

				expect( result.errors.filter( e => e.findNoCase( "unknown key" ) && e.findNoCase( "bogusKey" ) ).len() ).toBeGT( 0 );
				expect( result.errors.filter( e => e.findNoCase( "agentApi.enabled" ) ).len() ).toBeGT( 0 );

				// The important one: a literal secret here would otherwise "work"
				// while quietly getting committed.
				expect( result.errors.filter( e => e.findNoCase( "agentApi.tokenEnvVar" ) ).len() ).toBeGT( 0 );
			} );

			it( "accepts a well-formed agentApi block", function() {
				var result = validateFixture( "good-agent-api" );
				expect( result.errors.filter( e => e.findNoCase( "agentApi" ) ).len() ).toBe( 0 );
			} );

			describe( "offered profiles", function() {

				beforeEach( function() {
					variables.profileDirs = [];
				} );

				afterEach( function() {
					for ( var dir in profileDirs ) {
						if ( directoryExists( dir ) ) {
							directoryDelete( dir, true );
						}
					}
				} );

				private function profiledProject( string yamlExtra = "", struct gateways = {} ) {
					var dir = createTempDirectory( prefix = "bxagents-validate-" );
					profileDirs.append( dir );
					var nl = char( 10 );
					fileWrite( dir & "/Agent.yaml", "name: offered" & nl & "model: mock/mock-model" & nl & "profiles:" & nl & "  fast:" & nl & "    provider: mock" & nl & "  slow:" & nl & "    provider: mock" & nl & yamlExtra );
					fileWrite( dir & "/instructions.md", "Be helpful." );
					directoryCreate( dir & "/gateways" );
					for ( var name in gateways ) {
						fileWrite( dir & "/gateways/#name#.bx", "class {" & nl & "	function configure() {" & nl & "		return " & gateways[ name ] & ";" & nl & "	}" & nl & "}" & nl );
					}
					var discovery = discoverer.discover( dir );
					return validator.validate( dir, discovery, resolver.resolve( projectRoot = dir ) );
				}

				it( "accepts usage: true or false, and refuses anything else", function() {
					expect( profiledProject( "usage: true" & char( 10 ) ).errors ).toBeEmpty();
					expect( profiledProject( "usage: false" & char( 10 ) ).errors ).toBeEmpty();
					expect( profiledProject( "usage: often" & char( 10 ) ).errors.filter( e => e.findNoCase( "'usage' must be true or false" ) ) ).toHaveLength( 1 );
				} );

				it( "accepts a tui block, and says which names are valid when a style, widget or place is wrong", function() {
					var nl = char( 10 );
					expect( profiledProject( "tui:" & nl & "  prompt: box" & nl & "  widgets:" & nl & "    top: [ agent, git ]" & nl & "    bottom: []" & nl ).errors ).toBeEmpty();

					var style = profiledProject( "tui:" & nl & "  prompt: fancy" & nl ).errors.filter( e => e.findNoCase( "tui.prompt 'fancy' is not a prompt style" ) );
					expect( style ).toHaveLength( 1 );
					expect( style[ 1 ] ).toInclude( "bars, bars-hints, rule, box, panel" );

					var widget = profiledProject( "tui:" & nl & "  widgets:" & nl & "    top: [ agent, weather ]" & nl ).errors.filter( e => e.findNoCase( "no widget 'weather'" ) );
					expect( widget ).toHaveLength( 1 );
					expect( widget[ 1 ] ).toInclude( "folder" );

					expect( profiledProject( "tui:" & nl & "  widgets:" & nl & "    middle: [ agent ]" & nl ).errors.filter( e => e.findNoCase( "no place 'middle'" ) ) ).toHaveLength( 1 );
					expect( profiledProject( "tui:" & nl & "  widgets:" & nl & "    top: agent" & nl ).errors.filter( e => e.findNoCase( "must be a list of widget names" ) ) ).toHaveLength( 1 );
					expect( profiledProject( "tui:" & nl & "  colour: red" & nl ).errors.filter( e => e.findNoCase( "no setting 'colour'" ) ) ).toHaveLength( 1 );
				} );

				it( "warns when a model is written next to a default profile, since the profile is the default model", function() {
					var both = profiledProject( "defaultProfile: fast" & char( 10 ) );
					var modelOnly = profiledProject();

					expect( both.errors ).toBeEmpty();
					expect( both.warnings.filter( w => w.findNoCase( "model line is ignored" ) ) ).toHaveLength( 1 );
					expect( modelOnly.warnings.filter( w => w.findNoCase( "model line is ignored" ) ) ).toBeEmpty();
				} );

				it( "accepts a web UI that offers declared profiles, and 'default'", function() {
					var result = profiledProject( "", { chat : '{ exposes : "webui", path : "/chat", profiles : [ "fast", "default" ] }' } );

					expect( result.errors ).toBeEmpty();
				} );

				it( "refuses a profile the project does not declare, a repeat, and a list that is not a list", function() {
					var unknown = profiledProject( "", { chat : '{ exposes : "webui", path : "/chat", profiles : [ "nope" ] }' } );
					var repeated = profiledProject( "", { chat : '{ exposes : "webui", path : "/chat", profiles : [ "fast", "fast" ] }' } );
					var notList = profiledProject( "", { chat : '{ exposes : "webui", path : "/chat", profiles : "fast" }' } );

					expect( unknown.errors.filter( e => e.findNoCase( "offers profile [nope]" ) ) ).toHaveLength( 1 );
					expect( repeated.errors.filter( e => e.findNoCase( "more than once" ) ) ).toHaveLength( 1 );
					expect( notList.errors.filter( e => e.findNoCase( "must be a list" ) ) ).toHaveLength( 1 );
				} );

				it( "refuses a list on an agent route, which passes the caller's own options", function() {
					var result = profiledProject( "", { api : '{ exposes : "agent", path : "/api", profiles : [ "fast" ] }' } );

					expect( result.errors.filter( e => e.findNoCase( "only a 'webui' entry can offer" ) ) ).toHaveLength( 1 );
				} );

				it( "refuses web UI entries that offer different lists, since they share one handler", function() {
					var result = profiledProject( "", {
						one : '{ exposes : "webui", path : "/one", profiles : [ "fast" ] }',
						two : '{ exposes : "webui", path : "/two", profiles : [ "slow" ] }'
					} );

					expect( result.errors.filter( e => e.findNoCase( "offer different 'profiles'" ) ) ).toHaveLength( 1 );
				} );

				it( "refuses a web UI entry while the agent API is off: the page is a client of it", function() {
					var nl = char( 10 );
					var off = profiledProject( "agentApi:" & nl & "  enabled: false" & nl, { chat : '{ exposes : "webui", path : "/chat" }' } );
					var offNoPage = profiledProject( "agentApi:" & nl & "  enabled: false" & nl );

					expect( off.errors.filter( e => e.findNoCase( "cannot run without it" ) ) ).toHaveLength( 1 );
					expect( offNoPage.errors ).toBeEmpty();
				} );

				it( "checks agentApi.path, and keeps a gateway entry off it", function() {
					var nl = char( 10 );
					var ok = profiledProject( "agentApi:" & nl & "  path: /agent-api" & nl );
					var bad = profiledProject( "agentApi:" & nl & "  path: agent-api" & nl );
					var taken = profiledProject( "agentApi:" & nl & "  path: /agent-api" & nl, { chat : '{ exposes : "webui", path : "/agent-api/chat" }' } );
					var freed = profiledProject( "agentApi:" & nl & "  path: /agent-api" & nl, { chat : '{ exposes : "webui", path : "/__bxagents/chat" }' } );

					expect( ok.errors ).toBeEmpty();
					expect( bad.errors.filter( e => e.findNoCase( "agentApi.path" ) ) ).toHaveLength( 1 );
					expect( taken.errors.filter( e => e.findNoCase( "where the agent API is served" ) ) ).toHaveLength( 1 );
					// the default path is only reserved while it is the API's
					expect( freed.errors ).toBeEmpty();
				} );

				it( "checks agentApi.allowedIPs and agentApi.rateLimit", function() {
					var nl = char( 10 );
					var ok = profiledProject( "agentApi:" & nl & "  allowedIPs: [ 10.0.0.0/8, 203.0.113.7 ]" & nl & "  rateLimit:" & nl & "    requests: 60" & nl & "    perSeconds: 60" & nl );
					var badIp = profiledProject( "agentApi:" & nl & "  allowedIPs: [ example.com ]" & nl );
					var badLimit = profiledProject( "agentApi:" & nl & "  rateLimit:" & nl & "    requests: 0" & nl & "    perSeconds: 60" & nl );
					var byCaller = profiledProject( "agentApi:" & nl & "  rateLimit:" & nl & "    requests: 5" & nl & "    perSeconds: 60" & nl & "    by: caller" & nl );

					expect( ok.errors ).toBeEmpty();
					expect( badIp.errors.filter( e => e.findNoCase( "allowedIPs" ) ) ).toHaveLength( 1 );
					expect( badLimit.errors.filter( e => e.findNoCase( "rateLimit.requests" ) ) ).toHaveLength( 1 );
					expect( byCaller.errors.filter( e => e.findNoCase( "unknown key [by]" ) ) ).toHaveLength( 1 );
				} );

				it( "lets agentApi.manageTokens on only with issued tokens and a token access", function() {
					var nl = char( 10 );
					var ok = profiledProject( "agentApi:" & nl & "  tokens: true" & nl & "  manageTokens: true" & nl );
					var noTokens = profiledProject( "agentApi:" & nl & "  tokenEnvVar: MY_TOKEN" & nl & "  manageTokens: true" & nl );
					var open = profiledProject( "agentApi:" & nl & "  access: open" & nl & "  manageTokens: true" & nl );
					var off = profiledProject( "agentApi:" & nl & "  manageTokens: false" & nl );
					var notBoolean = profiledProject( "agentApi:" & nl & "  manageTokens: maybe" & nl );

					expect( ok.errors ).toBeEmpty();
					expect( off.errors ).toBeEmpty();
					expect( noTokens.errors.filter( e => e.findNoCase( "manageTokens" ) ) ).toHaveLength( 1 );
					expect( open.errors.filter( e => e.findNoCase( "manageTokens" ) ) ).toHaveLength( 1 );
					expect( notBoolean.errors.filter( e => e.findNoCase( "manageTokens" ) ) ).toHaveLength( 1 );
				} );

				it( "reports an agentApi.path that is not text, instead of failing on it", function() {
					var nl = char( 10 );
					var result = profiledProject( "agentApi:" & nl & "  path: [ /a ]" & nl );

					expect( result.errors.filter( e => e.findNoCase( "agentApi.path" ) ) ).toHaveLength( 1 );
				} );

				it( "checks agentApi.access against what is set for tokens", function() {
					var nl = char( 10 );
					var ok = profiledProject( "agentApi:" & nl & "  access: token" & nl & "  tokens: true" & nl );
					var openOk = profiledProject( "agentApi:" & nl & "  access: open" & nl );
					var contradicts = profiledProject( "agentApi:" & nl & "  access: open" & nl & "  tokens: true" & nl );
					var nothing = profiledProject( "agentApi:" & nl & "  access: token" & nl );
					var unknown = profiledProject( "agentApi:" & nl & "  access: closed" & nl );

					expect( ok.errors ).toBeEmpty();
					expect( openOk.errors ).toBeEmpty();
					expect( contradicts.errors.filter( e => e.findNoCase( "Remove one or the other" ) ) ).toHaveLength( 1 );
					expect( nothing.errors.filter( e => e.findNoCase( "which token" ) ) ).toHaveLength( 1 );
					expect( unknown.errors.filter( e => e.findNoCase( "open or token" ) ) ).toHaveLength( 1 );
				} );

				it( "validates agentApi.profiles the same way", function() {
					var good = profiledProject( "agentApi:" & char( 10 ) & "  profiles: [ fast, slow ]" & char( 10 ) );
					var bad = profiledProject( "agentApi:" & char( 10 ) & "  profiles: [ nope ]" & char( 10 ) );

					expect( good.errors ).toBeEmpty();
					expect( bad.errors.filter( e => e.findNoCase( "offers profile [nope]" ) ) ).toHaveLength( 1 );
				} );

			} );

			it( "rejects duplicate tool names", function() {
				var result = validateFixture( "duplicate-tool-names" );
				expect( result.errors.filter( e => e.findNoCase( "Duplicate name" ) && e.findNoCase( "tools/" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects a bare tool name and a tool listed twice", function() {
				var bare = validateFixture( "tools-bare-name" );
				expect( bare.errors.filter( e => e.findNoCase( "bare tool name" ) ).len() ).toBeGT( 0 );

				var twice = validateFixture( "tools-duplicate" );
				expect( twice.errors.filter( e => e.findNoCase( "more than once" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects toolOptions for a module the agent lists no tool from", function() {
				var result = validateFixture( "tool-options-unlisted-module" );
				expect( result.errors.filter( e => e.findNoCase( "bxplaywright" ) && e.findNoCase( "lists no tool" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects toolOptions for a module that takes no options", function() {
				var result = validateFixture( "tool-options-no-adapter" );
				expect( result.errors.filter( e => e.findNoCase( "[bxdemo]" ) && e.findNoCase( "takes no options" ) ).len() ).toBeGT( 0 );
			} );

			it( "accepts bxai allowedPaths for the file tools", function() {
				var result = validateFixture( "tool-options-bxai-good" );
				expect( result.errors.filter( e => e.findNoCase( "toolOptions" ) ) ).toBeEmpty();
			} );

			it( "rejects an empty bxai allowedPaths list, since it would open the whole disk", function() {
				var result = validateFixture( "tool-options-bxai-bad" );
				expect( result.errors.filter( e => e.findNoCase( "[bxai]" ) && e.findNoCase( "whole disk" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects an unknown bxplaywright option and names the valid ones", function() {
				var result = validateFixture( "tool-options-bad-option" );
				var hits = result.errors.filter( e => e.findNoCase( "unknown option [headles]" ) );
				expect( hits ).toHaveLength( 1 );
				expect( hits[ 1 ] ).toInclude( "Valid options:" );
			} );

			it( "rejects toolOptions keyed by item@module or given a non-mapping", function() {
				expect( validateFixture( "tool-options-item-key" ).errors.filter( e => e.findNoCase( "not item@module" ) ).len() ).toBeGT( 0 );
				expect( validateFixture( "tool-options-not-a-mapping" ).errors.filter( e => e.findNoCase( "must be a mapping" ) ).len() ).toBeGT( 0 );
			} );

			it( "accepts well-formed toolOptions", function() {
				var result = validateFixture( "tool-options-good" );
				expect( result.errors.filter( e => e.findNoCase( "toolOptions" ) ).len() ).toBe( 0 );
			} );

			it( "rejects duplicate skill names", function() {
				var result = validateFixture( "duplicate-skill-names" );
				expect( result.errors.filter( e => e.findNoCase( "Duplicate name" ) && e.findNoCase( "skills/" ) ).len() ).toBeGT( 0 );
			} );

			it( "detects a 2-node circular subagent reference and reports the full cycle path", function() {
				var result = validateFixture( "subagent-cycle-2" );
				var cycleErrors = result.errors.filter( e => e.findNoCase( "Circular subagent" ) );
				expect( cycleErrors.len() ).toBeGT( 0 );
				expect( cycleErrors[ 1 ] ).toInclude( "a" );
				expect( cycleErrors[ 1 ] ).toInclude( "b" );
			} );

			it( "detects a 3+ node circular subagent reference", function() {
				var result = validateFixture( "subagent-cycle-3" );
				var cycleErrors = result.errors.filter( e => e.findNoCase( "Circular subagent" ) );
				expect( cycleErrors.len() ).toBeGT( 0 );
			} );

			it( "does not false-positive on a non-cyclic diamond subagent DAG", function() {
				var result = validateFixture( "subagent-diamond-ok" );
				var cycleErrors = result.errors.filter( e => e.findNoCase( "Circular subagent" ) );
				expect( cycleErrors.len() ).toBe( 0 );
			} );

			it( "rejects the ROOT project's own subAgents referencing an unknown subagent (not just nested ones)", function() {
				// A real bug this closed: the unknown-reference check explicitly
				// excluded the root project's own subAgents list, so a typo'd
				// root-level reference passed validation cleanly and only
				// surfaced later, mid-generation, after .build/app had already
				// been partially (re)written.
				var result = validateFixture( "root-subagent-missing-ref" );
				var refErrors = result.errors.filter( e => e.findNoCase( "references unknown subagent" ) );
				expect( refErrors.len() ).toBeGT( 0 );
				expect( refErrors[ 1 ] ).toInclude( "nonexistent-subagent" );
			} );

			/**
			 * Every schedules/*.bx is a BoxLang scheduler class; the file name becomes the class name. What
			 * the validator catches is what would otherwise only fail when the app starts.
			 */
			it( "warns (doesn't error) when schedules/ holds a file that is not a .bx file", function() {
				var result = validateFixture( "schedules-not-bx-file" );
				expect( result.warnings.filter( w => w.findNoCase( "not .bx files" ) ).len() ).toBeGT( 0 );
				expect( result.errors.len() ).toBe( 0 );
			} );

			it( "errors on a scheduler whose file name cannot be a class name", function() {
				var root = newProject( "valid-minimal" );
				directoryCreate( root & "/schedules" );
				fileWrite( root & "/schedules/my-job.bx", "class {" & char( 10 ) & "}" & char( 10 ) );

				var result = validateRoot( root );
				expect( result.errors.filter( e => e.findNoCase( "schedules/my-job.bx" ) ).len() ).toBe( 1 );
			} );

			it( "errors on a file name with an extra dot, which would make the same class as another file", function() {
				var root = newProject( "valid-minimal" );
				directoryCreate( root & "/schedules" );
				fileWrite( root & "/schedules/Nightly.bx", "class {" & char( 10 ) & "}" & char( 10 ) );
				fileWrite( root & "/schedules/Nightly.backup.bx", "class {" & char( 10 ) & "}" & char( 10 ) );

				var result = validateRoot( root );
				var hits = result.errors.filter( e => e.findNoCase( "Nightly.backup.bx" ) );
				expect( hits ).toHaveLength( 1 );
				expect( hits[ 1 ] ).toInclude( "no dots or dashes" );
			} );

			it( "errors on two files that make the same class when only the case differs", function() {
				var root = newProject( "valid-minimal" );
				directoryCreate( root & "/schedules" );
				fileWrite( root & "/schedules/Nightly.bx", "class {" & char( 10 ) & "}" & char( 10 ) );
				fileWrite( root & "/schedules/nightly.bx", "class {" & char( 10 ) & "}" & char( 10 ) );

				var result = validateRoot( root );
				expect( result.errors.filter( e => e.findNoCase( "make the same scheduler class" ) ) ).toHaveLength( 1 );
			} );

			it( "errors on a scheduler left over from ColdBox's scheduler, saying what to do", function() {
				var root = newProject( "valid-minimal" );
				directoryCreate( root & "/schedules" );
				fileWrite( root & "/schedules/Scheduler.bx", 'class extends="coldbox.system.web.tasks.ColdBoxScheduler" {' & char( 10 ) & "}" & char( 10 ) );

				var result = validateRoot( root );
				var hits = result.errors.filter( e => e.findNoCase( "extends ColdBox" ) );
				expect( hits ).toHaveLength( 1 );
				expect( hits[ 1 ] ).toInclude( "plain BoxLang class" );
			} );

			/**
			 * A real, new collision risk once every agent's `name` also became
			 * a config/WireBox.bx binding key (see ColdBoxAppGenerator.
			 * renderWireBox()): two agents in the tree - the root project and
			 * a subagent, or two subagents - sharing the same declared name
			 * (explicitly, or both silently defaulting to "BxAi") would
			 * collide as a WireBox mapping and shadow one another rather than
			 * fail loudly. Caught here instead, before generation.
			 */
			it( "rejects two agents in the tree sharing the same declared name", function() {
				var result = validateFixture( "duplicate-agent-name" );
				var nameErrors = result.errors.filter( e => e.findNoCase( "is declared by more than one Agent.bx" ) );
				expect( nameErrors.len() ).toBeGT( 0 );
				expect( nameErrors[ 1 ] ).toInclude( "shared-name" );
			} );

			it( "rejects duplicate gateway exposure paths", function() {
				var result = validateFixture( "duplicate-gateway-path" );
				expect( result.errors.filter( e => e.findNoCase( "Duplicate gateway exposure path" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects duplicate gateway exposure paths that only collide once normalized (trailing slash)", function() {
				// "/chat" and "/chat/" are the same mount to every consumer -
				// both RouterGenerator and WebUiGenerator strip the trailing
				// slash - so comparing raw strings would let both claim it.
				var result = validateFixture( "duplicate-gateway-path-trailing-slash" );
				expect( result.errors.filter( e => e.findNoCase( "Duplicate gateway exposure path" ) ).len() ).toBeGT( 0 );
			} );

			it( "accepts a gateway exposure path with a trailing slash on its own", function() {
				var result = validateFixture( "gateway-path-trailing-slash-ok" );
				expect( result.errors ).toBeArray();
				expect( result.errors.len() ).toBe( 0 );
			} );

			it( "rejects a gateway exposure path missing its leading slash", function() {
				var result = validateFixture( "invalid-gateway-path-no-slash" );
				expect( result.errors.filter( e => e.findNoCase( "does not start with '/'" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects a gateway exposure path containing a '..' segment", function() {
				var result = validateFixture( "invalid-gateway-path-traversal" );
				expect( result.errors.filter( e => e.findNoCase( "containing a '.' or '..' segment" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects a gateway exposure path with characters outside the allowed set", function() {
				var result = validateFixture( "invalid-gateway-path-bad-chars" );
				expect( result.errors.filter( e => e.findNoCase( "invalid 'path'" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects an unknown gateway type", function() {
				var result = validateFixture( "unknown-gateway-type" );
				expect( result.errors.filter( e => e.findNoCase( "unknown type" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects an http gateway missing its required secretEnvVar", function() {
				var result = validateFixture( "http-gateway-missing-secret" );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'secretEnvVar'" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects a telegram gateway missing its required botTokenEnvVar", function() {
				var result = validateFixture( "telegram-gateway-missing-token" );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'botTokenEnvVar'" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects a slack gateway missing its required appTokenEnvVar (botTokenEnvVar present)", function() {
				var result = validateFixture( "slack-gateway-missing-token" );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'appTokenEnvVar'" ) ).len() ).toBeGT( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'botTokenEnvVar'" ) ).len() ).toBe( 0 );
			} );

			it( "rejects a discord gateway missing its required botTokenEnvVar", function() {
				var result = validateFixture( "discord-gateway-missing-token" );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'botTokenEnvVar'" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects an email gateway missing its required imapPasswordEnvVar/fromAddressEnvVar (imapHostEnvVar/imapUsernameEnvVar present)", function() {
				var result = validateFixture( "email-gateway-missing-token" );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'imapPasswordEnvVar'" ) ).len() ).toBeGT( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'fromAddressEnvVar'" ) ).len() ).toBeGT( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'imapHostEnvVar'" ) ).len() ).toBe( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'imapUsernameEnvVar'" ) ).len() ).toBe( 0 );
			} );

			it( "rejects a whatsapp-cloud gateway missing its required appSecretEnvVar/verifyTokenEnvVar (accessTokenEnvVar/phoneNumberIdEnvVar present)", function() {
				var result = validateFixture( "whatsapp-cloud-gateway-missing-token" );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'appSecretEnvVar'" ) ).len() ).toBeGT( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'verifyTokenEnvVar'" ) ).len() ).toBeGT( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'accessTokenEnvVar'" ) ).len() ).toBe( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'phoneNumberIdEnvVar'" ) ).len() ).toBe( 0 );
			} );

			it( "rejects a teams gateway missing its required appPasswordEnvVar (appIdEnvVar present)", function() {
				var result = validateFixture( "teams-gateway-missing-token" );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'appPasswordEnvVar'" ) ).len() ).toBeGT( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'appIdEnvVar'" ) ).len() ).toBe( 0 );
			} );

			it( "rejects a twilio gateway missing its required fromEnvVar (accountSidEnvVar/authTokenEnvVar present)", function() {
				var result = validateFixture( "twilio-gateway-missing-token" );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'fromEnvVar'" ) ).len() ).toBeGT( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'accountSidEnvVar'" ) ).len() ).toBe( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'authTokenEnvVar'" ) ).len() ).toBe( 0 );
			} );

			it( "rejects a github gateway missing its required botNameEnvVar (tokenEnvVar/webhookSecretEnvVar present)", function() {
				var result = validateFixture( "github-gateway-missing-token" );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'botNameEnvVar'" ) ).len() ).toBeGT( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'tokenEnvVar'" ) ).len() ).toBe( 0 );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'webhookSecretEnvVar'" ) ).len() ).toBe( 0 );
			} );

			it( "rejects a signal gateway missing its required accountEnvVar", function() {
				var result = validateFixture( "signal-gateway-missing-token" );
				expect( result.errors.filter( e => e.findNoCase( "requires a 'accountEnvVar'" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects an invalid gatewaySession.policy value", function() {
				var result = validateFixture( "bad-gateway-session-policy" );
				expect( result.errors.filter( e => e.findNoCase( "gatewaySession.policy" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects a bad gatewaySession.commands block: a long prefix, an unknown key, a command that is not there or does not run on a gateway", function() {
				var errors = validateFixture( "bad-gateway-commands" ).errors.filter( e => e.findNoCase( "gatewaySession.commands" ) );
				expect( errors.filter( e => e.findNoCase( "commands.prefix' must be a single character" ) ) ).toHaveLength( 1 );
				expect( errors.filter( e => e.findNoCase( "unknown key [colour]" ) ) ).toHaveLength( 1 );
				expect( errors.filter( e => e.findNoCase( "names [nonsense]" ) ) ).toHaveLength( 1 );
				expect( errors.filter( e => e.findNoCase( "names [copy]" ) ) ).toHaveLength( 1 );
				expect( errors.filter( e => e.findNoCase( "names [info]" ) ) ).toBeEmpty();
				expect( errors.filter( e => e.findNoCase( "prefixes.slack' must be a single character" ) ) ).toHaveLength( 1 );
				expect( errors.filter( e => e.findNoCase( "prefixes.telegram" ) ) ).toBeEmpty();
				expect( validateFixture( "bad-gateway-commands" ).errors.filter( e => e.findNoCase( "gatewaySession.attachments' must be true or false" ) ) ).toHaveLength( 1 );
			} );

			it( "rejects an mcp-exposure gateway entry missing its required target", function() {
				var result = validateFixture( "mcp-exposure-missing-target" );
				expect( result.errors.filter( e => e.findNoCase( "missing a 'target'" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects an mcp-exposure gateway entry targeting an unknown mcp server", function() {
				var result = validateFixture( "mcp-exposure-unknown-target" );
				expect( result.errors.filter( e => e.findNoCase( "unknown mcp server" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects an unknown model provider", function() {
				var result = validateFixture( "unknown-provider" );
				expect( result.errors.filter( e => e.findNoCase( "Unknown model provider" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects mcpServers entries missing required fields", function() {
				var result = validateFixture( "bad-mcp-server" );
				expect( result.errors.filter( e => e.findNoCase( "mcpServers" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects an mcpServers token or password written in the file, unknown keys and mistyped headers and timeouts", function() {
				var errors = validateFixture( "bad-mcp-credentials" ).errors.filter( e => e.findNoCase( "mcpServers" ) );
				var text = errors.toList( char( 10 ) );

				expect( text ).toInclude( "[leaky] writes its [token] in the file" );
				expect( text ).toInclude( "writes its [password] in the file" );
				expect( text ).toInclude( "unknown key [colour]" );
				expect( text ).toInclude( "'headers' must be a mapping" );
				expect( text ).toInclude( "'timeout' must be a number" );
			} );

			it( "accepts mcpServers credentials written as environment placeholders", function() {
				var projectRoot = expandPath( "/fixtures/with-mcp-credentials" );
				var result = validator.validate( projectRoot, discoverer.discover( projectRoot ), resolver.resolve( projectRoot = projectRoot ) );

				expect( result.errors.filter( e => e.findNoCase( "mcpServers" ) ) ).toBeEmpty();
			} );

			it( "rejects stdio and web mcpServers entries that are mixed up, mistyped or leak a secret", function() {
				var text = validateFixture( "bad-mcp-stdio" ).errors.filter( e => e.findNoCase( "mcpServers" ) ).toList( char( 10 ) );

				expect( text ).toInclude( "[both] has both a 'url' and a 'command'" );
				expect( text ).toInclude( "[string-command]'s 'command' must be a list" );
				expect( text ).toInclude( "[leaky-env] writes its env [X_API_TOKEN] in the file" );
				expect( text ).notToInclude( "env [PLAIN]" );
				expect( text ).toInclude( "[web-only-key] has an unknown key [token]" );
				expect( text ).toInclude( "'allowedHosts' must be a list of host names" );
				expect( text ).toInclude( "'redirects' must be true or false" );
				expect( text ).toInclude( "[bad-web] has an unknown key [cwd]" );
				expect( text ).toInclude( "'prefix' must be a non-empty text" );
				expect( text ).toInclude( "'toolFilter' must be a list of tool names" );
				expect( text ).toInclude( "'maxRestarts' must be a number" );
			} );

			it( "accepts stdio mcpServers and the web server controls", function() {
				var projectRoot = expandPath( "/fixtures/with-mcp-stdio" );
				var result = validator.validate( projectRoot, discoverer.discover( projectRoot ), resolver.resolve( projectRoot = projectRoot ) );

				expect( result.errors.filter( e => e.findNoCase( "mcpServers" ) ) ).toBeEmpty();
			} );

			it( "rejects a notes block with an unknown key, a bad provider, bad limits and a bad flag", function() {
				var text = validateFixture( "bad-notes" ).errors.filter( e => e.findNoCase( "notes" ) ).toList( char( 10 ) );

				expect( text ).toInclude( "unknown key [colour]" );
				expect( text ).toInclude( "'notes.provider' [not a class]" );
				expect( text ).toInclude( "'notes.user' has an unknown key [unit]" );
				expect( text ).toInclude( "'notes.user.limit' must be a whole number" );
				expect( text ).toInclude( "'notes.agent.limit' must be a whole number" );
				expect( text ).toInclude( "'notes.tool' must be true or false" );
			} );

			it( "accepts a notes block", function() {
				var projectRoot = expandPath( "/fixtures/with-notes" );
				var result = validator.validate( projectRoot, discoverer.discover( projectRoot ), resolver.resolve( projectRoot = projectRoot ) );

				expect( result.errors.filter( e => e.findNoCase( "notes" ) ) ).toBeEmpty();
			} );

			it( "rejects volumes with the reserved name and a bad mode", function() {
				var text = validateFixture( "bad-volumes" ).errors.filter( e => e.findNoCase( "volumes" ) ).toList( char( 10 ) );

				expect( text ).toInclude( "already has" );
				expect( text ).toInclude( "must be ro" );
			} );

			it( "accepts volumes with a path, a mode and a description", function() {
				expect( validateFixture( "with-volumes" ).errors.filter( e => e.findNoCase( "'volumes" ) ) ).toBeEmpty();
			} );

			it( "rejects the default memory's settings when they are out of range or unknown", function() {
				var text = validateFixture( "bad-memory" ).errors.filter( e => e.findNoCase( "memory" ) ).toList( char( 10 ) );

				expect( text ).toInclude( "memory.maxMessages must be a whole number from 20 to 100000" );
				expect( text ).toInclude( "memory.onLimit is not a setting of the default memory" );
			} );

			it( "accepts maxMessages and keepRecent under a memory block that names no type", function() {
				expect( validateFixture( "with-memory" ).errors.filter( e => e.findNoCase( "memory" ) ) ).toBeEmpty();
			} );

			it( "rejects a data block with an unknown key", function() {
				var text = validateFixture( "bad-data" ).errors.filter( e => e.findNoCase( "'data'" ) ).toList( char( 10 ) );

				expect( text ).toInclude( "'data' has an unknown key [folder]" );
			} );

			it( "accepts a data block that names a home", function() {
				expect( validateFixture( "with-data" ).errors.filter( e => e.findNoCase( "'data" ) ) ).toBeEmpty();
			} );

			it( "rejects a vault block with an unknown key or a bad flag", function() {
				var text = validateFixture( "bad-vault" ).errors.filter( e => e.findNoCase( "vault" ) ).toList( char( 10 ) );

				expect( text ).toInclude( "'vault' has an unknown key [colour]" );
				expect( text ).toInclude( "'vault.tools' must be true or false" );
			} );

			it( "accepts a vault block, and a vault placeholder with no block", function() {
				for ( var fixture in [ "with-vault", "with-vault-placeholder" ] ) {
					var projectRoot = expandPath( "/fixtures/" & fixture );
					var result = validator.validate( projectRoot, discoverer.discover( projectRoot ), resolver.resolve( projectRoot = projectRoot ) );

					// the token written as ${vault.NAME} is not "a token in the file"
					expect( result.errors.filter( e => e.findNoCase( "vault" ) || e.findNoCase( "writes its" ) ) ).toBeEmpty();
				}
			} );

			it( "rejects a model that names no provider and no profile", function() {
				var result = validateFixture( "missing-model-reference" );
				expect( result.errors.filter( e => e.findNoCase( "has no provider" ) ).len() ).toBeGT( 0 );
			} );

			/**
			 * Regression: a real bug this closed - validateModelProvider() was
			 * only ever called once, against the ROOT project's own resolved
			 * config. A SUBAGENT's own bad `model` value (unknown provider, or
			 * a name matching neither a core provider nor a models/ entry)
			 * passed validation cleanly and only crashed later, mid-generation,
			 * in ColdBoxAppGenerator - the same "validated but crashes at
			 * generation" pattern already closed for schedule action/cron
			 * support and root-level subagent references.
			 */
			it( "rejects a subagent's own bad model value, clearly attributed to that subagent", function() {
				var result = validateFixture( "subagent-bad-model" );
				var modelErrors = result.errors.filter( e => e.findNoCase( "has no provider" ) );
				expect( modelErrors.len() ).toBeGT( 0 );
				expect( modelErrors[ 1 ] ).toInclude( "Subagent [bad]" );
			} );

			it( "detects a circular module dependency", function() {
				var result = validateFixture( "module-cycle" );
				expect( result.errors.filter( e => e.findNoCase( "Circular module dependency" ) ).len() ).toBeGT( 0 );
			} );

			it( "rejects a module dependency referencing an unknown module", function() {
				var result = validateFixture( "module-missing-ref" );
				expect( result.errors.filter( e => e.findNoCase( "depends on unknown module" ) ).len() ).toBeGT( 0 );
			} );

			it( "collects multiple independent errors in a single validation pass", function() {
				var result = validateFixture( "multiple-errors" );

				expect( result.errors.filter( e => e.findNoCase( "Duplicate name" ) && e.findNoCase( "tools/" ) ).len() ).toBeGT( 0 );
				expect( result.errors.filter( e => e.findNoCase( "unknown type" ) ).len() ).toBeGT( 0 );
				expect( result.errors.filter( e => e.findNoCase( "Unknown model provider" ) ).len() ).toBeGT( 0 );
				expect( result.errors.len() ).toBeGTE( 3 );
			} );

			it( "accepts a webui gateway exposure entry, with or without an apiKeyEnvVar", function() {
				var withKey = validateFixture( "../gateways-webui" );
				expect( withKey.errors ).toBeArray();
				expect( withKey.errors.len() ).toBe( 0 );

				var withoutKey = validateFixture( "../gateways-webui-no-key" );
				expect( withoutKey.errors ).toBeArray();
				expect( withoutKey.errors.len() ).toBe( 0 );
			} );

			it( "accepts a fully themed webui entry", function() {
				var result = validateFixture( "../gateways-webui-themed" );
				expect( result.errors ).toBeArray();
				expect( result.errors.len() ).toBe( 0 );
			} );

			it( "rejects an unknown theme token so a typo fails the build instead of silently doing nothing", function() {
				var result = validateFixture( "../gateways-webui-bad-theme" );
				expect( result.errors.len() ).toBeGT( 0 );
				expect( result.errors.toList( " " ) ).toInclude( "theme.accentColor" );

				// The nested dark-mode block is validated against the same token list
				expect( result.errors.toList( " " ) ).toInclude( "theme.dark.bakcground" );
			} );

			it( "rejects a webui database block that would not survive generation", function() {
				// Both values are spliced straight into generated source - the
				// datasource name into ColdBox/qb settings, the path into an
				// expandPath() call. An absolute path there silently escapes the
				// app directory, which breaks a packaged .bxa deploy.
				var result = validateFixture( "../gateways-webui-bad-db" );
				expect( result.errors.len() ).toBeGT( 0 );

				var joined = result.errors.toList( " " );
				expect( joined ).toInclude( "database.datasource" );
				expect( joined ).toInclude( "database.path" );
				expect( joined ).toInclude( "journalMode" );
			} );

			it( "rejects a webui database path that walks out of the app with ..", function() {
				// The absolute-path check above does not catch this: the value is
				// relative, so it passed validation cleanly and still escaped the
				// app directory once expandPath() resolved it - the same failure
				// the absolute check exists to prevent.
				var result = validateFixture( "../gateways-webui-traversal-db" );
				expect( result.errors.len() ).toBeGT( 0 );
				expect( result.errors.toList( " " ) ).toInclude( "walks outside the app" );
			} );

			it( "rejects a webui users block that would leak or misconfigure credentials", function() {
				var result = validateFixture( "../gateways-webui-bad-users" );
				expect( result.errors.len() ).toBeGT( 0 );

				var joined = result.errors.toList( " " );
				// A committed password is rejected outright rather than ignored -
				// silently dropping it leaves someone believing they set one
				expect( joined ).toInclude( "never commit a password" );
				// No password source at all
				expect( joined ).toInclude( "needs either a 'passwordEnvVar'" );
				// Both sources set
				expect( joined ).toInclude( "pick one" );
				// Same username twice would race at seed time
				expect( joined ).toInclude( "more than once" );
				// A bcrypt-style hash is not this project's format
				expect( joined ).toInclude( "not in this project's format" );
				// admin is a flag, not a word
				expect( joined ).toInclude( "'admin' that is not true or false" );
			} );

			it( "returns no errors for a fully valid project", function() {
				var result = validateFixture( "../full-project" );
				expect( result.errors ).toBeArray();
				expect( result.errors.len() ).toBe( 0 );
			} );

		} );
	}

}
