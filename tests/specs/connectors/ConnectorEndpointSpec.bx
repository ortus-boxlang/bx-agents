import bxagents.models.connectors.ConnectorEndpoint;
import bxagents.models.connectors.ConnectorSettings;

/**
 * Where a connector is reached for one person: the address and headers its options make, and the sign in entries.
 */
class extends="testbox.system.BaseSpec" {

	/**
	 * @id A connector id
	 * @config The agent's config
	 *
	 * @return The connector as offered
	 */
	private struct function entryFor( required string id, struct config = {} ) {
		var wanted = arguments.id;
		return ConnectorSettings::resolve( arguments.config ).available.filter( c => c.id == wanted )[ 1 ];
	}

	/**
	 * The specs.
	 */
	function run() {
		describe( "ConnectorEndpoint", function() {

			it( "adds a query option's value to the address, in the order of the options, and leaves out an empty one", function() {
				var supabase = entryFor( "supabase" );

				expect( ConnectorEndpoint::of( supabase ).url ).toBe( "https://mcp.supabase.com/mcp?read_only=true" );
				expect( ConnectorEndpoint::of( supabase, { project_ref : "abc123" } ).url ).toBe( "https://mcp.supabase.com/mcp?project_ref=abc123&read_only=true" );
				expect( ConnectorEndpoint::of( supabase, { read_only : false } ).url ).toBe( "https://mcp.supabase.com/mcp" );
				expect( ConnectorEndpoint::of( supabase, { features : "database,docs" } ).url ).toInclude( "features=database%2Cdocs" );
			} );

			it( "sends a header option as a header, a boolean only when it is true", function() {
				var github = entryFor( "github" );

				expect( ConnectorEndpoint::of( github ).headers ).toBeEmpty();
				expect( ConnectorEndpoint::of( github, { readonly : true, toolsets : "issues,pull_requests" } ).headers ).toBe( { "X-MCP-Readonly" : "true", "X-MCP-Toolsets" : "issues,pull_requests" } );
				expect( ConnectorEndpoint::of( github, { readonly : false } ).headers ).toBeEmpty();
				expect( ConnectorEndpoint::of( github ).url ).toBe( "https://api.githubcopilot.com/mcp/" );
			} );

			it( "applies an option that is only for one way in to that way alone", function() {
				var stripe = entryFor( "stripe" );

				expect( ConnectorEndpoint::of( stripe, { connectedAccount : "acct_123" }, "bearer" ).headers ).toBe( { "Stripe-Account" : "acct_123" } );
				expect( ConnectorEndpoint::of( stripe, { connectedAccount : "acct_123" }, "oauth" ).headers ).toBeEmpty();
			} );

			it( "carries the admin's timeout, and none when the admin set none", function() {
				expect( ConnectorEndpoint::of( entryFor( "github" ) ).keyExists( "timeout" ) ).toBeFalse();
				var set = entryFor( "github", { connectors : { override : { github : { timeout : 45000 } } } } );

				expect( ConnectorEndpoint::of( set ).timeout ).toBe( 45000 );
			} );

			it( "makes a sign in entry for each offered connector that has one, and none for a token only or a local one", function() {
				var entries = ConnectorEndpoint::oauthEntries( ConnectorSettings::resolve( {} ).available );
				var names = entries.map( e => e.name );

				expect( names ).toBe( [ "atlassian", "cloudflare", "notion", "stripe", "supabase" ] );
				expect( names ).notToInclude( "github" );
				expect( names ).notToInclude( "git" );
			} );

			it( "gives a sign in entry its scopes, or true when the catalog names none, and the admin's option values in its address", function() {
				var config = { connectors : { override : { supabase : { options : { project_ref : "abc123" } }, atlassian : { scopes : [ "read:jira:agent-interface" ] } } } };
				var entries = ConnectorEndpoint::oauthEntries( ConnectorSettings::resolve( config ).available ).reduce( ( all, e ) => { all[ e.name ] = e; return all; }, {} );

				expect( entries.stripe.oauth ).toBe( { scopes : [ "mcp" ] } );
				expect( entries.cloudflare.oauth.scopes ).toBe( [ "user:read", "account:read" ] );
				expect( entries.notion.oauth ).toBeTrue();
				expect( entries.atlassian.oauth.scopes ).toBe( [ "read:jira:agent-interface" ] );
				expect( entries.supabase.url ).toBe( "https://mcp.supabase.com/mcp?project_ref=abc123&read_only=true" );
				expect( entries.notion.keyExists( "headers" ) ).toBeFalse();
			} );
		} );
	}

}
