import bxagents.models.connectors.ConnectorEndpoint;
import bxagents.models.connectors.ConnectorSettings;

/**
 * Where a connector is reached for one person: the address and headers its options make, and the sign in entries.
 */
class extends="testbox.system.BaseSpec" {

	/**
	 * @id A connector id
	 * @config The agent's config
	 *
	 * @return The connector as offered
	 */
	private struct function entryFor( required string id, struct config = {} ) {
		var wanted = arguments.id;
		return ConnectorSettings::resolve( arguments.config ).available.filter( c => c.id == wanted )[ 1 ];
	}

	/**
	 * The specs.
	 */
	function run() {
		describe( "ConnectorEndpoint", function() {

			it( "adds a query option's value to the address, in the order of the options, and leaves out an empty one", function() {
				var supabase = entryFor( "supabase" );

				expect( ConnectorEndpoint::of( supabase ).url ).toBe( "https://mcp.supabase.com/mcp?read_only=true" );
				expect( ConnectorEndpoint::of( supabase, { project_ref : "abc123" } ).url ).toBe( "https://mcp.supabase.com/mcp?project_ref=abc123&read_only=true" );
				expect( ConnectorEndpoint::of( supabase, { read_only : false } ).url ).toBe( "https://mcp.supabase.com/mcp" );
				expect( ConnectorEndpoint::of( supabase, { features : "database,docs" } ).url ).toInclude( "features=database%2Cdocs" );
			} );

			it( "sends a header option as a header, a boolean only when it is true", function() {
				var github = entryFor( "github" );

				expect( ConnectorEndpoint::of( github ).headers ).toBeEmpty();
				expect( ConnectorEndpoint::of( github, { readonly : true, toolsets : "issues,pull_requests" } ).headers ).toBe( { "X-MCP-Readonly" : "true", "X-MCP-Toolsets" : "issues,pull_requests" } );
				expect( ConnectorEndpoint::of( github, { readonly : false } ).headers ).toBeEmpty();
				expect( ConnectorEndpoint::of( github ).url ).toBe( "https://api.githubcopilot.com/mcp/" );
			} );

			it( "puts the chosen host in the address, and never a host that is not one of the choices", function() {
				var datadog = entryFor( "datadog" );

				expect( ConnectorEndpoint::of( datadog ).url ).toBe( "https://mcp.datadoghq.com/v1/mcp" );
				expect( ConnectorEndpoint::of( datadog ).host ).toBe( "mcp.datadoghq.com" );
				expect( ConnectorEndpoint::of( datadog, { site : "mcp.datadoghq.eu" } ).url ).toBe( "https://mcp.datadoghq.eu/v1/mcp" );
				expect( ConnectorEndpoint::of( datadog, { site : "mcp.datadoghq.eu" } ).host ).toBe( "mcp.datadoghq.eu" );
				// somebody else's server is not a choice: the default is used
				expect( ConnectorEndpoint::of( datadog, { site : "evil.example.com" } ).url ).toBe( "https://mcp.datadoghq.com/v1/mcp" );
				expect( ConnectorEndpoint::of( datadog, { site : "mcp.datadoghq.com@evil.example.com" } ).host ).toBe( "mcp.datadoghq.com" );
				expect( ConnectorEndpoint::of( datadog ).url ).notToInclude( "{" );
			} );

			it( "lists every host a connector may be reached at, so a token is sealed for all of them", function() {
				expect( ConnectorEndpoint::hostsOf( entryFor( "datadog" ) ) ).toHaveLength( 7 );
				expect( ConnectorEndpoint::hostsOf( entryFor( "datadog" ) ) ).toInclude( "mcp.datadoghq.eu" );
				expect( ConnectorEndpoint::hostsOf( entryFor( "github" ) ) ).toBe( [ "api.githubcopilot.com" ] );
				expect( ConnectorEndpoint::hostFor( entryFor( "mixpanel" ), { region : "mcp-eu.mixpanel.com" } ) ).toBe( "mcp-eu.mixpanel.com" );
			} );

			it( "says which header a token goes in: Authorization with Bearer unless the connector names another", function() {
				var plain = ConnectorEndpoint::of( entryFor( "github" ) );
				var keyed = ConnectorEndpoint::of( entryFor( "bigdata" ) );

				expect( plain.tokenHeader ).toBe( "" );
				expect( plain.tokenPrefix ).toBe( "Bearer " );
				expect( keyed.tokenHeader ).toBe( "x-api-key" );
				expect( keyed.tokenPrefix ).toBe( "" );
				expect( ConnectorEndpoint::of( entryFor( "wix" ), { wix_account_id : "acc-1" }, "bearer" ).headers ).toBe( { "wix-account-id" : "acc-1" } );
				expect( ConnectorEndpoint::of( entryFor( "wix" ), { wix_account_id : "acc-1" }, "oauth" ).headers ).toBeEmpty();
			} );

			it( "knows a public server from one that asks for a sign in or a token", function() {
				expect( ConnectorEndpoint::isOpen( entryFor( "excalidraw" ) ) ).toBeTrue();
				expect( ConnectorEndpoint::of( entryFor( "excalidraw" ) ).open ).toBeTrue();
				expect( ConnectorEndpoint::isOpen( entryFor( "github" ) ) ).toBeFalse();
				expect( ConnectorEndpoint::isOpen( entryFor( "git" ) ) ).toBeFalse();
			} );

			it( "makes a sign in entry for an app of the admin's own only once the admin has set it", function() {
				var available = ConnectorSettings::resolve( {} ).available;
				var none = ConnectorEndpoint::oauthEntries( available, name => "" ).map( e => e.name );

				// nothing set: no sign in for slack, asana or x-ads, and the others have theirs
				expect( none ).notToInclude( "slack" );
				expect( none ).notToInclude( "asana" );
				expect( none ).toInclude( "notion" );
				expect( ConnectorEndpoint::oauthEntries( available ).map( e => e.name ) ).notToInclude( "slack" );

				var set = { SLACK_CLIENT_ID : "id-1", SLACK_CLIENT_SECRET : "secret-1", X_ADS_CLIENT_ID : "native-id" };
				var entries = ConnectorEndpoint::oauthEntries( available, name => set[ name ] ?: "" ).reduce( ( all, e ) => { all[ e.name ] = e; return all; }, {} );

				expect( entries.slack.oauth.clientId ).toBe( "id-1" );
				expect( entries.slack.oauth.clientSecret ).toBe( "secret-1" );
				expect( entries.slack.oauth.scopes ).toInclude( "chat:write" );
				// a public client has an id and no secret
				expect( entries[ "x-ads" ].oauth.clientId ).toBe( "native-id" );
				expect( entries[ "x-ads" ].oauth ).notToHaveKey( "clientSecret" );
				expect( entries ).notToHaveKey( "asana" );
				// what the catalog says about it holds the names of variables, not values
				expect( ConnectorEndpoint::ownApp( entryFor( "slack" ) ).envVars ).toBe( { clientId : "SLACK_CLIENT_ID", clientSecret : "SLACK_CLIENT_SECRET" } );
			} );

			it( "gives a Google connector the addresses of its sign in and what it asks for, once the admin has set the app", function() {
				var available = ConnectorSettings::resolve( {} ).available;
				var set = { GOOGLE_CLIENT_ID : "g-id", GOOGLE_CLIENT_SECRET : "g-secret" };
				var entries = ConnectorEndpoint::oauthEntries( available, name => set[ name ] ?: "" ).reduce( ( all, e ) => { all[ e.name ] = e; return all; }, {} );

				expect( entries.gmail.oauth.endpoints.token ).toBe( "https://oauth2.googleapis.com/token" );
				expect( entries.gmail.oauth.endpoints.authorize ).toBe( "https://accounts.google.com/o/oauth2/v2/auth" );
				expect( entries.gmail.oauth.params ).toBe( { access_type : "offline", prompt : "consent" } );
				expect( entries.gmail.oauth.scopes ).toInclude( "https://www.googleapis.com/auth/gmail.readonly" );
				expect( entries.gmail.oauth.clientId ).toBe( "g-id" );
				expect( entries[ "google-drive" ].oauth.clientSecret ).toBe( "g-secret" );
				expect( entries.gmail.url ).toBe( "https://gmailmcp.googleapis.com/mcp/v1" );
				// the app is not set: none of the three has a sign in
				var none = ConnectorEndpoint::oauthEntries( available, name => "" ).map( e => e.name );
				expect( none ).notToInclude( "gmail" );
				expect( none ).notToInclude( "google-calendar" );
				// which connectors BxAgents signs in itself
				expect( ConnectorEndpoint::hasOwnEndpoints( entryFor( "gmail" ) ) ).toBeTrue();
				expect( ConnectorEndpoint::hasOwnEndpoints( entryFor( "slack" ) ) ).toBeFalse();
				expect( ConnectorEndpoint::hasOwnEndpoints( entryFor( "notion" ) ) ).toBeFalse();
			} );

			it( "applies an option that is only for one way in to that way alone", function() {
				var stripe = entryFor( "stripe" );

				expect( ConnectorEndpoint::of( stripe, { connectedAccount : "acct_123" }, "bearer" ).headers ).toBe( { "Stripe-Account" : "acct_123" } );
				expect( ConnectorEndpoint::of( stripe, { connectedAccount : "acct_123" }, "oauth" ).headers ).toBeEmpty();
			} );

			it( "carries the admin's timeout, and none when the admin set none", function() {
				expect( ConnectorEndpoint::of( entryFor( "github" ) ).keyExists( "timeout" ) ).toBeFalse();
				var set = entryFor( "github", { connectors : { override : { github : { timeout : 45000 } } } } );

				expect( ConnectorEndpoint::of( set ).timeout ).toBe( 45000 );
			} );

			it( "makes a sign in entry for each offered connector that has one, and none for a token only or a local one", function() {
				var entries = ConnectorEndpoint::oauthEntries( ConnectorSettings::resolve( {} ).available );
				var names = entries.map( e => e.name );

				// an app of the admin's own has no sign in until the admin has set it: those are left out here
				expect( names ).toBe( new bxagents.models.connectors.ConnectorCatalog().all().filter( e => e.auth.some( m => m.type == "oauth" && ( m.app ?: "" ) != "own" ) ).map( e => e.id ) );
				for ( var id in [ "atlassian", "cloudflare", "notion", "stripe", "supabase" ] ) {
					expect( names ).toInclude( id );
				}
				expect( names ).notToInclude( "github" );
				expect( names ).notToInclude( "git" );
			} );

			it( "gives a sign in entry its scopes, or true when the catalog names none, and the admin's option values in its address", function() {
				var config = { connectors : { override : { supabase : { options : { project_ref : "abc123" } }, atlassian : { scopes : [ "read:jira:agent-interface" ] } } } };
				var entries = ConnectorEndpoint::oauthEntries( ConnectorSettings::resolve( config ).available ).reduce( ( all, e ) => { all[ e.name ] = e; return all; }, {} );

				expect( entries.stripe.oauth ).toBe( { scopes : [ "mcp" ] } );
				expect( entries.cloudflare.oauth.scopes ).toBe( [ "user:read", "account:read" ] );
				expect( entries.notion.oauth ).toBeTrue();
				expect( entries.atlassian.oauth.scopes ).toBe( [ "read:jira:agent-interface" ] );
				expect( entries.supabase.url ).toBe( "https://mcp.supabase.com/mcp?project_ref=abc123&read_only=true" );
				expect( entries.notion.keyExists( "headers" ) ).toBeFalse();
			} );

			it( "starts a local program with a clean environment: what it needs to run, never the agent's secrets", function() {
				var host = {
					PATH : "/usr/bin", HOME : "/home/ada", LANG : "en_US.UTF-8", UV_CACHE_DIR : "/cache/uv", XDG_CACHE_HOME : "/cache", HTTPS_PROXY : "http://proxy:3128",
					BXAGENTS_VAULT_KEY : "vault-key-secret", OPENAI_API_KEY : "sk-secret", GITHUB_TOKEN : "ghp_secret", AWS_SECRET_ACCESS_KEY : "aws-secret"
				};
				var env = ConnectorEndpoint::programEnvironment( host, { MODE : "ro" } );

				expect( env.PATH ).toBe( "/usr/bin" );
				expect( env.HOME ).toBe( "/home/ada" );
				expect( env.UV_CACHE_DIR ).toBe( "/cache/uv" );
				expect( env.MODE ).toBe( "ro" );
				expect( env ).notToHaveKey( "BXAGENTS_VAULT_KEY" );
				expect( env ).notToHaveKey( "OPENAI_API_KEY" );
				expect( env ).notToHaveKey( "GITHUB_TOKEN" );
				expect( env ).notToHaveKey( "AWS_SECRET_ACCESS_KEY" );
			} );
		} );
	}

}
