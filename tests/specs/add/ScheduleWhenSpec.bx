class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "add.ScheduleWhen", function() {

			beforeEach( function() {
				variables.when = new bxagents.models.add.ScheduleWhen();
			} );

			it( "turns each phrase into the ColdBox scheduled-task call", function() {
				var cases = {
					"every 15 minutes"         : '.every( 15, "minutes" )',
					"every 1 hour"             : '.every( 1, "hours" )',
					"every 2 days"             : '.every( 2, "days" )',
					"hourly"                   : ".everyHour()",
					"hourly :15"               : ".everyHourAt( 15 )",
					"daily 09:00"              : '.everyDayAt( "09:00" )',
					"daily 9:05"               : '.everyDayAt( "09:05" )',
					"weekdays 08:30"           : '.onWeekdays( "08:30" )',
					"weekends 10:00"           : '.onWeekends( "10:00" )',
					"weekly mon 09:00"         : '.everyWeekOn( 1, "09:00" )',
					"weekly Sunday 18:30"      : '.everyWeekOn( 7, "18:30" )',
					"monthly 1 09:00"          : '.everyMonthOn( 1, "09:00" )',
					"first-business-day 09:00" : '.onFirstBusinessDayOfTheMonth( "09:00" )',
					"last-business-day 17:00"  : '.onLastBusinessDayOfTheMonth( "17:00" )'
				};

				for ( var phrase in cases ) {
					expect( when.parse( phrase ).call ).toBe( cases[ phrase ], "for [#phrase#]" );
				}
			} );

			it( "says each in plain words", function() {
				expect( when.parse( "every 15 minutes" ).summary ).toBe( "every 15 minutes" );
				expect( when.parse( "every 1 hours" ).summary ).toBe( "every hour" );
				expect( when.parse( "weekly fri 16:00" ).summary ).toBe( "every Friday at 16:00" );
				expect( when.parse( "weekdays 08:30" ).summary ).toBe( "Monday to Friday at 08:30" );
			} );

			it( "ignores case and extra spaces", function() {
				expect( when.parse( "  DAILY   09:00 " ).call ).toBe( '.everyDayAt( "09:00" )' );
			} );

			it( "only emits methods ColdBox's ScheduledTask really has", function() {
				var source = fileRead( expandPath( "/coldbox" ) & "/system/async/tasks/ScheduledTask.cfc" );
				var phrases = [ "every 5 minutes", "hourly", "hourly :5", "daily 09:00", "weekdays 09:00", "weekends 09:00", "weekly mon 09:00", "monthly 2 09:00", "first-business-day 09:00", "last-business-day 09:00" ];

				for ( var phrase in phrases ) {
					var method = when.parse( phrase ).call.reReplace( "^\.", "" ).reReplace( "\(.*$", "" );
					expect( source ).toInclude( "function " & method & "(", "ScheduledTask has no #method#()" );
				}
			} );

			it( "rejects what it cannot read, with an example", function() {
				var bad = [ "", "cron 0 9 * * *", "sometimes", "every minutes", "every 0 minutes", "every 5 fortnights", "hourly :99", "daily", "daily 25:00", "daily 9am", "weekly noday 09:00", "weekly mon", "monthly 31 09:00", "monthly 0 09:00" ];

				for ( var phrase in bad ) {
					var accepted = true;
					try {
						when.parse( phrase );
					} catch ( BxAgents.InvalidSchedule e ) {
						accepted = false;
					}
					expect( accepted ).toBeFalse( "accepted [#phrase#]" );
				}
			} );

		} );
	}

}
