class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "BrowserLauncher", function() {

			it( "refuses anything that is not a web address", function() {
				var launcher = new "models.connect.BrowserLauncher@bxagents"()
				expect( launcher.open( "file:///etc/passwd" ) ).toBeFalse()
				expect( launcher.open( "javascript:alert(1)" ) ).toBeFalse()
				expect( launcher.open( "calc.exe" ) ).toBeFalse()
				expect( launcher.open( "" ) ).toBeFalse()
			} );

		} );
	}

}
