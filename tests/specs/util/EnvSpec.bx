class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "Env", function() {

			beforeEach( function() {
				variables.system = createObject( "java", "java.lang.System" );
				variables.key = "BXAGENTS_ENV_SPEC_" & replace( createUUID(), "-", "", "all" );
			} );

			afterEach( function() {
				system.clearProperty( key );
			} );

			it( "answers the default for a name nothing sets", function() {
				expect( new bxagents.models.util.Env().get( key, "fallback" ) ).toBe( "fallback" );
				expect( new bxagents.models.util.Env().get( key ) ).toBe( "" );
			} );

			it( "answers what the system property is NOW, however often it changes (getSystemSetting() keeps its first answer)", function() {
				var env = new bxagents.models.util.Env();
				expect( env.get( key, "none" ) ).toBe( "none" );
				system.setProperty( key, "a" );
				expect( env.get( key, "none" ) ).toBe( "a" );
				system.setProperty( key, "b" );
				expect( env.get( key, "none" ) ).toBe( "b" );
				system.clearProperty( key );
				expect( env.get( key, "none" ) ).toBe( "none" );
			} );

			it( "is why it exists: getSystemSetting() answers from a per-key cache for the life of the process", function() {
				system.setProperty( key, "a" );
				expect( getSystemSetting( key, "none" ) ).toBe( "a" );
				system.setProperty( key, "b" );
				// measured on BoxLang 1.19.0: still "a"
				expect( getSystemSetting( key, "none" ) ).toBe( "a" );
			} );

		} );
	}

}
