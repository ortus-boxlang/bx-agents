/**
 * Extensions in a served agent: the build copies the project's extensions into the app and says how the
 * app starts them, and the app's start loads them, answers commands with them and starts their
 * BoxLang schedulers in the runtime's scheduler service.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "extensions in the built app", function() {

			beforeEach( function() {
				variables.tempDirs = [];
				variables.example = expandPath( "/examples/extensions-agent" );
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
				application.delete( "cbController" );
				application.delete( "bxagentsCommands" );
				application.delete( "bxagentsExtensions" );
			} );

			// the generated wiring: the base class public/Application.bx extends
			function wiring( required struct result ) {
				return fileRead( result.appDir & "/bxagents/Application.bx" );
			}

			function projectCopy() {
				var dir = createTempDirectory( prefix = "bxagents-extbuild-" );
				directoryCopy( example, dir, true );
				tempDirs.append( dir );
				return dir;
			}

			it( "copies extensions/ into the app, writes the project's settings, and starts them from Application.bx", function() {
				var root = projectCopy();
				var result = new bxagents.models.build.BuildPipeline( "1.0.0" ).build( root );

				expect( fileExists( result.appDir & "/extensions/hello.bx" ) ).toBeTrue();
				expect( fileExists( result.appDir & "/extensions/standup/schedulers/Reminder.bx" ) ).toBeTrue();
				var settings = jsonDeserialize( fileRead( result.appDir & "/config/extensions.json" ) );
				expect( settings.hello.greeting ).toBe( "Welcome aboard" );
				expect( settings.standup.at ).toBe( "09:30" );
				expect( wiring( result ) ).toInclude( "ServedExtensions@bxagents" );
			} );

			it( "builds a project with no extensions folder exactly as before", function() {
				var root = projectCopy();
				directoryDelete( root & "/extensions", true );
				// the example's loopback gateway is a type its extension brings, so it goes with it
				fileDelete( root & "/gateways/loopback.bx" );
				var result = new bxagents.models.build.BuildPipeline( "1.0.0" ).build( root );

				expect( directoryExists( result.appDir & "/extensions" ) ).toBeFalse();
				expect( wiring( result ) ).notToInclude( "ServedExtensions" );
			} );

			it( "keeps what extensions carry where it is: tools, skills, gateways and web files are not copied or merged", function() {
				var root = projectCopy();
				var result = new bxagents.models.build.BuildPipeline( "1.0.0" ).build( root );
				var app = result.appDir;

				// the extensions folder is in the app as it is...
				expect( fileExists( app & "/extensions/helpdesk/tools/Tickets.bx" ) ).toBeTrue();
				expect( fileExists( app & "/extensions/helpdesk/skills/triage/SKILL.md" ) ).toBeTrue();
				expect( fileExists( app & "/extensions/loopback/gateways/Loopback.bx" ) ).toBeTrue();
				expect( fileExists( app & "/extensions/panel/web/panel.js" ) ).toBeTrue();
				// ...and nothing of it was put anywhere else
				expect( fileExists( app & "/tools/Tickets.bx" ) ).toBeFalse();
				expect( directoryExists( app & "/skills/triage" ) ).toBeFalse();
				expect( directoryExists( app & "/chat/ext" ) ).toBeFalse();
				// the factory, the page and Application.bx read them there
				expect( fileRead( app & "/agent/GeneratedAgentFactory.bx" ) ).toInclude( "../extensions/helpdesk/tools" );
				expect( fileRead( app & "/agent/GeneratedAgentFactory.bx" ) ).toInclude( "../extensions/helpdesk/skills" );
				var ui = jsonDeserialize( fileRead( app & "/config/bxagentsui.json" ) );
				expect( ui.extensionScripts ).toBe( [ "/chat/ext/panel/panel.js" ] );
				expect( ui.extensionStyles ).toBe( [ "/chat/ext/panel/panel.css" ] );
				expect( fileRead( app & "/bxagents/Application.bx" ) ).toInclude( 'ExtensionGateways@bxagents"( appPath( "" ) ).register( "loopback"' );
				expect( fileRead( app & "/handlers/AgentApi.bx" ) ).toInclude( "function extensionFile(" );
				// the web app module answers <path>/ext/... and hands it to AgentApi.extensionFile (see bxagentsui Forward)
				expect( fileRead( app & "/modules/bxagentsui/config/Router.bx" ) ).toInclude( "/ext/:extension/:file-regex:(.+)" );
			} );

			function hasScheduler( required string name ) {
				var service = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getSchedulerService();
				return service.hasScheduler( createObject( "java", "ortus.boxlang.runtime.scopes.Key" ).of( name ) );
			}

			it( "starts the built app's extensions: commands for the web and chat platforms, BoxLang schedulers running with the extension's settings", function() {
				var root = projectCopy();
				var result = new bxagents.models.build.BuildPipeline( "1.0.0" ).build( root );

				var served = new bxagents.models.extensions.ServedExtensions( result.appDir ).start();

				try {
					var commands = new bxagents.models.chat.commands.CommandCatalog().forApplication();
					var names = commands.menu( "web" ).map( c => c.name );
					expect( names ).toInclude( "/hello" );
					expect( names ).toInclude( "/standup" );
					expect( names ).toInclude( "/extensions" );
					expect( hasScheduler( "extension-standup-Reminder" ) ).toBeTrue();
					// the scheduler's configure() read the settings Agent.yml gave the extension
					var running = served.service().report().filter( e => e.name == "standup" )[ 1 ];
					expect( running.state ).toBe( "loaded" );
					expect( running.problems ).toBeEmpty();
				} finally {
					served.stop();
				}
				expect( hasScheduler( "extension-standup-Reminder" ) ).toBeFalse();
			} );

			it( "says why a scheduler did not start, on its extension, and starts the others", function() {
				var root = projectCopy();
				fileWrite( root & "/extensions/standup/schedulers/Broken.bx", "class { function configure() { throw( message = 'no cron' ) } }" );
				var result = new bxagents.models.build.BuildPipeline( "1.0.0" ).build( root );

				var served = new bxagents.models.extensions.ServedExtensions( result.appDir ).start();

				try {
					expect( hasScheduler( "extension-standup-Reminder" ) ).toBeTrue();
					expect( hasScheduler( "extension-standup-Broken" ) ).toBeFalse();
					var standup = served.service().report().filter( e => e.name == "standup" )[ 1 ];
					expect( standup.problems[ 1 ] ).toInclude( "Broken" );
					expect( standup.problems[ 1 ] ).toInclude( "no cron" );
				} finally {
					served.stop();
				}
			} );

			it( "registers the extensions with ColdBox as interceptors, and takes them out when stopped", function() {
				var root = projectCopy();
				var result = new bxagents.models.build.BuildPipeline( "1.0.0" ).build( root );
				var seen = { registered : [], removed : [] };
				var interceptors = {
					register : ( target, name ) => seen.registered.append( name ),
					unregister : ( name ) => seen.removed.append( name )
				};
				application.cbController = { getInterceptorService : () => interceptors };

				var served = new bxagents.models.extensions.ServedExtensions( result.appDir ).start();
				served.stop();

				expect( seen.registered ).toInclude( "extension-audit" );
				expect( seen.registered ).toInclude( "extension-guard" );
				expect( seen.removed.sort( "text" ) ).toBe( seen.registered.sort( "text" ) );
			} );

			it( "does not read the person's own extensions in a served app", function() {
				var root = projectCopy();
				var result = new bxagents.models.build.BuildPipeline( "1.0.0" ).build( root );
				var home = createTempDirectory( prefix = "bxagents-home-" );
				tempDirs.append( home );
				directoryCreate( home & "/extensions" );
				fileWrite( home & "/extensions/mine.bx", "class { @Command( 'mine' ) function m( agentContext ) { return 'mine' } }" );
				fileWrite( home & "/Agent.yml", "extensions:
  disable: [ hello ]
" );
				// the served app takes no person's file and no home folder: nothing of the above is read
				var served = new bxagents.models.extensions.ServedExtensions( result.appDir ).start();
				var commands = application.bxagentsCommands;

				expect( isNull( commands.lookup( "mine" ) ) ).toBeTrue();
				expect( isNull( commands.lookup( "hello" ) ) ).toBeFalse();
				served.stop();
			} );

			it( "answers commands from the app's registry in the command service and a gateway session", function() {
				var root = projectCopy();
				var result = new bxagents.models.build.BuildPipeline( "1.0.0" ).build( root );
				var served = new bxagents.models.extensions.ServedExtensions( result.appDir ).start();

				var registry = new bxagents.models.chat.commands.CommandCatalog().forApplication();
				var context = new bxagents.models.chat.commands.CommandContext( {}, "gateway", true );
				expect( registry.run( "/hello Ada", context ).blocks()[ 1 ].text ).toBe( "Welcome aboard, Ada!" );
				// a chat platform answers only what its gateway allows, and the allow list can name an extension's command
				var allowed = registry.only( [ "hello", "info" ] );
				expect( allowed.menu( "gateway" ).map( c => c.name ) ).toBe( [ "/hello", "/info" ] );
				served.stop();
			} );

		} );
	}

}
