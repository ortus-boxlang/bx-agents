/**
 * Stands in for ColdBox's controller where an extension is started in a served app: it records the
 * settings set, the schedulers registered and started, and the warnings logged.
 */
class {

	function init() {
		variables.settings = {}
		variables.registered = []
		variables.started = []
		variables.removed = []
		variables.warnings = []
		return this
	}

	function setSetting( required string name, required any value ) {
		variables.settings[ arguments.name ] = arguments.value
		return this
	}

	function settings() {
		return variables.settings
	}

	function registered() {
		return variables.registered
	}

	function started() {
		return variables.started
	}

	function removed() {
		return variables.removed
	}

	function warnings() {
		return variables.warnings
	}

	function getSchedulerService() {
		var me = this
		return {
			loadScheduler : ( name, path ) => {
				me.registered().append( { name : name, path : path } )
				return { startup : () => me.started().append( name ), hasStarted : () => me.started().contains( name ) }
			},
			removeScheduler : ( name ) => me.removed().append( name )
		}
	}

	function getLogBox() {
		var me = this
		return { getLogger : ( target ) => { warn : ( text ) => me.warnings().append( text ), error : ( text ) => me.warnings().append( text ) } }
	}

}
