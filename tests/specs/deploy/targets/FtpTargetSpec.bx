/**
 * Thin wrapper coverage - confirms `FtpTarget` delegates to
 * `BaseFtpTarget.performDeploy()` with `secure: false`. The shared logic
 * itself (connect attribute building, remote file joining, real
 * connection-failure handling) is covered by `BaseFtpTargetSpec.bx`.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "deploy.targets.FtpTarget", function() {

			beforeEach( function() {
				variables.target = new bxagents.models.deploy.targets.FtpTarget();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempDir() {
				var dir = createTempDirectory( prefix = "bxagents-ftptarget-thin-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "throws BxAgents.InvalidDeployConfig when required fields are missing", function() {
				expect( function() {
					target.deploy( {}, { distDir : newTempDir() } );
				} ).toThrow( "BxAgents.InvalidDeployConfig" );
			} );

			it( "requires a password (ftp has no key-based auth)", function() {
				expect( function() {
					target.deploy( { host : "x", username : "y", remotePath : "/z", key : "/some/key" }, { distDir : newTempDir() } );
				} ).toThrow( "BxAgents.InvalidDeployConfig" );
			} );

			it( "attempts a real (secure: false) connection and wraps failure as BxAgents.DeployFailed", function() {
				var dir = newTempDir();
				fileWrite( dir & "/myagent-1.0.0.bxa", "fake bxa content" );

				expect( function() {
					target.deploy(
						{ host : "127.0.0.1", port : 1, username : "user", password : "pass", remotePath : "/uploads", timeout : 2 },
						{ distDir : dir }
					);
				} ).toThrow( "BxAgents.DeployFailed" );
			} );

		} );
	}

}
