/**
 * `buildConnectAttributes()`/`buildRemoteFile()` are pure and tested
 * directly. `performDeploy()` itself IS exercised for real against a
 * genuinely refused local connection (`127.0.0.1` on a port nothing is
 * listening on) - this sandbox has no outbound raw TCP egress at all (only
 * HTTPS through the proxy), so a real successful upload can't be verified
 * here, but a real connection attempt/failure/error-wrapping/cleanup path
 * can be, and is - see docs/known-limitations.md for the honest boundary.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "deploy.targets.BaseFtpTarget", function() {

			beforeEach( function() {
				variables.target = new bxagents.models.deploy.targets.BaseFtpTarget();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempDir() {
				var dir = createTempDirectory( prefix = "bxagents-ftptarget-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "builds a remote file path by joining remotePath and the .bxa's own name", function() {
				expect( target.buildRemoteFile( "/uploads/2025", "myagent-1.0.0.bxa" ) ).toBe( "/uploads/2025/myagent-1.0.0.bxa" );
			} );

			it( "strips a trailing slash from remotePath before joining", function() {
				expect( target.buildRemoteFile( "/uploads/2025/", "myagent-1.0.0.bxa" ) ).toBe( "/uploads/2025/myagent-1.0.0.bxa" );
			} );

			it( "builds ftp connect attributes defaulting port 21 and passive true", function() {
				var attrs = target.buildConnectAttributes( { host : "ftp.example.com", username : "user", password : "pass" }, "conn1", false );

				expect( attrs.server ).toBe( "ftp.example.com" );
				expect( attrs.connection ).toBe( "conn1" );
				expect( attrs.username ).toBe( "user" );
				expect( attrs.password ).toBe( "pass" );
				expect( attrs.port ).toBe( 21 );
				expect( attrs.passive ).toBeTrue();
				expect( attrs.secure ).toBeFalse();
				expect( attrs.timeout ).toBe( 30 );
				expect( attrs.keyExists( "key" ) ).toBeFalse();
			} );

			it( "honors an explicit ftp port, passive, and proxyServer", function() {
				var attrs = target.buildConnectAttributes(
					{ host : "ftp.example.com", username : "user", password : "pass", port : 2121, passive : false, proxyServer : "proxy.company.com:8080" },
					"conn1",
					false
				);

				expect( attrs.port ).toBe( 2121 );
				expect( attrs.passive ).toBeFalse();
				expect( attrs.proxyServer ).toBe( "proxy.company.com:8080" );
			} );

			it( "builds sftp connect attributes defaulting port 22, with a password", function() {
				var attrs = target.buildConnectAttributes( { host : "sftp.example.com", username : "user", password : "pass" }, "conn2", true );

				expect( attrs.port ).toBe( 22 );
				expect( attrs.secure ).toBeTrue();
				expect( attrs.password ).toBe( "pass" );
				expect( attrs.keyExists( "passive" ) ).toBeFalse();
			} );

			it( "builds sftp connect attributes with a key, passphrase, and fingerprint", function() {
				var attrs = target.buildConnectAttributes(
					{
						host        : "sftp.example.com",
						username    : "deploy",
						key         : "/home/me/.ssh/id_rsa",
						passphrase  : "secret",
						fingerprint : "SHA256:abc123"
					},
					"conn2",
					true
				);

				expect( attrs.key ).toBe( "/home/me/.ssh/id_rsa" );
				expect( attrs.passphrase ).toBe( "secret" );
				expect( attrs.fingerprint ).toBe( "SHA256:abc123" );
				expect( attrs.keyExists( "password" ) ).toBeFalse();
			} );

			it( "throws BxAgents.InvalidDeployConfig when host/username/remotePath are missing", function() {
				expect( function() {
					target.performDeploy( {}, { distDir : newTempDir() }, false );
				} ).toThrow( "BxAgents.InvalidDeployConfig" );
			} );

			it( "throws BxAgents.InvalidDeployConfig when ftp has no password", function() {
				expect( function() {
					target.performDeploy( { host : "x", username : "y", remotePath : "/z" }, { distDir : newTempDir() }, false );
				} ).toThrow( "BxAgents.InvalidDeployConfig" );
			} );

			it( "throws BxAgents.InvalidDeployConfig when sftp has neither password nor key", function() {
				expect( function() {
					target.performDeploy( { host : "x", username : "y", remotePath : "/z" }, { distDir : newTempDir() }, true );
				} ).toThrow( "BxAgents.InvalidDeployConfig" );
			} );

			it( "throws BxAgents.NotPackaged when dist/ has no .bxa", function() {
				var dir = newTempDir();
				expect( function() {
					target.performDeploy(
						{ host : "x", username : "y", password : "z", remotePath : "/uploads" },
						{ distDir : dir },
						false
					);
				} ).toThrow( "BxAgents.NotPackaged" );
			} );

			it( "wraps a real connection failure as BxAgents.DeployFailed (genuine refused connection, no server mocked)", function() {
				var dir = newTempDir();
				fileWrite( dir & "/myagent-1.0.0.bxa", "fake bxa content" );

				expect( function() {
					target.performDeploy(
						{ host : "127.0.0.1", port : 1, username : "user", password : "pass", remotePath : "/uploads", timeout : 2 },
						{ distDir : dir },
						false
					);
				} ).toThrow( "BxAgents.DeployFailed" );
			} );

		} );
	}

}
