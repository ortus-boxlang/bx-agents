/**
 * Thin wrapper coverage - confirms `SftpTarget` delegates to
 * `BaseFtpTarget.performDeploy()` with `secure: true`. The shared logic
 * itself (connect attribute building, remote file joining, real
 * connection-failure handling) is covered by `BaseFtpTargetSpec.bx`.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "deploy.targets.SftpTarget", function() {

			beforeEach( function() {
				variables.target = new bxagents.models.deploy.targets.SftpTarget();
				variables.tempDirs = [];
			} );

			afterEach( function() {
				for ( var dir in tempDirs ) {
					if ( directoryExists( dir ) ) {
						directoryDelete( dir, true );
					}
				}
			} );

			private function newTempDir() {
				var dir = createTempDirectory( prefix = "bxagents-sftptarget-thin-" );
				tempDirs.append( dir );
				return dir;
			}

			it( "throws BxAgents.InvalidDeployConfig when required fields are missing", function() {
				expect( function() {
					target.deploy( {}, { distDir : newTempDir() } );
				} ).toThrow( "BxAgents.InvalidDeployConfig" );
			} );

			it( "accepts key-based auth with no password", function() {
				var dir = newTempDir();
				fileWrite( dir & "/myagent-1.0.0.bxa", "fake bxa content" );

				// A real connection attempt with a key (no password) should get
				// PAST the "missing password/key" validation and fail on the
				// actual (refused) connection instead - proving key-only auth is
				// accepted, not silently rejected.
				expect( function() {
					target.deploy(
						{ host : "127.0.0.1", port : 1, username : "user", key : "/home/me/.ssh/id_rsa", remotePath : "/uploads", timeout : 2 },
						{ distDir : dir }
					);
				} ).toThrow( "BxAgents.DeployFailed" );
			} );

			it( "attempts a real (secure: true) connection and wraps failure as BxAgents.DeployFailed", function() {
				var dir = newTempDir();
				fileWrite( dir & "/myagent-1.0.0.bxa", "fake bxa content" );

				expect( function() {
					target.deploy(
						{ host : "127.0.0.1", port : 1, username : "user", password : "pass", remotePath : "/uploads", timeout : 2 },
						{ distDir : dir }
					);
				} ).toThrow( "BxAgents.DeployFailed" );
			} );

		} );
	}

}
