/**
 * The conversation list in the shared chat database.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "SessionStore", function() {

			beforeEach( function() {
				variables.dir = createTempDirectory( prefix = "bxagents-sessions-" );
				variables.sessions = new bxagents.models.store.SessionStore( bxagents.models.store.ChatStore::forFile( dir & "/chat.db" ) );
			} );

			afterEach( function() {
				if ( directoryExists( dir ) ) {
					directoryDelete( dir, true );
				}
			} );

			it( "creates a conversation on the first turn, titled by the first message", function() {
				expect( sessions.touch( "alice", "c1", "  What is   the plan for" & char( 10 ) & "the week? " ) ).toBeTrue();

				var row = sessions.byId( "alice", "c1" );
				expect( row.title ).toBe( "What is the plan for the week?" );
				expect( row.messageCount ).toBe( 2 );
			} );

			it( "records where a conversation started, keeps it, and lists by it", function() {
				sessions.touch( "alice", "w1", "from the page", 2, "web" );
				sessions.touch( "alice", "t1", "from the terminal", 2, "terminal" );
				sessions.touch( "alice", "w1", "later", 2, "api" );

				expect( sessions.byId( "alice", "w1" ).source ).toBe( "web" );
				expect( sessions.list( "alice", 20, "terminal" ).map( ( r ) => r.id ) ).toBe( [ "t1" ] );
				expect( sessions.list( "alice", 20 ) ).toHaveLength( 2 );
			} );

			it( "leaves the source blank when nobody said where it started", function() {
				sessions.touch( "alice", "c9", "hello" );

				expect( sessions.byId( "alice", "c9" ).source ).toBe( "" );
			} );

			it( "counts later turns and keeps the first title", function() {
				sessions.touch( "alice", "c1", "first" );
				sessions.touch( "alice", "c1", "second" );

				var row = sessions.byId( "alice", "c1" );
				expect( row.title ).toBe( "first" );
				expect( row.messageCount ).toBe( 4 );
			} );

			it( "cuts a long title at 60 characters", function() {
				sessions.touch( "alice", "c1", repeatString( "word ", 30 ) );

				var title = sessions.byId( "alice", "c1" ).title;
				expect( len( title ) ).toBe( 60 );
				expect( title ).toMatch( "\.\.\.$" );
			} );

			it( "refuses to touch, read or change a conversation that belongs to someone else", function() {
				sessions.touch( "alice", "c1", "mine" );

				expect( sessions.touch( "bob", "c1", "stolen" ) ).toBeFalse( "touch" );
				expect( sessions.byId( "bob", "c1" ) ).toBeEmpty( "find" );
				expect( sessions.rename( "bob", "c1", "x" ) ).toBeFalse( "rename" );
				expect( sessions.delete( "bob", "c1" ) ).toBeFalse( "delete" );
				expect( sessions.byId( "alice", "c1" ).title ).toBe( "mine" );
			} );

			it( "lists the user's conversations, most recent first", function() {
				sessions.touch( "alice", "c1", "one" );
				sleep( 1100 );
				sessions.touch( "alice", "c2", "two" );
				sessions.touch( "bob", "c3", "other" );

				expect( sessions.list( "alice" ).map( r => r.id ) ).toBe( [ "c2", "c1" ] );
				expect( sessions.latest( "alice" ).id ).toBe( "c2" );
				expect( sessions.latest( "nobody" ) ).toBeEmpty();
			} );

			it( "finds a conversation by its number, its id or the start of its id", function() {
				sessions.touch( "alice", "abc123", "one" );
				sleep( 1100 );
				sessions.touch( "alice", "abd456", "two" );

				expect( sessions.resolve( "alice", "1" ).id ).toBe( "abd456" );
				expect( sessions.resolve( "alice", "2" ).id ).toBe( "abc123" );
				expect( sessions.resolve( "alice", "abc" ).id ).toBe( "abc123" );
				expect( sessions.resolve( "alice", "ab" ) ).toBeEmpty();
				expect( sessions.resolve( "alice", "9" ) ).toBeEmpty();
				expect( sessions.resolve( "alice", "" ) ).toBeEmpty();
			} );

			it( "records the agent a conversation started with and never moves it", function() {
				sessions.touch( "alice", "c1", "to the researcher", 2, "web", "researcher" );
				sessions.touch( "alice", "c1", "later", 2, "web", "writer" );
				sessions.touch( "alice", "c2", "to the main agent" );

				expect( sessions.byId( "alice", "c1" ).agent ).toBe( "researcher" );
				expect( sessions.byId( "alice", "c2" ).agent ).toBe( "" );
			} );

			describe( "search", function() {

				beforeEach( function() {
					for ( var n = 1; n <= 30; n++ ) {
						sessions.touch( "alice", "w#n#", "web chat #n# about cats", 2, "web", n % 3 == 0 ? "researcher" : "" );
					}
					sessions.touch( "alice", "t1", "terminal 50% done_", 2, "terminal" );
					sessions.touch( "bob", "b1", "bobs", 2, "web" );
				} );

				it( "pages with the total of everything that matches", function() {
					var first = sessions.search( "alice", { limit : 10 } );
					var second = sessions.search( "alice", { limit : 10, offset : 10 } );

					expect( first.rows ).toHaveLength( 10 );
					expect( first.total ).toBe( 31 );
					expect( first.limit ).toBe( 10 );
					expect( second.offset ).toBe( 10 );
					expect( second.rows.map( r => r.id ) ).notToInclude( first.rows[ 1 ].id );
				} );

				it( "caps the page at 100 and defaults to 25", function() {
					expect( sessions.search( "alice" ).rows ).toHaveLength( 25 );
					expect( sessions.search( "alice", { limit : 5000 } ).limit ).toBe( 100 );
					expect( sessions.search( "alice", { limit : 0 } ).limit ).toBe( 1 );
				} );

				it( "filters by title text, treating % and _ as plain characters", function() {
					expect( sessions.search( "alice", { q : "CATS" } ).total ).toBe( 30 );
					expect( sessions.search( "alice", { q : "50%" } ).total ).toBe( 1 );
					expect( sessions.search( "alice", { q : "done_" } ).total ).toBe( 1 );
					expect( sessions.search( "alice", { q : "%" } ).total ).toBe( 1 );
					expect( sessions.search( "alice", { q : "nothing here" } ).total ).toBe( 0 );
				} );

				it( "filters by source and by agent, the main agent by name too", function() {
					expect( sessions.search( "alice", { source : "terminal" } ).total ).toBe( 1 );
					expect( sessions.search( "alice", { agent : "researcher" } ).total ).toBe( 10 );
					expect( sessions.search( "alice", { agent : "nanobox", mainAgent : "nanobox" } ).total ).toBe( 21 );
					expect( sessions.search( "alice", { agent : "researcher", source : "terminal" } ).total ).toBe( 0 );
				} );

				it( "filters by date", function() {
					var past = dateTimeFormat( dateAdd( "d", -1, now() ), "yyyy-MM-dd'T'HH:mm:ss" );
					var future = dateTimeFormat( dateAdd( "d", 1, now() ), "yyyy-MM-dd'T'HH:mm:ss" );

					expect( sessions.search( "alice", { since : past } ).total ).toBe( 31 );
					expect( sessions.search( "alice", { since : future } ).total ).toBe( 0 );
					expect( sessions.search( "alice", { before : past } ).total ).toBe( 0 );
					expect( sessions.search( "alice", { before : future } ).total ).toBe( 31 );
				} );

				it( "never reaches another user's rows unless asked for everyone's", function() {
					expect( sessions.search( "alice", { q : "bobs" } ).total ).toBe( 0 );
					expect( sessions.search( "", { q : "bobs" } ).rows[ 1 ].userId ).toBe( "bob" );
					expect( sessions.search( "" ).total ).toBe( 32 );
				} );

				it( "counts each facet with every filter but its own", function() {
					var counts = sessions.facets( "alice", { source : "web", agent : "researcher" } );

					expect( counts.source.web ).toBe( 10 );
					expect( counts.source.keyExists( "terminal" ) ).toBeFalse();
					expect( counts.agent.researcher ).toBe( 10 );
					expect( counts.agent[ "" ] ).toBe( 20 );
				} );

			} );

			it( "renames, resets the count and deletes", function() {
				sessions.touch( "alice", "c1", "one" );

				expect( sessions.rename( "alice", "c1", "Renamed" ) ).toBeTrue();
				sessions.resetCount( "alice", "c1" );
				expect( sessions.byId( "alice", "c1" ).title ).toBe( "Renamed" );
				expect( sessions.byId( "alice", "c1" ).messageCount ).toBe( 0 );
				expect( sessions.delete( "alice", "c1" ) ).toBeTrue();
				expect( sessions.byId( "alice", "c1" ) ).toBeEmpty();
			} );

		} );
	}

}
