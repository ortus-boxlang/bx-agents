/**
 * Proves the TestBox harness itself works, and that the module descriptor
 * (src/main/bx/ModuleConfig.bx) is a valid, loadable BoxLang class.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "BX Agents module descriptor", function() {

			it( "loads ModuleConfig.bx without errors and exposes core properties", function() {
				var moduleConfig = new bxagents.ModuleConfig();

				expect( moduleConfig.mapping ).toBe( "bxagents" );
				expect( moduleConfig.enabled ).toBeTrue();
				expect( len( moduleConfig.description ) ).toBeGT( 0 );
				expect( moduleConfig.dependencies ).toBeArray();
			} );

			it( "runs configure() without throwing", function() {
				var moduleConfig = new bxagents.ModuleConfig();

				expect( function() {
					moduleConfig.configure();
				} ).notToThrow();
			} );

		} );
	}

}
