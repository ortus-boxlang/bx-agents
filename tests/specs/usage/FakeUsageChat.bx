/**
 * A chat that answers usageReport() with what the spec gave it, for the /stats command.
 */
class {

	function init( required struct answer ) {
		variables.answer = arguments.answer
		variables.asked = []
		return this
	}

	struct function usageReport( numeric days = 30, string by = "model" ) {
		variables.asked.append( { days : arguments.days, by : arguments.by } )
		return variables.answer
	}

	array function asked() {
		return variables.asked
	}

}
