/**
 * The few things of bx-ai's chat request that the usage recorder reads, for a spec.
 */
class {

	function init( string userId = "", string threadId = "", string provider = "" ) {
		variables.userId = arguments.userId
		variables.threadId = arguments.threadId
		variables.provider = arguments.provider
		return this
	}

	string function getUserId() {
		return variables.userId
	}

	string function getThreadId() {
		return variables.threadId
	}

	string function getProvider() {
		return variables.provider
	}

}
