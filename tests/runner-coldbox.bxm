<bx:script>
	/**
	 * HTTP-servable TestBox runner for the ColdBox-dependent integration
	 * specs (tests/specs/integration/coldbox/**). Must be hit via a real HTTP
	 * request (through boxlang-miniserver) rather than the CLI runTests.bxs
	 * script: booting a real ColdBox app requires a genuine `cgi` scope,
	 * which only exists inside an actual web request - confirmed this
	 * session (a bare CLI script has no `cgi` scope at all, which ColdBox's
	 * RoutingService needs even just to load the router at startup).
	 *
	 * Outputs a JSON report in the shape runColdBoxIntegrationTests.bxs
	 * parses, as the raw HTTP response body.
	 *
	 * WHY NOT TestBox's own JSONReporter: it serializes the whole result
	 * memento, and these specs resolve real ColdBox/WireBox/qb singletons.
	 * Those live objects reach the serializer, which reflects over them
	 * (`StructUtil.objectToStruct` -> `DynamicInteropService.getMethodNames`)
	 * and follows their cyclic references until the JVM throws
	 * StackOverflowError - confirmed in CI, after the specs themselves had
	 * already run green. So the report is assembled here from scalars only:
	 * every value written into it is forced through toScalar() below, so no
	 * object can get into it no matter what a spec leaves behind.
	 *
	 * PROGRESS MARKERS: each stage appends to runner-progress.txt before it
	 * starts. When this page fails or hangs the response body may never
	 * arrive, so the file is the only record of how far it got. The
	 * orchestrator prints it, and CI dumps it too.
	 *
	 * Four rules below are load-bearing, each paid for by a CI cycle. See
	 * docs/known-limitations.md.
	 *
	 * 1. `char()`, NEVER `chr()`. `chr()` does not exist in BoxLang, in any
	 *    context. It parses fine and throws at runtime, so it survives
	 *    review - this page 500'd on every request because of one `chr( 10 )`.
	 *
	 * 2. `HH:mm:ss`, NEVER `HH:nn:ss`. In a BoxLang time mask `nn` is
	 *    NANOSECONDS, not minutes, and silently emits timestamps like
	 *    `02:777491298:32` that look corrupt rather than wrong.
	 *
	 * 3. APPEND ONLY, NEVER TRUNCATE, and one request only. This page used to
	 *    truncate its own marker file on entry while the orchestrator retried
	 *    once a second - so later attempts erased what the failing first
	 *    attempt recorded, and the diagnostics printed an empty file.
	 *
	 * 4. THE WORK LIVES IN NAMED FUNCTIONS and nothing closes over an
	 *    unscoped outer variable. A top-level try/catch has produced
	 *    `java.lang.VerifyError` in this project before. Diagnostics that can
	 *    themselves fail are worse than none: they fail silently and replace
	 *    the fault they exist to describe.
	 */

	/**
	 * Force any value to something safe to put in the report. Anything that
	 * is not a simple value becomes a short type description rather than
	 * being serialized - this is the guard that keeps a live ColdBox/WireBox
	 * object out of the JSON, which is what blew the stack before.
	 */
	string function toScalar( any value ) {
		try {
			if ( isNull( arguments.value ) ) {
				return "";
			}
			if ( isSimpleValue( arguments.value ) ) {
				// Concatenation rather than toString() - it coerces without
				// depending on a BIF name, and this file has already been
				// burned once by assuming a BIF exists.
				return "" & arguments.value;
			}
			if ( isArray( arguments.value ) ) {
				return "[array of #arrayLen( arguments.value )#]";
			}
			return "[non-simple value]";
		} catch ( any e ) {
			return "[unreadable value]";
		}
	}

	string function markProgress( required string progressFile, required string attemptID, required string stage ) {
		fileAppend(
			arguments.progressFile,
			"[#dateTimeFormat( now(), 'HH:mm:ss' )#] #arguments.attemptID# #arguments.stage##char( 10 )#"
		);
		return arguments.stage;
	}

	/**
	 * Walk the TestBox result into a plain, scalar-only struct matching what
	 * runColdBoxIntegrationTests.bxs reads. The orchestrator falls back to
	 * `specStat.error.message` when `failMessage` is absent, so errors are
	 * folded into failMessage here and that fallback simply never fires.
	 */
	struct function buildScalarReport( required any results ) {
		var report = {
			"totalBundles" : arguments.results.getTotalBundles(),
			"totalSuites"  : arguments.results.getTotalSuites(),
			"totalSpecs"   : arguments.results.getTotalSpecs(),
			"totalPass"    : arguments.results.getTotalPass(),
			"totalFail"    : arguments.results.getTotalFail(),
			"totalError"   : arguments.results.getTotalError(),
			"totalSkipped" : arguments.results.getTotalSkipped(),
			"bundleStats"  : []
		};

		for ( var bundleStat in arguments.results.getBundleStats() ) {
			var bundle = { "name": toScalar( bundleStat.name ?: "" ), "suiteStats": [] };

			for ( var suiteStat in ( bundleStat.suiteStats ?: [] ) ) {
				var suite = { "name": toScalar( suiteStat.name ?: "" ), "specStats": [] };

				for ( var specStat in ( suiteStat.specStats ?: [] ) ) {
					var failMessage = toScalar( specStat.failMessage ?: "" );
					// structKeyExists, not `isNull( specStat.error )` - the
					// latter has to evaluate the key to test it, which throws
					// when the key is simply absent.
					if ( !len( failMessage ) && structKeyExists( specStat, "error" ) ) {
						failMessage = toScalar( specStat.error.message ?: "" )
							& " " & toScalar( specStat.error.detail ?: "" );
					}
					suite.specStats.append( {
						"name"        : toScalar( specStat.name ?: "" ),
						"status"      : toScalar( specStat.status ?: "" ),
						"failMessage" : trim( failMessage )
					} );
				}

				bundle.suiteStats.append( suite );
			}

			report.bundleStats.append( bundle );
		}

		return report;
	}

	string function runIntegrationSpecs( required string progressFile, required string attemptID ) {
		try {
			markProgress( arguments.progressFile, arguments.attemptID, "constructing TestBox over tests.specs.integration.coldbox" );
			var testbox = new testbox.system.TestBox( directory = { mapping: "tests.specs.integration.coldbox", recurse: true } );

			markProgress( arguments.progressFile, arguments.attemptID, "running specs" );
			var results = testbox.runRaw();

			// Recorded BEFORE the report is built, so that even if assembling
			// or serializing it blows up, the marker file still says whether
			// the specs themselves passed. That distinction was invisible for
			// several CI cycles.
			markProgress(
				arguments.progressFile,
				arguments.attemptID,
				"specs finished - pass=#results.getTotalPass()# fail=#results.getTotalFail()# error=#results.getTotalError()# skipped=#results.getTotalSkipped()#"
			);

			markProgress( arguments.progressFile, arguments.attemptID, "building scalar JSON report" );
			return jsonSerialize( buildScalarReport( results ) );
		} catch ( any e ) {
			// Without this, an exception reaches the orchestrator as a bare
			// "HTTP 500" with no cause anywhere. Record it alongside the
			// markers, then rethrow so the run still fails.
			markProgress(
				arguments.progressFile,
				arguments.attemptID,
				"THREW [#e.type#] #e.message# #( e.detail ?: '' )##char( 10 )##( e.stackTrace ?: '' )#"
			);
			rethrow;
		}
	}

	progressFile = expandPath( "/" ) & "runner-progress.txt";
	attemptID    = createUUID();

	markProgress( progressFile, attemptID, "page entered" );
	jsonReport = runIntegrationSpecs( progressFile, attemptID );

	markProgress( progressFile, attemptID, "writing response" );
	bx:header name="Content-Type" value="application/json";
	writeOutput( jsonReport );
	markProgress( progressFile, attemptID, "done" );
</bx:script>
