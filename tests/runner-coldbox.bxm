<bx:script>
	/**
	 * HTTP-servable TestBox runner for the ColdBox-dependent integration
	 * specs (tests/specs/integration/coldbox/**). Must be hit via a real HTTP
	 * request (through boxlang-miniserver) rather than the CLI runTests.bxs
	 * script: booting a real ColdBox app requires a genuine `cgi` scope,
	 * which only exists inside an actual web request - confirmed this
	 * session (a bare CLI script has no `cgi` scope at all, which ColdBox's
	 * RoutingService needs even just to load the router at startup).
	 *
	 * Outputs the same TestBox JSON report shape runTests.bxs writes to disk,
	 * as the raw HTTP response body, for the calling orchestration script to
	 * fetch and parse.
	 *
	 * PROGRESS MARKERS: each stage appends to runner-progress.txt before it
	 * starts. When this page hangs the response never arrives, so the log says
	 * only "never responded" and nothing about where it stopped - the file is
	 * readable from outside the request and pins that down. The orchestrator
	 * prints it on timeout. Cheap, and the only way to see inside a request
	 * that never returns.
	 *
	 * Three rules below are load-bearing, each one paid for by a wasted CI
	 * cycle. See docs/known-limitations.md.
	 *
	 * 1. APPEND ONLY, NEVER TRUNCATE. This page used to open with
	 *    fileWrite( progressFile, "" ), and the orchestrator used to retry the
	 *    request once a second - so a later attempt truncated away everything
	 *    the hung earlier attempt had recorded, and the markers came back
	 *    EMPTY, saying nothing at all. The orchestrator now clears the file
	 *    once before its single request, and every write here is an append.
	 *
	 * 2. THE WORK LIVES IN A NAMED FUNCTION, not at the top level. A try/catch
	 *    written directly at the top level of a script has produced
	 *    `java.lang.VerifyError: Inconsistent stackmap frames` in this project
	 *    before; wrapping it in a function is the known-good shape.
	 *
	 * 3. NOTHING CLOSES OVER AN UNSCOPED OUTER VARIABLE. The progress path is
	 *    passed in as an argument. Diagnostics that can themselves fail are
	 *    worse than no diagnostics, because they fail silently and replace the
	 *    fault they exist to describe.
	 */
	string function markProgress( required string progressFile, required string attemptID, required string stage ) {
		fileAppend(
			arguments.progressFile,
			"[#dateTimeFormat( now(), 'HH:nn:ss' )#] #arguments.attemptID# #arguments.stage##chr( 10 )#"
		);
		return arguments.stage;
	}

	string function runIntegrationSpecs( required string progressFile, required string attemptID ) {
		try {
			markProgress( arguments.progressFile, arguments.attemptID, "constructing TestBox over tests.specs.integration.coldbox" );
			var testbox = new testbox.system.TestBox( directory = { mapping: "tests.specs.integration.coldbox", recurse: true } );

			markProgress( arguments.progressFile, arguments.attemptID, "running specs" );
			var results = testbox.runRaw();

			markProgress( arguments.progressFile, arguments.attemptID, "building JSON report" );
			var jsonReporter = new testbox.system.reports.JSONReporter();
			return jsonReporter.runReport( results, testbox, {}, true );
		} catch ( any e ) {
			// Without this, an exception reaches the orchestrator as a bare
			// "HTTP 500" with no cause anywhere. Record it alongside the
			// markers, then rethrow so the run still fails.
			markProgress(
				arguments.progressFile,
				arguments.attemptID,
				"THREW #e.type#: #e.message# #( e.detail ?: '' )##chr( 10 )##( e.stackTrace ?: '' )#"
			);
			rethrow;
		}
	}

	progressFile = expandPath( "/" ) & "runner-progress.txt";
	attemptID    = createUUID();

	markProgress( progressFile, attemptID, "page entered" );
	jsonReport = runIntegrationSpecs( progressFile, attemptID );

	markProgress( progressFile, attemptID, "writing response" );
	bx:header name="Content-Type" value="application/json";
	writeOutput( jsonReport );
	markProgress( progressFile, attemptID, "done" );
</bx:script>
