/**
 * A tool written the way a project writes one: an @AITool method that reads a vault secret for the person asking.
 */
class {

	@AITool( "Reads the newest mail." )
	function inbox( string query = "" ) {
		var token = vault( "MAIL_TOKEN", arguments, "mail.example.com" )
		return "token-length:" & len( token )
	}

}
