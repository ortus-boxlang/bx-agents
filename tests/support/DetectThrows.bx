/**
 * A stand-in Agent.bx whose `detectEnvironment()` throws - a real bug in a
 * project's own code, which EnvironmentResolver surfaces rather than swallows.
 */
class {

	/**
	 * @throws BxAgents.FixtureBoom Always
	 *
	 * @return Never returns
	 */
	string function detectEnvironment() {
		throw( type = "BxAgents.FixtureBoom", message = "boom from detectEnvironment" );
	}

}
