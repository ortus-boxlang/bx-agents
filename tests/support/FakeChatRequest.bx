/**
 * Stands in for bx-ai's AiChatRequest where a spec only needs to know who the run belongs to.
 */
class {

	property name="userId" default="";

	/**
	 * @userId The person the run belongs to
	 *
	 * @return This request
	 */
	function init( string userId = "" ) {
		variables.userId = arguments.userId
		return this
	}

	/**
	 * @return The person the run belongs to
	 */
	string function getUserId() {
		return variables.userId
	}

}
