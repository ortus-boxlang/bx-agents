/**
 * A stand-in Agent.bx that declares a `detectEnvironment()` returning whatever
 * the test set on it - the tier-1 environment hook EnvironmentResolver honors.
 */
class {

	variables.value = "";

	/**
	 * @value What detectEnvironment() should return
	 */
	void function setValue( required string value ) {
		variables.value = arguments.value;
	}

	/**
	 * @return The configured environment name
	 */
	string function detectEnvironment() {
		return variables.value;
	}

}
