/**
 * Test application context for the BX Agents module's TestBox suite.
 * Provides mappings so specs can instantiate module source classes directly
 * (e.g. `new bxagents.models.build.ProjectDiscoverer()`) without requiring
 * full BoxLang module registration.
 */
class {

	this.name					= "bxagents-tests";
	this.sessionManagement		= false;
	this.setClientCookies		= false;

	this.mappings[ "/bxagents" ]	= expandPath( "./../src/main/bx" );
	this.mappings[ "/tests" ]		= expandPath( "./" );
	this.mappings[ "/testbox" ]	= expandPath( "./../testbox" );
	this.mappings[ "/fixtures" ]	= expandPath( "./../src/test/resources/fixtures" );
	this.mappings[ "/libs" ]		= expandPath( "./../src/test/resources/libs" );

}
