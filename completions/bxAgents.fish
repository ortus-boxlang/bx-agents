# Tab completion for bxAgents, for fish.
# Generated by tools/generate-completions.bxs from the verb tables in ModuleConfig.bx, do not edit.
# Install it with:  cp <module folder>/completions/bxAgents.fish ~/.config/fish/completions/

function __bxagents_needs_verb
    set -l words (commandline -opc)
    test (count $words) -eq 1
end

function __bxagents_using_verb
    set -l words (commandline -opc)
    test (count $words) -ge 2; and test "$words[2]" = "$argv[1]"
end

# the file is loaded for bxAgents; bxagents gets the same completions
