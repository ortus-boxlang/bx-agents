{
	"mappings": {
		"/bxagents": "${user-dir}/src/main/bx",
		"/tests": "${user-dir}/tests",
		"/tools": "${user-dir}/tools",
		"/fixtures": "${user-dir}/src/test/resources/fixtures",
		"/libs": "${user-dir}/src/test/resources/libs",
		"/testbox": "${user-dir}/build/lib-stage/lib/testbox",
		"/coldbox": "${user-dir}/build/lib-stage/lib/coldbox",
		"/cbsecurity": "${user-dir}/build/lib-stage/lib/modules/cbsecurity"
	},
	"classPaths": [
		"${user-dir}/build/classes/java/main"
	],
	// SSE frames are terminated by a BLANK line, which whitespace compression collapses. Measured on 1.19.0 (on and off): a native
	// SSE() stream is unaffected (14 terminators, 14 frames, 8 deltas both ways); only a hand-written writeOutput stream loses its
	// terminators with it on (0 against 3). Off here as a safety net, the same line the vendored runtime/boxlang.json of a built app
	// patches (see src/main/bx/templates/coldbox-boxlang/VERSION).
	"whitespaceCompressionEnabled": false,
	"modulesDirectory": [
		"${user-dir}/build/modules"
	]
}
