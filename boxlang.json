{
	"mappings": {
		"/bxagents": "${user-dir}/src/main/bx",
		"/tests": "${user-dir}/tests",
		"/tools": "${user-dir}/tools",
		"/fixtures": "${user-dir}/src/test/resources/fixtures",
		"/libs": "${user-dir}/src/test/resources/libs",
		"/testbox": "${user-dir}/build/lib-stage/lib/testbox",
		"/coldbox": "${user-dir}/build/lib-stage/lib/coldbox"
	},
	"classPaths": [
		"${user-dir}/build/classes/java/main"
	],
	// SSE frames are terminated by a BLANK line. The web runtime's whitespace
	// compression collapses consecutive newlines, which eats those terminators
	// and leaves an unparseable stream - measured: with it on, a /stream body
	// carried zero occurrences of \n\n and http().sse( true ) reported
	// totalEvents: 0. Serve.bx sets the same directive for served projects.
	"whitespaceCompressionEnabled": false,
	"modulesDirectory": [
		"${user-dir}/build/modules"
	]
}
