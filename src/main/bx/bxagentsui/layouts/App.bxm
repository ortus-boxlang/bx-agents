<!--- The frame of every page: the left menu, the header and the page. As in cbGenesis, the parts are partials under
      views/_components/app, and the page itself is #view()#. Alpine starts the session store (appShell), so the menu
      shows only what this person may use. --->
<bx:output>
<!doctype html>
<html lang="en">
<head>#view( view = "_components/app/includes", module = "bxagentsui" )#</head>
<body x-data="appShell" :data-nav="$store.nav.folded ? 'folded' : 'open'" :class="{ 'nav-open': $store.nav.open }">
	#view( view = "_components/app/sprite", module = "bxagentsui" )#
	<a class="skip-link" href="##content">Skip to content</a>
	<div id="app">
		#view( view = "_components/app/sidebar", module = "bxagentsui" )#
		<div id="navScrim" aria-hidden="true" @click="$store.nav.open = false"></div>
		<div id="frame">
			#view( view = "_components/app/topbar", module = "bxagentsui" )#
			<main id="content" tabindex="-1">
				#view()#
			</main>
		</div>
	</div>
	#view( view = "_components/ui/toasts", module = "bxagentsui" )#
	#view( view = "_components/ui/confirm", module = "bxagentsui" )#
	#view( view = "_components/app/password", module = "bxagentsui" )#
	<!--- the extensions' scripts, deferred: they run after the app's own module script, so window.bxagents is there --->
	<bx:loop array="#prc.ui.extensionScripts ?: []#" item="href"><script defer src="#encodeForHTML( href )#"></script></bx:loop>
</body>
</html>
</bx:output>
