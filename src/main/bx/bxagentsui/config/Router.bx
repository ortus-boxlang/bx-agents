/**
 * The pages of the web app, relative to where the agent mounts the module. One route per page, as in cbGenesis.
 */
class {

	/**
	 * Declares the routes, the catch-all last so every other route wins.
	 */
	function configure() {
		// what the generated app answers under the same path (see Forward): sign in, sign out, extension files
		// /login.html reaches here as /login (ColdBox reads the extension as the format): GET is the form, POST its target
		route( "/login" ).withAction( { GET : "form", POST : "login" } ).toHandler( "Forward" )
		route( "/logout" ).to( "Forward.logout" )
		get( "/ext/:extension/:file-regex:(.+)" ).to( "Forward.extension" )
		route( "/" ).to( "Main.index" )
		// every partial and magic on one page, in a dev build only (see Main.kit)
		route( "/_kit" ).to( "Main.kit" )
		route( "/settings" ).to( "Settings.index" )
		route( "/gateways" ).to( "Gateways.index" )
		route( "/embeds" ).to( "Embeds.index" )
		route( "/logs/:area-regex:(agent|gateways|routines|heartbeat|api)" ).to( "Logs.index" )
		route( "/logs" ).to( "Logs.index" )
		route( "/data" ).to( "Data.index" )
		route( "/access/:tab-regex:(tokens|people)" ).to( "Access.index" )
		route( "/access" ).to( "Access.index" )
		route( "/registry/:tab-regex:(tools|skills|volumes)" ).to( "Registry.index" )
		route( "/registry" ).to( "Registry.index" )
		route( "/vault" ).to( "Vault.index" )
		route( "/conversations" ).to( "Conversations.index" )
		route( "/memory" ).to( "Memory.index" )
		route( "/agent/:tab-regex:(composition|files|usage)" ).to( "Agent.index" )
		route( "/agent" ).to( "Agent.index" )
		route( "/routines" ).to( "Routines.index" )
		route( "/connectors/:tab-regex:(all|connected|attention|agent)" ).to( "Connectors.index" )
		route( "/connectors" ).to( "Connectors.index" )
		// anything else under the app is a page it does not have: 404, rather than ColdBox's convention route looking for a
		// handler of that name (which answered 500)
		route( "/:missing-regex:(.+)" ).to( "Main.missing" )
	}

}
