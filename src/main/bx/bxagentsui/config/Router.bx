/**
 * The pages of the web app, relative to where the agent mounts the module. One route per page, as in cbGenesis.
 */
class {

	function configure() {
		route( "/" ).to( "Main.index" )
		// every partial and magic on one page, in a dev build only (see Main.kit)
		route( "/_kit" ).to( "Main.kit" )
		route( "/settings" ).to( "Settings.index" )
		route( "/gateways" ).to( "Gateways.index" )
		route( "/logs/:area-regex:(agent|gateways|routines|heartbeat|api)" ).to( "Logs.index" )
		route( "/logs" ).to( "Logs.index" )
		route( "/data" ).to( "Data.index" )
		route( "/access/:tab-regex:(tokens|people)" ).to( "Access.index" )
		route( "/access" ).to( "Access.index" )
		route( "/registry/:tab-regex:(tools|skills|volumes)" ).to( "Registry.index" )
		route( "/registry" ).to( "Registry.index" )
		route( "/vault" ).to( "Vault.index" )
		route( "/conversations" ).to( "Conversations.index" )
		route( "/memory" ).to( "Memory.index" )
		route( "/agent/:tab-regex:(composition|files|usage)" ).to( "Agent.index" )
		route( "/agent" ).to( "Agent.index" )
		// the pages still on the current page, until each moves here
		route( "/:page-regex:(routines|connectors)" ).to( "Main.page" )
	}

}
