/**
 * The pages of the web app, relative to where the agent mounts the module. One route per page, as in cbGenesis.
 */
class {

	function configure() {
		route( "/" ).to( "Main.index" )
		route( "/:page-regex:(conversations|routines|registry|connectors|memory|vault|settings|agent|gateways|logs|access|data)" ).to( "Main.page" )
	}

}
