/**
 * The pages of the web app. Each page is a view, its data comes from the agent API (/__bxagents) through its Alpine
 * component, so these actions only pick the view and the title.
 */
class extends="BaseHandler" {

	/**
	 * The chat.
	 */
	function index( event, rc, prc ) {
		prc.page = variables.menu.find( "chat" )
		event.setView( view = "main/index", module = "bxagentsui" )
	}

	/**
	 * Every partial and magic of the web app on one page, to look at and to test against. Only in a dev build
	 * (BXAGENTS_UI_LINK, see WebAppModule): a built agent answers 404.
	 */
	function kit( event, rc, prc ) {
		if ( !prc.ui.kit ) {
			event.renderData( type = "plain", data = "Not found", statusCode = 404 )
			return
		}
		prc.page = { id : "_kit", title : "Kit", icon : "squares-four", group : "main", capability : "" }
		event.setView( view = "main/kit", module = "bxagentsui" )
	}

	/**
	 * An address under the app that is none of its pages.
	 *
	 * @event The request context
	 * @rc The request collection
	 * @prc The private request collection
	 */
	function missing( event, rc, prc ) {
		event.renderData( type = "plain", data = "Not found", statusCode = 404 )
	}

}
