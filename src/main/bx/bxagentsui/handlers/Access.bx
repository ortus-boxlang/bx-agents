/**
 * Access (admin): tokens for the API, and the people who can sign in.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component (components/admin/AccessPage.js).
	 */
	function index( event, rc, prc ) {
		// the tab to open, from the address: /access/people
		prc.access = { tab : rc.tab ?: "" }
		showPage( event, prc, "access", "access/index" )
	}

}
