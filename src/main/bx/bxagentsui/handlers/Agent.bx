/**
 * Agent (admin): how the agent is put together, its files (read only) and its usage.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component (components/admin/AgentPage.js).
	 */
	function index( event, rc, prc ) {
		// the tab to open, from the address: /agent/usage
		prc.agentPage = { tab : rc.tab ?: "composition" }
		showPage( event, prc, "agent", "agent/index" )
	}

}
