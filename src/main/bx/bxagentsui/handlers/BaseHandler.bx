/**
 * What every page of the web app does first: asks for a signed in person when the agent has accounts, picks the layout and
 * hands the settings and the menu to the views.
 */
class {

	property name="menu" inject="Menu@bxagentsui";

	/**
	 * Runs before every action.
	 *
	 * @event The request context
	 * @rc The request collection
	 * @prc The private request collection
	 */
	function preHandler( event, rc, prc ) {
		prc.ui = getModuleSettings( "bxagentsui" )
		prc.user = { label : "", admin : false, signedIn : false }
		if ( prc.ui.signIn ) {
			var security = getInstance( "cbSecurity@cbSecurity" )
			if ( !security.isLoggedIn() ) {
				// to the sign-in form, as it is (relocate() would rewrite the address as an event)
				event.setHTTPHeader( statusCode = 302, statusText = "Found" )
				event.setHTTPHeader( name = "Location", value = prc.ui.loginUrl )
				event.noExecution()
				event.noRender()
				return
			}
			var user = security.getUser()
			prc.user = { label : user.getLabel(), admin : user.isAdmin(), signedIn : true }
		}
		prc.menu = variables.menu.groups()
		event.setLayout( name = "App", module = "bxagentsui" )
	}

	/**
	 * Shows a page of the menu with its view, or answers 404 for an unknown page and 403 for an admin page to anybody
	 * else. Every page action ends here, so the rule lives in one place.
	 *
	 * @event The request context
	 * @prc The private request collection
	 * @id The page's id in the menu
	 * @view The view to show, in this module
	 */
	function showPage( event, prc, required string id, required string view ) {
		prc.page = variables.menu.find( arguments.id )
		if ( !prc.page.count() ) {
			event.renderData( type = "plain", data = "Not found", statusCode = 404 )
			return
		}
		if ( prc.page.group == "admin" && prc.ui.signIn && !prc.user.admin ) {
			event.setHTTPHeader( statusCode = 403, statusText = "Forbidden" )
			event.setView( view = "main/forbidden", module = "bxagentsui" )
			return
		}
		event.setView( view = arguments.view, module = "bxagentsui" )
	}

}
