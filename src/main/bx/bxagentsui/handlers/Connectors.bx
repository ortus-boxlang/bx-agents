/**
 * Connectors: the services the agent can use for a person, each connected with their own token or sign in.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component
	 * (components/connectors/ConnectorsPage.js).
	 */
	function index( event, rc, prc ) {
		// the tab to open, from the address: /connectors/connected
		prc.connectors = { tab : rc.tab ?: "all" }
		showPage( event, prc, "connectors", "connectors/index" )
	}

}
