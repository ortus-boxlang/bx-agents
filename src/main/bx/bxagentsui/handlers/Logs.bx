/**
 * Logs (admin): one tab per area, a level filter, a search and a tail.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component (components/admin/LogsPage.js).
	 */
	function index( event, rc, prc ) {
		// the area to open and a search to start with, as the Gateways page links them: /logs/gateways?q=slack
		prc.logs = { area : rc.area ?: "agent", query : rc.q ?: "" }
		showPage( event, prc, "logs", "logs/index" )
	}

}
