/**
 * Gateways (admin): the chat services the agent talks through.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component (components/admin/GatewaysPage.js).
	 */
	function index( event, rc, prc ) {

		showPage( event, prc, "gateways", "gateways/index" )
	}

}
