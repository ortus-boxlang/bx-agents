/**
 * Vault: secrets the agent can use. A value is typed once and never comes back.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component (components/vault/VaultPage.js).
	 * When the agent asks for a secret (the vault_request tool) the chat sends the person here with the ask in the
	 * address: /vault?ask=GITHUB_TOKEN&scope=user&why=To+read+your+issues
	 */
	function index( event, rc, prc ) {
		prc.vault = { ask : rc.ask ?: "", scope : rc.scope ?: "", why : rc.why ?: "" }
		showPage( event, prc, "vault", "vault/index" )
	}

}
