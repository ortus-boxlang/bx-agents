/**
 * Data and backups (admin): where the agent keeps everything, and backups of it.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component (components/admin/DataPage.js).
	 */
	function index( event, rc, prc ) {

		showPage( event, prc, "data", "data/index" )
	}

}
