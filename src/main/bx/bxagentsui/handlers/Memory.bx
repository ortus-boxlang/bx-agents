/**
 * Memory: what the agent keeps about you, the notes every agent shares, and the memory of conversations.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component (components/memory/MemoryPage.js).
	 */
	function index( event, rc, prc ) {
		showPage( event, prc, "memory", "memory/index" )
	}

}
