/**
 * Embeds (admin): the agent on other websites, for anonymous visitors. Defined here, pasted there.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component (components/admin/EmbedsPage.js).
	 */
	function index( event, rc, prc ) {

		showPage( event, prc, "embeds", "embeds/index" )
	}

}
