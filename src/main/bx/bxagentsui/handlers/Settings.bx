/**
 * Settings: how the page looks, which model answers, the extensions and the server.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component (components/settings/SettingsPage.js).
	 */
	function index( event, rc, prc ) {

		showPage( event, prc, "settings", "settings/index" )
	}

}
