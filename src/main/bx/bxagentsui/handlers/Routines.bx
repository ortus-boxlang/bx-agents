/**
 * Routines: scheduled work. A person sees their own; an admin sees everyone's.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component (components/routines/RoutinesPage.js).
	 */
	function index( event, rc, prc ) {
		showPage( event, prc, "routines", "routines/index" )
	}

}
