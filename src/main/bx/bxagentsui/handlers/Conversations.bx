/**
 * Conversations: the whole list, paged and filtered by the server.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component
	 * (components/conversations/ConversationsPage.js). Filters can start from the address: ?q=, ?source=, ?agent=.
	 */
	function index( event, rc, prc ) {
		prc.conversations = { q : rc.q ?: "", source : rc.source ?: "", agent : rc.agent ?: "", hasSource : structKeyExists( rc, "source" ) }
		showPage( event, prc, "conversations", "conversations/index" )
	}

}
