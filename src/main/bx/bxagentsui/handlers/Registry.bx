/**
 * Registry: the agent's tools, the skills it can load, and the folders it may read and write.
 */
class extends="BaseHandler" {

	/**
	 * The page. Its data comes from the agent API through its Alpine component (components/registry/RegistryPage.js).
	 */
	function index( event, rc, prc ) {
		// the tab to open, from the address: /registry/skills
		prc.registry = { tab : rc.tab ?: "tools" }
		showPage( event, prc, "registry", "registry/index" )
	}

}
