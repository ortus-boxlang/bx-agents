<!--- The agent paused a tool call: what it wants to do, and Approve or Reject. The rest of the turn then streams in.
      Inside chatPage, as `m`. --->
<bx:output>
<div class="approval" role="group" aria-label="Approval">
	<div class="approval-title" x-text="m.actions.length === 1 ? 'Approve this action?' : 'Approve ' + m.actions.length + ' actions?'"></div>
	<template x-for="( action, a ) in m.actions" :key="a">
		<div class="approval-action" x-text="action.name + ( action.args ? ' ' + action.args : '' )"></div>
	</template>
	<div class="approval-buttons">
		<button type="button" @click="decide( m, 'approve' )">Approve</button>
		<button type="button" @click="decide( m, 'reject' )">Reject</button>
	</div>
</div>
</bx:output>
