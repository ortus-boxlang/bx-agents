<!--- What an empty chat says, and the suggestions it offers to send with one click. Inside chatPage. --->
<bx:output>
<div class="welcome" id="welcome" x-show="!loading && !messages.length && ( welcome || suggestions.length )" x-cloak>
	<p x-show="welcome" x-text="welcome"></p>
	<div class="suggestions" x-show="suggestions.length">
		<template x-for="s in suggestions" :key="s"><button type="button" @click="suggest( s )" x-text="s"></button></template>
	</div>
</div>
</bx:output>
