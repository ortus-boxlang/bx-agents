<!--- Data and backups (admin): where the agent keeps everything, and backups of it. State and actions: dataPage
      (resources/assets/js/components/admin/DataPage.js). --->
<bx:output>
<div class="pg" x-data="dataPage">
	#view( view = "_components/ui/page-head", module = "bxagentsui", args = {
		title   : "Data and backups",
		note    : "Where the agent keeps its conversations, notes, routines, logs and files, and backups of all of it.",
		actions : '<button type="button" class="btn primary" @click="make()" :disabled="making">' & view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "cloud-arrow-up" } ) & ' Make a backup</button>'
	} )#
	#view( view = "_components/ui/card", module = "bxagentsui", args = { title : "Where it is kept", contentView : "data/_folders" } )#
	#view( view = "_components/ui/card", module = "bxagentsui", args = { title : "Backups", contentView : "data/_backups" } )#
</div>
</bx:output>
