<!--- One backup, a row of the backups table, with Download and Restore. --->
<bx:output>
<td x-text="backup.name"></td>
<td x-text="$fmt.bytesText( backup.bytes )"></td>
<td x-text="$fmt.stampText( backup.madeAt )"></td>
<td>
	<div class="pg-actions nowrap">
		<button type="button" class="btn" @click="download( backup )" :aria-label="'Download ' + backup.name">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "download-simple" } )# Download</button>
		<button type="button" class="btn" @click="restore( backup )" :aria-label="'Restore ' + backup.name">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "cloud-arrow-down" } )# Restore</button>
	</div>
</td>
</bx:output>
