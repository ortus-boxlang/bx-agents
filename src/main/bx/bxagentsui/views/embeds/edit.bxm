<!--- The page that makes a new embed or changes one (the routes /embeds/new and /embeds/<id>, see handlers/Embeds.bx). `prc.embedId`
      is blank for a new one. State and actions: embedEditPage (resources/assets/js/components/admin/EmbedsPage.js). A new embed that
      is saved stays on this page, which is then the edit of it; the link back goes to the list. --->
<bx:output>
<div class="pg embeds embeds-edit" x-data="embedEditPage( '#encodeForHTML( prc.embedId )#' )">
	<p class="embeds-back">
		<a id="backToEmbeds" href="#encodeForHTML( prc.ui.basePath )#/embeds" @click="leave( $event )">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "caret-left" } )# All embeds</a>
	</p>
	<div class="pg-head">
		<div class="pg-title">
			<h1 x-text="title">Embed</h1>
			<p>The agent on another website, for anonymous visitors. Visitors do not sign in: they can only ask questions, with the tools you tick.</p>
		</div>
	</div>
	<p class="pg-note" x-show="loading">Loading...</p>
	<div x-show="failed" x-cloak>
		<p class="pg-error" role="alert" x-text="failed"></p>
		<p><a class="btn" href="#encodeForHTML( prc.ui.basePath )#/embeds">Back to the embeds</a></p>
	</div>
	#view( view = "embeds/_editor", module = "bxagentsui" )#
</div>
</bx:output>
