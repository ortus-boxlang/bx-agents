<!--- What goes in <head>: the title, the settings the scripts read (as JSON data, never as code), the theme set before
      the CSS loads so there is no flash, the gateway's theme and the Vite assets.

    Usage:
        #view( view = "_components/app/includes", module = "bxagentsui" )#
--->
<bx:output>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>#encodeForHTML( ( prc.page.title ?: "" ).len() ? prc.page.title & " - " & prc.ui.title : prc.ui.title )#</title>
<bx:if ( prc.ui.favicon ?: "" ).len()><link rel="icon" href="#encodeForHTML( prc.ui.favicon )#"></bx:if>
<script type="application/json" id="bxagents-config">#getInstance( "PageData@bxagentsui" ).json( {
	"basePath"  : prc.ui.basePath,
	"chatUrl"   : prc.ui.chatUrl,
	"apiBase"   : prc.ui.apiBase,
	"title"     : prc.ui.title,
	"signIn"    : prc.ui.signIn,
	"loginUrl"  : prc.ui.loginUrl,
	"logoutUrl" : prc.ui.logoutUrl
} )#</script>
<bx:if !( prc.ui.grammarWords ?: {} ).isEmpty()><script type="application/json" id="bxagents-grammars">#getInstance( "PageData@bxagentsui" ).json( prc.ui.grammarWords )#</script></bx:if>
<script>
	// the theme and appearance before the CSS, so the page never flashes the wrong look (the stores keep them in step
	// afterwards). The theme is a plain "dark" or "light", the appearance JSON.
	( function () {
		var root = document.documentElement;
		try {
			var mode = localStorage.getItem( "bxagents_webui_theme" );
			if ( mode !== "dark" && mode !== "light" ) {
				mode = window.matchMedia && window.matchMedia( "(prefers-color-scheme: dark)" ).matches ? "dark" : "light";
			}
			root.setAttribute( "data-theme", mode );
			var look = JSON.parse( localStorage.getItem( "bxagents_webui_appearance" ) || "{}" );
			var sizes = { small: "0.85rem", large: "1.05rem" };
			if ( sizes[ look.size ] ) { root.style.setProperty( "--font-size", sizes[ look.size ] ); }
			if ( look.density === "compact" ) { root.setAttribute( "data-density", "compact" ); }
		} catch ( e ) {}
	} )();
</script>
#getInstance( "Vite@bxagentsui" ).tags( [ "resources/assets/scss/app.scss", "resources/assets/js/App.js" ], prc.ui.includesUrl )#
<bx:loop array="#prc.ui.extensionStyles ?: []#" item="href"><link rel="stylesheet" href="#encodeForHTML( href )#"></bx:loop>
<bx:if prc.ui.themeCss.len() || prc.ui.customCss.len()>
<style>
#prc.ui.themeCss#
#prc.ui.customCss#
</style>
</bx:if>
</bx:output>
