<!--- The icon set, drawn once at the top of the page; an icon is <svg class="i"><use href="#i-name"/></svg>
      (see _components/ui/icon). The generator copies it into includes/icons.svg. --->
<bx:script>
	spriteFile = getDirectoryFromPath( getCurrentTemplatePath() ).reReplace( "views[\\/]_components[\\/]app[\\/]$", "" ) & "includes/icons.svg"
</bx:script>
<bx:if fileExists( spriteFile )><bx:output>#fileRead( spriteFile )#</bx:output></bx:if>
