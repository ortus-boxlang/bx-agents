<!--- The password of an agent without accounts (its API key), kept in this browser and sent with every call. It opens
      by itself when the server refuses a call (once per page load; with accounts a refusal goes to the sign-in form
      instead), and from the Password button of an agent without accounts. In the layout once. State: the password store. --->
<bx:output>
<dialog class="dlg" id="keyPanel" aria-labelledby="keyTitle" x-data
	x-effect="$store.password.open ? ( $el.open || $el.showModal() ) : ( $el.open && $el.close() )"
	@close="$store.password.open = false">
	<form class="dlg-form" method="dialog" autocomplete="off" @submit.prevent="$store.password.save()">
		<div class="dlg-head"><h2 id="keyTitle">Password for this server</h2></div>
		<p class="pg-error" role="alert" x-show="$store.password.problem" x-text="$store.password.problem"></p>
		<p class="pg-note">The server asks for a password (an access token). It is kept in this browser and sent with every request.</p>
		<label class="field"><span>Password</span>
			<input type="password" id="keyInput" autocomplete="current-password" x-model="$store.password.value" x-effect="$store.password.open && $nextTick( () => $el.focus() )">
		</label>
		<div class="pg-actions">
			<button type="submit" class="btn primary">Save</button>
			<button type="button" class="btn" x-show="$store.password.saved" @click="$store.password.forget()">Forget it</button>
			<button type="button" class="btn" @click="$store.password.open = false">Cancel</button>
		</div>
	</form>
</dialog>
</bx:output>
