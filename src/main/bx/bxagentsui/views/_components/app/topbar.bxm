<!--- The header: the menu button on a phone, the agent's icon and title, the theme switch and, with accounts, who is
      signed in and Sign out; without accounts, the Password button. --->
<bx:output>
<header>
	<div class="brand">
		<button type="button" id="navBtn" class="ib" title="Menu" aria-label="Menu" aria-controls="mainNav" :aria-expanded="$store.nav.isOpen( 'nav' ).toString()" @click="$store.nav.toggle( 'nav', $el )">
			#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "list" } )#
		</button>
		<span class="icon" aria-hidden="true"><bx:switch expression="#prc.ui.iconKind ?: ( prc.ui.icon.len() ? "text" : "none" )#">
			<bx:case value="image"><img src="#encodeForHTML( prc.ui.icon )#" alt=""></bx:case>
			<bx:case value="phosphor">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : prc.ui.iconName } )#</bx:case>
			<bx:case value="text">#encodeForHTML( prc.ui.icon )#</bx:case>
			<bx:defaultcase>#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "robot" } )#</bx:defaultcase>
		</bx:switch></span>
		<div>
			<h1>#encodeForHTML( prc.ui.title )#</h1>
			<bx:if prc.ui.subtitle.len()><p class="subtitle">#encodeForHTML( prc.ui.subtitle )#</p></bx:if>
		</div>
	</div>
	<div class="actions">
		<button type="button" class="ib" id="themeToggle" @click="$store.theme.toggle()" :aria-label="$store.theme.dark ? 'Switch to light theme' : 'Switch to dark theme'" :title="$store.theme.dark ? 'Light theme' : 'Dark theme'">
			<span x-show="$store.theme.dark">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "sun" } )#</span>
			<span x-show="!$store.theme.dark">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "moon" } )#</span>
		</button>
		<bx:if !prc.ui.signIn>
			<button type="button" class="ib" id="keyBtn" title="Password for this server" aria-label="Password" @click="$store.password.ask()">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "key" } )#</button>
		</bx:if>
		<bx:if prc.user.signedIn>
			<span class="meta" id="whoAmI">#encodeForHTML( prc.user.label )#</span>
			<a class="ib" id="signOut" href="#encodeForHTML( prc.ui.logoutUrl )#" title="Sign out" aria-label="Sign out">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "sign-out" } )#</a>
		</bx:if>
	</div>
</header>
</bx:output>
