<!--- The left menu: the pages of Menu.bx in their groups. A page shows only when this person may use it, which Alpine
      reads from the session store ($store.session.can). The current page is marked with aria-current. --->
<bx:output>
<nav id="mainNav" aria-label="Main" x-cloak>
	<div id="navList">
		<bx:loop array="#prc.menu#" item="group">
			<h2 class="nav-group" id="navGroup-#group.id#" data-capabilities="#encodeForHTMLAttribute( group.pages.map( p => p.capability ).toList( ' ' ) )#" x-show="$store.session.ready && $store.session.canAny( $el.dataset.capabilities )">#encodeForHTML( group.title )#</h2>
			<ul aria-labelledby="navGroup-#group.id#">
				<bx:loop array="#group.pages#" item="item">
					<li data-capability="#encodeForHTMLAttribute( item.capability )#" x-show="$store.session.ready && $store.session.can( $el.dataset.capability )">
						<a class="nav-item" href="#encodeForHTMLAttribute( prc.ui.basePath & ( item.id == 'chat' ? '/' : '/' & item.id ) )#" data-page="#item.id#" title="#encodeForHTMLAttribute( item.title )#"<bx:if ( prc.page.id ?: "" ) == item.id> aria-current="page"</bx:if>>
							<span>#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : item.icon } )#</span>
							<span class="nav-label">#encodeForHTML( item.title )#</span>
						</a>
					</li>
				</bx:loop>
			</ul>
		</bx:loop>
	</div>
	<div class="nav-foot" id="navFoldRow">
		<button type="button" id="navFold" :aria-expanded="( !$store.nav.folded ).toString()" @click="$store.nav.toggleFold()" :title="$store.nav.folded ? 'Open the menu' : 'Fold the menu to icons'">
			#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "caret-double-left" } )#<span id="navFoldLabel" class="nav-label">Fold menu</span>
		</button>
	</div>
</nav>
</bx:output>
