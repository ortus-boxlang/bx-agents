<!--- Toasts Component
    The one place short messages appear ($toast.success, $toast.error), announced to a screen reader. In the layout once.

    Usage:
        #view( view = "_components/ui/toasts", module = "bxagentsui" )#
--->
<bx:output>
<div class="toasts" role="status" aria-live="polite" x-data>
	<template x-for="item in $store.toast.items" :key="item.id">
		<div class="toast" :class="item.kind">
			<span x-show="item.kind === 'ok'">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "check-circle" } )#</span>
			<span x-show="item.kind === 'error'">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "warning-circle" } )#</span>
			<span x-show="item.kind === 'info'">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "info" } )#</span>
			<p x-text="item.text"></p>
			<button type="button" aria-label="Dismiss" @click="$store.toast.dismiss( item.id )">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "x" } )#</button>
		</div>
	</template>
</div>
</bx:output>
