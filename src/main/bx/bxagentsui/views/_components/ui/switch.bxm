<!--- Switch Component
    An on and off toggle (a checkbox under the hood, so it is a real form control for the keyboard and a screen reader).

    Usage:
        #view( view = "_components/ui/switch", module = "bxagentsui", args = { label : "Read only", model : "readonly" } )#

    Args:
        label    : string - what it switches (required)
        model    : string - the component variable it binds (Alpine; written by the developer, never data)
        disabled : string - an Alpine expression that disables it (default: "false")
--->
<bx:param name="args.label" default=""/>
<bx:param name="args.model" default=""/>
<bx:param name="args.disabled" default="false"/>
<bx:output>
<label class="switch-row">
	<span class="switch">
		<input type="checkbox" role="switch" x-model="#args.model#" :disabled="#args.disabled#">
		<span class="switch-track" aria-hidden="true"></span>
	</span>
	<span>#encodeForHTML( args.label )#</span>
</label>
</bx:output>
