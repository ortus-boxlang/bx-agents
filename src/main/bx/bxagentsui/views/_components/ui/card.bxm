<!--- Card Component
    A box of content with an optional title, as cbGenesis composes partials: the content is another view.

    Usage:
        #view( view = "_components/ui/card", module = "bxagentsui", args = {
            title       : "Catalog",
            contentView : "connectors/_banner",
            contentArgs : {}
        } )#

    Args:
        title       : string - a heading (default: "")
        contentView : string - the view inside the card, in this module (required)
        contentArgs : struct - the args for that view (default: {})
        classes     : string - extra CSS classes (default: "")
--->
<bx:param name="args.title" default=""/>
<bx:param name="args.contentView" default=""/>
<bx:param name="args.contentArgs" default="#{}#"/>
<bx:param name="args.classes" default=""/>
<bx:output>
<section class="card #encodeForHTML( args.classes )#">
	<bx:if len( args.title )><h2 class="card-title">#encodeForHTML( args.title )#</h2></bx:if>
	<bx:if len( args.contentView )>#view( view = args.contentView, module = "bxagentsui", args = args.contentArgs )#</bx:if>
</section>
</bx:output>
