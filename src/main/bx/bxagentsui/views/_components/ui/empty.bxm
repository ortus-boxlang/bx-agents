<!--- Empty State Component
    What a page or a list shows when there is nothing in it yet.

    Usage:
        #view( view = "_components/ui/empty", module = "bxagentsui", args = { icon : "puzzle-piece", title : "No connectors", text : "Nothing is offered yet." } )#

    Args:
        icon  : string - an icon name (default: "info")
        title : string - one short line (required)
        text  : string - what to do about it (default: "")
--->
<bx:param name="args.icon" default="info"/>
<bx:param name="args.title" default=""/>
<bx:param name="args.text" default=""/>
<bx:output>
<div class="pg-empty-state" role="status">
	#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : args.icon } )#
	<p class="pg-empty-title">#encodeForHTML( args.title )#</p>
	<bx:if args.text.len()><p class="pg-note">#encodeForHTML( args.text )#</p></bx:if>
</div>
</bx:output>
