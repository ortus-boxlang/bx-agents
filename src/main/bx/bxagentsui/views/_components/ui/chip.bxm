<!--- Chip Component
    A small label: a state, a count, a kind.

    Usage:
        #view( view = "_components/ui/chip", module = "bxagentsui", args = { text : "Connected", kind : "ok", icon : "check-circle" } )#

    Args:
        text : string - what it says (required)
        kind : string - "" | ok | warn | bad (default: "")
        icon : string - an icon name (default: "")
--->
<bx:param name="args.text" default=""/>
<bx:param name="args.kind" default=""/>
<bx:param name="args.icon" default=""/>
<bx:output><span class="chip #encodeForHTML( args.kind )#"><bx:if len( args.icon )>#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : args.icon } )#</bx:if>#encodeForHTML( args.text )#</span></bx:output>
