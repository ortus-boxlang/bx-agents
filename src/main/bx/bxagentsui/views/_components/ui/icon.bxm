<!--- Icon Component
    One icon of the set drawn by _components/app/sprite, sized by the text around it.

    Usage:
        #view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "gear" } )#

    Args:
        name    : string - the icon's name in the set (required)
        classes : string - extra CSS classes (default: "")
--->
<bx:param name="args.name" default=""/>
<bx:param name="args.classes" default=""/>
<bx:output><svg class="i #encodeForHTML( args.classes )#" aria-hidden="true"><use href="##i-#encodeForHTML( args.name )#"/></svg></bx:output>
