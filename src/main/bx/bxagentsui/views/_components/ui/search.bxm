<!--- Search Component
    A search box bound to an Alpine variable of the page's component, with a debounce.

    Usage:
        #view( view = "_components/ui/search", module = "bxagentsui", args = { label : "Search the connectors", model : "query" } )#

    Args:
        label    : string - the placeholder and the accessible name (required)
        model    : string - the component variable it writes (Alpine; written by the developer, never data)
        debounce : number - milliseconds to wait after typing (default: 200)
--->
<bx:param name="args.label" default="Search"/>
<bx:param name="args.model" default="query"/>
<bx:param name="args.debounce" default="200"/>
<bx:output>
<label class="search">
	#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "magnifying-glass" } )#
	<input type="search" placeholder="#encodeForHTML( args.label )#" aria-label="#encodeForHTML( args.label )#" x-model.debounce.#val( args.debounce )#ms="#args.model#">
</label>
</bx:output>
