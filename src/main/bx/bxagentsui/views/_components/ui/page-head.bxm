<!--- Page Head Component
    The title of a page, a line under it, and room for actions on the right.

    Usage:
        #view( view = "_components/ui/page-head", module = "bxagentsui", args = { title : "Connectors", note : "Services the agent can use for you." } )#

    Args:
        title   : string - the page's title (required)
        note    : string - one line under the title (default: "")
        actions : string - HTML for the right side, already escaped by the caller (default: "")
--->
<bx:param name="args.title" default=""/>
<bx:param name="args.note" default=""/>
<bx:param name="args.actions" default=""/>
<bx:output>
<div class="pg-head">
	<div class="pg-title">
		<h1>#encodeForHTML( args.title )#</h1>
		<bx:if args.note.len()><p>#encodeForHTML( args.note )#</p></bx:if>
	</div>
	<bx:if args.actions.len()><div class="pg-actions">#args.actions#</div></bx:if>
</div>
</bx:output>
