<!--- One use of a secret, a row of the activity table. --->
<td x-text="$fmt.stampText( line.at )"></td>
<td x-text="line.name || ''"></td>
<td><span class="chip" :class="line.ok ? 'ok' : 'bad'"><svg class="i" aria-hidden="true"><use :href="line.ok ? '#i-check-circle' : '#i-warning-circle'"/></svg><span x-text="( line.action || '' ) + ( line.ok ? '' : ' failed' )"></span></span></td>
<td x-text="line.scope || ''"></td>
<td x-text="line.actor || ''"></td>
<td x-text="( line.via || '' ) + ( line.host ? ' to ' + line.host : '' )"></td>
