<!--- The form to add a secret. The value is cleared as it is sent. Inside vaultPage. --->
<bx:output>
<h2>Add a secret</h2>
<form class="stack narrow-form" autocomplete="off" @submit.prevent="add()">
	<input type="text" maxlength="64" placeholder="NAME_OF_THE_SECRET" aria-label="Name" required x-model="form.name">
	<input type="password" autocomplete="new-password" placeholder="Value" aria-label="Value" required x-model="form.value" x-init="ask && $nextTick( () => $el.focus() )">
	<input type="text" placeholder="What it is for" aria-label="What it is for" x-model="form.description">
	<input type="text" placeholder="Hosts it may go to (comma separated, empty for any)" aria-label="Hosts" x-model="form.hosts">
	<div class="pg-actions"><button type="submit" class="btn primary">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "plus" } )# Add the secret</button></div>
</form>
</bx:output>
