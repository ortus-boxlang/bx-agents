<!--- Where the key is, and who used which secret, never a value (admin). Inside vaultPage. --->
<bx:output>
<section>
	<h2>Activity</h2>
	<p class="pg-note" x-text="activity.note"></p>
	<p class="pg-note" x-show="!activity.lines.length">Nothing has used a secret yet.</p>
	<div x-show="activity.lines.length">
		#view( view = "_components/ui/table", module = "bxagentsui", args = {
			caption : "Recent use of secrets",
			columns : [ "When", "Secret", "What", "Whose", "By", "Through" ],
			rows    : "activity.lines",
			item    : "line",
			rowView : "vault/_activity-row"
		} )#
	</div>
</section>
</bx:output>
