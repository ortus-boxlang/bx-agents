<!--- One secret: its name, what it is for and where it may go, with Edit and Remove. Inside vaultPage, as `secret`. --->
<bx:output>
<template x-if="!editing || editing.name !== secret.name">
	<div>
		<div class="pg-actions">
			<strong class="grow" x-text="secret.name"></strong>
			<button type="button" class="btn" x-show="canWrite" @click="edit( secret )" :aria-label="'Edit ' + secret.name">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "pencil-simple" } )# Edit</button>
			<button type="button" class="btn danger" x-show="canWrite" @click="remove( secret )" :aria-label="'Remove ' + secret.name">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "trash" } )# Remove</button>
		</div>
		<p class="pg-note" x-text="about( secret )"></p>
	</div>
</template>
<template x-if="editing && editing.name === secret.name">
	<form class="stack" autocomplete="off" @submit.prevent="save()">
		<strong x-text="secret.name"></strong>
		<input type="password" autocomplete="new-password" placeholder="New value (leave empty to keep the current one)" aria-label="New value" x-model="editing.value" x-init="$el.focus()">
		<input type="text" placeholder="What it is for" aria-label="What it is for" x-model="editing.description">
		<input type="text" placeholder="Hosts it may go to" aria-label="Hosts" x-model="editing.hosts">
		<div class="pg-actions">
			<button type="submit" class="btn primary">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "check" } )# Save</button>
			<button type="button" class="btn" @click="editing = null">Cancel</button>
		</div>
	</form>
</template>
</bx:output>
