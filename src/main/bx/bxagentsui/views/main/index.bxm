<!--- The chat: the conversations, the transcript and the composer. State and actions: chatPage
      (resources/assets/js/components/chat/ChatPage.js). The gateway's chat settings come as data. --->
<bx:output>
<div id="page-chat" x-data="chatPage"
	data-welcome="#encodeForHTML( prc.ui.welcome )#"
	data-suggestions="#encodeForHTML( jsonSerialize( prc.ui.suggestions ?: [] ) )#"
	data-show-reasoning="#( prc.ui.showReasoning ?: true ) ? 'true' : 'false'#"
	data-show-tools="#( prc.ui.showTools ?: true ) ? 'true' : 'false'#">
	<div class="shell">
		#view( view = "chat/_conversations", module = "bxagentsui" )#
		<div id="main">
			#view( view = "chat/_bar", module = "bxagentsui" )#
			<p class="talk-banner" role="status" x-show="talkBanner" x-cloak x-text="talkBanner"></p>
			<div id="messages" role="log" aria-live="polite" aria-relevant="additions text" aria-label="Conversation" x-ref="messages">
				#view( view = "chat/_welcome", module = "bxagentsui" )#
				<template x-for="( m, i ) in messages" :key="i">#view( view = "chat/_message", module = "bxagentsui" )#</template>
			</div>
			<p class="hint" role="status" x-text="hint"></p>
			#view( view = "chat/_composer", module = "bxagentsui" )#
			<bx:if len( prc.ui.footer )><footer class="note">#encodeForHTML( prc.ui.footer )#</footer></bx:if>
		</div>
	</div>
	#view( view = "_components/ui/drawer", module = "bxagentsui", args = { title : "Context", open : "contextOpen", contentView : "chat/_context" } )#
</div>
</bx:output>
