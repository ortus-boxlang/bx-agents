<!--- The folders the agent may read and write. Inside registryPage. --->
<bx:output>
<p class="pg-note" x-show="loaded.volumes && !failed && !volumes.length" x-cloak>No volumes. The agent has no folder it may read or write.</p>
<ul class="plain-list" aria-label="Volumes">
	<template x-for="volume in volumes" :key="volume.name">
		<li class="card">
			<div class="pg-actions">
				<strong x-text="volume.name"></strong>
				<span class="chip" :class="volume.mode === 'rw' ? '' : 'warn'"><svg class="i" aria-hidden="true"><use :href="volume.mode === 'rw' ? '##i-pencil-simple' : '##i-eye'"/></svg><span x-text="volume.mode === 'rw' ? 'Read and write' : 'Read only'"></span></span>
			</div>
			<p class="pg-note" x-text="volume.description || ''"></p>
		</li>
	</template>
</ul>
</bx:output>
