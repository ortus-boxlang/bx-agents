<!--- Registry: the tools, skills and volumes. State and actions: registryPage
      (resources/assets/js/components/registry/RegistryPage.js). The tab comes from the address as data. --->
<bx:output>
<div class="pg" x-data="registryPage" data-tab="#encodeForHTML( prc.registry.tab )#">
	#view( view = "_components/ui/page-head", module = "bxagentsui", args = { title : "Registry", note : "What the agent can use: its tools, the skills it can load, and the folders it may read and write." } )#
	#view( view = "_components/ui/tabs", module = "bxagentsui", args = {
		label : "Registry",
		model : "tab",
		tabs  : [ { id : "tools", label : "Tools", icon : "wrench" }, { id : "skills", label : "Skills", icon : "lightbulb" }, { id : "volumes", label : "Volumes", icon : "folder" } ]
	} )#
	<p class="pg-error" role="alert" x-show="failed" x-text="failed" x-cloak></p>
	<div x-show="tab === 'tools'">#view( view = "registry/_tools", module = "bxagentsui" )#</div>
	<div x-show="tab === 'skills'" x-cloak>#view( view = "registry/_skills", module = "bxagentsui" )#</div>
	<div x-show="tab === 'volumes'" x-cloak>#view( view = "registry/_volumes", module = "bxagentsui" )#</div>
</div>
</bx:output>
