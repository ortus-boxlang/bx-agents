<!--- Memory: notes about you, the agent's notes, and the conversation memory. State and actions: memoryPage
      (resources/assets/js/components/memory/MemoryPage.js). --->
<bx:output>
<div class="pg" x-data="memoryPage">
	#view( view = "_components/ui/page-head", module = "bxagentsui", args = { title : "Memory", note : "What the agent remembers. Notes are short lines it keeps across conversations and reads at the start of every one." } )#
	<p class="pg-error" role="alert" x-show="failed" x-text="failed" x-cloak></p>
	<template x-for="scope in scopes" :key="scope.id">
		<section class="card" :aria-label="scope.title" x-show="!loading && !failed">#view( view = "memory/_notes", module = "bxagentsui" )#</section>
	</template>
	#view( view = "_components/ui/card", module = "bxagentsui", args = { title : "Conversation memory", contentView : "memory/_conversations" } )#
</div>
</bx:output>
