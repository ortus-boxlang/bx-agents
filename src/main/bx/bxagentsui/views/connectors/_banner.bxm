<!--- What the catalog allows here, and how many tools the person has on across what they connected. Inside
      connectorsPage. --->
<bx:output>
<div class="card conn-banner" x-show="data" x-cloak>
	#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "sliders-horizontal" } )#
	<div class="conn-banner-text">
		<strong x-text="policyText"></strong>
		<div class="pg-note" x-text="policyDetail"></div>
	</div>
	<span class="chip" :class="{ warn: summary.over }" x-show="summary.toolsOn !== undefined">
		<svg class="i" aria-hidden="true" x-show="summary.over"><use href="##i-warning"/></svg><span x-text="summary.toolsOn + ' tools on'"></span>
	</span>
	<span class="pg-note" x-show="summary.over" x-text="'Models answer better with fewer than ' + summary.toolWarning + '.'"></span>
</div>
</bx:output>
