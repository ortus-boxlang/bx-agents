<!--- The account: the connectors, and signing out when the agent has accounts. Inside settingsPage. --->
<bx:output>
<p class="pg-note">The connectors are the services the agent uses for you, such as GitHub or a calendar.</p>
<div class="pg-actions">
	<a class="btn" href="#encodeForHTML( prc.ui.basePath )#/connectors" x-show="$store.session.can( 'connectors|connections' )">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "puzzle-piece" } )# Connectors</a>
	<bx:if prc.ui.signIn>
	<a class="btn" href="#encodeForHTML( prc.ui.logoutUrl )#">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "sign-out" } )# Sign out</a>
	</bx:if>
</div>
</bx:output>
