<!--- The project's files, read only, with a viewer. Inside agentPage. --->
<bx:output>
<p class="pg-note">The project's own files, read only. Secrets in Agent.yaml are shown as names, never values.</p>
<p class="pg-note" x-show="loaded.files && !failed && !files.length" x-cloak>No files to show.</p>
<ul class="plain-list" aria-label="Files">
	<template x-for="file in files" :key="file.path">
		<li class="card">
			<div class="pg-actions">
				<code class="grow" x-text="file.path"></code>
				<span class="pg-note" x-text="$fmt.bytesText( file.size )"></span>
				<button type="button" class="btn" @click="read( file )" :aria-label="'Read ' + file.path">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "eye" } )# Read</button>
			</div>
		</li>
	</template>
</ul>
<template x-if="viewing">
	<section class="card reader" aria-label="File" tabindex="-1" x-init="$nextTick( () => $el.focus( { preventScroll: true } ) )">
		<div class="card-head">
			<h2 x-text="viewing.path"></h2>
			<button type="button" class="btn" @click="viewing = null">#view( view = "_components/ui/icon", module = "bxagentsui", args = { name : "x" } )# Close</button>
		</div>
		<pre x-text="viewing.text"></pre>
	</section>
</template>
</bx:output>
