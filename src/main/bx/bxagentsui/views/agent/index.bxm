<!--- Agent (admin): composition, files and usage. State and actions: agentPage
      (resources/assets/js/components/admin/AgentPage.js). The tab comes from the address as data. --->
<bx:output>
<div class="pg" x-data="agentPage" data-tab="#encodeForHTML( prc.agentPage.tab )#">
	#view( view = "_components/ui/page-head", module = "bxagentsui", args = { title : "Agent", note : "How this agent is put together: what reaches it, what it is made of, and where it reaches out." } )#
	#view( view = "_components/ui/tabs", module = "bxagentsui", args = {
		label : "Agent",
		model : "tab",
		tabs  : [ { id : "composition", label : "Composition", icon : "tree-structure" }, { id : "files", label : "Files", icon : "folder" }, { id : "usage", label : "Usage", icon : "chart-line" } ]
	} )#
	<p class="pg-error" role="alert" x-show="failed" x-text="failed" x-cloak></p>
	<div x-show="tab === 'composition'">#view( view = "agent/_composition", module = "bxagentsui" )#</div>
	<div x-show="tab === 'files'" x-cloak>#view( view = "agent/_files", module = "bxagentsui" )#</div>
	<div x-show="tab === 'usage'" x-cloak>#view( view = "agent/_usage", module = "bxagentsui" )#</div>
</div>
</bx:output>
