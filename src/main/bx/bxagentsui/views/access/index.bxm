<!--- Access (admin): tokens for the API, and the people who can sign in. State and actions: accessPage
      (resources/assets/js/components/admin/AccessPage.js). The tab comes from the address as data. --->
<bx:output>
<div class="pg" x-data="accessPage" data-tab="#encodeForHTML( prc.access.tab )#">
	#view( view = "_components/ui/page-head", module = "bxagentsui", args = { title : "Access", note : "Who and what can use this agent: access tokens for the API, and the accounts that can sign in." } )#
	#view( view = "_components/ui/tabs", module = "bxagentsui", args = {
		label : "Access",
		model : "tab",
		tabs  : [ { id : "tokens", label : "Tokens", icon : "key" }, { id : "people", label : "People", icon : "users" } ]
	} )#
	<div x-show="tab === 'tokens'">#view( view = "access/_tokens", module = "bxagentsui" )#</div>
	<div x-show="tab === 'people'" x-cloak>#view( view = "access/_people", module = "bxagentsui" )#</div>
</div>
</bx:output>
