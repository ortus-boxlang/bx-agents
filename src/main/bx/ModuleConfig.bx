/**
 * This is the module descriptor and entry point for your module in the runtime.
 * The unique name of the moduel is the name of the directory on the modules folder.
 * A BoxLang mapping will be created for you with the name of the module.
 *
 * A module can have the following folders that will be automatically registered:
 * + bifs - Custom BIFs that will be registered into the runtime
 * + interceptors - Custom interceptors that will be registered into the runtime via the configure() method
 * + libs - Custom java libraries that your module leverages
 * + tags - Custom tags that will be registered into the runtime
 *
 * Every module will have its own classloader that will be used to load the module libs and dependencies.
 */
class {

	property name="moduleRecord";
	property name="boxRuntime";
	property name="log";

	/**
	 * --------------------------------------------------------------------------
	 * Module Properties
	 * --------------------------------------------------------------------------
	 * Here is where you define the properties of your module that the module service
	 * will use to register and activate your module
	 */

	/**
	 * Your module version. Try to use semantic versioning
	 * @mandatory
	 */
	this.version = "@build.version@+@build.number@";

	/**
	 * The BoxLang mapping for your module.  All BoxLang modules are registered with an internal
	 * mapping prefix of : bxModules.{this.mapping}, /bxmodules/{this.mapping}. Ex: bxModules.test, /bxmodules/test
	 */
	this.mapping = "bxagents";

	/**
	 * Who built the module
	 */
	this.author = "Luis Majano";

	/**
	 * The module description
	 */
	this.description = "Conventions-based AI agent framework for BoxLang, built on ColdBox and BX AI";

	/**
	 * The module web URL
	 */
	this.webURL = "https://www.ortussolutions.com";

	/**
	 * This boolean flag tells the module service to skip the module registration/activation process.
	 */
	this.enabled = true;

    /**
	 * The module dependencies that this module needs to be activated before this module is activated
	 */
	this.dependencies = [];

	/**
	 * --------------------------------------------------------------------------
	 * Module Methods
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Called by the ModuleService on module registration
	 */
	function configure(){
		/**
		 * Every module has a settings configuration object
		 */
		settings = {
			loadedOn : now(),
			loadedBy : "Luis Majano"
		};

		/**
		 * Every module can have a list of object mappings
		 * that can be created by boxLang.  This is a great way
		 * to create objects that can be used by the module
		 * or other modules.
		 * The mappings will be created in the following format:
		 * bxModules.{this.mapping}.{mappingName}
		 * Ex: bxModules.test.MyObject => bxModules.test.models.MyObject
		 */
		objectMappings = {
			// { name="MyObject", class="models.utilities.MyObject" }
		}

		/**
		 * DataSources can be defined by a module and they will be registered
		 * for you in the runtime
		 */
		datasources = {
			// { name="MyDSN", class="coldbox.system.datasources.ColdBoxDataSource", properties={dsn="mydsn"} }
		};

		/**
		 * The module interceptors to register into the runtime.
		 * BX Agents' own `@runtime`-scoped interceptors are added here as they are built (M7).
		 */
		interceptors = [
			// { class="path.to.Interceptor", properties={} }
		];

		/**
		 * A list of custom interception points to register into the runtime
		 */
		customInterceptionPoints = [];
	}

	/**
	 * Called by the ModuleService on module activation
	 */
	function onLoad(){

	}

	/**
	 * Called by the ModuleService on module deactivation
	 */
	function onUnload(){

	}

	/**
	 * --------------------------------------------------------------------------
	 * Module Events
	 * --------------------------------------------------------------------------
	 * You can listen to any runtime events by creating the methods
	 * that match the approved runtime interception points
	 */

	 function afterModuleActivations(){
		// do something
	 }

	/**
	 * --------------------------------------------------------------------------
	 * CLI Entry Point
	 * --------------------------------------------------------------------------
	 * Every BoxLang module may declare `main( args )`; `boxlang module:bxAgents
	 * <verb> ...` invokes it directly. Confirmed against the official
	 * BoxLang_Docs MCP source (`askQuestion`), and empirically against a real
	 * `module:` dispatch in this session: `args` contains ONLY the arguments
	 * AFTER `module:{name}` - the module name itself is never included. So
	 * args[1] = the verb, args[2..] = the verb's own flags/positional args.
	 * Dispatch itself is CLI-agnostic: raw argv is parsed once here into a
	 * plain options struct, then handed to one thin dispatcher class per verb
	 * under models/cli/ - every one of those is unit-tested directly against
	 * that struct shape, without going through argv parsing at all (see the
	 * build plan's own guidance to skip argv-parsing minutiae in tests).
	 *
	 * Argument parsing follows BoxLang's own documented CLI conventions
	 * exactly (see https://boxlang.ortusbooks.com/getting-started/running-boxlang/cli-scripting#parsed-arguments)
	 * - the same rules `CLIGetArgs()`/`server.cli.parsed` apply: `--option`
	 * (boolean true), `--option=value` / `--option="quoted value"`,
	 * `-o=value` / `-o` (short form), `-abc` (combined single-char
	 * shorthand), and `--!option` / `--no-option` (negation, sets false).
	 * Everything else becomes a positional. There is deliberately no
	 * `--key value` (space-separated) form - BoxLang's own convention
	 * doesn't have one either.
	 *
	 * `CLIGetArgs()`/`server.cli.parsed` themselves are NOT used here even
	 * though they already return this same shape: both are tied to the
	 * runtime's real process-launch argv, with no equivalent that parses an
	 * arbitrary array (confirmed via the official BoxLang_Docs source - no
	 * such BIF/Java class exists). That would make it impossible to call
	 * `main([...])` directly with a synthetic array in a unit test and get
	 * that array parsed - which every dispatch test in
	 * `ModuleConfigCliSpec.bx` depends on. `parseCliOptions()` below applies
	 * the identical documented rules to the `args` array `main()` actually
	 * receives, so it's testable AND matches the stock convention.
	 *
	 * `--version`/`-v` and `--help`/`-h` (or no verb, or the `help` verb) are
	 * handled before verb dispatch and never reach a verb class.
	 * `--version`/`-v` is only meaningful as the FIRST token, so it can never
	 * collide with a verb's own same-named flag (e.g. `package
	 * --version=1.0.0`). `--help`/`-h` is honoured in ANY position - no verb
	 * has a `--help` flag of its own to collide with, and the previous
	 * first-token-only handling meant `bxAgents clean --help` DELETED the
	 * build directories and `bxAgents build --help` ran a whole build instead
	 * of printing usage.
	 *
	 * Because there is no space-separated `--flag value` form, a value-taking
	 * flag written that way (`--message hello`) parses as boolean `true` with
	 * its intended value falling through to the positional project root -
	 * which silently hashed the literal string "true", scaffolded into
	 * `./openai/gpt-5`, or sent "true" to the model, since every verb tests
	 * its options with `len()` and `len( true )` is 4. `valueOptions` below
	 * declares, per verb, which flags REQUIRE a value; a valueless one is
	 * rejected here, before dispatch, so the check covers every verb in one
	 * place instead of each verb class re-validating its own flags (the verb
	 * classes stay thin dispatchers over an already-parsed struct, and stay
	 * unit-testable against that struct directly).
	 *
	 * `main()` itself is a thin wrapper around `dispatch()` for exactly one
	 * reason: `dispatch()`'s own return value must become the real OS
	 * process exit code for a genuine `boxlang module:bxAgents <verb>`
	 * invocation, but nothing does that automatically - confirmed directly
	 * against the official BoxLang_Docs MCP source: a module's `main()`
	 * return value is NOT mapped to the process exit code by the runtime;
	 * only an explicit `CLIExit( exitCode )` call (a real `System.exit()`)
	 * does that. Before this, every verb's own computed failure exit code
	 * was silently discarded - `bxAgents build && deploy` in a CI script
	 * would happily run `deploy` after a failed `build`, since the process
	 * always exited 0 regardless. `CLIExit()` cannot live in `dispatch()`
	 * itself though: `ModuleConfigCliSpec.bx`'s entire dispatch suite calls
	 * `dispatch()` directly, in-process, to assert on its returned int -
	 * calling `CLIExit()` there would `System.exit()` the whole TestBox JVM
	 * on the very first test. Keeping the real exit behind this outermost
	 * `main()` wrapper - which nothing in the test suite calls - means the
	 * exit code is genuinely enforced for real usage while every existing
	 * `dispatch()`-level test keeps working unchanged.
	 *
	 * @args The raw CLI argv, module name and dispatch token excluded
	 *
	 * @return The process exit code (0 success, 1 failure) - via a real CLIExit(), so nothing after this call runs
	 */
	function main( args = [] ) {
		return CLIExit( dispatch( arguments.args ) )
	}

	/**
	 * @args The raw CLI argv, module name and dispatch token excluded
	 *
	 * @return The exit code `main()` passes to CLIExit() (0 success, 1 failure) - never exits the process itself, so it stays directly callable from tests
	 */
	function dispatch( args = [] ) {
		// Relative to this file's OWN location (the module root) - confirmed
		// empirically this session that BoxLang resolves a bare dotted path
		// like "models.cli.New" relative to the module root ONLY from the
		// file BoxRunner directly invokes as the module's main() (this one);
		// nested classes (see e.g. New.bx's own reference to
		// ProjectScaffolder) do NOT get the same relative treatment and must
		// use the "Class@bxagents" suffix form instead - see BuildPipeline.bx.
		var verbs = {
			"new"     : "models.cli.New",
			"build"   : "models.cli.Build",
			"test"    : "models.cli.Test",
			"serve"   : "models.cli.Serve",
			"package" : "models.cli.Package",
			"deploy"  : "models.cli.Deploy",
			"inspect" : "models.cli.Inspect",
			"chat"    : "models.cli.Chat",
			"invoke"  : "models.cli.Invoke",
			"clean"   : "models.cli.Clean",
			"hash-password" : "models.cli.HashPassword",
			"doctor"  : "models.cli.Doctor"
		}

		var verbDescriptions = {
			"new"     : "Scaffold a new agent project           (--model & [--template], or --repo, or --forgebox)",
			"build"   : "Build a project into a generated app    ([--environment])",
			"test"    : "Run a project's own tests/specs via TestBox",
			"serve"   : "Serve a built project via boxlang-miniserver ([--port], [--host])",
			"chat"    : "Interactive REPL chat with a built agent ([--server] or [--connect=URL])",
			"invoke"  : "Send one message to a built agent, print the response, exit (--message, [--json])",
			"package" : "Package a built project into a .bxa    ([--version])",
			"deploy"  : "Deploy to a target                     (--name, or [--target], --destination)",
			"inspect" : "Pretty-print a built project's manifest.json ([--json])",
			"clean"   : "Remove a project's .build/ and dist/ output",
			"hash-password" : "Hash a password for a webui users entry (--password)",
			"doctor"  : "Diagnose the environment and project - runtime, modules, env vars ([--json])"
		}

		// Per verb, the flags that REQUIRE a value - `--projectRoot` is
		// universal and appended to every verb's own list below. See this
		// method's docblock for why a valueless one is a hard error rather
		// than a silent boolean `true`.
		var valueOptions = {
			"new"     : [ "model", "name", "description", "template", "repo", "forgebox" ],
			"build"   : [ "environment", "generatorVersion" ],
			"test"    : [],
			"serve"   : [ "port", "host" ],
			"package" : [ "version" ],
			"deploy"  : [ "name", "target", "destination" ],
			"inspect" : [],
			// `server` is a boolean flag, so it is NOT listed here - only
			// flags that REQUIRE a value belong in this map.
			"chat"    : [ "connect", "port" ],
			"invoke"  : [ "message", "port" ],
			"clean"   : [],
			"hash-password" : [ "password" ],
			"doctor"  : []
		}

		var firstToken = arrayLen( arguments.args ) >= 1 ? arguments.args[ 1 ] : ""

		if ( firstToken == "--version" || firstToken == "-v" ) {
			println( "bxAgents v#this.version#" )
			return 0
		}

		// Anywhere in argv, not just first: `bxAgents clean --help` must print
		// usage, NOT delete the project's build directories.
		if ( firstToken == "help" || hasHelpFlag( arguments.args ) ) {
			printUsage( verbs, verbDescriptions )
			return 0
		}

		if ( !len( firstToken ) ) {
			printUsage( verbs, verbDescriptions )
			return 1
		}

		var verbName = firstToken

		if ( !verbs.keyExists( verbName ) ) {
			println( "Unknown verb [#verbName#]." )
			println( "" )
			printUsage( verbs, verbDescriptions )
			return 1
		}

		var rawVerbArgs = []
		for ( var i = 2; i <= arrayLen( arguments.args ); i++ ) {
			rawVerbArgs.append( arguments.args[ i ] )
		}

		var options = parseCliOptions( rawVerbArgs )

		var requiredValueFlags = [ "projectRoot" ]
		requiredValueFlags.append( valueOptions[ verbName ] ?: [], true )

		for ( var flag in requiredValueFlags ) {
			if ( options._valuelessFlags.keyExists( flag ) ) {
				println( "Error: --#flag# requires a value - write it as `--#flag#=<value>`." )
				println( "bxAgents follows BoxLang's own CLI convention: a space-separated `--#flag# <value>` is not supported." )
				return 1
			}
		}

		options.delete( "_valuelessFlags" )
		options.projectRoot = resolveProjectRoot( options )

		try {
			var verbClass = new "#verbs[ verbName ]#"()
			var result = verbClass.run( options )
			if ( len( result.message ?: "" ) ) {
				println( result.message )
			}
			return result.exitCode ?: 0
		} catch ( any e ) {
			println( "Error: #e.message#" )
			return 1
		}
	}

	/**
	 * Prints the `--help`/no-verb/unknown-verb usage text: module identity,
	 * one line per verb (sorted alphabetically) with its description, and the
	 * two global flags handled before verb dispatch. Prints line-by-line
	 * rather than building and returning one joined string.
	 *
	 * This note used to say BoxLang "has no `chr()` BIF available in this
	 * module-CLI execution context", which was the wrong conclusion from a
	 * real symptom: `chr()` does not exist in BoxLang in ANY context - the
	 * BIF is spelled `char()`. Verified directly against the runtime, and
	 * separately re-confirmed the expensive way when `chr( 10 )` in the
	 * ColdBox integration runner page 500'd every request. Use `char()`.
	 *
	 * @verbs Struct mapping verb name -> dispatch class path
	 * @verbDescriptions Struct mapping verb name -> one-line help text
	 */
	private void function printUsage( required struct verbs, required struct verbDescriptions ) {
		println( "bxAgents v#this.version# - #this.description#" )
		println( "" )
		println( "Usage: boxlang module:bxAgents <verb> [options]" )
		println( "" )

		for ( var verbName in arguments.verbs.keyArray().sort( "textnocase" ) ) {
			println( "  #verbName.lJustify( 9 )# #arguments.verbDescriptions[ verbName ] ?: ''#" )
		}

		println( "" )
		println( "Global options:" )
		println( "  -h, --help     Show this help message and exit (accepted in any position)" )
		println( "  -v, --version  Show the module version and exit" )
		println( "" )
		println( "Every verb also accepts --projectRoot=<path> (or a bare positional path) to" )
		println( "target a project other than the current directory." )
	}

	/**
	 * Parses a verb's own argv (module name + verb already stripped) into a
	 * plain options struct, following BoxLang's own documented CLI argument
	 * conventions (see `main()`'s docblock for why this exists instead of
	 * just calling `CLIGetArgs()`):
	 *
	 * - `--option`          -> `true`
	 * - `--option=value`    -> `value` (surrounding `"..."` / `'...'` stripped)
	 * - `-o=value`          -> short form with a value
	 * - `-o`                -> short form, `true`
	 * - `-abc`              -> combined single-char shorthand: a/b/c all `true`
	 * - `--!option`         -> negation, `false`
	 * - `--no-option`       -> negation, `false`
	 * - anything else       -> a positional; the first one becomes
	 *                          `_positional` (a fallback project path for
	 *                          `resolveProjectRoot()`)
	 *
	 * Repeated options override earlier ones, matching the documented "last
	 * one wins" rule.
	 *
	 * Also records, in `_valuelessFlags`, every flag whose LAST occurrence
	 * carried no `=value` (so `--flag`, `--!flag`, `--no-flag`, `-abc`, but
	 * not `--flag=x`). That has to be tracked HERE, at parse time: once the
	 * struct is built a boolean `true` is indistinguishable from the string
	 * "true", and `isBoolean( "true" )` is itself true - so `main()` could
	 * not otherwise tell `--message` (no value) from `--message=true`. See
	 * `main()`'s docblock for what it does with it; `main()` strips the key
	 * again before handing the struct to a verb.
	 *
	 * @rawArgs A verb's own argv, with the module name and verb token already stripped
	 *
	 * @return A plain options struct (flag names -> value/true/false), plus a `_valuelessFlags` key (struct of flag names given without a value) and an optional `_positional` key for the first bare positional argument
	 */
	private struct function parseCliOptions( required array rawArgs ) {
		var options = {}
		var valueless = {}

		for ( var token in arguments.rawArgs ) {
			if ( token.startsWith( "--!" ) ) {
				options[ token.right( len( token ) - 3 ) ] = false
				valueless[ token.right( len( token ) - 3 ) ] = true
			} else if ( token.startsWith( "--no-" ) ) {
				options[ token.right( len( token ) - 5 ) ] = false
				valueless[ token.right( len( token ) - 5 ) ] = true
			} else if ( token.startsWith( "--" ) ) {
				var body = token.right( len( token ) - 2 )
				var eqPos = body.find( "=" )
				if ( eqPos ) {
					options[ body.left( eqPos - 1 ) ] = stripQuotes( body.right( len( body ) - eqPos ) )
					valueless.delete( body.left( eqPos - 1 ) )
				} else {
					options[ body ] = true
					valueless[ body ] = true
				}
			} else if ( token.startsWith( "-" ) && len( token ) > 1 ) {
				var body = token.right( len( token ) - 1 )
				var eqPos = body.find( "=" )
				if ( eqPos ) {
					options[ body.left( eqPos - 1 ) ] = stripQuotes( body.right( len( body ) - eqPos ) )
					valueless.delete( body.left( eqPos - 1 ) )
				} else if ( len( body ) > 1 ) {
					for ( var charIndex = 1; charIndex <= len( body ); charIndex++ ) {
						options[ body.mid( charIndex, 1 ) ] = true
						valueless[ body.mid( charIndex, 1 ) ] = true
					}
				} else {
					options[ body ] = true
					valueless[ body ] = true
				}
			} else if ( !options.keyExists( "_positional" ) ) {
				options[ "_positional" ] = token
			}
		}

		options[ "_valuelessFlags" ] = valueless

		return options
	}

	/**
	 * Does this argv carry a bare `--help`/`-h` in ANY position? Whole-token
	 * matches only, so a combined `-abc` shorthand that happens to contain an
	 * `h` is not one, and neither is a `--help=...` assignment.
	 *
	 * @args The raw CLI argv, module name and dispatch token excluded
	 *
	 * @return True if usage should be printed instead of dispatching a verb
	 */
	private boolean function hasHelpFlag( required array args ) {
		for ( var token in arguments.args ) {
			if ( token == "--help" || token == "-h" ) {
				return true
			}
		}

		return false
	}

	/**
	 * Strips one layer of matching surrounding `"..."` / `'...'` quotes from
	 * a `--option="value"` / `--option='value'` assignment, per BoxLang's own
	 * documented convention.
	 *
	 * @value The raw assigned value, quotes included if present
	 *
	 * @return The value with one layer of matching surrounding quotes removed, or unchanged if none/mismatched
	 */
	private string function stripQuotes( required string value ) {
		if ( len( arguments.value ) < 2 ) {
			return arguments.value
		}
		var first = arguments.value.left( 1 )
		var last  = arguments.value.right( 1 )
		if ( ( first == '"' && last == '"' ) || ( first == "'" && last == "'" ) ) {
			return arguments.value.right( len( arguments.value ) - 1 ).left( len( arguments.value ) - 2 )
		}
		return arguments.value
	}

	/**
	 * Precedence: --projectRoot flag > first positional arg > the shell's
	 * current working directory. A relative value is resolved against the
	 * CWD, never against this module's own file location.
	 *
	 * @options The parsed options struct from parseCliOptions()
	 *
	 * @return An absolute, trailing-slash-free path to the target project root
	 */
	private string function resolveProjectRoot( required struct options ) {
		var cwd = getSystemSetting( "user.dir", "" )
		var candidate = len( arguments.options.projectRoot ?: "" )
			? arguments.options.projectRoot
			: ( len( arguments.options._positional ?: "" ) ? arguments.options._positional : "." )

		if ( candidate == "." ) {
			return cwd.reReplace( "[\/]+$", "" )
		}

		var isAbsolute = candidate.startsWith( "/" ) || reFind( "^[A-Za-z]:", candidate ) > 0
		var resolved = isAbsolute ? candidate : ( cwd & "/" & candidate )
		return resolved.reReplace( "[\/]+$", "" )
	}
}
