/**
 * This is the module descriptor and entry point for your module in the runtime.
 * The unique name of the moduel is the name of the directory on the modules folder.
 * A BoxLang mapping will be created for you with the name of the module.
 *
 * A module can have the following folders that will be automatically registered:
 * + bifs - Custom BIFs that will be registered into the runtime
 * + interceptors - Custom interceptors that will be registered into the runtime via the configure() method
 * + libs - Custom java libraries that your module leverages
 * + tags - Custom tags that will be registered into the runtime
 *
 * Every module will have its own classloader that will be used to load the module libs and dependencies.
 */
class {

	property name="moduleRecord";
	property name="boxRuntime";
	property name="log";

	/**
	 * --------------------------------------------------------------------------
	 * Module Properties
	 * --------------------------------------------------------------------------
	 * Here is where you define the properties of your module that the module service
	 * will use to register and activate your module
	 */

	/**
	 * Your module version. Try to use semantic versioning
	 * @mandatory
	 */
	this.version = "@build.version@+@build.number@";

	/**
	 * The BoxLang mapping for your module.  All BoxLang modules are registered with an internal
	 * mapping prefix of : bxModules.{this.mapping}, /bxmodules/{this.mapping}. Ex: bxModules.test, /bxmodules/test
	 */
	this.mapping = "bxagents";

	/**
	 * Who built the module
	 */
	this.author = "Luis Majano";

	/**
	 * The module description
	 */
	this.description = "Conventions-based AI agent framework for BoxLang, built on ColdBox and BX AI";

	/**
	 * The module web URL
	 */
	this.webURL = "https://www.ortussolutions.com";

	/**
	 * This boolean flag tells the module service to skip the module registration/activation process.
	 */
	this.enabled = true;

    /**
	 * The module dependencies that this module needs to be activated before this module is activated
	 */
	this.dependencies = [];

	/**
	 * --------------------------------------------------------------------------
	 * Module Methods
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Called by the ModuleService on module registration
	 */
	function configure(){
		/**
		 * Every module has a settings configuration object
		 */
		settings = {
			loadedOn : now(),
			loadedBy : "Luis Majano"
		};

		/**
		 * Every module can have a list of object mappings
		 * that can be created by boxLang.  This is a great way
		 * to create objects that can be used by the module
		 * or other modules.
		 * The mappings will be created in the following format:
		 * bxModules.{this.mapping}.{mappingName}
		 * Ex: bxModules.test.MyObject => bxModules.test.models.MyObject
		 */
		objectMappings = {
			// { name="MyObject", class="models.utilities.MyObject" }
		}

		/**
		 * DataSources can be defined by a module and they will be registered
		 * for you in the runtime
		 */
		datasources = {
			// { name="MyDSN", class="coldbox.system.datasources.ColdBoxDataSource", properties={dsn="mydsn"} }
		};

		/**
		 * The module interceptors to register into the runtime.
		 * BX Agents' own `@runtime`-scoped interceptors are added here as they are built (M7).
		 */
		interceptors = [
			// { class="path.to.Interceptor", properties={} }
		];

		/**
		 * A list of custom interception points to register into the runtime
		 */
		customInterceptionPoints = [];
	}

	/**
	 * Called by the ModuleService on module activation
	 */
	function onLoad(){

	}

	/**
	 * Called by the ModuleService on module deactivation
	 */
	function onUnload(){

	}

	/**
	 * --------------------------------------------------------------------------
	 * Module Events
	 * --------------------------------------------------------------------------
	 * You can listen to any runtime events by creating the methods
	 * that match the approved runtime interception points
	 */

	 function afterModuleActivations(){
		// do something
	 }

	/**
	 * --------------------------------------------------------------------------
	 * CLI Entry Point
	 * --------------------------------------------------------------------------
	 * Every BoxLang module may declare `main( args )`; `boxlang module:bxAgents
	 * <verb> ...` invokes it directly. Confirmed against the official
	 * BoxLang_Docs MCP source (`askQuestion`): `args` contains ONLY the
	 * arguments AFTER `module:{name}` - the module name itself is never
	 * included. So args[1] = the verb, args[2..] = the verb's own
	 * flags/positional args. Dispatch itself is CLI-agnostic: raw argv is
	 * parsed once here into a plain options struct, then handed to one thin
	 * dispatcher class per verb under models/cli/ - every one of those is
	 * unit-tested directly against that struct shape, without going through
	 * argv parsing at all (see the build plan's own guidance to skip
	 * argv-parsing minutiae in tests).
	 *
	 * @args The raw CLI argv, module name and dispatch token excluded
	 *
	 * @return The process exit code (0 success, 1 failure)
	 */
	function main( args = [] ) {
		var verbs = {
			"new"     : "bxagents.models.cli.New",
			"build"   : "bxagents.models.cli.Build",
			"serve"   : "bxagents.models.cli.Serve",
			"package" : "bxagents.models.cli.Package",
			"deploy"  : "bxagents.models.cli.Deploy",
			"inspect" : "bxagents.models.cli.Inspect",
			"chat"    : "bxagents.models.cli.Chat",
			"clean"   : "bxagents.models.cli.Clean"
		}

		var verbName = arrayLen( arguments.args ) >= 1 ? arguments.args[ 1 ] : ""

		if ( !len( verbName ) || !verbs.keyExists( verbName ) ) {
			println( "Usage: boxlang module:bxAgents <#verbs.keyArray().sort( 'textnocase' ).toList( '|' )#> [options]" )
			return 1
		}

		var rawVerbArgs = []
		for ( var i = 2; i <= arrayLen( arguments.args ); i++ ) {
			rawVerbArgs.append( arguments.args[ i ] )
		}

		var options = parseCliOptions( rawVerbArgs )
		options.projectRoot = resolveProjectRoot( options )

		try {
			var verbClass = new "#verbs[ verbName ]#"()
			var result = verbClass.run( options )
			if ( len( result.message ?: "" ) ) {
				println( result.message )
			}
			return result.exitCode ?: 0
		} catch ( any e ) {
			println( "Error: #e.message#" )
			return 1
		}
	}

	/**
	 * Parses a verb's own argv (module name + verb already stripped) into a
	 * plain options struct: `--key=value` and `--key value` both set `key`;
	 * a bare `--flag` (no value, or followed by another `--flag`) sets it to
	 * `true`; the first non-flag token becomes `_positional` (used as a
	 * fallback project path by `resolveProjectRoot()`).
	 */
	private struct function parseCliOptions( required array rawArgs ) {
		var options = {}
		var i = 1

		while ( i <= arrayLen( arguments.rawArgs ) ) {
			var token = arguments.rawArgs[ i ]

			if ( token.startsWith( "--" ) ) {
				var body = token.right( len( token ) - 2 )
				var eqPos = body.find( "=" )

				if ( eqPos ) {
					options[ body.left( eqPos - 1 ) ] = body.right( len( body ) - eqPos )
				} else {
					var hasValue = i < arrayLen( arguments.rawArgs ) && !arguments.rawArgs[ i + 1 ].startsWith( "--" )
					if ( hasValue ) {
						options[ body ] = arguments.rawArgs[ i + 1 ]
						i++
					} else {
						options[ body ] = true
					}
				}
			} else if ( !options.keyExists( "_positional" ) ) {
				options[ "_positional" ] = token
			}

			i++
		}

		return options
	}

	/**
	 * Precedence: --projectRoot flag > first positional arg > the shell's
	 * current working directory. A relative value is resolved against the
	 * CWD, never against this module's own file location.
	 */
	private string function resolveProjectRoot( required struct options ) {
		var cwd = getSystemSetting( "user.dir", "" )
		var candidate = len( arguments.options.projectRoot ?: "" )
			? arguments.options.projectRoot
			: ( len( arguments.options._positional ?: "" ) ? arguments.options._positional : "." )

		if ( candidate == "." ) {
			return cwd.reReplace( "[\/]+$", "" )
		}

		var isAbsolute = candidate.startsWith( "/" ) || reFind( "^[A-Za-z]:", candidate ) > 0
		var resolved = isAbsolute ? candidate : ( cwd & "/" & candidate )
		return resolved.reReplace( "[\/]+$", "" )
	}
}
