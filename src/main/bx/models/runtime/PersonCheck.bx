import bxModules.bxagents.models.api.Caller;

/**
 * Whether a person is one the agent knows, for a scheduled run that is to act as them (`runAs`): the local user, an active
 * account of the web app, or anyone who has already talked to the agent (a chat platform user keeps their id). A made up name
 * is refused, so a typo does not run the agent as nobody.
 */
class {

	/**
	 * @store A ChatStore
	 */
	function init( required any store ) {
		variables.store = arguments.store
		return this
	}

	/**
	 * @person The id to check
	 *
	 * @return True when the agent knows them
	 */
	boolean function exists( required string person ) {
		var who = trim( arguments.person )
		if ( !len( who ) ) {
			return false
		}
		if ( who == Caller::localId() ) {
			return true
		}
		if ( variables.store.rows( "SELECT 1 AS found FROM users WHERE username = :name AND isActive = 1", { name : who } ).len() ) {
			return true
		}
		return variables.store.rows( "SELECT 1 AS found FROM conversations WHERE userId = :name LIMIT 1", { name : who } ).len() > 0
	}

}
