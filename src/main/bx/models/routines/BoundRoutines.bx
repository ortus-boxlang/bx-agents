/**
 * The routines of one person, for a command: a RoutineManager with the person already filled in, so a command (which only knows
 * "this conversation's owner") never handles a Caller. It has the same shape as the remote one a terminal gets when it is
 * connected to a server (RemoteRoutines), so a command is written once.
 *
 * Every method answers an Outcome.
 */
class {

	/**
	 * @manager A RoutineManager
	 * @who The Caller the commands act as
	 */
	function init( required any manager, required any who ) {
		variables.manager = arguments.manager
		variables.who = arguments.who
		return this
	}

	/** True for an admin, who may list everyone's routines */
	boolean function isAdmin() {
		return variables.who.isAdmin()
	}

	any function list( boolean all = false ) {
		return variables.manager.list( variables.who, arguments.all )
	}

	any function get( required string ref ) {
		return variables.manager.get( variables.who, arguments.ref )
	}

	any function run( required string ref ) {
		return variables.manager.run( variables.who, arguments.ref )
	}

	any function pause( required string ref ) {
		return variables.manager.pause( variables.who, arguments.ref )
	}

	any function resume( required string ref ) {
		return variables.manager.resume( variables.who, arguments.ref )
	}

	any function delete( required string ref ) {
		return variables.manager.delete( variables.who, arguments.ref )
	}

	any function reports( required string ref ) {
		return variables.manager.reports( variables.who, arguments.ref )
	}

	any function report( required string ref, required string file ) {
		return variables.manager.report( variables.who, arguments.ref, arguments.file )
	}

}
