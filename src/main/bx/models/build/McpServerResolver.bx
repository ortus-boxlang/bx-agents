/**
 * Prepares an agent's `mcpServers` list when the app starts, never at build time.
 *
 * - `${env.NAME}` and `${env.NAME:default}` are replaced everywhere in an entry, so a token, a header or
 *   an environment value stays in the environment and not in the project.
 * - `allowedHosts` (a web server entry) becomes the `urlGuard` function bx-ai asks for: a request to a host
 *   that is not listed is refused before anything is sent.
 * - The programs the stdio servers start are added to bx-ai's `mcp.stdio.allowedCommands` setting, so the
 *   process runs only what the project declared. A setting someone already filled in is left alone.
 * - `oauth` (a web server that asks each person to sign in) gets what bx-ai's OAuth needs and the project cannot
 *   write: the vault token store, so tokens are sealed in the chat database, the person the run belongs to as the
 *   `subject`, and the callback address of the agent API unless the entry names its own `redirectUri`.
 */
class {

	/**
	 * @placeholders Replaces ${env.NAME}; a ToolSelector by default
	 */
	function init( any placeholders ) {
		variables.placeholders = isNull( arguments.placeholders ) ? new "models.build.ToolSelector@bxagents"() : arguments.placeholders
		return this
	}

	/**
	 * @servers The entries: a URL string, a web server struct or a stdio struct ( { command, env, ... } )
	 * @label What the list belongs to, for messages
	 * @context { apiPath : where the agent API is served; vault : a VaultWiring (tests) }
	 *
	 * @return The entries ready for bx-ai's withMCPServers()
	 */
	array function resolve( required array servers, string label = "mcpServers", struct context = {} ) {
		var resolved = []
		// not named `server`: that is a reserved scope
		for ( var listed in arguments.servers ) {
			// each entry on its own, so a secret limited to hosts is checked against THIS server's address
			resolved.append( variables.placeholders.resolvePlaceholders( listed, arguments.label, { host : hostOf( listed ) } ) )
		}
		var executables = []
		for ( var entry in resolved ) {
			if ( !isStruct( entry ) ) {
				continue
			}
			if ( entry.keyExists( "allowedHosts" ) ) {
				entry[ "urlGuard" ] = hostGuard( entry.allowedHosts )
				entry.delete( "allowedHosts" )
			}
			if ( entry.keyExists( "oauth" ) ) {
				entry[ "oauth" ] = oauthOf( entry.oauth, arguments.context )
			}
			if ( entry.keyExists( "command" ) ) {
				executables.append( executableOf( entry.command ) )
			}
		}
		allowCommands( executables )
		return resolved
	}

	/**
	 * @entry One mcpServers entry
	 *
	 * @return The host its URL points to, or blank for a program (stdio) or a bare string that is not a URL
	 */
	private string function hostOf( required any entry ) {
		// not named `url`: that is a reserved scope in a web request
		var address = isStruct( arguments.entry ) ? ( arguments.entry.url ?: "" ) : ( isSimpleValue( arguments.entry ) ? arguments.entry : "" )
		try {
			return len( address ) ? lCase( createObject( "java", "java.net.URI" ).create( address ).getHost() ?: "" ) : ""
		} catch ( any e ) {
			return ""
		}
	}

	/**
	 * @hosts Host names; "*.example.com" matches any subdomain of example.com (not example.com itself)
	 *
	 * @return A function ( url ) => boolean for bx-ai's withUrlGuard()
	 */
	function hostGuard( required any hosts ) {
		var allowed = isArray( arguments.hosts ) ? arguments.hosts.map( host => lCase( trim( toString( host ) ) ) ) : [ lCase( trim( toString( arguments.hosts ) ) ) ]
		return ( url ) => {
			var host = ""
			try {
				host = lCase( createObject( "java", "java.net.URI" ).create( url ).getHost() ?: "" )
			} catch ( any e ) {
				return false
			}
			if ( !len( host ) ) {
				return false
			}
			for ( var pattern in allowed ) {
				if ( pattern == host ) {
					return true
				}
				if ( left( pattern, 2 ) == "*." && host.endsWith( mid( pattern, 2, len( pattern ) ) ) ) {
					return true
				}
			}
			return false
		}
	}


	/**
	 * Fills in the OAuth options bx-ai needs and a project cannot write.
	 *
	 * @oauth `true`, or the entry's `oauth` struct ( { scopes, clientId, clientSecret, clientMetadataUrl, clientName, redirectUri } )
	 * @context { apiPath, wiring }
	 *
	 * @return The struct for bx-ai's `oauth` option: the entry's own keys, plus the vault `store`, a `subject` function and a `redirectUri`
	 */
	private struct function oauthOf( required any oauth, struct context = {} ) {
		var options = isStruct( arguments.oauth ) ? duplicate( arguments.oauth ) : {}
		var wiring = arguments.context.wiring ?: new "models.vault.VaultWiring@bxagents"()
		if ( !options.keyExists( "store" ) ) {
			options[ "store" ] = wiring.tokenStore()
		}
		if ( !options.keyExists( "subject" ) ) {
			options[ "subject" ] = subjectFunction( wiring )
		}
		if ( !len( options.redirectUri ?: "" ) ) {
			options[ "redirectUri" ] = callbackAddress( arguments.context.apiPath ?: "/__bxagents" )
		}
		return options
	}

	/**
	 * @wiring A VaultWiring
	 *
	 * @return A function ( context ) => text: the person a call is made for, "default" when the run has no name
	 */
	private function function subjectFunction( required any wiring ) {
		return ( context ) => {
			var who = wiring.userOf( isStruct( context ) ? ( context.chatRequest ?: "" ) : "" )
			return len( who ) ? who : "default"
		}
	}

	/**
	 * @apiPath Where the agent API is served
	 *
	 * @return The address the provider sends the person back to: BXAGENTS_PUBLIC_URL, the API path and /connect/callback; blank when the app has no public address set
	 */
	private string function callbackAddress( required string apiPath ) {
		var base = trim( getSystemSetting( "BXAGENTS_PUBLIC_URL", "" ) ).reReplace( "/+$", "" )
		return len( base ) ? base & arguments.apiPath & "/connect/callback" : ""
	}

	// ----------------------------------------------------------------------------------

	/**
	 * @command The command array of a stdio server
	 *
	 * @return The program: "uvx", or the full path when it has a directory, as bx-ai matches it
	 */
	private string function executableOf( required any command ) {
		return isArray( arguments.command ) && arguments.command.len() ? toString( arguments.command[ 1 ] ) : ""
	}

	/**
	 * Adds the programs to bx-ai's allow-list, but only when nobody set one: an empty list means "any program"
	 * to bx-ai, and a list we filled in earlier keeps growing as more agents start.
	 */
	private void function allowCommands( required array executables ) {
		var wanted = arguments.executables.filter( name => len( name ) )
		if ( !wanted.len() ) {
			return
		}
		try {
			var settings = getModuleInfo( "bxai" ).settings
			if ( !isStruct( settings.mcp ?: "" ) || !isStruct( settings.mcp.stdio ?: "" ) ) {
				return
			}
			var stdio = settings.mcp.stdio
			if ( !isArray( stdio.allowedCommands ?: "" ) ) {
				return
			}
			var managed = stdio.keyExists( "managedByBxAgents" )
			if ( stdio.allowedCommands.len() && !managed ) {
				return
			}
			stdio[ "managedByBxAgents" ] = true
			for ( var name in wanted ) {
				if ( !stdio.allowedCommands.contains( name ) ) {
					stdio.allowedCommands.append( name )
				}
			}
		} catch ( any e ) {
			// bx-ai is not loaded or has no such setting: nothing to restrict
		}
	}

}
