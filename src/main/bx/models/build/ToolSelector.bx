/**
 * Decides which tools one agent gets. Runs inside the built app, once per agent
 * node, when the generated `GeneratedAgentFactory` assembles its agents.
 *
 * The registry bx-ai keeps (`aiToolRegistry()`) is a CATALOG: a tool being in it
 * only means it is available. An agent gets a tool only when it asks for it:
 *
 *   - its OWN tools, the classes in its `tools/` folder, always; and
 *   - whatever its `tools:` list names. Every name is `item@module`, the same key
 *     bx-ai uses in its registry, so the module part says what must be installed:
 *       now@bxai          one tool from one module
 *       *@bxplaywright    every tool that module has registered (`@bxplaywright` is the same)
 *
 * A bare name (`now`) is an error with a hint, never a guess: bx-ai itself would
 * happily resolve it to whichever module registered a tool of that name first.
 * That is also why lookups here are EXACT on the registry key: bx-ai's `get()`
 * falls back to matching by name alone, so `now@somemodule` could silently
 * resolve to `now@bxai`.
 *
 * Modules BX Agents builds the tools of itself (see ToolModules; bxplaywright) are not
 * taken from the registry: each agent gets a fresh set, configured by its own
 * `toolOptions.<module>`, so two agents never share one browser.
 *
 * An own tool wins over a module tool of the same name (the module tool is
 * dropped and a warning is logged), so a project can override a stock tool by
 * writing its own.
 */
class {

	/**
	 * @adapters Extra or replacement module adapters by module name, for tests (see ToolModules)
	 */
	function init( struct adapters = {} ) {
		variables.modules = new "models.build.ToolModules@bxagents"( arguments.adapters )
		return this
	}

	/**
	 * @names The agent's `tools:` entries, e.g. [ "now@bxai", "*@bxplaywright" ]
	 * @ownTools The agent's own tool objects, from its `tools/` folder
	 * @agentName The agent's name, for messages
	 * @toolOptions The agent's `toolOptions`, keyed by module name
	 *
	 * @return The tool objects to attach to the agent: its own, then the selected ones, each once
	 */
	array function select( required array names, array ownTools = [], string agentName = "", struct toolOptions = {} ) {
		var registry = aiToolRegistry()
		var registryKeys = registry.getKeys()
		var selected = arguments.ownTools.duplicate()
		var seenKeys = {}

		var ownToolNames = {}
		for ( var own in arguments.ownTools ) {
			ownToolNames[ own.getName() ] = true
		}

		var parsedEntries = arguments.names.map( entry => parse( entry, agentName ) )
		checkToolOptions( arguments.toolOptions, parsedEntries, arguments.agentName )

		// A module BX Agents builds the tools of itself (bxplaywright) is asked ONCE per agent,
		// so every entry for it draws from the same fresh set. Nothing else is shared.
		var built = {}

		for ( var i = 1; i <= arguments.names.len(); i++ ) {
			var entry = arguments.names[ i ]
			var parsed = parsedEntries[ i ]
			var catalog = {}
			var catalogKeys = []

			if ( variables.modules.has( parsed.module ) ) {
				if ( !built.keyExists( parsed.module ) ) {
					built[ parsed.module ] = buildModuleCatalog( parsed.module, arguments.toolOptions[ parsed.module ] ?: {}, arguments.agentName )
				}
				catalog = built[ parsed.module ]
				catalogKeys = catalog.keyArray()
				if ( variables.modules.supplements( parsed.module ) ) {
					// the module's registered tools stay available next to the adapter's (bx-ai: now, httpGet, ...)
					catalogKeys = registryKeys.filter( key => !catalog.keyExists( key ) ).append( catalogKeys, true )
				}
			} else {
				catalogKeys = registryKeys
			}

			var keys = []
			if ( parsed.item == "*" ) {
				keys = catalogKeys.filter( key => find( "@", key ) > 0 && listLast( key, "@" ) == parsed.module )
				if ( !keys.len() ) {
					throw(
						type    = "BxAgents.UnknownToolModule",
						message = "#describeAgent( arguments.agentName )# lists [#entry#] but no tools are registered under module [#parsed.module#]. Is the module installed and loaded? #registeredModulesHint( registry )# To add a module to the project, install it in the project root, for example: install-bx-module <name> --local (or `box install <name>`)."
					)
				}
			} else {
				var key = parsed.item & "@" & parsed.module
				if ( !catalogKeys.contains( key ) ) {
					var unknownMessage = "#describeAgent( arguments.agentName )# lists [#entry#] but there is no tool [#key#]. #availableHint( catalogKeys, parsed.module, registry )#"
					throw(
						type    = "BxAgents.UnknownTool",
						message = unknownMessage & supplementHint( parsed )
					)
				}
				keys = [ key ]
			}

			for ( var toolKey in keys ) {
				if ( seenKeys.keyExists( toolKey ) ) {
					continue
				}
				seenKeys[ toolKey ] = true
				var tool = catalog.keyExists( toolKey ) ? catalog[ toolKey ] : registry.get( toolKey )

				if ( ownToolNames.keyExists( tool.getName() ) ) {
					writeLog(
						text : "#describeAgent( arguments.agentName )#: its own tool [#tool.getName()#] wins over [#toolKey#], which was left out.",
						type : "warning",
						file : "bxagents-tools"
					)
					continue
				}

				selected.append( tool )
			}
		}

		return selected
	}

	/**
	 * Tells a missing tool from a module that adds tools of its own (bx-ai's file tools)
	 * what it was probably missing.
	 *
	 * @parsed The parsed `tools:` entry
	 *
	 * @return A sentence to append to the unknown-tool message, or empty
	 */
	private string function supplementHint( required struct parsed ) {
		if ( !variables.modules.has( parsed.module ) || !variables.modules.supplements( parsed.module ) ) {
			return ""
		}
		return " Tools that need folders (the file tools) exist only when `toolOptions.#parsed.module#.allowedPaths` names them, for example allowedPaths: [ tmp, cwd ]."
	}

	/**
	 * Fresh tools for one agent from a module BX Agents builds the tools of itself.
	 *
	 * @module The module name
	 * @options The agent's options for it, placeholders not yet resolved
	 * @agentName The agent's name, for messages
	 *
	 * @return { "name@module" : tool }
	 */
	private struct function buildModuleCatalog( required string module, required struct options, required string agentName ) {
		var adapter = variables.modules.get( arguments.module )
		if ( !adapter.available() ) {
			throw(
				type    = "BxAgents.UnknownToolModule",
				message = "#describeAgent( arguments.agentName )# lists tools from module [#arguments.module#] but it is not loaded. Install it in the project root, for example: install-bx-module bx-playwright --local (or `box install bx-playwright`)"
			)
		}
		var catalog = {}
		for ( var tool in adapter.tools( resolvePlaceholders( arguments.options, arguments.module ) ) ) {
			catalog[ tool.getName() & "@" & arguments.module ] = tool
		}
		return catalog
	}

	/**
	 * Every `toolOptions` key must name a module the agent lists tools from, and that
	 * module must take options.
	 *
	 * @toolOptions The agent's `toolOptions`
	 * @parsedEntries The parsed `tools:` entries
	 * @agentName The agent's name, for messages
	 */
	private void function checkToolOptions( required struct toolOptions, required array parsedEntries, required string agentName ) {
		var listed = {}
		for ( var parsed in arguments.parsedEntries ) {
			listed[ parsed.module ] = true
		}
		for ( var module in arguments.toolOptions ) {
			if ( !listed.keyExists( module ) ) {
				throw(
					type    = "BxAgents.InvalidToolOptions",
					message = "#describeAgent( arguments.agentName )# has toolOptions for [#module#] but lists no tool from that module in `tools`."
				)
			}
			if ( !variables.modules.has( module ) ) {
				throw(
					type    = "BxAgents.InvalidToolOptions",
					message = "#describeAgent( arguments.agentName )# has toolOptions for [#module#], which takes no options."
				)
			}
			var problems = variables.modules.get( module ).validateOptions( arguments.toolOptions[ module ] )
			if ( problems.len() ) {
				throw(
					type    = "BxAgents.InvalidToolOptions",
					message = "#describeAgent( arguments.agentName )# toolOptions [#module#]: #problems.toList( '; ' )#"
				)
			}
		}
	}

	/**
	 * Replace ${env.NAME} and ${env.NAME:default} in every text value, so a secret or a
	 * per-machine setting lives in the environment and not in the project. Resolved
	 * when the app starts, never at build time.
	 *
	 * @value A struct, array or simple value
	 * @module The module name, for messages
	 *
	 * @return The same shape with the placeholders replaced
	 */
	any function resolvePlaceholders( required any value, string module = "" ) {
		var input = arguments.value
		var owner = arguments.module
		if ( isStruct( input ) ) {
			var result = {}
			for ( var key in input ) {
				result[ key ] = resolvePlaceholders( input[ key ], owner )
			}
			return result
		}
		if ( isArray( input ) ) {
			return input.map( item => resolvePlaceholders( item, owner ) )
		}
		if ( !isSimpleValue( input ) || isNumeric( input ) || isBoolean( input ) ) {
			return input
		}
		var text = input
		var match = reFind( "\$\{env\.([A-Za-z0-9_]+)(:([^}]*))?\}", text, 1, true )
		while ( match.pos[ 1 ] > 0 ) {
			var name = text.mid( match.pos[ 2 ], match.len[ 2 ] )
			var hasDefault = match.pos.len() >= 3 && match.pos[ 3 ] > 0
			var fallback = hasDefault ? text.mid( match.pos[ 4 ], match.len[ 4 ] ) : ""
			var found = getSystemSetting( name, hasDefault ? fallback : "__bxagents_unset__" )
			if ( found == "__bxagents_unset__" ) {
				throw(
					type    = "BxAgents.MissingToolOption",
					message = "#find( ' ', owner ) ? owner : 'toolOptions [' & owner & ']'# uses ${env.#name#} but the environment variable #name# is not set. Set it, or give a default: ${env.#name#:default}"
				)
			}
			var before = match.pos[ 1 ] > 1 ? text.left( match.pos[ 1 ] - 1 ) : ""
			var afterStart = match.pos[ 1 ] + match.len[ 1 ]
			var after = afterStart <= len( text ) ? text.mid( afterStart, len( text ) - afterStart + 1 ) : ""
			text = before & found & after
			match = reFind( "\$\{env\.([A-Za-z0-9_]+)(:([^}]*))?\}", text, match.pos[ 1 ] + len( found ), true )
		}
		return text
	}

	/**
	 * Split one `tools:` entry into its item and module, rejecting anything malformed.
	 *
	 * @entry One entry, e.g. "now@bxai", "*@bxplaywright" or "@bxplaywright"
	 * @agentName The agent's name, for messages
	 *
	 * @return { item, module } - item is "*" for a whole module
	 */
	struct function parse( required any entry, string agentName = "" ) {
		var text = isSimpleValue( arguments.entry ) ? trim( arguments.entry ) : ""

		if ( !len( text ) ) {
			throw(
				type    = "BxAgents.InvalidToolName",
				message = "#describeAgent( arguments.agentName )# has an empty or non-text entry in `tools`."
			)
		}

		if ( !find( "@", text ) ) {
			throw(
				type    = "BxAgents.InvalidToolName",
				message = "#describeAgent( arguments.agentName )# lists the bare tool name [#text#]. Write it as item@module, for example #text#@bxai, or *@module for every tool a module provides."
			)
		}

		var item = listFirst( text, "@" )
		var module = listRest( text, "@" )
		if ( text.left( 1 ) == "@" ) {
			item = "*"
			module = text.mid( 2, len( text ) )
		}

		if ( !len( module ) || find( "@", module ) || !reFind( "^[A-Za-z0-9_.-]+$", module ) || ( item != "*" && !reFind( "^[A-Za-z0-9_.-]+$", item ) ) ) {
			throw(
				type    = "BxAgents.InvalidToolName",
				message = "#describeAgent( arguments.agentName )# has the malformed tool entry [#text#]. Use item@module or *@module."
			)
		}

		return { "item" : item, "module" : module }
	}

	/**
	 * @agentName The agent's name, possibly blank
	 *
	 * @return "Agent [name]" for messages
	 */
	private string function describeAgent( string agentName = "" ) {
		return len( arguments.agentName ) ? "Agent [#arguments.agentName#]" : "An agent"
	}

	/**
	 * @registry The tool registry
	 *
	 * @return A hint naming the modules that do have tools registered
	 */
	private string function registeredModulesHint( required any registry ) {
		// Built from the keys: bx-ai's own getModules() throws on a non-empty registry
		// (it tests `!module.isEmpty` without calling it).
		var modules = arguments.registry.getKeys()
			.filter( key => find( "@", key ) )
			.map( key => listLast( key, "@" ) )
			.unique()
		if ( !arrayLen( modules ) ) {
			return "No module has registered any tool."
		}
		return "Modules with registered tools: " & modules.sort( "text" ).toList( ", " ) & "."
	}

	/**
	 * @registryKeys Every key in the registry
	 * @module The module the missing tool was asked for in
	 * @registry The tool registry
	 *
	 * @return A hint naming what the module does provide, or which modules exist
	 */
	private string function availableHint( required array registryKeys, required string module, required any registry ) {
		var inModule = arguments.registryKeys.filter( key => find( "@", key ) && listLast( key, "@" ) == module )
		if ( inModule.len() ) {
			return "Tools in [#arguments.module#]: #inModule.sort( 'text' ).toList( ', ' )#."
		}
		return "No tools are registered under module [#arguments.module#] - is it installed and loaded? #registeredModulesHint( arguments.registry )#"
	}

}
