/**
 * Picks a ForgeBox version for the range a `box.json` dependency asks for.
 *
 * Versions look like `7.2.2`, `7.2.2+23` (build number), `1.0.0-snapshot` (pre-release).
 * Ranges, the subset of the usual semver syntax a `box.json` uses:
 *
 *   *  or  latest  or empty   the newest release (a pre-release only when no release exists)
 *   1.2.3  or  =1.2.3         exactly that version (a pre-release such as 1.0.0-snapshot is asked for by name)
 *   ^1.2.3                    >=1.2.3 <2.0.0   (^0.2.3 is <0.3.0, ^0.0.3 is <0.0.4)
 *   ~1.2.3                    >=1.2.3 <1.3.0
 *   1  1.x  1.2  1.2.x        any release in that major, or major.minor
 *   >=1.0.0 <2.0.0            comparators, all must hold (space separated)
 *   ^1 || ^3                  alternatives
 *
 * Pre-releases are never picked for a range, only by exact name or as the last resort of `*`.
 * Build metadata (`+23`) is ignored when comparing, and only breaks a tie between equal versions
 * (the higher build wins).
 */
class {

	/**
	 * @version A version string
	 *
	 * @return { major, minor, patch, pre : [ identifiers ], build : numeric, raw }
	 */
	struct function parse( required string version ) {
		var text = trim( arguments.version )
		var match = text.reFind( "^v?(\d+)(?:\.(\d+))?(?:\.(\d+))?(?:-([0-9A-Za-z.\-]+))?(?:\+([0-9A-Za-z.\-]+))?$", 1, true )
		if ( match.pos[ 1 ] == 0 ) {
			throw( type = "BxAgents.InvalidVersion", message = "[#arguments.version#] is not a version (expected something like 1.2.3, 1.2.3+4 or 1.0.0-snapshot)" )
		}
		var part = ( index ) => ( match.pos.len() >= index && match.pos[ index ] > 0 ) ? text.mid( match.pos[ index ], match.len[ index ] ) : ""
		var buildText = part( 6 )
		return {
			major : val( part( 2 ) ),
			minor : val( part( 3 ) ),
			patch : val( part( 4 ) ),
			pre   : len( part( 5 ) ) ? listToArray( part( 5 ), "." ) : [],
			build : isNumeric( buildText ) ? val( buildText ) : 0,
			raw   : text
		}
	}

	/**
	 * @a A version string
	 * @b A version string
	 *
	 * @return -1, 0 or 1; build metadata is only used when everything else is equal
	 */
	numeric function compare( required string a, required string b ) {
		var left = parse( arguments.a )
		var right = parse( arguments.b )
		for ( var field in [ "major", "minor", "patch" ] ) {
			if ( left[ field ] != right[ field ] ) {
				return left[ field ] < right[ field ] ? -1 : 1
			}
		}
		var byPre = comparePre( left.pre, right.pre )
		if ( byPre != 0 ) {
			return byPre
		}
		return left.build == right.build ? 0 : ( left.build < right.build ? -1 : 1 )
	}

	/**
	 * @version A version string
	 * @range A range (see the class docs)
	 *
	 * @return True when the version is inside the range; a pre-release only matches a range that names it exactly
	 */
	boolean function satisfies( required string version, string range = "*" ) {
		var candidate = parse( arguments.version )
		var text = trim( arguments.range )
		if ( isAny( text ) ) {
			return candidate.pre.isEmpty()
		}
		for ( var alternative in text.split( "\s*\|\|\s*" ) ) {
			if ( satisfiesAll( candidate, trim( alternative ) ) ) {
				return true
			}
		}
		return false
	}

	/**
	 * @versions The versions on offer, any order
	 * @range A range (see the class docs)
	 *
	 * @return The best matching version string exactly as given, or "" when none matches
	 */
	string function pick( required array versions, string range = "*" ) {
		var text = trim( arguments.range )
		var matches = arguments.versions.filter( v => satisfies( v, text ) )
		if ( !matches.len() && isAny( text ) ) {
			// nothing but pre-releases on offer: the newest of them
			matches = arguments.versions.slice( 1 )
		}
		if ( !matches.len() ) {
			return ""
		}
		var best = matches[ 1 ]
		for ( var candidate in matches ) {
			if ( compare( candidate, best ) > 0 ) {
				best = candidate
			}
		}
		return best
	}

	// ------------------------------------------------------------------------

	private boolean function isAny( required string range ) {
		return !len( arguments.range ) || arguments.range == "*" || arguments.range == "latest"
	}

	private boolean function satisfiesAll( required struct candidate, required string clause ) {
		if ( !len( arguments.clause ) ) {
			return false
		}
		for ( var comparator in arguments.clause.split( "\s+" ) ) {
			if ( !satisfiesComparator( arguments.candidate, comparator ) ) {
				return false
			}
		}
		return true
	}

	private boolean function satisfiesComparator( required struct candidate, required string comparator ) {
		var text = arguments.comparator
		var operator = ""
		var operatorMatch = text.reFind( "^(\^|~|>=|<=|>|<|=)", 1, true )
		if ( operatorMatch.pos[ 1 ] > 0 ) {
			operator = text.mid( 1, operatorMatch.len[ 1 ] )
			text = text.mid( operatorMatch.len[ 1 ] + 1, len( text ) )
		}

		// 1, 1.x, 1.2, 1.2.* : a partial or wildcard version, with no operator
		var segments = text.reReplace( "^v", "" ).split( "\." )
		var isPartial = !text.reFind( "[-+]" ) && ( segments.len() < 3 || segments.some( s => s.reFind( "^[xX*]$" ) ) )
		if ( !operator.len() && isPartial ) {
			if ( arguments.candidate.pre.len() ) {
				return false
			}
			for ( var i = 1; i <= segments.len(); i++ ) {
				if ( !segments[ i ].reFind( "^[xX*]$" ) && arguments.candidate[ [ "major", "minor", "patch" ][ i ] ] != val( segments[ i ] ) ) {
					return false
				}
			}
			return true
		}

		var base = parse( text.reReplaceNoCase( "\.[x*]", "", "all" ) )

		if ( operator == "" || operator == "=" ) {
			return arguments.candidate.pre.toList( "." ) == base.pre.toList( "." )
				&& compareCore( arguments.candidate, base ) == 0
				&& ( !arguments.candidate.build || !base.build || arguments.candidate.build == base.build )
		}

		// Ranges never reach pre-releases
		if ( arguments.candidate.pre.len() ) {
			return false
		}
		switch ( operator ) {
			case ">=":
				return compareCore( arguments.candidate, base ) >= 0
			case ">":
				return compareCore( arguments.candidate, base ) > 0
			case "<=":
				return compareCore( arguments.candidate, base ) <= 0
			case "<":
				return compareCore( arguments.candidate, base ) < 0
			case "~":
				return compareCore( arguments.candidate, base ) >= 0 && compareCore( arguments.candidate, tildeCeiling( base, text ) ) < 0
			case "^":
				return compareCore( arguments.candidate, base ) >= 0 && compareCore( arguments.candidate, caretCeiling( base, text ) ) < 0
		}
		return false
	}

	/** major.minor.patch only, ignoring pre-release and build */
	private numeric function compareCore( required struct a, required struct b ) {
		for ( var field in [ "major", "minor", "patch" ] ) {
			if ( arguments.a[ field ] != arguments.b[ field ] ) {
				return arguments.a[ field ] < arguments.b[ field ] ? -1 : 1
			}
		}
		return 0
	}

	/** The first version a ~ range does not reach: ~1.2.3 stops at 1.3.0, ~1 at 2.0.0 */
	private struct function tildeCeiling( required struct base, required string written ) {
		var segments = listLen( arguments.written, "." )
		return segments >= 2
			? { major : arguments.base.major, minor : arguments.base.minor + 1, patch : 0 }
			: { major : arguments.base.major + 1, minor : 0, patch : 0 }
	}

	/** The first version a ^ range does not reach: the leftmost non-zero part is the one that must not change */
	private struct function caretCeiling( required struct base, required string written ) {
		var segments = listLen( arguments.written, "." )
		if ( arguments.base.major > 0 || segments == 1 ) {
			return { major : arguments.base.major + 1, minor : 0, patch : 0 }
		}
		if ( arguments.base.minor > 0 || segments == 2 ) {
			return { major : 0, minor : arguments.base.minor + 1, patch : 0 }
		}
		return { major : 0, minor : 0, patch : arguments.base.patch + 1 }
	}

	/** semver pre-release precedence: no pre-release beats any; numbers compare numerically and sort below text */
	private numeric function comparePre( required array a, required array b ) {
		if ( !arguments.a.len() && !arguments.b.len() ) {
			return 0
		}
		if ( !arguments.a.len() ) {
			return 1
		}
		if ( !arguments.b.len() ) {
			return -1
		}
		var shared = min( arguments.a.len(), arguments.b.len() )
		for ( var i = 1; i <= shared; i++ ) {
			var left = arguments.a[ i ]
			var right = arguments.b[ i ]
			if ( left == right ) {
				continue
			}
			var leftNumeric = isNumeric( left )
			var rightNumeric = isNumeric( right )
			if ( leftNumeric && rightNumeric ) {
				return val( left ) < val( right ) ? -1 : 1
			}
			if ( leftNumeric != rightNumeric ) {
				return leftNumeric ? -1 : 1
			}
			return compareNoCase( left, right ) < 0 ? -1 : 1
		}
		return arguments.a.len() == arguments.b.len() ? 0 : ( arguments.a.len() < arguments.b.len() ? -1 : 1 )
	}

}
