/**
 * Puts the `web/` folders of a project's folder extensions into the web page's mount, and says which files the page
 * should link.
 *
 *   extensions/acme/web/panel.css, panel.js, logo.png   ->   <mount>/ext/acme/panel.css, panel.js, logo.png
 *
 * Every file under `web/` is served from `<path>/ext/<name>/`, in folders too. The `*.css` and `*.js` files that sit
 * directly in `web/` are linked into the page (styles in the head, scripts at the end of the body, in file name order),
 * so the page has the `bxagents` script object by the time they run. An extension turned off by name in
 * `extensions.disable` brings nothing. Single-file extensions have no folder, so they bring nothing here.
 */
class {

	/**
	 * @projectRoot The project's folder
	 * @mountDir The folder the web page is written into (`<app>/<path>`)
	 * @path The page's URL path, such as "/chat" or ""
	 * @disable The `extensions.disable` entries
	 *
	 * @return { styles, scripts, extensions } - the HTML to put in the page, and the extensions that brought files
	 */
	struct function copy( required string projectRoot, required string mountDir, required string path, array disable = [] ) {
		var found = { styles : [], scripts : [], extensions : [] }
		var source = arguments.projectRoot & "/extensions"
		if ( !directoryExists( source ) ) {
			return finish( found )
		}
		var settings = new "models.extensions.ExtensionSettings@bxagents"()
		var names = directoryList( source, false, "name", "", "name" ).filter( name => !name.startsWith( "." ) )
		for ( var name in names ) {
			var web = source & "/" & name & "/web"
			if ( !directoryExists( web ) || isDisabled( settings, arguments.disable, name ) ) {
				continue
			}
			directoryCopy( web, arguments.mountDir & "/ext/" & name, true )
			found.extensions.append( name )
			var base = arguments.path & "/ext/" & name & "/"
			for ( var file in directoryList( web, false, "name", "", "name" ) ) {
				if ( !fileExists( web & "/" & file ) ) {
					continue
				}
				var href = encodeForHTML( base & file )
				if ( file.lCase().endsWith( ".css" ) ) {
					found.styles.append( '<link rel="stylesheet" href="#href#">' )
				} else if ( file.lCase().endsWith( ".js" ) ) {
					found.scripts.append( '<script src="#href#"></script>' )
				}
			}
		}
		return finish( found )
	}

	// ----------------------------------------------------------------------------------

	private struct function finish( required struct found ) {
		return {
			styles     : arguments.found.styles.toList( char( 10 ) ),
			scripts    : arguments.found.scripts.toList( char( 10 ) ),
			extensions : arguments.found.extensions
		}
	}

	/**
	 * Only a name or glob turns an extension off as a whole; `extension:item` entries turn off one thing of it.
	 */
	private boolean function isDisabled( required any settings, required array disable, required string name ) {
		for ( var pattern in arguments.disable ) {
			if ( !pattern.contains( ":" ) && arguments.settings.matches( pattern, arguments.name ) ) {
				return true
			}
		}
		return false
	}

}
