/**
 * Writes `handlers/AgentApi.bx` into the generated app: every action of the agent API
 * on the always-on /__bxagents path (see RouterGenerator, which registers the routes that call it).
 *
 * The handler is a real BoxLang class kept in generators/agentapi/AgentApi.bx so it is compiled and
 * checked with the rest of the module; this class only stamps the access mode and the offered profiles into a copy. Who may call is decided
 * before the handler runs, by the route middleware (see RouterGenerator and models.api.Authenticator).
 */
import bxModules.bxagents.models.util.Strings;
import bxModules.bxagents.models.api.AccessMode;
import bxModules.bxagents.models.api.ApiPath;
import bxModules.bxagents.models.api.Guards;
import bxModules.bxagents.models.api.ExposureWarning;

class {

	/**
	 * @appDir The generated app folder
	 * @agentApi The root project's `agentApi` config - `{ enabled, tokenEnvVar, tokens }`, all optional
	 *
	 * @return { written : boolean, path : string } - written is false when `agentApi.enabled` is false
	 */
	struct function generate( required string appDir, struct agentApi = {} ) {
		// what `serve` needs to know about the API without reading the handler: see models.api.ExposureWarning
		directoryCreate( path = arguments.appDir.reReplace( "[\/]+$", "" ) & "/config", createPath = true, ignoreExists = true )
		fileWrite(
			arguments.appDir.reReplace( "[\/]+$", "" ) & "/" & ExposureWarning::fileName(),
			jsonSerialize( { "enabled" : arguments.agentApi.enabled ?: true, "access" : AccessMode::of( arguments.agentApi ), "path" : ApiPath::of( arguments.agentApi ), "restricted" : Guards::hasAddresses( arguments.agentApi ) } )
		)
		if ( !( arguments.agentApi.enabled ?: true ) ) {
			return { written : false, path : "" }
		}
		var handlerDir = arguments.appDir.reReplace( "[\/]+$", "" ) & "/handlers"
		directoryCreate( path = handlerDir, createPath = true, ignoreExists = true )

		var source = fileRead( getDirectoryFromPath( getCurrentTemplatePath() ) & "agentapi/AgentApi.bx", "UTF-8" )
		source = stamp( source, "__ACCESS__", AccessMode::of( arguments.agentApi ) )
		source = stamp( source, "__API_PATH__", ApiPath::of( arguments.agentApi ) )
		source = stamp( source, "__MANAGE_TOKENS__", ( arguments.agentApi.manageTokens ?: false ) == true ? "true" : "false" )
		// the allow-list as JSON inside a string, parsed when the handler asks for it
		source = stamp( source, "__PROFILES__", Strings::bxLiteral( jsonSerialize( ( arguments.agentApi.profiles ?: [] ).map( p => toString( p ) ) ) ) )

		var path = handlerDir & "/AgentApi.bx"
		fileWrite( path, source )
		return { written : true, path : path }
	}

	/**
	 * Puts a setting into the handler, in the one place its template keeps a quoted marker for it.
	 *
	 * @source The template
	 * @marker The marker's name, kept in the template as "name"
	 * @value What goes between the quotes, already safe for a string
	 */
	private string function stamp( required string source, required string marker, required string value ) {
		var quoted = '"#arguments.marker#"'
		if ( !arguments.source.find( quoted ) ) {
			throw( type = "BxAgents.AgentApiTemplateBroken", message = "agentapi/AgentApi.bx has lost its #arguments.marker# marker" )
		}
		return arguments.source.replace( quoted, '"' & arguments.value & '"' )
	}

}
