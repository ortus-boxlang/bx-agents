/**
 * GENERATED FILE - produced by BX Agents' build pipeline.
 * Do not edit by hand; rebuilding your project overwrites this file.
 *
 * Every action of the agent API, on the always-on route /__bxagents and on the path of any gateway that
 * exposes the agent: a whole turn (invoke), many (batch), a stream (stream), a stream that also reports tool
 * calls and pauses for approval (events), stopping a run (cancel), steering a run (steer), the approval round
 * trip (pending, resume), conversations, notes and commands.
 *
 * Each action only reads the request, asks the AgentService (models.api) and sends what it answers; the
 * work itself is written once, there, for the web page, the terminal and the gateways alike.
 *
 * Who may call is decided before an action runs: with agentApi.access token the route middleware
 * (models.api.Authenticator) names the caller from the x-bxagents-token header or answers 401, and an
 * open API makes everyone the one `local` user.
 */
class {

	// ----------------------------------------------------------------------------------
	// Who is calling
	// ----------------------------------------------------------------------------------

	/**
	 * Every action starts with this: it answers 401 and returns true when the caller is not allowed, so the
	 * action stops. When the API needs a token the route middleware has already refused a caller who has none,
	 * so this is the second lock on the same door.
	 */
	private boolean function refused( required any event ) {
		if ( !isNull( callerOf( arguments.event ) ) ) {
			return false
		}
		answer( arguments.event, new "models.api.Authenticator@bxagents"().refusal() )
		return true
	}

	/**
	 * "open" (everyone is the one local user) or "token" (the route middleware names the caller), from agentApi.access.
	 */
	private string function accessMode() {
		return "__ACCESS__"
	}

	/**
	 * Who is calling: the Caller the route middleware put on the request, or on an open API the one local user.
	 * Null when the API needs a token and nobody named one.
	 */
	private function callerOf( required any event ) {
		if ( arguments.event.privateValueExists( "bxagentsCaller" ) ) {
			return arguments.event.getPrivateValue( "bxagentsCaller" )
		}
		if ( accessMode() == "open" ) {
			var everyone = service().localCaller( new "models.api.Authenticator@bxagents"().sourceOf( getHTTPRequestData( false ).headers ) )
			arguments.event.setPrivateValue( "bxagentsCaller", everyone )
			return everyone
		}
		return nullValue()
	}

	// ----------------------------------------------------------------------------------
	// The service, and answering
	// ----------------------------------------------------------------------------------

	private function agent() {
		return getInstance( "GeneratedAgent" )
	}

	/**
	 * The one service behind every action: turns, conversations, notes, preferences and commands.
	 */
	private function service() {
		// once per request: the probe for the shared database is a query
		if ( !request.keyExists( "bxagentsService" ) ) {
			request[ "bxagentsService" ] = new "models.api.AgentService@bxagents"( agent(), sharedStore(), offered(), { manageTokens : manageTokens() } )
		}
		return request.bxagentsService
	}

	/**
	 * The shared chat database, or null when the server has none (then there is no conversation list).
	 */
	private function sharedStore() {
		try {
			var store = new "models.store.ChatStore@bxagents"( "" )
			store.rows( "SELECT 1 AS found FROM conversations LIMIT 1" )
			return store
		} catch ( any e ) {
			return nullValue()
		}
	}

	/** Where this build serves the API, as agentApi.path (or the default) set it */
	private string function apiPath() {
		return "__API_PATH__"
	}

	/**
	 * Whether an admin may manage access tokens over this API (agentApi.manageTokens), as the build stamped it in.
	 */
	private boolean function manageTokens() {
		return "__MANAGE_TOKENS__" == "true"
	}

	/**
	 * The profiles a caller may ask for with options.profile: agentApi.profiles, none by default. A profile
	 * is a model the server pays for, so the caller never picks one the app did not list.
	 */
	private function offered() {
		return new "models.runtime.OfferedProfiles@bxagents"( jsonDeserialize( "__PROFILES__" ) )
	}

	/**
	 * @data What the call produced
	 *
	 * @return A worked Outcome
	 */
	private function done( any data = {} ) {
		return new "models.api.Outcome@bxagents"( ok = true, data = arguments.data )
	}

	/**
	 * @code A name from ApiEdge's list, such as `not_found`
	 * @reason What to tell the person
	 *
	 * @return A failed Outcome
	 */
	private function failed( required string code, string reason = "" ) {
		return new "models.api.Outcome@bxagents"( ok = false, code = arguments.code, reason = arguments.reason )
	}

	/**
	 * Sends an Outcome: its data with success, or the code and reason with the status the code means.
	 */
	private void function answer( required any event, required any outcome ) {
		var edge = new "models.api.ApiEdge@bxagents"()
		arguments.event.renderData( type : "json", statusCode : edge.statusFor( arguments.outcome ), data : edge.bodyFor( arguments.outcome ) )
	}

	/**
	 * Sends what an AgentConversation answers, { ok, reason? ... }: the answer with success, 400 and the reason when it did not work.
	 */
	private void function answerResult( required any event, required struct result ) {
		answer( arguments.event, new "models.api.Outcome@bxagents"().fromResult( arguments.result ) )
	}

	/**
	 * ColdBox calls this when a route is reached with a verb it does not take (a GET to a route that is POST only). It
	 * would otherwise answer with an HTML error page; every answer of this API is JSON.
	 */
	function onInvalidHTTPMethod( event, rc, prc, faultAction = "", eventArguments = {} ) {
		answer( event, failed( "method_not_allowed", "That route does not take " & event.getHTTPMethod() ) )
	}

	private function noSessions() {
		return failed( "not_found", "This server keeps no list of conversations" )
	}

	/**
	 * The caller's conversation to act on, or null after answering 400 or 404. With mustExist the conversation has to be in
	 * the list already (reading it); without, one nobody has spoken in yet will do (naming it, copying it).
	 */
	private function conversationOf( required any event, required string conversationId, boolean mustExist = true ) {
		var all = service().conversations()
		if ( isNull( all ) ) {
			answer( arguments.event, noSessions() )
			return nullValue()
		}
		var caller = callerOf( arguments.event )
		if ( arguments.mustExist ) {
			var opened = all.open( caller, arguments.conversationId )
			if ( !opened.succeeded() ) {
				answer( arguments.event, opened )
				return nullValue()
			}
		} else if ( !len( arguments.conversationId ) ) {
			answer( arguments.event, failed( "bad_request", "conversationId is required" ) )
			return nullValue()
		}
		return service().conversation( caller, arguments.conversationId )
	}

	// ----------------------------------------------------------------------------------
	// Profiles and the agent
	// ----------------------------------------------------------------------------------

	/**
	 * The profiles this route offers: { profiles : [ { name, description, provider, model, isDefault } ] }, empty when
	 * agentApi.profiles lists none. Never a key, and never a profile that is not on the list.
	 */
	function profiles( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, done( { "profiles" : offered().list() } ) )
	}

	/**
	 * This API described as an OpenAPI 3 document: every route, what it takes and gives, and the frames of a stream.
	 * Sent as the document itself, not wrapped in an answer, so a tool that reads OpenAPI can be pointed at it.
	 */
	function openapi( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		event.renderData( type : "json", data : service().apiDocument( apiPath(), accessMode() ) )
	}

	/**
	 * Whether the server is up: { status : "ok" }. Open to anyone, even when the API needs a token, and says nothing else, so a
	 * load balancer or a script can check on it.
	 */
	function health( event, rc, prc ) {
		answer( event, done( { "status" : "ok" } ) )
	}

	/**
	 * A file of an extension's web/ folder, read from the extension itself: <page path>/ext/<extension>/<file>. The page links these,
	 * so like the page's own files they are not behind the sign-in. Anything that is not a plain file inside that folder is a 404.
	 */
	function extensionFile( event, rc, prc ) {
		var appDir = getCanonicalPath( getDirectoryFromPath( getCurrentTemplatePath() ) & ".." )
		var file = new "models.extensions.ExtensionWebFiles@bxagents"( appDir ).find( rc.extension ?: "", rc.file ?: "" )
		if ( !len( file ) ) {
			event.renderData( type: "text", data: "Not found", statusCode: 404 )
			return
		}
		event.sendFile( file: file, disposition: "inline" )
	}

	/**
	 * Who the agent is, for a client's banner: name, a short model label and what it can do.
	 */
	function about( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, service().about( callerOf( event ) ) )
	}

	/**
	 * The names of the tools the agent has.
	 */
	function tools( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var config = agent().getConfig()
		answer( event, done( { "tools" : config.tools ?: [], "count" : config.toolCount ?: 0 } ) )
	}

	/**
	 * What is in the caller's context for one conversation: the system prompt, the tool definitions, the notes and the
	 * messages, as estimated sizes (see models.chat.ContextReport). Nothing is sent to a model.
	 *
	 * Query: conversationId
	 */
	function context( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, done( service().conversation( callerOf( event ), rc.conversationId ?: "" ).contextReport() ) )
	}

	/**
	 * What the extensions' status items say for one conversation: { items : [ { name, text } ] }. An
	 * item with nothing to say is left out. Query: conversationId
	 */
	function status( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var conversation = service().conversation( callerOf( event ), rc.conversationId ?: "" )
		answer( event, done( { "items" : new "models.extensions.ServedStatus@bxagents"().items( conversation ) } ) )
	}

	/**
	 * What the extensions' slots hold for one conversation: { items : [ { id, extension, place, html, text } ] }.
	 * A slot with nothing to show is left out. Query: conversationId
	 */
	function slots( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var conversation = service().conversation( callerOf( event ), rc.conversationId ?: "" )
		answer( event, done( { "items" : new "models.extensions.ServedSlots@bxagents"().items( conversation ) } ) )
	}

	/**
	 * Tests a model with one tiny question: { ok, model, ms, reply } or { ok : false, model, reason }. A profile is
	 * only used when the route offers it (agentApi.profiles); without one the server's own model is tested.
	 *
	 * Body: { profile? }
	 */
	function ping( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		var result = service().conversation( callerOf( event ) ).ping( body.profile ?: "" )
		result[ "success" ] = result.ok ?: false
		event.renderData( type : "json", data : result )
	}

	// ----------------------------------------------------------------------------------
	// Turns
	// ----------------------------------------------------------------------------------

	/**
	 * One whole turn: { output, threadId, success }. Body: { input, threadId?, conversationId?, params?, options?, attachments? }
	 */
	function invoke( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var answered = service().turns().run( callerOf( event ), event.getHTTPContent( json : true ) )
		if ( answered.succeeded() ) {
			event.setHTTPHeader( name : "X-Thread-Id", value : answered.data().threadId )
		}
		answer( event, answered )
	}

	/**
	 * Many turns on one thread: { outputs : [ { output, success } | { error, success : false } ], threadId }.
	 * Body: { inputs : [ ... ], params?, options? }
	 */
	function batch( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, service().turns().batch( callerOf( event ), event.getHTTPContent( json : true ) ) )
	}

	/**
	 * One turn as a stream of the frames thread, chunk and done (and error). The same body as invoke. Use events
	 * for a stream that also reports tool calls and pauses for approval.
	 */
	function stream( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var prepared = service().turns().prepareTurn( callerOf( event ), event.getHTTPContent( json : true ) )
		if ( !prepared.succeeded() ) {
			answer( event, prepared )
			return
		}
		event.setHTTPHeader( name : "X-Thread-Id", value : prepared.data().threadId )
		return streamTurn( prepared.data(), [ "thread", "chunk", "done", "error" ] )
	}

	/**
	 * What is served here: { name, description, pattern, endpoints }.
	 */
	function info( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var config = agent().getConfig()
		// ColdBox gives the routed path without its leading slash
		var pattern = "/" & reReplace( event.getCurrentRoutedURL(), "(^/+|/info/?$)", "", "all" )
		answer( event, done( {
			"name"        : config.name ?: "",
			"description" : config.description ?: "",
			"pattern"     : pattern,
			"endpoints"   : [
				{ "verb" : "POST", "path" : pattern & "/invoke", "description" : "Synchronous execution" },
				{ "verb" : "POST", "path" : pattern & "/stream", "description" : "Streaming SSE execution" },
				{ "verb" : "POST", "path" : pattern & "/batch", "description" : "Batch execution" },
				{ "verb" : "GET", "path" : pattern & "/info", "description" : "Endpoint metadata" }
			]
		} ) )
	}

	/**
	 * Streams one turn with everything it does. The frames are thread, chunk, done and:
	 *
	 *   tool       { id, name, arguments, status : "running" | "ok", ms }
	 *   suspended  { threadId, pendingActions : [ { toolName, toolArgs } ] } when the run waits for a human
	 *   error      { message }
	 *
	 * Body: { input, threadId?, conversationId?, params?, options?, attachments? }
	 */
	function events( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var prepared = service().turns().prepareTurn( callerOf( event ), event.getHTTPContent( json : true ) )
		if ( !prepared.succeeded() ) {
			answer( event, prepared )
			return
		}
		event.setHTTPHeader( name : "X-Thread-Id", value : prepared.data().threadId )
		return streamTurn( prepared.data() )
	}

	/**
	 * Stops a run at its next checkpoint (before the next model call or tool call).
	 *
	 * Body: { threadId, reason? }
	 */
	function cancel( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		answer( event, service().turns().cancel( callerOf( event ), body.threadId ?: "", body.reason ?: "Cancelled by the user." ) )
	}

	/**
	 * Splices a message into a run in flight, without stopping and restarting it.
	 *
	 * Body: { threadId, input }
	 */
	function steer( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		answer( event, service().turns().steer( callerOf( event ), body.threadId ?: "", body.input ?: "" ) )
	}

	/**
	 * What a run that stopped for approval is waiting on, without consuming the checkpoint.
	 *
	 * Query: threadId
	 */
	function pending( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, service().turns().pending( callerOf( event ), rc.threadId ?: "" ) )
	}

	/**
	 * Answers an approval and streams the rest of the turn, in the same frames as events.
	 *
	 * Body: { threadId, decision : "approve" | "approve_session" | "reject", editedData?, reason? }
	 */
	function resume( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		var prepared = service().turns().prepareResume( callerOf( event ), body.threadId ?: "", body )
		if ( !prepared.succeeded() ) {
			answer( event, prepared )
			return
		}
		return streamTurn( prepared.data() )
	}

	/**
	 * Opens the event stream and runs a prepared turn in it. The runner makes the frames; this only sends them.
	 *
	 * @turn What the TurnRunner prepared
	 * @only The frame names to send; every frame when empty
	 */
	private string function streamTurn( required struct turn, array only = [] ) {
		var runner = service().turns()
		var prepared = arguments.turn
		var wanted = arguments.only
		SSE(
			callback : ( emitter ) => {
				runner.execute(
					prepared,
					( name, data ) => {
						if ( !wanted.len() || wanted.contains( name ) ) {
							emitter.send( data, name )
						}
					},
					() => !emitter.isClosed()
				)
				if ( !emitter.isClosed() ) {
					emitter.close()
				}
			},
			keepAliveInterval : 30000
		)
		return ""
	}

	// ----------------------------------------------------------------------------------
	// Conversations
	// ----------------------------------------------------------------------------------

	/**
	 * GET: the caller's recent conversations, most recent first: { sessions : [ { id, title, messageCount, source, updatedAt } ] }.
	 * Query: limit?, source?
	 * POST: starts a conversation, { conversationId }; the id is made here, never taken from the caller. Body: { title? }
	 *
	 * 404 when this server keeps no conversation list (no shared chat database).
	 */
	function sessions( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var all = service().conversations()
		if ( isNull( all ) ) {
			answer( event, noSessions() )
			return
		}
		if ( event.getHTTPMethod() == "POST" ) {
			answer( event, all.create( callerOf( event ), event.getHTTPContent( json : true ).title ?: "" ) )
			return
		}
		answer( event, all.list( callerOf( event ), val( rc.limit ?: 20 ), rc.source ?: "", isBoolean( rc.all ?: "" ) && rc.all ) )
	}

	/**
	 * Names one of the caller's conversations; one nobody has spoken in yet gets its row. { ok, title } or { ok : false, reason }.
	 *
	 * Body: { conversationId, title }
	 */
	function renameSession( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		var conversation = conversationOf( event, body.conversationId ?: "", false )
		if ( isNull( conversation ) ) {
			return
		}
		answerResult( event, conversation.rename( body.title ?: "" ) )
	}

	/**
	 * Copies one of the caller's conversations, messages and all, under a new name.
	 * { ok, id, title, messages } or { ok : false, reason }.
	 *
	 * Body: { conversationId, title? }
	 */
	function forkSession( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		var conversation = conversationOf( event, body.conversationId ?: "", false )
		if ( isNull( conversation ) ) {
			return
		}
		answerResult( event, conversation.fork( body.title ?: "" ) )
	}

	/**
	 * What was said in one of the caller's conversations, from the agent's memory.
	 *
	 * Query: conversationId
	 */
	function history( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var conversation = conversationOf( event, rc.conversationId ?: "" )
		if ( isNull( conversation ) ) {
			return
		}
		answer( event, done( { "conversationId" : rc.conversationId, "messages" : conversation.history() } ) )
	}

	/**
	 * Forgets the messages of one of the caller's conversations.
	 *
	 * Body: { conversationId }
	 */
	function clear( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var conversation = conversationOf( event, event.getHTTPContent( json : true ).conversationId ?: "" )
		if ( isNull( conversation ) ) {
			return
		}
		answer( event, done( conversation.clear() ) )
	}

	/**
	 * Replaces the older messages of one of the caller's conversations with a summary.
	 *
	 * Body: { conversationId }
	 */
	function compact( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var conversation = conversationOf( event, event.getHTTPContent( json : true ).conversationId ?: "" )
		if ( isNull( conversation ) ) {
			return
		}
		answer( event, done( conversation.compact() ) )
	}

	/**
	 * Deletes one of the caller's conversations, its row and the agent's messages for it. Body: { conversationId }
	 */
	function deleteSession( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var all = service().conversations()
		answer( event, isNull( all ) ? noSessions() : all.delete( callerOf( event ), event.getHTTPContent( json : true ).conversationId ?: "" ) )
	}

	/**
	 * One of the caller's conversations as a file to save. Query: conversationId, format (md or html, md by default)
	 */
	function export( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var exported = service().exportOf( callerOf( event ), rc.conversationId ?: "", rc.format ?: "md" )
		if ( !exported.succeeded() ) {
			answer( event, exported )
			return
		}
		var file = exported.data()
		event.setHTTPHeader( name : "Content-Disposition", value : 'attachment; filename="#file.file#"' )
		event.renderData( type : "text", data : file.content, contentType : file.mime & "; charset=utf-8" )
	}

	// ----------------------------------------------------------------------------------
	// Who and what is set
	// ----------------------------------------------------------------------------------

	/**
	 * Who the server takes the caller to be: { id, name, scope, source, agent }.
	 */
	function whoami( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, service().whoami( callerOf( event ) ) )
	}

	/**
	 * What the caller has set for themselves, as { preferences : { key : value } }. 404 when this server keeps no shared database.
	 */
	function preferences( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var kept = service().preferences( callerOf( event ) )
		answer( event, isNull( kept ) ? noPreferences() : done( { "preferences" : kept.all() } ) )
	}

	/**
	 * Body: { key, value }
	 */
	function setPreference( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var kept = service().preferences( callerOf( event ) )
		var body = event.getHTTPContent( json : true )
		answer( event, isNull( kept ) ? noPreferences() : kept.set( body.key ?: "", body.value ?: "" ) )
	}

	/**
	 * Body: { key }
	 */
	function deletePreference( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var kept = service().preferences( callerOf( event ) )
		answer( event, isNull( kept ) ? noPreferences() : kept.delete( event.getHTTPContent( json : true ).key ?: "" ) )
	}

	private function noPreferences() {
		return failed( "not_found", "This server keeps no preferences" )
	}

	// ----------------------------------------------------------------------------------
	// Commands
	// ----------------------------------------------------------------------------------

	/**
	 * The commands a client may offer, { commands : [ { name : "/help", hint } ] }: the same slash commands as the
	 * terminal chat, the ones that make sense on a server. Admin commands are left out for a caller who is not an admin.
	 */
	function commands( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, done( { "commands" : service().commands().menu( "web", callerOf( event ).isAdmin() ) } ) )
	}

	/**
	 * Runs one command for the caller: { success, blocks, effects, conversationId }, see models.chat.commands.Reply.
	 *
	 * Body: { line : "/info", conversationId? }
	 */
	function command( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		var line = trim( body.line ?: "" )
		if ( !new "models.chat.commands.CommandLine@bxagents"( line ).isCommand() ) {
			answer( event, failed( "bad_request", "line must be a command, such as /help" ) )
			return
		}
		var caller = callerOf( event )
		event.renderData( type : "json", data : service().commands().execute( caller.id(), body.conversationId ?: "", line, "web", caller.isAdmin() ) )
	}

	// ----------------------------------------------------------------------------------
	// Notes
	// ----------------------------------------------------------------------------------

	/**
	 * GET: the notes of the agent and of the caller, { provider, user : { owner, notes, stats }, agent : { ... } }.
	 * POST: adds a note, { scope : "user" | "agent", text }. 404 when the agent keeps no notes.
	 */
	function notes( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var kept = service().notes( callerOf( event ) )
		if ( event.getHTTPMethod() == "POST" ) {
			var body = event.getHTTPContent( json : true )
			answer( event, kept.add( body.scope ?: "user", body.text ?: "" ) )
			return
		}
		answer( event, kept.all() )
	}

	// ----------------------------------------------------------------------------------
	// Vault
	// ----------------------------------------------------------------------------------

	/**
	 * GET: the secrets the caller can use, { admin, user, status, secrets : [ { name, scope, owner, description, hosts } ] }.
	 * POST: stores one, { scope : "user" | "agent", name, value, description?, hosts? }. The value is never in an answer.
	 */
	function vault( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		if ( !service().keepsSessions() ) {
			answer( event, failed( "not_found", "This server keeps no database, so it has no vault" ) )
			return
		}
		var kept = service().vault( callerOf( event ) )
		if ( event.getHTTPMethod() == "POST" ) {
			var body = event.getHTTPContent( json : true )
			answer( event, kept.add( body.scope ?: "user", body.name ?: "", body.value ?: "", body ) )
			return
		}
		answer( event, kept.all() )
	}

	/**
	 * Body: { scope, name, value?, description?, hosts? }. Only what is sent changes.
	 */
	function updateVault( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		if ( !service().keepsSessions() ) {
			answer( event, failed( "not_found", "This server keeps no database, so it has no vault" ) )
			return
		}
		var body = event.getHTTPContent( json : true )
		var changes = {}
		for ( var key in [ "value", "description", "hosts" ] ) {
			if ( body.keyExists( key ) ) {
				changes[ key ] = body[ key ]
			}
		}
		answer( event, service().vault( callerOf( event ) ).update( body.scope ?: "user", body.name ?: "", changes ) )
	}

	/**
	 * Body: { scope, name }. Removing one of the agent's secrets needs an admin caller.
	 */
	function removeVault( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		if ( !service().keepsSessions() ) {
			answer( event, failed( "not_found", "This server keeps no database, so it has no vault" ) )
			return
		}
		var body = event.getHTTPContent( json : true )
		answer( event, service().vault( callerOf( event ) ).remove( body.scope ?: "user", body.name ?: "" ) )
	}

	/**
	 * Access tokens, for an admin, when the server's config allows it (agentApi.manageTokens): GET lists them (never a
	 * secret), POST makes one and answers with its secret, this once.
	 *
	 * Body of POST: { name, scope?, expires? }
	 */
	function tokens( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var kept = service().tokens()
		if ( isNull( kept ) ) {
			answer( event, failed( "not_found", "This server does not manage tokens over the API" ) )
			return
		}
		if ( event.getHTTPMethod() == "POST" ) {
			var body = event.getHTTPContent( json : true )
			answer( event, kept.create( callerOf( event ), body.name ?: "", body.scope ?: "chat", body.expires ?: "" ) )
			return
		}
		answer( event, kept.list( callerOf( event ) ) )
	}

	/**
	 * Stops a token working. Body: { name }
	 */
	function revokeToken( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var kept = service().tokens()
		if ( isNull( kept ) ) {
			answer( event, failed( "not_found", "This server does not manage tokens over the API" ) )
			return
		}
		answer( event, kept.revoke( callerOf( event ), event.getHTTPContent( json : true ).name ?: "" ) )
	}

	/**
	 * Body: { scope, id, text }
	 */
	function updateNote( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		answer( event, service().notes( callerOf( event ) ).update( body.scope ?: "", body.id ?: "", body.text ?: "" ) )
	}

	/**
	 * Body: { scope, id }. Removing an agent note needs an admin caller; a person removes their own notes.
	 */
	function removeNote( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		answer( event, service().notes( callerOf( event ) ).remove( body.scope ?: "", body.id ?: "" ) )
	}

}
