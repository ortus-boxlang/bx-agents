/**
 * GENERATED FILE - produced by BX Agents' build pipeline.
 * Do not edit by hand; rebuilding your project overwrites this file.
 *
 * Run control for the agent's always-on route, /__bxagents. ColdBox's toAi() gives that route
 * invoke, stream, batch and info; this handler sits beside them with what a chat client needs on
 * top: a stream that also reports tool calls and pauses for approval (events), stopping a run
 * (cancel), steering a run (steer), the approval round trip (pending, resume), conversations,
 * notes and commands.
 *
 * Each action only reads the request, asks the AgentService (models.api) and sends what it answers; the
 * work itself is written once, there, for the web page, the terminal and the gateways alike.
 *
 * Every action is behind the same token gate as the toAi routes. The x-bxagents-token header is
 * compared with the environment variable named by agentApi.tokenEnvVar (an unset or blank variable
 * matches nothing), and, when agentApi.tokens is on, with the tokens made by `bxAgents token create`.
 * A route with neither is open, and everyone is the one `local` user. The name of the token that was
 * used is who is calling.
 */
class {

	// ----------------------------------------------------------------------------------
	// Who is calling
	// ----------------------------------------------------------------------------------

	/**
	 * Every action starts with this: it answers 401 and returns true when the caller is not allowed, so the
	 * action stops. (A preHandler cannot do it: ColdBox runs the action anyway after event.noExecution().)
	 */
	private boolean function refused( required any event ) {
		if ( !isNull( callerOf( arguments.event ) ) ) {
			return false
		}
		answer( arguments.event, failed( "unauthorized", "Missing or invalid x-bxagents-token header" ) )
		return true
	}

	/**
	 * The environment variable that holds the shared token, "" when there is none.
	 */
	private string function tokenVariable() {
		return "__TOKEN_ENV_VAR__"
	}

	/**
	 * Whether tokens made by `bxAgents token create` are accepted.
	 */
	private boolean function tokensEnabled() {
		return "__TOKENS_ENABLED__" == "true"
	}

	/**
	 * Who is calling, once per request: a Caller, or null for a caller who may not.
	 *
	 *   no tokenEnvVar and no tokens   open: everyone is the one `local` user
	 *   the tokenEnvVar secret         "admin"
	 *   an issued token                the name and scope it was made with
	 *
	 * The surface the call came in on (web, terminal, api) is a label the client sends in x-bxagents-source.
	 */
	private function callerOf( required any event ) {
		var known = arguments.event.getPrivateValue( "bxagentsCaller", nullValue() )
		if ( !isNull( known ) ) {
			return known
		}
		var found = lookUpCaller( sourceOf() )
		if ( !isNull( found ) ) {
			arguments.event.setPrivateValue( "bxagentsCaller", found )
		}
		return found ?: nullValue()
	}

	private string function sourceOf() {
		var given = lCase( getHTTPRequestData( false ).headers[ "x-bxagents-source" ] ?: "" )
		return reFind( "^[a-z0-9][a-z0-9_-]{0,31}$", given ) ? given : "api"
	}

	private function lookUpCaller( required string source ) {
		var variableName = tokenVariable()
		if ( !len( variableName ) && !tokensEnabled() ) {
			return service().localCaller( arguments.source )
		}
		var given = getHTTPRequestData( false ).headers[ "x-bxagents-token" ] ?: ""
		if ( !len( given ) ) {
			return nullValue()
		}
		if ( len( variableName ) ) {
			var expected = getSystemSetting( variableName, "" )
			if ( len( expected ) && createObject( "java", "java.security.MessageDigest" ).isEqual( given.getBytes( "UTF-8" ), expected.getBytes( "UTF-8" ) ) ) {
				return new "models.api.Caller@bxagents"( id = "admin", scope = "admin", source = arguments.source )
			}
		}
		if ( tokensEnabled() ) {
			// the app's default datasource is the shared chat database
			var who = new "models.store.TokenService@bxagents"( new "models.store.ChatStore@bxagents"( "" ) ).authenticate( given )
			if ( !who.isEmpty() ) {
				return new "models.api.Caller@bxagents"( id = who.name, scope = who.scope, source = arguments.source )
			}
		}
		return nullValue()
	}

	// ----------------------------------------------------------------------------------
	// The service, and answering
	// ----------------------------------------------------------------------------------

	private function agent() {
		return getInstance( "GeneratedAgent" )
	}

	/**
	 * The one service behind every action: turns, conversations, notes, preferences and commands.
	 */
	private function service() {
		// once per request: the probe for the shared database is a query
		if ( !request.keyExists( "bxagentsService" ) ) {
			request[ "bxagentsService" ] = new "models.api.AgentService@bxagents"( agent(), sharedStore(), offered() )
		}
		return request.bxagentsService
	}

	/**
	 * The shared chat database, or null when the server has none (then there is no conversation list).
	 */
	private function sharedStore() {
		try {
			var store = new "models.store.ChatStore@bxagents"( "" )
			store.rows( "SELECT 1 AS found FROM conversations LIMIT 1" )
			return store
		} catch ( any e ) {
			return nullValue()
		}
	}

	/**
	 * The profiles a caller may ask for with options.profile: agentApi.profiles, none by default. A profile
	 * is a model the server pays for, so the caller never picks one the app did not list.
	 */
	private function offered() {
		return new "models.runtime.OfferedProfiles@bxagents"( jsonDeserialize( "__PROFILES__" ) )
	}

	/**
	 * @data What the call produced
	 *
	 * @return A worked Outcome
	 */
	private function done( any data = {} ) {
		return new "models.api.Outcome@bxagents"( ok = true, data = arguments.data )
	}

	/**
	 * @code A name from ApiEdge's list, such as `not_found`
	 * @reason What to tell the person
	 *
	 * @return A failed Outcome
	 */
	private function failed( required string code, string reason = "" ) {
		return new "models.api.Outcome@bxagents"( ok = false, code = arguments.code, reason = arguments.reason )
	}

	/**
	 * Sends an Outcome: its data with success, or the code and reason with the status the code means.
	 */
	private void function answer( required any event, required any outcome ) {
		var edge = new "models.api.ApiEdge@bxagents"()
		arguments.event.renderData( type : "json", statusCode : edge.statusFor( arguments.outcome ), data : edge.bodyFor( arguments.outcome ) )
	}

	/**
	 * Sends what an AgentConversation answers, { ok, reason? ... }: the answer with success, 400 and the reason when it did not work.
	 */
	private void function answerResult( required any event, required struct result ) {
		answer( arguments.event, new "models.api.Outcome@bxagents"().fromResult( arguments.result ) )
	}

	private function noSessions() {
		return failed( "not_found", "This server keeps no list of conversations" )
	}

	/**
	 * The caller's conversation to act on, or null after answering 400 or 404. With mustExist the conversation has to be in
	 * the list already (reading it); without, one nobody has spoken in yet will do (naming it, copying it).
	 */
	private function conversationOf( required any event, required string conversationId, boolean mustExist = true ) {
		var all = service().conversations()
		if ( isNull( all ) ) {
			answer( arguments.event, noSessions() )
			return nullValue()
		}
		var caller = callerOf( arguments.event )
		if ( arguments.mustExist ) {
			var opened = all.open( caller, arguments.conversationId )
			if ( !opened.succeeded() ) {
				answer( arguments.event, opened )
				return nullValue()
			}
		} else if ( !len( arguments.conversationId ) ) {
			answer( arguments.event, failed( "bad_request", "conversationId is required" ) )
			return nullValue()
		}
		return service().conversation( caller, arguments.conversationId )
	}

	// ----------------------------------------------------------------------------------
	// Profiles and the agent
	// ----------------------------------------------------------------------------------

	/**
	 * The profiles this route offers: { profiles : [ { name, description, provider, model, isDefault } ] }, empty when
	 * agentApi.profiles lists none. Never a key, and never a profile that is not on the list.
	 */
	function profiles( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, done( { "profiles" : offered().list() } ) )
	}

	/**
	 * Who the agent is, for a client's banner: name, a short model label and what it can do.
	 */
	function about( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, service().about( callerOf( event ) ) )
	}

	/**
	 * The names of the tools the agent has.
	 */
	function tools( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var config = agent().getConfig()
		answer( event, done( { "tools" : config.tools ?: [], "count" : config.toolCount ?: 0 } ) )
	}

	/**
	 * What is in the caller's context for one conversation: the system prompt, the tool definitions, the notes and the
	 * messages, as estimated sizes (see models.chat.ContextReport). Nothing is sent to a model.
	 *
	 * Query: conversationId
	 */
	function context( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, done( service().conversation( callerOf( event ), rc.conversationId ?: "" ).contextReport() ) )
	}

	/**
	 * What the extensions' status items say for one conversation: { items : [ { name, text } ] }. An
	 * item with nothing to say is left out. Query: conversationId
	 */
	function status( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var conversation = service().conversation( callerOf( event ), rc.conversationId ?: "" )
		answer( event, done( { "items" : new "models.extensions.ServedStatus@bxagents"().items( conversation ) } ) )
	}

	/**
	 * What the extensions' slots hold for one conversation: { items : [ { id, extension, place, html, text } ] }.
	 * A slot with nothing to show is left out. Query: conversationId
	 */
	function slots( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var conversation = service().conversation( callerOf( event ), rc.conversationId ?: "" )
		answer( event, done( { "items" : new "models.extensions.ServedSlots@bxagents"().items( conversation ) } ) )
	}

	/**
	 * Tests a model with one tiny question: { ok, model, ms, reply } or { ok : false, model, reason }. A profile is
	 * only used when the route offers it (agentApi.profiles); without one the server's own model is tested.
	 *
	 * Body: { profile? }
	 */
	function ping( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		var result = service().conversation( callerOf( event ) ).ping( body.profile ?: "" )
		result[ "success" ] = result.ok ?: false
		event.renderData( type : "json", data : result )
	}

	// ----------------------------------------------------------------------------------
	// Turns
	// ----------------------------------------------------------------------------------

	/**
	 * Streams one turn. The frames are thread, chunk, done and:
	 *
	 *   tool       { id, name, arguments, status : "running" | "ok", ms }
	 *   suspended  { threadId, pendingActions : [ { toolName, toolArgs } ] } when the run waits for a human
	 *   error      { message }
	 *
	 * Body: { input, threadId?, conversationId?, params?, options?, attachments? }
	 */
	function events( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var prepared = service().turns().prepareTurn( callerOf( event ), event.getHTTPContent( json : true ) )
		if ( !prepared.succeeded() ) {
			answer( event, prepared )
			return
		}
		event.setHTTPHeader( name : "X-Thread-Id", value : prepared.data().threadId )
		return streamTurn( prepared.data() )
	}

	/**
	 * Stops a run at its next checkpoint (before the next model call or tool call).
	 *
	 * Body: { threadId, reason? }
	 */
	function cancel( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		answer( event, service().turns().cancel( callerOf( event ), body.threadId ?: "", body.reason ?: "Cancelled by the user." ) )
	}

	/**
	 * Splices a message into a run in flight, without stopping and restarting it.
	 *
	 * Body: { threadId, input }
	 */
	function steer( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		answer( event, service().turns().steer( callerOf( event ), body.threadId ?: "", body.input ?: "" ) )
	}

	/**
	 * What a run that stopped for approval is waiting on, without consuming the checkpoint.
	 *
	 * Query: threadId
	 */
	function pending( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, service().turns().pending( callerOf( event ), rc.threadId ?: "" ) )
	}

	/**
	 * Answers an approval and streams the rest of the turn, in the same frames as events.
	 *
	 * Body: { threadId, decision : "approve" | "approve_session" | "reject", editedData?, reason? }
	 */
	function resume( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		var prepared = service().turns().prepareResume( callerOf( event ), body.threadId ?: "", body )
		if ( !prepared.succeeded() ) {
			answer( event, prepared )
			return
		}
		return streamTurn( prepared.data() )
	}

	/**
	 * Opens the event stream and runs a prepared turn in it. The runner makes the frames; this only sends them.
	 *
	 * @turn What the TurnRunner prepared
	 */
	private string function streamTurn( required struct turn ) {
		var runner = service().turns()
		var prepared = arguments.turn
		SSE(
			callback : ( emitter ) => {
				runner.execute( prepared, ( name, data ) => emitter.send( data, name ), () => !emitter.isClosed() )
				if ( !emitter.isClosed() ) {
					emitter.close()
				}
			},
			keepAliveInterval : 30000
		)
		return ""
	}

	// ----------------------------------------------------------------------------------
	// Conversations
	// ----------------------------------------------------------------------------------

	/**
	 * The caller's recent conversations, most recent first: { sessions : [ { id, title, messageCount, source, updatedAt } ] }.
	 * 404 when this server keeps no conversation list (no shared chat database).
	 *
	 * Query: limit?, source?
	 */
	function sessions( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var all = service().conversations()
		answer( event, isNull( all ) ? noSessions() : all.list( callerOf( event ), val( rc.limit ?: 20 ), rc.source ?: "" ) )
	}

	/**
	 * Names one of the caller's conversations; one nobody has spoken in yet gets its row. { ok, title } or { ok : false, reason }.
	 *
	 * Body: { conversationId, title }
	 */
	function renameSession( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		var conversation = conversationOf( event, body.conversationId ?: "", false )
		if ( isNull( conversation ) ) {
			return
		}
		answerResult( event, conversation.rename( body.title ?: "" ) )
	}

	/**
	 * Copies one of the caller's conversations, messages and all, under a new name.
	 * { ok, id, title, messages } or { ok : false, reason }.
	 *
	 * Body: { conversationId, title? }
	 */
	function forkSession( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		var conversation = conversationOf( event, body.conversationId ?: "", false )
		if ( isNull( conversation ) ) {
			return
		}
		answerResult( event, conversation.fork( body.title ?: "" ) )
	}

	/**
	 * What was said in one of the caller's conversations, from the agent's memory.
	 *
	 * Query: conversationId
	 */
	function history( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var conversation = conversationOf( event, rc.conversationId ?: "" )
		if ( isNull( conversation ) ) {
			return
		}
		answer( event, done( { "conversationId" : rc.conversationId, "messages" : conversation.history() } ) )
	}

	/**
	 * Forgets the messages of one of the caller's conversations.
	 *
	 * Body: { conversationId }
	 */
	function clear( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var conversation = conversationOf( event, event.getHTTPContent( json : true ).conversationId ?: "" )
		if ( isNull( conversation ) ) {
			return
		}
		answer( event, done( conversation.clear() ) )
	}

	/**
	 * Replaces the older messages of one of the caller's conversations with a summary.
	 *
	 * Body: { conversationId }
	 */
	function compact( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var conversation = conversationOf( event, event.getHTTPContent( json : true ).conversationId ?: "" )
		if ( isNull( conversation ) ) {
			return
		}
		answer( event, done( conversation.compact() ) )
	}

	// ----------------------------------------------------------------------------------
	// Commands
	// ----------------------------------------------------------------------------------

	/**
	 * The commands a client may offer, { commands : [ { name : "/help", hint } ] }: the same slash commands as the
	 * terminal chat, the ones that make sense on a server. Admin commands are left out for a caller who is not an admin.
	 */
	function commands( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		answer( event, done( { "commands" : service().commands().menu( "web", callerOf( event ).isAdmin() ) } ) )
	}

	/**
	 * Runs one command for the caller: { success, blocks, effects, conversationId }, see models.chat.commands.Reply.
	 *
	 * Body: { line : "/info", conversationId? }
	 */
	function command( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		var line = trim( body.line ?: "" )
		if ( !new "models.chat.commands.CommandLine@bxagents"( line ).isCommand() ) {
			answer( event, failed( "bad_request", "line must be a command, such as /help" ) )
			return
		}
		var caller = callerOf( event )
		event.renderData( type : "json", data : service().commands().execute( caller.id(), body.conversationId ?: "", line, "web", caller.isAdmin() ) )
	}

	// ----------------------------------------------------------------------------------
	// Notes
	// ----------------------------------------------------------------------------------

	/**
	 * GET: the notes of the agent and of the caller, { provider, user : { owner, notes, stats }, agent : { ... } }.
	 * POST: adds a note, { scope : "user" | "agent", text }. 404 when the agent keeps no notes.
	 */
	function notes( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var kept = service().notes( callerOf( event ) )
		if ( event.getHTTPMethod() == "POST" ) {
			var body = event.getHTTPContent( json : true )
			answer( event, kept.add( body.scope ?: "user", body.text ?: "" ) )
			return
		}
		answer( event, kept.all() )
	}

	/**
	 * Body: { scope, id, text }
	 */
	function updateNote( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		answer( event, service().notes( callerOf( event ) ).update( body.scope ?: "", body.id ?: "", body.text ?: "" ) )
	}

	/**
	 * Body: { scope, id }. Removing an agent note needs an admin caller; a person removes their own notes.
	 */
	function removeNote( event, rc, prc ) {
		if ( refused( event ) ) {
			return
		}
		var body = event.getHTTPContent( json : true )
		answer( event, service().notes( callerOf( event ) ).remove( body.scope ?: "", body.id ?: "" ) )
	}

}
