/**
 * Generates the core ColdBox application skeleton for a project's assembled
 * agent (Build Pipeline Phase 5): `Application.bx`, `config/ColdBox.bx`,
 * `config/WireBox.bx`, and `agent/GeneratedAgentFactory.bx`.
 *
 * `GeneratedAgentFactory.bx` translates the resolved config's `provider/model`
 * slug (BX Agents' own convention) into bx-ai's separate `aiModel(provider:, params:{model:})`
 * arguments, and its declared `subAgents` names into nested `aiAgent()` calls,
 * building leaf subagents before their parents so each parent can pass in the
 * already-built child instances.
 *
 * ColdBox's own `Application.bx`/`config/ColdBox.bx`/`config/WireBox.bx` conventions
 * follow established ColdBox framework documentation.
 *
 * The plain `aiAgent()` BIF's return value is used directly for `route().toAi()`
 * exposure - no adapter subclass needed. Confirmed by reading real
 * `coldbox-platform` source (system/web/routing/Router.cfc): `toAi()`'s
 * `IAiRunnable` contract is just `run(input,params,options)`/
 * `stream(onChunk,input,params,options)`/`getName()` - exactly bx-ai's own
 * `IAiRunnable` interface, which `AiAgent` (via `AiBaseRunnable`) already
 * implements natively.
 */
class {

	property name="modelSlugParser";
	property name="configResolver";

	/**
	 * Uses the "Class@bxagents" module-relative suffix form, not a bare
	 * "bxagents.models...." path - see BuildPipeline.bx's init() docblock
	 * for why (a real bug this session found and fixed: the bare form only
	 * resolves under this repo's own dev/test mapping, not a real install).
	 */
	function init() {
		variables.modelSlugParser = new "models.build.ModelSlugParser@bxagents"()
		variables.configResolver = new "models.build.AgentConfigResolver@bxagents"()
		return this
	}

	/**
	 * @projectRoot Absolute path to the project root (containing Agent.bx/instructions.md)
	 * @buildDir Absolute path to the build output directory, e.g. "<projectRoot>/.build/app"
	 * @resolvedConfig The root project's resolved config, from AgentConfigResolver.resolve()
	 * @agentInterceptors Names of agent-scope PER-REQUEST interceptors already copied into "<buildDir>/interceptors" (see InterceptorSplitter) - registered for real from Application.bx's onApplicationStart() (see renderInterceptorRegistration()), never via a declarative config/ColdBox.bx array, which never reaches ColdBox's InterceptorService on this stack (confirmed directly against a real boot)
	 * @gatewayRegistrations Bare `aiGatewayRegistry().register( aiGateway( ... ) )` statement strings (see GatewayGenerator), inserted into Application.bx's onApplicationStart()
	 * @mcpRegistrations Bare `mcpServer( ... ).registerTool( ... )` statement strings (see McpGenerator), inserted into Application.bx's onApplicationStart()
	 * @extraStartupStatements Any other bare statement strings to insert into Application.bx's onApplicationStart(), e.g. `aiToolRegistry().scan( "tools" )` (see BuildPipeline)
	 * @cliEnvironment Optional environment name the build was invoked with (e.g. from `--environment`), re-applied when resolving each subagent's OWN config so a subagent's environment-specific overrides match the same environment the root project was built for, rather than silently falling back to each subagent's default environment
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .models is used, to resolve a bare `model` value against a `models/` entry - see resolveModelReference()). Subagents have no `models/` folder of their own; every node resolves against the ROOT project's models/, matching the flat-namespace design already used for subAgents references (see docs/conventions/subagents.md)
	 * @hasEmailGateway Whether the project has at least one `type: "email"` gateway (see GatewayGenerator) - when true, `moduleSettings.cbmailservices` is generated so `EmailGateway`'s `MailService@cbmailservices` resolution has a real `BXMail`-protocol mailer configured. cbmailservices/bx-mail themselves are server-level module installs (see box.json `dependencies`), not something this generator installs
	 *
	 * @return { applicationBx, coldboxConfig, wireboxConfig, agentFactory, index, agentNodes: every { name, accessorPath } WireBox-registered agent - see buildAgentTree() }
	 */
	struct function generate(
		required string projectRoot,
		required string buildDir,
		required struct resolvedConfig,
		array agentInterceptors = [],
		array gatewayRegistrations = [],
		array mcpRegistrations = [],
		array extraStartupStatements = [],
		string cliEnvironment = "",
		struct discovery = {},
		boolean hasEmailGateway = false,
		boolean hasWebUi = false,
		struct webUiDatabase = {},
		boolean webUiHasUsers = false
	) {
		var root = normalizePath( arguments.projectRoot )
		var appDir = normalizePath( arguments.buildDir )

		directoryCreate( path = appDir, createPath = true, ignoreExists = true )
		directoryCreate( path = appDir & "/config", createPath = true, ignoreExists = true )
		directoryCreate( path = appDir & "/agent", createPath = true, ignoreExists = true )

		var appName = len( arguments.resolvedConfig.name ?: "" ) ? arguments.resolvedConfig.name : "BxAi"

		var applicationPath  = appDir & "/Application.bx"
		var coldboxPath      = appDir & "/config/ColdBox.bx"
		var wireboxPath      = appDir & "/config/WireBox.bx"
		var agentFactoryPath = appDir & "/agent/GeneratedAgentFactory.bx"

		var startupStatements = []
		for ( var statement in arguments.extraStartupStatements ) {
			startupStatements.append( statement )
		}
		for ( var statement in arguments.mcpRegistrations ) {
			startupStatements.append( statement )
		}
		for ( var statement in arguments.gatewayRegistrations ) {
			startupStatements.append( statement )
		}
		// Real, per-request interceptor registration - see renderInterceptorRegistration()'s
		// own docblock for why this can't be the declarative config/ColdBox.bx
		// array ColdBox itself documents. Registered in the order callers passed
		// them in arguments.agentInterceptors (BuildPipeline.bx registers the
		// web UI's login gate last, after its store/accounts exist).
		for ( var interceptorName in arguments.agentInterceptors ) {
			startupStatements.append( renderInterceptorRegistration( interceptorName ) )
		}

		// No memory TYPE is forced here. Scoping is handled by IDENTITY instead -
		// handlers/ChatUi.bx passes controller.getUserSessionIdentifier() as the
		// agent's userId, and
		// every memory an agent holds is keyed by (userId, conversationId), so a
		// project stays free to configure whichever memories it wants (an agent
		// can hold several at once) without any of them collapsing into a bucket
		// shared across visitors. Only an explicit `memory` key on Agent.bx
		// changes what gets generated.
		var agentFactory = renderAgentFactory(
			root,
			appDir,
			arguments.resolvedConfig,
			arguments.cliEnvironment,
			arguments.discovery
		)

		fileWrite(
			applicationPath,
			renderApplication(
				appName            : appName,
				startupStatements  : startupStatements,
				sessionManagement  : arguments.hasWebUi,
				datasourceName     : arguments.webUiDatabase.datasource ?: "",
				databasePath       : arguments.webUiDatabase.path ?: ""
			)
		)
		fileWrite( coldboxPath, renderColdboxConfig( appName, arguments.resolvedConfig.security ?: {}, arguments.hasEmailGateway, arguments.webUiDatabase.datasource ?: "" ) )
		fileWrite( wireboxPath, renderWireBox( agentFactory.nodes ) )
		fileWrite( agentFactoryPath, agentFactory.source )

		// cbauth's userServiceClass CANNOT be set via config/ColdBox.bx's own
		// `moduleSettings` - see renderCbauthModuleOverride()'s own docblock.
		// This is ColdBox's OTHER, genuinely-working per-module settings path:
		// a config/modules/<name>.bx file, invoked directly by ModuleService.cfc
		// via a plain function call (`oConfig.configure( mConfig.settings )`),
		// not the reflection-based one that never reaches ColdBox on this stack.
		if ( arguments.webUiHasUsers ) {
			var modulesConfigDir = appDir & "/config/modules"
			directoryCreate( path : modulesConfigDir, createPath : true, ignoreExists : true )
			fileWrite( modulesConfigDir & "/cbauth.bx", renderCbauthModuleOverride() )
		}

		var indexPath = appDir & "/index.bxm"
		fileWrite( indexPath, renderIndex() )

		return {
			applicationBx : applicationPath,
			coldboxConfig : coldboxPath,
			wireboxConfig : wireboxPath,
			agentFactory  : agentFactoryPath,
			index         : indexPath,
			agentNodes    : agentFactory.nodes
		}
	}

	// --------------------------------------------------------------------------
	// Static file rendering
	// --------------------------------------------------------------------------

	/**
	 * @appName The agent's name, stamped into `this.name`
	 * @startupStatements Bare statement strings inserted into `onApplicationStart()`, after `loadColdbox()` - tool scan, MCP registrations, gateway registrations, in that order
	 *
	 * @return The rendered Application.bx source
	 */
	private string function renderApplication(
		required string appName,
		array startupStatements = [],
		boolean sessionManagement = false,
		numeric sessionTimeoutMinutes = 60,
		string datasourceName = "",
		string databasePath = ""
	) {
		var lines = [
			"class {",
			"",
			'	this.name              = "#bxLiteral( arguments.appName )#"'
		]

		if ( arguments.sessionManagement ) {
			// A browser-facing project needs a real session: it is what keys each
			// visitor's own agent memory (see renderMemoryExpression()'s `session`
			// default). Cookies go with it - without them there is no session to
			// key by, and every visitor collapses back into one shared bucket.
			lines.append( "	this.sessionManagement = true" )
			lines.append( "	this.setClientCookies  = true" )
			lines.append( "	this.sessionTimeout    = createTimeSpan( 0, 0, #int( arguments.sessionTimeoutMinutes )#, 0 )" )
		} else {
			// API/gateway-only projects have no browser to track - sessions would
			// be pure overhead plus a cookie nobody asked for.
			lines.append( "	this.sessionManagement = false" )
			lines.append( "	this.setClientCookies  = false" )
		}

		if ( len( arguments.datasourceName ) ) {
			// The web UI's own SQLite store: conversation index, preferences,
			// and whatever later features need real relational storage that the
			// agent's own IAiMemory cannot express (it has no enumeration API -
			// no way to ask "which conversations does this user have").
			//
			// Registered as a NAMED datasource on purpose, never as an inline
			// struct passed per query. qb's own NullSQLCommenter.appendSqlComments()
			// declares its `datasource` argument as `string`, so handing
			// QueryBuilder a struct throws a type error before any SQL runs -
			// confirmed directly against qb 13.1.0, not inferred.
			lines.append( "" )
			lines.append( "	// The web UI's SQLite store - see models/ChatDb.bx" )
			lines.append( '	this.datasources[ "#bxLiteral( arguments.datasourceName )#" ] = {' )
			lines.append( '		"driver"  : "sqlite",' )
			lines.append( '		"database": expandPath( "#bxLiteral( arguments.databasePath )#" )' )
			lines.append( "	}" )
			// Also the app default. A generated app has exactly one datasource,
			// so anything that runs a query without naming one should reach it
			// rather than failing with "No default datasource defined in the
			// application" - which is precisely what happened in a real boot.
			//
			// The key is `this.datasource`, NOT `this.defaultDatasource`. The
			// latter is the obvious-looking name, is accepted silently, and
			// does nothing - verified directly against the runtime: with
			// `this.defaultDatasource` set, an unqualified query still fails
			// with "No default datasource defined in the application ...
			// Registered datasources are: [<name>]"; with `this.datasource` it
			// resolves.
			lines.append( '	this.datasource = "#bxLiteral( arguments.datasourceName )#"' )
		}

		lines.append( "" )
		lines.append( "	COLDBOX_APP_ROOT_PATH  = expandPath( ""/"" )" )
		lines.append( '	COLDBOX_APP_MAPPING    = ""' )
		lines.append( '	COLDBOX_CONFIG_MAPPING = ""' )
		lines.append( '	COLDBOX_APP_KEY        = ""' )
		lines.append( "" )
		lines.append( "	function onApplicationStart() {" )
		if ( len( arguments.databasePath ) ) {
			// SQLite creates the database FILE on first connect, but never its
			// parent directory - a missing ./data/ is an unopenable-database
			// error at boot, not an auto-created folder. Done here rather than in
			// ChatDb because this is where the configured path literally is;
			// ChatDb only ever knows the datasource NAME.
			lines.append( "		// SQLite creates the db file, but not the directory holding it" )
			lines.append( '		directoryCreate( getDirectoryFromPath( expandPath( "#bxLiteral( arguments.databasePath )#" ) ), true, true )' )
		}
		// Named args deliberately, not positional - coldbox.system.Bootstrap's
		// real init() signature is
		// (COLDBOX_CONFIG_FILE, COLDBOX_APP_ROOT_PATH, COLDBOX_APP_KEY, COLDBOX_APP_MAPPING, COLDBOX_FAIL_FAST, COLDBOX_WEB_MAPPING) -
		// a prior positional call here passed COLDBOX_APP_ROOT_PATH as the
		// FIRST arg (silently becoming COLDBOX_CONFIG_FILE), breaking config
		// loading the moment a real ColdBox boot exercised it. Confirmed
		// against real coldbox.system.Bootstrap source this session.
		lines.append( "		application.cbBootstrap = new coldbox.system.Bootstrap(" )
		lines.append( "			COLDBOX_CONFIG_FILE   = COLDBOX_CONFIG_MAPPING," )
		lines.append( "			COLDBOX_APP_ROOT_PATH = COLDBOX_APP_ROOT_PATH," )
		lines.append( "			COLDBOX_APP_KEY       = COLDBOX_APP_KEY," )
		lines.append( "			COLDBOX_APP_MAPPING   = COLDBOX_APP_MAPPING" )
		lines.append( "		)" )
		lines.append( "		application.cbBootstrap.loadColdbox()" )

		for ( var statement in arguments.startupStatements ) {
			lines.append( "		" & statement )
		}

		lines.append( "		return true" )
		lines.append( "	}" )
		lines.append( "" )
		lines.append( "	function onRequestStart( required string targetPage ) {" )
		lines.append( '		if ( structKeyExists( url, "fwreinit" ) ) {' )
		lines.append( "			application.cbBootstrap.processReinit()" )
		lines.append( "		}" )
		lines.append( "		application.cbBootstrap.onRequestStart( arguments.targetPage )" )
		lines.append( "		return true" )
		lines.append( "	}" )
		lines.append( "" )
		lines.append( "}" )
		lines.append( "" )

		return lines.toList( char( 10 ) )
	}

	/**
	 * ColdBox's own onRequestStart() (wired in Application.bx) intercepts and
	 * fully handles every request before this file's own body would run - this
	 * exists only as a physical rewrite target for the web server (MiniServer's
	 * `rewriteFileName` convention defaults to "index.bxm").
	 *
	 * @return The rendered index.bxm source (an empty script body)
	 */
	private string function renderIndex() {
		return "<bx:script>" & char( 10 ) & "</bx:script>" & char( 10 )
	}

	/**
	 * @appName The agent's name, stamped into ColdBox's own `coldbox.appName` setting
	 * @security The resolved config's own `security` block, forwarded verbatim into bx-ai's `moduleSettings.bxai.security` (passthrough only - see M8.5)
	 * @hasEmailGateway Whether to also generate `moduleSettings.cbmailservices` (see generate()'s own docblock)
	 * @webUiDatasource The web UI's SQLite datasource name, or "" - when set, pins qb's grammar and default datasource
	 *
	 * @return The rendered config/ColdBox.bx source
	 */
	private string function renderColdboxConfig( required string appName, struct security = {}, boolean hasEmailGateway = false, string webUiDatasource = "" ) {
		var lines = [
			"class {",
			"",
			"	function configure() {",
			"		coldbox = {",
			'			appName : "#bxLiteral( arguments.appName )#"',
			"		}"
		]

		// No identifierProvider here on purpose. A closure declared in this
		// struct never reaches configSettings - verified in a real boot, both
		// inside the literal (the shape ColdBox documents) and as a later
		// assignment - so getUserSessionIdentifier() silently kept returning
		// the session id. models/WebUiIdentity.bx holds it instead, registered
		// from onApplicationStart() via setSetting(), which writes directly to
		// the struct that method reads. See WebUiGenerator.

		// No `interceptors = [...]` here either, for the exact same reason:
		// confirmed directly against a real ColdBox 8.1.0 boot that this array
		// never reaches ColdBox's InterceptorService at all (ModuleService.cfc's
		// own `controller.getSetting( "ColdBoxConfig" ).getPropertyMixin(...)`
		// reflection, the same mechanism `identifierProvider` above already
		// falls afoul of, generalizes to every top-level key here - moduleSettings
		// included, see below). Every project-declared and web-UI interceptor is
		// instead registered for real from Application.bx's onApplicationStart()
		// - see renderInterceptorRegistration() and generate()'s own assembly of
		// startupStatements.

		// bx-ai's own skillsDirectory setting defaults to "/.agents/skills" - a
		// DIFFERENT path than BX Agents' own skills/ convention (copied verbatim
		// by ToolsSkillsCopier, M6), so it must always be pointed at "/skills"
		// or bx-ai would never find them. security (if any) is forwarded
		// verbatim in the same block - bx-ai's own SecurityDirector.buildGlobalMiddleware()
		// turns it into middleware automatically (decision: passthrough only,
		// no new guardrails/ convention folder for v1 - see the build plan's M8.5).
		var bxaiSettings = { skillsDirectory : "/skills" }
		if ( arguments.security.count() ) {
			bxaiSettings[ "security" ] = arguments.security
		}
		// Each module's settings are collected as a block of lines, then joined
		// with commas below. Doing it this way rather than having each block
		// decide its own trailing comma from what MIGHT follow it means adding a
		// module can't silently produce a dangling comma or a missing one.
		var settingBlocks = [ [ "			bxai : #renderLiteral( bxaiSettings )#" ] ]

		// The `BXMail` protocol (cbmailservices' own dispatch to bx-mail's
		// `bx:mail` component - see EmailGateway.bx / docs/conventions/gateways/email.md)
		// - both modules are real, server-level installs (box.json `dependencies`),
		// not something this generator installs itself.
		if ( arguments.hasEmailGateway ) {
			settingBlocks.append( [ '			cbmailservices : { mailers : { "default" : { class : "BXMail" } } }' ] )
		}

		// Pin qb's grammar rather than leaving it on "AutoDiscover@qb". Autodiscovery
		// calls cfdbinfo against the DEFAULT datasource, which this app deliberately
		// never sets - the SQLite store is a named datasource, not the default - so
		// autodiscovery would either fail or silently resolve BaseGrammar and emit
		// SQL SQLite cannot run. The grammar is known here, so state it.
		//
		// defaultOptions carries the datasource NAME into every QueryBuilder qb
		// hands out, so no call site has to remember it.
		if ( len( arguments.webUiDatasource ) ) {
			settingBlocks.append( [
				"			qb : {",
				'				defaultGrammar : "SQLiteGrammar@qb",',
				'				defaultOptions : { datasource : "#bxLiteral( arguments.webUiDatasource )#" }',
				"			}"
			] )
		}

		// cbauth's userServiceClass is deliberately NOT set here via
		// `moduleSettings.cbauth` - see generate()'s own writing of
		// config/modules/cbauth.bx instead, and its docblock for why.

		lines.append( "" )
		lines.append( "		moduleSettings = {" )
		for ( var blockIndex = 1; blockIndex <= settingBlocks.len(); blockIndex++ ) {
			var block = settingBlocks[ blockIndex ]
			var comma = blockIndex < settingBlocks.len() ? "," : ""
			for ( var lineIndex = 1; lineIndex <= block.len(); lineIndex++ ) {
				lines.append( block[ lineIndex ] & ( lineIndex == block.len() ? comma : "" ) )
			}
		}
		lines.append( "		}" )

		lines.append( "	}" )
		lines.append( "" )
		lines.append( "}" )
		lines.append( "" )

		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders one onApplicationStart() statement that registers a per-request
	 * interceptor (already written into `interceptors/<name>.bx` - see
	 * InterceptorSplitter/WebUiGenerator) directly against ColdBox's real
	 * InterceptorService, using its OWN plain `register()` method
	 * (`interceptorService.register( target:, name: )`, which builds its
	 * listener list off `getMetadata()` on the already-built object - real
	 * reflection, not the `getPropertyMixin()` indirection that never reaches
	 * ColdBox on this stack).
	 *
	 * This is NOT the same fix as `config/modules/cbauth.bx` below: that one
	 * targets a broken SETTINGS read; this one targets interceptor
	 * REGISTRATION, which is entirely undocumented as a config/ColdBox.bx
	 * concept - `interceptors = [...]` simply never worked at all on this
	 * stack. Confirmed directly: a `preProcess` interceptor declared that way
	 * never fired on any real request - the web UI's own login gate and
	 * API-key gate included, wide open despite `users`/`apiKeyEnvVar` being
	 * configured, until registered this way instead.
	 *
	 * `application.cbController`, not `getController()`/bare `getInstance()`:
	 * this runs as a plain onApplicationStart() statement, which has none of
	 * an interceptor's own mixed-in helpers - only what Application.bx itself
	 * sets up (see the seed statement's own precedent).
	 *
	 * `interceptors.<name>`, the module-relative invocation path
	 * InterceptorSplitter/WebUiGenerator already write these files under -
	 * `getInstance( "<name>" )` alone throws `Instance not found`.
	 *
	 * @interceptorName The interceptor's class name, e.g. "WebUiLoginGate" (no `interceptors.` prefix - added here)
	 *
	 * @return A single onApplicationStart() statement
	 */
	private string function renderInterceptorRegistration( required string interceptorName ) {
		return 'application.cbController.getInterceptorService().register( target: application.cbController.getWireBox().getInstance( "interceptors.#bxLiteral( arguments.interceptorName )#" ), name: "#bxLiteral( arguments.interceptorName )#" )'
	}

	/**
	 * Renders `config/modules/cbauth.bx` - the ONLY thing that actually sets
	 * cbauth's `userServiceClass`.
	 *
	 * `moduleSettings.cbauth` in config/ColdBox.bx (the documented ColdBox
	 * convention, and what this generator used to emit) never reaches cbauth
	 * on this stack: confirmed directly against a real boot that
	 * `AuthenticationService.getUserService()` still sees the empty-string
	 * default and throws `IncompleteConfiguration`, even with the setting
	 * present, correctly spelled, in the generated file - the same
	 * `getPropertyMixin()` reflection gap `identifierProvider`/`interceptors`
	 * above already fall afoul of.
	 *
	 * `config/modules/<name>.bx` is ColdBox's OTHER per-module settings
	 * mechanism (`ModuleService.cfc`'s `loadModuleSettingsOverride()`), and it
	 * genuinely works here: it is invoked with a plain function call -
	 * `oConfig.configure( mConfig.settings )`, returning the merged struct -
	 * never the reflection-based `getPropertyMixin()` read the other path
	 * relies on. Confirmed directly: with this file in place, a real sign-in
	 * against real cbauth resolves `UserService` and authenticates for real.
	 *
	 * @return The rendered config/modules/cbauth.bx source
	 */
	private string function renderCbauthModuleOverride() {
		return [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" *",
			" * cbauth's own per-module settings override (ColdBox's",
			" * config/modules/<name>.bx convention) - see",
			" * ColdBoxAppGenerator.renderCbauthModuleOverride()'s docblock for why",
			" * this, and not config/ColdBox.bx's own `moduleSettings.cbauth`, is",
			" * what actually sets userServiceClass.",
			" */",
			"class {",
			"",
			"	function configure( settings ) {",
			'		arguments.settings.userServiceClass = "UserService"',
			"		return arguments.settings",
			"	}",
			"",
			"}",
			""
		].toList( char( 10 ) )
	}

	/**
	 * Maps GeneratedAgentFactory, the lazily-built singleton GeneratedAgent
	 * (the root of the tree), and - the point of `agentNodes` - one
	 * additional binding PER agent node in the tree (root + every subagent,
	 * recursively), keyed by that node's OWN declared `name` from its
	 * Agent.bx. This is what lets a hand-written `schedules/Scheduler.bx`
	 * (or anything else WireBox-aware) call `getInstance( "SupportBot" )`/
	 * `getInstance( "Summarizer" )` directly instead of only ever reaching
	 * the fixed `"GeneratedAgent"` root alias.
	 *
	 * Every node resolves off the SAME underlying singleton build - a
	 * subagent's binding is just `injector.getInstance( "GeneratedAgent" )`
	 * plus one `getSubAgent( name )` hop per level of nesting (confirmed
	 * against real bx-ai source: `AiAgent.getSubAgent( name )` searches that
	 * node's own DIRECT `subAgents` by their own `getAgentName()`, so a
	 * grandchild needs one hop per ancestor, not just one) - never a second,
	 * independent construction.
	 *
	 * @agentNodes Every node in the tree - { name, accessorPath } structs from buildAgentTree(), where accessorPath is the ordered list of getSubAgent() names needed to reach that node from the root singleton (empty for root itself)
	 *
	 * @return The rendered config/WireBox.bx source
	 */
	private string function renderWireBox( required array agentNodes ) {
		var lines = [
			'class extends="coldbox.system.ioc.config.Binder" {',
			"",
			"	function configure() {",
			'		map( "GeneratedAgentFactory" ).to( "agent.GeneratedAgentFactory" ).asSingleton()',
			"",
			"		// Built once, shared by every consumer (HTTP routes via toAi(), the",
			"		// CLI chat REPL, etc.) - never construct the agent tree more than once.",
			"		// `injector`, not a bare getInstance() call - coldbox.system.ioc.config.Binder",
			"		// has no such delegate/method at all (confirmed against real source this",
			"		// session); `variables.injector` is the real WireBox Injector reference",
			"		// Binder itself uses internally for the same purpose.",
			'		map( "GeneratedAgent" ).toProvider( function() {',
			'			return injector.getInstance( "GeneratedAgentFactory" ).buildAgent()',
			"		} ).asSingleton()"
		]

		for ( var node in arguments.agentNodes ) {
			var accessor = 'injector.getInstance( "GeneratedAgent" )'
			for ( var hop in node.accessorPath ) {
				accessor &= '.getSubAgent( "#bxLiteral( hop )#" )'
			}

			lines.append( "" )
			lines.append( "		// Lets schedules/Scheduler.bx (or anything else) resolve this" )
			lines.append( "		// agent directly by the name its own Agent.bx declares." )
			lines.append( '		map( "#bxLiteral( node.name )#" ).toProvider( function() {' )
			lines.append( "			return #accessor#" )
			lines.append( "		} )" )
		}

		lines.append( "	}" )
		lines.append( "" )
		lines.append( "}" )
		lines.append( "" )
		return lines.toList( char( 10 ) )
	}

	// --------------------------------------------------------------------------
	// GeneratedAgentFactory.bx - the agent/subagent build tree
	// --------------------------------------------------------------------------

	/**
	 * Real bug found this session: this factory's generated `aiAgent()` calls
	 * NEVER passed a `tools:` argument at all (confirmed against real bx-ai
	 * source: `AiAgent.bx` never references `aiToolRegistry()` internally -
	 * a project's tools/ were copied into the build and made
	 * name-resolvable for MCP wiring, but no agent BX Agents ever built - in
	 * ANY context: a real served app, `chat`, or a test spec - actually
	 * received them). Fixed here, but deliberately NOT by relying on
	 * `aiToolRegistry().scan("tools")`'s relative-path resolution (which
	 * depends on whatever "/" mapping is in effect for the CALLING context -
	 * unverified/fragile the moment this factory is loaded via
	 * `DynamicClassLoader` rather than a real ColdBox boot, and that
	 * rejection still stands): `ToolRegistryLoader.bx` is called once here
	 * with the tools directory's path, then every agent node's `aiAgent()`
	 * call attaches `aiToolRegistry().getAll()` - safe regardless of how
	 * many nodes exist, since re-registering an already-scanned tool is a
	 * no-op overwrite (confirmed against real bx-ai `BaseRegistry.register()`
	 * source).
	 *
	 * PORTABILITY - why that path is no longer a bare baked-in absolute:
	 * every runtime path this factory needs (its own `tools/` directory,
	 * each node's `instructions.md`, each class-based node's copied
	 * Agent.bx) used to be embedded as the ABSOLUTE path it happened to have
	 * on the BUILDING machine, which made the whole point of `package` - "a
	 * portable .bxa" - untrue: built on CI at `/home/runner/work/x` and
	 * unzipped at `/opt/x`, the first `getInstance( "GeneratedAgent" )` blew
	 * up, and merely RENAMING the project directory broke a local build the
	 * same way. `instructions.md` was worse still: its baked path pointed
	 * into the SOURCE project, a file `package` never even put in the
	 * archive.
	 *
	 * So each of those files is now copied into the app (see
	 * copyNodeInstructions()/copyAgentClass()) and referenced through a
	 * generated `resolveAppPath( relative, fallback )` helper (see
	 * renderResolveAppPath()) that locates them relative to this factory's
	 * OWN location on disk via `getCurrentTemplatePath()`. The build-time
	 * absolute path is still emitted, as that helper's FALLBACK: if
	 * self-location ever fails to resolve (proven for a module-loaded class -
	 * see WebUiGenerator.renderUiBundle()'s docblock - but not independently
	 * verified for the `DynamicClassLoader` load path `chat`/`invoke` use),
	 * behaviour is exactly what it was before this change, never worse.
	 *
	 * @projectRoot Absolute path to the project root (containing Agent.bx/instructions.md)
	 * @appDir Absolute path to the generated ColdBox app dir - its own `tools/` subfolder is loaded
	 * @resolvedConfig The root project's resolved config
	 * @cliEnvironment Optional environment name the build was invoked with, re-applied to every subagent's own config resolution
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .models is used)
	 *
	 * @return { source: the rendered agent/GeneratedAgentFactory.bx source, nodes: every agent node in the tree - see buildAgentTree() }
	 */
	private struct function renderAgentFactory( required string projectRoot, required string appDir, required struct resolvedConfig, string cliEnvironment = "", struct discovery = {}, string defaultMemory = "" ) {
		var built = buildAgentTree( arguments.projectRoot, arguments.projectRoot, arguments.resolvedConfig, "agent", arguments.cliEnvironment, arguments.discovery, [], arguments.defaultMemory, normalizePath( arguments.appDir ) )
		var body = built.statements.toList( char( 10 ) & char( 10 ) )
		var toolsDir = normalizePath( arguments.appDir ) & "/tools"

		var lines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" */",
			"class {",
			"",
			"	function buildAgent() {",
			'		new "models.build.ToolRegistryLoader@bxagents"().load( resolveAppPath( "../tools", "#bxLiteral( toolsDir )#" ) )',
			"",
			body,
			"",
			"		return agent",
			"	}",
			""
		]

		for ( var helperLine in renderResolveAppPath() ) {
			lines.append( helperLine )
		}

		lines.append( "}" )
		lines.append( "" )

		return { source : lines.toList( char( 10 ) ), nodes : built.nodes }
	}

	/**
	 * The generated factory's own private path resolver - emitted into every
	 * `agent/GeneratedAgentFactory.bx` and used for every file the built app
	 * reads at runtime (its `tools/` directory, each node's `instructions.md`,
	 * each class-based node's copied `Agent.bx`).
	 *
	 * It answers "where am I on disk?" with `getCurrentTemplatePath()` - the
	 * same primitive WebUiGenerator.renderUiBundle() already relies on, and
	 * which was confirmed empirically to resolve correctly for a class loaded
	 * through a module mapping - and resolves everything else relative to
	 * that. Since the factory is written to `<appDir>/agent/`, `instructions.md`
	 * sits beside it, a subagent's at `subagents/<name>/instructions.md`, a
	 * class-based agent's copied class at `classes/<var>Class.bx`, and the
	 * app's tools at `../tools`.
	 *
	 * The build-time absolute path is passed as `fallbackPath` rather than
	 * dropped: self-location is NOT independently verified for the
	 * `DynamicClassLoader` load path `chat`/`invoke` use (see Chat.bx), so if
	 * it ever comes back as something that doesn't resolve, the generated app
	 * behaves exactly as it did before portability was addressed - it reads
	 * the same absolute path it always baked in. Never worse, only better.
	 *
	 * Checks `directoryExists()` as well as `fileExists()` because one of the
	 * three call sites (`tools/`) resolves a DIRECTORY, not a file.
	 *
	 * @return The helper's source lines, appended to the generated class body
	 */
	private array function renderResolveAppPath() {
		return [
			"	/**",
			"	 * Resolves a path inside this generated app relative to THIS file's own",
			"	 * location on disk, so the app stays portable - a built app can be zipped",
			"	 * up (`bxAgents package`) and unzipped anywhere, and every path below",
			"	 * still resolves. Falls back to the absolute path recorded at build time",
			"	 * if self-location does not resolve, which is exactly how this app",
			"	 * behaved before it was made relocatable.",
			"	 */",
			"	private string function resolveAppPath( required string relativePath, required string fallbackPath ) {",
			"		var candidate = getDirectoryFromPath( getCurrentTemplatePath() ) & arguments.relativePath",
			"		return ( fileExists( candidate ) || directoryExists( candidate ) ) ? candidate : arguments.fallbackPath",
			"	}",
			""
		]
	}

	/**
	 * Recursively builds the leaf-first list of `var <name> = aiAgent(...)`
	 * statements for a project and its declared `subAgents`.
	 *
	 * Per the M3-validated DAG model, subagents live in a single FLAT
	 * namespace under the root project's own `subagents/` folder - a
	 * subagent's declared `subAgents` names reference SIBLING entries in
	 * that same root-level folder, not a folder nested under itself. So
	 * `rootProjectRoot` (fixed) is threaded through separately from
	 * `nodePath` (this node's own directory, used to locate its instructions.md).
	 *
	 * `cliEnvironment` (the same value the root project itself was resolved
	 * with - see BuildPipeline.build()'s `cliEnvironment` param) is re-applied
	 * to every subagent's own `AgentConfigResolver.resolve()` call too - a
	 * real bug this closed: without this, a subagent's own environment-
	 * specific overrides were always resolved against ITS default
	 * environment, silently ignoring whatever `--environment` the whole
	 * build was actually invoked with, so a `--environment=production` build
	 * could still generate a subagent wired to its dev-environment config.
	 *
	 * Also collects, per node, `{ name, accessorPath }` - `name` is the
	 * node's own declared name (see `resolveAgentName()`) and `accessorPath`
	 * is the ordered list of `getSubAgent()` names needed to reach it from
	 * the root singleton (empty for root itself) - `renderWireBox()` uses
	 * these to register every agent under its own name.
	 *
	 * @rootProjectRoot Absolute path to the ROOT project root - fixed across the whole recursion, since subagents always live under its own `subagents/` folder
	 * @nodePath Absolute path to THIS node's own directory, used to locate its instructions.md
	 * @resolvedConfig THIS node's own resolved config
	 * @varName The BoxLang variable name to assign this node's built `aiAgent()` to, e.g. "agent" or "subagent_foo"
	 * @cliEnvironment Optional environment name the build was invoked with, re-applied to every subagent's own config resolution
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .models is used), shared by every node
	 * @accessorPath The ordered list of getSubAgent() names needed to reach THIS node from the root singleton - empty for the initial (root) call
	 * @nodeRelativePath THIS node's own directory expressed RELATIVE to the root project root - "" for the root itself, "subagents/<name>" for every subagent (flat, per the DAG model above, so it is never nested any deeper than that). Used to mirror the node into the generated app, so its instructions.md is copied to a matching place under `<appDir>/agent/` - see copyNodeInstructions()
	 *
	 * @return { statements: leaf-first `var <name> = aiAgent(...)` statement strings, nodes: [ { name, accessorPath } ] for this node and every descendant }
	 */
	private struct function buildAgentTree(
		required string rootProjectRoot,
		required string nodePath,
		required struct resolvedConfig,
		required string varName,
		string cliEnvironment = "",
		struct discovery = {},
		array accessorPath = [],
		string defaultMemory = "",
		string appDir = "",
		string nodeRelativePath = ""
	) {
		var declaredSubAgents = arguments.resolvedConfig.subAgents ?: []
		var subAgentVarNames = []
		var statements = []
		var thisName = resolveAgentName( arguments.resolvedConfig )
		var nodes = [ { name : thisName, accessorPath : arguments.accessorPath } ]

		for ( var subName in declaredSubAgents ) {
			var subPath = arguments.rootProjectRoot & "/subagents/" & subName
			if ( !directoryExists( subPath ) ) {
				throw(
					type    = "BxAgents.MissingSubagent",
					message = "Subagent [#subName#] referenced from [#arguments.nodePath#] was not found at [#subPath#]"
				)
			}

			var subConfig = variables.configResolver.resolve( projectRoot = subPath, cliEnvironment = arguments.cliEnvironment )
			var subVarName = "subagent_" & sanitizeIdentifier( subName )
			var childAccessorPath = duplicate( arguments.accessorPath )
			childAccessorPath.append( resolveAgentName( subConfig ) )

			var built = buildAgentTree( arguments.rootProjectRoot, subPath, subConfig, subVarName, arguments.cliEnvironment, arguments.discovery, childAccessorPath, arguments.defaultMemory, arguments.appDir, "subagents/" & subName )

			for ( var stmt in built.statements ) {
				statements.append( stmt )
			}
			for ( var node in built.nodes ) {
				nodes.append( node )
			}
			subAgentVarNames.append( subVarName )
		}

		statements.append( renderAgentStatement( arguments.varName, arguments.nodePath, arguments.resolvedConfig, subAgentVarNames, arguments.discovery, thisName, arguments.defaultMemory, arguments.appDir, arguments.nodeRelativePath ) )

		return { statements : statements, nodes : nodes }
	}

	/**
	 * The single source of truth for a node's own declared agent name -
	 * reused by ProjectValidator's name-uniqueness check (now that a
	 * duplicate name would silently collide as a WireBox binding key) so
	 * the two never drift on what "no name set" defaults to.
	 *
	 * @resolvedConfig A single node's own resolved config
	 *
	 * @return resolvedConfig.name if declared via configure(), else the class's
	 *         own name (resolvedConfig.classAgentName) for a class-based agent
	 *         that set none, else the default "BxAi"
	 */
	string function resolveAgentName( required struct resolvedConfig ) {
		if ( len( arguments.resolvedConfig.name ?: "" ) ) {
			return arguments.resolvedConfig.name
		}
		// A class-based agent with no configure()-declared name override still
		// carries a real name from its own super.init() - see AgentConfigResolver's
		// classAgentName. Only falls through to the bare "BxAi" default for a
		// descriptor Agent.bx (or a class-based one that never set a name at all).
		if ( len( arguments.resolvedConfig.classAgentName ?: "" ) ) {
			return arguments.resolvedConfig.classAgentName
		}
		return "BxAi"
	}

	/**
	 * Every generated agent gets a checkpointer — without one, bx-ai's
	 * HumanInTheLoopMiddleware.onAttach() throws NoCheckpointer for any
	 * gateway other than "cli" (confirmed against bx-ai source: it requires a
	 * checkpointer whenever the attached gateway can suspend), and
	 * GatewaySession only forwards a checkpointer to its gateways when the
	 * agent already has one — so every push-style gateway's HITL support was
	 * silently broken without this. Defaults to a `cache`-backed memory (not
	 * restart-durable, but enough for same-process HITL) if the project
	 * declares no `checkpointer` key of its own.
	 *
	 * @resolvedConfig A single node's own resolved config - only `checkpointer` is used
	 *
	 * @return A BoxLang `aiMemory( memory: "type", config: {...} )` expression string
	 */
	private string function renderCheckpointerExpression( required struct resolvedConfig ) {
		var checkpointer = arguments.resolvedConfig.checkpointer ?: { type: "cache" }
		var type = trim( checkpointer.type ?: "cache" )
		var rest = duplicate( checkpointer )
		rest.delete( "type" )
		// aiMemory()'s first param is named `memory`, not `type` - all-named-args here
		// because BoxLang doesn't allow mixing positional and named arguments in one call.
		return 'aiMemory( memory: "#bxLiteral( type )#", config: #renderLiteral( rest )# )'
	}

	/**
	 * Resolves a node's agent MEMORY - the conversation store, distinct from the
	 * checkpointer above (which only holds suspended-run state).
	 *
	 * This is what decides who shares a conversation with whom. bx-ai's own
	 * default is `window`, an in-process store keyed by (userId, conversationId);
	 * since the generated agent is a WireBox singleton and nothing supplies those
	 * ids by default, EVERY visitor to a browser-facing app would otherwise read
	 * and write one shared bucket. `session` memory instead stores under the
	 * BoxLang `session` scope, so each visitor is separated server-side, with no
	 * client-supplied identifier to trust - which is why a `webui` project turns
	 * session management on (see renderApplication()).
	 *
	 * An explicit `memory` key on Agent.bx always wins over that default.
	 *
	 * @resolvedConfig A single node's own resolved config - only `memory` is used
	 * @defaultMemory Memory type to use when the node declares none ("" means leave bx-ai's own default alone)
	 *
	 * @return A BoxLang `aiMemory( ... )` expression string, or "" to omit the argument entirely
	 */
	private string function renderMemoryExpression( required struct resolvedConfig, string defaultMemory = "" ) {
		var declared = arguments.resolvedConfig.memory ?: {}

		if ( isSimpleValue( declared ) && len( trim( declared ) ) ) {
			declared = { type: trim( declared ) }
		}

		var type = isStruct( declared ) ? trim( declared.type ?: "" ) : ""
		if ( !len( type ) ) {
			type = arguments.defaultMemory
		}
		if ( !len( type ) ) {
			return ""
		}

		var rest = isStruct( declared ) ? duplicate( declared ) : {}
		rest.delete( "type" )
		return 'aiMemory( memory: "#bxLiteral( type )#", config: #renderLiteral( rest )# )'
	}

	/**
	 * Renders one node's `aiAgent( ... )` statement - a descriptor-based agent
	 * built entirely from its resolved config, unless `resolvedConfig.classBasedAgent`
	 * is set, in which case this defers to renderClassBasedAgentStatement()
	 * instead (a class-based Agent.bx IS the agent, not a descriptor to build
	 * one from).
	 *
	 * Requires an `instructions.md` alongside the node and a configured model;
	 * both throw when missing since an agent cannot run without them. The model
	 * expression, checkpointer, memory, sub-agents and MCP servers are each
	 * resolved by the matching render*Expression()/extract*() helper. Only
	 * `memory` is conditional - it is omitted entirely when its expression comes
	 * back empty (bx-ai's own default then applies). `checkpointer` is always
	 * emitted (its helper never returns empty - it defaults to `cache`), and
	 * `subAgents`/`mcpServers` are always emitted, falling back to `[]`.
	 *
	 * The node's `instructions.md` is COPIED into the generated app and read
	 * back from there at runtime (see copyNodeInstructions() for the layout and
	 * renderResolveAppPath() for why) - it used to be read straight from the
	 * SOURCE project by an absolute path baked in at build time, a file
	 * `package` never even put in the `.bxa`, so a built app could only ever
	 * run on the machine that built it, from an unmoved, unrenamed project
	 * directory.
	 *
	 * @varName The BoxLang variable name to assign this node's instance to
	 * @nodePath Absolute path to THIS node's own directory, holding its instructions.md
	 * @resolvedConfig THIS node's own resolved config
	 * @subAgentVarNames Already-rendered child variable names to attach
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover()
	 * @name The agent's resolved `name` value
	 * @defaultMemory The build-wide default memory type, if any
	 * @appDir Absolute path to the generated app dir - this node's instructions.md is copied under its `agent/`, and it is forwarded to renderClassBasedAgentStatement() for class-based nodes
	 * @nodeRelativePath THIS node's directory relative to the root project root ("" for the root, "subagents/<name>" for a subagent) - mirrored under `<appDir>/agent/` so every node keeps its own instructions.md
	 *
	 * @return The rendered statement block for this one node
	 */
	private string function renderAgentStatement(
		required string varName,
		required string nodePath,
		required struct resolvedConfig,
		required array subAgentVarNames,
		struct discovery = {},
		required string name,
		string defaultMemory = "",
		string appDir = "",
		string nodeRelativePath = ""
	) {
		// A class-based Agent.bx IS the agent - instantiate it rather than
		// rebuilding one from its config. Everything below this line describes
		// the DESCRIPTOR shape.
		if ( arguments.resolvedConfig.classBasedAgent ?: false ) {
			return renderClassBasedAgentStatement(
				varName          : arguments.varName,
				nodePath         : arguments.nodePath,
				resolvedConfig   : arguments.resolvedConfig,
				subAgentVarNames : arguments.subAgentVarNames,
				discovery        : arguments.discovery,
				defaultMemory    : arguments.defaultMemory,
				appDir           : arguments.appDir,
				nodeRelativePath : arguments.nodeRelativePath
			)
		}

		var instructionsPath = arguments.nodePath & "/instructions.md"
		if ( !fileExists( instructionsPath ) ) {
			throw(
				type    = "BxAgents.MissingInstructions",
				message = "No instructions.md found at [#instructionsPath#]"
			)
		}

		var instructionsRelative = copyNodeInstructions( instructionsPath, arguments.appDir, arguments.nodeRelativePath )

		var modelSlug = arguments.resolvedConfig.model ?: ""
		if ( !len( modelSlug ) ) {
			throw(
				type    = "BxAgents.MissingModel",
				message = "Agent at [#arguments.nodePath#] has no model configured"
			)
		}

		var parsedModel = resolveModelReference( modelSlug, arguments.discovery, arguments.nodePath )
		var description = arguments.resolvedConfig.description ?: ""

		var modelExpression = len( parsedModel.model )
			? 'aiModel( provider : "#bxLiteral( parsedModel.provider )#", params : { model : "#bxLiteral( parsedModel.model )#" } )'
			: 'aiModel( provider : "#bxLiteral( parsedModel.provider )#" )'

		var checkpointerExpression = renderCheckpointerExpression( arguments.resolvedConfig )
		var memoryExpression = renderMemoryExpression( arguments.resolvedConfig, arguments.defaultMemory )

		var lines = []
		lines.append( "var #arguments.varName# = aiAgent(" )
		lines.append( '	name : "#bxLiteral( arguments.name )#",' )
		lines.append( '	description : "#bxLiteral( description )#",' )
		lines.append( '	instructions : fileRead( resolveAppPath( "#bxLiteral( instructionsRelative )#", "#bxLiteral( instructionsPath )#" ) ),' )
		lines.append( '	model : #modelExpression#,' )
		lines.append( "	tools : aiToolRegistry().getAll()," )
		if ( len( memoryExpression ) ) {
			lines.append( "	memory : #memoryExpression#," )
		}
		lines.append( "	checkpointer : #checkpointerExpression#," )

		if ( arguments.subAgentVarNames.len() ) {
			lines.append( "	subAgents : [ #arguments.subAgentVarNames.toList( ", " )# ]," )
		} else {
			lines.append( "	subAgents : []," )
		}

		var mcpServerUrls = extractMcpServerUrls( arguments.resolvedConfig )
		if ( mcpServerUrls.len() ) {
			var quoted = mcpServerUrls.map( function( url ) {
				return '"#bxLiteral( url )#"'
			} )
			lines.append( "	mcpServers : [ #quoted.toList( ", " )# ]" )
		} else {
			lines.append( "	mcpServers : []" )
		}

		lines.append( ")" )

		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders one node when its Agent.bx IS the agent - a class extending bx-ai's
	 * AiAgent - rather than a descriptor whose configure() we build an
	 * `aiAgent()` call from.
	 *
	 * THE RULE, in one line: an explicitly declared convention wins; otherwise
	 * the class is in charge.
	 *
	 * So a class-based agent that sets everything in its own init() gets nothing
	 * imposed on it, while one that sets the bare minimum still picks up the
	 * conventions it did not speak for. Deliberately NOT implemented by comparing
	 * the instance against bx-ai's DEFAULT_AGENT_* values - "did the author mean
	 * this, or is it just the default?" is unanswerable, and an author who
	 * genuinely wants the default name would find it silently replaced. Presence
	 * of the external declaration is a fact; intent behind a default value is not.
	 *
	 *   instructions.md present  -> withInstructions( fileRead(...) )
	 *   config declares model    -> setModel( aiModel(...) )
	 *   config declares name     -> setName(), and likewise description/memory
	 *   tools/ discovered        -> withTools(), which APPENDS in bx-ai rather
	 *                               than replacing, so the class's own tools stay
	 *   subagents/ declared      -> addSubAgent() per child, appended the same way
	 *   checkpointer             -> injected only when the class set none AND the
	 *                               config declares none (see renderCheckpointerExpression)
	 *
	 * @varName The BoxLang variable name to assign this node's instance to
	 * @nodePath Absolute path to THIS node's own directory, holding its Agent.bx
	 * @resolvedConfig THIS node's own resolved config
	 * @subAgentVarNames Already-rendered child variable names to attach
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover()
	 * @defaultMemory The build-wide default memory type, if any
	 * @appDir Absolute path to the generated app dir - the class is copied under its agent/classes/, and this node's instructions.md (if any) under its agent/
	 * @nodeRelativePath THIS node's directory relative to the root project root ("" for the root, "subagents/<name>" for a subagent) - mirrored under `<appDir>/agent/` so every node keeps its own instructions.md
	 *
	 * @return The rendered statement block for this one node
	 */
	private string function renderClassBasedAgentStatement(
		required string varName,
		required string nodePath,
		required struct resolvedConfig,
		required array subAgentVarNames,
		struct discovery = {},
		string defaultMemory = "",
		string appDir = "",
		string nodeRelativePath = ""
	) {
		var classAbsolutePath = copyAgentClass( arguments.nodePath, arguments.varName, arguments.appDir )
		var classRelativePath = "classes/" & getFileFromPath( classAbsolutePath )

		var lines = []
		lines.append( "// #arguments.varName#: a class-based Agent.bx - instantiated, not rebuilt." )
		// Instantiated by its own FILESYSTEM path via DynamicClassLoader, exactly
		// the same primitive `chat`/default `invoke` already use to load
		// GeneratedAgentFactory.bx itself - never a relative dotted-path `new`.
		// A relative `new "agent.classes.#varName#Class"()` only resolves under a
		// real ColdBox boot (serve/invoke --server), which registers the app root
		// as a mapping as an ordinary part of startup; `chat` and default `invoke`
		// never boot ColdBox, and registering a mapping mid-script does not
		// reliably make relative lookups resolve either (the same limitation
		// already documented for TestRunnerLauncher's TestBox discovery - see
		// docs/known-limitations.md). Loading by a real path sidesteps mapping
		// resolution entirely, so it works identically in both contexts.
		//
		// That path is resolved at RUNTIME, next to the generated factory itself
		// (see renderResolveAppPath()), rather than being frozen as the absolute
		// path this machine happened to build at - otherwise the copied class is
		// unreachable the moment the app is unzipped anywhere else, which is the
		// whole promise of a `.bxa`. The build-time absolute path stays on as the
		// fallback, so nothing regresses if self-location does not resolve.
		lines.append( 'var #arguments.varName#Context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()' )
		lines.append( 'var #arguments.varName# = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" ).instantiate( resolveAppPath( "#bxLiteral( classRelativePath )#", "#bxLiteral( classAbsolutePath )#" ), #arguments.varName#Context )' )

		// --- identity: only what the project declared OUTSIDE the class ---
		if ( len( arguments.resolvedConfig.name ?: "" ) ) {
			lines.append( '#arguments.varName#.setName( "#bxLiteral( arguments.resolvedConfig.name )#" )' )
		}
		if ( len( arguments.resolvedConfig.description ?: "" ) ) {
			lines.append( '#arguments.varName#.setDescription( "#bxLiteral( arguments.resolvedConfig.description )#" )' )
		}

		// instructions.md is optional here, unlike a descriptor agent - the class
		// carries its own instructions when the file is absent.
		var instructionsPath = arguments.nodePath & "/instructions.md"
		if ( fileExists( instructionsPath ) ) {
			var instructionsRelative = copyNodeInstructions( instructionsPath, arguments.appDir, arguments.nodeRelativePath )
			lines.append( '#arguments.varName#.withInstructions( fileRead( resolveAppPath( "#bxLiteral( instructionsRelative )#", "#bxLiteral( instructionsPath )#" ) ) )' )
		}

		// model is optional here too - no MissingModel throw, since the class
		// already has one from its own super.init().
		var modelSlug = arguments.resolvedConfig.model ?: ""
		if ( len( modelSlug ) ) {
			var parsedModel = resolveModelReference( modelSlug, arguments.discovery, arguments.nodePath )
			var modelExpression = len( parsedModel.model )
				? 'aiModel( provider : "#bxLiteral( parsedModel.provider )#", params : { model : "#bxLiteral( parsedModel.model )#" } )'
				: 'aiModel( provider : "#bxLiteral( parsedModel.provider )#" )'
			lines.append( "#arguments.varName#.setModel( #modelExpression# )" )
		}

		// --- conventions that ADD rather than replace ---
		lines.append( "#arguments.varName#.withTools( aiToolRegistry().getAll() )" )

		for ( var subVarName in arguments.subAgentVarNames ) {
			lines.append( "#arguments.varName#.addSubAgent( #subVarName# )" )
		}

		var memoryExpression = renderMemoryExpression( arguments.resolvedConfig, arguments.defaultMemory )
		if ( len( memoryExpression ) ) {
			lines.append( "#arguments.varName#.setMemory( #memoryExpression# )" )
		}

		// The one case the build fills in without an explicit declaration: an
		// agent reachable from a gateway with NO checkpointer has silently broken
		// human-in-the-loop, so a class that set none still gets the cache default.
		var declaresCheckpointer = structKeyExists( arguments.resolvedConfig, "checkpointer" )
		var classHasCheckpointer = arguments.resolvedConfig.classHasCheckpointer ?: false
		if ( declaresCheckpointer || !classHasCheckpointer ) {
			lines.append( "#arguments.varName#.withCheckpointer( #renderCheckpointerExpression( arguments.resolvedConfig )# )" )
		}

		var mcpServerUrls = extractMcpServerUrls( arguments.resolvedConfig )
		if ( mcpServerUrls.len() ) {
			var quoted = mcpServerUrls.map( function( url ) {
				return '"#bxLiteral( url )#"'
			} )
			lines.append( "#arguments.varName#.withMCPServers( [ #quoted.toList( ", " )# ] )" )
		}

		return lines.toList( char( 10 ) )
	}

	/**
	 * Copies ONE node's `instructions.md` into the generated app, mirroring the
	 * node's own place in the source project under the app's `agent/` folder -
	 * the root project's lands beside the generated factory itself
	 * (`<appDir>/agent/instructions.md`), and each subagent's under its own
	 * `<appDir>/agent/subagents/<name>/instructions.md`, so two nodes can never
	 * collide on one file and every node keeps its own.
	 *
	 * Without this, `instructions.md` was the one runtime file a built app read
	 * that was never copied into it at all: the generated `fileRead()` pointed
	 * at an absolute path back inside the SOURCE project, so `package` shipped a
	 * `.bxa` whose agent could not read its own instructions anywhere but on the
	 * building machine - and not even there once the project was renamed.
	 *
	 * A no-op (returning the relative path anyway, which then simply won't
	 * resolve and lets the generated `resolveAppPath()` fall back to the source
	 * path) when no app directory is available - a descriptor node can be
	 * rendered with no `appDir` at all, unlike a class-based one.
	 *
	 * @instructionsPath Absolute path to the node's own source instructions.md - the caller has already confirmed it exists
	 * @appDir Absolute path to the generated app dir, or "" when rendering without one
	 * @nodeRelativePath This node's directory relative to the root project root - "" for the root, "subagents/<name>" for a subagent
	 *
	 * @return The copied file's path RELATIVE to the generated factory's own
	 *         directory (`<appDir>/agent/`), e.g. "instructions.md" or
	 *         "subagents/researcher/instructions.md" - passed straight to the
	 *         generated resolveAppPath() helper
	 */
	private string function copyNodeInstructions( required string instructionsPath, required string appDir, required string nodeRelativePath ) {
		var relative = len( arguments.nodeRelativePath )
			? arguments.nodeRelativePath & "/instructions.md"
			: "instructions.md"

		if ( !len( arguments.appDir ) ) {
			return relative
		}

		var destination = normalizePath( arguments.appDir ) & "/agent/" & relative
		directoryCreate( path = getDirectoryFromPath( destination ), createPath = true, ignoreExists = true )
		fileCopy( arguments.instructionsPath, destination )

		return relative
	}

	/**
	 * Copies a class-based Agent.bx into the generated app so the built app can
	 * instantiate it at runtime, exactly as tools/, skills/ and mcp/ are copied.
	 * A descriptor Agent.bx is never copied - it is consumed at build time and
	 * has no runtime role.
	 *
	 * Named by the node's own varName, which buildAgentTree already guarantees is
	 * unique and identifier-safe across the whole tree, so two subagents cannot
	 * collide on one file. The "Class" suffix keeps the component path from
	 * colliding with the local variable of the same name in the generated factory.
	 *
	 * @nodePath Absolute path to the node directory holding Agent.bx
	 * @varName This node's variable name in the generated factory
	 * @appDir Absolute path to the generated app dir
	 *
	 * @return The copied file's own absolute path, e.g. "/path/to/app/agent/classes/agentClass.bx" -
	 *         instantiated by DynamicClassLoader off a real filesystem path, never a relative dotted
	 *         lookup. The caller resolves that path at runtime relative to the generated factory
	 *         (see renderResolveAppPath()) so the built app stays relocatable, and keeps this
	 *         absolute one only as that resolution's fallback
	 */
	private string function copyAgentClass( required string nodePath, required string varName, required string appDir ) {
		var source = arguments.nodePath & "/Agent.bx"
		if ( !fileExists( source ) ) {
			throw(
				type    = "BxAgents.MissingAgentDescriptor",
				message = "No Agent.bx found at [#source#]"
			)
		}

		if ( !len( arguments.appDir ) ) {
			throw(
				type    = "BxAgents.MissingBuildDir",
				message = "A class-based Agent.bx at [#source#] cannot be generated without a build directory to copy it into"
			)
		}

		var classesDir = arguments.appDir & "/agent/classes"
		directoryCreate( path = classesDir, createPath = true, ignoreExists = true )

		var className = arguments.varName & "Class"
		var destination = classesDir & "/" & className & ".bx"
		fileCopy( source, destination )

		return destination
	}

	// --------------------------------------------------------------------------
	// Helpers
	// --------------------------------------------------------------------------

	/**
	 * Resolves a node's `model` value (already validated by ProjectValidator's
	 * validateModelProvider(), a permissive check happy with ANY of the 3
	 * shapes below) into a concrete `{ provider, model }` pair -
	 * `model` is `""` when only a provider was given, meaning "use that
	 * provider's own default model" (aiModel() supports omitting `params.model`
	 * entirely - see bx-ai's aiModel.bif docblock).
	 *
	 * A real bug this closed: this used to call `modelSlugParser.parse()`
	 * directly with no `defaultProvider`, which only handles shape 1 below -
	 * both a bare provider name and a `models/` entry name (shapes 2 and 3,
	 * both explicitly validated as legal by ProjectValidator and documented
	 * in docs/conventions/models.md) threw `BxAgents.InvalidModelSlug` here,
	 * crashing generation on a project that had already passed validation
	 * cleanly.
	 *
	 *   1. "openai/gpt-5"  -> already a full provider/model slug
	 *   2. "openai"        -> a bare CORE_PROVIDERS name, no models/ lookup needed
	 *   3. "summarizer"    -> a models/summarizer.bx|.json entry's OWN
	 *                         { provider, model } struct is read and used
	 *
	 * @modelSlug The node's own resolvedConfig.model value
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .models is used)
	 * @nodePath Absolute path to this node's own directory, for error message context
	 *
	 * @return { provider, model } - model is "" when only a bare provider name was given
	 */
	private struct function resolveModelReference( required string modelSlug, required struct discovery, required string nodePath ) {
		if ( arguments.modelSlug.find( "/" ) ) {
			return variables.modelSlugParser.parse( arguments.modelSlug )
		}

		if ( variables.modelSlugParser.isKnownProvider( arguments.modelSlug ) ) {
			return { provider : arguments.modelSlug, model : "" }
		}

		var modelsEntries = arguments.discovery.models ?: []
		var match = modelsEntries.filter( function( m ) { return m.name == modelSlug } )
		if ( !match.len() ) {
			throw(
				type    = "BxAgents.InvalidModelSlug",
				message = "Agent at [#arguments.nodePath#] has model [#arguments.modelSlug#] which is neither a known provider nor a models/ entry"
			)
		}

		var entryConfig = readModelEntryConfig( match[ 1 ].path )
		if ( isNull( entryConfig ) ) {
			throw(
				type    = "BxAgents.InvalidModelSlug",
				message = "models/ entry [#arguments.modelSlug#] (referenced from [#arguments.nodePath#]) could not be read"
			)
		}

		var provider = trim( entryConfig.provider ?: "" )
		if ( !len( provider ) ) {
			throw(
				type    = "BxAgents.InvalidModelSlug",
				message = "models/ entry [#arguments.modelSlug#] (referenced from [#arguments.nodePath#]) has no 'provider'"
			)
		}

		return { provider : provider, model : trim( entryConfig.model ?: "" ) }
	}

	/**
	 * @path Absolute path to a `models/*` entry's `.bx`/`.json` file
	 *
	 * @return The entry's config struct, or null if it could not be read
	 */
	private any function readModelEntryConfig( required string path ) {
		try {
			if ( arguments.path.endsWith( ".json" ) ) {
				return jsonDeserialize( fileRead( arguments.path ) )
			}

			var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()
			var instance = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
				.instantiate( arguments.path, context )
			return instance.configure()
		} catch ( any e ) {
			return null
		}
	}

	/**
	 * Reduces a node's own `resolvedConfig.mcpServers` (a plain URL string, or
	 * a `{ url, name }` struct - per M3's validated shape) into a bare array
	 * of URL strings for `aiAgent(mcpServers: [...])`. No network connection
	 * is ever attempted here - reachability is a runtime/warning concern.
	 * Each subagent has its own resolvedConfig, so this runs per-node, not
	 * just for the root.
	 *
	 * @resolvedConfig A single node's own resolved config
	 *
	 * @return A bare array of MCP server URL strings
	 */
	private array function extractMcpServerUrls( required struct resolvedConfig ) {
		var entries = arguments.resolvedConfig.mcpServers ?: []
		var urls = []

		for ( var entry in entries ) {
			if ( isStruct( entry ) ) {
				var url = entry.url ?: ""
				if ( !len( url ) ) {
					throw(
						type    = "BxAgents.InvalidMcpServer",
						message = "An mcpServers entry is missing a 'url'"
					)
				}
				urls.append( url )
			} else if ( isSimpleValue( entry ) && len( entry ) ) {
				urls.append( entry )
			} else {
				throw(
					type    = "BxAgents.InvalidMcpServer",
					message = "An mcpServers entry must be a URL string or a { url, name } struct"
				)
			}
		}

		return urls
	}

	/**
	 * @path A filesystem path
	 *
	 * @return The path with any trailing slash(es) stripped
	 */
	private string function normalizePath( required string path ) {
		return arguments.path.reReplace( "[\/]+$", "" )
	}

	/**
	 * @name A subagent name, which may contain characters not legal in a BoxLang identifier
	 *
	 * @return name with any non-alphanumeric/underscore character replaced by "_", and a leading "_" added if it would otherwise start with a digit
	 */
	private string function sanitizeIdentifier( required string name ) {
		var sanitized = arguments.name.reReplace( "[^A-Za-z0-9_]", "_", "all" )
		return reFind( "^[0-9]", sanitized ) ? "_" & sanitized : sanitized
	}

	/**
	 * Escapes a value for embedding as a BoxLang double-quoted string literal:
	 * doubles `"` (quote escaping) and `#` (prevents accidental interpolation
	 * if the generated source is later re-parsed/evaluated).
	 *
	 * @value A raw string to embed inside a generated double-quoted BoxLang string literal
	 *
	 * @return value with `"` doubled and `#` doubled
	 */
	private string function bxLiteral( required string value ) {
		// Note: literal "#" is written as "##" in BoxLang source (its own
		// escape convention), so the search/replace args below are doubled
		// accordingly: one literal "#" is written "##", one literal "##" is "####".
		return arguments.value.replace( '"', '""', "all" ).replace( "##", "####", "all" )
	}

	/**
	 * Renders a value as a BoxLang literal for embedding in generated source:
	 * strings are quoted, booleans/numbers are bare, structs/arrays recurse.
	 * Struct keys are sorted for deterministic output. Type is checked via the
	 * value's actual Java class (not isNumeric()/isBoolean(), which test
	 * CASTABILITY in BoxLang - a genuine string like "12345" would otherwise be
	 * misrendered as a bare literal, silently changing its type).
	 *
	 * @value Any struct/array/string/numeric/boolean value to render
	 *
	 * @return A BoxLang source literal expression for value
	 */
	private string function renderLiteral( required any value ) {
		var val = arguments.value

		if ( isStruct( val ) ) {
			var keys = val.keyArray().sort( "textnocase" )
			var parts = keys.map( function( k ) {
				return '"#bxLiteral( k )#" : #renderLiteral( val[ k ] )#'
			} )
			return "{ " & parts.toList( ", " ) & " }"
		}

		if ( isArray( val ) ) {
			var parts = val.map( function( v ) {
				return renderLiteral( v )
			} )
			return "[ " & parts.toList( ", " ) & " ]"
		}

		var className = val.getClass().getName()
		var numericClasses = [
			"java.lang.Integer", "java.lang.Long", "java.lang.Short",
			"java.lang.Double", "java.lang.Float",
			"java.math.BigDecimal", "java.math.BigInteger"
		]

		if ( className == "java.lang.Boolean" ) {
			return val ? "true" : "false"
		}

		if ( numericClasses.contains( className ) ) {
			return toString( val )
		}

		return '"#bxLiteral( toString( val ) )#"'
	}

}
