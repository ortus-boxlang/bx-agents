/**
 * Generates the core ColdBox application skeleton for a project's assembled
 * agent (Build Pipeline Phase 5): `Application.bx`, `config/ColdBox.bx`,
 * `config/WireBox.bx`, and `agent/GeneratedAgentFactory.bx`.
 *
 * `GeneratedAgentFactory.bx` translates the resolved config's `provider/model`
 * slug (BX Agents' own convention) into bx-ai's separate `aiModel(provider:, params:{model:})`
 * arguments, and its declared `subAgents` names into nested `aiAgent()` calls,
 * building leaf subagents before their parents so each parent can pass in the
 * already-built child instances.
 *
 * ColdBox's own `Application.bx`/`config/ColdBox.bx`/`config/WireBox.bx` conventions
 * follow established ColdBox framework documentation.
 *
 * The plain `aiAgent()` BIF's return value is used directly for `route().toAi()`
 * exposure - no adapter subclass needed. Confirmed by reading real
 * `coldbox-platform` source (system/web/routing/Router.cfc): `toAi()`'s
 * `IAiRunnable` contract is just `run(input,params,options)`/
 * `stream(onChunk,input,params,options)`/`getName()` - exactly bx-ai's own
 * `IAiRunnable` interface, which `AiAgent` (via `AiBaseRunnable`) already
 * implements natively.
 */
class {

	property name="modelSlugParser";
	property name="configResolver";

	/**
	 * Uses the "Class@bxagents" module-relative suffix form, not a bare
	 * "bxagents.models...." path - see BuildPipeline.bx's init() docblock
	 * for why (a real bug this session found and fixed: the bare form only
	 * resolves under this repo's own dev/test mapping, not a real install).
	 */
	function init() {
		variables.modelSlugParser = new "models.build.ModelSlugParser@bxagents"()
		variables.configResolver = new "models.build.AgentConfigResolver@bxagents"()
		return this
	}

	/**
	 * @projectRoot Absolute path to the project root (containing Agent.bx/instructions.md)
	 * @buildDir Absolute path to the build output directory, e.g. "<projectRoot>/.build/app"
	 * @resolvedConfig The root project's resolved config, from AgentConfigResolver.resolve()
	 * @agentInterceptors Names of agent-scope interceptors already copied into "<buildDir>/interceptors" (see InterceptorSplitter), to reference from config/ColdBox.bx
	 * @gatewayRegistrations Bare `aiGatewayRegistry().register( aiGateway( ... ) )` statement strings (see GatewayGenerator), inserted into Application.bx's onApplicationStart()
	 * @mcpRegistrations Bare `mcpServer( ... ).registerTool( ... )` statement strings (see McpGenerator), inserted into Application.bx's onApplicationStart()
	 * @extraStartupStatements Any other bare statement strings to insert into Application.bx's onApplicationStart(), e.g. `aiToolRegistry().scan( "tools" )` (see BuildPipeline)
	 * @cliEnvironment Optional environment name the build was invoked with (e.g. from `--environment`), re-applied when resolving each subagent's OWN config so a subagent's environment-specific overrides match the same environment the root project was built for, rather than silently falling back to each subagent's default environment
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .models is used, to resolve a bare `model` value against a `models/` entry - see resolveModelReference()). Subagents have no `models/` folder of their own; every node resolves against the ROOT project's models/, matching the flat-namespace design already used for subAgents references (see docs/conventions/subagents.md)
	 *
	 * @return { applicationBx, coldboxConfig, wireboxConfig, agentFactory, index, agentNodes: every { name, accessorPath } WireBox-registered agent - see buildAgentTree() }
	 */
	struct function generate(
		required string projectRoot,
		required string buildDir,
		required struct resolvedConfig,
		array agentInterceptors = [],
		array gatewayRegistrations = [],
		array mcpRegistrations = [],
		array extraStartupStatements = [],
		string cliEnvironment = "",
		struct discovery = {}
	) {
		var root = normalizePath( arguments.projectRoot )
		var appDir = normalizePath( arguments.buildDir )

		directoryCreate( path = appDir, createPath = true, ignoreExists = true )
		directoryCreate( path = appDir & "/config", createPath = true, ignoreExists = true )
		directoryCreate( path = appDir & "/agent", createPath = true, ignoreExists = true )

		var appName = len( arguments.resolvedConfig.name ?: "" ) ? arguments.resolvedConfig.name : "BxAi"

		var applicationPath  = appDir & "/Application.bx"
		var coldboxPath      = appDir & "/config/ColdBox.bx"
		var wireboxPath      = appDir & "/config/WireBox.bx"
		var agentFactoryPath = appDir & "/agent/GeneratedAgentFactory.bx"

		var startupStatements = []
		for ( var statement in arguments.extraStartupStatements ) {
			startupStatements.append( statement )
		}
		for ( var statement in arguments.mcpRegistrations ) {
			startupStatements.append( statement )
		}
		for ( var statement in arguments.gatewayRegistrations ) {
			startupStatements.append( statement )
		}

		var agentFactory = renderAgentFactory( root, appDir, arguments.resolvedConfig, arguments.cliEnvironment, arguments.discovery )

		fileWrite( applicationPath, renderApplication( appName, startupStatements ) )
		fileWrite( coldboxPath, renderColdboxConfig( appName, arguments.agentInterceptors, arguments.resolvedConfig.security ?: {} ) )
		fileWrite( wireboxPath, renderWireBox( agentFactory.nodes ) )
		fileWrite( agentFactoryPath, agentFactory.source )

		var indexPath = appDir & "/index.bxm"
		fileWrite( indexPath, renderIndex() )

		return {
			applicationBx : applicationPath,
			coldboxConfig : coldboxPath,
			wireboxConfig : wireboxPath,
			agentFactory  : agentFactoryPath,
			index         : indexPath,
			agentNodes    : agentFactory.nodes
		}
	}

	// --------------------------------------------------------------------------
	// Static file rendering
	// --------------------------------------------------------------------------

	/**
	 * @appName The agent's name, stamped into `this.name`
	 * @startupStatements Bare statement strings inserted into `onApplicationStart()`, after `loadColdbox()` - tool scan, MCP registrations, gateway registrations, in that order
	 *
	 * @return The rendered Application.bx source
	 */
	private string function renderApplication( required string appName, array startupStatements = [] ) {
		var lines = [
			"class {",
			"",
			'	this.name              = "#bxLiteral( arguments.appName )#"',
			"	this.sessionManagement = false",
			"	this.setClientCookies  = false",
			"",
			"	COLDBOX_APP_ROOT_PATH  = expandPath( ""/"" )",
			'	COLDBOX_APP_MAPPING    = ""',
			'	COLDBOX_CONFIG_MAPPING = ""',
			'	COLDBOX_APP_KEY        = ""',
			"",
			"	function onApplicationStart() {",
			// Named args deliberately, not positional - coldbox.system.Bootstrap's
			// real init() signature is
			// (COLDBOX_CONFIG_FILE, COLDBOX_APP_ROOT_PATH, COLDBOX_APP_KEY, COLDBOX_APP_MAPPING, COLDBOX_FAIL_FAST, COLDBOX_WEB_MAPPING) -
			// a prior positional call here passed COLDBOX_APP_ROOT_PATH as the
			// FIRST arg (silently becoming COLDBOX_CONFIG_FILE), breaking config
			// loading the moment a real ColdBox boot exercised it. Confirmed
			// against real coldbox.system.Bootstrap source this session.
			"		application.cbBootstrap = new coldbox.system.Bootstrap(",
			"			COLDBOX_CONFIG_FILE   = COLDBOX_CONFIG_MAPPING,",
			"			COLDBOX_APP_ROOT_PATH = COLDBOX_APP_ROOT_PATH,",
			"			COLDBOX_APP_KEY       = COLDBOX_APP_KEY,",
			"			COLDBOX_APP_MAPPING   = COLDBOX_APP_MAPPING",
			"		)",
			"		application.cbBootstrap.loadColdbox()"
		]

		for ( var statement in arguments.startupStatements ) {
			lines.append( "		" & statement )
		}

		lines.append( "		return true" )
		lines.append( "	}" )
		lines.append( "" )
		lines.append( "	function onRequestStart( required string targetPage ) {" )
		lines.append( '		if ( structKeyExists( url, "fwreinit" ) ) {' )
		lines.append( "			application.cbBootstrap.processReinit()" )
		lines.append( "		}" )
		lines.append( "		application.cbBootstrap.onRequestStart( arguments.targetPage )" )
		lines.append( "		return true" )
		lines.append( "	}" )
		lines.append( "" )
		lines.append( "}" )
		lines.append( "" )

		return lines.toList( char( 10 ) )
	}

	/**
	 * ColdBox's own onRequestStart() (wired in Application.bx) intercepts and
	 * fully handles every request before this file's own body would run - this
	 * exists only as a physical rewrite target for the web server (MiniServer's
	 * `rewriteFileName` convention defaults to "index.bxm").
	 *
	 * @return The rendered index.bxm source (an empty script body)
	 */
	private string function renderIndex() {
		return "<bx:script>" & char( 10 ) & "</bx:script>" & char( 10 )
	}

	/**
	 * @appName The agent's name, stamped into ColdBox's own `coldbox.appName` setting
	 * @agentInterceptors Names of agent-scope interceptors already copied into `interceptors/` (see InterceptorSplitter), registered here
	 * @security The resolved config's own `security` block, forwarded verbatim into bx-ai's `moduleSettings.bxai.security` (passthrough only - see M8.5)
	 *
	 * @return The rendered config/ColdBox.bx source
	 */
	private string function renderColdboxConfig( required string appName, array agentInterceptors = [], struct security = {} ) {
		var lines = [
			"class {",
			"",
			"	function configure() {",
			"		coldbox = {",
			'			appName : "#bxLiteral( arguments.appName )#"',
			"		}"
		]

		if ( arguments.agentInterceptors.len() ) {
			lines.append( "" )
			lines.append( "		interceptors = [" )
			for ( var i = 1; i <= arguments.agentInterceptors.len(); i++ ) {
				var comma = i < arguments.agentInterceptors.len() ? "," : ""
				lines.append( '			{ class : "interceptors.#bxLiteral( arguments.agentInterceptors[ i ] )#" }#comma#' )
			}
			lines.append( "		]" )
		}

		// bx-ai's own skillsDirectory setting defaults to "/.agents/skills" - a
		// DIFFERENT path than BX Agents' own skills/ convention (copied verbatim
		// by ToolsSkillsCopier, M6), so it must always be pointed at "/skills"
		// or bx-ai would never find them. security (if any) is forwarded
		// verbatim in the same block - bx-ai's own SecurityDirector.buildGlobalMiddleware()
		// turns it into middleware automatically (decision: passthrough only,
		// no new guardrails/ convention folder for v1 - see the build plan's M8.5).
		var bxaiSettings = { skillsDirectory : "/skills" }
		if ( arguments.security.count() ) {
			bxaiSettings[ "security" ] = arguments.security
		}
		lines.append( "" )
		lines.append( "		moduleSettings = {" )
		lines.append( "			bxai : #renderLiteral( bxaiSettings )#" )
		lines.append( "		}" )

		lines.append( "	}" )
		lines.append( "" )
		lines.append( "}" )
		lines.append( "" )

		return lines.toList( char( 10 ) )
	}

	/**
	 * Maps GeneratedAgentFactory, the lazily-built singleton GeneratedAgent
	 * (the root of the tree), and - the point of `agentNodes` - one
	 * additional binding PER agent node in the tree (root + every subagent,
	 * recursively), keyed by that node's OWN declared `name` from its
	 * Agent.bx. This is what lets a hand-written `schedules/Scheduler.bx`
	 * (or anything else WireBox-aware) call `getInstance( "SupportBot" )`/
	 * `getInstance( "Summarizer" )` directly instead of only ever reaching
	 * the fixed `"GeneratedAgent"` root alias.
	 *
	 * Every node resolves off the SAME underlying singleton build - a
	 * subagent's binding is just `injector.getInstance( "GeneratedAgent" )`
	 * plus one `getSubAgent( name )` hop per level of nesting (confirmed
	 * against real bx-ai source: `AiAgent.getSubAgent( name )` searches that
	 * node's own DIRECT `subAgents` by their own `getAgentName()`, so a
	 * grandchild needs one hop per ancestor, not just one) - never a second,
	 * independent construction.
	 *
	 * @agentNodes Every node in the tree - { name, accessorPath } structs from buildAgentTree(), where accessorPath is the ordered list of getSubAgent() names needed to reach that node from the root singleton (empty for root itself)
	 *
	 * @return The rendered config/WireBox.bx source
	 */
	private string function renderWireBox( required array agentNodes ) {
		var lines = [
			'class extends="coldbox.system.ioc.config.Binder" {',
			"",
			"	function configure() {",
			'		map( "GeneratedAgentFactory" ).to( "agent.GeneratedAgentFactory" ).asSingleton()',
			"",
			"		// Built once, shared by every consumer (HTTP routes via toAi(), the",
			"		// CLI chat REPL, etc.) - never construct the agent tree more than once.",
			"		// `injector`, not a bare getInstance() call - coldbox.system.ioc.config.Binder",
			"		// has no such delegate/method at all (confirmed against real source this",
			"		// session); `variables.injector` is the real WireBox Injector reference",
			"		// Binder itself uses internally for the same purpose.",
			'		map( "GeneratedAgent" ).toProvider( function() {',
			'			return injector.getInstance( "GeneratedAgentFactory" ).buildAgent()',
			"		} ).asSingleton()"
		]

		for ( var node in arguments.agentNodes ) {
			var accessor = 'injector.getInstance( "GeneratedAgent" )'
			for ( var hop in node.accessorPath ) {
				accessor &= '.getSubAgent( "#bxLiteral( hop )#" )'
			}

			lines.append( "" )
			lines.append( "		// Lets schedules/Scheduler.bx (or anything else) resolve this" )
			lines.append( "		// agent directly by the name its own Agent.bx declares." )
			lines.append( '		map( "#bxLiteral( node.name )#" ).toProvider( function() {' )
			lines.append( "			return #accessor#" )
			lines.append( "		} )" )
		}

		lines.append( "	}" )
		lines.append( "" )
		lines.append( "}" )
		lines.append( "" )
		return lines.toList( char( 10 ) )
	}

	// --------------------------------------------------------------------------
	// GeneratedAgentFactory.bx - the agent/subagent build tree
	// --------------------------------------------------------------------------

	/**
	 * Real bug found this session: this factory's generated `aiAgent()` calls
	 * NEVER passed a `tools:` argument at all (confirmed against real bx-ai
	 * source: `AiAgent.bx` never references `aiToolRegistry()` internally -
	 * a project's tools/ were copied into the build and made
	 * name-resolvable for MCP wiring, but no agent BX Agents ever built - in
	 * ANY context: a real served app, `chat`, or a test spec - actually
	 * received them). Fixed here, not by relying on `aiToolRegistry().scan("tools")`'s
	 * relative-path resolution (which depends on whatever "/" mapping is in
	 * effect for the CALLING context - unverified/fragile the moment this
	 * factory is loaded via `DynamicClassLoader` rather than a real ColdBox
	 * boot): `ToolRegistryLoader.bx` is called once here with the tools
	 * directory's ABSOLUTE path embedded as a literal at generation time
	 * (the same pattern already used for `instructions.md`'s own absolute
	 * `fileRead()` path below), then every agent node's `aiAgent()` call
	 * attaches `aiToolRegistry().getAll()` - safe regardless of how many
	 * nodes exist, since re-registering an already-scanned tool is a no-op
	 * overwrite (confirmed against real bx-ai `BaseRegistry.register()`
	 * source).
	 *
	 * @projectRoot Absolute path to the project root (containing Agent.bx/instructions.md)
	 * @appDir Absolute path to the generated ColdBox app dir - its own `tools/` subfolder is loaded
	 * @resolvedConfig The root project's resolved config
	 * @cliEnvironment Optional environment name the build was invoked with, re-applied to every subagent's own config resolution
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .models is used)
	 *
	 * @return { source: the rendered agent/GeneratedAgentFactory.bx source, nodes: every agent node in the tree - see buildAgentTree() }
	 */
	private struct function renderAgentFactory( required string projectRoot, required string appDir, required struct resolvedConfig, string cliEnvironment = "", struct discovery = {} ) {
		var built = buildAgentTree( arguments.projectRoot, arguments.projectRoot, arguments.resolvedConfig, "agent", arguments.cliEnvironment, arguments.discovery )
		var body = built.statements.toList( char( 10 ) & char( 10 ) )
		var toolsDir = normalizePath( arguments.appDir ) & "/tools"

		var lines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" */",
			"class {",
			"",
			"	function buildAgent() {",
			'		new "models.build.ToolRegistryLoader@bxagents"().load( "#bxLiteral( toolsDir )#" )',
			"",
			body,
			"",
			"		return agent",
			"	}",
			"",
			"}",
			""
		]
		return { source : lines.toList( char( 10 ) ), nodes : built.nodes }
	}

	/**
	 * Recursively builds the leaf-first list of `var <name> = aiAgent(...)`
	 * statements for a project and its declared `subAgents`.
	 *
	 * Per the M3-validated DAG model, subagents live in a single FLAT
	 * namespace under the root project's own `subagents/` folder - a
	 * subagent's declared `subAgents` names reference SIBLING entries in
	 * that same root-level folder, not a folder nested under itself. So
	 * `rootProjectRoot` (fixed) is threaded through separately from
	 * `nodePath` (this node's own directory, used to locate its instructions.md).
	 *
	 * `cliEnvironment` (the same value the root project itself was resolved
	 * with - see BuildPipeline.build()'s `cliEnvironment` param) is re-applied
	 * to every subagent's own `AgentConfigResolver.resolve()` call too - a
	 * real bug this closed: without this, a subagent's own environment-
	 * specific overrides were always resolved against ITS default
	 * environment, silently ignoring whatever `--environment` the whole
	 * build was actually invoked with, so a `--environment=production` build
	 * could still generate a subagent wired to its dev-environment config.
	 *
	 * Also collects, per node, `{ name, accessorPath }` - `name` is the
	 * node's own declared name (see `resolveAgentName()`) and `accessorPath`
	 * is the ordered list of `getSubAgent()` names needed to reach it from
	 * the root singleton (empty for root itself) - `renderWireBox()` uses
	 * these to register every agent under its own name.
	 *
	 * @rootProjectRoot Absolute path to the ROOT project root - fixed across the whole recursion, since subagents always live under its own `subagents/` folder
	 * @nodePath Absolute path to THIS node's own directory, used to locate its instructions.md
	 * @resolvedConfig THIS node's own resolved config
	 * @varName The BoxLang variable name to assign this node's built `aiAgent()` to, e.g. "agent" or "subagent_foo"
	 * @cliEnvironment Optional environment name the build was invoked with, re-applied to every subagent's own config resolution
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .models is used), shared by every node
	 * @accessorPath The ordered list of getSubAgent() names needed to reach THIS node from the root singleton - empty for the initial (root) call
	 *
	 * @return { statements: leaf-first `var <name> = aiAgent(...)` statement strings, nodes: [ { name, accessorPath } ] for this node and every descendant }
	 */
	private struct function buildAgentTree(
		required string rootProjectRoot,
		required string nodePath,
		required struct resolvedConfig,
		required string varName,
		string cliEnvironment = "",
		struct discovery = {},
		array accessorPath = []
	) {
		var declaredSubAgents = arguments.resolvedConfig.subAgents ?: []
		var subAgentVarNames = []
		var statements = []
		var thisName = resolveAgentName( arguments.resolvedConfig )
		var nodes = [ { name : thisName, accessorPath : arguments.accessorPath } ]

		for ( var subName in declaredSubAgents ) {
			var subPath = arguments.rootProjectRoot & "/subagents/" & subName
			if ( !directoryExists( subPath ) ) {
				throw(
					type    = "BxAgents.MissingSubagent",
					message = "Subagent [#subName#] referenced from [#arguments.nodePath#] was not found at [#subPath#]"
				)
			}

			var subConfig = variables.configResolver.resolve( projectRoot = subPath, cliEnvironment = arguments.cliEnvironment )
			var subVarName = "subagent_" & sanitizeIdentifier( subName )
			var childAccessorPath = duplicate( arguments.accessorPath )
			childAccessorPath.append( resolveAgentName( subConfig ) )

			var built = buildAgentTree( arguments.rootProjectRoot, subPath, subConfig, subVarName, arguments.cliEnvironment, arguments.discovery, childAccessorPath )

			for ( var stmt in built.statements ) {
				statements.append( stmt )
			}
			for ( var node in built.nodes ) {
				nodes.append( node )
			}
			subAgentVarNames.append( subVarName )
		}

		statements.append( renderAgentStatement( arguments.varName, arguments.nodePath, arguments.resolvedConfig, subAgentVarNames, arguments.discovery, thisName ) )

		return { statements : statements, nodes : nodes }
	}

	/**
	 * The single source of truth for a node's own declared agent name -
	 * reused by ProjectValidator's name-uniqueness check (now that a
	 * duplicate name would silently collide as a WireBox binding key) so
	 * the two never drift on what "no name set" defaults to.
	 *
	 * @resolvedConfig A single node's own resolved config
	 *
	 * @return resolvedConfig.name if set, else the default "BxAi"
	 */
	string function resolveAgentName( required struct resolvedConfig ) {
		return len( arguments.resolvedConfig.name ?: "" ) ? arguments.resolvedConfig.name : "BxAi"
	}

	/**
	 * @varName The BoxLang variable name to assign this node's built `aiAgent()` to
	 * @nodePath Absolute path to THIS node's own directory, used to locate its instructions.md
	 * @resolvedConfig THIS node's own resolved config
	 * @subAgentVarNames Already-rendered child variable names, to reference in this node's own `subAgents: [...]`
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .models is used)
	 * @name This node's own declared agent name (see resolveAgentName()) - passed in rather than recomputed, so it stays identical to the value buildAgentTree() already used to build this node's WireBox accessor path
	 *
	 * @return The rendered `var <name> = aiAgent(...)` statement string for this one node
	 */
	private string function renderAgentStatement(
		required string varName,
		required string nodePath,
		required struct resolvedConfig,
		required array subAgentVarNames,
		struct discovery = {},
		required string name
	) {
		var instructionsPath = arguments.nodePath & "/instructions.md"
		if ( !fileExists( instructionsPath ) ) {
			throw(
				type    = "BxAgents.MissingInstructions",
				message = "No instructions.md found at [#instructionsPath#]"
			)
		}

		var modelSlug = arguments.resolvedConfig.model ?: ""
		if ( !len( modelSlug ) ) {
			throw(
				type    = "BxAgents.MissingModel",
				message = "Agent at [#arguments.nodePath#] has no model configured"
			)
		}

		var parsedModel = resolveModelReference( modelSlug, arguments.discovery, arguments.nodePath )
		var description = arguments.resolvedConfig.description ?: ""

		var modelExpression = len( parsedModel.model )
			? 'aiModel( provider : "#bxLiteral( parsedModel.provider )#", params : { model : "#bxLiteral( parsedModel.model )#" } )'
			: 'aiModel( provider : "#bxLiteral( parsedModel.provider )#" )'

		var lines = []
		lines.append( "var #arguments.varName# = aiAgent(" )
		lines.append( '	name : "#bxLiteral( arguments.name )#",' )
		lines.append( '	description : "#bxLiteral( description )#",' )
		lines.append( '	instructions : fileRead( "#bxLiteral( instructionsPath )#" ),' )
		lines.append( '	model : #modelExpression#,' )
		lines.append( "	tools : aiToolRegistry().getAll()," )

		if ( arguments.subAgentVarNames.len() ) {
			lines.append( "	subAgents : [ #arguments.subAgentVarNames.toList( ", " )# ]," )
		} else {
			lines.append( "	subAgents : []," )
		}

		var mcpServerUrls = extractMcpServerUrls( arguments.resolvedConfig )
		if ( mcpServerUrls.len() ) {
			var quoted = mcpServerUrls.map( function( url ) {
				return '"#bxLiteral( url )#"'
			} )
			lines.append( "	mcpServers : [ #quoted.toList( ", " )# ]" )
		} else {
			lines.append( "	mcpServers : []" )
		}

		lines.append( ")" )

		return lines.toList( char( 10 ) )
	}

	// --------------------------------------------------------------------------
	// Helpers
	// --------------------------------------------------------------------------

	/**
	 * Resolves a node's `model` value (already validated by ProjectValidator's
	 * validateModelProvider(), a permissive check happy with ANY of the 3
	 * shapes below) into a concrete `{ provider, model }` pair -
	 * `model` is `""` when only a provider was given, meaning "use that
	 * provider's own default model" (aiModel() supports omitting `params.model`
	 * entirely - see bx-ai's aiModel.bif docblock).
	 *
	 * A real bug this closed: this used to call `modelSlugParser.parse()`
	 * directly with no `defaultProvider`, which only handles shape 1 below -
	 * both a bare provider name and a `models/` entry name (shapes 2 and 3,
	 * both explicitly validated as legal by ProjectValidator and documented
	 * in docs/conventions/models.md) threw `BxAgents.InvalidModelSlug` here,
	 * crashing generation on a project that had already passed validation
	 * cleanly.
	 *
	 *   1. "openai/gpt-5"  -> already a full provider/model slug
	 *   2. "openai"        -> a bare CORE_PROVIDERS name, no models/ lookup needed
	 *   3. "summarizer"    -> a models/summarizer.bx|.json entry's OWN
	 *                         { provider, model } struct is read and used
	 *
	 * @modelSlug The node's own resolvedConfig.model value
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .models is used)
	 * @nodePath Absolute path to this node's own directory, for error message context
	 *
	 * @return { provider, model } - model is "" when only a bare provider name was given
	 */
	private struct function resolveModelReference( required string modelSlug, required struct discovery, required string nodePath ) {
		if ( arguments.modelSlug.find( "/" ) ) {
			return variables.modelSlugParser.parse( arguments.modelSlug )
		}

		if ( variables.modelSlugParser.isKnownProvider( arguments.modelSlug ) ) {
			return { provider : arguments.modelSlug, model : "" }
		}

		var modelsEntries = arguments.discovery.models ?: []
		var match = modelsEntries.filter( function( m ) { return m.name == modelSlug } )
		if ( !match.len() ) {
			throw(
				type    = "BxAgents.InvalidModelSlug",
				message = "Agent at [#arguments.nodePath#] has model [#arguments.modelSlug#] which is neither a known provider nor a models/ entry"
			)
		}

		var entryConfig = readModelEntryConfig( match[ 1 ].path )
		if ( isNull( entryConfig ) ) {
			throw(
				type    = "BxAgents.InvalidModelSlug",
				message = "models/ entry [#arguments.modelSlug#] (referenced from [#arguments.nodePath#]) could not be read"
			)
		}

		var provider = trim( entryConfig.provider ?: "" )
		if ( !len( provider ) ) {
			throw(
				type    = "BxAgents.InvalidModelSlug",
				message = "models/ entry [#arguments.modelSlug#] (referenced from [#arguments.nodePath#]) has no 'provider'"
			)
		}

		return { provider : provider, model : trim( entryConfig.model ?: "" ) }
	}

	/**
	 * @path Absolute path to a `models/*` entry's `.bx`/`.json` file
	 *
	 * @return The entry's config struct, or null if it could not be read
	 */
	private any function readModelEntryConfig( required string path ) {
		try {
			if ( arguments.path.endsWith( ".json" ) ) {
				return jsonDeserialize( fileRead( arguments.path ) )
			}

			var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()
			var instance = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
				.instantiate( arguments.path, context )
			return instance.configure()
		} catch ( any e ) {
			return null
		}
	}

	/**
	 * Reduces a node's own `resolvedConfig.mcpServers` (a plain URL string, or
	 * a `{ url, name }` struct - per M3's validated shape) into a bare array
	 * of URL strings for `aiAgent(mcpServers: [...])`. No network connection
	 * is ever attempted here - reachability is a runtime/warning concern.
	 * Each subagent has its own resolvedConfig, so this runs per-node, not
	 * just for the root.
	 *
	 * @resolvedConfig A single node's own resolved config
	 *
	 * @return A bare array of MCP server URL strings
	 */
	private array function extractMcpServerUrls( required struct resolvedConfig ) {
		var entries = arguments.resolvedConfig.mcpServers ?: []
		var urls = []

		for ( var entry in entries ) {
			if ( isStruct( entry ) ) {
				var url = entry.url ?: ""
				if ( !len( url ) ) {
					throw(
						type    = "BxAgents.InvalidMcpServer",
						message = "An mcpServers entry is missing a 'url'"
					)
				}
				urls.append( url )
			} else if ( isSimpleValue( entry ) && len( entry ) ) {
				urls.append( entry )
			} else {
				throw(
					type    = "BxAgents.InvalidMcpServer",
					message = "An mcpServers entry must be a URL string or a { url, name } struct"
				)
			}
		}

		return urls
	}

	/**
	 * @path A filesystem path
	 *
	 * @return The path with any trailing slash(es) stripped
	 */
	private string function normalizePath( required string path ) {
		return arguments.path.reReplace( "[\/]+$", "" )
	}

	/**
	 * @name A subagent name, which may contain characters not legal in a BoxLang identifier
	 *
	 * @return name with any non-alphanumeric/underscore character replaced by "_", and a leading "_" added if it would otherwise start with a digit
	 */
	private string function sanitizeIdentifier( required string name ) {
		var sanitized = arguments.name.reReplace( "[^A-Za-z0-9_]", "_", "all" )
		return reFind( "^[0-9]", sanitized ) ? "_" & sanitized : sanitized
	}

	/**
	 * Escapes a value for embedding as a BoxLang double-quoted string literal:
	 * doubles `"` (quote escaping) and `#` (prevents accidental interpolation
	 * if the generated source is later re-parsed/evaluated).
	 *
	 * @value A raw string to embed inside a generated double-quoted BoxLang string literal
	 *
	 * @return value with `"` doubled and `#` doubled
	 */
	private string function bxLiteral( required string value ) {
		// Note: literal "#" is written as "##" in BoxLang source (its own
		// escape convention), so the search/replace args below are doubled
		// accordingly: one literal "#" is written "##", one literal "##" is "####".
		return arguments.value.replace( '"', '""', "all" ).replace( "##", "####", "all" )
	}

	/**
	 * Renders a value as a BoxLang literal for embedding in generated source:
	 * strings are quoted, booleans/numbers are bare, structs/arrays recurse.
	 * Struct keys are sorted for deterministic output. Type is checked via the
	 * value's actual Java class (not isNumeric()/isBoolean(), which test
	 * CASTABILITY in BoxLang - a genuine string like "12345" would otherwise be
	 * misrendered as a bare literal, silently changing its type).
	 *
	 * @value Any struct/array/string/numeric/boolean value to render
	 *
	 * @return A BoxLang source literal expression for value
	 */
	private string function renderLiteral( required any value ) {
		var val = arguments.value

		if ( isStruct( val ) ) {
			var keys = val.keyArray().sort( "textnocase" )
			var parts = keys.map( function( k ) {
				return '"#bxLiteral( k )#" : #renderLiteral( val[ k ] )#'
			} )
			return "{ " & parts.toList( ", " ) & " }"
		}

		if ( isArray( val ) ) {
			var parts = val.map( function( v ) {
				return renderLiteral( v )
			} )
			return "[ " & parts.toList( ", " ) & " ]"
		}

		var className = val.getClass().getName()
		var numericClasses = [
			"java.lang.Integer", "java.lang.Long", "java.lang.Short",
			"java.lang.Double", "java.lang.Float",
			"java.math.BigDecimal", "java.math.BigInteger"
		]

		if ( className == "java.lang.Boolean" ) {
			return val ? "true" : "false"
		}

		if ( numericClasses.contains( className ) ) {
			return toString( val )
		}

		return '"#bxLiteral( toString( val ) )#"'
	}

}
