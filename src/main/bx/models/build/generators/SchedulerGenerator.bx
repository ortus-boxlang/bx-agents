/**
 * Copies a project's `schedules/*.bx` into the generated app (Build Pipeline Phase 5) as `schedules/<Name>.bx`.
 *
 * Every file is one BoxLang scheduler: a plain class with a `configure()` that builds tasks, using BoxLang's own
 * task DSL (`.cron()`, `.every...()`, `.withNoOverlaps()`, `.call()` ...). There is no ColdBox in a scheduler.
 * The generated base `Application.bx` lists the copied classes in `this.schedulers`, so BoxLang starts them with
 * the app and shuts them down with it (see ColdBoxAppGenerator).
 *
 * A scheduler gets its helpers (`task()`, `run()`, `agent()` ... see runtime/Scheduler.bx) by inheritance. The
 * developer does not have to write the `extends`: the copy adds `extends="bxagents.Scheduler"` to a class
 * that names no parent of its own, so a scheduler file is just `class { function configure() { ... } }`.
 *
 * ```javascript
 * // schedules/Nightly.bx
 * class {
 *     function configure() {
 *         task( "cleanup" )
 *             .cron( "0 0 * * *" )
 *             .call( () => run( "clean up old tickets" ) )
 *     }
 * }
 * ```
 */
import bxModules.bxagents.models.util.Strings;

class {

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .schedules is used)
	 *
	 * @return The class path of each scheduler, relative to the app, e.g. [ "schedules.Nightly" ]
	 */
	array function classPaths( required struct discovery ) {
		return ( arguments.discovery.schedules ?: [] ).map( e => "schedules." & e.name )
	}

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .schedules is used)
	 * @appDir Absolute path to the generated ColdBox app dir, e.g. "<projectRoot>/.build/app"
	 *
	 * @return { schedulers : [ { name, classPath, path } ] } - what was written, in the order it was discovered
	 */
	struct function generate( required struct discovery, required string appDir ) {
		var schedulesDir = Strings::normalizePath( arguments.appDir ) & "/schedules"

		// Matches the rest of the build: wipe stale output, never merge into it
		if ( directoryExists( schedulesDir ) ) {
			directoryDelete( schedulesDir, true )
		}

		var entries = arguments.discovery.schedules ?: []
		if ( !entries.len() ) {
			return { schedulers : [] }
		}

		directoryCreate( path = schedulesDir, createPath = true, ignoreExists = true )

		var written = []
		for ( var entry in entries ) {
			var target = schedulesDir & "/" & entry.name & ".bx"
			fileWrite( target, withBase( fileRead( entry.path, "UTF-8" ), entry.name ) )
			written.append( { name : entry.name, classPath : "schedules." & entry.name, path : target } )
		}

		return { schedulers : written }
	}

	/**
	 * Adds `extends="bxagents.Scheduler"` to the scheduler class unless it already names a parent.
	 *
	 * @source The scheduler file's source
	 * @name The scheduler's file name without extension, used in the error message
	 *
	 * @return The source to copy into the app
	 */
	string function withBase( required string source, required string name ) {
		var declaration = reFind( "(?m)^[ \t]*class\b", arguments.source, 1, true )
		if ( !declaration.pos[ 1 ] ) {
			throw(
				type    = "BxAgents.InvalidScheduler",
				message = "schedules/#arguments.name#.bx has no class declaration. A scheduler is a class: class { function configure() { ... } }"
			)
		}

		var afterKeyword = declaration.pos[ 1 ] + declaration.len[ 1 ]
		var opening = arguments.source.find( "{", afterKeyword )
		var header = opening ? arguments.source.mid( afterKeyword, opening - afterKeyword ) : ""
		if ( reFindNoCase( "\bextends\s*=", header ) ) {
			return arguments.source
		}

		return arguments.source.left( afterKeyword - 1 ) & ' extends="bxagents.Scheduler"' & arguments.source.mid( afterKeyword, len( arguments.source ) )
	}

}
