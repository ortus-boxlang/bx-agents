/**
 * Passes a project's own `schedules/Scheduler.bx` through into the build
 * (Build Pipeline Phase 5) as `config/Scheduler.bx` - a plain file copy, no
 * generation, no translation.
 *
 * `schedules/Scheduler.bx` is a REAL, hand-written ColdBox scheduler class
 * (`extends="coldbox.system.web.tasks.ColdBoxScheduler"`), using ColdBox's
 * own full `task()`/`.cron()`/`.everyDayAt()`/`.withNoOverlaps()`/`.when()`/
 * `.startOn()`/`.endOn()`/etc. DSL directly - not a BX Agents-specific
 * `{cron, action}` config shape. This project used to translate a narrow
 * `{cron, action}` convention into ColdBox's frequency-method DSL here, but
 * that meant re-inventing (and, worse, only PARTIALLY re-inventing - lists,
 * ranges, step values, and day-of-month-AND-day-of-week combined cron
 * expressions had no translation) a scheduler ColdBox already has a real,
 * complete API for. Removing the translation layer means a schedule can use
 * anything ColdBox's scheduler supports, with nothing left for this project
 * to keep in sync with it.
 *
 * Each agent in the tree (root + every subagent, recursively) is registered
 * in the generated `config/WireBox.bx` under its OWN declared `name` from
 * its `Agent.bx` (see `ColdBoxAppGenerator.renderWireBox()`), so a schedule
 * reaches whichever agent it wants via a plain `getInstance( "TheAgentName" )` -
 * exactly like any other WireBox-aware ColdBox code, no BX Agents-specific
 * lookup needed:
 *
 * ```javascript
 * // schedules/Scheduler.bx
 * component extends="coldbox.system.web.tasks.ColdBoxScheduler" {
 *     function configure() {
 *         task( "nightly" )
 *             .call( () => getInstance( "SupportBot" ).run( "cleanup" ) )
 *             .everyDayAt( "00:00" )
 *             .withNoOverlaps()
 *     }
 * }
 * ```
 */
class {

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .hasScheduler is used)
	 * @appDir Absolute path to the generated ColdBox app dir, e.g. "<projectRoot>/.build/app"
	 *
	 * @return { hasSchedules: boolean, scheduler: the written config/Scheduler.bx path, only present when hasSchedules is true }
	 */
	struct function generate( required struct discovery, required string appDir ) {
		if ( !( arguments.discovery.hasScheduler ?: false ) ) {
			return { hasSchedules : false }
		}

		var appDir = normalizePath( arguments.appDir )
		directoryCreate( path = appDir & "/config", createPath = true, ignoreExists = true )
		var schedulerPath = appDir & "/config/Scheduler.bx"

		fileWrite( schedulerPath, fileRead( arguments.discovery.schedulerPath ) )

		return { scheduler : schedulerPath, hasSchedules : true }
	}

	/**
	 * @path A filesystem path
	 *
	 * @return The path with any trailing slash(es) stripped
	 */
	private string function normalizePath( required string path ) {
		return arguments.path.reReplace( "[\/]+$", "" )
	}

}
