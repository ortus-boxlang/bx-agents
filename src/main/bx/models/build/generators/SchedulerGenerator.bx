/**
 * Generates `config/Scheduler.bx` for a project's `schedules/*` entries (Build
 * Pipeline Phase 5): one ColdBox scheduled task per entry, invoking the same
 * singleton "GeneratedAgent" instance (see ColdBoxAppGenerator/WireBox.bx from
 * M8) with the schedule's `action` string as a plain prompt - e.g.
 * `{ cron: "0 0 * * *", action: "cleanup" }` wakes the agent up once a day
 * with the message "cleanup" and lets it reason/use tools from there. There is
 * no "does this action exist" check, since any string is a valid prompt -
 * only that `action` is present at all.
 *
 * ColdBox's task scheduler has NO raw cron expression support (confirmed via
 * https://coldbox.ortusbooks.com/digging-deeper/scheduled-tasks - the DSL is
 * named frequency methods: every()/everyMinute()/everyHour()/everyHourAt()/
 * everyDayAt()/everyWeekOn()/etc., not a cron string). `schedules/*`'s cron
 * convention (already 5-field-validated in M3) is translated to the closest
 * matching frequency method here. Only a deliberately narrow subset of cron
 * shapes is supported for now - every-N-minutes, every-N-hours, every-hour-
 * at-minute, every-minute, and daily-at-time - all built from methods whose
 * exact signature this session could confirm from documentation. Weekly/
 * monthly/day-of-week cron shapes, and any list/range field, are rejected
 * with a clear error rather than guessed at (everyWeekOn()/everyMonthOn()'s
 * `day` argument format - number vs weekday name - wasn't confirmed this
 * session; revisit once coldbox-platform source is available).
 */
class {

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .schedules is used)
	 * @appDir Absolute path to the generated ColdBox app dir, e.g. "<projectRoot>/.build/app"
	 */
	struct function generate( required struct discovery, required string appDir ) {
		var schedules = arguments.discovery.schedules ?: []

		if ( !schedules.len() ) {
			return { hasSchedules : false }
		}

		var lines = []
		for ( var schedule in schedules ) {
			lines.append( renderTask( schedule ) )
		}

		var appDir = normalizePath( arguments.appDir )
		directoryCreate( path = appDir & "/config", createPath = true, ignoreExists = true )
		var schedulerPath = appDir & "/config/Scheduler.bx"
		fileWrite( schedulerPath, renderSchedulerFile( lines ) )

		return { scheduler : schedulerPath, hasSchedules : true }
	}

	private string function renderTask( required struct schedule ) {
		var config = readEntryConfig( arguments.schedule.path )
		if ( isNull( config ) ) {
			throw(
				type    = "BxAgents.InvalidSchedule",
				message = "Schedule [#arguments.schedule.name#] could not be read"
			)
		}

		var action = trim( config.action ?: "" )
		if ( !len( action ) ) {
			throw(
				type    = "BxAgents.MissingScheduleAction",
				message = "Schedule [#arguments.schedule.name#] is missing an 'action'"
			)
		}

		var cron = trim( config.cron ?: "" )
		var frequency = translateCron( cron, arguments.schedule.name )

		return 'task( "#bxLiteral( arguments.schedule.name )#" ).call( () => getInstance( "GeneratedAgent" ).run( "#bxLiteral( action )#" ) ).#frequency#'
	}

	// --------------------------------------------------------------------------
	// Cron -> ColdBox frequency-method translation
	// --------------------------------------------------------------------------

	private string function translateCron( required string cron, required string scheduleName ) {
		var fields = listToArray( arguments.cron, " " )
		if ( fields.len() != 5 ) {
			throwUnsupportedCron( arguments.cron, arguments.scheduleName )
		}

		var minute = fields[ 1 ]
		var hour = fields[ 2 ]
		var dom = fields[ 3 ]
		var month = fields[ 4 ]
		var dow = fields[ 5 ]

		// Only day-of-month/month/day-of-week == "*" shapes are supported for now.
		if ( dom != "*" || month != "*" || dow != "*" ) {
			throwUnsupportedCron( arguments.cron, arguments.scheduleName )
		}

		// */N minutes, every other field "*" -> every(N, "minutes")
		if ( minute.startsWith( "*/" ) && hour == "*" ) {
			return 'every( #minute.right( len( minute ) - 2 )#, "minutes" )'
		}

		// exact minute, */N hours -> every(N, "hours")
		if ( isExactNumber( minute ) && hour.startsWith( "*/" ) ) {
			return 'every( #hour.right( len( hour ) - 2 )#, "hours" )'
		}

		// "*" minute, "*" hour -> every minute
		if ( minute == "*" && hour == "*" ) {
			return "everyMinute()"
		}

		// exact minute, "*" hour -> every hour, at that minute
		if ( isExactNumber( minute ) && hour == "*" ) {
			return "everyHourAt( #minute# )"
		}

		// exact minute, exact hour -> daily at HH:MM
		if ( isExactNumber( minute ) && isExactNumber( hour ) ) {
			return 'everyDayAt( "#padTime( hour )#:#padTime( minute )#" )'
		}

		throwUnsupportedCron( arguments.cron, arguments.scheduleName )
		return "" // unreachable, keeps the compiler happy about a return on every path
	}

	private void function throwUnsupportedCron( required string cron, required string scheduleName ) {
		throw(
			type    = "BxAgents.UnsupportedCronExpression",
			message = "Schedule [#arguments.scheduleName#] uses a cron expression [#arguments.cron#] that has no equivalent in ColdBox's frequency-method scheduler DSL yet - supported shapes: '*/N * * * *', 'M */N * * *', '* * * * *', 'M * * * *', 'M H * * *' (exact minute/hour only, no lists/ranges/day-of-week/day-of-month/month)"
		)
	}

	private boolean function isExactNumber( required string field ) {
		return reFind( "^[0-9]+$", arguments.field ) > 0
	}

	private string function padTime( required string numericField ) {
		return len( arguments.numericField ) < 2 ? "0" & arguments.numericField : arguments.numericField
	}

	// --------------------------------------------------------------------------
	// File rendering
	// --------------------------------------------------------------------------

	private string function renderSchedulerFile( required array lines ) {
		var fileLines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" */",
			"class {",
			"",
			"	function configure() {"
		]

		for ( var line in arguments.lines ) {
			fileLines.append( "		" & line )
		}

		fileLines.append( "	}" )
		fileLines.append( "" )
		fileLines.append( "}" )
		fileLines.append( "" )

		return fileLines.toList( char( 10 ) )
	}

	private any function readEntryConfig( required string path ) {
		try {
			if ( arguments.path.endsWith( ".json" ) ) {
				return jsonDeserialize( fileRead( arguments.path ) )
			}

			var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()
			var instance = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
				.instantiate( arguments.path, context )
			return instance.configure()
		} catch ( any e ) {
			return null
		}
	}

	private string function normalizePath( required string path ) {
		return arguments.path.reReplace( "[\/]+$", "" )
	}

	private string function bxLiteral( required string value ) {
		return arguments.value.replace( '"', '""', "all" ).replace( "##", "####", "all" )
	}

}
