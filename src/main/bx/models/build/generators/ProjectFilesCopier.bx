/**
 * Copies the project's own definition files into the built app's `project/` folder, so a served app can show them
 * (the admin Files tab) without the project next to it: the agent definition (Agent.yml or Agent.bx), the
 * instructions, and the subagents/ and gateways/ folders. tools/ and skills/ are copied to the app's own folders
 * by ToolsSkillsCopier.
 *
 * These are text files that name secrets, never hold them (Agent.yml says which environment variable to read).
 * What is never copied: hidden files (.env), a secrets file, a symbolic link, and anything that is not text.
 */
class {

	static {
		FILES   = [ "Agent.yml", "Agent.bx", "instructions.md" ]
		FOLDERS = [ "subagents", "gateways" ]
		TEXT    = "md,yaml,yml,bx,bxs,bxm,json,txt"
		TARGET  = "project"
	}

	/**
	 * @projectRoot The project folder
	 * @appDir The built app's folder
	 *
	 * @return { copied : how many files }
	 */
	struct function copy( required string projectRoot, required string appDir ) {
		var root = replace( arguments.projectRoot, "\", "/", "all" ).reReplace( "/+$", "" )
		var target = replace( arguments.appDir, "\", "/", "all" ).reReplace( "/+$", "" ) & "/" & static.TARGET
		if ( directoryExists( target ) ) {
			directoryDelete( target, true )
		}
		var copied = 0
		for ( var name in static.FILES ) {
			if ( fileExists( root & "/" & name ) && safe( root, root & "/" & name ) ) {
				directoryCreate( path = target, createPath = true, ignoreExists = true )
				fileCopy( root & "/" & name, target & "/" & name )
				copied++
			}
		}
		for ( var folder in static.FOLDERS ) {
			if ( !directoryExists( root & "/" & folder ) ) {
				continue
			}
			for ( var file in directoryList( path = root & "/" & folder, recurse = true, listInfo = "array", type = "file" ) ) {
				var clean = replace( file, "\", "/", "all" )
				if ( !shown( clean, root ) || !safe( root, clean ) ) {
					continue
				}
				var to = target & "/" & mid( clean, len( root ) + 2, len( clean ) )
				directoryCreate( path = getDirectoryFromPath( to ), createPath = true, ignoreExists = true )
				fileCopy( clean, to )
				copied++
			}
		}
		return { copied : copied }
	}

	/**
	 * A text file, not hidden, not a secrets file.
	 */
	private boolean function shown( required string file, required string root ) {
		var relative = mid( arguments.file, len( arguments.root ) + 2, len( arguments.file ) )
		var name = listLast( arguments.file, "/" )
		return !relative.contains( "/." ) && !name.startsWith( "." ) && !reFindNoCase( "^secrets?\b", name ) && listFindNoCase( static.TEXT, listLast( name, "." ) ) > 0
	}

	/**
	 * Not a symbolic link, and really under the project folder once every link in its path is followed.
	 */
	private boolean function safe( required string root, required string file ) {
		var paths = createObject( "java", "java.nio.file.Paths" )
		var files = createObject( "java", "java.nio.file.Files" )
		if ( files.isSymbolicLink( paths.get( arguments.file, [] ) ) ) {
			return false
		}
		var real = replace( createObject( "java", "java.io.File" ).init( arguments.file ).getCanonicalPath(), "\", "/", "all" )
		var base = replace( createObject( "java", "java.io.File" ).init( arguments.root ).getCanonicalPath(), "\", "/", "all" )
		return real.startsWith( base & "/" )
	}

}
