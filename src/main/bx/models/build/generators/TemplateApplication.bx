/**
 * The template variant of `public/Application.bx`: the ColdBox BoxLang template's own file, byte for byte,
 * with only INSERTED blocks added, each fenced by `// >>> BXAGENTS` and `// <<< BXAGENTS`. Not one template
 * line is changed or removed, so what the template documents about its Application.bx is still true of
 * the file, and a person comparing it with the template sees four small additions and nothing else.
 *
 * What the additions do is hand the generated wiring (app/bxagents/Wiring.bx, or the project's own
 * hook class that extends it) the four moments it needs:
 *
 *   1. the pseudo-constructor: the app's name, sessions, schedulers and datasource
 *   2. onApplicationStart, first: what has to be in place before ColdBox loads (data home, logs, bx-ai's settings)
 *   3. onApplicationStart, after `loadColdbox()`: tools, gateways, interceptors and the other startup statements
 *   4. onRequestStart, before ColdBox gets the request: wait for the request body (see models/api/RequestBody.bx)
 *
 * The other variant, a thin class that extends a generated base, is ColdBoxAppGenerator's
 * `applicationVariant: "stub"` (the choice is `defaultVariant()` there).
 */
class {

	variables.OPEN = "// >>> BXAGENTS"
	variables.CLOSE = "// <<< BXAGENTS"

	/**
	 * The four lines of the template the blocks are put after, or before. Each has to occur exactly once in the
	 * vendored file; a refresh of the template that moves one makes the build stop and say so, rather than put
	 * a block in the wrong place.
	 *
	 * @return The anchors, in the order the blocks are inserted
	 */
	array function anchors() {
		return [
			char( 9 ) & 'this.datasource = "coldbox"' & char( 10 ),
			char( 9 ) & char( 9 ) & 'bx:setting requestTimeout ="300";' & char( 10 ),
			char( 9 ) & char( 9 ) & "application.cbBootstrap.loadColdbox()" & char( 10 ),
			char( 9 ) & char( 9 ) & "return application.cbBootstrap.onRequestStart( arguments.targetPage )" & char( 10 )
		]
	}

	/**
	 * @template The template's public/Application.bx source
	 * @hookClass The class path the blocks create the wiring from: `app.bxagents.Wiring`, or the project's own class that extends it
	 *
	 * @return The template with the blocks inserted
	 */
	string function insert( required string template, string hookClass = "app.bxagents.Wiring" ) {
		var anchors = anchors()
		for ( var anchor in anchors ) {
			var occurrences = ( len( arguments.template ) - len( arguments.template.replace( anchor, "", "all" ) ) ) / len( anchor )
			if ( occurrences != 1 ) {
				throw(
					type    = "BxAgents.TemplateChanged",
					message = "The vendored ColdBox template's public/Application.bx no longer has this line exactly once, so BxAgents cannot tell where its blocks go: [#trim( anchor )#]. Update TemplateApplication.bx for the refreshed template."
				)
			}
		}
		var t = arguments.template
		// the last anchor first would shift nothing above it, but each block goes right after (or before) its own line
		t = after( t, anchors[ 1 ], block( 1, [
			"_bx = new #arguments.hookClass#()",
			"for ( _bxKey in _bx.settings() ) {",
			"	this[ _bxKey ] = _bx.settings()[ _bxKey ]",
			"}"
		] ) )
		t = after( t, anchors[ 2 ], block( 2, [ "_bx.before()" ] ) )
		t = after( t, anchors[ 3 ], block( 2, [ "_bx.after()" ] ) )
		t = before( t, anchors[ 4 ], block( 2, [ "_bx.beforeRequest()" ] ) )
		return t
	}

	/**
	 * @return The count of lines of `source` that are inside a BXAGENTS block, for a spec that checks the file is the template plus blocks
	 */
	array function blockLines( required string source ) {
		var inside = false
		var found = []
		for ( var line in arguments.source.listToArray( char( 10 ), true ) ) {
			if ( trim( line ).startsWith( variables.OPEN ) ) {
				inside = true
			}
			if ( inside ) {
				found.append( line )
			}
			if ( trim( line ) == variables.CLOSE ) {
				inside = false
			}
		}
		return found
	}

	/**
	 * The inverse of insert(): the source with every fenced block taken out again (and the blank line that sets a class-body
	 * block apart). What is left is the template, which is how a spec proves that nothing of it was changed.
	 *
	 * @source A file insert() made
	 *
	 * @return The source without the blocks
	 */
	string function withoutBlocks( required string source ) {
		var kept = []
		var inside = false
		var lines = arguments.source.listToArray( char( 10 ), true )
		for ( var index = 1; index <= lines.len(); index++ ) {
			var line = lines[ index ]
			if ( trim( line ).startsWith( variables.OPEN ) ) {
				inside = true
				// a block in the class body is set apart by a blank line of its own
				if ( kept.len() && !len( trim( kept[ kept.len() ] ) ) && trim( lines[ index + 1 ] ?: "" ).startsWith( "_bx = new" ) ) {
					kept.deleteAt( kept.len() )
				}
				continue
			}
			if ( inside ) {
				inside = trim( line ) != variables.CLOSE
				continue
			}
			kept.append( line )
		}
		return kept.toList( char( 10 ) )
	}

	/**
	 * @depth How many tabs the block is indented by (1 in the class body, 2 inside a function)
	 * @lines The block's lines, without indentation
	 *
	 * @return The block, fenced, starting after a blank line when it is in the class body
	 */
	private string function block( required numeric depth, required array lines ) {
		var pad = repeatString( char( 9 ), arguments.depth )
		var out = []
		if ( arguments.depth == 1 ) {
			out.append( "" )
		}
		out.append( pad & variables.OPEN & " (generated; the lines around this block are the template's, unchanged)" )
		for ( var line in arguments.lines ) {
			out.append( len( line ) ? pad & line : "" )
		}
		out.append( pad & variables.CLOSE )
		return out.toList( char( 10 ) ) & char( 10 )
	}

	private string function after( required string source, required string anchor, required string block ) {
		var at = arguments.source.find( arguments.anchor ) + len( arguments.anchor )
		return arguments.source.left( at - 1 ) & arguments.block & arguments.source.mid( at, len( arguments.source ) )
	}

	private string function before( required string source, required string anchor, required string block ) {
		var at = arguments.source.find( arguments.anchor )
		return arguments.source.left( at - 1 ) & arguments.block & arguments.source.mid( at, len( arguments.source ) )
	}

}
