/**
 * Copies a project's `tools/` and `skills/` conventions (and the skills installed
 * from the registry, .agents/skills/) into the generated
 * app verbatim (Build Pipeline Phase 5, BX AI wiring), so bx-ai's own
 * `aiToolRegistry().scan()` / `AiSkill::fromDirectory()` discover them
 * unmodified at startup - BX Agents does not duplicate those scanners.
 *
 * Each destination folder is wiped before copying (not merged), so a
 * previous build's stale files never survive into a fresh one. Dotfiles/
 * dot-directories (including `.env`) are never descended into or copied,
 * even if present inside `tools/`/`skills/`.
 */
import bxModules.bxagents.models.util.Strings;

class {

	/**
	 * @projectRoot Absolute path to the project root
	 * @buildDir Absolute path to the build output directory, e.g. "<projectRoot>/.build/app"
	 *
	 * @return { tools, skills } - absolute paths to the copied destination folders
	 */
	struct function copy( required string projectRoot, required string buildDir ) {
		var root = Strings::normalizePath( arguments.projectRoot )
		var appDir = Strings::normalizePath( arguments.buildDir )

		var toolsDest = appDir & "/tools"
		var skillsDest = appDir & "/skills"

		wipeAndCopy( root & "/tools", toolsDest )
		wipeAndCopy( root & "/skills", skillsDest )
		copyInstalledSkills( root, skillsDest )

		return { tools : toolsDest, skills : skillsDest }
	}

	/**
	 * Adds the skills installed from the registry (.agents/skills/) to the app's skills/, and lists their folders in
	 * skills/.installed.json.
	 * A skill of your own with the same folder name is already there and is left alone, so
	 * it wins; the dotfile rule still applies to everything inside.
	 *
	 * @root The project root
	 * @skillsDest The app's skills/ folder (already filled with the project's own)
	 */
	private void function copyInstalledSkills( required string root, required string skillsDest ) {
		var src = arguments.root & "/.agents/skills"
		if ( !directoryExists( src ) ) {
			return
		}
		directoryCreate( path = arguments.skillsDest, createPath = true, ignoreExists = true )
		var added = []
		for ( var entry in directoryList( path = src, recurse = false, listInfo = "name", sort = "asc", type = "dir" ) ) {
			if ( entry.startsWith( "." ) || directoryExists( arguments.skillsDest & "/" & entry ) ) {
				continue
			}
			directoryCreate( path = arguments.skillsDest & "/" & entry, createPath = true, ignoreExists = true )
			// a skill installer links a global skill into .agents/skills; the app gets a copy of what the link points at
			copyTree( realPathOf( src & "/" & entry ), arguments.skillsDest & "/" & entry )
			added.append( entry )
		}
		// Both kinds end up in the app's one skills/ folder. Which folders came from the registry is kept beside them,
		// so the app can still tell the skills installed from those that ship with the agent (see SkillLibrary).
		if ( added.len() ) {
			fileWrite( arguments.skillsDest & "/.installed.json", jsonSerialize( added ), "UTF-8" )
		}
	}

	/**
	 * Wipes dest (if present) and recreates it with a fresh copy of src's
	 * contents - matches the build pipeline's "wipe stale output, don't
	 * merge" rule. A no-op (after wiping) if src doesn't exist.
	 *
	 * @src Absolute path to the source convention folder, e.g. "<projectRoot>/tools"
	 * @dest Absolute path to the destination folder, e.g. "<appDir>/tools"
	 */
	private void function wipeAndCopy( required string src, required string dest ) {
		if ( directoryExists( arguments.dest ) ) {
			directoryDelete( arguments.dest, true )
		}

		if ( !directoryExists( arguments.src ) ) {
			return
		}

		directoryCreate( path = arguments.dest, createPath = true, ignoreExists = true )
		copyTree( arguments.src, arguments.dest )
	}

	/**
	 * BoxLang lists nothing inside a folder reached through a symbolic link, so the folder is listed by the place the
	 * link points at.
	 *
	 * @path A file or folder path
	 *
	 * @return The path with every link resolved, forward slashes
	 */
	private string function realPathOf( required string path ) {
		return replace( createObject( "java", "java.nio.file.Paths" ).get( arguments.path, [] ).toRealPath( [] ).toString(), "\", "/", "all" )
	}

	/**
	 * Recursively copies `src`'s contents into `dest`, one directory level at
	 * a time, skipping any entry (file or directory) whose own name starts
	 * with "." - so a hidden directory's contents are never reached at all,
	 * not merely filtered leaf-by-leaf.
	 *
	 * @src Absolute path to the source directory (already known to exist)
	 * @dest Absolute path to the destination directory (already created)
	 */
	private void function copyTree( required string src, required string dest, numeric depth = 1 ) {
		// a link back up the tree would otherwise copy for ever
		if ( arguments.depth > 32 ) {
			throw( type = "BxAgents.CopyTooDeep", message = "Stopped copying [#arguments.src#]: the folders are nested more than 32 deep, which usually means a symbolic link that points back up the tree." )
		}
		var entries = directoryList( path = arguments.src, recurse = false, listInfo = "name", sort = "asc", type = "all" )

		for ( var entry in entries ) {
			if ( entry.startsWith( "." ) ) {
				continue
			}

			var srcPath = arguments.src & "/" & entry
			var destPath = arguments.dest & "/" & entry

			if ( directoryExists( srcPath ) ) {
				directoryCreate( path = destPath, createPath = true, ignoreExists = true )
				copyTree( realPathOf( srcPath ), destPath, arguments.depth + 1 )
			} else {
				fileCopy( srcPath, destPath )
			}
		}
	}

}
