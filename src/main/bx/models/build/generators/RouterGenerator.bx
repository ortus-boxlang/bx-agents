/**
 * Generates `config/Router.bx` for a project's HTTP exposure (Build Pipeline
 * Phase 5): one `route(path).toAi("GeneratedAgent")` per `gateways/*` entry
 * that exposes the agent, one `route(path & "/api").toAi("GeneratedAgent")`
 * per entry that exposes the web chat UI (see WebUiGenerator - the UI's
 * own static shell is a real file, not a route), one `route(path).toMCP(target)`
 * per entry that exposes a local `mcp/*` server - all native ColdBox 8.1 AI
 * Routing DSL terminators (https://coldbox.ortusbooks.com/the-basics/routing/routing-dsl/ai-routing),
 * confirmed via documentation to auto-register 4 sub-routes (toAi) or 1 route
 * (toMCP) respectively.
 *
 * When the project declares ANY channel-adapter gateway (see GatewayGenerator),
 * also emits one `route( "/gateways" ).toAiGateway()` - the native ColdBox
 * terminator for the bx-ai Gateway surface, which registers the inbound-event,
 * verification-handshake, human-interaction and info routes itself. This
 * replaces the three hand-written routes plus a generated passthrough handler
 * this generator used to emit, from back when ColdBox had no such terminator.
 *
 * That mount is deliberately NOT gated on `type: "http"`. `http` is one gateway
 * among many, and the surface it unlocks is not http-specific: the
 * `/interactions/:requestID` routes are the human-in-the-loop approval channel
 * for EVERY gateway, resolved through bx-ai's own gateway registry rather than
 * per-transport. Gating it on http left every push-only project (Telegram,
 * Slack, Discord, ...) able to PAUSE for an approval it had no route to answer.
 */
import bxModules.bxagents.models.util.Strings;

import bxModules.bxagents.models.util.EntryConfigReader;
import bxModules.bxagents.models.api.AccessMode;
import bxModules.bxagents.models.api.Guards;

import bxModules.bxagents.models.api.ApiPath;
import bxModules.bxagents.models.api.ApiContract;

class {

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .gateways is used)
	 * @appDir Absolute path to the generated ColdBox app dir, e.g. "<projectRoot>/.build/app"
	 * @hasChannelGateway Whether the project declares ANY channel-adapter gateway (see GatewayGenerator) - mounts the bx-ai Gateway surface at /gateways when true. Not http-specific: see this class's own docblock for why.
	 * @hasWhatsAppCloudGateway Whether a whatsapp-cloud-type channel-adapter gateway exists (see GatewayGenerator) - emits the GET/POST WhatsApp Cloud webhook routes when true
	 * @hasTeamsGateway Whether a teams-type channel-adapter gateway exists (see GatewayGenerator) - emits the POST Teams webhook route when true
	 * @hasTwilioGateway Whether a twilio-type channel-adapter gateway exists (see GatewayGenerator) - emits the POST Twilio webhook route when true
	 * @hasGitHubGateway Whether a github-type channel-adapter gateway exists (see GatewayGenerator) - emits the POST GitHub webhook route when true
	 * @agentApi The root project's own `agentApi` config (see Agent.bx's configure()) - `{ enabled, tokenEnvVar }`, both optional. Controls the always-on reserved agent route below.
	 *
	 * @return { router, hasRoutes, hasAgentExposure }
	 */
	struct function generate( required struct discovery, required string appDir, boolean hasChannelGateway = false, boolean hasWhatsAppCloudGateway = false, boolean hasTeamsGateway = false, boolean hasTwilioGateway = false, boolean hasGitHubGateway = false, struct agentApi = {} ) {
		var exposureEntries = collectExposureEntries( arguments.discovery )
		var lines = []

		var gated = AccessMode::gated( arguments.agentApi )
		lines.append( renderAuthGate( arguments.agentApi ), true )
		lines.append( renderReservedAgentRoute( arguments.agentApi ), true )

		for ( var entry in exposureEntries ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( renderExposureRoute( entry, gated ) )
		}

		if ( arguments.hasChannelGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// bx-ai Gateway webhook surface - one native ColdBox terminator that" )
			lines.append( "// registers the inbound-event, verification-handshake, human-interaction" )
			lines.append( "// and info routes under this base path." )
			lines.append( 'route( "/gateways" ).toAiGateway()' )
		}

		if ( arguments.hasWhatsAppCloudGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// WhatsApp Business Cloud API webhook surface - Meta's own verify" )
			lines.append( "// handshake (GET) and signed inbound delivery (POST), handled by" )
			lines.append( "// WhatsAppCloudGateway itself (own X-Hub-Signature-256 scheme, not" )
			lines.append( "// bx-ai's GatewayRequestProcessor)." )
			lines.append( 'get( "/webhooks/whatsapp-cloud" ).toHandler( "WhatsAppCloud.verify" )' )
			lines.append( 'post( "/webhooks/whatsapp-cloud" ).toHandler( "WhatsAppCloud.process" )' )
		}

		if ( arguments.hasTeamsGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// Microsoft Teams webhook surface (Bot Framework Activity protocol) -" )
			lines.append( "// one route, handled by TeamsGateway itself (own JWT-bearer scheme," )
			lines.append( "// not bx-ai's GatewayRequestProcessor)." )
			lines.append( 'post( "/webhooks/teams" ).toHandler( "Teams.process" )' )
		}

		if ( arguments.hasTwilioGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// Twilio SMS webhook surface - handled by TwilioGateway itself" )
			lines.append( "// (own X-Twilio-Signature scheme, not bx-ai's GatewayRequestProcessor)." )
			lines.append( 'post( "/webhooks/twilio" ).toHandler( "Twilio.process" )' )
		}

		if ( arguments.hasGitHubGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// GitHub webhook surface (issue/PR comments) - handled by GitHubGateway" )
			lines.append( "// itself (own X-Hub-Signature-256 scheme, not bx-ai's GatewayRequestProcessor)." )
			lines.append( 'post( "/webhooks/github" ).toHandler( "GitHub.process" )' )
		}

		var appDir = Strings::normalizePath( arguments.appDir )
		directoryCreate( path = appDir & "/config", createPath = true, ignoreExists = true )
		var routerPath = appDir & "/config/Router.bx"
		fileWrite( routerPath, renderRouterFile( lines ) )

		var hasAgentExposure = false
		for ( var entry in exposureEntries ) {
			if ( entry.config.exposes == "agent" ) {
				hasAgentExposure = true
			}
		}

		return {
			router           : routerPath,
			hasRoutes        : lines.len() > 0,
			hasAgentExposure : hasAgentExposure
		}
	}

	/**
	 * The gate every agent API route passes first, when the API needs a token or keeps some addresses out or limits its
	 * use: a list of ColdBox route middleware, `gate`, and the route meta they read, `gateMeta`.
	 *
	 * The address list and the rate limit are cbSecurity's own middleware (`AllowedIPs@cbsecurity`, `Throttle@cbsecurity`,
	 * see models.api.Guards). The token check, `auth`, asks models.api.Authenticator who is calling: it names the caller
	 * on the request, or answers 401 and stops the action. An open API has no `auth`, only the guards it asked for.
	 *
	 * @agentApi The root project's `agentApi` config
	 *
	 * @return The statement lines that define `gate` and `gateMeta`; none when nothing guards the API
	 */
	private array function renderAuthGate( required struct agentApi ) {
		if ( !AccessMode::gated( arguments.agentApi ) ) {
			return []
		}
		var lines = []
		var chain = Guards::middleware( arguments.agentApi ).map( name => '"#name#"' )
		if ( AccessMode::of( arguments.agentApi ) == "token" ) {
			var tokenEnvVar = trim( arguments.agentApi.tokenEnvVar ?: "" )
			var tokens = ( arguments.agentApi.tokens ?: false ) ? "true" : "false"
			var accounts = ( arguments.agentApi.webAccounts ?: false ) ? "true" : "false"
			lines.append( "// Who may call: a request carries the shared secret (#len( tokenEnvVar ) ? tokenEnvVar : 'none set'#), an issued token (#tokens#) or the page's own sign-in (#accounts#)." )
			lines.append( "// A request that carries neither is answered 401 before any action runs; the secret itself is read from the" )
			lines.append( "// environment when a request comes in and is never written here." )
			lines.append( 'var auth = ( event, rc, prc ) => new "models.api.Authenticator@bxagents"( tokenEnvVar : "#Strings::bxLiteral( tokenEnvVar )#", tokens : #tokens#, accounts : #accounts# ).guard( event )' )
			chain.append( "auth" )
		}
		if ( Guards::any( arguments.agentApi ) ) {
			lines.append( "// Which addresses may call (allowedIPs) and how often (rateLimit) are cbSecurity middleware, run before the token check." )
		}
		lines.append( "var gate = [ #chain.toList( ', ' )# ]" )
		lines.append( 'var gateMeta = jsonDeserialize( "#Strings::bxLiteral( jsonSerialize( Guards::meta( arguments.agentApi ) ) )#" )' )
		lines.append( "" )
		return lines
	}

	/**
	 * The route to one action of the agent API handler, behind the gate when the API needs a token.
	 *
	 * @verb get or post; empty for a path that answers both
	 * @path The full path
	 * @action The AgentApi action
	 * @gated True when the route goes through `gate`
	 */
	private string function handlerRoute( required string verb, required string path, required string action, required boolean gated ) {
		var start = len( arguments.verb ) ? '#arguments.verb#( "#Strings::bxLiteral( arguments.path )#" )' : 'route( "#Strings::bxLiteral( arguments.path )#" )'
		return start & ( arguments.gated ? ".middleware( gate ).meta( gateMeta )" : "" ) & '.toHandler( "AgentApi.#arguments.action#" )'
	}

	/**
	 * The four routes every place that serves the agent has: one whole turn, many, a stream, and what is served.
	 *
	 * @base The path they sit under
	 * @gated True when they go through `gate`
	 */
	private array function turnRoutes( required string base, required boolean gated ) {
		return contractRoutes( arguments.base, arguments.gated, {}, [ "invoke", "stream", "batch", "info" ] )
	}

	/**
	 * The routes of ApiContract, in its order, for the actions asked for (all when none are named). A route that takes
	 * one verb is written with it; one that takes several (a list and a make) is written for any verb, and the handler
	 * tells them apart. A route the contract marks open is never behind the gate.
	 *
	 * @base The path they sit under
	 * @gated True when the routes go through `gate`
	 * @options As ApiContract::operations()
	 * @only The actions to write; empty for every one
	 */
	private array function contractRoutes( required string base, required boolean gated, struct options = {}, array only = [] ) {
		var base = arguments.base
		var gated = arguments.gated
		var only = arguments.only
		return ApiContract::operations( arguments.options )
			.filter( ( op ) => !only.len() || only.contains( op.action ) )
			.map( ( op ) => handlerRoute( op.methods.count() == 1 ? op.methods.keyArray()[ 1 ] : "", base & op.path, op.action, gated && !op.open ) )
	}

	/**
	 * Renders the RESERVED agent route: the whole agent API at /__bxagents, emitted on EVERY build regardless of what
	 * the project declares under `gateways/`, so this module's own tooling always has an address to talk to. Without it,
	 * `invoke --server` (and anything else that needs to reach a built agent over HTTP) fails outright on any project
	 * that never declared a public one.
	 *
	 * `agentApi.enabled` (default TRUE) turns it off entirely - for a build destined somewhere the endpoint has no
	 * business existing. Because it reads from `configure()`, an `Agent.bx` can scope that per environment with a
	 * `production()` override, using the mechanism that already exists.
	 *
	 * Every route is our own handler route (handlers/AgentApi.bx), never ColdBox's toAi(): route middleware does not
	 * cover toAi()'s routes (a real run showed `stream` answering with no token at all), so a gate on them would have
	 * been a hole. See renderAuthGate().
	 *
	 * @agentApi The root project's `agentApi` config - `{ enabled, access, tokenEnvVar, tokens }`, all optional
	 *
	 * @return The route's own statement lines - an empty array when `agentApi.enabled` is false
	 */
	private array function renderReservedAgentRoute( required struct agentApi ) {
		if ( !( arguments.agentApi.enabled ?: true ) ) {
			return []
		}
		var gated = AccessMode::gated( arguments.agentApi )
		var lines = [
			"// The reserved agent route - always present, whatever gateways/ declares,",
			"// so this module's own tooling (chat --server, invoke --server) always has",
			"// an address. A project's own public API belongs in gateways/ instead."
		]
		lines.append( turnRoutes( ApiPath::of( arguments.agentApi ), gated ), true )
		lines.append( "" )
		lines.append( renderRunControlRoutes( gated, ApiPath::of( arguments.agentApi ), ( arguments.agentApi.manageTokens ?: false ) == true ), true )
		return lines
	}

	/**
	 * The routes beside the four turn routes: the rich event stream, stopping and steering a run, the approval round
	 * trip, conversations, notes and commands. All served by handlers/AgentApi.bx (see AgentApiGenerator).
	 *
	 * @gated True when they go through `gate`
	 * @apiBase The path the API is served on
	 * @manageTokens True when an admin may manage access tokens over the API (agentApi.manageTokens)
	 *
	 * @return The route statement lines
	 */
	private array function renderRunControlRoutes( required boolean gated, required string apiBase, boolean manageTokens = false ) {
		var rest = ApiContract::actions( { manageTokens : arguments.manageTokens } ).filter( ( action ) => ![ "invoke", "stream", "batch", "info" ].contains( action ) )
		return [ "// Run control, conversations, notes and the rest - the same path, served by handlers/AgentApi.bx" ].append(
			contractRoutes( arguments.apiBase, arguments.gated, { manageTokens : arguments.manageTokens }, rest ),
			true
		)
	}

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .gateways is used)
	 *
	 * @return { name, config } for every gateways/* entry that has an `exposes` key, sorted by path
	 */
	private array function collectExposureEntries( required struct discovery ) {
		var entries = []

		for ( var gw in ( arguments.discovery.gateways ?: [] ) ) {
			var config = EntryConfigReader::read( gw.path )
			if ( !isNull( config ) && structKeyExists( config, "exposes" ) ) {
				entries.append( { name : gw.name, config : config } )
			}
		}

		// Deterministic ordering by path, independent of filesystem listing order.
		entries.sort( function( a, b ) {
			var pathA = a.config.path ?: ""
			var pathB = b.config.path ?: ""
			if ( pathA != pathB ) {
				return pathA < pathB ? -1 : 1
			}
			return 0
		} )

		return entries
	}

	/**
	 * @entry An exposure entry { name, config }, from collectExposureEntries()
	 * @gated True when the agent API needs a token: the agent routes go through `gate`
	 *
	 * @return A bare `route(...).toAi(...)` or `route(...).toMCP(...)` statement string
	 */
	private string function renderExposureRoute( required struct entry, required boolean gated ) {
		// Normalized exactly as WebUiGenerator normalizes the same value when it
		// mounts the chat shell, so the two generators can never disagree about
		// where an entry lives: a path of "/chat/" mounts at <appDir>/chat, and
		// without this the router would register "/chat//login" and every
		// sign-in from the shell would 404.
		var path = Strings::normalizePath( arguments.entry.config.path ?: "" )

		if ( arguments.entry.config.exposes == "agent" ) {
			// the same four routes as the reserved path, from the same handler, behind the same gate
			return turnRoutes( path, arguments.gated ).toList( char( 10 ) & char( 9 ) & char( 9 ) )
		}

		if ( arguments.entry.config.exposes == "webui" ) {
			// The static chat shell itself (<path>/index.html) is a real file under the app's own webroot - see WebUiGenerator -
			// so it is served directly. What it calls is the agent API at the reserved path (see ApiPath), the same one the
			// terminal and the gateways use, so the only routes here are the extension files and the sign-in.
			// Sign-in, only when this entry declares accounts. The form itself is
			// the static login.html mounted beside the shell, so only its POST
			// target and logout need routes.
			var authRoutes = ( arguments.entry.config.users ?: [] ).len()
				? [
					'post( "#Strings::bxLiteral( path )#/login" ).toHandler( "ChatAuth.doLogin" )',
					'post( "#Strings::bxLiteral( path )#/logout" ).toHandler( "ChatAuth.doLogout" )',
					'get( "#Strings::bxLiteral( path )#/logout" ).toHandler( "ChatAuth.doLogout" )'
				]
				: []

			return [
				// the files of an extension's web/ folder, read from the extension itself
				'get( "#Strings::bxLiteral( path )#/ext/:extension/:file-regex:(.+)" ).toHandler( "AgentApi.extensionFile" )'
			].append( authRoutes, true ).toList( char( 10 ) & char( 9 ) & char( 9 ) )
		}

		var target = arguments.entry.config.target ?: ""
		return 'route( "#Strings::bxLiteral( path )#" ).toMCP( "#Strings::bxLiteral( target )#" )'
	}

	/**
	 * @lines Bare route/comment statement strings to embed in configure()'s body
	 *
	 * @return The rendered config/Router.bx source
	 */
	private string function renderRouterFile( required array lines ) {
		var body = arguments.lines.len() ? arguments.lines : [ "// No HTTP exposure declared under gateways/" ]
		var indented = body.map( line => len( line ) ? "		" & line : "" )

		var fileLines = [
			"class {",
			"",
			"	function configure() {"
		]
		for ( var line in indented ) {
			fileLines.append( line )
		}
		fileLines.append( "	}" )
		fileLines.append( "" )
		fileLines.append( "}" )
		fileLines.append( "" )

		return fileLines.toList( char( 10 ) )
	}

}
