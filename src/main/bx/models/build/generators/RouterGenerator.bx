/**
 * Generates `config/Router.bx` for a project's HTTP exposure (Build Pipeline
 * Phase 5): one `route(path).toAi("GeneratedAgent")` per `gateways/*` entry
 * that exposes the agent, one `route(path & "/api").toAi("GeneratedAgent")`
 * per entry that exposes the web chat UI (see WebUiGenerator - the UI's
 * own static shell is a real file, not a route), one `route(path).toMCP(target)`
 * per entry that exposes a local `mcp/*` server - all native ColdBox 8.1 AI
 * Routing DSL terminators (https://coldbox.ortusbooks.com/the-basics/routing/routing-dsl/ai-routing),
 * confirmed via documentation to auto-register 4 sub-routes (toAi) or 1 route
 * (toMCP) respectively.
 *
 * When the project declares ANY channel-adapter gateway (see GatewayGenerator),
 * also emits one `route( "/gateways" ).toAiGateway()` - the native ColdBox
 * terminator for the bx-ai Gateway surface, which registers the inbound-event,
 * verification-handshake, human-interaction and info routes itself. This
 * replaces the three hand-written routes plus a generated passthrough handler
 * this generator used to emit, from back when ColdBox had no such terminator.
 *
 * That mount is deliberately NOT gated on `type: "http"`. `http` is one gateway
 * among many, and the surface it unlocks is not http-specific: the
 * `/interactions/:requestID` routes are the human-in-the-loop approval channel
 * for EVERY gateway, resolved through bx-ai's own gateway registry rather than
 * per-transport. Gating it on http left every push-only project (Telegram,
 * Slack, Discord, ...) able to PAUSE for an approval it had no route to answer.
 */
class {

	/**
	 * The reserved base path the always-on agent route mounts at - see
	 * renderReservedAgentRoute(). `toAi()` appends its own four sub-routes to
	 * it (`/invoke`, `/stream`, `/batch`, `/info`).
	 *
	 * The `__` prefix is what makes it reserved: ProjectValidator rejects any
	 * `gateways/*` entry whose own path falls under it, so a user's public API
	 * and this module's tooling channel can never collide.
	 */
	static {
		RESERVED_AGENT_PATH = "/__bxagents"
	}

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .gateways is used)
	 * @appDir Absolute path to the generated ColdBox app dir, e.g. "<projectRoot>/.build/app"
	 * @hasChannelGateway Whether the project declares ANY channel-adapter gateway (see GatewayGenerator) - mounts the bx-ai Gateway surface at /gateways when true. Not http-specific: see this class's own docblock for why.
	 * @hasWhatsAppCloudGateway Whether a whatsapp-cloud-type channel-adapter gateway exists (see GatewayGenerator) - emits the GET/POST WhatsApp Cloud webhook routes when true
	 * @hasTeamsGateway Whether a teams-type channel-adapter gateway exists (see GatewayGenerator) - emits the POST Teams webhook route when true
	 * @hasTwilioGateway Whether a twilio-type channel-adapter gateway exists (see GatewayGenerator) - emits the POST Twilio webhook route when true
	 * @hasGitHubGateway Whether a github-type channel-adapter gateway exists (see GatewayGenerator) - emits the POST GitHub webhook route when true
	 * @agentApi The root project's own `agentApi` config (see Agent.bx's configure()) - `{ enabled, tokenEnvVar }`, both optional. Controls the always-on reserved agent route below.
	 *
	 * @return { router, hasRoutes, hasAgentExposure }
	 */
	struct function generate( required struct discovery, required string appDir, boolean hasChannelGateway = false, boolean hasWhatsAppCloudGateway = false, boolean hasTeamsGateway = false, boolean hasTwilioGateway = false, boolean hasGitHubGateway = false, struct agentApi = {} ) {
		var exposureEntries = collectExposureEntries( arguments.discovery )
		var lines = []

		lines.append( renderReservedAgentRoute( arguments.agentApi ), true )

		for ( var entry in exposureEntries ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( renderExposureRoute( entry ) )
		}

		if ( arguments.hasChannelGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// bx-ai Gateway webhook surface - one native ColdBox terminator that" )
			lines.append( "// registers the inbound-event, verification-handshake, human-interaction" )
			lines.append( "// and info routes under this base path." )
			lines.append( 'route( "/gateways" ).toAiGateway()' )
		}

		if ( arguments.hasWhatsAppCloudGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// WhatsApp Business Cloud API webhook surface - Meta's own verify" )
			lines.append( "// handshake (GET) and signed inbound delivery (POST), handled by" )
			lines.append( "// WhatsAppCloudGateway itself (own X-Hub-Signature-256 scheme, not" )
			lines.append( "// bx-ai's GatewayRequestProcessor)." )
			lines.append( 'get( "/webhooks/whatsapp-cloud" ).toHandler( "WhatsAppCloud.verify" )' )
			lines.append( 'post( "/webhooks/whatsapp-cloud" ).toHandler( "WhatsAppCloud.process" )' )
		}

		if ( arguments.hasTeamsGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// Microsoft Teams webhook surface (Bot Framework Activity protocol) -" )
			lines.append( "// one route, handled by TeamsGateway itself (own JWT-bearer scheme," )
			lines.append( "// not bx-ai's GatewayRequestProcessor)." )
			lines.append( 'post( "/webhooks/teams" ).toHandler( "Teams.process" )' )
		}

		if ( arguments.hasTwilioGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// Twilio SMS webhook surface - handled by TwilioGateway itself" )
			lines.append( "// (own X-Twilio-Signature scheme, not bx-ai's GatewayRequestProcessor)." )
			lines.append( 'post( "/webhooks/twilio" ).toHandler( "Twilio.process" )' )
		}

		if ( arguments.hasGitHubGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// GitHub webhook surface (issue/PR comments) - handled by GitHubGateway" )
			lines.append( "// itself (own X-Hub-Signature-256 scheme, not bx-ai's GatewayRequestProcessor)." )
			lines.append( 'post( "/webhooks/github" ).toHandler( "GitHub.process" )' )
		}

		var appDir = normalizePath( arguments.appDir )
		directoryCreate( path = appDir & "/config", createPath = true, ignoreExists = true )
		var routerPath = appDir & "/config/Router.bx"
		fileWrite( routerPath, renderRouterFile( lines ) )

		var hasAgentExposure = false
		for ( var entry in exposureEntries ) {
			if ( entry.config.exposes == "agent" ) {
				hasAgentExposure = true
			}
		}

		return {
			router           : routerPath,
			hasRoutes        : lines.len() > 0,
			hasAgentExposure : hasAgentExposure
		}
	}

	/**
	 * Renders the RESERVED agent route - `route( "/__bxagents" ).toAi( ... )` -
	 * emitted on EVERY build regardless of what the project declares under
	 * `gateways/`, so this module's own tooling always has an address to talk
	 * to. Without it, `invoke --server` (and anything else that needs to reach
	 * a built agent over HTTP) fails outright on any project that never
	 * declared an `exposes: "agent"` entry - which is every scaffolded
	 * template.
	 *
	 * This is deliberately NOT a substitute for a project's own
	 * `exposes: "agent"` entry: that one is the user's public API, at a path
	 * they choose. This one is the toolchain's service entrance, at a fixed
	 * reserved path a user's own entry can never collide with (ProjectValidator
	 * rejects any gateways/* path under the same prefix).
	 *
	 * `agentApi.enabled` (default TRUE) turns it off entirely - for a build
	 * destined somewhere the endpoint has no business existing. Because it
	 * reads from `configure()`, an `Agent.bx` can scope that per environment
	 * with a `production()` override, using the mechanism that already exists.
	 *
	 * `agentApi.tokenEnvVar` names an environment variable holding a shared
	 * secret; when set, every sub-route is gated behind ColdBox's own
	 * `withCondition()` route modifier (inherited by all four sub-routes -
	 * confirmed against the real `toAi()` source), which compares an
	 * `x-bxagents-token` request header against it. The condition FAILS CLOSED
	 * on purpose: an unset/blank env var returns false outright, rather than
	 * degenerating into `"" == ""` and letting every caller through - which is
	 * exactly the trap a naive equality check falls into. A failing condition
	 * makes ColdBox skip the route entirely - which, on its own, would drop the
	 * request through to ColdBox's default `main.index` event. A generated app
	 * defines no such handler, so that path produces a 500 ERROR PAGE, not a
	 * clean refusal (confirmed by real HTTP request, not assumed - it is what
	 * the first working version of this actually did). So a second route is
	 * registered immediately after, catching everything the condition turned
	 * away and answering a deliberate 401 with a small JSON body. That does
	 * confirm the endpoint exists, which a 404 would not - but leaking a
	 * ColdBox error page is strictly worse than admitting an endpoint is
	 * there, and it also stops the refusal path depending on whether the
	 * project happens to define a `main.index`.
	 *
	 * The condition closure takes ONE argument, the routed request string:
	 * RoutingService invokes it as `condition( requestString )` (confirmed in
	 * `RoutingService.cfc`'s own match loop), NOT with the
	 * `( route, params, event )` signature ColdBox's `Router.cfc` docblocks
	 * show. So the header is read with `getHTTPRequestData( false ).headers` -
	 * the same BIF `Router.cfc` itself uses to read request headers - rather
	 * than off an `event` that is never passed. Header lookup is
	 * case-insensitive because BoxLang struct keys are.
	 *
	 * @agentApi The root project's `agentApi` config - `{ enabled, tokenEnvVar }`, both optional
	 *
	 * @return The route's own statement line(s) - an empty array when `agentApi.enabled` is false
	 */
	private array function renderReservedAgentRoute( required struct agentApi ) {
		if ( !( arguments.agentApi.enabled ?: true ) ) {
			return []
		}

		var tokenEnvVar = trim( arguments.agentApi.tokenEnvVar ?: "" )

		var lines = [
			"// The reserved agent route - always present, whatever gateways/ declares,",
			"// so this module's own tooling (chat --server, invoke --server) always has",
			"// an address. A project's own public API belongs in gateways/ instead."
		]

		if ( !len( tokenEnvVar ) ) {
			lines.append( 'route( "#static.RESERVED_AGENT_PATH#" ).toAi( "GeneratedAgent" )' )
			return lines
		}

		lines.append( "// Gated on #tokenEnvVar#: an unset or blank value matches nothing," )
		lines.append( "// so this fails closed rather than letting every caller through." )
		lines.append( 'route( "#static.RESERVED_AGENT_PATH#" )' )
		lines.append( '	.withCondition( ( requestString ) => {' )
		lines.append( '		var expected = getSystemSetting( "#bxLiteral( tokenEnvVar )#", "" )' )
		lines.append( '		if ( !len( expected ) ) {' )
		lines.append( '			return false' )
		lines.append( '		}' )
		lines.append( '		var headers = getHTTPRequestData( false ).headers' )
		lines.append( '		return ( headers[ "x-bxagents-token" ] ?: "" ) == expected' )
		lines.append( '	} )' )
		lines.append( '	.toAi( "GeneratedAgent" )' )
		lines.append( "" )
		lines.append( "// Registered AFTER the gated route, so it only ever catches what the" )
		lines.append( "// condition above turned away. Without it a refused request falls" )
		lines.append( "// through to ColdBox's default main.index event, which a generated app" )
		lines.append( "// does not define - producing a 500 error page instead of an answer." )
		lines.append( "// RoutingService renders whatever this returns as JSON, with the" )
		lines.append( "// route's own status code, so the closure just returns the body." )
		lines.append( 'route( "#static.RESERVED_AGENT_PATH#/:subroute?" )' )
		lines.append( '	.toResponse( ( event, rc, prc ) => {' )
		lines.append( '		return { "success" : false, "error" : "Missing or invalid x-bxagents-token header" }' )
		lines.append( '	}, 401 )' )

		return lines
	}

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .gateways is used)
	 *
	 * @return { name, config } for every gateways/* entry that has an `exposes` key, sorted by path
	 */
	private array function collectExposureEntries( required struct discovery ) {
		var entries = []

		for ( var gw in ( arguments.discovery.gateways ?: [] ) ) {
			var config = readEntryConfig( gw.path )
			if ( !isNull( config ) && structKeyExists( config, "exposes" ) ) {
				entries.append( { name : gw.name, config : config } )
			}
		}

		// Deterministic ordering by path, independent of filesystem listing order.
		entries.sort( function( a, b ) {
			var pathA = a.config.path ?: ""
			var pathB = b.config.path ?: ""
			if ( pathA != pathB ) {
				return pathA < pathB ? -1 : 1
			}
			return 0
		} )

		return entries
	}

	/**
	 * @entry An exposure entry { name, config }, from collectExposureEntries()
	 *
	 * @return A bare `route(...).toAi(...)` or `route(...).toMCP(...)` statement string
	 */
	private string function renderExposureRoute( required struct entry ) {
		// Normalized exactly as WebUiGenerator normalizes the same value when it
		// mounts the chat shell, so the two generators can never disagree about
		// where an entry lives: a path of "/chat/" mounts at <appDir>/chat with
		// an API_BASE of "/chat/api", and without this the router would register
		// "/chat//api/invoke" and every request from the shell would 404.
		var path = normalizePath( arguments.entry.config.path ?: "" )

		if ( arguments.entry.config.exposes == "agent" ) {
			return 'route( "#bxLiteral( path )#" ).toAi( "GeneratedAgent" )'
		}

		if ( arguments.entry.config.exposes == "webui" ) {
			// The static chat shell itself (<path>/index.html) is a real file
			// under the app's own webroot - see WebUiGenerator - so it's served
			// directly, no route needed. Only the API needs routes, at a fixed
			// "/api" suffix so they never collide with the shell's own files.
			//
			// Deliberately NOT toAi(): its actions forward body.options to the
			// runnable verbatim, so a userId could only ever come from the caller.
			// The web UI needs a SERVER-side identity - ColdBox's own
			// getUserSessionIdentifier() - so that
			// every memory the agent holds is scoped per visitor instead of shared.
			// handlers/ChatUi.bx (see WebUiGenerator) supplies that while keeping
			// toAi()'s exact route shape and SSE wire format.
			var api = bxLiteral( path ) & "/api"

			// Sign-in, only when this entry declares accounts. The form itself is
			// the static login.html mounted beside the shell, so only its POST
			// target and logout need routes.
			var authRoutes = ( arguments.entry.config.users ?: [] ).len()
				? [
					'post( "#bxLiteral( path )#/login" ).toHandler( "ChatAuth.doLogin" )',
					'post( "#bxLiteral( path )#/logout" ).toHandler( "ChatAuth.doLogout" )',
					'get( "#bxLiteral( path )#/logout" ).toHandler( "ChatAuth.doLogout" )'
				]
				: []

			return [
				'post( "#api#/invoke" ).toHandler( "ChatUi.invoke" )',
				'post( "#api#/stream" ).toHandler( "ChatUi.stream" )',
				'post( "#api#/batch" ).toHandler( "ChatUi.batch" )',
				'post( "#api#/cancel" ).toHandler( "ChatUi.cancel" )',
				'post( "#api#/steer" ).toHandler( "ChatUi.steer" )',
				'post( "#api#/clear" ).toHandler( "ChatUi.clear" )',
				'post( "#api#/compact" ).toHandler( "ChatUi.compact" )',
				'post( "#api#/resume" ).toHandler( "ChatUi.resume" )',
				'post( "#api#/conversations/create" ).toHandler( "ChatUi.conversationCreate" )',
				'post( "#api#/conversations/rename" ).toHandler( "ChatUi.conversationRename" )',
				'post( "#api#/conversations/delete" ).toHandler( "ChatUi.conversationDelete" )',
				'post( "#api#/preferences/set" ).toHandler( "ChatUi.preferenceSet" )',
				'post( "#api#/preferences/delete" ).toHandler( "ChatUi.preferenceDelete" )',
				'get( "#api#/pending" ).toHandler( "ChatUi.pending" )',
				'get( "#api#/tools" ).toHandler( "ChatUi.tools" )',
				'get( "#api#/history" ).toHandler( "ChatUi.history" )',
				'get( "#api#/conversations" ).toHandler( "ChatUi.conversations" )',
				'get( "#api#/preferences" ).toHandler( "ChatUi.preferences" )',
				'get( "#api#/health" ).toHandler( "ChatUi.health" )',
				'get( "#api#/info" ).toHandler( "ChatUi.info" )'
			// renderRouterFile() indents the FIRST line of whatever comes back;
			// the continuation lines have to carry that same two-tab body indent
			// themselves or the generated Router.bx comes out ragged.
			].append( authRoutes, true ).toList( char( 10 ) & char( 9 ) & char( 9 ) )
		}

		var target = arguments.entry.config.target ?: ""
		return 'route( "#bxLiteral( path )#" ).toMCP( "#bxLiteral( target )#" )'
	}

	/**
	 * @lines Bare route/comment statement strings to embed in configure()'s body
	 *
	 * @return The rendered config/Router.bx source
	 */
	private string function renderRouterFile( required array lines ) {
		var body = arguments.lines.len() ? arguments.lines : [ "// No HTTP exposure declared under gateways/" ]
		var indented = body.map( line => len( line ) ? "		" & line : "" )

		var fileLines = [
			"class {",
			"",
			"	function configure() {"
		]
		for ( var line in indented ) {
			fileLines.append( line )
		}
		fileLines.append( "	}" )
		fileLines.append( "" )
		fileLines.append( "}" )
		fileLines.append( "" )

		return fileLines.toList( char( 10 ) )
	}

	/**
	 * Reads a discovered `gateways/*` entry's config: JSON files are
	 * deserialized directly, `.bx` files are dynamically loaded and their
	 * `configure()` invoked.
	 *
	 * @path Absolute path to the entry's `.bx`/`.json` file
	 *
	 * @return The entry's config struct, or null if it could not be read
	 */
	private any function readEntryConfig( required string path ) {
		try {
			if ( arguments.path.endsWith( ".json" ) ) {
				return jsonDeserialize( fileRead( arguments.path ) )
			}

			var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()
			var instance = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
				.instantiate( arguments.path, context )
			return instance.configure()
		} catch ( any e ) {
			return null
		}
	}

	/**
	 * @path A filesystem path, or an exposure entry's URL path
	 *
	 * @return The path with any trailing slash(es) stripped
	 */
	private string function normalizePath( required string path ) {
		return arguments.path.reReplace( "[\/]+$", "" )
	}

	/**
	 * @value A raw string to embed inside a generated double-quoted BoxLang string literal
	 *
	 * @return value with `"` doubled and `#` doubled, so it round-trips as a literal, not an interpolation
	 */
	private string function bxLiteral( required string value ) {
		return arguments.value.replace( '"', '""', "all" ).replace( "##", "####", "all" )
	}

}
