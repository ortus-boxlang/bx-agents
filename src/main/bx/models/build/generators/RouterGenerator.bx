/**
 * Generates `config/Router.bx` for a project's HTTP exposure (Build Pipeline
 * Phase 5): one `route(path).toAi("GeneratedAgent")` per `gateways/*` entry
 * that exposes the agent, one `route(path & "/api").toAi("GeneratedAgent")`
 * per entry that exposes the v1 web chat UI (see WebUiGenerator - the UI's
 * own static shell is a real file, not a route), one `route(path).toMCP(target)`
 * per entry that exposes a local `mcp/*` server - all native ColdBox 8.1 AI
 * Routing DSL terminators (https://coldbox.ortusbooks.com/the-basics/routing/routing-dsl/ai-routing),
 * confirmed via documentation to auto-register 4 sub-routes (toAi) or 1 route
 * (toMCP) respectively.
 *
 * When at least one channel-adapter gateway of type "http" exists (see
 * GatewayGenerator), also emits the 3 fixed bx-ai Gateway webhook routes.
 * ColdBox has no `toAiGateway()` DSL terminator (confirmed absent from the
 * routing-dsl docs) - so this is BX Agents' own wiring, following the same
 * shape a future core terminator would produce (plain routes to a generated
 * handler), not a reuse of toAi()/toMCP(). See the accompanying proposal to
 * upstream a real `toAiGateway()` into coldbox-platform.
 */
class {

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .gateways is used)
	 * @appDir Absolute path to the generated ColdBox app dir, e.g. "<projectRoot>/.build/app"
	 * @hasHttpGateway Whether an http-type channel-adapter gateway exists (see GatewayGenerator) - emits the 3 fixed gateway webhook routes when true
	 * @hasWhatsAppCloudGateway Whether a whatsapp-cloud-type channel-adapter gateway exists (see GatewayGenerator) - emits the GET/POST WhatsApp Cloud webhook routes when true
	 * @hasTeamsGateway Whether a teams-type channel-adapter gateway exists (see GatewayGenerator) - emits the POST Teams webhook route when true
	 * @hasTwilioGateway Whether a twilio-type channel-adapter gateway exists (see GatewayGenerator) - emits the POST Twilio webhook route when true
	 * @hasGitHubGateway Whether a github-type channel-adapter gateway exists (see GatewayGenerator) - emits the POST GitHub webhook route when true
	 *
	 * @return { router, hasRoutes, hasAgentExposure }
	 */
	struct function generate( required struct discovery, required string appDir, boolean hasHttpGateway = false, boolean hasWhatsAppCloudGateway = false, boolean hasTeamsGateway = false, boolean hasTwilioGateway = false, boolean hasGitHubGateway = false ) {
		var exposureEntries = collectExposureEntries( arguments.discovery )
		var lines = []

		for ( var entry in exposureEntries ) {
			lines.append( renderExposureRoute( entry ) )
		}

		if ( arguments.hasHttpGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// bx-ai Gateway webhook surface - ColdBox has no toAiGateway() DSL" )
			lines.append( "// terminator (yet), so this mirrors the same shape toAi()/toMCP() use:" )
			lines.append( "// plain routes to a generated handler that proxies GatewayRequestProcessor." )
			lines.append( 'post( "/gateways/:gatewayName/events" ).toHandler( "Gateway.process" )' )
			lines.append( 'get( "/interactions/:requestID" ).toHandler( "Gateway.process" )' )
			lines.append( 'post( "/interactions/:requestID/decisions" ).toHandler( "Gateway.process" )' )
		}

		if ( arguments.hasWhatsAppCloudGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// WhatsApp Business Cloud API webhook surface - Meta's own verify" )
			lines.append( "// handshake (GET) and signed inbound delivery (POST), handled by" )
			lines.append( "// WhatsAppCloudGateway itself (own X-Hub-Signature-256 scheme, not" )
			lines.append( "// bx-ai's GatewayRequestProcessor)." )
			lines.append( 'get( "/webhooks/whatsapp-cloud" ).toHandler( "WhatsAppCloud.verify" )' )
			lines.append( 'post( "/webhooks/whatsapp-cloud" ).toHandler( "WhatsAppCloud.process" )' )
		}

		if ( arguments.hasTeamsGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// Microsoft Teams webhook surface (Bot Framework Activity protocol) -" )
			lines.append( "// one route, handled by TeamsGateway itself (own JWT-bearer scheme," )
			lines.append( "// not bx-ai's GatewayRequestProcessor)." )
			lines.append( 'post( "/webhooks/teams" ).toHandler( "Teams.process" )' )
		}

		if ( arguments.hasTwilioGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// Twilio SMS webhook surface - handled by TwilioGateway itself" )
			lines.append( "// (own X-Twilio-Signature scheme, not bx-ai's GatewayRequestProcessor)." )
			lines.append( 'post( "/webhooks/twilio" ).toHandler( "Twilio.process" )' )
		}

		if ( arguments.hasGitHubGateway ) {
			if ( lines.len() ) {
				lines.append( "" )
			}
			lines.append( "// GitHub webhook surface (issue/PR comments) - handled by GitHubGateway" )
			lines.append( "// itself (own X-Hub-Signature-256 scheme, not bx-ai's GatewayRequestProcessor)." )
			lines.append( 'post( "/webhooks/github" ).toHandler( "GitHub.process" )' )
		}

		var appDir = normalizePath( arguments.appDir )
		directoryCreate( path = appDir & "/config", createPath = true, ignoreExists = true )
		var routerPath = appDir & "/config/Router.bx"
		fileWrite( routerPath, renderRouterFile( lines ) )

		var hasAgentExposure = false
		for ( var entry in exposureEntries ) {
			if ( entry.config.exposes == "agent" ) {
				hasAgentExposure = true
			}
		}

		return {
			router           : routerPath,
			hasRoutes        : lines.len() > 0,
			hasAgentExposure : hasAgentExposure
		}
	}

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .gateways is used)
	 *
	 * @return { name, config } for every gateways/* entry that has an `exposes` key, sorted by path
	 */
	private array function collectExposureEntries( required struct discovery ) {
		var entries = []

		for ( var gw in ( arguments.discovery.gateways ?: [] ) ) {
			var config = readEntryConfig( gw.path )
			if ( !isNull( config ) && structKeyExists( config, "exposes" ) ) {
				entries.append( { name : gw.name, config : config } )
			}
		}

		// Deterministic ordering by path, independent of filesystem listing order.
		entries.sort( function( a, b ) {
			var pathA = a.config.path ?: ""
			var pathB = b.config.path ?: ""
			if ( pathA != pathB ) {
				return pathA < pathB ? -1 : 1
			}
			return 0
		} )

		return entries
	}

	/**
	 * @entry An exposure entry { name, config }, from collectExposureEntries()
	 *
	 * @return A bare `route(...).toAi(...)` or `route(...).toMCP(...)` statement string
	 */
	private string function renderExposureRoute( required struct entry ) {
		var path = arguments.entry.config.path ?: ""

		if ( arguments.entry.config.exposes == "agent" ) {
			return 'route( "#bxLiteral( path )#" ).toAi( "GeneratedAgent" )'
		}

		if ( arguments.entry.config.exposes == "webui" ) {
			// The static chat shell itself (<path>/index.html) is a real file
			// under the app's own webroot - see WebUiGenerator - so it's served
			// directly, no route needed. Only the API needs routes, at a fixed
			// "/api" suffix so they never collide with the shell's own files.
			//
			// Deliberately NOT toAi(): its actions forward body.options to the
			// runnable verbatim, so a userId could only ever come from the caller.
			// The web UI needs a SERVER-side identity - session.sessionId - so that
			// every memory the agent holds is scoped per visitor instead of shared.
			// handlers/ChatUi.bx (see WebUiGenerator) supplies that while keeping
			// toAi()'s exact route shape and SSE wire format.
			var api = bxLiteral( path ) & "/api"
			return [
				'post( "#api#/invoke" ).toHandler( "ChatUi.invoke" )',
				'post( "#api#/stream" ).toHandler( "ChatUi.stream" )',
				'post( "#api#/batch" ).toHandler( "ChatUi.batch" )',
				'post( "#api#/cancel" ).toHandler( "ChatUi.cancel" )',
				'post( "#api#/steer" ).toHandler( "ChatUi.steer" )',
				'post( "#api#/clear" ).toHandler( "ChatUi.clear" )',
				'post( "#api#/compact" ).toHandler( "ChatUi.compact" )',
				'post( "#api#/resume" ).toHandler( "ChatUi.resume" )',
				'get( "#api#/pending" ).toHandler( "ChatUi.pending" )',
				'get( "#api#/tools" ).toHandler( "ChatUi.tools" )',
				'get( "#api#/history" ).toHandler( "ChatUi.history" )',
				'get( "#api#/health" ).toHandler( "ChatUi.health" )',
				'get( "#api#/info" ).toHandler( "ChatUi.info" )'
			// renderRouterFile() indents the FIRST line of whatever comes back;
			// the continuation lines have to carry that same two-tab body indent
			// themselves or the generated Router.bx comes out ragged.
			].toList( char( 10 ) & char( 9 ) & char( 9 ) )
		}

		var target = arguments.entry.config.target ?: ""
		return 'route( "#bxLiteral( path )#" ).toMCP( "#bxLiteral( target )#" )'
	}

	/**
	 * @lines Bare route/comment statement strings to embed in configure()'s body
	 *
	 * @return The rendered config/Router.bx source
	 */
	private string function renderRouterFile( required array lines ) {
		var body = arguments.lines.len() ? arguments.lines : [ "// No HTTP exposure declared under gateways/" ]
		var indented = body.map( line => len( line ) ? "		" & line : "" )

		var fileLines = [
			"class {",
			"",
			"	function configure() {"
		]
		for ( var line in indented ) {
			fileLines.append( line )
		}
		fileLines.append( "	}" )
		fileLines.append( "" )
		fileLines.append( "}" )
		fileLines.append( "" )

		return fileLines.toList( char( 10 ) )
	}

	/**
	 * Reads a discovered `gateways/*` entry's config: JSON files are
	 * deserialized directly, `.bx` files are dynamically loaded and their
	 * `configure()` invoked.
	 *
	 * @path Absolute path to the entry's `.bx`/`.json` file
	 *
	 * @return The entry's config struct, or null if it could not be read
	 */
	private any function readEntryConfig( required string path ) {
		try {
			if ( arguments.path.endsWith( ".json" ) ) {
				return jsonDeserialize( fileRead( arguments.path ) )
			}

			var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()
			var instance = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
				.instantiate( arguments.path, context )
			return instance.configure()
		} catch ( any e ) {
			return null
		}
	}

	/**
	 * @path A filesystem path
	 *
	 * @return The path with any trailing slash(es) stripped
	 */
	private string function normalizePath( required string path ) {
		return arguments.path.reReplace( "[\/]+$", "" )
	}

	/**
	 * @value A raw string to embed inside a generated double-quoted BoxLang string literal
	 *
	 * @return value with `"` doubled and `#` doubled, so it round-trips as a literal, not an interpolation
	 */
	private string function bxLiteral( required string value ) {
		return arguments.value.replace( '"', '""', "all" ).replace( "##", "####", "all" )
	}

}
