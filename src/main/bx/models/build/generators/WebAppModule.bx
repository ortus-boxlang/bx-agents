import bxModules.bxagents.models.util.Strings;
import bxModules.bxagents.models.util.TreeDelete;

/**
 * Puts the web app module (src/main/bx/bxagentsui: handlers, router, layouts, views and the Vite build) into a built
 * app: copied to <app>/modules/bxagentsui (code, views, the Vite manifest and its icon set, none of it served), its
 * settings in <app>/config/bxagentsui.json from the web UI gateway's configure(), and ONLY the files the browser
 * loads (the built scripts and styles) into <public>/includes/bxagentsui, where the web root serves them. The module
 * reads the settings file when ColdBox registers it: its entry point (basePath) mounts it.
 *
 * With BXAGENTS_UI_LINK=true (what ui/scripts/stack.mjs sets) the module is linked instead of copied, so a change to a
 * view or a handler shows on the next request, without a build; <public>/includes/bxagentsui is then a link to the
 * module's includes folder. BXAGENTS_UI_SOURCE names the folder to link (the
 * repository's src/main/bx/bxagentsui), since the running bxagents module may be a packaged copy.
 */
class {

	/**
	 * @return Where the module's source is: next to this generator in the bxagents module
	 */
	string function sourceDir() {
		var named = createObject( "java", "java.lang.System" ).getenv( "BXAGENTS_UI_SOURCE" ) ?: ""
		return len( named ) ? named : expandPath( getDirectoryFromPath( getCurrentTemplatePath() ) & "../../../bxagentsui" )
	}

	/**
	 * @entry The web UI gateway entry ({ config, projectRoot })
	 *
	 * @return The path the module answers at: the gateway's own path (`/chat`)
	 */
	string function mountPath( required struct entry ) {
		var path = Strings::normalizePath( arguments.entry.config.path ?: "" )
		return len( path ) ? path : "/"
	}

	/**
	 * Copies (or links) the module, its icons, and writes its settings.
	 *
	 * @entry The web UI gateway entry
	 * @appDir The generated app
	 * @publicDir The web root, e.g. "<projectRoot>/.build/public". Defaults to `public/` beside the app folder
	 * @apiBase Where the agent API is served
	 * @themeCss The gateway's theme as CSS custom properties
	 * @customCss The project's own theme.css
	 */
	void function install(
		required struct entry,
		required string appDir,
		required string apiBase,
		string themeCss = "",
		string customCss = "",
		array disable = [],
		string publicDir = ""
	) {
		var target = Strings::normalizePath( arguments.appDir ) & "/modules/bxagentsui"
		var source = sourceDir()
		var link = ( createObject( "java", "java.lang.System" ).getenv( "BXAGENTS_UI_LINK" ) ?: "" ) == "true"
		removeInstalled( target, arguments.appDir )
		directoryCreate( getDirectoryFromPath( target ), true, true )
		var files = createObject( "java", "java.nio.file.Files" )
		if ( link ) {
			files.createSymbolicLink( pathOf( target ), pathOf( source ), [] )
		} else {
			directoryCopy( source, target, true )
			// a dev server note never ships
			if ( fileExists( target & "/includes/hot" ) ) {
				fileDelete( target & "/includes/hot" )
			}
		}
		fileCopy( getDirectoryFromPath( getCurrentTemplatePath() ) & "webui/vendor/icons.svg", target & "/includes/icons.svg" )
		publishIncludes( target, len( arguments.publicDir ) ? Strings::normalizePath( arguments.publicDir ) : getDirectoryFromPath( Strings::normalizePath( arguments.appDir ) ).reReplace( "[\\/]+$", "" ) & "/public", link )

		var config = arguments.entry.config
		var path = Strings::normalizePath( config.path ?: "" )
		var signIn = ( config.users ?: [] ).len() > 0
		var extensions = new "models.build.generators.ExtensionWebAssets@bxagents"().links( arguments.entry.projectRoot ?: "", len( path ) ? path : "", arguments.disable )
		var settings = {
			"basePath"    : mountPath( arguments.entry ),
			// the chat: the module's own home page
			"chatUrl"     : len( path ) ? path & "/" : "/",
			"apiBase"     : arguments.apiBase,
			"title"       : len( config.title ?: "" ) ? config.title : "BX Agents Chat",
			"subtitle"    : config.subtitle ?: "",
			"icon"        : config.icon ?: "",
			// how the header draws the icon (image, a name of the icon set, text, or the robot), and the tab's icon
			"iconKind"    : iconKind( config.icon ?: "" ),
			"iconName"    : phosphorName( config.icon ?: "" ),
			"favicon"     : faviconHref( config.icon ?: "" ),
			// the BoxLang and CFML word lists the terminal uses, so the chat colours code the same way
			"grammarWords" : grammarWords(),
			"welcome"     : config.welcome ?: "",
			"placeholder" : len( config.placeholder ?: "" ) ? config.placeholder : "Message...",
			"footer"      : config.footer ?: "",
			"signIn"      : signIn,
			"loginUrl"    : signIn ? path & "/login.html" : "",
			"logoutUrl"   : signIn ? path & "/logout" : "",
			"themeCss"    : arguments.themeCss,
			"customCss"   : arguments.customCss,
			// what the empty chat offers, and whether it shows the model's reasoning and its tool calls (both on by default)
			"suggestions" : suggestionsOf( config ),
			// the files of the project's folder extensions (their web/ folders), linked by the layout
			"extensionStyles"  : extensions.styleHrefs,
			"extensionScripts" : extensions.scriptHrefs,
			"showReasoning" : isNull( config.showReasoning ?: javacast( "null", "" ) ) ? true : !!config.showReasoning,
			"showTools"   : isNull( config.showToolCalls ?: javacast( "null", "" ) ) ? true : !!config.showToolCalls,
			// the browser's address of public/includes/bxagentsui (see publishIncludes()); the module's own folder is not served
			"includesUrl" : "/includes/bxagentsui",
			// the /_kit page of partials: only where the module is linked for development
			"kit"         : link
		}
		// read by the module's ModuleConfig when ColdBox registers it (a JSON file: data, never code)
		directoryCreate( Strings::normalizePath( arguments.appDir ) & "/config", true, true )
		fileWrite( Strings::normalizePath( arguments.appDir ) & "/config/bxagentsui.json", jsonSerialize( settings ) )
	}

	/**
	 * Puts what the browser loads where the web root serves it: the Vite build's `assets` (scripts and styles) go to
	 * `<public>/includes/bxagentsui/build/assets`. The manifest (read on the server by Vite.bx) and the icon sprite
	 * (read on the server by sprite.bxm) stay inside the app, where nothing serves them. A linked module is linked as a
	 * whole, for the dev stack, which also serves its dev server's `hot` note.
	 *
	 * @installed <app>/modules/bxagentsui
	 * @publicDir The web root
	 * @link Whether the module was linked rather than copied
	 */
	private void function publishIncludes( required string installed, required string publicDir, required boolean link ) {
		var served = arguments.publicDir & "/includes/bxagentsui"
		var files = createObject( "java", "java.nio.file.Files" )
		directoryCreate( path = arguments.publicDir & "/includes", createPath = true, ignoreExists = true )
		if ( files.isSymbolicLink( pathOf( served ) ) ) {
			files.delete( pathOf( served ) )
		} else if ( directoryExists( served ) ) {
			TreeDelete::tree( served )
		}
		if ( arguments.link ) {
			files.createSymbolicLink( pathOf( served ), pathOf( arguments.installed & "/includes" ), [] )
			return
		}
		var built = arguments.installed & "/includes/build/assets"
		if ( directoryExists( built ) ) {
			directoryCreate( path = served & "/build", createPath = true, ignoreExists = true )
			directoryCopy( built, served & "/build/assets", true )
		}
	}

	/**
	 * Removes what an earlier build installed: a link is removed as a link (never followed, so the module's source is never
	 * touched), a copy is deleted, and only ever inside the generated app.
	 *
	 * @target <app>/modules/bxagentsui
	 * @appDir The generated app
	 */
	private void function removeInstalled( required string target, required string appDir ) {
		var files = createObject( "java", "java.nio.file.Files" )
		var path = pathOf( arguments.target )
		if ( files.isSymbolicLink( path ) ) {
			files.delete( path )
			return
		}
		if ( !directoryExists( arguments.target ) ) {
			return
		}
		var app = createObject( "java", "java.io.File" ).init( arguments.appDir ).getCanonicalPath()
		var real = createObject( "java", "java.io.File" ).init( arguments.target ).getCanonicalPath()
		if ( !real.startsWith( app & createObject( "java", "java.io.File" ).separator ) ) {
			throw( type = "BxAgents.UnsafeDelete", message = "Refusing to delete [#real#]: it is outside the generated app [#app#]." )
		}
		TreeDelete::tree( arguments.target )
	}

	/**
	 * @file A path
	 *
	 * @return It as a java.nio.file.Path
	 */
	private any function pathOf( required string file ) {
		return createObject( "java", "java.io.File" ).init( arguments.file ).toPath()
	}

	/**
	 * @config The web UI gateway's config
	 *
	 * @return The `suggestions` as at most four short texts: what the empty chat offers to send with one click
	 */
	array function suggestionsOf( required struct config ) {
		var given = arguments.config.suggestions ?: []
		if ( !isArray( given ) ) {
			return []
		}
		var kept = []
		for ( var suggestion in given ) {
			if ( isSimpleValue( suggestion ) && len( trim( suggestion ) ) && kept.len() < 4 ) {
				kept.append( left( trim( suggestion ), 120 ) )
			}
		}
		return kept
	}

	/**
	 * @icon The gateway's `icon`: an emoji or short text, an image address, or `phosphor:<name>`
	 *
	 * @return image | phosphor | text | none: how the header draws it
	 */
	string function iconKind( required string icon ) {
		if ( !len( trim( arguments.icon ) ) ) {
			return "none"
		}
		if ( isIconUrl( arguments.icon ) ) {
			return "image"
		}
		return len( phosphorName( arguments.icon ) ) ? "phosphor" : "text"
	}

	/**
	 * @icon The gateway's `icon`
	 *
	 * @return The tab's icon: the image itself, the set's drawing or the emoji as an SVG data address, or "" for none
	 */
	string function faviconHref( required string icon ) {
		if ( !len( trim( arguments.icon ) ) ) {
			return ""
		}
		if ( isIconUrl( arguments.icon ) ) {
			return arguments.icon
		}
		var named = phosphorName( arguments.icon )
		if ( len( named ) ) {
			// the same drawing the header shows, from the app's own icon set
			var vector = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="##3b5bdb">' & iconSymbols()[ named ] & "</svg>"
			return "data:image/svg+xml," & urlEncodedFormat( vector ).replace( "+", "%20", "all" )
		}
		// an emoji has no image file to ship: the glyph drawn as text in an SVG, percent-encoded since it is almost
		// always several bytes, which a data: address does not reliably decode raw
		return "data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20100%20100%22%3E"
			& "%3Ctext%20y=%22.9em%22%20font-size=%2290%22%3E" & urlEncodedFormat( arguments.icon ) & "%3C/text%3E%3C/svg%3E"
	}

	/**
	 * @icon The gateway's `icon`
	 *
	 * @return true when it is an image address rather than an emoji or a name
	 */
	boolean function isIconUrl( required string icon ) {
		return arguments.icon.reFindNoCase( "^(https?:\/\/|\/|data:image\/)" ) > 0
	}

	/**
	 * @icon The gateway's `icon`
	 *
	 * @return The icon's name when it is written `phosphor:<name>` and the app's icon set has it, else "" (so an emoji, an
	 *         address or a name the set does not have are not taken for one)
	 */
	string function phosphorName( required string icon ) {
		var written = trim( arguments.icon )
		if ( !written.lCase().startsWith( "phosphor:" ) ) {
			return ""
		}
		var named = lCase( trim( written.mid( 10, written.len() ) ) )
		return iconSymbols().keyExists( named ) ? named : ""
	}

	/**
	 * @return The BoxLang and CFML word lists of Grammars.words(), the ones the terminal colours code with
	 */
	struct function grammarWords() {
		var words = {}
		var props = createObject( "java", "ortus.boxlang.bxagents.tui.Grammars" ).words()
		for ( var key in props.stringPropertyNames() ) {
			words[ key ] = props.getProperty( key )
		}
		return words
	}

	/**
	 * @return The drawings of the app's icon set, by name: the inside of each <symbol> of webui/vendor/icons.svg
	 */
	private struct function iconSymbols() {
		if ( !variables.keyExists( "symbols" ) ) {
			var found = {}
			var sprite = fileRead( getDirectoryFromPath( getCurrentTemplatePath() ) & "webui/vendor/icons.svg" )
			for ( var match in sprite.reMatch( '<symbol id="i-[a-z0-9-]+"[^>]*>.*?</symbol>' ) ) {
				var name = match.reReplace( '^<symbol id="i-([a-z0-9-]+)".*$', "\1" )
				found[ name ] = match.reReplace( "^<symbol[^>]*>(.*)</symbol>$", "\1" )
			}
			variables.symbols = found
		}
		return variables.symbols
	}

}
