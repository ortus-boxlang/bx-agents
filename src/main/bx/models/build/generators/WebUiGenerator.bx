/**
 * Generates the web chat UI (Build Pipeline Phase 5, alongside
 * RouterGenerator): for every `gateways/*` entry with `exposes: "webui"`,
 * copies a small, dependency-free, PRE-BUILT static chat page
 * (`webui/index.html`, sitting next to this class - see the docblock on
 * `renderUiBundle()` for how its path is resolved) into the generated app
 * at `<appDir><path>/index.html`, and - when the entry configures an
 * `apiKeyEnvVar` - generates a `preProcess` interceptor gating just that
 * entry's own `<path>/api/*` route (never the static shell itself; see
 * below for why).
 *
 * Deliberately NOT a Vite/npm build: v1 is a single self-contained HTML
 * file (inline CSS/JS, no separate assets to serve or bundle), matching
 * the "small first, then we grow" v1 scope decision. There is nothing to
 * `npm install`/`npm run build` here or in a generated project - the page
 * ships as literal source, read via `fileRead()` and lightly templated
 * with plain string substitution (`.replace()`), never interpolated as
 * BoxLang - the file legitimately contains `#` (CSS hex colors), which
 * would collide with BoxLang's own `#expression#` string-interpolation
 * syntax if this content were ever embedded as a BoxLang string literal
 * instead of a real, separate, non-`.bx` file (confirmed empirically this
 * session - a bare `#fff` inside a BoxLang string literal fails to parse).
 *
 * Talks to the SAME `route(path & "/api").toAi("GeneratedAgent")` route
 * RouterGenerator already knows how to render for `exposes: "agent"` -
 * see RouterGenerator.renderExposureRoute()'s `webui` branch.
 */
import bxModules.bxagents.models.util.Strings;

import bxModules.bxagents.models.util.EntryConfigReader;

import bxModules.bxagents.models.api.ApiPath;

class {

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .gateways is used)
	 * @appDir Absolute path to the generated ColdBox app dir, e.g. "<projectRoot>/.build/app"
	 *
	 * @return { hasWebUi, webUiAuthInterceptorName } - webUiAuthInterceptorName is "" when no webui entry configures an apiKeyEnvVar
	 */
	struct function generate( required struct discovery, required string appDir, struct config = {} ) {
		var entries = collectWebUiEntries( arguments.discovery )
		if ( !entries.len() ) {
			return { hasWebUi : false, webUiAuthInterceptorName : "" }
		}

		for ( var entry in entries ) {
			renderUiBundle( entry, arguments.appDir, new "models.extensions.ExtensionSettings@bxagents"().disableList( isStruct( arguments.config.extensions ?: "" ) ? arguments.config.extensions : {} ) )
		}

		// Accounts decide whether a sign-in is wired in, so they are resolved first. The page itself calls the agent API
		// (see api.ApiPath); this generator only writes the shell, the sign-in pieces and the account store.
		var users = collectWebUiUsers( entries )

		// The SQLite store, shared with the agent API (conversations, preferences, notes, tokens) and holding the
		// accounts. One store per app, named after the first entry's own database config (they all share it).
		var database = resolveDatabaseConfig( entries )

		var modelDir = Strings::normalizePath( arguments.appDir ) & "/models"
		directoryCreate( path : modelDir, createPath : true, ignoreExists : true )
		fileWrite( modelDir & "/ChatDb.bx", renderChatDb( database ) )
		fileWrite( modelDir & "/PasswordHasher.bx", renderPasswordHasher() )
		fileWrite( modelDir & "/UserService.bx", renderUserService() )
		fileWrite( modelDir & "/User.bx", renderUser() )

		var interceptorDir = Strings::normalizePath( arguments.appDir ) & "/interceptors"
		directoryCreate( path : interceptorDir, createPath : true, ignoreExists : true )

		// Migrates the web UI's SQLite store at boot, rather than on whichever
		// request happens to touch the database first. Used to be an
		// afterConfigurationLoad interceptor; as an interceptor it silently
		// never fired (see BuildPipeline.bx's own note on the seeder, which hit
		// the exact same thing), masked because ChatDb.onDIComplete() migrates
		// on first use anyway. A plain onApplicationStart() statement, like the
		// seeder, actually runs.
		var warmStatement = 'application.cbController.getWireBox().getInstance( "ChatDb" )'

		// Accounts. A project that declares none stays exactly as it was: no
		// login gate, no seeder, no cbauth in the picture at all - which keeps
		// `bxAgents serve` on a laptop a zero-ceremony experience.
		var userEntries = entries.filter( function( entry ) {
			return ( entry.config.users ?: [] ).len() > 0
		} )

		var seedStatement = ""
		var loginGateName = ""
		if ( users.len() ) {
			fileWrite( modelDir & "/UserSeeder.bx", renderUserSeeder( users ) )
			// Runs from onApplicationStart(), where "after ColdBox is loaded" is
			// a fact rather than an assumption about interceptor ordering.
			// Wrapped: seeding runs on the boot path, so an exception here would
			// stop the app serving at all. An account that fails to seed must
			// degrade to "cannot sign in", never to "the app is down".
			seedStatement = 'try { application.cbController.getWireBox().getInstance( "UserSeeder" ).seed() } catch ( any e ) { writeLog( text : "Web UI account seeding failed: " & e.message, type : "error", file : "webui-auth" ) }'

			loginGateName = "WebUiLoginGate"
			fileWrite( interceptorDir & "/#loginGateName#.bx", renderLoginGate( userEntries ) )

			var handlerDir = Strings::normalizePath( arguments.appDir ) & "/handlers"
			directoryCreate( path : handlerDir, createPath : true, ignoreExists : true )
			fileWrite( handlerDir & "/ChatAuth.bx", renderAuthHandler( userEntries.first() ) )
		}

		return {
			hasWebUi                   : true,
			webUiWarmStatement         : warmStatement,
			webUiSeedStatement         : seedStatement,
			webUiLoginGateName         : loginGateName,
			webUiHasUsers              : users.len() > 0,
			webUiDatabase              : database
		}
	}

	/**
	 * Resolves the one SQLite store every webui entry in a project shares.
	 *
	 * Both keys are optional per entry; the first entry that sets one wins,
	 * which keeps a single-entry project (the overwhelmingly common shape)
	 * to zero configuration while still allowing a rename.
	 *
	 * @entries webui exposure entries, from collectWebUiEntries()
	 *
	 * @return { datasource, path } - datasource NAME and app-relative db file path
	 */
	private struct function resolveDatabaseConfig( required array entries ) {
		var datasource = "bxagents"
		var dbPath = "./data/chat.db"

		for ( var entry in arguments.entries ) {
			var configured = entry.config.database ?: {}
			if ( !isStruct( configured ) ) {
				continue
			}
			if ( len( configured.datasource ?: "" ) ) {
				datasource = configured.datasource
				break
			}
		}
		for ( var entry in arguments.entries ) {
			var configured = entry.config.database ?: {}
			if ( isStruct( configured ) && len( configured.path ?: "" ) ) {
				dbPath = configured.path
				break
			}
		}

		return { datasource : datasource, path : dbPath }
	}

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .gateways is used)
	 *
	 * @return { name, config } for every gateways/* entry with `exposes: "webui"`, sorted by path
	 */
	private array function collectWebUiEntries( required struct discovery ) {
		var entries = []

		for ( var gw in ( arguments.discovery.gateways ?: [] ) ) {
			var config = EntryConfigReader::read( gw.path )
			if ( !isNull( config ) && ( config.exposes ?: "" ) == "webui" ) {
				// discover() returns no projectRoot, but every gateways/* entry sits at
				// "<root>/gateways/<name>.bx" by convention, so the root is two levels up
				// from the entry file. Derived here rather than threaded through
				// generate()'s signature, which BuildPipeline already calls positionally.
				var gatewaysDir = Strings::normalizePath( getDirectoryFromPath( gw.path ) )
				entries.append( {
					name        : gw.name,
					config      : config,
					projectRoot : Strings::normalizePath( getDirectoryFromPath( gatewaysDir ) )
				} )
			}
		}

		entries.sort( function( a, b ) {
			var pathA = a.config.path ?: ""
			var pathB = b.config.path ?: ""
			if ( pathA != pathB ) {
				return pathA < pathB ? -1 : 1
			}
			return 0
		} )

		return entries
	}

	/**
	 * Reads the vendored `webui/index.html` template sitting next to THIS
	 * class - resolved via `getCurrentTemplatePath()` (an absolute
	 * filesystem path to this .bx file itself, confirmed empirically this
	 * session to resolve correctly whether this class is loaded via this
	 * repo's own dev-time path mapping or a genuinely installed module's
	 * `/bxmodules/bxagents` mapping - it doesn't depend on either prefix,
	 * only on "where am I on disk"), so the template ships alongside this
	 * generator with no separate resource-mapping/packaging step needed
	 * beyond `createModuleStructure` also copying `**\/*.html` (see build.gradle).
	 *
	 * @entry A webui exposure entry { name, config }, from collectWebUiEntries()
	 * @appDir Absolute path to the generated ColdBox app dir
	 */
	private void function renderUiBundle( required struct entry, required string appDir, array disable = [] ) {
		var templateDir = getDirectoryFromPath( getCurrentTemplatePath() )
		var html = fileRead( templateDir & "webui/index.html" )

		var config = arguments.entry.config
		var path = Strings::normalizePath( config.path ?: "" )
		var title = len( config.title ?: "" ) ? config.title : "BX Agents Chat"
		var subtitle = config.subtitle ?: ""
		var icon = config.icon ?: ""
		var welcome = config.welcome ?: ""
		var placeholder = len( config.placeholder ?: "" ) ? config.placeholder : "Message..."
		var footer = config.footer ?: ""

		// Both default ON: the whole point of surfacing them is that a turn's
		// reasoning and tool activity are already on the wire and were being
		// thrown away. Opt OUT per entry when the surface is user-facing.
		var showReasoning = isNull( config.showReasoning ?: javacast( "null", "" ) ) ? true : !!config.showReasoning
		var showTools = isNull( config.showToolCalls ?: javacast( "null", "" ) ) ? true : !!config.showToolCalls

		html = html.replace( "__API_BASE__", ApiPath::reserved(), "all" )
		html = html.replace( "__APP_TITLE__", escapeHtml( title ), "all" )
		html = html.replace( "__PLACEHOLDER__", escapeHtml( placeholder ), "all" )
		html = html.replace( "__FAVICON__", renderFavicon( icon ), "all" )
		html = html.replace( "__APP_ICON__", renderHeaderIcon( icon ), "all" )
		html = html.replace(
			"__APP_SUBTITLE__",
			len( subtitle ) ? '<p class="subtitle">' & escapeHtml( subtitle ) & "</p>" : "",
			"all"
		)
		html = html.replace(
			"__FOOTER__",
			len( footer ) ? '<footer class="note">' & escapeHtml( footer ) & "</footer>" : "",
			"all"
		)
		html = html.replace( "__WELCOME__", escapeJs( welcome ), "all" )
		html = html.replace( "__SHOW_REASONING__", showReasoning ? "true" : "false", "all" )
		html = html.replace( "__SHOW_TOOLS__", showTools ? "true" : "false", "all" )
		html = html.replace( "__THEME_TOKENS__", renderThemeTokens( config.theme ?: {} ), "all" )
		html = html.replace( "__CUSTOM_CSS__", readCustomCss( arguments.entry ), "all" )
		// Last, so none of the replacements above can touch the libraries' own text (they contain "__proto__" and the like)
		html = html.replace( "__MARKDOWN_SCRIPTS__", renderMarkdownScripts( templateDir ), "all" )
		html = html.replace( "__ICON_SPRITE__", fileRead( templateDir & "webui/vendor/icons.svg" ), "all" )

		var mountDir = Strings::normalizePath( arguments.appDir ) & path
		directoryCreate( path : mountDir, createPath : true, ignoreExists : true )
		// The web/ folders of the project's folder extensions are served where they are (see ExtensionWebFiles); the page links them
		var assets = new "models.build.generators.ExtensionWebAssets@bxagents"().links( arguments.entry.projectRoot, path, arguments.disable )
		html = html.replace( "__EXTENSION_STYLES__", assets.styles, "all" )
		html = html.replace( "__EXTENSION_SCRIPTS__", assets.scripts, "all" )
		fileWrite( mountDir & "/index.html", html )

		// The sign-in form ships only when the entry actually declares users -
		// an ungated project should not serve a login page that gates nothing.
		if ( ( arguments.entry.config.users ?: [] ).len() ) {
			var login = fileRead( templateDir & "webui/login.html" )
			login = login.replace( "__TITLE__", encodeForHTML( config.title ?: "Chat" ), "all" )
			login = login.replace( "__LOGIN_ACTION__", path & "/login", "all" )
			login = login.replace( "__THEME_TOKENS__", renderThemeTokens( config.theme ?: {} ), "all" )
			fileWrite( mountDir & "/login.html", login )
		}
	}

	/**
	 * Config key -> CSS custom property. This map IS the themeable surface: a
	 * key outside it is rejected by ProjectValidator rather than silently
	 * ignored, so a typo fails the build instead of quietly doing nothing.
	 */
	private struct function themeTokenMap() {
		return [
			"accent"            : "--accent",
			"accentFg"          : "--accent-fg",
			"bg"                : "--bg",
			"fg"                : "--fg",
			"muted"             : "--muted",
			"border"            : "--border",
			"surface"           : "--surface",
			"inputBg"           : "--input-bg",
			"bubbleUser"        : "--bubble-user",
			"bubbleUserFg"      : "--bubble-user-fg",
			"bubbleAssistant"   : "--bubble-assistant",
			"bubbleAssistantFg" : "--bubble-assistant-fg",
			"bubbleError"       : "--bubble-error",
			"reasoningFg"       : "--reasoning-fg",
			"reasoningBg"       : "--reasoning-bg",
			"toolFg"            : "--tool-fg",
			"toolBg"            : "--tool-bg",
			"radius"            : "--radius",
			"radiusSm"          : "--radius-sm",
			"font"              : "--font",
			"fontMono"          : "--font-mono",
			"fontSize"          : "--font-size",
			"maxWidth"          : "--max-width"
		]
	}

	/**
	 * Renders the `theme` block into two CSS rules: light-mode tokens on
	 * `:root`, and anything under `theme.dark` on `:root[data-theme="dark"]`,
	 * both emitted AFTER the template's own defaults so they win by cascade
	 * order without needing `!important`.
	 *
	 * @theme The entry's `theme` config struct (may be empty)
	 *
	 * @return CSS text, or "" when nothing is themed
	 */
	/**
	 * The script tags that turn an answer's Markdown into a page: marked, DOMPurify and highlight.js (bundled by
	 * tools/webui-vendor, inlined so the UI works offline with no extra requests) and the BoxLang and CFML
	 * grammars, built from the same word lists the terminal's highlighter reads.
	 *
	 * @templateDir The folder holding the webui template
	 *
	 * @return Script tags, ready to put in the page
	 */
	private string function renderMarkdownScripts( required string templateDir ) {
		var words = {}
		var props = createObject( "java", "ortus.boxlang.bxagents.tui.Grammars" ).words()
		for ( var key in props.stringPropertyNames() ) {
			words[ key ] = props.getProperty( key )
		}
		var vendor = arguments.templateDir & "webui/vendor/"
		return [
			"<script>" & fileRead( vendor & "libs.min.js" ) & "</script>",
			"<script>" & fileRead( vendor & "bx-grammars.js" ),
			"registerBoxLangGrammars( hljs, " & jsonSerialize( words ) & " );</script>"
		].toList( char( 10 ) )
	}

	private string function renderThemeTokens( required struct theme ) {
		var tokens = themeTokenMap()
		var lightRules = []
		var darkRules = []

		for ( var key in tokens ) {
			if ( arguments.theme.keyExists( key ) ) {
				lightRules.append( "		#tokens[ key ]#: #normalizeCssValue( arguments.theme[ key ] )#;" )
			}
		}

		var dark = arguments.theme.dark ?: {}
		if ( isStruct( dark ) ) {
			for ( var key in tokens ) {
				if ( dark.keyExists( key ) ) {
					darkRules.append( "		#tokens[ key ]#: #normalizeCssValue( dark[ key ] )#;" )
				}
			}
		}

		var out = []
		if ( lightRules.len() ) {
			out.append( "	:root {" )
			out.append( lightRules.toList( char( 10 ) ) )
			out.append( "	}" )
		}
		if ( darkRules.len() ) {
			out.append( '	:root[data-theme="dark"] {' )
			out.append( darkRules.toList( char( 10 ) ) )
			out.append( "	}" )
		}

		return out.toList( char( 10 ) )
	}

	/**
	 * A bare hex value (`"3b82f6"`) is given its leading `##`. This exists
	 * because BoxLang starts string interpolation at `##` in BOTH quote styles,
	 * so `accent: "##3b82f6"` in a `.bx` config is a parse error unless the
	 * author escapes it as `"####3b82f6"` - a footgun nobody remembers. Writing
	 * the hex bare sidesteps it entirely; `rgb()`/`hsl()`/named colors need
	 * nothing special either way.
	 *
	 * Rejects the handful of characters that could break out of the `<style>`
	 * block or the rule itself.
	 *
	 * @value A raw theme value from config
	 *
	 * @return The CSS-ready value
	 */
	private string function normalizeCssValue( required any value ) {
		var raw = toString( arguments.value ).trim()

		if ( raw.reFind( "[<>{};]" ) ) {
			throw(
				type    : "InvalidThemeValue",
				message : "Theme value [#raw#] contains one of < > { } ; which cannot appear in a CSS custom property value."
			)
		}

		// 3, 6, or 8 bare hex digits and nothing else -> a color missing its "##"
		if ( raw.reFindNoCase( "^[0-9a-f]{3}$|^[0-9a-f]{6}$|^[0-9a-f]{8}$" ) ) {
			return "##" & raw
		}

		return raw
	}

	/**
	 * Inlines the project's own CSS override file, last in the <style> block so
	 * it beats both the shipped defaults and the generated `theme` tokens. This
	 * is the escape hatch for anything the token map doesn't cover - and it's a
	 * real .css file, so ordinary `##rrggbb` hex works there with no BoxLang
	 * escaping in play at all.
	 *
	 * @entry A webui exposure entry { name, config, projectRoot }
	 *
	 * @return The file's contents, or "" when the project has no override
	 */
	private string function readCustomCss( required struct entry ) {
		var relative = len( arguments.entry.config.themeFile ?: "" )
			? arguments.entry.config.themeFile
			: "resources/webui/theme.css"

		var cssPath = arguments.entry.projectRoot & "/" & relative.reReplace( "^[\/]+", "" )
		if ( !fileExists( cssPath ) ) {
			return ""
		}

		var css = fileRead( cssPath )

		// The stylesheet is inlined into a <style> element, so a literal
		// "</style" inside it would close that element early and dump the rest
		// of the file into the document as markup. Fail the build loudly rather
		// than silently stripping the author's own CSS.
		if ( css.findNoCase( "</style" ) ) {
			throw(
				type    : "InvalidThemeFile",
				message : "[#cssPath#] contains a literal ""</style"", which would terminate the page's inline style block. Remove it."
			)
		}

		return css
	}

	/**
	 * @icon The entry's `icon` config - an emoji/short text, or an image URL/path
	 *
	 * @return A <link rel="icon"> tag, or "" when no icon is configured
	 */
	private string function renderFavicon( required string icon ) {
		if ( !len( arguments.icon ) ) {
			return ""
		}

		if ( isIconUrl( arguments.icon ) ) {
			return '<link rel="icon" href="' & escapeHtml( arguments.icon ) & '">'
		}

		// Emoji favicons have no image file to ship: render the glyph into an
		// inline SVG data URI, which keeps the page self-contained. The glyph is
		// percent-encoded rather than dropped in raw - it is almost always
		// multi-byte, and raw non-ASCII in a data: URI is not reliably decoded.
		// Attribute values are percent-encoded rather than quoted, so escapeHtml()
		// below has no quotes to turn into entities and the href stays readable.
		var svg = "data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20100%20100%22%3E"
			& "%3Ctext%20y=%22.9em%22%20font-size=%2290%22%3E" & urlEncodedFormat( arguments.icon ) & "%3C/text%3E%3C/svg%3E"
		return '<link rel="icon" href="' & escapeHtml( svg ) & '">'
	}

	/**
	 * @icon The entry's `icon` config
	 *
	 * @return The header brand mark markup: the configured emoji or image, else a robot
	 */
	private string function renderHeaderIcon( required string icon ) {
		if ( !len( arguments.icon ) ) {
			return '<span class="icon"><svg class="i" aria-hidden="true"><use href="##i-robot"/></svg></span>'
		}

		if ( isIconUrl( arguments.icon ) ) {
			return '<span class="icon"><img src="' & escapeHtml( arguments.icon ) & '" alt=""></span>'
		}

		return '<span class="icon">' & escapeHtml( arguments.icon ) & "</span>"
	}

	/**
	 * @icon The entry's `icon` config
	 *
	 * @return true when the value should be treated as an image reference rather than an emoji/glyph
	 */
	private boolean function isIconUrl( required string icon ) {
		return arguments.icon.reFindNoCase( "^(https?:\/\/|\/|data:image\/)" ) > 0
	}

	/**
	 * @value Text destined for HTML body/attribute content
	 *
	 * @return value with the five markup-significant characters escaped
	 */
	private string function escapeHtml( required string value ) {
		return arguments.value
			.replace( "&", "&amp;", "all" )
			.replace( "<", "&lt;", "all" )
			.replace( ">", "&gt;", "all" )
			.replace( '"', "&quot;", "all" )
			.replace( "'", "&##39;", "all" )
	}

	/**
	 * @value Text destined for a double-quoted JavaScript string literal
	 *
	 * @return value escaped so it cannot terminate the literal or the <script> block
	 */
	private string function escapeJs( required string value ) {
		// Built from char( 92 ) rather than written as a literal backslash so the
		// meaning does not depend on whether BoxLang treats "\" as an escape.
		var slash = char( 92 )

		return arguments.value
			.replace( slash, slash & slash, "all" )
			.replace( '"', slash & '"', "all" )
			.replace( char( 13 ), "", "all" )
			.replace( char( 10 ), slash & "n", "all" )
			.replace( "</", "<" & slash & "/", "all" )
	}

	/**
	 * Renders `models/UserService.bx` - cbauth's `IUserService`, backed by the
	 * web UI's own SQLite store.
	 *
	 * cbauth asks for exactly three methods and owns everything else (session
	 * storage, login/logout, its own interception points), which is why this
	 * project uses it rather than hand-rolling authentication. The contract was
	 * read from cbauth 5.x's own `interfaces/IUserService.cfc`, not inferred.
	 *
	 * @return The rendered models/UserService.bx source
	 */
	private string function renderUserService() {
		var lines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" *",
			" * cbauth's IUserService, backed by the web UI's SQLite store.",
			" *",
			" * Accounts come from your gateways/* webui entry's `users` block and",
			" * are seeded at boot - see models/UserSeeder.bx.",
			" */",
			"class singleton {",
			"",
			'	property name="wirebox" inject="wirebox";',
			"",
			"	/**",
			"	 * True only for an ACTIVE account whose password verifies.",
			"	 *",
			"	 * A missing user still runs a hash verification against a dummy value",
			"	 * before returning false. Without that, an unknown username answers",
			"	 * measurably faster than a known one with a wrong password, which",
			"	 * turns this into a username oracle.",
			"	 */",
			"	boolean function isValidCredentials( required username, required password ) {",
			"		var record = chatDb().findUserByUsername( arguments.username )",
			"",
			"		if ( record.isEmpty() ) {",
			'			hasher().verify( arguments.password, "pbkdf2$210000$bm90LWEtcmVhbC1zYWx0$bm90LWEtcmVhbC1oYXNo" )',
			"			return false",
			"		}",
			"",
			'		return hasher().verify( arguments.password, record.passwordHash ?: "" )',
			"	}",
			"",
			"	function retrieveUserByUsername( required username ) {",
			"		return toUser( chatDb().findUserByUsername( arguments.username ) )",
			"	}",
			"",
			"	function retrieveUserById( required id ) {",
			"		return toUser( chatDb().findUserById( arguments.id ) )",
			"	}",
			"",
			"	/**",
			"	 * A populated User, or an empty one when no account matched. cbauth",
			"	 * treats an object whose getId() is empty as 'no user'.",
			"	 */",
			"	private any function toUser( required struct record ) {",
			'		var user = wirebox.getInstance( "User" )',
			"		if ( arguments.record.isEmpty() ) {",
			"			return user",
			"		}",
			"		return user.populate(",
			'			id          : arguments.record.id ?: "",',
			'			username    : arguments.record.username ?: "",',
			'			displayName : arguments.record.displayName ?: ""',
			"		)",
			"	}",
			"",
			'	private any function chatDb() {',
			'		return wirebox.getInstance( "ChatDb" )',
			"	}",
			"",
			"	private any function hasher() {",
			'		return wirebox.getInstance( "PasswordHasher" )',
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders `models/User.bx` - cbauth's `IAuthUser`.
	 *
	 * cbauth requires only `getId()`. That id is what the ColdBox
	 * `identifierProvider` returns once someone is signed in, so it becomes the
	 * `userId` every conversation, preference, memory and pending-run ownership
	 * check is already keyed by.
	 *
	 * @return The rendered models/User.bx source
	 */
	private string function renderUser() {
		var lines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" *",
			" * cbauth's IAuthUser. getId() is the whole required contract; the rest",
			" * is here so a template or handler can greet someone by name.",
			" *",
			" * Transient, not a singleton - one instance per signed-in user.",
			" */",
			"class {",
			"",
			'	property name="id"          type="string" default="";',
			'	property name="username"    type="string" default="";',
			'	property name="displayName" type="string" default="";',
			"",
			"	function init() {",
			'		variables.id = ""',
			'		variables.username = ""',
			'		variables.displayName = ""',
			"		return this",
			"	}",
			"",
			'	any function populate( string id = "", string username = "", string displayName = "" ) {',
			"		variables.id = arguments.id",
			"		variables.username = arguments.username",
			"		variables.displayName = arguments.displayName",
			"		return this",
			"	}",
			"",
			"	// cbauth's IAuthUser contract",
			"	function getId() {",
			"		return variables.id",
			"	}",
			"",
			"	boolean function isLoaded() {",
			"		return len( variables.id ) > 0",
			"	}",
			"",
			"	/**",
			"	 * What to show in the UI - the display name when set, else the",
			"	 * username. Never the id, which is an opaque UUID.",
			"	 */",
			"	string function getLabel() {",
			"		return len( variables.displayName ) ? variables.displayName : variables.username",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders `handlers/ChatAuth.bx` - the sign-in endpoints.
	 *
	 * The form itself is a real static file (`<path>/login.html`, from
	 * resources/webui/login.html), served like the chat shell is. This handler
	 * only verifies and redirects, which keeps HTML out of generated BoxLang
	 * string arrays entirely - and means a failed attempt renders a fixed
	 * message from a query flag rather than echoing anything a caller supplied.
	 *
	 * @entry The webui entry this login belongs to
	 *
	 * @return The rendered handlers/ChatAuth.bx source
	 */
	private string function renderAuthHandler( required struct entry ) {
		var base       = Strings::normalizePath( arguments.entry.config.path ?: "" )
		var appPath    = renderLiteral( base & "/" )
		var loginPath  = renderLiteral( base & "/login.html" )
		var failedPath = renderLiteral( base & "/login.html?failed=1" )

		var lines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" *",
			" * Sign-in for the web UI, backed by cbsecurity against the users table.",
			" * The form is the static login.html alongside the chat shell.",
			" */",
			"class {",
			"",
			'	property name="auth" inject="cbSecurity@cbSecurity";',
			"",
			"	/**",
			"	 * Verify a submitted username/password.",
			"	 *",
			"	 * Every failure redirects to the same generic message. Unknown user",
			"	 * and wrong password are indistinguishable on purpose, so this cannot",
			"	 * be used to discover which usernames exist.",
			"	 */",
			"	function doLogin( event, rc, prc ) {",
			'		var username = trim( rc.username ?: "" )',
			"",
			"		try {",
			'			auth.authenticate( username, rc.password ?: "" )',
			"		} catch ( any e ) {",
			"			writeLog(",
			'				text : "Failed web UI sign-in for [" & username & "]",',
			'				type : "warning",',
			'				file : "webui-auth"',
			"			)",
			"			return redirectTo( event, #failedPath# )",
			"		}",
			"",
			"		return redirectTo( event, #appPath# )",
			"	}",
			"",
			"	function doLogout( event, rc, prc ) {",
			"		auth.logout()",
			"		return redirectTo( event, #loginPath# )",
			"	}",
			"",
			"	private function redirectTo( required any event, required string location ) {",
			"		arguments.event.setHTTPHeader( statusCode = 302, statusText = 'Found' )",
			"		arguments.event.setHTTPHeader( name = 'Location', value = arguments.location )",
			// noExecution() alone stops the handler chain but NOT ColdBox's own
			// view/layout rendering - confirmed against real ColdBox 8.1.0
			// source (Bootstrap.cfc checks isNoRender()/getIsNoExecution()
			// separately). Without noRender() too, a plain redirect like this
			// one 500s trying to render a default view that was never asked
			// for, clobbering the 302 with an error page.
			"		arguments.event.noExecution()",
			"		arguments.event.noRender()",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders `interceptors/WebUiAuthGate.bx` - the sign-in gate.
	 *
	 * Generated only when a project actually declares users. With no users
	 * configured nothing is gated, which keeps `bxAgents serve` on a laptop a
	 * zero-ceremony experience; the docs are explicit that this is a local-dev
	 * posture, not a deployment one.
	 *
	 * Unlike the API-key gate, this one DOES cover the static shell: a browser
	 * hitting the page unauthenticated should land on a login form, and there is
	 * no header for it to be missing. `/login` itself is exempt, or the
	 * redirect would loop forever.
	 *
	 * @entries webui entries that declare users
	 *
	 * @return The rendered interceptors/WebUiLoginGate.bx source
	 */
	private string function renderLoginGate( required array entries ) {
		var lines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" *",
			" * Requires a signed-in user for the web UI.",
			" *",
			" * A browser navigation gets a redirect to the login form. The agent API is not",
			" * behind this gate: it answers its own callers (see api.Authenticator), so the",
			" * page's fetch() gets a 401 with JSON and never a redirect into an HTML form.",
			" */",
			"class {",
			"",
			'	property name="auth" inject="cbSecurity@cbSecurity";',
			"",
			"	function preProcess( event, interceptData, rc, prc ) {",
			"		var path = event.getPath()"
		]

		for ( var entry in arguments.entries ) {
			var base = Strings::normalizePath( entry.config.path ?: "" )
			// Built as their own variables first. A #renderLiteral(...)#
			// interpolation containing its own double-quoted string terminates
			// the surrounding string early - a parse hazard this project has
			// been bitten by more than once.
			var basePath   = renderLiteral( base )
			var loginPath  = renderLiteral( base & "/login" )
			var logoutPath = renderLiteral( base & "/logout" )
			var agentApi   = renderLiteral( ApiPath::reserved() )

			lines.append( "" )
			lines.append( "		if ( path.startsWith( #basePath# ) ) {" )
			lines.append( "			// The login form and its POST target must stay reachable" )
			lines.append( "			// while signed out, or the redirect below never terminates." )
			lines.append( "			// The agent API is under this path when the page sits at the root; it gates itself." )
			lines.append( "			if ( path.startsWith( #loginPath# ) || path.startsWith( #logoutPath# ) || path.startsWith( #agentApi# ) ) {" )
			lines.append( "				return" )
			lines.append( "			}" )
			lines.append( "			if ( !auth.isLoggedIn() ) {" )
			lines.append( "				event.setHTTPHeader( statusCode = 302, statusText = 'Found' )" )
			lines.append( "				event.setHTTPHeader( name = 'Location', value = #loginPath# )" )
			// See ChatAuth.bx's own redirectTo() for why both calls are needed:
			// noExecution() alone does not stop ColdBox's own view rendering.
			lines.append( "				event.noExecution()" )
			lines.append( "				event.noRender()" )
			lines.append( "				return" )
			lines.append( "			}" )
			lines.append( "		}" )
		}

		lines.append( "	}" )
		lines.append( "" )
		lines.append( "}" )
		lines.append( "" )
		return lines.toList( char( 10 ) )
	}

	/**
	 * Every configured account across all webui entries, normalized.
	 *
	 * A username may only be declared once across the whole project - two
	 * entries claiming the same username would race each other at seed time and
	 * whichever ran last would win silently. ProjectValidator rejects that, so
	 * reaching here with a duplicate is a bug, not user error.
	 *
	 * @entries collectWebUiEntries()'s result
	 *
	 * @return Array of { username, passwordEnvVar, passwordHash, displayName }
	 */
	private array function collectWebUiUsers( required array entries ) {
		var users = []
		for ( var entry in arguments.entries ) {
			for ( var user in ( entry.config.users ?: [] ) ) {
				users.append( {
					username       : user.username ?: "",
					passwordEnvVar : user.passwordEnvVar ?: "",
					passwordHash   : user.passwordHash ?: "",
					displayName    : user.displayName ?: ""
				} )
			}
		}
		return users
	}

	/**
	 * Renders `models/UserSeeder.bx` - reconciles the accounts in `gateways/*`
	 * config into the users table at boot.
	 *
	 * A MODEL called from `onApplicationStart()`, not an interceptor on
	 * `afterConfigurationLoad`. It was an interceptor first, and it silently
	 * never ran: the users table still appeared - because `ChatDb.init()`
	 * migrates on construction, so the schema shows up the moment WireBox
	 * builds it - which made the interceptor look like it had fired when
	 * nothing had. A startup statement runs after `loadColdbox()` has fully
	 * returned, with no dependence on when a given interception point fires
	 * relative to when config-declared interceptors are registered.
	 *
	 * Config is the source of truth for WHO exists. Passwords never appear in
	 * it: an account names an environment variable holding its plaintext
	 * (`passwordEnvVar`), or carries an already-hashed value (`passwordHash`),
	 * which is safe to commit precisely because it cannot be reversed.
	 *
	 * Runs from onApplicationStart() after the web UI's own warm statement
	 * (`getInstance( "ChatDb" )`, see BuildPipeline.bx) has migrated - the
	 * users table has to exist before anything is written into it.
	 *
	 * @users collectWebUiUsers()'s result
	 *
	 * @return The rendered models/UserSeeder.bx source
	 */
	private string function renderUserSeeder( required array users ) {
		var lines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" *",
			" * Reconciles the accounts declared in your gateways/* webui entry into",
			" * the users table, once per boot.",
			" *",
			" * Adding a user to config creates them. Changing their password updates",
			" * it. REMOVING them from config deactivates the account - deliberately",
			" * not a delete, because their conversations reference their id and",
			" * dropping the row would orphan that history rather than revoke access.",
			" *",
			" * Called from Application.bx's onApplicationStart(), after ColdBox has",
			" * finished loading. Idempotent, so running it twice is harmless.",
			" */",
			"class singleton {",
			"",
			'	property name="wirebox" inject="wirebox";',
			"",
			"	void function seed() {",
			'		var db = wirebox.getInstance( "ChatDb" )',
			'		var hasher = wirebox.getInstance( "PasswordHasher" )',
			"		var configured = []",
			""
		]

		for ( var user in arguments.users ) {
			lines.append( "		// ---- #user.username# ----" )
			lines.append( "		configured.append( #renderLiteral( user.username )# )" )

			if ( len( user.passwordHash ) ) {
				// A pre-hashed value needs no work at boot and no environment.
				lines.append( "		db.upsertUser(" )
				lines.append( "			username     : #renderLiteral( user.username )#," )
				lines.append( "			passwordHash : #renderLiteral( user.passwordHash )#," )
				lines.append( "			displayName  : #renderLiteral( user.displayName )#" )
				lines.append( "		)" )
			} else {
				lines.append( "		var plaintext = getSystemSetting( #renderLiteral( user.passwordEnvVar )#, '' )" )
				lines.append( "		if ( !len( plaintext ) ) {" )
				lines.append( "			// Fail CLOSED. Creating the account with an empty or default" )
				lines.append( "			// password because its environment variable is missing would be" )
				lines.append( "			// far worse than it simply not existing." )
				lines.append( '			writeLog(' )
				lines.append( '				text : "Web UI user [#user.username#] skipped: #user.passwordEnvVar# is not set",' )
				lines.append( '				type : "warning",' )
				lines.append( '				file : "webui-auth"' )
				lines.append( "			)" )
				lines.append( "		} else {" )
				lines.append( "			// Re-hash only when the configured password no longer matches what" )
				lines.append( "			// is stored. Hashing is deliberately expensive, so doing it on" )
				lines.append( "			// every boot for every user would be a real startup cost." )
				lines.append( "			var existing = db.findUserByUsername( #renderLiteral( user.username )# )" )
				lines.append( "			var unchanged = !existing.isEmpty() && hasher.verify( plaintext, existing.passwordHash ?: '' )" )
				lines.append( "			if ( !unchanged ) {" )
				lines.append( "				db.upsertUser(" )
				lines.append( "					username     : #renderLiteral( user.username )#," )
				lines.append( "					passwordHash : hasher.hash( plaintext )," )
				lines.append( "					displayName  : #renderLiteral( user.displayName )#" )
				lines.append( "				)" )
				lines.append( "			}" )
				lines.append( "		}" )
			}
			lines.append( "" )
		}

		lines.append( "		// Anyone no longer in config loses access on this boot." )
		lines.append( "		var revoked = db.deactivateUsersNotIn( configured )" )
		lines.append( "" )
		lines.append( "		// The revoked count is logged, not just the configured one: a" )
		lines.append( "		// revocation that silently does nothing looks identical to one that" )
		lines.append( "		// worked, and that is precisely the failure that went unnoticed." )
		lines.append( '		writeLog( text : "Web UI accounts reconciled: " & configured.len() & " configured, " & revoked & " revoked", type : "information", file : "webui-auth" )' )
		lines.append( "	}" )
		lines.append( "" )
		lines.append( "}" )
		lines.append( "" )

		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders `models/PasswordHasher.bx`.
	 *
	 * Passwords are HASHED, never encrypted. Encryption is reversible, and a
	 * stolen SQLite file almost always travels with whatever could decrypt it -
	 * so a reversible scheme turns one file leak into every user's password. A
	 * one-way KDF means the file alone yields nothing usable.
	 *
	 * PBKDF2-HMAC-SHA256 via `generatePBKDFKey()`, because BoxLang ships no
	 * bcrypt/argon2 BIF (verified against the runtime, not assumed) and PBKDF2
	 * is the strongest primitive available without pulling in a dependency.
	 *
	 * Two properties matter more than the specific numbers:
	 *   - a per-user random salt, so identical passwords do not collide and a
	 *     precomputed table is useless
	 *   - the iteration count is stored IN the hash, so it can be raised later
	 *     without invalidating existing hashes - old rows keep verifying at
	 *     their own cost until they are next written
	 *
	 * 210,000 iterations (~350ms on the runtime this was measured against).
	 * OWASP currently suggests 600,000 for PBKDF2-HMAC-SHA256; this sits lower
	 * deliberately, because seeding re-verifies every configured user on each
	 * boot and 600k would add roughly a second per user to startup. Raise it
	 * if your deployment can absorb that - the stored format already supports
	 * a mixed estate.
	 *
	 * @return The rendered models/PasswordHasher.bx source
	 */
	private string function renderPasswordHasher() {
		var lines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" *",
			" * One-way password hashing for the web UI's user accounts.",
			" *",
			" * Format: pbkdf2$<iterations>$<salt>$<derived>",
			" *",
			" * The iteration count travels with each hash, so raising ITERATIONS",
			" * later does not invalidate anything already stored.",
			" */",
			"class singleton {",
			"",
			"	// OWASP suggests 600000 for PBKDF2-HMAC-SHA256. This is lower on",
			"	// purpose: user seeding verifies every configured account on each",
			"	// boot, and 600000 costs about a second per user there. Raise it if",
			"	// your startup budget allows - existing hashes keep working.",
			"	static {",
			"		final ITERATIONS = 210000",
			'		final ALGORITHM  = "PBKDF2WithHmacSHA256"',
			"		final KEY_LENGTH = 256",
			'		final PREFIX     = "pbkdf2"',
			"	}",
			"",
			"	/**",
			"	 * Hash a plaintext password with a fresh random salt.",
			"	 *",
			"	 * @password The plaintext to hash",
			"	 *",
			"	 * @return The encoded hash, safe to store and safe to commit",
			"	 */",
			"	string function hash( required string password ) {",
			'		var salt = generateSecretKey( "AES", 128 )',
			"		var derived = generatePBKDFKey( static.ALGORITHM, arguments.password, salt, static.ITERATIONS, static.KEY_LENGTH )",
			'		return static.PREFIX & "$" & static.ITERATIONS & "$" & salt & "$" & derived',
			"	}",
			"",
			"	/**",
			"	 * Does this plaintext produce the stored hash?",
			"	 *",
			"	 * Re-derives using the salt and iteration count recorded in the stored",
			"	 * value, then compares in constant time - a byte-by-byte comparison",
			"	 * leaks how much of a guess was correct through its own timing.",
			"	 *",
			"	 * Any malformed or empty stored value is a NON-match, never an error:",
			"	 * a corrupt row must fail closed, not throw its way past the check.",
			"	 *",
			"	 * @password The plaintext to check",
			"	 * @stored The previously stored hash",
			"	 *",
			"	 * @return true only on a genuine match",
			"	 */",
			"	boolean function verify( required string password, required string stored ) {",
			"		try {",
			'			var parts = listToArray( arguments.stored, "$" )',
			"			if ( parts.len() != 4 || parts[ 1 ] != static.PREFIX ) {",
			"				return false",
			"			}",
			"			var expected = generatePBKDFKey( static.ALGORITHM, arguments.password, parts[ 3 ], parts[ 2 ], static.KEY_LENGTH )",
			'			return createObject( "java", "java.security.MessageDigest" ).isEqual(',
			'				charsetDecode( expected, "UTF-8" ),',
			'				charsetDecode( parts[ 4 ], "UTF-8" )',
			"			)",
			"		} catch ( any e ) {",
			"			return false",
			"		}",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders `models/ChatDb.bx` - the web UI's SQLite store.
	 *
	 * The schema is versioned and owned by the module's ChatStore (shared with
	 * the terminal chat): `migrate()` applies only the migrations newer than
	 * whatever the database already records, so booting an app whose store
	 * already exists is a no-op rather than an error. Queries go through qb.
	 *
	 * @database { datasource, path } from resolveDatabaseConfig()
	 *
	 * @return The rendered models/ChatDb.bx source
	 */
	private string function renderChatDb( required struct database ) {
		var lines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" *",
			" * The web UI's SQLite store: the sign-in accounts, reached through qb.",
			" *",
			" * Conversations, preferences, notes and tokens are the agent API's, in the same database",
			" * through the module's ChatStore, which owns the versioned schema. migrate() applies only",
			" * what the database has not already recorded, so booting against an existing store is a no-op.",
			" */",
			"class singleton {",
			"",
			'	property name="wirebox" inject="wirebox";',
			"",
			"	static {",
			'		final DATASOURCE     = "#escapeJs( arguments.database.datasource )#"',
			"	}",
			"",
			"	function onDIComplete() {",
			"		migrate()",
			"	}",
			"",
			"	string function getDatasource() {",
			"		return static.DATASOURCE",
			"	}",
			"",
			"	// -----------------------------------------------------------------",
			"	// Schema",
			"	// -----------------------------------------------------------------",
			"",
			"	/**",
			"	 * Brings the database up to date. The schema lives in the module's",
			"	 * ChatStore, shared with the terminal chat, so a chat started in one is",
			"	 * there in the other. Forward-only and safe to run on every boot.",
			"	 *",
			"	 * @return The version the database is at afterwards",
			"	 */",
			"	numeric function migrate() {",
			'		return new "models.store.ChatStore@bxagents"( static.DATASOURCE ).migrate()',
			"	}",
			"",
			"	// -----------------------------------------------------------------",
			"	// Users",
			"	// -----------------------------------------------------------------",
			"",
			"	/**",
			"	 * The active account for a username, or an empty struct. Only active",
			"	 * users are ever returned - a deactivated account must not authenticate.",
			"	 */",
			"	struct function findUserByUsername( required string username ) {",
			"		var found = query()",
			'			.from( "users" )',
			'			.where( "username", arguments.username )',
			'			.where( "isActive", 1 )',
			"			.first()",
			"		return isStruct( found ) ? found : {}",
			"	}",
			"",
			"	struct function findUserById( required string id ) {",
			"		var found = query()",
			'			.from( "users" )',
			'			.where( "id", arguments.id )',
			'			.where( "isActive", 1 )',
			"			.first()",
			"		return isStruct( found ) ? found : {}",
			"	}",
			"",
			"	/**",
			"	 * Create or update one configured account, returning its id.",
			"	 *",
			"	 * Matched on username, NOT on id - the config is the source of truth for",
			"	 * who exists, and it has no way to know the generated id. An existing",
			"	 * user keeps their id (and therefore their whole history) even when the",
			"	 * password or display name changes.",
			"	 */",
			'	string function upsertUser( required string username, required string passwordHash, string displayName = "" ) {',
			"		var existing = query()",
			'			.from( "users" )',
			'			.where( "username", arguments.username )',
			"			.first()",
			"",
			'		if ( isStruct( existing ) && len( existing.id ?: "" ) ) {',
			"			query()",
			'				.from( "users" )',
			'				.where( "id", existing.id )',
			"				.update( {",
			'					"passwordHash" : arguments.passwordHash,',
			'					"displayName"  : arguments.displayName,',
			'					"isActive"     : 1,',
			'					"updatedAt"    : now()',
			"				} )",
			"			return existing.id",
			"		}",
			"",
			"		var id = createUUID()",
			"		query()",
			'			.from( "users" )',
			"			.insert( {",
			'				"id"           : id,',
			'				"username"     : arguments.username,',
			'				"passwordHash" : arguments.passwordHash,',
			'				"displayName"  : arguments.displayName,',
			'				"isActive"     : 1,',
			'				"createdAt"    : now(),',
			'				"updatedAt"    : now()',
			"			} )",
			"		return id",
			"	}",
			"",
			"	/**",
			"	 * Deactivate every account NOT in the configured list, so removing a user",
			"	 * from config revokes their access on the next boot. Deliberately not a",
			"	 * DELETE: their conversations reference their id, and dropping the row",
			"	 * would orphan that history rather than revoke access.",
			"	 *",
			"	 * An empty list deactivates nothing - that means the project configures no",
			"	 * users at all, and wiping every account over a likely misconfiguration is",
			"	 * not a decision this should make silently.",
			"	 *",
			"	 * The count comes from its OWN select rather than from update()'s return",
			"	 * value. qb hands back a driver result STRUCT there, not a row count, so",
			"	 * `return query()...update()` under a numeric declaration throws - and it",
			"	 * throws AFTER the UPDATE has committed, which is how this failed the",
			"	 * first time: every row in the table was correct and the app still could",
			"	 * not finish onApplicationStart(), so it served nothing at all.",
			"	 */",
			"	numeric function deactivateUsersNotIn( required array usernames ) {",
			"		if ( arguments.usernames.isEmpty() ) {",
			"			return 0",
			"		}",
			"",
			"		var doomed = query()",
			'			.from( "users" )',
			'			.whereNotIn( "username", arguments.usernames )',
			'			.where( "isActive", 1 )',
			"			.get()",
			"",
			"		if ( doomed.isEmpty() ) {",
			"			return 0",
			"		}",
			"",
			"		query()",
			'			.from( "users" )',
			'			.whereNotIn( "username", arguments.usernames )',
			'			.where( "isActive", 1 )',
			'			.update( { "isActive" : 0, "updatedAt" : now() } )',
			"",
			"		return doomed.len()",
			"	}",
			"",
			"	// -----------------------------------------------------------------",
			"	// Query entry point",
			"	// -----------------------------------------------------------------",
			"",
			"	/**",
			"	 * A fresh QueryBuilder per call - qb's builders are stateful and",
			"	 * accumulate their WHERE/ORDER clauses, so sharing one across calls",
			"	 * leaks the previous query's conditions into the next.",
			"	 *",
			"	 * The datasource is named HERE, on every builder, rather than being",
			"	 * left to moduleSettings.qb.defaultOptions. That setting is still",
			"	 * written in config/ColdBox.bx (it is the right thing for any other",
			"	 * qb use in the app), but it was NOT reaching QueryBuilder in a real",
			"	 * ColdBox boot: every query failed with",
			"	 *",
			"	 *   No default datasource defined in the application or globally or",
			"	 *   in the query options. Registered datasources are: [<name>]",
			"	 *",
			"	 * - i.e. the datasource was registered, and the builder still had no",
			"	 * options. Exactly why the module setting did not arrive was not run",
			"	 * to ground; naming it explicitly is better than depending on that",
			"	 * plumbing either way.",
			"	 */",
			"	any function query() {",
			"		return wirebox.getInstance( ""QueryBuilder@qb"" )",
			"			.mergeDefaultOptions( { datasource : static.DATASOURCE } )",
			"	}",
			"",
			"}",
			""
		]

		return lines.toList( char( 10 ) )
	}

	/**
	 * @value A raw string to embed inside a generated double-quoted BoxLang string literal
	 *
	 * @return value with `"` doubled and `#` doubled, so it round-trips as a literal, not an interpolation
	 */
	private string function renderLiteral( required string value ) {
		return '"' & arguments.value.replace( '"', '""', "all" ).replace( "##", "####", "all" ) & '"'
	}

}
