/**
 * Generates the bx-ai channel-adapter (`IGateway`/`aiGatewayRegistry()`) wiring
 * for a project's `gateways/*` entries that are NOT HTTP/MCP exposure entries
 * (Build Pipeline Phase 5) - i.e. the `{ type: "mock"|"cli"|"http", ... }`
 * shape, distinct from the `{ exposes: "agent"|"mcp", ... }` shape RouterGenerator
 * handles.
 *
 * Every channel-adapter entry needs a `aiGatewayRegistry().register(aiGateway(...))`
 * call at app startup (returned here as bare statement strings for
 * ColdBoxAppGenerator to insert into Application.bx's onApplicationStart() -
 * this class never writes Application.bx itself).
 *
 * A `type: "http"` entry's `secretEnvVar` (the NAME of an environment
 * variable, never the secret value itself) is deliberately never embedded as
 * a literal - `renderHttpOptions()` emits a live `getSystemSetting(...)` call
 * for it instead, resolved at server startup. Every other channel-adapter
 * entry's config renders as an ordinary literal via `renderLiteral()`. This
 * matches the "secrets stay external" rule used everywhere else in this
 * project (provider API keys, deploy target credentials) - a real, previously
 * unfixed bug had this entry's raw secret value embedded in generated source
 * and shipped unredacted inside the packaged `.bxa` (see docs/known-limitations.md).
 *
 * `http`-type entries additionally need a generated handler
 * (`handlers/Gateway.bx`) so the fixed 3-route bx-ai Gateway webhook surface
 * (`GatewayRequestProcessor::processHttp()`) is reachable over HTTP - see
 * RouterGenerator for the routes pointing at it. Confirmed via bx-ai source
 * (models/gateway/http/GatewayRequestProcessor.bx) that `processHttp()` is a
 * static, zero-argument call that reads/writes the raw HTTP request/response
 * itself (via cgi.PATH_INFO and its own HTTPTransport), so the handler action
 * is a thin, identical passthrough for all 3 routes - no event/rc/prc
 * translation needed, just `event.noRender()` afterward since processHttp()
 * already wrote the real response.
 *
 * "Push-style" entries (`type: "telegram"`, and future "slack"/"discord"/
 * "email"/"whatsapp-cloud"/"whatsapp-personal") resolve to a bx-ai gateway
 * class living inside THIS module (`bxModules.bxagents.models.gateways.*`),
 * not a core bx-ai name - so their registration renders `aiGateway( "bxModules.bxagents...",
 * options )` (a bare class-path string, one of aiGateway()'s own supported
 * resolution paths) instead of `aiGateway( "telegram", options )`. Any project
 * with at least one push-style entry also gets a generated
 * `interceptors/GatewaySessionBootstrap.bx` (see renderSessionInterceptor())
 * wiring a single `aiGatewaySession()` for the whole project - GatewaySession
 * itself (bx-ai) is what actually dispatches an inbound message from any of
 * these gateways to the agent.
 */
class {

	/**
	 * Push-style gateway type -> the bx-ai IGateway class (living in THIS
	 * module) aiGateway() should construct for it, via its bare-class-path
	 * resolution fallback. Data-driven so adding a 7th push-style gateway is
	 * one map entry, not new branching logic.
	 */
	static {
		TYPE_CLASS_MAP = {
			telegram: "bxModules.bxagents.models.gateways.TelegramGateway",
			slack   : "bxModules.bxagents.models.gateways.SlackGateway",
			discord : "bxModules.bxagents.models.gateways.DiscordGateway",
			email   : "bxModules.bxagents.models.gateways.EmailGateway"
		}

		// Per push-style type, the *EnvVar option keys renderSecretOptions()
		// resolves live via getSystemSetting() instead of ever embedding a
		// secret as a literal in generated source - same "secrets stay
		// external" rule already enforced for the core `http` type. email's
		// imapHost/fromAddress aren't cryptographic secrets, but the SAME
		// env-var-driven convention is used for every one of its config
		// values anyway - deployment-varying values never baked in.
		SECRET_KEY_MAPS = {
			telegram: { botToken: "botTokenEnvVar" },
			slack   : { botToken: "botTokenEnvVar", appToken: "appTokenEnvVar" },
			discord : { botToken: "botTokenEnvVar" },
			email   : {
				imapHost    : "imapHostEnvVar",
				imapUsername: "imapUsernameEnvVar",
				imapPassword: "imapPasswordEnvVar",
				fromAddress : "fromAddressEnvVar"
			}
		}
	}

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .gateways is used)
	 * @appDir Absolute path to the generated ColdBox app dir, e.g. "<projectRoot>/.build/app" - the handler (if needed) is written to "<appDir>/handlers/Gateway.bx"
	 * @resolvedConfig The root project's resolved config (AgentConfigResolver.resolve()) - only `gatewaySession` is used, to configure the generated GatewaySession's policy/maxQueueDepth
	 *
	 * @return { registrationStatements: [], hasHttpGateway, handlerPath (only if hasHttpGateway), hasPushGateway, hasEmailGateway, sessionInterceptorName (only if hasPushGateway) }
	 */
	struct function generate( required struct discovery, required string appDir, struct resolvedConfig = {} ) {
		var channelEntries = collectChannelEntries( arguments.discovery )
		var hasHttpGateway = false
		var hasEmailGateway = false
		var pushGatewayNames = []

		for ( var entry in channelEntries ) {
			var type = entry.config.type ?: ""
			if ( type == "http" ) {
				hasHttpGateway = true
			}
			if ( type == "email" ) {
				hasEmailGateway = true
			}
			// The registered aiGatewayRegistry() key is ALWAYS the gateway
			// class's own fixed getName() (e.g. TelegramGateway.init() sets
			// variables.name = "telegram") - never the discovered gateways/*
			// entry's own filename-derived name. Confirmed against real
			// bx-ai source (GatewayRegistry.register() calls
			// gateway.getName(), never anything caller-supplied) and
			// empirically: registering a real gateway then calling
			// aiGatewayRegistry().get() with its discovered entry name
			// throws "No item found in registry". Every push-style type's
			// registered name happens to equal its own `type` string, so
			// that's what the generated interceptor must look up by -
			// deduplicated, since two entries of the same type would
			// collide on the same registry slot anyway (bx-ai's registry
			// is name-keyed, not instance-keyed - see the v1 limitation
			// noted in docs/known-limitations.md).
			if ( static.TYPE_CLASS_MAP.keyExists( type ) && !pushGatewayNames.contains( type ) ) {
				pushGatewayNames.append( type )
			}
		}

		var result = {
			registrationStatements : channelEntries.map( e => renderRegistration( e ) ),
			hasHttpGateway         : hasHttpGateway,
			hasPushGateway         : pushGatewayNames.len() > 0,
			hasEmailGateway        : hasEmailGateway
		}

		if ( hasHttpGateway ) {
			var handlerDir = normalizePath( arguments.appDir ) & "/handlers"
			directoryCreate( path = handlerDir, createPath = true, ignoreExists = true )
			var handlerPath = handlerDir & "/Gateway.bx"
			fileWrite( handlerPath, renderHandler() )
			result[ "handlerPath" ] = handlerPath
		}

		if ( pushGatewayNames.len() ) {
			var interceptorDir = normalizePath( arguments.appDir ) & "/interceptors"
			directoryCreate( path = interceptorDir, createPath = true, ignoreExists = true )
			var interceptorName = "GatewaySessionBootstrap"
			fileWrite( interceptorDir & "/#interceptorName#.bx", renderSessionInterceptor( pushGatewayNames, arguments.resolvedConfig ) )
			result[ "sessionInterceptorName" ] = interceptorName
		}

		return result
	}

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .gateways is used)
	 *
	 * @return { name, config } for every gateways/* entry that is a channel-adapter (not an `exposes` entry), sorted by name
	 */
	private array function collectChannelEntries( required struct discovery ) {
		var entries = []

		for ( var gw in ( arguments.discovery.gateways ?: [] ) ) {
			var config = readEntryConfig( gw.path )
			if ( !isNull( config ) && !structKeyExists( config, "exposes" ) ) {
				entries.append( { name : gw.name, config : config } )
			}
		}

		// Deterministic ordering by name, independent of filesystem listing order.
		entries.sort( function( a, b ) {
			if ( a.name != b.name ) {
				return a.name < b.name ? -1 : 1
			}
			return 0
		} )

		return entries
	}

	/**
	 * @entry A single channel-adapter entry { name, config }, from collectChannelEntries()
	 *
	 * @return A bare `aiGatewayRegistry().register( aiGateway(...) )` statement string
	 */
	private string function renderRegistration( required struct entry ) {
		var type = arguments.entry.config.type ?: ""
		var options = duplicate( arguments.entry.config )
		options.delete( "type" )

		var nameExpression = static.TYPE_CLASS_MAP.keyExists( type )
			? renderLiteral( static.TYPE_CLASS_MAP[ type ] )
			: renderLiteral( type )

		var secretKeyMap = secretKeyMapFor( type )
		var renderedOptions = secretKeyMap.count()
			? renderSecretOptions( options, secretKeyMap )
			: renderLiteral( options )

		return "aiGatewayRegistry().register( aiGateway( #nameExpression#, #renderedOptions# ) )"
	}

	/**
	 * @type A gateway entry's own `type` value
	 *
	 * @return This type's own { literalKey: envVarOptionKey } map (see SECRET_KEY_MAPS), or {} if it has none (renders as an ordinary literal instead)
	 */
	private struct function secretKeyMapFor( required string type ) {
		if ( arguments.type == "http" ) {
			return { secret: "secretEnvVar" }
		}
		return static.SECRET_KEY_MAPS[ arguments.type ] ?: {}
	}

	/**
	 * Like `renderLiteral()` for a struct, but every key named in
	 * `secretKeyMap` never appears in the output as its literal value - it's
	 * replaced with a live `getSystemSetting( "<envVarName>", "" )` call,
	 * resolved at server startup rather than baked into generated source.
	 * `getSystemSetting()` defaults to `""` if the env var is unset - bx-ai's
	 * own HttpGateway already treats an empty secret as "no signing
	 * configured" and rejects requests accordingly (confirmed via its
	 * source), so an operator who forgot to set the env var gets a clear
	 * per-request rejection rather than a hard crash at startup. The same
	 * discipline is extended here to every push-style gateway's own token/
	 * secret options (e.g. Telegram's `botToken` <- `botTokenEnvVar`).
	 *
	 * @options A gateway entry's own config, minus its `type` key
	 * @secretKeyMap { outputKey: envVarOptionKeyInOptions } - e.g. { secret: "secretEnvVar" }, { botToken: "botTokenEnvVar" }
	 *
	 * @return A BoxLang struct-literal expression string, safe to embed in generated source
	 */
	private string function renderSecretOptions( required struct options, required struct secretKeyMap ) {
		var rest = duplicate( arguments.options )
		var envVarNames = {}

		for ( var outputKey in arguments.secretKeyMap ) {
			var envVarOptionKey = arguments.secretKeyMap[ outputKey ]
			envVarNames[ outputKey ] = trim( rest[ envVarOptionKey ] ?: "" )
			rest.delete( envVarOptionKey )
			rest[ outputKey ] = ""
		}

		var keys = rest.keyArray().sort( "textnocase" )
		var parts = keys.map( function( k ) {
			if ( envVarNames.keyExists( k ) ) {
				return '"#bxLiteral( k )#" : getSystemSetting( #renderLiteral( envVarNames[ k ] )#, "" )'
			}
			return '"#bxLiteral( k )#" : #renderLiteral( rest[ k ] )#'
		} )
		return "{ " & parts.toList( ", " ) & " }"
	}

	/**
	 * Renders `interceptors/GatewaySessionBootstrap.bx` - a generated ColdBox
	 * interceptor (not a raw `Application.bx`/`onApplicationStart()`
	 * statement, unlike the plain registration calls above) that builds one
	 * `aiGatewaySession()` for the whole project, bundling every push-style
	 * gateway entry, and starts it.
	 *
	 * An interceptor is used specifically because its `afterConfigurationLoad`
	 * point is guaranteed by ColdBox's own lifecycle to fire strictly AFTER
	 * the framework (including SchedulerService, which registers
	 * `appScheduler@coldbox`) has finished loading - each push-style
	 * gateway's own `onStart()` needs that scheduler singleton already live,
	 * an ordering `Application.bx`'s `onApplicationStart()` splice point
	 * doesn't guarantee.
	 *
	 * v1 scope: exactly one GatewaySession, always bound to the project's
	 * root agent (the fixed "GeneratedAgent" WireBox binding) - matches the
	 * existing precedent that `exposes: "agent"` HTTP exposure is also always
	 * root-agent-only (see RouterGenerator). A project with subagents cannot
	 * yet route different gateways to different subagents.
	 *
	 * @pushGatewayNames Every distinct push-style gateway TYPE present (see TYPE_CLASS_MAP) - these ARE the real aiGatewayRegistry() keys (== each gateway class's own fixed getName()), not the discovered gateways/* entries' own filenames
	 * @resolvedConfig The root project's resolved config - only `gatewaySession` ({ policy, maxQueueDepth }, both optional) is used
	 *
	 * @return The rendered interceptors/GatewaySessionBootstrap.bx source
	 */
	private string function renderSessionInterceptor( required array pushGatewayNames, struct resolvedConfig = {} ) {
		var sessionConfig = arguments.resolvedConfig.gatewaySession ?: {}
		var policy = trim( sessionConfig.policy ?: "queue" )
		var maxQueueDepth = sessionConfig.maxQueueDepth ?: 50

		var gatewayRefs = arguments.pushGatewayNames.map( function( name ) {
			return 'aiGatewayRegistry().get( #renderLiteral( name )# )'
		} )

		var lines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" *",
			" * Wires the project's root agent to every push-style gateway",
			" * (Telegram, and friends) via a single bx-ai GatewaySession,",
			" * started once ColdBox's own framework - including the",
			" * scheduler these gateways depend on - has finished loading.",
			" */",
			"class {",
			"",
			"	function afterConfigurationLoad( event, interceptData ) {",
			"		var wirebox        = getController().getWireBox()",
			'		var agent          = wirebox.getInstance( "GeneratedAgent" )',
			// "session" is a reserved BoxLang/ColdBox scope name (like "request"/
			// "server"/"url"/"form"/"cgi"/"thread") - a local variable with that
			// exact name can collide with the live scope rather than behaving as
			// an ordinary local, so this is deliberately named "gatewaySession".
			"		var gatewaySession = aiGatewaySession(",
			"			agent        : agent,",
			"			gateways     : [ #gatewayRefs.toList( ', ' )# ],",
			"			policy       : #renderLiteral( policy )#,",
			"			maxQueueDepth: #maxQueueDepth#",
			"		)",
			"		gatewaySession.start()",
			"		application.bxaiGatewaySession = gatewaySession",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * @return The rendered handlers/Gateway.bx source
	 */
	private string function renderHandler() {
		var lines = [
			"/**",
			" * GENERATED FILE - produced by BX Agents' build pipeline.",
			" * Do not edit by hand; rebuilding your project overwrites this file.",
			" *",
			" * Thin passthrough for the bx-ai Gateway webhook surface - all 3 routes",
			" * (events/interactions/decisions) share this one action, since",
			" * GatewayRequestProcessor::processHttp() dispatches internally off the",
			" * raw request path/method and writes the response itself.",
			" */",
			"class {",
			"",
			"	function process( event, rc, prc ) {",
			"		bxModules.bxai.models.gateway.http.GatewayRequestProcessor::processHttp()",
			"		return arguments.event.noRender()",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders a value as a BoxLang literal for embedding in generated source:
	 * strings are quoted (with "/# doubled), booleans/numbers are bare, structs
	 * and arrays recurse. Struct keys are sorted for deterministic output.
	 *
	 * Type is checked via the value's actual Java class (not isNumeric()/
	 * isBoolean(), which test CASTABILITY in BoxLang - a genuine string like
	 * "12345" or "true" would otherwise be misrendered as a bare literal,
	 * silently changing its type in the generated source).
	 *
	 * @value Any struct/array/string/numeric/boolean value to render
	 *
	 * @return A BoxLang source literal expression for value
	 */
	private string function renderLiteral( required any value ) {
		// Captured into locals before any closure below - BoxLang closures don't
		// reliably re-resolve the enclosing method's `arguments` scope from
		// within a nested function literal (a real engine quirk, not a style choice).
		var val = arguments.value

		if ( isStruct( val ) ) {
			var keys = val.keyArray().sort( "textnocase" )
			var parts = keys.map( function( k ) {
				return '"#bxLiteral( k )#" : #renderLiteral( val[ k ] )#'
			} )
			return "{ " & parts.toList( ", " ) & " }"
		}

		if ( isArray( val ) ) {
			var parts = val.map( function( v ) {
				return renderLiteral( v )
			} )
			return "[ " & parts.toList( ", " ) & " ]"
		}

		var className = val.getClass().getName()
		var numericClasses = [
			"java.lang.Integer", "java.lang.Long", "java.lang.Short",
			"java.lang.Double", "java.lang.Float",
			"java.math.BigDecimal", "java.math.BigInteger"
		]

		if ( className == "java.lang.Boolean" ) {
			return val ? "true" : "false"
		}

		if ( numericClasses.contains( className ) ) {
			return toString( val )
		}

		return '"#bxLiteral( toString( val ) )#"'
	}

	/**
	 * Reads a discovered `gateways/*` entry's config: JSON files are
	 * deserialized directly, `.bx` files are dynamically loaded and their
	 * `configure()` invoked.
	 *
	 * @path Absolute path to the entry's `.bx`/`.json` file
	 *
	 * @return The entry's config struct, or null if it could not be read
	 */
	private any function readEntryConfig( required string path ) {
		try {
			if ( arguments.path.endsWith( ".json" ) ) {
				return jsonDeserialize( fileRead( arguments.path ) )
			}

			var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()
			var instance = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
				.instantiate( arguments.path, context )
			return instance.configure()
		} catch ( any e ) {
			return null
		}
	}

	/**
	 * @path A filesystem path
	 *
	 * @return The path with any trailing slash(es) stripped
	 */
	private string function normalizePath( required string path ) {
		return arguments.path.reReplace( "[\/]+$", "" )
	}

	/**
	 * @value A raw string to embed inside a generated double-quoted BoxLang string literal
	 *
	 * @return value with `"` doubled and `#` doubled, so it round-trips as a literal, not an interpolation
	 */
	private string function bxLiteral( required string value ) {
		return arguments.value.replace( '"', '""', "all" ).replace( "##", "####", "all" )
	}

}
