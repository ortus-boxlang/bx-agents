/**
 * Scaffolds a new BX Agents project skeleton - the `new` CLI verb's real
 * implementation (M12): a minimal `Agent.bx` + `instructions.md`, plus every
 * empty convention folder (`tools/`, `skills/`, `subagents/`, `gateways/`,
 * `schedules/`, `mcp/`, `interceptors/`, `models/`, `modules/`) so a user has
 * a working starting point to edit immediately.
 *
 * Also scaffolds a ready-to-run `tests/` folder (M15 - inspired by the
 * `coldbox-templates/boxlang` template's own dedicated `tests/` + `box.json`
 * folder, adapted to BX Agents' own simpler testing story: agent BEHAVIOR,
 * not HTTP routing, so no Application.bx/VirtualApp needed here at all):
 * `tests/box.json` (a `testbox` devDependency, installed via `box install`
 * inside `tests/`) and `tests/specs/AgentSpec.bx` (one example spec
 * extending `BaseAgentSpec`, passing out of the box against the scaffolded
 * `test()` environment override below).
 *
 * Also supports 5 built-in `--template=` starters (`new`'s `--template` option,
 * default `minimal`), each layering a small amount of pre-wired content on top
 * of the same base skeleton above: `webui-chat` (a `gateways/webui.bx` chat UI
 * exposure), `slack-bot` (a `gateways/slack.bx` channel adapter + matching
 * `.env` stub lines), `mcp-server` (an example `mcp/*.bx` tool exposed via a
 * `gateways/*.bx` `exposes: "mcp"` entry), and `scheduled` (a real hand-written
 * `schedules/Scheduler.bx` calling the scaffolded agent on a timer). Every
 * template's extra content reuses a config shape `ProjectValidator.bx` already
 * accepts (webui exposure, Slack's required env-var keys, mcp exposure+target,
 * a real Scheduler.bx) - no validator changes are needed for any of them.
 *
 * Also scaffolds a `.env` declaring `BOXLANG_HOME=.build/runtime` (mirroring
 * `ortus-boxlang/bx-ai-intro`'s own `.env`/`BOXLANG_HOME` convention, and the
 * exact same `.build/runtime` path `serve`'s own `serverHome` already uses -
 * see `Serve.bx`) - confirmed empirically against the real BoxLang runtime
 * jar (not just documentation) that `BOXLANG_HOME` is a genuine environment
 * variable read by `BoxRunner` itself, before `BoxRuntime` initializes, for
 * EVERY invocation - not just `serve`'s own separately-spawned miniserver
 * process. Whether this actually reaches `chat`/`build`/`test`/`invoke`
 * depends on whether the BoxLang CLI installation in use loads `.env` from
 * the project directory automatically (confirmed this is NOT something the
 * raw runtime jar does itself - a `.env` sitting unexported in the working
 * directory has no effect - so this may depend on a wrapper/BVM-level
 * feature this project doesn't control) - see docs/known-limitations.md.
 * A `.gitignore` is scaffolded alongside it (`.env` may later hold real
 * provider API keys, and `.build`/`dist` are pure build output).
 */
class {

	property name="modelSlugParser";

	/**
	 * @return this
	 */
	function init() {
		// "@bxagents" suffix, not a bare "ModelSlugParser" reference - see
		// BuildPipeline.bx's init() docblock for why.
		variables.modelSlugParser = new "models.build.ModelSlugParser@bxagents"()
		return this
	}

	/**
	 * The 5 built-in `--template=` names `applyTemplate()` accepts.
	 */
	static {
		TEMPLATES = [ "minimal", "webui-chat", "slack-bot", "mcp-server", "scheduled" ]
	}

	/**
	 * @targetDir Absolute path to the new project directory (created if missing; refuses to run if it already contains an Agent.bx)
	 * @name The agent's name
	 * @model The agent's provider/model slug, e.g. "openai/gpt-5"
	 * @description Optional agent description
	 * @template One of TEMPLATES - "minimal" (the bare skeleton) unless the caller asks for one of the other 4 starters
	 *
	 * @return { projectRoot, agentBx, instructions, testsBoxJson, agentSpec, template }
	 */
	struct function scaffold( required string targetDir, required string name, required string model, string description = "", string template = "minimal" ) {
		if ( !static.TEMPLATES.contains( arguments.template ) ) {
			throw(
				type    = "BxAgents.UnknownTemplate",
				message = "Unknown --template [#arguments.template#] - must be one of: #static.TEMPLATES.toList()#"
			)
		}

		var dir = arguments.targetDir.reReplace( "[\/]+$", "" )

		if ( fileExists( dir & "/Agent.bx" ) ) {
			throw(
				type    = "BxAgents.ProjectAlreadyExists",
				message = "[#dir#] already contains an Agent.bx - refusing to overwrite an existing project"
			)
		}

		directoryCreate( path = dir, createPath = true, ignoreExists = true )

		var agentBxPath = dir & "/Agent.bx"
		var instructionsPath = dir & "/instructions.md"

		fileWrite( agentBxPath, renderAgentBx( arguments.name, arguments.model, arguments.description ) )
		fileWrite( instructionsPath, renderInstructions( arguments.name ) )

		var conventionFolders = [ "tools", "skills", "subagents", "gateways", "schedules", "mcp", "interceptors", "models", "modules" ]
		for ( var folder in conventionFolders ) {
			directoryCreate( path = dir & "/" & folder, createPath = true, ignoreExists = true )
		}

		directoryCreate( path = dir & "/tests/specs", createPath = true, ignoreExists = true )
		var testsBoxJsonPath = dir & "/tests/box.json"
		var agentSpecPath = dir & "/tests/specs/AgentSpec.bx"
		fileWrite( testsBoxJsonPath, renderTestsBoxJson( arguments.name ) )
		fileWrite( agentSpecPath, renderAgentSpec( arguments.name ) )

		var envPath = dir & "/.env"
		var gitignorePath = dir & "/.gitignore"
		if ( !fileExists( envPath ) ) {
			fileWrite( envPath, renderEnv() )
		}
		if ( !fileExists( gitignorePath ) ) {
			fileWrite( gitignorePath, renderGitignore() )
		}

		applyTemplate( arguments.template, dir, arguments.name )

		return {
			projectRoot  : dir,
			agentBx      : agentBxPath,
			instructions : instructionsPath,
			testsBoxJson : testsBoxJsonPath,
			agentSpec    : agentSpecPath,
			env          : envPath,
			gitignore    : gitignorePath,
			template     : arguments.template
		}
	}

	/**
	 * Layers one of the 5 built-in templates' extra content on top of the base
	 * skeleton `scaffold()` always writes first. "minimal" is a no-op - it IS
	 * the base skeleton.
	 *
	 * @template One of TEMPLATES
	 * @dir Absolute path to the project root (trailing slash already stripped)
	 * @name The agent's name - reused so a template's own config (e.g. a Scheduler.bx's getInstance() call) references the correct WireBox binding key
	 */
	private void function applyTemplate( required string template, required string dir, required string name ) {
		switch ( arguments.template ) {
			case "minimal":
				return;
			case "webui-chat":
				fileWrite( arguments.dir & "/gateways/webui.bx", renderWebUiGateway() )
				return;
			case "slack-bot":
				fileWrite( arguments.dir & "/gateways/slack.bx", renderSlackGateway() )
				appendSlackEnvStubs( arguments.dir & "/.env" )
				return;
			case "mcp-server":
				fileWrite( arguments.dir & "/mcp/exampleServer.bx", renderMcpExampleServer() )
				fileWrite( arguments.dir & "/gateways/mcpExpose.bx", renderMcpExposeGateway() )
				return;
			case "scheduled":
				fileWrite( arguments.dir & "/schedules/Scheduler.bx", renderSchedulerBx( arguments.name ) )
				return;
		}
	}

	/**
	 * Renders a CLASS-BASED Agent.bx - it `extends` bx-ai's own `AiAgent`, so it
	 * IS the agent, rather than a plain class whose `configure()` describes one.
	 * Name/description/model are set directly in `init()`'s `super.init(...)`
	 * call; `instructions.md` (scaffolded alongside this file) is picked up
	 * automatically at build time via `withInstructions()` - nothing here needs
	 * to reference it. This is the only shape BX Agents scaffolds: inheriting
	 * from `AiAgent` and adding whatever a project needs directly on the class
	 * (private helpers, overridden methods, tools registered in code) is the
	 * simpler default, and the class is real BoxLang the IDE can introspect,
	 * rather than a config struct describing one.
	 *
	 * @name The agent's name
	 * @model The agent's provider/model slug
	 * @description Optional agent description
	 *
	 * @return The rendered Agent.bx source, including a `test()` environment override pointed at the mock provider
	 */
	private string function renderAgentBx( required string name, required string model, required string description ) {
		var lines = [
			'class extends="bxModules.bxai.models.runnables.AiAgent" {',
			"",
			"	function init() {",
			"		super.init(",
			'			name        : "#bxLiteral( arguments.name )#",',
			'			description : "#bxLiteral( arguments.description )#",',
			"			model       : #renderModelExpression( arguments.model )#",
			"		)",
			"		return this",
			"	}",
			"",
			"	// `bxAgents test` builds against this override by default (see",
			"	// BaseAgentSpec.bx) so a fresh project's tests need no API key or",
			"	// network access - swap the model here to test against a real",
			"	// provider instead.",
			"	function test() {",
			"		return {",
			'			model : "mock/mock-model"',
			"		};",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders a `provider/model` slug as an `aiModel(...)` expression -
	 * `--model` is documented as always a full slug, but a bare known
	 * provider name (no "/") is handled too, matching how a project's own
	 * `Agent.bx` may resolve `model` elsewhere in the build pipeline.
	 *
	 * @modelSlug The `--model` value passed to `new`
	 *
	 * @return A BoxLang `aiModel( ... )` expression string
	 */
	private string function renderModelExpression( required string modelSlug ) {
		if ( arguments.modelSlug.find( "/" ) ) {
			var parsed = variables.modelSlugParser.parse( arguments.modelSlug )
			return 'aiModel( provider : "#bxLiteral( parsed.provider )#", params : { model : "#bxLiteral( parsed.model )#" } )'
		}
		return 'aiModel( provider : "#bxLiteral( arguments.modelSlug )#" )'
	}

	/**
	 * @name The agent's name, used to derive the tests package's own name
	 *
	 * @return The rendered tests/box.json source, declaring a testbox devDependency
	 */
	private string function renderTestsBoxJson( required string name ) {
		var lines = [
			"{",
			'	"name": "#bxLiteral( arguments.name )#-tests",',
			'	"version": "1.0.0",',
			'	"private": true,',
			'	"devDependencies": {',
			'		"testbox": "*"',
			"	},",
			'	"installPaths": {',
			'		"testbox": "testbox/"',
			"	}",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * @name The agent's name, used in the spec's describe() block
	 *
	 * @return The rendered tests/specs/AgentSpec.bx source - one example spec extending BaseAgentSpec
	 */
	private string function renderAgentSpec( required string name ) {
		var lines = [
			'class extends="bxModules.bxagents.models.testing.BaseAgentSpec" {',
			"",
			"	function run() {",
			'		describe( "#bxLiteral( arguments.name )#", function() {',
			"",
			'			it( "responds to a greeting", function() {',
			'				mockResponses( [ "Hello! How can I help you today?" ] )',
			"",
			'				var response = agent.run( "Hi there" )',
			"",
			'				expect( response ).toContainText( "Hello" )',
			"			} )",
			"",
			"		} )",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * @name The agent's name
	 *
	 * @return The rendered instructions.md source
	 */
	private string function renderInstructions( required string name ) {
		var lines = [
			"## #arguments.name#",
			"",
			"You are #arguments.name#, a helpful AI agent.",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * @return The rendered .env source, declaring BOXLANG_HOME (see the class docblock)
	 */
	private string function renderEnv() {
		var lines = [
			"## BoxLang runtime home - keeps this project's compiled-class cache",
			"## and config overrides isolated from every other BX Agents project",
			"## on this machine, instead of silently sharing the default ~/.boxlang.",
			"## Matches the same .build/runtime path `serve` already scopes its own",
			"## server-home to (see docs/known-limitations.md for the exact scope",
			"## of what this does and doesn't reach).",
			"BOXLANG_HOME=.build/runtime",
			"",
			"## Add your own AI provider API keys here too, e.g.:",
			"## OPENAI_API_KEY=sk-...",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * @return The rendered .gitignore source
	 */
	private string function renderGitignore() {
		var lines = [
			".build/",
			"dist/",
			".env",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * @return The rendered gateways/webui.bx source - a "webui-chat" template's chat UI exposure, matching the `{ exposes: "webui", path: "/chat" }` shape ProjectValidator/WebUiGenerator already accept
	 */
	private string function renderWebUiGateway() {
		var lines = [
			"class {",
			"",
			"	function configure() {",
			"		return {",
			'			exposes : "webui",',
			'			path    : "/chat"',
			"		};",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * @return The rendered gateways/slack.bx source - a "slack-bot" template's channel adapter, matching ProjectValidator's REQUIRED_ENV_VAR_KEYS.slack shape (botTokenEnvVar + appTokenEnvVar)
	 */
	private string function renderSlackGateway() {
		var lines = [
			"class {",
			"",
			"	function configure() {",
			"		return {",
			'			type           : "slack",',
			'			botTokenEnvVar : "SLACK_BOT_TOKEN",',
			'			appTokenEnvVar : "SLACK_APP_TOKEN"',
			"		};",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * Appends the `SLACK_BOT_TOKEN`/`SLACK_APP_TOKEN` stub lines `renderSlackGateway()`'s
	 * entry names, to an already-written `.env` (never overwrites an existing
	 * one - only ever called right after `scaffold()`'s own base `.env` write).
	 *
	 * @envPath Absolute path to the project's `.env`
	 */
	private void function appendSlackEnvStubs( required string envPath ) {
		var lines = [
			"",
			"## Slack gateway (gateways/slack.bx) - see https://api.slack.com/apps",
			"SLACK_BOT_TOKEN=xoxb-...",
			"SLACK_APP_TOKEN=xapp-...",
			""
		]
		fileWrite( arguments.envPath, fileRead( arguments.envPath ) & lines.toList( char( 10 ) ) )
	}

	/**
	 * @return The rendered mcp/exampleServer.bx source - a "mcp-server" template's trivial example MCP tool server
	 */
	private string function renderMcpExampleServer() {
		var lines = [
			"class {",
			"",
			"	function configure() {",
			"		return {",
			'			description : "Example MCP tool server",',
			'			version     : "1.0.0"',
			"		};",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * @return The rendered gateways/mcpExpose.bx source - a "mcp-server" template's `exposes: "mcp"` entry targeting exampleServer, matching the `{ exposes, path, target }` shape ProjectValidator already accepts
	 */
	private string function renderMcpExposeGateway() {
		var lines = [
			"class {",
			"",
			"	function configure() {",
			"		return {",
			'			exposes : "mcp",',
			'			path    : "/mcp",',
			'			target  : "exampleServer"',
			"		};",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * Renders a real, hand-written ColdBox scheduler class - a "scheduled"
	 * template's `schedules/Scheduler.bx` (no `{cron, action}` data shape;
	 * that convention is gone - see docs/conventions/schedules.md). Calls the
	 * scaffolded agent by the same `name` its own Agent.bx declares via
	 * `super.init(name: ...)`, so `getInstance()` resolves the correct WireBox
	 * binding key (see ColdBoxAppGenerator.resolveAgentName()).
	 *
	 * @name The agent's name
	 *
	 * @return The rendered schedules/Scheduler.bx source
	 */
	private string function renderSchedulerBx( required string name ) {
		var lines = [
			'class extends="coldbox.system.web.tasks.ColdBoxScheduler" {',
			"",
			"	function configure() {",
			'		task( "example" )',
			'			.call( () => getInstance( "#bxLiteral( arguments.name )#" ).run( "Give me a status update" ) )',
			'			.everyDayAt( "00:00" )',
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	/**
	 * @value A raw string to embed inside a generated double-quoted BoxLang string literal
	 *
	 * @return value with `"` doubled and `#` doubled, so it round-trips as a literal, not an interpolation
	 */
	private string function bxLiteral( required string value ) {
		return arguments.value.replace( '"', '""', "all" ).replace( "##", "####", "all" )
	}

}
