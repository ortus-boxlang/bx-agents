/**
 * Scaffolds a new BX Agents project skeleton - the `new` CLI verb's real
 * implementation (M12): a minimal `Agent.bx` + `instructions.md`, plus every
 * empty convention folder (`tools/`, `skills/`, `subagents/`, `gateways/`,
 * `schedules/`, `mcp/`, `interceptors/`, `models/`, `modules/`) so a user has
 * a working starting point to edit immediately.
 *
 * Also scaffolds a ready-to-run `tests/` folder (M15 - inspired by the
 * `coldbox-templates/boxlang` template's own dedicated `tests/` + `box.json`
 * folder, adapted to BX Agents' own simpler testing story: agent BEHAVIOR,
 * not HTTP routing, so no Application.bx/VirtualApp needed here at all):
 * `tests/box.json` (a `testbox` devDependency, installed via `box install`
 * inside `tests/`) and `tests/specs/AgentSpec.bx` (one example spec
 * extending `BaseAgentSpec`, passing out of the box against the scaffolded
 * `test()` environment override below).
 */
class {

	/**
	 * @targetDir Absolute path to the new project directory (created if missing; refuses to run if it already contains an Agent.bx)
	 * @name The agent's name
	 * @model The agent's provider/model slug, e.g. "openai/gpt-5"
	 * @description Optional agent description
	 */
	struct function scaffold( required string targetDir, required string name, required string model, string description = "" ) {
		var dir = arguments.targetDir.reReplace( "[\/]+$", "" )

		if ( fileExists( dir & "/Agent.bx" ) ) {
			throw(
				type    = "BxAgents.ProjectAlreadyExists",
				message = "[#dir#] already contains an Agent.bx - refusing to overwrite an existing project"
			)
		}

		directoryCreate( path = dir, createPath = true, ignoreExists = true )

		var agentBxPath = dir & "/Agent.bx"
		var instructionsPath = dir & "/instructions.md"

		fileWrite( agentBxPath, renderAgentBx( arguments.name, arguments.model, arguments.description ) )
		fileWrite( instructionsPath, renderInstructions( arguments.name ) )

		var conventionFolders = [ "tools", "skills", "subagents", "gateways", "schedules", "mcp", "interceptors", "models", "modules" ]
		for ( var folder in conventionFolders ) {
			directoryCreate( path = dir & "/" & folder, createPath = true, ignoreExists = true )
		}

		directoryCreate( path = dir & "/tests/specs", createPath = true, ignoreExists = true )
		var testsBoxJsonPath = dir & "/tests/box.json"
		var agentSpecPath = dir & "/tests/specs/AgentSpec.bx"
		fileWrite( testsBoxJsonPath, renderTestsBoxJson( arguments.name ) )
		fileWrite( agentSpecPath, renderAgentSpec( arguments.name ) )

		return {
			projectRoot  : dir,
			agentBx      : agentBxPath,
			instructions : instructionsPath,
			testsBoxJson : testsBoxJsonPath,
			agentSpec    : agentSpecPath
		}
	}

	private string function renderAgentBx( required string name, required string model, required string description ) {
		var lines = [
			"class {",
			"",
			"	function configure() {",
			"		return {",
			'			name        : "#bxLiteral( arguments.name )#",',
			'			model       : "#bxLiteral( arguments.model )#",',
			'			description : "#bxLiteral( arguments.description )#"',
			"		};",
			"	}",
			"",
			"	// `bxAgents test` builds against this override by default (see",
			"	// BaseAgentSpec.bx) so a fresh project's tests need no API key or",
			"	// network access - swap the model here to test against a real",
			"	// provider instead.",
			"	function test() {",
			"		return {",
			'			model : "mock/mock-model"',
			"		};",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	private string function renderTestsBoxJson( required string name ) {
		var lines = [
			"{",
			'	"name": "#bxLiteral( arguments.name )#-tests",',
			'	"version": "1.0.0",',
			'	"private": true,',
			'	"devDependencies": {',
			'		"testbox": "*"',
			"	},",
			'	"installPaths": {',
			'		"testbox": "testbox/"',
			"	}",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	private string function renderAgentSpec( required string name ) {
		var lines = [
			'class extends="bxModules.bxagents.models.testing.BaseAgentSpec" {',
			"",
			"	function run() {",
			'		describe( "#bxLiteral( arguments.name )#", function() {',
			"",
			'			it( "responds to a greeting", function() {',
			'				mockResponses( [ "Hello! How can I help you today?" ] )',
			"",
			'				var response = agent.run( "Hi there" )',
			"",
			'				expect( response ).toContainText( "Hello" )',
			"			} )",
			"",
			"		} )",
			"	}",
			"",
			"}",
			""
		]
		return lines.toList( char( 10 ) )
	}

	private string function renderInstructions( required string name ) {
		var lines = [
			"## #arguments.name#",
			"",
			"You are #arguments.name#, a helpful AI agent.",
			""
		]
		return lines.toList( char( 10 ) )
	}

	private string function bxLiteral( required string value ) {
		return arguments.value.replace( '"', '""', "all" ).replace( "##", "####", "all" )
	}

}
