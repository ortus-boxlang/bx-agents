/**
 * Validates a BX Agents project's discovered source (Build Pipeline Phase 3).
 *
 * Runs every validator (never fail-fast) and returns `{ errors: [], warnings: [] }`.
 * Errors block the build; warnings do not. No network calls are ever made here
 * (e.g. remote MCP server reachability is out of scope - bx-ai resolves that
 * live, at runtime).
 */
class {

	property name="modelSlugParser";

	/**
	 * @return this
	 */
	function init() {
		// "@bxagents" suffix, not a bare "ModelSlugParser" reference - see
		// BuildPipeline.bx's init() docblock for why. CORE_PROVIDERS itself
		// lives on ModelSlugParser now (single source of truth shared with
		// ColdBoxAppGenerator's generation-time model resolution).
		variables.modelSlugParser = new "models.build.ModelSlugParser@bxagents"()
		return this
	}

	/**
	 * Validate a project's discovered source against its resolved configuration.
	 *
	 * @projectRoot Absolute path to the project root
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover()
	 * @resolvedConfig The resolved config struct from AgentConfigResolver.resolve()
	 *
	 * @return { errors: [], warnings: [] } - a non-empty errors array means the build must not proceed
	 */
	struct function validate( required string projectRoot, required struct discovery, required struct resolvedConfig ) {
		var errors = []
		var warnings = []

		validateDuplicateNames( arguments.discovery, errors )
		validateSubagents( arguments.projectRoot, arguments.discovery, errors )
		validateModules( arguments.projectRoot, arguments.discovery, errors )
		validateSchedules( arguments.projectRoot, arguments.discovery, warnings )
		validateGateways( arguments.discovery, errors )
		validateGatewaySession( arguments.resolvedConfig, errors )
		validateMcpServers( arguments.resolvedConfig, errors )
		validateModelProvider( arguments.resolvedConfig, arguments.discovery, errors )

		return { errors : errors, warnings : warnings }
	}

	// --------------------------------------------------------------------------
	// Duplicate names
	// --------------------------------------------------------------------------

	/**
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover()
	 * @errors Accumulator array - append() any validation errors found
	 */
	private void function validateDuplicateNames( required struct discovery, required array errors ) {
		for ( var category in [ "tools", "skills", "models", "subagents" ] ) {
			var entries = arguments.discovery[ category ] ?: []
			for ( var dup in findDuplicateNames( entries ) ) {
				arguments.errors.append( "Duplicate name [#dup#] found in #category#/" )
			}
		}
	}

	/**
	 * @entries A discovery category's entry array (each with a `name`)
	 *
	 * @return The distinct `name` values that appear more than once
	 */
	private array function findDuplicateNames( required array entries ) {
		var seen = {}
		var duplicates = []
		for ( var entry in arguments.entries ) {
			if ( structKeyExists( seen, entry.name ) ) {
				if ( !duplicates.contains( entry.name ) ) {
					duplicates.append( entry.name )
				}
			} else {
				seen[ entry.name ] = true
			}
		}
		return duplicates
	}

	// --------------------------------------------------------------------------
	// Circular subagent detection
	// --------------------------------------------------------------------------

	/**
	 * Validates every subagent's own model, checks for unknown subagent
	 * references (including the ROOT project's own `subAgents` list, not
	 * just nested subagents), detects circular subagent references, and
	 * checks that every node's own DECLARED agent name (root + every
	 * subagent) is unique across the whole tree.
	 *
	 * That last check matters now in a way it didn't before: `name` doubles
	 * as a `config/WireBox.bx` binding key (see `ColdBoxAppGenerator.
	 * renderWireBox()`), so two nodes sharing a name - including two that
	 * both leave it unset and silently share the "BxAi" default - would
	 * collide as a WireBox mapping (the second `map()` call for the same
	 * key wins, silently shadowing the first) rather than fail loudly.
	 * Reuses `ColdBoxAppGenerator.resolveAgentName()` for the "no name set"
	 * default rather than a second, independently-drifting copy of it.
	 *
	 * @projectRoot Absolute path to the project root
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover()
	 * @errors Accumulator array - append() any validation errors found
	 */
	private void function validateSubagents( required string projectRoot, required struct discovery, required array errors ) {
		var subagents = arguments.discovery.subagents ?: []
		// "@bxagents" suffix, not a bare "AgentConfigResolver" reference - see
		// BuildPipeline.bx's init() docblock for why.
		var resolver = new "models.build.AgentConfigResolver@bxagents"()
		var coldboxAppGenerator = new "models.build.generators.ColdBoxAppGenerator@bxagents"()
		var graph = {}
		var nameOwners = {}

		for ( var subagent in subagents ) {
			var agentBxPath = subagent.path & "/Agent.bx"
			if ( !fileExists( agentBxPath ) ) {
				arguments.errors.append( "Subagent [#subagent.name#] is missing its Agent.bx descriptor" )
				graph[ subagent.name ] = []
				continue
			}

			try {
				var config = resolver.resolve( projectRoot = subagent.path )
				graph[ subagent.name ] = config.subAgents ?: []
				validateModelProvider( config, arguments.discovery, arguments.errors, "Subagent [#subagent.name#]'s Agent.bx" )
				recordNameOwner( nameOwners, coldboxAppGenerator.resolveAgentName( config ), "Subagent [#subagent.name#]" )
			} catch ( any e ) {
				arguments.errors.append( "Subagent [#subagent.name#] failed to load: #e.message#" )
				graph[ subagent.name ] = []
			}
		}

		// Root-level subAgents declared directly on the project's own Agent.bx
		var rootProjectAgentBx = arguments.projectRoot & "/Agent.bx"
		var rootSubAgents = []
		if ( fileExists( rootProjectAgentBx ) ) {
			try {
				var rootConfig = resolver.resolve( projectRoot = arguments.projectRoot )
				rootSubAgents = rootConfig.subAgents ?: []
				recordNameOwner( nameOwners, coldboxAppGenerator.resolveAgentName( rootConfig ), "The project's own Agent.bx" )
			} catch ( any e ) {
				// Already surfaced elsewhere (config resolution failures are not this validator's job)
			}
		}
		graph[ "__root__" ] = rootSubAgents

		for ( var nodeName in graph ) {
			for ( var refName in graph[ nodeName ] ) {
				if ( !structKeyExists( graph, refName ) ) {
					var source = nodeName == "__root__" ? "The project's own Agent.bx" : "Subagent [#nodeName#]"
					arguments.errors.append( "#source# references unknown subagent [#refName#]" )
				}
			}
		}

		for ( var cyclePath in detectCycles( graph ) ) {
			arguments.errors.append( "Circular subagent reference detected: #cyclePath#" )
		}

		for ( var name in nameOwners ) {
			if ( nameOwners[ name ].len() > 1 ) {
				arguments.errors.append( "Agent name [#name#] is declared by more than one Agent.bx (#nameOwners[ name ].toList( ", " )#) - each agent's name must be unique across the whole project, since it also becomes its config/WireBox.bx binding key" )
			}
		}
	}

	/**
	 * @nameOwners Accumulator struct of { declaredName : [ sourceLabels ] } - mutated in place
	 * @name A node's own declared agent name
	 * @sourceLabel A human-readable label for the node that declared it, e.g. "Subagent [billing]"
	 */
	private void function recordNameOwner( required struct nameOwners, required string name, required string sourceLabel ) {
		if ( !structKeyExists( arguments.nameOwners, arguments.name ) ) {
			arguments.nameOwners[ arguments.name ] = []
		}
		arguments.nameOwners[ arguments.name ].append( arguments.sourceLabel )
	}

	// --------------------------------------------------------------------------
	// Module dependency validation (same missing/cycle rules as subagents)
	// --------------------------------------------------------------------------

	/**
	 * Checks each `modules/*` entry's own `module.json` `dependsOn` list for
	 * unknown module references and circular dependencies (same rules as
	 * validateSubagents()'s graph checks).
	 *
	 * @projectRoot Absolute path to the project root
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover()
	 * @errors Accumulator array - append() any validation errors found
	 */
	private void function validateModules( required string projectRoot, required struct discovery, required array errors ) {
		var modules = arguments.discovery.modules ?: []
		var graph = {}

		for ( var mod in modules ) {
			var manifestPath = mod.path & "/module.json"
			var dependsOn = []
			if ( fileExists( manifestPath ) ) {
				try {
					var manifest = jsonDeserialize( fileRead( manifestPath ) )
					dependsOn = manifest.dependsOn ?: []
				} catch ( any e ) {
					arguments.errors.append( "Module [#mod.name#]'s module.json is not valid JSON: #e.message#" )
				}
			}
			graph[ mod.name ] = dependsOn
		}

		for ( var nodeName in graph ) {
			for ( var refName in graph[ nodeName ] ) {
				if ( !structKeyExists( graph, refName ) ) {
					arguments.errors.append( "Module [#nodeName#] depends on unknown module [#refName#]" )
				}
			}
		}

		for ( var cyclePath in detectCycles( graph ) ) {
			arguments.errors.append( "Circular module dependency detected: #cyclePath#" )
		}
	}

	/**
	 * Detects cycles in a directed graph using DFS + a recursion stack.
	 *
	 * @graph A struct of { nodeName: [ referencedNodeNames ] }
	 *
	 * @return An array of human-readable cycle path strings (e.g. "a -> b -> a"), one per cycle found
	 */
	private array function detectCycles( required struct graph ) {
		var visited = {}
		var cycles = []

		for ( var startNode in arguments.graph ) {
			if ( !structKeyExists( visited, startNode ) ) {
				walkForCycles( startNode, arguments.graph, visited, {}, [], cycles )
			}
		}

		return cycles
	}

	/**
	 * DFS helper for detectCycles() - visits `node`, recursing into its
	 * references, and records a cycle path whenever it revisits a node
	 * currently on the recursion stack.
	 *
	 * @node The node currently being visited
	 * @graph The full graph being walked
	 * @visited Struct of node name -> true, for nodes visited at all (across the whole detectCycles() call)
	 * @onStack Struct of node name -> boolean, for nodes on the CURRENT recursion path
	 * @path The ordered list of nodes visited to reach `node`, this call
	 * @cycles Accumulator array - append() a human-readable cycle path string whenever one is found
	 */
	private void function walkForCycles(
		required string node,
		required struct graph,
		required struct visited,
		required struct onStack,
		required array path,
		required array cycles
	) {
		arguments.visited[ arguments.node ] = true
		arguments.onStack[ arguments.node ] = true
		var currentPath = duplicate( arguments.path )
		currentPath.append( arguments.node )

		for ( var refName in ( arguments.graph[ arguments.node ] ?: [] ) ) {
			if ( !structKeyExists( arguments.graph, refName ) ) {
				// Unknown reference already reported by the caller
				continue
			}
			if ( structKeyExists( arguments.onStack, refName ) && arguments.onStack[ refName ] ) {
				var cycleStart = currentPath.find( refName )
				var cycleNodes = currentPath.slice( cycleStart )
				cycleNodes.append( refName )
				arguments.cycles.append( cycleNodes.toList( " -> " ) )
			} else if ( !structKeyExists( arguments.visited, refName ) ) {
				walkForCycles( refName, arguments.graph, arguments.visited, arguments.onStack, currentPath, arguments.cycles )
			}
		}

		arguments.onStack[ arguments.node ] = false
	}

	// --------------------------------------------------------------------------
	// Schedules
	// --------------------------------------------------------------------------

	/**
	 * `schedules/Scheduler.bx` is real, hand-written ColdBox code passed
	 * through into the build untouched (see SchedulerGenerator) - there's no
	 * `{cron, action}` data shape left to validate. The one thing worth
	 * catching here: a `schedules/` folder that exists but has no
	 * `Scheduler.bx` in it (e.g. a leftover file from before this project
	 * moved off its old `{cron, action}` convention) is silently ignored by
	 * discovery - `hasScheduler` is simply false, and no error surfaces
	 * anywhere else. Warn here instead, so a schedule that quietly stopped
	 * running is at least visible at build time.
	 *
	 * @projectRoot Absolute path to the project root
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover()
	 * @warnings Accumulator array - append() any validation warnings found
	 */
	private void function validateSchedules( required string projectRoot, required struct discovery, required array warnings ) {
		var schedulesDir = arguments.projectRoot & "/schedules"
		if ( arguments.discovery.hasScheduler ?: false ) {
			return
		}

		if ( directoryExists( schedulesDir ) && directoryList( schedulesDir, false, "query" ).recordCount > 0 ) {
			arguments.warnings.append( "schedules/ exists but has no Scheduler.bx - it's ignored. Add a schedules/Scheduler.bx (a real ColdBox scheduler class) - see docs/conventions/schedules.md" )
		}
	}

	// --------------------------------------------------------------------------
	// Gateways (two entry kinds - see M8 design notes)
	// --------------------------------------------------------------------------

	/**
	 * Push-style channel-adapter type -> its own required `*EnvVar` option
	 * keys, checked by validateGateways() below. Data-driven so adding a 7th
	 * push-style gateway is one map entry, not new branching logic - the
	 * core `http` type keeps its own inline check since it predates this map
	 * and reports a more specific message.
	 */
	static {
		REQUIRED_ENV_VAR_KEYS = {
			telegram: [ "botTokenEnvVar" ],
			slack   : [ "botTokenEnvVar", "appTokenEnvVar" ],
			discord : [ "botTokenEnvVar" ],
			email   : [ "imapHostEnvVar", "imapUsernameEnvVar", "imapPasswordEnvVar", "fromAddressEnvVar" ],
			"whatsapp-cloud": [ "accessTokenEnvVar", "phoneNumberIdEnvVar", "appSecretEnvVar", "verifyTokenEnvVar" ],
			teams   : [ "appIdEnvVar", "appPasswordEnvVar" ],
			twilio  : [ "accountSidEnvVar", "authTokenEnvVar", "fromEnvVar" ],
			github  : [ "tokenEnvVar", "webhookSecretEnvVar", "botNameEnvVar" ],
			signal  : [ "accountEnvVar" ]
		}
	}

	/**
	 * Validates both `gateways/*` entry kinds: exposure entries (`exposes:
	 * "agent"|"mcp"|"webui"`, unique `path`) and channel-adapter entries (`type`,
	 * unique `name`, `secretEnvVar` required for `http`, and each push-style
	 * type's own required `*EnvVar` keys per REQUIRED_ENV_VAR_KEYS).
	 *
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover()
	 * @errors Accumulator array - append() any validation errors found
	 */
	private void function validateGateways( required struct discovery, required array errors ) {
		var seenPaths = {}
		var seenNames = {}
		var validGatewayTypes = [ "mock", "cli", "http" ]
		for ( var pushType in static.REQUIRED_ENV_VAR_KEYS.keyArray() ) {
			validGatewayTypes.append( pushType )
		}

		// Usernames are global to the project, not per entry: two entries
		// claiming the same one would race at seed time and the later boot order
		// would silently decide whose password wins.
		var seenUsernames = {}

		for ( var gateway in ( arguments.discovery.gateways ?: [] ) ) {
			var config = readEntryConfig( gateway.path )
			if ( isNull( config ) ) {
				arguments.errors.append( "Gateway [#gateway.name#] could not be read" )
				continue
			}

			if ( structKeyExists( config, "exposes" ) ) {
				// Exposure entry: exposes an agent (raw HTTP or the web chat UI) or an MCP server
				if ( ![ "agent", "mcp", "webui" ].contains( config.exposes ) ) {
					arguments.errors.append( "Gateway [#gateway.name#] has an invalid 'exposes' value [#config.exposes#] - must be 'agent', 'mcp', or 'webui'" )
				}

				var path = config.path ?: ""
				if ( !len( path ) ) {
					arguments.errors.append( "Gateway [#gateway.name#] is missing a 'path'" )
				} else if ( structKeyExists( seenPaths, path ) ) {
					arguments.errors.append( "Duplicate gateway exposure path [#path#]" )
				} else {
					seenPaths[ path ] = true
				}

				// "agent" and "webui" exposure always target the project's single
				// root agent, so no "target" is needed (webui's own optional
				// apiKeyEnvVar is just a plain *EnvVar name, same non-required
				// shape as every other gateway's optional overrides - no
				// dedicated check beyond 'path' above). "mcp" exposure must name
				// WHICH local mcp/* server to expose, since a project can
				// declare more than one.
				if ( config.exposes == "mcp" ) {
					var target = config.target ?: ""
					var mcpNames = ( arguments.discovery.mcp ?: [] ).map( m => m.name )
					if ( !len( target ) ) {
						arguments.errors.append( "Gateway [#gateway.name#] exposes 'mcp' but is missing a 'target'" )
					} else if ( !mcpNames.contains( target ) ) {
						arguments.errors.append( "Gateway [#gateway.name#] targets unknown mcp server [#target#]" )
					}
				}

				if ( config.exposes == "webui" ) {
					validateWebUiTheme( gateway.name, config.theme ?: {}, arguments.errors )
					validateWebUiDatabase( gateway.name, config.database ?: {}, arguments.errors )
					validateWebUiUsers( gateway.name, config.users ?: [], arguments.errors, seenUsernames )
				}
			} else {
				// Channel-adapter entry: a bx-ai IGateway (mock/cli/http) registered by name
				if ( structKeyExists( seenNames, gateway.name ) ) {
					arguments.errors.append( "Duplicate gateway name [#gateway.name#]" )
				} else {
					seenNames[ gateway.name ] = true
				}

				var type = config.type ?: ""
				if ( !validGatewayTypes.contains( type ) ) {
					arguments.errors.append( "Gateway [#gateway.name#] has an unknown type [#type#] - must be one of: #validGatewayTypes.toList()#" )
				} else if ( type == "http" && !len( config.secretEnvVar ?: "" ) ) {
					arguments.errors.append( "Gateway [#gateway.name#] is of type 'http' and requires a 'secretEnvVar' (the NAME of an environment variable holding the signing secret, never the secret value itself)" )
				} else if ( static.REQUIRED_ENV_VAR_KEYS.keyExists( type ) ) {
					for ( var requiredKey in static.REQUIRED_ENV_VAR_KEYS[ type ] ) {
						if ( !len( config[ requiredKey ] ?: "" ) ) {
							arguments.errors.append( "Gateway [#gateway.name#] is of type '#type#' and requires a '#requiredKey#' (the NAME of an environment variable, never the secret value itself)" )
						}
					}
				}
			}
		}
	}

	/**
	 * Validates a `webui` entry's optional `theme` block: every key must name a
	 * real design token, so a typo (`accentColor` instead of `accent`) fails the
	 * build rather than silently rendering the default and leaving someone to
	 * wonder why their brand color never showed up.
	 *
	 * The token list is duplicated from WebUiGenerator.themeTokenMap() rather
	 * than shared, matching this codebase's per-generator self-containment
	 * convention - that method is the source of truth; keep the two in step.
	 *
	 * @gatewayName The gateways/* entry name, for the error message
	 * @theme The entry's `theme` config value (may be any type - callers pass it unchecked)
	 * @errors Accumulator array - append() any validation errors found
	 */
	/**
	 * Validates a `webui` entry's optional `database` block. Both keys are
	 * optional (the defaults - datasource "bxagents", path "./data/chat.db" -
	 * mean a project configures nothing), but a key that IS set has to be
	 * usable, and both feed straight into generated source.
	 *
	 * `datasource` becomes a ColdBox datasource name and a qb settings value,
	 * so it is restricted to word characters. `path` becomes the argument to
	 * expandPath() in Application.bx - an absolute path there silently escapes
	 * the app directory, which breaks a packaged .bxa deploy, so it must stay
	 * relative.
	 *
	 * @gatewayName The gateways/* entry name, for the error message
	 * @database The entry's `database` config value (may be any type - callers pass it unchecked)
	 * @errors Accumulator array - append() any validation errors found
	 */
	/**
	 * Validates a `webui` entry's optional `users` block - the accounts allowed
	 * to sign in.
	 *
	 * A password is NEVER written here. An entry names the environment variable
	 * holding it (`passwordEnvVar`), or carries an already-hashed value
	 * (`passwordHash`), which is safe to commit precisely because it cannot be
	 * reversed. A literal `password` key is rejected outright rather than
	 * ignored: silently dropping it would leave someone believing they had set
	 * a password when they had only committed one.
	 *
	 * @gatewayName The gateways/* entry name, for the error message
	 * @users The entry's `users` config value (may be any type - callers pass it unchecked)
	 * @errors Accumulator array - append() any validation errors found
	 * @seen Struct of usernames already claimed, mutated as they are seen
	 */
	private void function validateWebUiUsers( required string gatewayName, required any users, required array errors, required struct seen ) {
		if ( !isArray( arguments.users ) ) {
			if ( isStruct( arguments.users ) || isSimpleValue( arguments.users ) ) {
				arguments.errors.append( "Gateway [#arguments.gatewayName#] has a 'users' value that is not an array - it must be a list of { username, passwordEnvVar | passwordHash } structs" )
			}
			return
		}

		for ( var user in arguments.users ) {
			if ( !isStruct( user ) ) {
				arguments.errors.append( "Gateway [#arguments.gatewayName#] has a 'users' entry that is not a struct - each user needs at least { username, passwordEnvVar }" )
				continue
			}

			var username = user.username ?: ""
			if ( !len( username ) ) {
				arguments.errors.append( "Gateway [#arguments.gatewayName#] has a 'users' entry with no 'username'" )
				continue
			}

			var key = lCase( username )
			if ( arguments.seen.keyExists( key ) ) {
				arguments.errors.append( "Gateway [#arguments.gatewayName#] declares the username [#username#] more than once in this project - usernames must be unique across every webui entry" )
			}
			arguments.seen[ key ] = true

			if ( structKeyExists( user, "password" ) ) {
				arguments.errors.append( "Gateway [#arguments.gatewayName#] user [#username#] sets a literal 'password' - never commit a password. Use 'passwordEnvVar' to name an environment variable holding it, or 'passwordHash' for an already-hashed value" )
			}

			var hasEnvVar = len( user.passwordEnvVar ?: "" )
			var hasHash = len( user.passwordHash ?: "" )

			if ( !hasEnvVar && !hasHash ) {
				arguments.errors.append( "Gateway [#arguments.gatewayName#] user [#username#] needs either a 'passwordEnvVar' (the NAME of an environment variable) or a 'passwordHash'" )
			}
			if ( hasEnvVar && hasHash ) {
				arguments.errors.append( "Gateway [#arguments.gatewayName#] user [#username#] sets both 'passwordEnvVar' and 'passwordHash' - pick one, so which wins is never ambiguous" )
			}
			if ( hasHash && !( user.passwordHash ).startsWith( "pbkdf2$" ) ) {
				arguments.errors.append( "Gateway [#arguments.gatewayName#] user [#username#] has a 'passwordHash' that is not in this project's format - it must look like pbkdf2$<iterations>$<salt>$<hash>" )
			}
		}
	}

	/**
	 * Validates a `webui` entry's optional `database` block - where the
	 * generated app's chat history is persisted.
	 *
	 * Rejects unknown keys, a `datasource` that isn't a valid ColdBox
	 * datasource name, and a `path` that is either absolute or walks outside
	 * the app root with `..` - the generated app resolves `path` with
	 * expandPath(), so it must stay relative and contained.
	 *
	 * @gatewayName The gateways/* entry name, for the error message
	 * @database The entry's `database` config value (may be any type - callers pass it unchecked)
	 * @errors Accumulator array - append() any validation errors found
	 */
	private void function validateWebUiDatabase( required string gatewayName, required any database, required array errors ) {
		if ( !isStruct( arguments.database ) || arguments.database.isEmpty() ) {
			return
		}

		var validKeys = [ "datasource", "path" ]
		for ( var key in arguments.database ) {
			if ( !validKeys.contains( key ) ) {
				arguments.errors.append( "Gateway [#arguments.gatewayName#] has an unknown 'database' key [#key#] - valid keys: #validKeys.toList( ", " )#" )
			}
		}

		var datasource = arguments.database.datasource ?: ""
		if ( len( datasource ) && !reFind( "^[A-Za-z][A-Za-z0-9_]*$", datasource ) ) {
			arguments.errors.append( "Gateway [#arguments.gatewayName#] has an invalid 'database.datasource' [#datasource#] - it names a ColdBox datasource, so it must start with a letter and contain only letters, digits or underscores" )
		}

		var dbPath = arguments.database.path ?: ""
		if ( len( dbPath ) && ( dbPath.startsWith( "/" ) || reFind( "^[A-Za-z]:", dbPath ) ) ) {
			arguments.errors.append( "Gateway [#arguments.gatewayName#] has an absolute 'database.path' [#dbPath#] - it is resolved with expandPath() inside the generated app, so it must be relative to the app root (e.g. ""./data/chat.db"")" )
		}
		// A relative path can escape the app directory just as effectively as an
		// absolute one - "../../var/chat.db" is exactly the case the absolute
		// check exists to stop, and slipped straight past it. Checked on both
		// separators, since the value is written into generated source that may
		// be built on one platform and run on another.
		if ( len( dbPath ) && ( dbPath.listToArray( "/\\" ).contains( ".." ) ) ) {
			arguments.errors.append( "Gateway [#arguments.gatewayName#] has a 'database.path' [#dbPath#] that walks outside the app with '..' - it is resolved with expandPath() inside the generated app, so it must stay within the app root (e.g. ""./data/chat.db"")" )
		}
	}

	/**
	 * Validates a `webui` entry's optional `theme` block - the CSS token
	 * overrides applied to the generated chat UI.
	 *
	 * Every top-level key must be a known theme token, except `dark`, which
	 * nests a light/dark-mode override struct whose own keys are checked
	 * against the same set of valid tokens.
	 *
	 * @gatewayName The gateways/* entry name, for the error message
	 * @theme The entry's `theme` config value (may be any type - callers pass it unchecked)
	 * @errors Accumulator array - append() any validation errors found
	 */
	private void function validateWebUiTheme( required string gatewayName, required any theme, required array errors ) {
		if ( !isStruct( arguments.theme ) || arguments.theme.isEmpty() ) {
			return
		}

		var validTokens = [
			"accent", "accentFg", "bg", "fg", "muted", "border", "surface", "inputBg",
			"bubbleUser", "bubbleUserFg", "bubbleAssistant", "bubbleAssistantFg", "bubbleError",
			"reasoningFg", "reasoningBg", "toolFg", "toolBg",
			"radius", "radiusSm", "font", "fontMono", "fontSize", "maxWidth"
		]

		for ( var key in arguments.theme ) {
			// `dark` is the nested dark-mode override block, not a token itself
			if ( key == "dark" ) {
				if ( !isStruct( arguments.theme.dark ) ) {
					arguments.errors.append( "Gateway [#arguments.gatewayName#] has a 'theme.dark' that is not a struct - it holds dark-mode token overrides" )
					continue
				}
				for ( var darkKey in arguments.theme.dark ) {
					if ( !validTokens.contains( darkKey ) ) {
						arguments.errors.append( "Gateway [#arguments.gatewayName#] has an unknown theme token [theme.dark.#darkKey#] - valid tokens: #validTokens.toList( ", " )#" )
					}
				}
				continue
			}

			if ( !validTokens.contains( key ) ) {
				arguments.errors.append( "Gateway [#arguments.gatewayName#] has an unknown theme token [theme.#key#] - valid tokens: #validTokens.toList( ", " )#" )
			}
		}
	}

	// --------------------------------------------------------------------------
	// Gateway session (single project-wide GatewaySession, bundling every
	// push-style gateway - see GatewayGenerator.renderSessionInterceptor())
	// --------------------------------------------------------------------------

	/**
	 * Validates the optional `gatewaySession: { policy, maxQueueDepth }` block
	 * on the root Agent.bx's configure() return struct, mirroring bx-ai's own
	 * GatewaySession.VALID_POLICIES exactly, so a bad value fails loudly at
	 * `build` time instead of surfacing as a GatewaySessionInvalidPolicy
	 * exception the first time the generated app actually boots.
	 *
	 * @resolvedConfig The resolved config struct from AgentConfigResolver.resolve() - only `gatewaySession` is used
	 * @errors Accumulator array - append() any validation errors found
	 */
	private void function validateGatewaySession( required struct resolvedConfig, required array errors ) {
		if ( !structKeyExists( arguments.resolvedConfig, "gatewaySession" ) ) {
			return
		}

		var validPolicies = [ "reject", "queue", "steer", "interrupt" ]
		var sessionConfig = arguments.resolvedConfig.gatewaySession
		var policy = sessionConfig.policy ?: "queue"

		if ( !validPolicies.contains( policy ) ) {
			arguments.errors.append( "Agent.bx's 'gatewaySession.policy' has an invalid value [#policy#] - must be one of: #validPolicies.toList()#" )
		}
	}

	// --------------------------------------------------------------------------
	// Remote MCP servers (declared on Agent.bx itself, consumed - never dialed - at build time)
	// --------------------------------------------------------------------------

	/**
	 * @resolvedConfig The resolved config struct from AgentConfigResolver.resolve() - only `mcpServers` is used
	 * @errors Accumulator array - append() any validation errors found
	 */
	private void function validateMcpServers( required struct resolvedConfig, required array errors ) {
		var mcpServers = arguments.resolvedConfig.mcpServers ?: []

		if ( !isArray( mcpServers ) ) {
			arguments.errors.append( "Agent.bx's 'mcpServers' must be an array" )
			return
		}

		for ( var entry in mcpServers ) {
			if ( isStruct( entry ) ) {
				if ( !len( entry.url ?: "" ) ) {
					arguments.errors.append( "An mcpServers entry is missing a 'url'" )
				}
			} else if ( isSimpleValue( entry ) ) {
				if ( !len( entry ) ) {
					arguments.errors.append( "An mcpServers entry is an empty string" )
				}
			} else {
				arguments.errors.append( "An mcpServers entry must be a URL string or a { url, name } struct" )
			}
		}
	}

	// --------------------------------------------------------------------------
	// Model / provider validation
	// --------------------------------------------------------------------------

	/**
	 * @resolvedConfig The node's own resolved config - only `model` is used
	 * @discovery The raw discovery struct from ProjectDiscoverer.discover() (only .models is used)
	 * @errors Accumulator array - append() any validation errors found
	 * @source Human-readable label for error messages - defaults to describing
	 * the ROOT project's own Agent.bx. Callers validating a SUBAGENT's config
	 * pass their own "Subagent [name]'s Agent.bx" label instead, so a bad
	 * model value on a subagent is reported clearly rather than misattributed
	 * to the root project.
	 */
	private void function validateModelProvider( required struct resolvedConfig, required struct discovery, required array errors, string source = "Agent.bx's configure()" ) {
		var modelValue = arguments.resolvedConfig.model ?: ""

		if ( !len( modelValue ) ) {
			// A class-based Agent.bx already HAS a model from its own super.init();
			// requiring the config to redeclare one would defeat the point. A
			// descriptor Agent.bx still must, since nothing else supplies it.
			if ( arguments.resolvedConfig.classBasedAgent ?: false ) {
				return
			}
			arguments.errors.append( "#arguments.source# must declare a 'model'" )
			return
		}

		if ( modelValue.find( "/" ) ) {
			var parsed = variables.modelSlugParser.parse( modelValue )
			if ( !variables.modelSlugParser.isKnownProvider( parsed.provider ) ) {
				arguments.errors.append( "#arguments.source#: Unknown model provider [#parsed.provider#] - must be one of: #variables.modelSlugParser.coreProviders().toList()#" )
			}
			return
		}

		// No slash: must either be a known provider's default model, or a named
		// reference to a models/ entry. Subagents have no models/ folder of
		// their own - they resolve against the ROOT project's discovery.models,
		// matching the flat-namespace design already used for subAgents
		// references (see docs/conventions/subagents.md) and ColdBoxAppGenerator's
		// own generation-time model resolution.
		var modelNames = ( arguments.discovery.models ?: [] ).map( m => m.name )
		if ( !variables.modelSlugParser.isKnownProvider( modelValue ) && !modelNames.contains( modelValue ) ) {
			arguments.errors.append( "#arguments.source#: model [#modelValue#] has no provider and does not match any models/ entry" )
		}
	}

	// --------------------------------------------------------------------------
	// Shared helpers
	// --------------------------------------------------------------------------

	/**
	 * Reads a discovered entry's config: JSON files are deserialized directly,
	 * `.bx` files are dynamically loaded and their configure() invoked.
	 * Returns null (not throws) if the entry can't be read - callers report
	 * their own contextual error message.
	 *
	 * @path Absolute path to the entry's `.bx`/`.json` file
	 *
	 * @return The entry's config struct, or null if it could not be read
	 */
	private any function readEntryConfig( required string path ) {
		try {
			if ( arguments.path.endsWith( ".json" ) ) {
				return jsonDeserialize( fileRead( arguments.path ) )
			}

			var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()
			var instance = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
				.instantiate( arguments.path, context )
			return instance.configure()
		} catch ( any e ) {
			return null
		}
	}

}
