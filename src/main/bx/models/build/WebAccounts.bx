/**
 * Whether a web UI entry in `gateways/` lists `users`: sign-in accounts. A page with accounts must not sit in front of
 * an API that anyone can call, so the build treats the agent API as needing a sign-in then (see api.AccessMode).
 */
import bxModules.bxagents.models.util.EntryConfigReader;

class {

	/**
	 * @discovery The discovery struct from ProjectDiscoverer.discover()
	 *
	 * @return True when any `exposes: "webui"` entry lists at least one user
	 */
	static boolean function present( required struct discovery ) {
		for ( var gateway in ( arguments.discovery.gateways ?: [] ) ) {
			var config = EntryConfigReader::read( gateway.path )
			if ( !isNull( config ) && ( config.exposes ?: "" ) == "webui" && isArray( config.users ?: "" ) && config.users.len() ) {
				return true
			}
		}
		return false
	}

	/**
	 * @agentApi The `agentApi` block of the agent's config
	 * @discovery The discovery struct
	 *
	 * @return The same block, told whether the page has accounts: what every part of the build that asks AccessMode should be given
	 */
	static struct function effective( struct agentApi = {}, required struct discovery ) {
		var effective = duplicate( arguments.agentApi )
		effective[ "webAccounts" ] = present( arguments.discovery )
		return effective
	}

}
