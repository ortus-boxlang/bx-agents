/**
 * Makes the encrypted secrets of a project readable to everything that asks the environment.
 *
 * A project that keeps its secrets in the repository has a `secrets.json` at its root:
 *
 *   { "CLAUDE_API_KEY": "bxsecret:AbCd...==", "GITHUB_PERSONAL_ACCESS_TOKEN": "bxsecret:..." }
 *
 * Each value is BoxLang's own `bxsecret:` ciphertext (what `boxlang generatesecret` prints), so
 * it is safe to commit. Everything in BX Agents asks for a secret by the NAME of an environment
 * variable (the model key, an MCP token, a gateway token, `${env.NAME}` in Agent.yaml), all through
 * getSystemSetting(). This loader decrypts each value and publishes it as a Java system property
 * of that name, which getSystemSetting() reads, so none of those places has to know the secret
 * came from a file.
 *
 * Two rules keep it safe to turn on:
 *   - A variable already in the real environment, or already set as a property, is left alone.
 *     Whoever deploys can always override a committed value.
 *   - Nothing is decrypted without the project's seed, BOXLANG_SECURITY_SECRETSEED. Without it
 *     (or with another one) loading fails with a message that says so, rather than the app
 *     starting with every key quietly missing.
 *
 * Decrypted values live in memory only. They are never logged, and only variable NAMES appear
 * in any message.
 */
class {

	static {
		SEED_VARIABLE = "BOXLANG_SECURITY_SECRETSEED"
		FILE_NAME = "secrets.json"
		// AES with the wrong key usually fails to decrypt, but not always; a known value encrypted
		// with the project's seed lets a wrong seed be recognised for certain, before any secret is used
		CANARY_KEY = "_seedCheck"
		CANARY_TEXT = "bxagents-secrets"
	}

	/**
	 * @file Absolute path to the secrets file; a missing file is fine and loads nothing
	 * @seed The seed to decrypt with; defaults to BOXLANG_SECURITY_SECRETSEED, then BoxLang's own runtime seed
	 *
	 * @return { loaded : [ names ], skipped : [ names already set ] }
	 *
	 * @throws BxAgents.SecretsUnreadable When the file is not a mapping of names to bxsecret: values, or a value cannot be decrypted
	 */
	struct function load( required string file, string seed = "" ) {
		var result = { loaded : [], skipped : [] }
		if ( !fileExists( arguments.file ) ) {
			return result
		}

		var entries = read( arguments.file )
		if ( entries.isEmpty() ) {
			return result
		}

		var utility = createObject( "java", "ortus.boxlang.runtime.util.ConfigSecretUtil" )
		var system = createObject( "java", "java.lang.System" )
		var key = len( arguments.seed ) ? arguments.seed : resolveSeed( utility )
		checkSeed( arguments.file, utility, key )

		for ( var name in entries.keyArray().sort( "textnocase" ) ) {
			if ( len( system.getenv( name ) ?: "" ) || len( system.getProperty( name ) ?: "" ) ) {
				result.skipped.append( name )
				continue
			}
			var plain = ""
			try {
				plain = utility.decrypt( entries[ name ].mid( len( utility.SECURE_VALUE_PREFIX ) + 1, len( entries[ name ] ) ), key )
			} catch ( any e ) {
				throw(
					type    = "BxAgents.SecretsUnreadable",
					message = "Cannot decrypt [#name#] from #getFileFromPath( arguments.file )#. It was encrypted with a different seed. Set #static.SEED_VARIABLE# to this project's seed: it is in the project's .env, and your team's secret manager should hold the same value."
				)
			}
			system.setProperty( name, plain )
			result.loaded.append( name )
		}
		return result
	}

	/**
	 * Makes the value that proves a seed is the project's: the canary entry for a new secrets file.
	 *
	 * @seed The project's seed
	 *
	 * @return A bxsecret: value
	 */
	string function canary( required string seed ) {
		var utility = createObject( "java", "ortus.boxlang.runtime.util.ConfigSecretUtil" )
		return utility.SECURE_VALUE_PREFIX & utility.encrypt( static.CANARY_TEXT, arguments.seed )
	}

	/**
	 * Fails when the file carries a canary the given seed cannot decrypt to its known text.
	 */
	private void function checkSeed( required string file, required any utility, required string seed ) {
		var data = jsonDeserialize( fileRead( arguments.file ) )
		var check = data[ static.CANARY_KEY ] ?: ""
		if ( !len( check ) ) {
			return
		}
		var ok = false
		try {
			ok = arguments.utility.decrypt( check.mid( len( arguments.utility.SECURE_VALUE_PREFIX ) + 1, len( check ) ), arguments.seed ) == static.CANARY_TEXT
		} catch ( any e ) {
			ok = false
		}
		if ( !ok ) {
			throw(
				type    = "BxAgents.SecretsUnreadable",
				message = "The seed in force cannot read #getFileFromPath( arguments.file )#. Set #static.SEED_VARIABLE# to this project's seed: it is in the project's .env, and your team's secret manager should hold the same value."
			)
		}
	}

	/**
	 * @file Absolute path to the secrets file
	 *
	 * @return The names the file holds, for messages and checks. Values stay unread.
	 */
	array function names( required string file ) {
		return fileExists( arguments.file ) ? read( arguments.file ).keyArray().sort( "textnocase" ) : []
	}

	/**
	 * Reads and checks the file: a JSON mapping of NAME to a bxsecret: value, nothing else.
	 * A plain value in it would be a secret committed in the clear, so it is refused.
	 *
	 * @file Absolute path
	 *
	 * @return { NAME : "bxsecret:..." }
	 */
	struct function read( required string file ) {
		var data = {}
		try {
			data = jsonDeserialize( fileRead( arguments.file ) )
		} catch ( any e ) {
			throw( type = "BxAgents.SecretsUnreadable", message = "#getFileFromPath( arguments.file )# is not valid JSON: #e.message#" )
		}
		if ( !isStruct( data ) ) {
			throw( type = "BxAgents.SecretsUnreadable", message = "#getFileFromPath( arguments.file )# must be a JSON object of NAME: ""bxsecret:..."" pairs." )
		}
		var entries = {}
		for ( var name in data ) {
			if ( name.startsWith( "_" ) ) {
				continue
			}
			var value = data[ name ]
			if ( !reFind( "^[A-Za-z_][A-Za-z0-9_]*$", name ) ) {
				throw( type = "BxAgents.SecretsUnreadable", message = "[#name#] in #getFileFromPath( arguments.file )# is not a valid environment variable name." )
			}
			if ( !isSimpleValue( value ) || !value.startsWith( "bxsecret:" ) ) {
				throw( type = "BxAgents.SecretsUnreadable", message = "[#name#] in #getFileFromPath( arguments.file )# is not encrypted. Every value must start with bxsecret: (make one with `boxlang generatesecret`). A plain secret must not be committed." )
			}
			entries[ name ] = value
		}
		return entries
	}

	/**
	 * @return The seed in force: the environment's, else BoxLang's own runtime seed
	 */
	private string function resolveSeed( required any utility ) {
		var fromEnvironment = getSystemSetting( static.SEED_VARIABLE, "" )
		return len( fromEnvironment ) ? fromEnvironment : arguments.utility.getRuntimeSeed()
	}

}
