/**
 * Discovers a BX Agents project's convention-based source files (Build Pipeline Phase 2).
 *
 * Walks the project root and enumerates `models/`, `tools/`, `skills/`, `subagents/`,
 * `gateways/`, `schedules/`, `mcp/`, `interceptors/`, `modules/` into raw
 * `{ name, path, type }` entries. This is discovery only - no validation or
 * interpretation of contents happens here (that's ProjectValidator, Phase 3).
 *
 * Conventions:
 *  - models/, gateways/: one entry per top-level `.bx`/`.json` file
 *  - tools/, mcp/, interceptors/: one entry per `.bx` file (tools/ recurses,
 *    matching BX AI's own `aiToolRegistry().scan()` convention - actual tool
 *    names are discovered by BX AI itself at runtime, not here)
 *  - skills/: one entry per immediate subfolder containing a `SKILL.md`; the
 *    entry name is the skill's YAML frontmatter `name:` if present, else the
 *    folder name
 *  - subagents/: one entry per immediate subfolder (each mirrors the project's
 *    own `Agent.bx` + `instructions.md` convention); the entry name here is
 *    always the folder name (a subagent's *declared* name/subAgents list is
 *    only known once its own Agent.bx is loaded, in a later phase)
 *  - schedules/: unlike every other convention folder, this holds ONE real
 *    ColdBox scheduler class - `schedules/Scheduler.bx`, passed through into
 *    the build untouched (see SchedulerGenerator) - not a list of entries
 *  - modules/: one entry per immediate subfolder
 *
 * Dotfiles and files with no recognized extension (e.g. README.md) are ignored.
 */
class {

	/**
	 * @projectRoot Absolute path to the project root
	 *
	 * @return { models, tools, skills, subagents, gateways, mcp, interceptors, modules, hasScheduler, schedulerPath } - each convention EXCEPT schedules/ is an array of { name, path, type }; schedules/ is instead the single hasScheduler/schedulerPath pair
	 */
	struct function discover( required string projectRoot ) {
		var root = arguments.projectRoot.reReplace( "[\\/]+$", "" )
		var scheduler = discoverScheduler( root )

		return {
			models        : listFiles( root & "/models", [ "bx", "json" ], "model" ),
			tools         : listFiles( root & "/tools", [ "bx" ], "tool", true ),
			skills        : listSkills( root & "/skills" ),
			subagents     : listSubfolders( root & "/subagents", "subagent" ),
			gateways      : listFiles( root & "/gateways", [ "bx", "json" ], "gateway" ),
			mcp           : listFiles( root & "/mcp", [ "bx" ], "mcp" ),
			interceptors  : listFiles( root & "/interceptors", [ "bx" ], "interceptor" ),
			modules       : listSubfolders( root & "/modules", "module" ),
			hasScheduler  : scheduler.hasScheduler,
			schedulerPath : scheduler.schedulerPath
		}
	}

	/**
	 * @root Absolute path to the project root
	 *
	 * @return { hasScheduler: boolean, schedulerPath: string } - schedulerPath is "" when hasScheduler is false
	 */
	private struct function discoverScheduler( required string root ) {
		var schedulerPath = arguments.root & "/schedules/Scheduler.bx"
		return {
			hasScheduler  : fileExists( schedulerPath ),
			schedulerPath : fileExists( schedulerPath ) ? schedulerPath : ""
		}
	}

	/**
	 * @dir The convention folder to scan, e.g. "<projectRoot>/tools"
	 * @extensions Allowed file extensions, lowercase, e.g. [ "bx", "json" ]
	 * @type The entry `type` to stamp on every result, e.g. "tool"
	 * @recurse Whether to walk subdirectories too (tools/ does; gateways/schedules/etc. don't)
	 *
	 * @return An array of { name, path, type } for every non-dotfile matching a recognized extension
	 */
	private array function listFiles(
		required string dir,
		required array extensions,
		required string type,
		boolean recurse = false
	) {
		if ( !directoryExists( arguments.dir ) ) {
			return []
		}

		var extensions = arguments.extensions
		var entryType = arguments.type

		return directoryList( arguments.dir, arguments.recurse, "path", "*", "asc", "file" )
			.filter( path => {
				var fileName = getFileFromPath( path )
				if ( fileName.left( 1 ) == "." ) {
					return false
				}
				var ext = listLast( fileName, "." ).lcase()
				return extensions.contains( ext )
			} )
			.map( path => {
				return {
					name : listFirst( getFileFromPath( path ), "." ),
					path : path,
					type : entryType
				}
			} )
	}

	/**
	 * @dir The convention folder to scan, e.g. "<projectRoot>/subagents"
	 * @type The entry `type` to stamp on every result, e.g. "subagent"
	 *
	 * @return An array of { name, path, type } for every immediate, non-dotfile subfolder
	 */
	private array function listSubfolders( required string dir, required string type ) {
		if ( !directoryExists( arguments.dir ) ) {
			return []
		}

		var entryType = arguments.type

		return directoryList( arguments.dir, false, "path", "*", "asc", "dir" )
			.filter( path => getFileFromPath( path ).left( 1 ) != "." )
			.map( path => {
				return {
					name : getFileFromPath( path ),
					path : path,
					type : entryType
				}
			} )
	}

	/**
	 * @dir The skills/ folder to scan
	 *
	 * @return An array of { name, path, type: "skill" } for every immediate subfolder containing a SKILL.md
	 */
	private array function listSkills( required string dir ) {
		if ( !directoryExists( arguments.dir ) ) {
			return []
		}

		return directoryList( arguments.dir, false, "path", "*", "asc", "dir" )
			.filter( path => getFileFromPath( path ).left( 1 ) != "." )
			.filter( path => fileExists( path & "/SKILL.md" ) )
			.map( path => {
				var folderName = getFileFromPath( path )
				return {
					name : deriveSkillName( path & "/SKILL.md", folderName ),
					path : path,
					type : "skill"
				}
			} )
	}

	/**
	 * @skillMdPath Absolute path to a skill's SKILL.md
	 * @fallbackName Used when SKILL.md has no YAML frontmatter `name:` field - typically the folder name
	 *
	 * @return The skill's frontmatter `name:` value if present, else fallbackName
	 */
	private string function deriveSkillName( required string skillMdPath, required string fallbackName ) {
		var content = fileRead( arguments.skillMdPath )

		if ( !content.startsWith( "---" ) ) {
			return arguments.fallbackName
		}

		// Bound the search to the frontmatter block (between the opening and
		// closing "---" markers) so a `name:`-looking line in the body can't
		// be mistaken for the frontmatter's own name.
		var closingPos = content.find( "---", 4 )
		var frontmatter = closingPos ? content.mid( 4, closingPos - 4 ) : content

		var matches = frontmatter.reMatch( "name\s*:\s*[^\r\n]+" )
		if ( matches.len() ) {
			var name = matches[ 1 ].listRest( ":" ).trim()
			if ( len( name ) ) {
				return name
			}
		}

		return arguments.fallbackName
	}

}
