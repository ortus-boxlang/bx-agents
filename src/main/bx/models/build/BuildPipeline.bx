/**
 * Orchestrates BX Agents' full build pipeline for a single project - the
 * `build` CLI verb's real implementation (M12), wiring together every phase
 * built in M1-M10:
 *
 *   resolve config -> discover -> validate (fail on any error) -> generate
 *   the ColdBox app skeleton (interceptors, gateways/mcp registrations,
 *   router, tools/skills copy, scheduler) -> normalize + write the internal
 *   manifest.
 *
 * Deliberately produces ONLY `.build/app/` + `.build/manifest.json` -
 * packaging (`.bxa`) is a separate step (see PackagerService / the
 * `package` CLI verb), so a fast dev loop (`build` -> inspect -> `build`
 * again) never pays the packaging cost it doesn't need.
 */
class {

	/**
	 * Every sibling reference below uses the "Class@bxagents" module-relative
	 * suffix form, NOT a bare "bxagents.models...." dotted path - confirmed
	 * empirically this session that the bare form only resolves in THIS
	 * repo's own dev/test boxlang.json (a hand-declared plain "/bxagents"
	 * mapping), and fails under a genuinely installed module (which only
	 * gets BoxLang's own auto-registered "bxModules.bxagents.*"/"@bxagents"
	 * resolution) - a real, previously-undiscovered bug that broke every CLI
	 * verb under a real install. This file itself is a nested class (not the
	 * module root ModuleConfig.bx sits at), so it can't rely on relative
	 * resolution the way ModuleConfig.bx's own verb dispatch table does.
	 *
	 * @generatorVersion This module's own version, stamped into every generated manifest.json's generator.version field
	 *
	 * @return this
	 */
	function init( string generatorVersion = "dev" ) {
		variables.configResolver = new "models.build.AgentConfigResolver@bxagents"()
		variables.discoverer = new "models.build.ProjectDiscoverer@bxagents"()
		variables.validator = new "models.build.ProjectValidator@bxagents"()
		variables.manifestNormalizer = new "models.build.ManifestNormalizer@bxagents"( arguments.generatorVersion )
		variables.coldboxAppGenerator = new "models.build.generators.ColdBoxAppGenerator@bxagents"()
		variables.toolsSkillsCopier = new "models.build.generators.ToolsSkillsCopier@bxagents"()
		variables.interceptorSplitter = new "models.build.generators.InterceptorSplitter@bxagents"()
		variables.routerGenerator = new "models.build.generators.RouterGenerator@bxagents"()
		variables.webUiGenerator = new "models.build.generators.WebUiGenerator@bxagents"()
		variables.gatewayGenerator = new "models.build.generators.GatewayGenerator@bxagents"()
		variables.schedulerGenerator = new "models.build.generators.SchedulerGenerator@bxagents"()
		variables.mcpGenerator = new "models.build.generators.McpGenerator@bxagents"()
		return this
	}

	/**
	 * @projectRoot Absolute path to the project root (containing Agent.bx)
	 * @cliEnvironment Optional environment name, e.g. from a CLI flag
	 * @onProgress Called with one human-readable line per phase/interaction as the build proceeds - defaults to a no-op, so callers that don't care (every existing caller, before `build --verbose`) pay nothing extra. Passing a closure that collects into an array (rather than printing) is how this is unit-tested - see BuildPipelineSpec.bx
	 *
	 * @return { projectRoot, buildDir, appDir, manifestPath, manifest, warnings }
	 */
	struct function build( required string projectRoot, string cliEnvironment = "", any onProgress = function( required string message ) {} ) {
		var root = normalizePath( arguments.projectRoot )
		var buildDir = root & "/.build"
		var appDir = buildDir & "/app"
		var buildStart = getTickCount()

		arguments.onProgress( "+ Resolving Agent.bx config..." )
		var config = variables.configResolver.resolve( projectRoot = root, cliEnvironment = arguments.cliEnvironment )
		arguments.onProgress( "    name=#config.name ?: ''#, model=#config.model ?: ''#, environment=#config.environment ?: ''#" )

		arguments.onProgress( "+ Discovering project source..." )
		var discovery = variables.discoverer.discover( root )
		arguments.onProgress(
			"    models=#discovery.models.len()#, tools=#discovery.tools.len()#, skills=#discovery.skills.len()#, subagents=#discovery.subagents.len()#, gateways=#discovery.gateways.len()#, scheduler=#( discovery.hasScheduler ? 'yes' : 'no' )#, mcp=#discovery.mcp.len()#, interceptors=#discovery.interceptors.len()#, modules=#discovery.modules.len()#"
		)

		arguments.onProgress( "+ Validating project..." )
		var validation = variables.validator.validate( root, discovery, config )

		if ( validation.errors.len() ) {
			arguments.onProgress( "    #validation.errors.len()# error(s) - build aborted" )
			throw(
				type    = "BxAgents.BuildValidationFailed",
				message = "Project failed validation with #validation.errors.len()# error(s): #validation.errors.toList( '; ' )#"
			)
		}
		for ( var warning in validation.warnings ) {
			arguments.onProgress( "    ! #warning#" )
		}
		if ( !validation.warnings.len() ) {
			arguments.onProgress( "    no errors or warnings" )
		}

		if ( directoryExists( appDir ) ) {
			arguments.onProgress( "+ Removing stale .build/app..." )
			directoryDelete( appDir, true )
		}
		directoryCreate( path = appDir, createPath = true, ignoreExists = true )

		arguments.onProgress( "+ Splitting interceptors (agent vs runtime scope)..." )
		var interceptorSplit = variables.interceptorSplitter.split(
			appDir & "/interceptors",
			buildDir & "/runtime-interceptors",
			discovery
		)
		arguments.onProgress( "    agent-scope=#interceptorSplit.agent.len()#, runtime-scope=#interceptorSplit.runtime.len()#" )

		arguments.onProgress( "+ Generating gateway registrations..." )
		var gatewayResult = variables.gatewayGenerator.generate( discovery, appDir, config )
		arguments.onProgress( "    #gatewayResult.registrationStatements.len()# registration(s), httpGateway=#( gatewayResult.hasHttpGateway ? 'yes' : 'no' )#, pushGateway=#( gatewayResult.hasPushGateway ? 'yes' : 'no' )#" )

		arguments.onProgress( "+ Generating local MCP server registrations..." )
		var mcpResult = variables.mcpGenerator.generate( discovery, appDir )
		arguments.onProgress( "    #mcpResult.registrations.len()# registration(s)" )

		arguments.onProgress( "+ Generating config/Router.bx..." )
		variables.routerGenerator.generate( discovery, appDir, gatewayResult.hasHttpGateway, gatewayResult.hasWhatsAppCloudGateway ?: false, gatewayResult.hasTeamsGateway ?: false, gatewayResult.hasTwilioGateway ?: false, gatewayResult.hasGitHubGateway ?: false )

		arguments.onProgress( "+ Generating the v1 web chat UI (if any gateways/* entry exposes it)..." )
		var webUiResult = variables.webUiGenerator.generate( discovery, appDir )
		arguments.onProgress( "    webui=#( webUiResult.hasWebUi ? 'yes' : 'no' )#, apiKeyGate=#( len( webUiResult.webUiAuthInterceptorName ?: '' ) ? 'yes' : 'no' )#" )

		var toolScanStatements = []
		if ( discovery.tools.len() ) {
			// bx-ai has no built-in "scan this app's tools/ folder" convention
			// (unlike skillsDirectory) - the app must call aiToolRegistry().scan()
			// itself at startup so tool-by-name lookups (M10's local MCP server
			// wiring, any future tool reference) resolve.
			toolScanStatements.append( 'aiToolRegistry().scan( "tools" )' )
		}

		var agentInterceptorNames = interceptorSplit.agent.map( function( e ) { return e.name } )
		if ( len( gatewayResult.sessionInterceptorName ?: "" ) ) {
			agentInterceptorNames.append( gatewayResult.sessionInterceptorName )
		}
		if ( len( webUiResult.webUiAuthInterceptorName ?: "" ) ) {
			agentInterceptorNames.append( webUiResult.webUiAuthInterceptorName )
		}

		arguments.onProgress( "+ Generating core ColdBox app skeleton (Application.bx, config/WireBox.bx, config/ColdBox.bx, agent/GeneratedAgentFactory.bx)..." )
		var coldboxResult = variables.coldboxAppGenerator.generate(
			projectRoot           = root,
			buildDir              = appDir,
			resolvedConfig        = config,
			agentInterceptors     = agentInterceptorNames,
			gatewayRegistrations  = gatewayResult.registrationStatements,
			mcpRegistrations      = mcpResult.registrations,
			extraStartupStatements = toolScanStatements,
			cliEnvironment        = arguments.cliEnvironment,
			discovery             = discovery,
			hasEmailGateway       = gatewayResult.hasEmailGateway ?: false,
			// Drives BOTH session management in Application.bx and the
			// session-scoped memory default: a browser-facing app needs a real
			// HTTP session, because that session is what separates one visitor's
			// conversation from another's.
			hasWebUi              = webUiResult.hasWebUi ?: false
		)
		var agentNames = coldboxResult.agentNodes.map( function( n ) { return n.name } )
		arguments.onProgress( "    agents registered in WireBox (getInstance-able by name): #agentNames.toList( ', ' )#" )

		arguments.onProgress( "+ Copying tools/ and skills/..." )
		variables.toolsSkillsCopier.copy( root, appDir )

		if ( discovery.hasScheduler ?: false ) {
			arguments.onProgress( "+ Copying schedules/Scheduler.bx..." )
		} else {
			arguments.onProgress( "+ No schedules/Scheduler.bx found - skipping scheduler" )
		}
		variables.schedulerGenerator.generate( discovery, appDir )

		arguments.onProgress( "+ Normalizing and writing the manifest..." )
		var manifest = variables.manifestNormalizer.normalize( root, discovery, config )
		var manifestPath = buildDir & "/manifest.json"
		fileWrite( manifestPath, jsonSerialize( manifest ) )
		arguments.onProgress( "    #manifest.files.len()# file(s) tracked" )

		arguments.onProgress( "+ Build completed in #( getTickCount() - buildStart )#ms" )

		return {
			projectRoot  : root,
			buildDir     : buildDir,
			appDir       : appDir,
			manifestPath : manifestPath,
			manifest     : manifest,
			warnings     : validation.warnings
		}
	}

	/**
	 * @path A filesystem path
	 *
	 * @return The path with any trailing slash(es) stripped
	 */
	private string function normalizePath( required string path ) {
		return arguments.path.reReplace( "[\/]+$", "" )
	}

}
