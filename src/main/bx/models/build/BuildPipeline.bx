import bxModules.bxagents.models.util.TreeDelete;
/**
 * Orchestrates BX Agents' full build pipeline for a single project - the
 * `build` CLI verb's real implementation (M12), wiring together every phase
 * built in M1-M10:
 *
 *   resolve config -> discover -> validate (fail on any error) -> generate
 *   the ColdBox app skeleton (interceptors, gateways/mcp registrations,
 *   router, tools/skills copy, scheduler) -> normalize + write the internal
 *   manifest.
 *
 * Produces `.build/`, laid out like the ColdBox BoxLang application template (see models/build/layout/BuildLayout):
 * `app/` (the generated code), `public/` (the only folder a server serves), `lib/` (ColdBox and its modules), `runtime/`
 * (the engine config and the one module the app loads, `bxagents`), `boxlang_modules/`, `miniserver.json`, and
 * `.build/manifest.json` beside them. Packaging (`.bxa`) is a separate step (see PackagerService / the
 * `package` CLI verb), so a fast dev loop (`build` -> inspect -> `build` again) never pays the packaging cost it
 * doesn't need.
 */
import bxModules.bxagents.models.connect.OAuthServers;
import bxModules.bxagents.models.connectors.ConnectorSettings;
import bxModules.bxagents.models.util.Strings;

import bxModules.bxagents.models.build.AgentApiConfig;
import bxModules.bxagents.models.routines.RoutineSettings;

class {

	/**
	 * Every sibling reference below uses the "Class@bxagents" module-relative
	 * suffix form, NOT a bare "bxagents.models...." dotted path - confirmed
	 * empirically this session that the bare form only resolves in THIS
	 * repo's own dev/test boxlang.json (a hand-declared plain "/bxagents"
	 * mapping), and fails under a genuinely installed module (which only
	 * gets BoxLang's own auto-registered "bxModules.bxagents.*"/"@bxagents"
	 * resolution) - a real, previously-undiscovered bug that broke every CLI
	 * verb under a real install. This file itself is a nested class (not the
	 * module root ModuleConfig.bx sits at), so it can't rely on relative
	 * resolution the way ModuleConfig.bx's own verb dispatch table does.
	 *
	 * @generatorVersion This module's own version, stamped into every generated manifest.json's generator.version field
	 *
	 * @return this
	 */
	function init( string generatorVersion = "dev" ) {
		variables.configResolver = new "models.build.AgentConfigResolver@bxagents"()
		variables.discoverer = new "models.build.ProjectDiscoverer@bxagents"()
		variables.validator = new "models.build.ProjectValidator@bxagents"()
		variables.manifestNormalizer = new "models.build.ManifestNormalizer@bxagents"( arguments.generatorVersion )
		variables.coldboxAppGenerator = new "models.build.generators.ColdBoxAppGenerator@bxagents"()
		variables.templateAssembler = new "models.build.layout.TemplateAssembler@bxagents"()
		variables.moduleCopier = new "models.build.layout.ModuleCopier@bxagents"()
		variables.miniServerJson = new "models.build.layout.MiniServerJson@bxagents"()
		variables.moduleDir = ""
		variables.libsDir = ""
		variables.toolsSkillsCopier = new "models.build.generators.ToolsSkillsCopier@bxagents"()
		variables.projectFilesCopier = new "models.build.generators.ProjectFilesCopier@bxagents"()
		variables.runtimeLibsCopier = new "models.build.generators.RuntimeLibsCopier@bxagents"()
		variables.boxLangModulesCopier = new "models.build.generators.BoxLangModulesCopier@bxagents"()
		variables.interceptorSplitter = new "models.build.generators.InterceptorSplitter@bxagents"()
		variables.routerGenerator = new "models.build.generators.RouterGenerator@bxagents"()
		variables.agentApiGenerator = new "models.build.generators.AgentApiGenerator@bxagents"()
		variables.webUiGenerator = new "models.build.generators.WebUiGenerator@bxagents"()
		variables.gatewayGenerator = new "models.build.generators.GatewayGenerator@bxagents"()
		variables.schedulerGenerator = new "models.build.generators.SchedulerGenerator@bxagents"()
		variables.extensionsGenerator = new "models.build.generators.ExtensionsGenerator@bxagents"()
		variables.mcpGenerator = new "models.build.generators.McpGenerator@bxagents"()
		return this
	}

	/**
	 * For tests and the dev harness: which folder is copied into `runtime/modules`, and the lib/ the ColdBox
	 * libraries come from. Not set, they are what ModuleCopier.sourceDir() finds (BXAGENTS_MODULE_DIR, else the installed
	 * module this code runs from); a source checkout has neither, and the build says so rather than failing. A test passes
	 * the folder here rather than changing BXAGENTS_MODULE_DIR, because getSystemSetting() answers from a per-key cache.
	 *
	 * @moduleDir The module folder (any name) to copy into the app's runtime; `none` copies nothing
	 * @libsDir The module's lib/ folder (coldbox, modules/*)
	 */
	function setModuleSource( string moduleDir = "", string libsDir = "" ) {
		variables.moduleDir = arguments.moduleDir
		variables.libsDir = arguments.libsDir
		return this
	}

	/**
	 * For tests: a RegistryClient that does not touch the network.
	 *
	 * @client A RegistryClient
	 */
	function setSkillsClient( required any client ) {
		variables.skillsClient = arguments.client
		return this
	}

	/**
	 * Installs the skills .agents/skills.lock.json lists and the disk lacks, so a fresh
	 * checkout builds the same agent. Nothing is fetched when they are all there.
	 */
	private void function restoreSkills( required string root, required any onProgress ) {
		if ( !fileExists( arguments.root & "/.agents/skills.lock.json" ) ) {
			return
		}
		var client = variables.skillsClient ?: new "models.skills.RegistryClient@bxagents"()
		var restored = new "models.skills.SkillInstaller@bxagents"( client ).restore( arguments.root )
		if ( restored.len() ) {
			arguments.onProgress( "+ Restoring installed skills..." )
			for ( var skill in restored ) {
				arguments.onProgress( "    #skill.name#" & ( skill.moved ? " (the registry's copy differs from the locked one: bxAgents skills update #skill.name#)" : "" ) )
			}
		}
	}

	/**
	 * Installs the extensions extensions.lock.json lists and the project lacks, so a fresh checkout builds the same
	 * app. Each must be what was locked; if one cannot be brought back the build stops and says which and why.
	 */
	private void function restoreExtensions( required string root, required any onProgress ) {
		if ( !fileExists( arguments.root & "/extensions.lock.json" ) ) {
			return
		}
		var restored = new "models.extensions.ExtensionInstaller@bxagents"( projectRoot : arguments.root ).restore()
		if ( restored.restored.len() ) {
			arguments.onProgress( "+ Restoring installed extensions..." )
			for ( var name in restored.restored ) {
				arguments.onProgress( "    #name#" )
			}
		}
		if ( restored.failed.len() ) {
			throw( type : "BxAgents.ExtensionRestoreFailed", message : "Could not restore the extensions extensions.lock.json lists: " & restored.failed.map( f => "#f.name# (#f.reason#)" ).toList( "; " ) )
		}
	}

	/**
	 * @projectRoot Absolute path to the project root (containing Agent.bx)
	 * @cliEnvironment Optional environment name, e.g. from a CLI flag
	 * @onProgress Called with one human-readable line per phase/interaction as the build proceeds - defaults to a no-op, so callers that don't care (every existing caller, before `build --verbose`) pay nothing extra. Passing a closure that collects into an array (rather than printing) is how this is unit-tested - see BuildPipelineSpec.bx
	 *
	 * @return { projectRoot, buildDir, appDir, publicDir, libDir, runtimeDir, manifestPath, manifest, warnings, template : { version, tag, commit }, module : { copied, reason } }
	 */
	struct function build( required string projectRoot, string cliEnvironment = "", any onProgress = function( required string message ) {} ) {
		var root = Strings::normalizePath( arguments.projectRoot )
		var layout = new "models.build.layout.BuildLayout@bxagents"().of( root )
		var buildDir = layout.buildDir
		var appDir = layout.appDir
		var publicDir = layout.publicDir
		var buildStart = getTickCount()

		restoreSkills( root, arguments.onProgress )
		restoreExtensions( root, arguments.onProgress )

		arguments.onProgress( "+ Resolving the agent config..." )
		var config = variables.configResolver.resolve( projectRoot = root, cliEnvironment = arguments.cliEnvironment, withPerson = true )
		// the person's files change what is baked, so say which settings, and from which file: nothing is silent
		for ( var changed in config.personLayers.changed ) {
			arguments.onProgress( "    #changed.path# (#changed.op#) from #changed.file#" )
		}
		// A class-based Agent.bx with no configure() leaves config.name/model
		// unset by design (see AgentConfigResolver/ManifestNormalizer) - fall
		// back to the class-carried classAgentName/classAgentModel for this
		// display line only, so it isn't blank for the default scaffolded shape.
		var displayName = len( config.name ?: "" ) ? config.name : ( config.classAgentName ?: "" )
		var displayModel = len( config.model ?: "" ) ? config.model : ( config.classAgentModel ?: "" )
		arguments.onProgress( "    name=#displayName#, model=#displayModel#, environment=#config.environment ?: ''#" )

		arguments.onProgress( "+ Discovering project source..." )
		var discovery = variables.discoverer.discover( root )
		arguments.onProgress(
			"    tools=#discovery.tools.len()#, skills=#discovery.skills.len()#, subagents=#discovery.subagents.len()#, gateways=#discovery.gateways.len()#, schedules=#discovery.schedules.len()#, mcp=#discovery.mcp.len()#, interceptors=#discovery.interceptors.len()#, modules=#discovery.modules.len()#"
		)

		arguments.onProgress( "+ Validating project..." )
		var validation = variables.validator.validate( root, discovery, config )

		if ( validation.errors.len() ) {
			arguments.onProgress( "    #validation.errors.len()# error(s) - build aborted" )
			throw(
				type    = "BxAgents.BuildValidationFailed",
				message = "Project failed validation with #validation.errors.len()# error(s): #validation.errors.toList( '; ' )#"
			)
		}
		for ( var warning in validation.warnings ) {
			arguments.onProgress( "    ! #warning#" )
		}
		if ( !validation.warnings.len() ) {
			arguments.onProgress( "    no errors or warnings" )
		}

		if ( directoryExists( appDir ) ) {
			arguments.onProgress( "+ Removing stale .build/app..." )
			// never through a link: a dev build links the web app module from its source (see WebAppModule)
			TreeDelete::tree( appDir )
		}
		directoryCreate( path = appDir, createPath = true, ignoreExists = true )

		// The template's public/ (replaced), runtime/boxlang.json and app/Application.bx guard, then the empty folders its
		// conventions name. From the snapshot this module carries: nothing is fetched.
		var template = variables.templateAssembler.assemble( buildDir )
		arguments.onProgress( "+ Laying out .build like the ColdBox BoxLang template (v#template.version#, #left( template.commit, 8 )#)..." )

		arguments.onProgress( "+ Splitting interceptors (agent vs runtime scope)..." )
		// The splitter adds the "interceptors" folder itself: handing it
		// `<appDir>/interceptors` put the files in `interceptors/interceptors/`, where
		// the generated Application.bx's getInstance( "interceptors.<Name>" ) cannot
		// find them and the app fails to start ("Instance not found").
		var interceptorSplit = variables.interceptorSplitter.split(
			appDir,
			buildDir & "/runtime-interceptors",
			discovery
		)
		arguments.onProgress( "    agent-scope=#interceptorSplit.agent.len()#, runtime-scope=#interceptorSplit.runtime.len()#" )

		arguments.onProgress( "+ Generating gateway registrations..." )
		var gatewayTypes = new "models.gateways.GatewayTypes@bxagents"().withExtensions( root, new "models.extensions.ExtensionSettings@bxagents"().disableList( isStruct( config.extensions ?: "" ) ? config.extensions : {} ) )
		var gatewayResult = variables.gatewayGenerator.generate( discovery, appDir, config, gatewayTypes )
		arguments.onProgress( "    #gatewayResult.registrationStatements.len()# registration(s), httpGateway=#( gatewayResult.hasHttpGateway ? 'yes' : 'no' )#, pushGateway=#( gatewayResult.hasPushGateway ? 'yes' : 'no' )#" )

		arguments.onProgress( "+ Generating local MCP server registrations..." )
		var mcpResult = variables.mcpGenerator.generate( discovery, appDir )
		arguments.onProgress( "    #mcpResult.registrations.len()# registration(s)" )

		// the agent API as the build sees it: a web page with accounts closes it (see models.api.AccessMode)
		var effectiveAgentApi = AgentApiConfig::effective( config.agentApi ?: {}, discovery )

		arguments.onProgress( "+ Generating config/Router.bx..." )
		variables.routerGenerator.generate( discovery, appDir, gatewayResult.hasChannelGateway ?: false, gatewayResult.hasWhatsAppCloudGateway ?: false, gatewayResult.hasTeamsGateway ?: false, gatewayResult.hasTwilioGateway ?: false, gatewayResult.hasGitHubGateway ?: false, effectiveAgentApi )

		arguments.onProgress( "+ Generating the agent API run control (handlers/AgentApi.bx)..." )
		var agentApiResult = variables.agentApiGenerator.generate( appDir, effectiveAgentApi, OAuthServers::of( config ), {
			agentName : config.name ?: "",
			dataHome  : ( isStruct( config.data ?: "" ) ? config.data : {} ).home ?: "",
			volumes   : isStruct( config.volumes ?: "" ) ? config.volumes : {},
			gateways  : gatewayResult.channelInfo ?: [],
			routines  : isStruct( config.routines ?: "" ) && RoutineSettings::resolve( config.routines ).enabled ? RoutineSettings::resolve( config.routines ) : {},
			// what a person can connect to: the catalog as this build sees it, narrowed by the agent's `connectors` key
			connectors : ConnectorSettings::resolve( config )
		} )
		arguments.onProgress( "    #agentApiResult.written ? 'written' : 'off (agentApi.enabled is false)'#" )

		arguments.onProgress( "+ Generating the web chat UI (if any gateways/* entry exposes it)..." )
		var webUiResult = variables.webUiGenerator.generate( discovery, appDir, config, publicDir )
		arguments.onProgress( "    webui=#( webUiResult.hasWebUi ? 'yes' : 'no' )#, signIn=#( webUiResult.webUiHasUsers ?: false ? 'yes' : 'no' )#, database=#( webUiResult.webUiDatabase.datasource ?: '-' )#" )

		var toolScanStatements = []
		if ( discovery.tools.len() ) {
			// bx-ai has no built-in "scan this app's tools/ folder" convention
			// (unlike skillsDirectory) - the app must call aiToolRegistry().scan()
			// itself at startup so tool-by-name lookups (M10's local MCP server
			// wiring, any future tool reference) resolve.
			// `app.tools`: bx-ai expands the dotted path against a mapping (expandPath( "/app/tools" )), so it must be a mapping path
			// (the template's /app), not a path relative to the app. A bare "tools" expands the mapping /tools, which this layout does not have
			toolScanStatements.append( 'aiToolRegistry().scan( "app.tools" )' )
		}

		// Every name here is a PER-REQUEST interceptor (preProcess and friends),
		// genuinely registered at runtime via ColdBox's InterceptorService - see
		// ColdBoxAppGenerator's renderInterceptorRegistration(). A declarative
		// `interceptors = [...]` array in config/ColdBox.bx used to be how this
		// worked; it never actually reaches ColdBox's InterceptorService in a
		// real boot on this stack (confirmed directly - the same
		// getPropertyMixin()-based config reflection gap already documented for
		// `coldbox.identifierProvider`, generalized), so both the web UI's own
		// login gate and any project-declared interceptor were dead
		// code.
		var agentInterceptorNames = interceptorSplit.agent.map( function( e ) { return e.name } )
		var projectInterceptorNames = agentInterceptorNames.duplicate()
		// Requires a signed-in user. Registered last so the store exists and the
		// accounts are seeded before anything can be gated against them.
		if ( len( webUiResult.webUiLoginGateName ?: "" ) ) {
			agentInterceptorNames.append( webUiResult.webUiLoginGateName )
		}

		// Everything below is a bare onApplicationStart() statement, not an
		// interceptor - either because it is a one-shot boot action with no
		// per-request behavior (account seeding, warming the web UI's store,
		// starting push gateways), or because an interceptor here was already
		// proven dead on this stack (the seeder; see the comment above).
		// Without a web UI there is no store yet, so the app gets the default one, migrated at start.
		var chatDatabase = webUiResult.webUiDatabase ?: {}
		// Issued tokens and the chats of gateways both live there
		var needsStore = ( ( effectiveAgentApi.tokens ?: false ) && ( effectiveAgentApi.enabled ?: true ) ) || len( gatewayResult.sessionStartupStatement ?: "" )
		if ( needsStore && chatDatabase.isEmpty() ) {
			chatDatabase = { datasource : "bxagents", path : "./data/chat.db" }
		}
		// A hosted MCP server looks its tools up in the registry (aiToolRegistry().get( "name" )), so the scan must run
		// before its registration: the generator emits the MCP registrations ahead of the other startup statements.
		var scanBeforeMcp = mcpResult.registrations.len() && toolScanStatements.len()
		var mcpStatements = scanBeforeMcp ? toolScanStatements.duplicate().append( mcpResult.registrations, true ) : mcpResult.registrations
		var startupStatements = scanBeforeMcp ? [] : toolScanStatements.duplicate()
		// Extensions first: the gateway session and the web page answer commands with the registry this puts in place
		var extensionsResult = variables.extensionsGenerator.generate( root, appDir, config )
		if ( extensionsResult.hasExtensions ) {
			arguments.onProgress( "+ Copying extensions/ into the app..." )
			startupStatements.append( extensionsResult.startupStatement )
		}
		if ( len( gatewayResult.sessionStartupStatement ?: "" ) ) {
			startupStatements.append( gatewayResult.sessionStartupStatement )
		}
		// Order matters: the seeder writes into tables this warms/migrates.
		if ( len( webUiResult.webUiWarmStatement ?: "" ) ) {
			startupStatements.append( webUiResult.webUiWarmStatement )
		}
		if ( len( webUiResult.webUiSeedStatement ?: "" ) ) {
			startupStatements.append( webUiResult.webUiSeedStatement )
		}
		if ( needsStore && !len( webUiResult.webUiWarmStatement ?: "" ) ) {
			startupStatements.append( 'new "models.store.ChatStore@bxagents"( "" ).migrate()' )
		}

		arguments.onProgress( "+ Generating core ColdBox app skeleton (Application.bx, config/WireBox.bx, config/ColdBox.bx, agent/GeneratedAgentFactory.bx)..." )
		var coldboxResult = variables.coldboxAppGenerator.generate(
			projectRoot           = root,
			buildDir              = appDir,
			resolvedConfig        = config,
			agentInterceptors     = agentInterceptorNames,
			projectInterceptors   = projectInterceptorNames,
			gatewayRegistrations  = gatewayResult.registrationStatements,
			mcpRegistrations      = mcpStatements,
			extraStartupStatements = startupStatements,
			cliEnvironment        = arguments.cliEnvironment,
			discovery             = discovery,
			hasEmailGateway       = gatewayResult.hasEmailGateway ?: false,
			// Drives BOTH session management in Application.bx and the
			// session-scoped memory default: a browser-facing app needs a real
			// HTTP session, because that session is what separates one visitor's
			// conversation from another's.
			hasWebUi              = webUiResult.hasWebUi ?: false,
			// { datasource, path } for the web UI's SQLite store - drives both
			// this.datasources in Application.bx and moduleSettings.qb
			webUiDatabase         = chatDatabase,
			webUiHasUsers         = webUiResult.webUiHasUsers ?: false,
			// Registered through this.schedulers in the generated base Application
			schedulerClasses      = variables.schedulerGenerator.classPaths( discovery ),
			// The developer's own Application.bx, copied as it is; absent, the app gets one that only extends the base
			userApplicationPath   = fileExists( root & "/Application.bx" ) ? root & "/Application.bx" : "",
			publicDir             = publicDir
		)
		var agentNames = coldboxResult.agentNodes.map( function( n ) { return n.name } )
		arguments.onProgress( "    agents registered in WireBox (getInstance-able by name): #agentNames.toList( ', ' )#" )

		arguments.onProgress( "+ Copying tools/ and skills/..." )
		variables.toolsSkillsCopier.copy( root, appDir )
		// the definition and the instructions travel too, so the admin Files tab can show them from the served app
		variables.projectFilesCopier.copy( root, appDir )

		// BoxLang modules the developer installed in the project (boxlang_modules/, by CommandBox or
		// `install-bx-module --local`) travel with the app, so `serve` and a packaged .bxa carry them
		var modulesResult = variables.boxLangModulesCopier.copy( root, buildDir )
		if ( modulesResult.copied.len() || modulesResult.skipped.len() ) {
			arguments.onProgress( "+ Copying boxlang_modules/ into .build..." )
			arguments.onProgress( "    copied=#modulesResult.copied.toList( ', ' )#" & ( modulesResult.skipped.len() ? ", left out (devDependencies)=#modulesResult.skipped.toList( ', ' )#" : "" ) )
		}

		arguments.onProgress( "+ Copying bundled ColdBox runtime libraries..." )
		var libsResult = variables.runtimeLibsCopier.copy( libDir = layout.libDir, projectRoot = root, bundledLibsDir = variables.libsDir )
		if ( libsResult.bundled ) {
			arguments.onProgress( "    #libsResult.copied.toList( ', ' )#" )
		} else {
			arguments.onProgress( "    ! this BX Agents install has no bundled lib/ (source checkout?) - ColdBox and its modules must already be resolvable" )
		}

		// Only the bxagents module goes into runtime/modules: the one module the served app needs, with the modules nested in it.
		// Never the machine's own module folder, which would load every module installed there.
		var moduleResult = variables.moduleCopier.copy( variables.moduleCopier.sourceDir( variables.moduleDir ), layout.runtimeDir )
		if ( moduleResult.reason == "copied" ) {
			arguments.onProgress( "+ Copied the bxagents module into .build/runtime/modules" )
		} else if ( moduleResult.reason == "unchanged" ) {
			arguments.onProgress( "+ The bxagents module in .build/runtime/modules is up to date" )
		} else {
			arguments.onProgress( "    ! no installed bxagents module to copy (source checkout?) - a served app needs the module in .build/runtime/modules" )
		}

		// The server config a deployed or packaged copy starts from; `serve` writes its own with the port and host asked for
		variables.miniServerJson.write( buildDir, 8080, "127.0.0.1" )

		var schedulerResult = variables.schedulerGenerator.generate( discovery, appDir )
		if ( schedulerResult.schedulers.len() ) {
			arguments.onProgress( "+ Copying schedules/ (#schedulerResult.schedulers.map( s => s.name ).toList( ', ' )#)..." )
		} else {
			arguments.onProgress( "+ No schedules/*.bx found - skipping schedulers" )
		}

		arguments.onProgress( "+ Normalizing and writing the manifest..." )
		var manifest = variables.manifestNormalizer.normalize( root, discovery, config )
		var manifestPath = buildDir & "/manifest.json"
		fileWrite( manifestPath, jsonSerialize( manifest ) )
		arguments.onProgress( "    #manifest.files.len()# file(s) tracked" )

		arguments.onProgress( "+ Build completed in #( getTickCount() - buildStart )#ms" )

		return {
			projectRoot  : root,
			buildDir     : buildDir,
			appDir       : appDir,
			publicDir    : publicDir,
			libDir       : layout.libDir,
			runtimeDir   : layout.runtimeDir,
			template     : template,
			module       : moduleResult,
			manifestPath : manifestPath,
			manifest     : manifest,
			warnings     : validation.warnings
		}
	}


}
