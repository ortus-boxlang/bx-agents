/**
 * The agent API as the build sees it: `agentApi` from the agent's config, plus what a web UI entry in `gateways/` brings
 * with it, because the page calls this API and so is part of who may call it and what it may offer:
 *
 *   webAccounts   true when a web UI entry lists `users`: a page with accounts must not sit in front of an API that
 *                 anyone can call, so the API then needs a sign-in (see api.AccessMode)
 *   tokenEnvVar   the entry's `apiKeyEnvVar` when the agent's own config names none: the page's key is the API's secret
 *   profiles      the entry's `profiles` when the agent's own config offers none
 */
import bxModules.bxagents.models.util.EntryConfigReader;

class {

	/**
	 * @agentApi The `agentApi` block of the agent's config
	 * @discovery The discovery struct
	 *
	 * @return The same block with what the web UI entries add: what every part of the build that asks AccessMode should be given
	 */
	static struct function effective( struct agentApi = {}, required struct discovery ) {
		var effective = duplicate( arguments.agentApi )
		effective[ "webAccounts" ] = false
		for ( var entry in webEntries( arguments.discovery ) ) {
			if ( isArray( entry.users ?: "" ) && entry.users.len() ) {
				effective[ "webAccounts" ] = true
			}
			if ( !len( trim( effective.tokenEnvVar ?: "" ) ) && len( trim( entry.apiKeyEnvVar ?: "" ) ) ) {
				effective[ "tokenEnvVar" ] = trim( entry.apiKeyEnvVar )
			}
			if ( !( isArray( effective.profiles ?: "" ) && effective.profiles.len() ) && isArray( entry.profiles ?: "" ) && entry.profiles.len() ) {
				effective[ "profiles" ] = entry.profiles
			}
		}
		return effective
	}

	/**
	 * @discovery The discovery struct
	 *
	 * @return True when a gateways/ entry exposes the web UI
	 */
	static boolean function hasWebUi( required struct discovery ) {
		return webEntries( arguments.discovery ).len() > 0
	}

	/**
	 * @return The config of every `exposes: "webui"` entry
	 */
	private static array function webEntries( required struct discovery ) {
		var found = []
		for ( var gateway in ( arguments.discovery.gateways ?: [] ) ) {
			var config = EntryConfigReader::read( gateway.path )
			if ( !isNull( config ) && ( config.exposes ?: "" ) == "webui" ) {
				found.append( config )
			}
		}
		return found
	}

}
