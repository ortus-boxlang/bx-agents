/**
 * Resolves a BX Agents project's full build-time configuration (Build Pipeline Phase 1).
 *
 * Agent.bx comes in two shapes, and this resolver handles both:
 *
 *   DESCRIPTOR - a plain class whose configure() returns a config struct. The
 *                build renders an `aiAgent( ... )` call from it.
 *   CLASS-BASED - a class that `extends` bx-ai's own AiAgent, so it IS the
 *                agent. The build instantiates it rather than rebuilding one,
 *                and layers conventions on top. configure() is OPTIONAL here:
 *                a class-based agent that declares everything in its own
 *                init() needs no config struct at all.
 *
 * Merges, in increasing precedence:
 *   1. Agent.bx's configure()  (optional for a class-based Agent.bx)
 *   2. Agent.bx's environment() override method (e.g. development(), production())
 *   3. boxlang.json
 *   4. boxlang-{environment}.json
 *   5. miniserver.json
 *   6. miniserver-{environment}.json
 *
 * Struct keys are merged recursively; arrays and scalars are REPLACED (not appended/merged)
 * by a higher-precedence value. Secrets are never read/merged here - they stay external
 * (OS env, .env, platform secret manager) and are resolved by bx-ai itself at runtime.
 */
class {

	property name="environmentResolver";

	/**
	 * @return this
	 */
	function init() {
		// "@bxagents" suffix, not a bare "EnvironmentResolver" reference - see
		// BuildPipeline.bx's init() docblock for why.
		variables.environmentResolver = new "models.build.EnvironmentResolver@bxagents"()
		return this
	}

	/**
	 * Resolve a project's full build-time configuration.
	 *
	 * @projectRoot Absolute path to the project root (containing Agent.bx)
	 * @cliEnvironment Optional environment name passed explicitly (e.g. via a CLI flag)
	 * @boxContext The current BoxLang execution context. Defaults to the shared runtime context; only override this if you have a more specific one (e.g. from a CLI's main()).
	 *
	 * @return The fully merged config struct, plus a resolved "environment" key
	 */
	struct function resolve( required string projectRoot, string cliEnvironment = "", any boxContext ) {
		var normalizedRoot = arguments.projectRoot.reReplace( "[\\/]+$", "" )
		var agentBxPath = normalizedRoot & "/Agent.bx"
		var context = isNull( arguments.boxContext ) ? getDefaultContext() : arguments.boxContext

		if ( !fileExists( agentBxPath ) ) {
			throw(
				type    = "BxAgents.MissingAgentDescriptor",
				message = "No Agent.bx found at [#agentBxPath#]"
			)
		}

		var environment			= variables.environmentResolver.resolve( arguments.cliEnvironment )
		var agentDescriptor		= loadAgentDescriptor( agentBxPath, context )
		var isClassBased		= isClassBasedAgent( agentDescriptor )

		var baseConfig			= invokeConfigure( agentDescriptor, agentBxPath, isClassBased )
		var envOverrides		= invokeEnvironmentOverride( agentDescriptor, environment, agentBxPath )

		var config = deepMerge( baseConfig, envOverrides )
		config = deepMerge( config, readJsonConfig( normalizedRoot, "boxlang" ) )
		config = deepMerge( config, readJsonConfig( normalizedRoot, "boxlang", environment ) )
		config = deepMerge( config, readJsonConfig( normalizedRoot, "miniserver" ) )
		config = deepMerge( config, readJsonConfig( normalizedRoot, "miniserver", environment ) )

		config[ "environment" ] = environment

		// Recorded AFTER the merge so no config file can fake it - whether this
		// node is class-based is a fact about the loaded class, never a setting.
		// The generator branches on it. It never reaches manifest.json: that is
		// built from an explicit allowlist of four fields (ManifestNormalizer's
		// buildAgentSummary), not by stripping - so nothing here can leak into it.
		config[ "classBasedAgent" ] = isClassBased
		if ( isClassBased ) {
			// Only the checkpointer needs a runtime look at the instance: it is
			// the one thing the build injects a default for even when the config
			// declares nothing (a gateway-attached agent without a checkpointer
			// has silently broken HITL - see ColdBoxAppGenerator), so the build
			// has to know whether the class already set one.
			config[ "classHasCheckpointer" ] = classHasCheckpointer( agentDescriptor )
		}

		return config
	}

	/**
	 * @return The shared runtime's own BoxLang execution context
	 */
	private function getDefaultContext() {
		return createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()
	}

	/**
	 * @agentBxPath Absolute path to the project's Agent.bx
	 * @boxContext The BoxLang execution context to instantiate it within
	 *
	 * @return The instantiated Agent.bx instance
	 */
	private function loadAgentDescriptor( required string agentBxPath, required any boxContext ) {
		try {
			return createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
				.instantiate( arguments.agentBxPath, arguments.boxContext )
		} catch ( any e ) {
			throw(
				type    = "BxAgents.InvalidAgentDescriptor",
				message = "Agent.bx at [#arguments.agentBxPath#] failed to load: #e.message#"
			)
		}
	}

	/**
	 * Is this Agent.bx a class-based agent - i.e. does it extend bx-ai's AiAgent
	 * and therefore ARE the agent, rather than describing one?
	 *
	 * Checked with isInstanceOf against the real class rather than by looking for
	 * an `extends` attribute or a method name, so a project that subclasses its
	 * OWN AiAgent subclass is still recognised.
	 *
	 * @agentDescriptor The instantiated Agent.bx instance, from loadAgentDescriptor()
	 *
	 * @return true when the instance is an AiAgent
	 */
	private boolean function isClassBasedAgent( required any agentDescriptor ) {
		return isInstanceOf( arguments.agentDescriptor, "bxModules.bxai.models.runnables.AiAgent" )
	}

	/**
	 * Does a class-based Agent.bx already carry a checkpointer of its own?
	 *
	 * @agentDescriptor The instantiated Agent.bx instance - MUST be class-based
	 *
	 * @return true when the class set a checkpointer in its own init()
	 */
	private boolean function classHasCheckpointer( required any agentDescriptor ) {
		try {
			return !isNull( arguments.agentDescriptor.getCheckpointer() )
		} catch ( any e ) {
			// Never fail a build over an introspection call - if it cannot be
			// read, treat it as absent and let the build inject its default.
			return false
		}
	}

	/**
	 * @agentDescriptor The instantiated Agent.bx instance, from loadAgentDescriptor()
	 * @agentBxPath Absolute path to Agent.bx, for error message context
	 * @isClassBased Whether this Agent.bx IS an agent (extends AiAgent), which makes configure() optional
	 *
	 * @return The struct returned by Agent.bx's configure(), or {} when a class-based Agent.bx declares none
	 */
	private function invokeConfigure( required any agentDescriptor, required string agentBxPath, boolean isClassBased = false ) {
		// A class-based Agent.bx configures itself in its own init(); a config
		// struct is an optional extra there, not the point of the file. A
		// DESCRIPTOR Agent.bx with no configure() is still an error - it would
		// describe nothing at all.
		if ( arguments.isClassBased && !hasMethod( arguments.agentDescriptor, "configure" ) ) {
			return {}
		}

		try {
			var result = arguments.agentDescriptor.configure()
		} catch ( any e ) {
			throw(
				type    = "BxAgents.InvalidAgentDescriptor",
				message = "Agent.bx at [#arguments.agentBxPath#] threw from configure(): #e.message#"
			)
		}

		if ( !isStruct( result ) ) {
			throw(
				type    = "BxAgents.InvalidAgentDescriptor",
				message = "Agent.bx at [#arguments.agentBxPath#]'s configure() must return a struct"
			)
		}

		return result
	}

	/**
	 * @agentDescriptor The instantiated Agent.bx instance, from loadAgentDescriptor()
	 * @environment The resolved environment name, e.g. "production" - looked up as a method name on agentDescriptor
	 * @agentBxPath Absolute path to Agent.bx, for error message context
	 *
	 * @return The struct returned by the matching environment-override method, or {} if Agent.bx declares no such method
	 */
	private function invokeEnvironmentOverride( required any agentDescriptor, required string environment, required string agentBxPath ) {
		if ( !hasMethod( arguments.agentDescriptor, arguments.environment ) ) {
			return {}
		}

		try {
			var result = invoke( arguments.agentDescriptor, arguments.environment, {} )
		} catch ( any e ) {
			throw(
				type    = "BxAgents.InvalidAgentDescriptor",
				message = "Agent.bx at [#arguments.agentBxPath#] threw from environment override [#arguments.environment#()]: #e.message#"
			)
		}

		if ( !isStruct( result ) ) {
			throw(
				type    = "BxAgents.InvalidAgentDescriptor",
				message = "Agent.bx at [#arguments.agentBxPath#]'s [#arguments.environment#()] override must return a struct"
			)
		}

		return result
	}

	/**
	 * @instance Any object instance
	 * @methodName The method name to look for, case-insensitive
	 *
	 * @return True if instance declares a function with that name
	 */
	private boolean function hasMethod( required any instance, required string methodName ) {
		var meta = getMetaData( arguments.instance )
		var functions = meta.functions ?: []
		var targetName = arguments.methodName.lcase()
		return functions.some( fn => fn.name.lcase() == targetName )
	}

	/**
	 * Reads an optional `{baseName}.json` or `{baseName}-{environment}.json`
	 * file from the project root - "" environment reads the base file.
	 *
	 * @projectRoot Absolute path to the project root
	 * @baseName The config file's base name, e.g. "boxlang" or "miniserver"
	 * @environment Optional environment suffix; "" reads the base (non-suffixed) file
	 *
	 * @return The parsed JSON object as a struct, or {} if the file doesn't exist
	 */
	private struct function readJsonConfig( required string projectRoot, required string baseName, string environment = "" ) {
		var fileName = len( arguments.environment ) ? "#arguments.baseName#-#arguments.environment#.json" : "#arguments.baseName#.json"
		var filePath = arguments.projectRoot & "/" & fileName

		if ( !fileExists( filePath ) ) {
			return {}
		}

		try {
			var parsed = jsonDeserialize( fileRead( filePath ) )
		} catch ( any e ) {
			throw(
				type    = "BxAgents.InvalidJsonConfig",
				message = "Failed to parse [#filePath#] as JSON: #e.message#"
			)
		}

		if ( !isStruct( parsed ) ) {
			throw(
				type    = "BxAgents.InvalidJsonConfig",
				message = "[#filePath#] must contain a JSON object at the top level"
			)
		}

		return parsed
	}

	/**
	 * Recursively merges `overrides` on top of `base`. Struct keys merge
	 * recursively when both sides are structs; arrays and every other
	 * scalar value are REPLACED wholesale by the override, never appended/merged.
	 *
	 * @base The lower-precedence struct
	 * @overrides The higher-precedence struct, merged on top
	 *
	 * @return A new, merged struct - neither input is mutated
	 */
	private struct function deepMerge( required struct base, required struct overrides ) {
		var merged = duplicate( arguments.base )

		for ( var key in arguments.overrides ) {
			var overrideValue = arguments.overrides[ key ]

			if ( isStruct( overrideValue ) && structKeyExists( merged, key ) && isStruct( merged[ key ] ) ) {
				merged[ key ] = deepMerge( merged[ key ], overrideValue )
			} else {
				// Arrays (and all other scalar values) are REPLACED, not appended/merged
				merged[ key ] = overrideValue
			}
		}

		return merged
	}

}
