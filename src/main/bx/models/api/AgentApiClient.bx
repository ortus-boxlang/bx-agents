/**
 * A BoxLang client for the agent API: call a running agent from your own code, with the same routes the web page and
 * the terminal use.
 *
 * ```
 * client = new bxModules.bxagents.models.api.AgentApiClient( url = "http://127.0.0.1:8080", token = getSystemSetting( "AGENT_TOKEN", "" ) )
 *
 * answer = client.invoke( "Summarize today's tickets" )
 * println( answer.output )
 *
 * client.stream( "Write a haiku", ( piece ) => print( piece ), conversationId = answer.threadId )
 * ```
 *
 * Every method answers the parsed JSON of the route (a struct with `success`), or for the streams a struct of what the
 * run produced. A bad request comes back as `{ success : false, error, code }`; a refused token, a missing route and a
 * server that fails are thrown:
 *
 *   BxAgents.AgentApiUnauthorized   the server wants a token this client did not send, or a wrong one
 *   BxAgents.AgentRouteMissing      the server has no such route (an older server, or tokens not managed over the API)
 *   BxAgents.AgentStreamFailed      the server answered some other failure
 *
 * Which methods exist follows ApiContract: a spec fails when a route has no method here.
 */
import bxModules.bxagents.models.cli.support.AgentClient;

class {

	/**
	 * @url The server root, for example "http://127.0.0.1:8080"
	 * @token The shared secret or an access token; blank when the server is open
	 * @path Where the server serves its API when it is not "/__bxagents" (agentApi.path)
	 * @source What to call this program: kept with each conversation it starts, and shown in lists. A plain name.
	 * @timeout Seconds to wait for an answer; a stream may run this long between the first and the last frame
	 */
	function init( required string url, string token = "", string path = "", string source = "api", numeric timeout = 120 ) {
		variables.url = arguments.url.reReplace( "[\/]+$", "" )
		variables.timeout = arguments.timeout
		variables.http = new AgentClient().withSource( arguments.source )
		if ( len( trim( arguments.token ) ) ) {
			variables.http.withToken( arguments.token )
		}
		if ( len( trim( arguments.path ) ) ) {
			variables.http.withPath( arguments.path )
		}
		return this
	}

	// ---- Turns -------------------------------------------------------------------

	/**
	 * One whole turn.
	 *
	 * @input What to say to the agent
	 * @conversationId Carries on a conversation; blank starts a new one
	 * @options Per request options, for example { profile : "quick" } (a profile the server offers)
	 *
	 * @return { success, output, threadId }
	 */
	struct function invoke( required string input, string conversationId = "", struct options = {}, string agent = "" ) {
		return post( "invoke", turn( arguments.input, arguments.conversationId, arguments.options, arguments.agent ), variables.timeout )
	}

	/**
	 * One turn as a stream of text.
	 *
	 * @input What to say
	 * @onChunk Called with each piece of text as it arrives; optional
	 * @conversationId Carries on a conversation; blank starts a new one
	 * @options As invoke()
	 *
	 * @return { output, threadId, suspended, pending, error }
	 */
	struct function stream( required string input, any onChunk, string conversationId = "", struct options = {}, string agent = "" ) {
		var sink = arguments.onChunk ?: nullValue()
		var onEvent = ( event ) => {
			if ( !isNull( sink ) && ( event.type ?: "" ) == "delta" ) {
				sink( event.text )
			}
		}
		return variables.http.events( variables.url, "stream", turn( arguments.input, arguments.conversationId, arguments.options, arguments.agent ), variables.timeout, onEvent )
	}

	/**
	 * One turn as the full event stream: text, tool calls, a pause for approval, an error.
	 *
	 * @input What to say
	 * @onEvent Called with each event: { type : "thread" | "delta" | "reasoning" | "tool" | "suspended" | "error", ... }; "delta" has the text
	 * @conversationId Carries on a conversation; blank starts a new one
	 * @options As invoke()
	 *
	 * @return { output, threadId, suspended, pending, error }; when `suspended` is true, answer with resume()
	 */
	struct function events( required string input, any onEvent, string conversationId = "", struct options = {}, string agent = "" ) {
		return variables.http.events(
			variables.url,
			"events",
			turn( arguments.input, arguments.conversationId, arguments.options, arguments.agent ),
			variables.timeout,
			arguments.onEvent ?: nullValue()
		)
	}

	/**
	 * Several inputs, one after another, in one conversation.
	 *
	 * @inputs An array of strings
	 *
	 * @return { success, outputs, threadId }
	 */
	struct function batch( required array inputs, string conversationId = "", struct options = {}, string agent = "" ) {
		var body = { "inputs" : arguments.inputs, "options" : arguments.options }
		if ( len( arguments.agent ) ) {
			body[ "agent" ] = arguments.agent
		}
		if ( len( arguments.conversationId ) ) {
			body[ "conversationId" ] = arguments.conversationId
		}
		return post( "batch", body, variables.timeout )
	}

	/**
	 * Carries on a run that paused for approval.
	 *
	 * @threadId The run's id, from the answer that was suspended
	 * @decision approve, reject or edit
	 * @onEvent As events(); optional
	 * @editedData The changed arguments, for `edit`
	 * @reason Why, for `reject`
	 *
	 * @return As events()
	 */
	struct function resume( required string threadId, required string decision, any onEvent, struct editedData = {}, string reason = "", string agent = "" ) {
		var body = { "threadId" : arguments.threadId, "decision" : arguments.decision }
		if ( len( arguments.agent ) ) {
			body[ "agent" ] = arguments.agent
		}
		if ( !arguments.editedData.isEmpty() ) {
			body[ "editedData" ] = arguments.editedData
		}
		if ( len( arguments.reason ) ) {
			body[ "reason" ] = arguments.reason
		}
		return variables.http.events( variables.url, "resume", body, variables.timeout, arguments.onEvent ?: nullValue() )
	}

	/** Stops a run. Only the caller who started it may, or an admin. `agent` names the sub-agent the run was talking to, if any. */
	struct function cancel( required string threadId, string reason = "", string agent = "" ) {
		return post( "cancel", { "threadId" : arguments.threadId, "reason" : arguments.reason }.append( withAgent( arguments.agent ) ) )
	}

	/** Adds a message to a run that is going. */
	struct function steer( required string threadId, required string input, string agent = "" ) {
		return post( "steer", { "threadId" : arguments.threadId, "input" : arguments.input }.append( withAgent( arguments.agent ) ) )
	}

	/** What a paused run waits to have approved. */
	struct function pending( required string threadId, string agent = "" ) {
		return get( "pending", { threadId : arguments.threadId }.append( withAgent( arguments.agent ) ) )
	}

	// ---- About the agent -----------------------------------------------------------

	/** What is served: name, model and routes. */
	struct function info() {
		return get( "info" )
	}

	/** The agent in full, with what this server can do (`capabilities`). */
	struct function about() {
		return get( "agent" )
	}

	/** The tools the agent has. */
	struct function tools() {
		return get( "tools" )
	}

	/** The models this server lets a caller ask for with options.profile. */
	struct function profiles() {
		return get( "profiles" )
	}

	/** Is the server up. Needs no token. */
	struct function health() {
		return get( "health" )
	}

	/** Who the server takes this client to be: { id, scope, source }. */
	struct function whoami() {
		return get( "whoami" )
	}

	/** The folders the agent may use: { volumes : [ { name, mode, description } ] }. Never a folder on the machine. */
	struct function volumes() {
		return get( "volumes" )
	}

	/** The agent's logs, for an admin token: no area lists them, an area gives its last lines. level and q filter. */
	struct function logs( string area = "", numeric tail = 200, string level = "", string q = "" ) {
		var query = {}
		if ( len( arguments.area ) ) {
			query[ "area" ] = arguments.area
			query[ "tail" ] = arguments.tail
		}
		if ( len( arguments.level ) ) {
			query[ "level" ] = arguments.level
		}
		if ( len( arguments.q ) ) {
			query[ "q" ] = arguments.q
		}
		return get( "logs", query )
	}

	/** The chat apps and the state of each: { gateways : [ ... ] }. An admin token only. */
	struct function gateways() {
		return get( "gateways" )
	}

	/** Stops and starts one chat app in place: { gateway : the fresh row }. An admin token only. */
	struct function reconnectGateway( required string name ) {
		return post( "gateways/reconnect", { "name" : arguments.name } )
	}

	/** The skills the agent can load: { skills : [ { name, description, origin } ] }, origin being project or agent. Never a folder on the machine. */
	struct function skills() {
		return get( "skills" )
	}

	/** One skill's text: { name, description, origin, size, savedAt, body, truncated }. 404 when there is none by that name. */
	struct function readSkill( required string name ) {
		return get( "skills/read", { name : arguments.name } )
	}

	/** The caller's routines: { routines : [ ... ] }. An admin may pass all to see everyone's. 404 when routines are off. */
	struct function routines( boolean all = false ) {
		return get( "routines", arguments.all ? { "all" : 1 } : {} )
	}

	/** One routine with its prompt: { routine }. */
	struct function routine( required string name ) {
		return get( "routines/get", { "name" : arguments.name } )
	}

	/**
	 * Makes a routine.
	 *
	 * @name Folder-style, up to 40 characters
	 * @schedule A cron expression or every 30m
	 * @prompt What to tell the agent each time
	 * @destination Blank for the default, routine, or gateway:<name>
	 * @chat The chat id on that chat app, when asked for
	 */
	struct function createRoutine( required string name, required string schedule, required string prompt, string destination = "", string chat = "" ) {
		var body = { "name" : arguments.name, "schedule" : arguments.schedule, "prompt" : arguments.prompt }
		if ( len( arguments.destination ) ) {
			body[ "destination" ] = arguments.destination
		}
		if ( len( arguments.chat ) ) {
			body[ "chat" ] = arguments.chat
		}
		return post( "routines", body )
	}

	/** Changes a routine. Pass only what changes: schedule, prompt, destination, chat. */
	struct function updateRoutine( required string name, struct changes = {} ) {
		var body = { "name" : arguments.name }
		for ( var key in [ "schedule", "prompt", "destination", "chat" ] ) {
			if ( arguments.changes.keyExists( key ) ) {
				body[ key ] = arguments.changes[ key ]
			}
		}
		return post( "routines/update", body )
	}

	/** What a schedule means before it is saved: { value, text, nextRunText }, or a 400 with the sentence a save would give. */
	struct function describeSchedule( required string cadence ) {
		return get( "routines/schedule", { "schedule" : arguments.cadence } )
	}

	/** Stops a routine from running until it is resumed. */
	struct function pauseRoutine( required string name ) {
		return post( "routines/pause", { "name" : arguments.name } )
	}

	/** Starts a paused routine again. */
	struct function resumeRoutine( required string name ) {
		return post( "routines/resume", { "name" : arguments.name } )
	}

	/** Makes a routine due now; the heartbeat of the served app starts it within a minute. */
	struct function runRoutine( required string name ) {
		return post( "routines/run", { "name" : arguments.name } )
	}

	/** Deletes a routine. Its conversation and reports stay. */
	struct function deleteRoutine( required string name ) {
		return post( "routines/delete", { "name" : arguments.name } )
	}

	/** The report files of a routine: { files, count, totalBytes }. */
	struct function routineReports( required string name ) {
		return get( "routines/reports", { "name" : arguments.name } )
	}

	/** One report file: { file, text, cut }. */
	struct function routineReport( required string name, required string file ) {
		return get( "routines/report", { "name" : arguments.name, "file" : arguments.file } )
	}

	/** Removes one report file. */
	struct function deleteRoutineReport( required string name, required string file ) {
		return post( "routines/reports/delete", { "name" : arguments.name, "file" : arguments.file } )
	}

	/**
	 * Removes the reports of a routine older than some days, or all of them. Without apply it only says what it would remove.
	 *
	 * @name The routine
	 * @olderThanDays Files saved more than this many days ago
	 * @all Every file
	 * @apply True to really remove them
	 */
	struct function cleanRoutineReports( required string name, numeric olderThanDays = 0, boolean all = false, boolean apply = false ) {
		var body = { "name" : arguments.name, "all" : arguments.all, "apply" : arguments.apply }
		if ( arguments.olderThanDays > 0 ) {
			body[ "olderThanDays" ] = arguments.olderThanDays
		}
		return post( "routines/reports/clean", body )
	}

	/** Where the agent keeps everything, and where each volume is. An admin token only. */
	struct function data() {
		return get( "data" )
	}

	/** The sign-in accounts and whether each is an admin. An admin only. */
	struct function users() {
		return get( "users" )
	}

	/** Makes an account an admin, or takes that away. An admin only; the last admin cannot be demoted. */
	struct function setUserAdmin( required string username, required boolean admin ) {
		return post( "users/admin", { "username" : arguments.username, "admin" : arguments.admin } )
	}

	/** Asks a model for one word, to see that it answers. */
	struct function ping( string profile = "" ) {
		return post( "ping", len( arguments.profile ) ? { "profile" : arguments.profile } : {} )
	}

	/** What the next turn would send, by part, against the model's window. */
	struct function context( string conversationId = "" ) {
		return get( "context", withConversation( arguments.conversationId ) )
	}

	/** The status items that extensions show. */
	struct function status( string conversationId = "" ) {
		return get( "status", withConversation( arguments.conversationId ) )
	}

	/** What extensions put in the page's slots. */
	struct function slots( string conversationId = "" ) {
		return get( "slots", withConversation( arguments.conversationId ) )
	}

	/** This API as an OpenAPI 3 document. */
	struct function openapi() {
		return get( "openapi" )
	}

	// ---- Commands -------------------------------------------------------------------

	/** The slash commands this caller may run. */
	struct function commands() {
		return get( "commands" )
	}

	/**
	 * Runs a slash command.
	 *
	 * @line The whole line, for example "/context"
	 */
	struct function command( required string line, string conversationId = "" ) {
		var body = { "line" : arguments.line }
		if ( len( arguments.conversationId ) ) {
			body[ "conversationId" ] = arguments.conversationId
		}
		return post( "command", body )
	}

	// ---- Conversations ----------------------------------------------------------------

	/**
	 * A page of the caller's conversations, newest first: { sessions, total, limit, offset, facets? }.
	 *
	 * @limit How many (at most 100)
	 * @source Only the ones started from this surface
	 * @all An admin only: everyone's, with whose each is
	 * @offset How many to skip, for the next page
	 * @q Only those whose title contains this text
	 * @agent Only those that started with this agent
	 * @since Only those active on or after this date (ISO 8601)
	 * @before Only those active before this date (ISO 8601)
	 * @facets True to also get the counts per source and per agent
	 */
	struct function sessions(
		numeric limit = 25,
		string source = "",
		boolean all = false,
		numeric offset = 0,
		string q = "",
		string agent = "",
		string since = "",
		string before = "",
		boolean facets = false
	) {
		var query = { limit : arguments.limit }
		for ( var key in [ "source", "q", "agent", "since", "before" ] ) {
			if ( len( arguments[ key ] ) ) {
				query[ key ] = arguments[ key ]
			}
		}
		if ( arguments.offset > 0 ) {
			query[ "offset" ] = arguments.offset
		}
		if ( arguments.all ) {
			query[ "all" ] = 1
		}
		if ( arguments.facets ) {
			query[ "facets" ] = 1
		}
		return get( "sessions", query )
	}

	/** Starts a conversation. */
	struct function createSession( string title = "", string agent = "" ) {
		var body = len( arguments.title ) ? { "title" : arguments.title } : {}
		return post( "sessions", body.append( withAgent( arguments.agent ) ) )
	}

	/** Names a conversation. */
	struct function renameSession( required string conversationId, required string title ) {
		return post( "sessions/rename", { "conversationId" : arguments.conversationId, "title" : arguments.title } )
	}

	/** Copies a conversation under a new name. */
	struct function forkSession( required string conversationId, string title = "" ) {
		return post( "sessions/fork", { "conversationId" : arguments.conversationId, "title" : arguments.title } )
	}

	/** Deletes a conversation and its messages. */
	struct function deleteSession( required string conversationId ) {
		return post( "sessions/delete", { "conversationId" : arguments.conversationId } )
	}

	/** The messages of a conversation, as [ { role, text } ]. */
	struct function history( required string conversationId ) {
		return get( "history", withConversation( arguments.conversationId ) )
	}

	/**
	 * A conversation as a file.
	 *
	 * @format md or html
	 *
	 * @return The file's text
	 */
	string function export( required string conversationId, string format = "md" ) {
		return variables.http.getText( variables.url, "export", { conversationId : arguments.conversationId, format : arguments.format } )
	}

	/** Deletes the messages of a conversation and keeps the conversation. */
	struct function clear( string conversationId = "" ) {
		return post( "clear", len( arguments.conversationId ) ? { "conversationId" : arguments.conversationId } : {} )
	}

	/**
	 * Forgets the messages of conversations and keeps the conversations: one of the caller's, or with `all` (an admin's call)
	 * every conversation, or those that belong to one agent. Answers { conversations, messages }.
	 */
	struct function clearMemory( string conversationId = "", boolean all = false, string agent = "" ) {
		var body = {}
		if ( len( arguments.conversationId ) ) {
			body[ "conversationId" ] = arguments.conversationId
		}
		if ( arguments.all ) {
			body[ "all" ] = true
		}
		if ( len( arguments.agent ) ) {
			body[ "agent" ] = arguments.agent
		}
		return post( "memory/clear", body )
	}

	/** Summarizes older messages and keeps the recent ones. */
	struct function compact( string conversationId = "", numeric keepRecent = 0 ) {
		var body = {}
		if ( len( arguments.conversationId ) ) {
			body[ "conversationId" ] = arguments.conversationId
		}
		if ( arguments.keepRecent > 0 ) {
			body[ "keepRecent" ] = arguments.keepRecent
		}
		return post( "compact", body )
	}

	// ---- Notes and preferences -----------------------------------------------------------

	/** The notes about the caller and about the agent's own work. */
	struct function notes() {
		return get( "notes" )
	}

	/**
	 * @scope user (about the caller) or agent (about the agent's work, shared by everyone)
	 */
	struct function addNote( required string scope, required string text ) {
		return post( "notes", { "scope" : arguments.scope, "text" : arguments.text } )
	}

	struct function updateNote( required string scope, required string id, required string text ) {
		return post( "notes/update", { "scope" : arguments.scope, "id" : arguments.id, "text" : arguments.text } )
	}

	/** A note of the agent takes an admin. */
	struct function removeNote( required string scope, required string id ) {
		return post( "notes/remove", { "scope" : arguments.scope, "id" : arguments.id } )
	}

	/** Removes every note of one scope: user (the caller's own) or agent (an admin's). Answers { cleared : how many }. */
	struct function clearNotes( required string scope ) {
		return post( "notes/clear", { "scope" : arguments.scope } )
	}

	// ---- Connections ---------------------------------------------------------------------

	/** The servers that ask people to sign in, and which the caller has connected. */
	struct function connections() {
		return get( "connect" )
	}

	/**
	 * Starts a sign in for the caller.
	 *
	 * @name The server's name
	 *
	 * @return { name, authorizationUrl }
	 */
	struct function connect( required string name ) {
		return post( "connect", { "name" : arguments.name } )
	}

	/**
	 * Forgets the caller's sign in to one server.
	 *
	 * @name The server's name
	 */
	struct function removeConnection( required string name ) {
		return post( "connect/remove", { "name" : arguments.name } )
	}

	/**
	 * What a provider's redirect would do, for a program that catches the redirect itself and hands it on. Public.
	 *
	 * @code   The code
	 * @state  The state
	 * @issuer The iss, when the provider sent one
	 */
	struct function connectCallback( required string code, required string state, string issuer = "" ) {
		var query = { "code" : arguments.code, "state" : arguments.state }
		if ( len( arguments.issuer ) ) {
			query[ "iss" ] = arguments.issuer
		}
		return get( "connect/callback", query )
	}

	// ---- Vault ---------------------------------------------------------------------------

	/** The secrets the caller can use, by name: never a value. */
	struct function vault() {
		return get( "vault" )
	}

	/**
	 * Stores a secret. The value goes in once and is never returned.
	 *
	 * @scope user (the caller's own) or agent (shared; an admin)
	 * @fields { description, hosts }
	 */
	struct function addSecret( required string scope, required string name, required string value, struct fields = {} ) {
		var body = { "scope" : arguments.scope, "name" : arguments.name, "value" : arguments.value }
		body.append( arguments.fields )
		return post( "vault", body )
	}

	/** @changes { value, description, hosts }, any of them */
	struct function updateVault( required string scope, required string name, required struct changes ) {
		var body = { "scope" : arguments.scope, "name" : arguments.name }
		body.append( arguments.changes )
		return post( "vault/update", body )
	}

	struct function removeVault( required string scope, required string name ) {
		return post( "vault/remove", { "scope" : arguments.scope, "name" : arguments.name } )
	}

	/** The caller's settings. */
	struct function preferences() {
		return get( "preferences" )
	}

	struct function setPreference( required string key, required string value ) {
		return post( "preferences/set", { "key" : arguments.key, "value" : arguments.value } )
	}

	struct function deletePreference( required string key ) {
		return post( "preferences/delete", { "key" : arguments.key } )
	}

	// ---- Access tokens (an admin, on a server with agentApi.manageTokens) -------------------

	/** The access tokens, never a secret. */
	struct function tokens() {
		return get( "tokens" )
	}

	/**
	 * Makes an access token. The secret is in this answer and nowhere else.
	 *
	 * @scope chat or admin
	 * @expires How long it lasts ("90d"), or blank for never
	 *
	 * @return { success, token, name, scope, expiresAt }
	 */
	struct function createToken( required string name, string scope = "chat", string expires = "" ) {
		return post( "tokens", { "name" : arguments.name, "scope" : arguments.scope, "expires" : arguments.expires } )
	}

	/** Stops a token working. */
	struct function revokeToken( required string name ) {
		return post( "tokens/revoke", { "name" : arguments.name } )
	}

	// ---- inside ------------------------------------------------------------------------------

	private struct function get( required string route, struct query = {} ) {
		return variables.http.getJson( variables.url, arguments.route, arguments.query, 30 )
	}

	private struct function post( required string route, required struct body, numeric timeout = 30 ) {
		return variables.http.postJson( variables.url, arguments.route, arguments.body, arguments.timeout )
	}

	/** The body every turn route takes: only what was given is sent */
	private struct function turn( required string input, string conversationId, struct options, string agent = "" ) {
		var body = { "input" : arguments.input }
		if ( len( arguments.conversationId ?: "" ) ) {
			body[ "conversationId" ] = arguments.conversationId
		}
		if ( !( arguments.options ?: {} ).isEmpty() ) {
			body[ "options" ] = arguments.options
		}
		if ( len( arguments.agent ?: "" ) ) {
			body[ "agent" ] = arguments.agent
		}
		return body
	}

	private struct function withAgent( required string agent ) {
		return len( arguments.agent ) ? { agent : arguments.agent } : {}
	}

	private struct function withConversation( required string conversationId ) {
		return len( arguments.conversationId ) ? { conversationId : arguments.conversationId } : {}
	}

}
