/**
 * The list of a caller's conversations, and starting and deleting them. What happens inside one conversation
 * (history, rename, fork, compact, export) is AgentConversation's.
 */
import bxModules.bxagents.models.api.Outcome;

class {

	/**
	 * @agent The built agent, whose memory holds the messages
	 * @sessions A SessionStore
	 */
	function init( required any agent, required any sessions ) {
		variables.agent = arguments.agent
		variables.sessions = arguments.sessions
		return this
	}

	/**
	 * @caller The Caller
	 * @limit How many, newest first
	 * @source Only those that started there (`web`, `terminal`, `api`, a gateway's platform); all when blank
	 * @all True to list everyone's, for an admin: each row then also says whose it is (`userId`)
	 *
	 * @offset How many to skip, for the next page
	 * @q Only those whose title contains this text
	 * @agent Only those that started with this agent (a name from the agent tree)
	 * @since Only those active on or after this date
	 * @before Only those active before this date
	 * @facets True to also answer how many there are per source and per agent
	 *
	 * @return An Outcome: { sessions : [ { id, title, messageCount, source, agent, createdAt, updatedAt } ], total, limit, offset, facets? }, or forbidden.
	 *         `total` counts everything that matches, whatever the page holds; a blank `agent` on a stored row reads as the main agent's name
	 */
	any function list(
		required any caller,
		numeric limit = 25,
		string source = "",
		boolean all = false,
		numeric offset = 0,
		string q = "",
		string agent = "",
		string since = "",
		string before = "",
		boolean facets = false
	) {
		if ( arguments.all && !arguments.caller.isAdmin() ) {
			return Outcome::failed( "forbidden", "Only an admin may list everyone's conversations" )
		}
		var main = mainName()
		var filters = {
			limit  : arguments.limit,
			offset : arguments.offset,
			q      : arguments.q,
			source : arguments.source,
			since  : arguments.since,
			before : arguments.before,
			agent  : trim( arguments.agent ),
			mainAgent : main
		}
		var userId = arguments.all ? "" : arguments.caller.id()
		var found = variables.sessions.search( userId, filters )
		var data = {
			"sessions" : found.rows.map( row => stamped( row ) ),
			"total"    : found.total,
			"limit"    : found.limit,
			"offset"   : found.offset
		}
		if ( arguments.facets ) {
			var counts = variables.sessions.facets( userId, filters )
			var byAgent = {}
			for ( var name in counts.agent ) {
				var key = len( name ) ? name : main
				byAgent[ key ] = ( byAgent[ key ] ?: 0 ) + counts.agent[ name ]
			}
			data[ "facets" ] = { "source" : counts.source, "agent" : byAgent }
		}
		return Outcome::done( data )
	}

	/**
	 * @return The main agent's name, which a stored blank agent stands for
	 */
	private string function mainName() {
		try {
			return variables.agent.getAgentName() ?: ""
		} catch ( any e ) {
			return ""
		}
	}

	/**
	 * A copy of a stored row with its two times written as ISO 8601, as a client reads them, rather than as the date
	 * object the database gave.
	 */
	private struct function stamped( required struct row ) {
		var copy = duplicate( arguments.row )
		if ( structKeyExists( copy, "agent" ) && !len( copy.agent ) ) {
			copy.agent = mainName()
		}
		for ( var key in [ "createdAt", "updatedAt" ] ) {
			if ( isDate( copy[ key ] ?: "" ) ) {
				copy[ key ] = dateTimeFormat( copy[ key ], "yyyy-MM-dd'T'HH:mm:ss" )
			}
		}
		return copy
	}

	/**
	 * Checks that a conversation is the caller's before anything is read from or done to it. A conversation that does
	 * not exist and one that is somebody else's answer the same, so an id cannot be used to find out which.
	 *
	 * @return An Outcome: done( { conversationId } ), bad_request or not_found
	 */
	any function open( required any caller, required string conversationId ) {
		if ( !len( arguments.conversationId ) ) {
			return Outcome::failed( "bad_request", "conversationId is required" )
		}
		if ( variables.sessions.byId( arguments.caller.id(), arguments.conversationId ).isEmpty() ) {
			return Outcome::failed( "not_found", "There is no such conversation" )
		}
		return Outcome::done( { "conversationId" : arguments.conversationId } )
	}

	/**
	 * Starts a conversation and gives its id. The id is made here, never taken from the client: one the client
	 * chose could collide with a conversation that exists.
	 *
	 * @caller The Caller; the conversation records the surface it came in on
	 * @title What to call it; the first message names it when blank
	 * @agent The agent it belongs to (a name from the agent tree); blank for the main agent. A conversation keeps the agent it started with.
	 *
	 * @return An Outcome: { conversationId }
	 */
	any function create( required any caller, string title = "", string agent = "" ) {
		var id = createUUID()
		var owner = trim( arguments.agent )
		variables.sessions.touch( arguments.caller.id(), id, trim( arguments.title ), 0, arguments.caller.source(), owner == mainName() ? "" : owner )
		return Outcome::done( { "conversationId" : id } )
	}

	/**
	 * Deletes a conversation for real: its row and the messages the agent still holds for it. Dropping only the
	 * row would leave it out of sight but in the model's context the moment the id was used again.
	 *
	 * @return An Outcome: done, or not_found (it does not exist or is not the caller's: the same answer)
	 */
	any function delete( required any caller, required string conversationId ) {
		if ( !len( arguments.conversationId ) ) {
			return Outcome::failed( "bad_request", "conversationId is required" )
		}
		if ( !variables.sessions.delete( arguments.caller.id(), arguments.conversationId ) ) {
			return Outcome::failed( "not_found", "There is no such conversation" )
		}
		forget( arguments.caller.id(), arguments.conversationId )
		return Outcome::done( { "deleted" : true } )
	}

	/**
	 * Forgets a conversation's messages and keeps the conversation: the agent's memory of it is emptied and the
	 * count in the list goes to zero, together.
	 *
	 * @return An Outcome: { cleared : true }, bad_request or not_found
	 */
	any function clear( required any caller, required string conversationId ) {
		var opened = open( arguments.caller, arguments.conversationId )
		if ( !opened.succeeded() ) {
			return opened
		}
		forget( arguments.caller.id(), arguments.conversationId )
		variables.sessions.setCount( arguments.caller.id(), arguments.conversationId, 0 )
		return Outcome::done( { "cleared" : true } )
	}

	/**
	 * Clears conversation memory and keeps the conversations: one of the caller's, or (an admin's call) every
	 * conversation of one agent or of all of them. Each conversation's count in the list goes to zero with its messages.
	 *
	 * @caller The Caller
	 * @conversationId One of the caller's conversations; blank when `all` is set
	 * @all True to clear every conversation of every user: admin only
	 * @agent With `all`: only the conversations that belong to this agent (a name from the agent tree); every agent when blank
	 *
	 * @return An Outcome: { conversations, messages } (how many were cleared), bad_request, not_found or forbidden
	 */
	any function clearMemory( required any caller, string conversationId = "", boolean all = false, string agent = "" ) {
		if ( !arguments.all ) {
			if ( !len( arguments.conversationId ) ) {
				return Outcome::failed( "bad_request", "Say which conversation (conversationId), or all : true for every conversation" )
			}
			var opened = open( arguments.caller, arguments.conversationId )
			if ( !opened.succeeded() ) {
				return opened
			}
			var held = val( variables.sessions.byId( arguments.caller.id(), arguments.conversationId ).messageCount ?: 0 )
			clear( arguments.caller, arguments.conversationId )
			return Outcome::done( { "conversations" : 1, "messages" : held } )
		}
		if ( !arguments.caller.isAdmin() ) {
			return Outcome::failed( "forbidden", "Clearing the memory of every conversation needs an admin" )
		}
		// read every row first: clearing moves a row to the front of the list, which would shift the pages
		var rows = []
		var offset = 0
		while ( true ) {
			var page = variables.sessions.search( "", { limit : 100, offset : offset, agent : trim( arguments.agent ), mainAgent : mainName() } )
			rows.append( page.rows, true )
			offset += 100
			if ( offset >= page.total ) {
				break
			}
		}
		var messages = 0
		for ( var row in rows ) {
			messages += val( row.messageCount ?: 0 )
			forget( row.userId, row.id )
			variables.sessions.setCount( row.userId, row.id, 0 )
		}
		return Outcome::done( { "conversations" : rows.len(), "messages" : messages } )
	}

	/**
	 * Empties what every agent holds for one conversation: the agent it belongs to, and the sub-agents it delegated to
	 * (they keep their own memory under their own key, with the same conversation id).
	 */
	private void function forget( required string userId, required string conversationId ) {
		var userId = arguments.userId
		var id = arguments.conversationId
		for ( var node in new AgentTree( variables.agent ).agents() ) {
			node.getMemories().each( ( memory ) => memory.clear( userId, id ) )
		}
	}

	/**
	 * Sets the count in the list to what the agent's memory holds for the conversation. It is called whenever
	 * memory changed: after a turn, after compacting. The count is never added to, because a memory keeps at most
	 * `maxMessages` and compacting shrinks it.
	 *
	 * @return The number of messages the memory holds, which is now the count
	 */
	numeric function refreshCount( required any caller, required string conversationId ) {
		if ( !len( arguments.conversationId ) ) {
			return 0
		}
		var held = variables.agent.getMemoryMessages( arguments.caller.id(), arguments.conversationId ).len()
		variables.sessions.setCount( arguments.caller.id(), arguments.conversationId, held )
		return held
	}

}
