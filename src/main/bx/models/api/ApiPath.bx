/**
 * Where the agent API lives. One answer for the router, the validator, the web page and the terminal's `--connect`,
 * so they cannot drift apart.
 *
 * It is `agentApi.path` in the agent's config and `/__bxagents` when that is not set. The `__` in the default is what
 * keeps it clear of a project's own routes: the validator rejects any `gateways/*` entry whose own path falls on the
 * API's path, so a project's public API and this module's own channel can never collide.
 */
class {

	/** @return The path every built agent serves its API on unless told otherwise, with no trailing slash */
	static string function default() {
		return "/__bxagents"
	}

	/**
	 * @agentApi The `agentApi` block of the agent's config
	 *
	 * @return The path the API is served on: `path` from the block, else the default; no trailing slash
	 */
	static string function of( struct agentApi = {} ) {
		var configured = trim( arguments.agentApi.path ?: "" )
		return len( configured ) ? configured.reReplace( "[\/]+$", "" ) : ApiPath::default()
	}

	/**
	 * @path The configured value of `agentApi.path`
	 *
	 * @return What is wrong with it, as sentences; empty when it is fine
	 */
	static array function problems( required any path ) {
		if ( !isSimpleValue( arguments.path ) ) {
			return [ "Agent.bx's 'agentApi.path' must be a string" ]
		}
		var value = trim( arguments.path )
		if ( !len( value ) ) {
			return [ "Agent.bx's 'agentApi.path' must not be blank - leave it out for the default [#ApiPath::default()#]" ]
		}
		if ( !reFind( "^(/[A-Za-z0-9_~-]+)+/?$", value ) ) {
			return [ "Agent.bx's 'agentApi.path' [#value#] must start with '/' and have only segments of letters, digits, '_', '-' or '~' (e.g. ""/agent-api""); it becomes a route prefix and a JavaScript string" ]
		}
		return []
	}

	/**
	 * @appDir A built app folder
	 *
	 * @return The path that build serves its API on, read from what the build wrote (config/agentapi.json); the default when it says nothing
	 */
	static string function fromBuild( required string appDir ) {
		var file = arguments.appDir.reReplace( "[\/]+$", "" ) & "/config/agentapi.json"
		if ( !fileExists( file ) ) {
			return ApiPath::default()
		}
		try {
			return ApiPath::of( jsonDeserialize( fileRead( file ) ) )
		} catch ( any e ) {
			return ApiPath::default()
		}
	}

}
