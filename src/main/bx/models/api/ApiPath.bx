/**
 * Where the agent API lives. One answer for the router, the validator, the web page and the terminal's `--connect`,
 * so they cannot drift apart.
 *
 * The `__` prefix is what makes it reserved: the validator rejects any `gateways/*` entry whose own path falls under it,
 * so a project's public API and this module's own channel can never collide.
 */
class {

	/**
	 * @return The path every built agent serves its API on, with no trailing slash
	 */
	static string function reserved() {
		return "/__bxagents"
	}

}
