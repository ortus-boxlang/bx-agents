/**
 * Runs the agent's turns for any surface and reports what happens as frames, so the web page, the terminal and an
 * HTTP client all see the same thing. It holds the one copy of the work that used to be written in each place:
 * checking the profile and the pictures, noting the turn in the conversation list, pairing tool calls with their
 * answers, and telling a run that waits for a human from one that is done.
 *
 * A turn is started in two steps, so an HTTP edge can still answer 400 before it opens a stream:
 *
 *   prepared = runner.prepareTurn( caller, request )   an Outcome; its data is the turn
 *   runner.execute( prepared.data(), onFrame )         runs it and calls onFrame( name, data )
 *
 * Frames: thread { threadId }, chunk <what the model sent>, tool { id, name, arguments, status, ms },
 * suspended { threadId, pendingActions }, error { message }, done "[DONE]".
 *
 * A run belongs to the caller that started it. The thread id is the client's to choose, so the id handed to bx-ai (its
 * registry of runs, its checkpoints) is scoped by the caller, `u:<caller id, URL-encoded>:<thread id>` (see `scope()`):
 * another caller who names the same id reaches a different slot, and cannot cancel, steer or resume the run. Frames and
 * answers carry the client's own id.
 *
 * A request is { input, conversationId?, threadId?, params?, options?, attachments?, images? }; `images` (paths) only for a runner built with localImages. Of `options` and `params`
 * only `options.profile` is used, and `params` loses the keys TurnOptions refuses.
 */
import bxModules.bxagents.models.api.Outcome;
import bxModules.bxagents.models.api.TurnOptions;
import bxModules.bxagents.models.logs.Logger;
import bxModules.bxagents.models.runtime.InterceptorRegistration;


class {

	/**
	 * @agent The built agent (a bx-ai AiAgent)
	 * @sessions A SessionStore, or null when the app keeps no conversation list
	 * @offered An OfferedProfiles: which profiles a request may ask for; null allows none beyond the default
	 * @agentName The name the turns are for when `agent` is a sub-agent that is talked to directly; blank for the main agent. A conversation belongs to the agent it started with.
	 * @mainName The main agent's name, for the words of a refusal
	 * @localImages True only for the in-process terminal: `images: [ { path } ]` may then name files on this machine. Never set from a request
	 */
	function init( required any agent, any sessions, any offered, string agentName = "", string mainName = "", boolean localImages = false ) {
		variables.agent = arguments.agent
		variables.agentName = arguments.agentName
		variables.mainName = arguments.mainName
		variables.localImages = arguments.localImages
		variables.sessions = arguments.sessions ?: nullValue()
		variables.offered = arguments.offered ?: nullValue()
		// the list's message count is refreshed from memory when a turn ends (see prepareTurn)
		variables.conversations = isNull( variables.sessions ) ? nullValue() : new Conversations( variables.agent, variables.sessions )
		return this
	}

	// ----------------------------------------------------------------------------------
	// Starting a turn
	// ----------------------------------------------------------------------------------

	/**
	 * Checks a request and readies the turn, without running anything.
	 *
	 * @caller The Caller
	 * @request { input, conversationId?, threadId?, params?, options?, attachments? }
	 *
	 * @return An Outcome: the turn { threadId, scoped, work } or bad_profile / bad_attachment
	 */
	any function prepareTurn( required any caller, required struct request ) {
		var threadId = len( arguments.request.threadId ?: "" ) ? arguments.request.threadId : createUUID()
		// only what TurnOptions accepts reaches the agent: a caller's own `options` went through whole before, which let
		// `_resumeContext` run tools with no approval and let `params.model` and `options.apiKey` pick a model
		var cleanOptions = TurnOptions::ofOptions( arguments.request.options ?: {} )
		var cleanParams = TurnOptions::ofParams( arguments.request.params ?: {} )
		var ignored = cleanOptions.dropped.map( ( k ) => "options." & k ).append( cleanParams.dropped.map( ( k ) => "params." & k ), true )
		if ( ignored.len() ) {
			Logger::log( "agent", "warn", "Ignored what #arguments.caller.source()# sent in a turn request: #ignored.toList( ', ' )#" )
		}
		var options = cleanOptions.value
		// a visitor of an embed never chooses a profile: the embed's own record does, set by the server (EmbedPublic), so it
		// is not held to the list of profiles a client may ask for
		if ( !arguments.caller.isEmbed() && !profileAllowed( options ) ) {
			return Outcome::failed( "bad_profile", "profile is not offered here" )
		}
		options[ "userId" ] = arguments.caller.id()
		// what the embed filter reads to know this is an embed turn and which embed it is for (see EmbedFilterMiddleware); a
		// client cannot send it, TurnOptions drops every key it does not know and this is set after that
		if ( arguments.caller.isEmbed() ) {
			// `usageMetadata` is a property of every bx-ai request, so the filter can read it from the request in its hooks
			options[ "usageMetadata" ] = { "embedId" : arguments.caller.embedId() }
		}
		options[ "threadId" ] = scoped( arguments.caller, threadId )

		var input = arguments.request.input ?: ""
		var conversationId = arguments.request.conversationId ?: ""
		if ( len( conversationId ) ) {
			options[ "conversationId" ] = conversationId
		}

		// pictures arrive as files on this machine (images: [ { path } ], the terminal) or as data over the wire
		// (attachments: [ { name, mime, data } ]); MessageBuilder checks and builds both
		// `images` holds paths to files on this machine, so only the terminal that runs the agent in its own process may
		// send it. Who the caller says it is (the source header) is not proof; the runner is built with the flag by code.
		var images = variables.localImages && isArray( arguments.request.images ?: "" ) ? duplicate( arguments.request.images ) : []
		if ( !variables.localImages && arguments.request.keyExists( "images" ) ) {
			Logger::log( "agent", "warn", "Ignored what #arguments.caller.source()# sent in a turn request: images (send attachments with base64 data)" )
		}
		var attachments = arguments.request.attachments ?: []
		if ( isArray( attachments ) ) {
			for ( var a in attachments ) {
				images.append( { name : a.name ?: "", mime : a.mime ?: "", base64 : a.data ?: "" } )
			}
		}
		if ( images.len() ) {
			var facts = new "models.runtime.ModelFacts@bxagents"().of( len( options.profile ?: "" ) ? options.profile : ( variables.agent.getConfig().profile ?: "" ) )
			var built = new "models.chat.MessageBuilder@bxagents"().build( input, images, facts )
			if ( !built.ok ) {
				return Outcome::failed( "bad_attachment", built.reason )
			}
			input = built.input
		}

		// a conversation belongs to the agent it started with
		var owner = belongsTo( arguments.caller, conversationId )
		if ( len( owner ) && owner != ( len( variables.agentName ) ? variables.agentName : variables.mainName ) ) {
			return Outcome::failed( "conflict", "This conversation belongs to #owner#" )
		}

		// only a turn that will run is noted in the list
		if ( len( conversationId ) ) {
			noteTurn( arguments.caller, conversationId, arguments.request.input ?: "" )
		}

		var thisAgent = variables.agent
		var params = cleanParams.value
		var tally = isNull( variables.conversations ) ? nullValue() : variables.conversations
		var theCaller = arguments.caller
		var theConversation = conversationId
		// when the turn ends, however it ends, the list's count becomes what memory holds. A list that cannot be
		// written must not fail the turn.
		var settle = () => {
			if ( !isNull( tally ) && len( theConversation ) ) {
				try {
					tally.refreshCount( theCaller, theConversation )
				} catch ( any e ) {
					// the turn is over; the count is corrected by the next one
				}
			}
		}
		return Outcome::done( {
			threadId : threadId,
			scoped   : options.threadId,
			// a visitor of an embed (an anonymous person on another website) is never told why a turn failed, see failureText()
			visitor  : arguments.caller.isEmbed(),
			work     : ( onChunk ) => {
				try {
					return thisAgent.stream( onChunk, input, params, options )
				} finally {
					settle()
				}
			},
			run      : () => {
				try {
					return thisAgent.run( input, params, options )
				} finally {
					settle()
				}
			}
		} )
	}

	/**
	 * Readies the answer to an approval that stopped a run.
	 *
	 * @caller The Caller; it must be who started the run
	 * @threadId The run
	 * @request { decision : approve | approve_session | reject, editedData?, reason? }
	 *
	 * @return An Outcome: the turn { threadId, scoped, work }, bad_request or not_your_run (also when nothing of the caller is waiting on that id)
	 */
	any function prepareResume( required any caller, required string threadId, required struct request ) {
		var decision = arguments.request.decision ?: ""
		if ( !len( arguments.threadId ) || !len( decision ) ) {
			return Outcome::failed( "bad_request", "threadId and decision are required" )
		}
		var checkpointer = variables.agent.getCheckpointer()
		if ( !isNull( checkpointer ) ) {
			var state = checkpointer.loadState( scoped( arguments.caller, arguments.threadId ) )
			// the checkpoint is kept under the caller's own scope, so a run another caller started is not found here, and
			// neither is one that is not waiting: both are the same answer, so an id cannot be probed
			if ( state.isEmpty() || ownerOf( state ) != arguments.caller.id() ) {
				return Outcome::failed( "not_your_run", "No run of yours is waiting on that thread id" )
			}
		}
		var thisAgent = variables.agent
		var threadId = arguments.threadId
		var agentThread = scoped( arguments.caller, arguments.threadId )
		var decidedBy = arguments.caller.id()
		var edited = arguments.request.editedData ?: {}
		var reason = arguments.request.reason ?: ""
		return Outcome::done( {
			threadId : threadId,
			scoped   : agentThread,
			work     : ( onChunk ) => thisAgent.resumeStream( onChunk, decision, agentThread, edited, decidedBy, reason )
		} )
	}

	// ----------------------------------------------------------------------------------
	// Running it
	// ----------------------------------------------------------------------------------

	/**
	 * Prepares a turn and runs it.
	 *
	 * @return An Outcome: the refusal from prepareTurn, or done( { threadId } ) once the frames have all been sent
	 */
	any function stream( required any caller, required struct request, required function onFrame, function isOpen ) {
		var prepared = prepareTurn( arguments.caller, arguments.request )
		if ( !prepared.succeeded() ) {
			return prepared
		}
		execute( prepared.data(), arguments.onFrame, arguments.isOpen ?: nullValue() )
		return Outcome::done( { threadId : prepared.data().threadId } )
	}

	/**
	 * Prepares the answer to an approval and runs the rest of the turn.
	 */
	any function resume( required any caller, required string threadId, required struct request, required function onFrame, function isOpen ) {
		var prepared = prepareResume( arguments.caller, arguments.threadId, arguments.request )
		if ( !prepared.succeeded() ) {
			return prepared
		}
		execute( prepared.data(), arguments.onFrame, arguments.isOpen ?: nullValue() )
		return Outcome::done( { threadId : arguments.threadId } )
	}

	/**
	 * What a client is told when a turn fails. The terminal that runs the agent in its own process gets the full diagnostic, any other
	 * client the exception's message. A visitor of an embed gets neither: the message of a provider or engine error can carry a key
	 * fragment, an upstream address or a model name, and it is read by anyone with `curl`. The detail is in the log.
	 */
	private string function failureText( required any e, required string diagnostic, boolean visitor = false ) {
		if ( arguments.visitor ) {
			return "Something went wrong. Please try again in a moment."
		}
		return variables.localImages ? arguments.diagnostic : arguments.e.message
	}

	/**
	 * One whole turn without frames.
	 *
	 * @return An Outcome: { output, threadId }, or the refusal from prepareTurn
	 */
	any function run( required any caller, required struct request ) {
		var prepared = prepareTurn( arguments.caller, arguments.request )
		if ( !prepared.succeeded() ) {
			return prepared
		}
		var turn = prepared.data()
		try {
			return Outcome::done( { output : turn.run(), threadId : turn.threadId } )
		} catch ( any e ) {
			var diagnostic = bxModules.bxagents.models.runtime.ErrorReport::describe( e, bxModules.bxagents.models.runtime.ErrorReport::forAgent( variables.agent ) )
			Logger::log( "agent", "error", "A turn failed (from #arguments.caller.source()#): " & diagnostic )
			return Outcome::failed( "internal", failureText( e, diagnostic, arguments.caller.isEmbed() ) )
		}
	}

	/**
	 * @request { inputs : [ ... ], params?, options?, conversationId?, threadId? }
	 *
	 * @return An Outcome: { outputs : [ { output, success } or { error, success : false } ], threadId }
	 */
	any function batch( required any caller, required struct request ) {
		var inputs = arguments.request.inputs ?: []
		if ( !isArray( inputs ) || !inputs.len() ) {
			return Outcome::failed( "bad_request", "inputs must be a list with at least one item" )
		}
		var threadId = len( arguments.request.threadId ?: "" ) ? arguments.request.threadId : createUUID()
		var outputs = []
		for ( var item in inputs ) {
			var single = duplicate( arguments.request )
			single.delete( "inputs" )
			single[ "input" ] = item
			single[ "threadId" ] = threadId
			var one = run( arguments.caller, single )
			if ( one.succeeded() ) {
				outputs.append( { "output" : one.data().output, "success" : true } )
			} else {
				outputs.append( { "error" : one.reason(), "success" : false } )
			}
		}
		return Outcome::done( { outputs : outputs, threadId : threadId } )
	}

	/**
	 * Runs a prepared turn, sending frames as it goes.
	 *
	 * @turn What prepareTurn or prepareResume answered
	 * @onFrame Called as onFrame( name, data )
	 * @isOpen Called before each frame; false stops sending (the client went away). Always open when omitted
	 */
	void function execute( required struct turn, required function onFrame, function isOpen ) {
		var send = arguments.onFrame
		var open = () => true
		if ( !isNull( arguments.isOpen ) ) {
			open = arguments.isOpen
		}
		var threadId = arguments.turn.threadId
		var agentThread = arguments.turn.scoped
		var work = arguments.turn.work
		var calls = {}
		var counter = { value : 0 }
		send( "thread", { "threadId" : threadId } )

		// bx-ai announces every tool call in the process. Only this thread's are sent on.
		var interceptor = InterceptorRegistration::register( ( data ) => {
			if ( !open() || !belongsToThread( data, agentThread ) ) {
				return
			}
			var name = data.name
			var shown = visibleArguments( data.arguments ?: {} )
			if ( data.keyExists( "results" ) ) {
				var waiting = calls[ name ] ?: []
				var finished = waiting.len() ? waiting.first() : name
				if ( waiting.len() ) {
					waiting.deleteAt( 1 )
				} else {
					Logger::log( "agent", "warn", "Tool completion had no matching start event", name )
				}
				var ms = data.executionTime ?: 0
				Logger::log( "agent", "info", "Tool completed (call #finished#, #ms# ms)", name )
				send( "tool", { "id" : finished, "name" : name, "arguments" : shown, "status" : "ok", "ms" : ms } )
				return
			}
			counter.value++
			var started = name & "##" & counter.value
			calls[ name ] = calls[ name ] ?: []
			calls[ name ].append( started )
			Logger::log( "agent", "info", "Tool started (call #started#)", name )
			send( "tool", { "id" : started, "name" : name, "arguments" : shown, "status" : "running", "ms" : 0 } )
		}, [ "beforeAIToolExecute", "afterAIToolExecute" ] )

		try {
			work( ( chunk ) => {
				if ( !open() ) {
					return
				}
				send( "chunk", chunk )
				// the sentinel for a run that stops on a human decision
				if ( isStruct( chunk ) && ( chunk.type ?: "" ) == "middleware_stop" ) {
					send( "suspended", { "threadId" : threadId, "pendingActions" : pendingActionsOf( chunk ) } )
				}
			} )
			if ( open() ) {
				send( "done", "[DONE]" )
			}
		} catch ( any e ) {
			var diagnostic = bxModules.bxagents.models.runtime.ErrorReport::describe( e, bxModules.bxagents.models.runtime.ErrorReport::forAgent( variables.agent ) )
			Logger::log( "agent", "error", "A streamed turn failed: " & diagnostic )
			if ( open() ) {
				send( "error", { "message" : failureText( e, diagnostic, arguments.turn.visitor ?: false ) } )
			}
		} finally {
			InterceptorRegistration::unregister( interceptor )
		}
	}

	// ----------------------------------------------------------------------------------
	// Controlling a run
	// ----------------------------------------------------------------------------------

	/**
	 * Stops a run at its next checkpoint (before the next model call or tool call). A run belongs to the caller that
	 * started it: another caller's thread id does not reach it, so the answer is false.
	 *
	 * @caller   The Caller
	 * @threadId The run, from the first frame of its stream
	 * @reason   Why it stopped, kept with the run
	 *
	 * @return An Outcome: { cancelled }, false when no run with that id is going here; bad_request without a thread id
	 */
	any function cancel( required any caller, required string threadId, string reason = "Cancelled by the user." ) {
		if ( !len( arguments.threadId ) ) {
			return Outcome::failed( "bad_request", "threadId is required" )
		}
		return Outcome::done( { "cancelled" : variables.agent.cancelRun( scoped( arguments.caller, arguments.threadId ), arguments.reason ) } )
	}

	/**
	 * Splices a message into a run in flight, read by the model before its next step. Like cancel, only the caller
	 * that started the run reaches it.
	 *
	 * @caller   The Caller
	 * @threadId The run, from the first frame of its stream
	 * @input    The message to add
	 *
	 * @return An Outcome: { steered }, false when no run with that id is going here; bad_request without both
	 */
	any function steer( required any caller, required string threadId, required string input ) {
		if ( !len( arguments.threadId ) || !len( arguments.input ) ) {
			return Outcome::failed( "bad_request", "threadId and input are required" )
		}
		return Outcome::done( { "steered" : variables.agent.steerRun( scoped( arguments.caller, arguments.threadId ), arguments.input ) } )
	}

	/**
	 * What a run that stopped for approval is waiting on, without consuming the checkpoint. A run belongs to who
	 * started it; for anyone else this answers as though nothing is pending, so it cannot be used to find out
	 * whether a threadId exists.
	 */
	any function pending( required any caller, required string threadId ) {
		if ( !len( arguments.threadId ) ) {
			return Outcome::failed( "bad_request", "threadId is required" )
		}
		var checkpointer = variables.agent.getCheckpointer()
		if ( isNull( checkpointer ) ) {
			return Outcome::done( { "pending" : false } )
		}
		var state = checkpointer.loadState( scoped( arguments.caller, arguments.threadId ) )
		if ( !state.isEmpty() && ownerOf( state ) != arguments.caller.id() ) {
			return Outcome::done( { "pending" : false } )
		}
		return Outcome::done( {
			"pending"        : !state.isEmpty(),
			"pendingActions" : state.suspendData.pendingActions ?: [],
			"threadId"       : arguments.threadId
		} )
	}

	// ----------------------------------------------------------------------------------

	/**
	 * The id bx-ai knows a run by. The client picks its thread id, so on its own it could name somebody else's run;
	 * scoped by the caller, it cannot. The caller id is URL-encoded, so it never holds a colon and `u:<a>:<b>` can be
	 * split in only one way: `a:b` + `c` and `a` + `b:c` come out as `u:a%3Ab:c` and `u:a:b:c`.
	 */
	static string function scope( required string callerId, required string threadId ) {
		return "u:" & createObject( "java", "java.net.URLEncoder" ).encode( arguments.callerId, "UTF-8" ) & ":" & arguments.threadId
	}

	/**
	 * @return The client's own thread id from an id made by scope(); anything else (a routine's or a gateway's) as it is
	 */
	static string function unscope( required string agentThreadId ) {
		var id = arguments.agentThreadId
		if ( left( id, 2 ) != "u:" ) {
			return id
		}
		var cut = find( ":", id, 3 )
		return cut ? mid( id, cut + 1 ) : id
	}

	private string function scoped( required any caller, required string threadId ) {
		return static.scope( arguments.caller.id(), arguments.threadId )
	}

	private boolean function profileAllowed( required struct options ) {
		return isNull( variables.offered ) ? !len( arguments.options.profile ?: "" ) : variables.offered.allows( arguments.options )
	}

	/**
	 * @return The name of the agent a conversation belongs to, or blank when it has no row yet or the list cannot be read (a list that cannot be read must not stop the turn)
	 */
	private string function belongsTo( required any caller, required string conversationId ) {
		if ( !len( arguments.conversationId ) || isNull( variables.sessions ) ) {
			return ""
		}
		try {
			var existing = variables.sessions.byId( arguments.caller.id(), arguments.conversationId )
			return existing.isEmpty() ? "" : ( len( existing.agent ?: "" ) ? existing.agent : variables.mainName )
		} catch ( any e ) {
			return ""
		}
	}

	/**
	 * Notes the turn in the conversation list: the row exists, has its title and its time is now. The count is not touched here, it is set from memory when the turn ends. A list that cannot be written must not stop the turn.
	 */
	private void function noteTurn( required any caller, required string conversationId, required string input ) {
		try {
			if ( !isNull( variables.sessions ) ) {
				variables.sessions.touch( arguments.caller.id(), arguments.conversationId, arguments.input, 0, arguments.caller.source(), variables.agentName )
			}
		} catch ( any e ) {
			// the turn goes on without a list
		}
	}

	private array function pendingActionsOf( required struct chunk ) {
		try {
			if ( arguments.chunk.result.isSuspended() ) {
				return arguments.chunk.result.getData().pendingActions ?: []
			}
		} catch ( any ignored ) {
			// the details stay available from pending()
		}
		return []
	}

	/**
	 * @data A beforeAIToolExecute or afterAIToolExecute announcement
	 *
	 * @return True when the tool call belongs to the run on this thread
	 */
	private boolean function belongsToThread( required struct data, required string threadId ) {
		var chatRequest = arguments.data.chatRequest ?: nullValue()
		if ( isNull( chatRequest ) ) {
			return false
		}
		return chatRequest.getThreadId() == arguments.threadId
	}

	/**
	 * bx-ai passes the whole chat request to tools as `_chatRequest`; names starting with an underscore are its
	 * plumbing, not something the model asked for.
	 */
	private struct function visibleArguments( required any args ) {
		var shown = {}
		if ( isStruct( arguments.args ) ) {
			for ( var key in arguments.args ) {
				if ( left( key, 1 ) != "_" ) {
					shown[ key ] = arguments.args[ key ]
				}
			}
		}
		return shown
	}

	/**
	 * The identity a suspended run was started under, kept in the checkpoint by the agent.
	 */
	private string function ownerOf( required struct state ) {
		if ( !structKeyExists( arguments.state, "options" ) || !isStruct( arguments.state.options ) ) {
			return ""
		}
		return arguments.state.options.userId ?: ""
	}

}
