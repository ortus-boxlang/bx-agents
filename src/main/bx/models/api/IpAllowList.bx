/**
 * Which addresses may call the agent API at all (`agentApi.allowedIPs`). Entries are single addresses (`203.0.113.7`,
 * `::1`) or networks in CIDR form (`10.0.0.0/8`, `fd00::/8`). An empty list lets everyone in.
 *
 * It is checked against the address of the connection, never against a forwarded-for header: a header is whatever the
 * client says it is, so trusting it would let anyone choose their own address.
 */
class {

	/**
	 * @entries The allowed addresses and networks
	 */
	function init( array entries = [] ) {
		variables.rules = []
		for ( var entry in arguments.entries ) {
			var rule = IpAllowList::parse( toString( entry ) )
			if ( !isNull( rule ) ) {
				variables.rules.append( rule )
			}
		}
		variables.open = !arguments.entries.len()
		return this
	}

	/**
	 * @address The caller's address
	 *
	 * @return True when the list is empty or the address is on it
	 */
	boolean function allows( required string address ) {
		if ( variables.open ) {
			return true
		}
		var bytes = IpAllowList::bytesOf( arguments.address )
		if ( isNull( bytes ) ) {
			return false
		}
		for ( var rule in variables.rules ) {
			if ( rule.bytes.len() == bytes.len() && IpAllowList::sharesPrefix( rule.bytes, bytes, rule.bits ) ) {
				return true
			}
		}
		return false
	}

	/**
	 * @list The configured value of `agentApi.allowedIPs`
	 *
	 * @return What is wrong with it, as sentences; empty when it is fine
	 */
	static array function problems( required any list ) {
		if ( !isArray( arguments.list ) ) {
			return [ "Agent.bx's 'agentApi.allowedIPs' must be a list of addresses or networks (e.g. [ ""10.0.0.0/8"", ""203.0.113.7"" ])" ]
		}
		var found = []
		for ( var entry in arguments.list ) {
			if ( !isSimpleValue( entry ) || isNull( IpAllowList::parse( toString( entry ) ) ) ) {
				found.append( "Agent.bx's 'agentApi.allowedIPs' has [#isSimpleValue( entry ) ? entry : 'a non-text entry'#], which is not an IP address or a network like 10.0.0.0/8" )
			}
		}
		return found
	}

	/**
	 * @return { bytes, bits } for an address or network, or null when it is neither
	 */
	static any function parse( required string text ) {
		var parts = trim( arguments.text ).listToArray( "/", true )
		if ( !parts.len() || parts.len() > 2 ) {
			return nullValue()
		}
		var bytes = IpAllowList::bytesOf( parts[ 1 ] )
		if ( isNull( bytes ) ) {
			return nullValue()
		}
		var bits = bytes.len() * 8
		if ( parts.len() == 2 ) {
			if ( !reFind( "^[0-9]{1,3}$", parts[ 2 ] ) || val( parts[ 2 ] ) > bits ) {
				return nullValue()
			}
			bits = val( parts[ 2 ] )
		}
		return { bytes : bytes, bits : bits }
	}

	/**
	 * @return The address as bytes (4 for IPv4, 16 for IPv6), or null when the text is not a literal address (a host name is never looked up)
	 */
	static any function bytesOf( required string text ) {
		var literal = trim( arguments.text ).reReplace( "^\[|\]$", "", "all" )
		if ( !reFind( "^[0-9a-fA-F:.]+$", literal ) || ( !literal.find( ":" ) && !reFind( "^[0-9]{1,3}(\.[0-9]{1,3}){3}$", literal ) ) ) {
			return nullValue()
		}
		try {
			return createObject( "java", "java.net.InetAddress" ).getByName( literal ).getAddress()
		} catch ( any e ) {
			return nullValue()
		}
	}

	/**
	 * @return True when the first `bits` bits of both addresses are the same
	 */
	static boolean function sharesPrefix( required any a, required any b, required numeric bits ) {
		var whole = int( arguments.bits / 8 )
		for ( var i = 1; i <= whole; i++ ) {
			if ( arguments.a[ i ] != arguments.b[ i ] ) {
				return false
			}
		}
		var rest = arguments.bits mod 8
		if ( rest == 0 ) {
			return true
		}
		var mask = bitAnd( bitSHLN( 255, 8 - rest ), 255 )
		return bitAnd( arguments.a[ whole + 1 ], mask ) == bitAnd( arguments.b[ whole + 1 ], mask )
	}

}
