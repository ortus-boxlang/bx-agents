/**
 * The one thing a client of the agent holds: the web page's routes, the terminal chat and the gateways all ask
 * it, so each thing the agent can do is written once.
 *
 *   service.turns()                       run a turn, stream its frames, cancel, steer, resume
 *   service.conversations()               list, start and delete conversations
 *   service.conversation( caller, id )    one conversation: history, rename, fork, compact, export, notes
 *   service.preferences( caller )         what a person has set for themselves
 *   service.commands()                    the slash commands
 *   service.whoami( caller )              who the server takes the caller to be
 *
 * A call answers an Outcome and never picks an HTTP status; ApiEdge does that, in one place.
 */
class {

	/**
	 * @agent The built agent
	 * @store A ChatStore, or null when the app keeps no shared database (then there is no conversation list or preferences)
	 * @offered An OfferedProfiles: which profiles a client may ask for
	 */
	function init( required any agent, any store, any offered ) {
		variables.agent = arguments.agent
		variables.store = arguments.store ?: nullValue()
		variables.offered = arguments.offered ?: new "models.runtime.OfferedProfiles@bxagents"( [] )
		variables.sessions = isNull( variables.store ) ? nullValue() : new "models.store.SessionStore@bxagents"( variables.store )
		return this
	}

	/** @return True when the app has a shared database: conversation list, preferences */
	boolean function keepsSessions() {
		return !isNull( variables.sessions )
	}

	any function agent() {
		return variables.agent
	}

	/** @return The SessionStore, or null */
	any function sessions() {
		return variables.sessions ?: nullValue()
	}

	any function turns() {
		return new TurnRunner( variables.agent, variables.sessions ?: nullValue(), variables.offered )
	}

	/**
	 * @return The Conversations, or null when the app keeps no list
	 */
	any function conversations() {
		return keepsSessions() ? new Conversations( variables.agent, variables.sessions ) : nullValue()
	}

	/**
	 * @caller The Caller
	 * @conversationId The conversation; a new one when blank
	 *
	 * @return An AgentConversation for the caller. The model is picked per message here, not changed for everyone.
	 */
	any function conversation( required any caller, string conversationId = "" ) {
		return new "models.chat.ServerConversation@bxagents"( variables.agent, arguments.caller.id(), variables.sessions ?: nullValue(), arguments.conversationId )
			.withOfferedProfiles( variables.offered.names() )
	}

	/**
	 * @return A Preferences for the caller, or null when the app keeps no shared database
	 */
	any function preferences( required any caller ) {
		return isNull( variables.store ) ? nullValue() : new Preferences( variables.store, arguments.caller.id() )
	}

	/**
	 * @return The one CommandService for this agent
	 */
	any function commands() {
		return new "models.chat.commands.CommandService@bxagents"( agent = variables.agent, sessions = variables.sessions ?: nullValue(), offered = variables.offered.names() )
	}

	/**
	 * @return An Outcome: the caller as the server sees it, and the agent's name
	 */
	any function whoami( required any caller ) {
		var shown = arguments.caller.toStruct()
		shown[ "agent" ] = variables.agent.getConfig().name ?: ""
		return new Outcome( ok = true, data = shown )
	}

}
