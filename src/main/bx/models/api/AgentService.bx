/**
 * The one thing a client of the agent holds: the web page's routes, the terminal chat and the gateways all ask
 * it, so each thing the agent can do is written once.
 *
 *   service.turns()                       run a turn, stream its frames, cancel, steer, resume
 *   service.conversations()               list, start and delete conversations
 *   service.conversation( caller, id )    one conversation: history, rename, fork, compact, export, notes
 *   service.preferences( caller )         what a person has set for themselves
 *   service.commands()                    the slash commands
 *   service.whoami( caller )              who the server takes the caller to be
 *   service.volumes( caller )             the folders the agent may use, by name
 *   service.skills( caller )              the skills the agent can load, with who wrote each
 *   service.logs( caller, area ... )      the agent's logs, for an admin
 *   service.gateways( caller )            the chat apps and their state, for an admin
 *   service.data( caller )                where the agent keeps everything (admin only)
 *   service.accounts()                    the sign-in accounts and who is an admin (admin only), or null with no database
 *
 * A call answers an Outcome and never picks an HTTP status; ApiEdge does that, in one place.
 */
import bxModules.bxagents.models.api.Caller as CallerType;

import bxModules.bxagents.models.api.Outcome;
import bxModules.bxagents.models.logs.Logger;
import bxModules.bxagents.models.api.OpenApiDocument;
import bxModules.bxagents.models.routines.RoutineSettings;

class {

	/**
	 * @agent The built agent
	 * @store A ChatStore, or null when the app keeps no shared database (then there is no conversation list or preferences)
	 * @offered An OfferedProfiles: which profiles a client may ask for
	 */
	function init( required any agent, any store, any offered, struct options = {} ) {
		variables.manageTokens = arguments.options.manageTokens ?: false
		// an AppData: the data home and volumes of the app; without one the volume list is empty and there is no data report
		variables.appData = arguments.options.data ?: nullValue()
		variables.connectionService = arguments.options.connections ?: nullValue()
		// a GatewayInfo: the chat apps and their state; without one the list is empty
		variables.gatewayInfo = arguments.options.gateways ?: nullValue()
		// the resolved routines settings when the build turned routines on (a struct), or false
		variables.routinesOn = arguments.options.routines ?: false
		variables.agent = arguments.agent
		variables.store = arguments.store ?: nullValue()
		variables.offered = arguments.offered ?: new "models.runtime.OfferedProfiles@bxagents"( [] )
		variables.sessions = isNull( variables.store ) ? nullValue() : new "models.store.SessionStore@bxagents"( variables.store )
		return this
	}

	/** @return True when the app has a shared database: conversation list, preferences */
	boolean function keepsSessions() {
		return !isNull( variables.sessions )
	}

	/**
	 * Whether this server lets an admin manage access tokens over the API (agentApi.manageTokens) and has the database
	 * they live in.
	 */
	boolean function keepsTokens() {
		return variables.manageTokens && !isNull( variables.store )
	}

	/**
	 * @return Token management for an admin caller, or null when the server does not offer it
	 */
	any function tokens() {
		return keepsTokens() ? new Tokens( new "models.store.TokenService@bxagents"( variables.store ) ) : nullValue()
	}

	/**
	 * @return Account management for an admin caller, or null when the app keeps no shared database
	 */
	any function accounts() {
		return isNull( variables.store ) ? nullValue() : new Accounts( new "models.store.AccountService@bxagents"( variables.store ) )
	}

	any function agent() {
		return variables.agent
	}

	/**
	 * @apiBase The path the API is served on
	 * @access open or token
	 *
	 * @return The OpenAPI 3 document of this server's API (a struct, not an Outcome): the routes it really has, so
	 *         the token routes are in it only when this server offers them
	 */
	struct function apiDocument( required string apiBase, string access = "open" ) {
		return new OpenApiDocument( variables.agent.getConfig().name ?: "agent", { manageTokens : variables.manageTokens } ).build( arguments.apiBase, arguments.access )
	}

	/** @return The SessionStore, or null */
	any function sessions() {
		return variables.sessions ?: nullValue()
	}

	any function turns() {
		return new TurnRunner( variables.agent, variables.sessions ?: nullValue(), variables.offered )
	}

	/**
	 * @return The Conversations, or null when the app keeps no list
	 */
	any function conversations() {
		return keepsSessions() ? new Conversations( variables.agent, variables.sessions ) : nullValue()
	}

	/**
	 * @caller The Caller
	 * @conversationId The conversation; a new one when blank
	 *
	 * @return An AgentConversation for the caller. The model is picked per message here, not changed for everyone.
	 */
	any function conversation( required any caller, string conversationId = "" ) {
		var found = new "models.chat.ServerConversation@bxagents"( variables.agent, arguments.caller.id(), variables.sessions ?: nullValue(), arguments.conversationId )
			.withOfferedProfiles( variables.offered.names() )
		return isNull( variables.appData ) ? found : found.withData( variables.appData )
	}

	/**
	 * @return A Preferences for the caller, or null when the app keeps no shared database
	 */
	any function preferences( required any caller ) {
		return isNull( variables.store ) ? nullValue() : new Preferences( variables.store, arguments.caller.id() )
	}

	/**
	 * @return The one CommandService for this agent
	 */
	any function commands() {
		return new "models.chat.commands.CommandService@bxagents"( agent = variables.agent, sessions = variables.sessions ?: nullValue(), offered = variables.offered.names(), data = variables.appData ?: nullValue(), routines = routines() ?: nullValue() )
	}

	/**
	 * @source The surface the call came in on
	 *
	 * @return The one user of a server that is open on this machine
	 */
	any function localCaller( string source = "api" ) {
		return CallerType::localUser( arguments.source )
	}

	/**
	 * A conversation as a file a person can keep.
	 *
	 * @caller The Caller
	 * @conversationId The conversation; it must be the caller's
	 * @format md or html
	 *
	 * @return An Outcome: { file, mime, content }, or bad_request, not_found
	 */
	any function exportOf( required any caller, required string conversationId, string format = "md" ) {
		if ( !keepsSessions() ) {
			return Outcome::failed( "not_found", "This server keeps no list of conversations" )
		}
		var exporter = new "models.chat.Exporter@bxagents"()
		var parsed = exporter.parse( "--format=" & arguments.format )
		if ( !parsed.ok ) {
			return Outcome::failed( "bad_request", parsed.reason )
		}
		var opened = conversations().open( arguments.caller, arguments.conversationId )
		if ( !opened.succeeded() ) {
			return opened
		}
		var title = variables.sessions.byId( arguments.caller.id(), arguments.conversationId ).title ?: ""
		return Outcome::done( {
			file    : exporter.defaultName( parsed.format ),
			mime    : exporter.mime( parsed.format ),
			content : exporter.render( conversation( arguments.caller, arguments.conversationId ).history(), parsed.format, title )
		} )
	}

	/**
	 * @caller The Caller
	 *
	 * @return The notes the agent keeps for the caller and about its job
	 */
	any function notes( required any caller ) {
		return new Notes( variables.agent, arguments.caller )
	}

	/**
	 * @caller The Caller
	 *
	 * @return The secrets the caller can manage: their own and, for an admin, the agent's
	 */
	any function vault( required any caller ) {
		return new Vault( new "models.vault.VaultWiring@bxagents"().serviceFor( variables.store ), arguments.caller )
	}

	/**
	 * @caller The Caller
	 *
	 * @return The servers that ask the caller to sign in and which they have connected
	 */
	any function connections( required any caller ) {
		return new Connections( isNull( variables.connectionService ) ? new "models.connect.ConnectionService@bxagents"( [] ) : variables.connectionService, arguments.caller )
	}

	/**
	 * @return True when at least one MCP server asks people to sign in
	 */
	boolean function hasConnections() {
		return !isNull( variables.connectionService ) && variables.connectionService.hasServers()
	}

	/**
	 * Who the agent is, for a client's banner: name, a short model label and what it can do.
	 *
	 * @caller The Caller
	 *
	 * @return An Outcome
	 */
	any function about( required any caller ) {
		var config = variables.agent.getConfig()
		// AiAgent.getConfig().model is the AiModel's whole config struct; a client wants provider/model
		var modelConfig = config.model ?: {}
		var modelLabel = modelConfig
		if ( isStruct( modelConfig ) ) {
			var modelId = ( modelConfig.params ?: {} ).model ?: ( modelConfig.name ?: "" )
			modelLabel = [ modelConfig.provider ?: "", modelId ].filter( ( part ) => len( part ) ).toList( "/" )
		}
		var facts = new "models.runtime.ModelFacts@bxagents"().of( config.profile ?: "" )
		return Outcome::done( {
			"name"          : config.name ?: "",
			"description"   : config.description ?: "",
			"model"         : modelLabel,
			"contextWindow" : facts.contextWindow,
			"vision"        : facts.vision,
			"toolCount"     : config.toolCount ?: 0,
			"memoryCount"   : config.memoryCount ?: 0,
			"subAgents"     : ( config.subAgents ?: [] ).map( ( sub ) => sub.name ?: "" ),
			"capabilities"  : {
				"streaming"     : true, "reasoning" : true, "toolCalls" : true, "history" : true,
				"events"        : true, "cancel" : true, "steer" : true, "approvals" : true, "attachments" : true,
				"commands"      : true, "context" : true,
				"compact"       : conversation( arguments.caller ).canCompact(),
				"notes"         : notes( arguments.caller ).keeps(),
				"vault"         : keepsSessions(),
				"connections"   : hasConnections(),
				"routines"      : !isNull( routinesSettings() ),
				"conversations" : keepsSessions(),
				"preferences"   : keepsSessions(),
				"profiles"      : variables.offered.any(),
				"tokens"        : keepsTokens() && arguments.caller.isAdmin(),
				"logs"          : !isNull( variables.appData ) && arguments.caller.isAdmin(),
				"gateways"      : !isNull( variables.gatewayInfo ) && arguments.caller.isAdmin(),
				"status"        : new "models.extensions.ServedStatus@bxagents"().available(),
				"slots"         : new "models.extensions.ServedSlots@bxagents"().available()
			}
		} )
	}

	/**
	 * @return An Outcome: the caller as the server sees it, and the agent's name
	 */
	any function whoami( required any caller ) {
		var shown = arguments.caller.toStruct()
		shown[ "agent" ] = variables.agent.getConfig().name ?: ""
		return Outcome::done( shown )
	}

	/**
	 * @return An Outcome: { volumes : [ { name, mode, description } ] }, never a folder on the machine
	 */
	any function volumes( required any caller ) {
		return Outcome::done( { "volumes" : isNull( variables.appData ) ? [] : variables.appData.listing() } )
	}

	/**
	 * @return The resolved routines settings when they are on (the build stamps them; true means the defaults), otherwise null
	 */
	private any function routinesSettings() {
		if ( isStruct( variables.routinesOn ) ) {
			return variables.routinesOn.isEmpty() ? nullValue() : variables.routinesOn
		}
		return isBoolean( variables.routinesOn ) && variables.routinesOn ? RoutineSettings::resolve( { enabled : true } ) : nullValue()
	}

	/**
	 * What a person can do with routines, or null when the build left them off or the app keeps no shared database.
	 * The reports are included when the app knows its data home.
	 *
	 * @return A RoutineManager, or null
	 */
	any function routines() {
		var resolved = routinesSettings()
		if ( isNull( resolved ) || isNull( variables.store ) ) {
			return nullValue()
		}
		var service = new "models.routines.Routines@bxagents"( variables.store, resolved )
		var destinations = new "models.routines.Destinations@bxagents"( new "models.gateways.GatewayChats@bxagents"( variables.store ) )
		var reports = isNull( variables.appData ) ? nullValue() : new "models.routines.RoutineReports@bxagents"( service, new "models.routines.RoutineResults@bxagents"( variables.appData.home(), resolved ) )
		return new "models.routines.RoutineManager@bxagents"( service, destinations, reports ?: nullValue() )
	}

	/**
	 * @return An Outcome: { skills : [ { name, description, origin } ] }, never a folder on the machine
	 */
	any function skills( required any caller ) {
		var library = new "models.skills.SkillLibrary@bxagents"( isNull( variables.appData ) ? "" : variables.appData.home() )
		return Outcome::done( { "skills" : library.listing() } )
	}

	/**
	 * The agent's logs. Without an area, which logs there are and how many errors were logged since the app started;
	 * with one, its last lines.
	 *
	 * @caller The Caller; only an admin may read the logs
	 * @area One of the log areas, or blank
	 * @tail How many lines at most
	 * @level Least serious level to show, or blank
	 * @q Text a line must contain, or blank
	 *
	 * @return An Outcome: { logs : [ { area, file, bytes, modified } ], errors : { area : count } } or { area, lines : [ { time, level, area, subject, message } ] }
	 */
	any function logs( required any caller, string area = "", any tail = 200, string level = "", string q = "" ) {
		if ( !arguments.caller.isAdmin() ) {
			return Outcome::failed( "forbidden", "Only an admin may read the logs" )
		}
		if ( isNull( variables.appData ) ) {
			return Outcome::failed( "not_found", "This server does not know its data home, so it has no logs folder" )
		}
		var reader = new "models.logs.LogReader@bxagents"( variables.appData.home().folder( "logs" ) )
		if ( !len( trim( arguments.area ) ) ) {
			return Outcome::done( { "logs" : reader.list(), "errors" : Logger::errorCounts() } )
		}
		if ( !isNumeric( arguments.tail ) || arguments.tail < 1 ) {
			return Outcome::failed( "bad_request", "tail must be a whole number of 1 or more" )
		}
		try {
			return Outcome::done( reader.tail( arguments.area, int( arguments.tail ), arguments.level, arguments.q ) )
		} catch ( "BxAgents.UnknownLog" e ) {
			return Outcome::failed( "not_found", e.message )
		}
	}

	/**
	 * The chat apps the project names and the state of each. Their credentials are shown as set or not set, never as values.
	 *
	 * @caller The Caller; only an admin may see them
	 *
	 * @return An Outcome: { gateways : [ { name, type, state, running, capabilities, credentials, lastActiveAt, lastError } ] }
	 */
	any function gateways( required any caller ) {
		if ( !arguments.caller.isAdmin() ) {
			return Outcome::failed( "forbidden", "Only an admin may see the chat apps" )
		}
		return Outcome::done( { "gateways" : isNull( variables.gatewayInfo ) ? [] : variables.gatewayInfo.listing() } )
	}

	/**
	 * Where the agent keeps everything and how big each part is. It shows folders on the machine, so only an admin gets it.
	 *
	 * @return An Outcome: the AppData report, or forbidden / not_found
	 */
	any function data( required any caller ) {
		if ( !arguments.caller.isAdmin() ) {
			return Outcome::failed( "forbidden", "Only an admin may see where the agent keeps its data" )
		}
		if ( isNull( variables.appData ) ) {
			return Outcome::failed( "not_found", "This server does not know its data home" )
		}
		return Outcome::done( variables.appData.report() )
	}

}
