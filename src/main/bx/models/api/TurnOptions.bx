/**
 * What a client of the agent API may put in `options` and `params` of a turn.
 *
 * Why this exists: TurnRunner used to pass the caller's `options` and `params` to bx-ai whole. bx-ai reads
 * `options._resumeContext` into the chat request, and the provider then runs the tool calls it carries without ever
 * reaching the approval middleware (beforeToolCall), so a caller with chat scope could run any tool, approval-gated
 * or not. The same pass-through let a caller pick the model, the key and the provider payload, which
 * `agentApi.profiles` was meant to prevent.
 *
 *   options  an ALLOWLIST: `profile` only (a name; OfferedProfiles decides whether it is offered). `options` is
 *            bx-ai's control plane (key, URL, resume state, scripted replies), nothing in it is a model setting.
 *   params   a DENYLIST. `params` is what the model provider documents (temperature, top_p, max_tokens, stop, seed,
 *            response_format, reasoning settings ...), which must not be restricted, and they differ per provider.
 *            What is refused is read from the bx-ai source (models/providers/*.bx, runnables/AiModel.bx):
 *            the request body is `{ model, messages }.append( params )`, so params override the body, and
 *            nothing in params reaches the URL, the key or the headers except `model`.
 *
 * Both are dropped without an error: a client library that sends a field this server does not take still works, and
 * a hostile request gets no answer that tells it which key mattered. The names that were dropped (never the values)
 * are returned so the caller can log them. A key starting with `_` is internal to bx-ai: it is dropped from
 * `options` and, at every depth, from `params`. The server sets `userId`, `threadId` and `conversationId` itself.
 */
class {

	static {
		ALLOWED_OPTIONS = { profile : ( v ) => isSimpleValue( v ) && !isBoolean( v ) && len( trim( v ) ) > 0 && len( v ) <= 200 };

		// lower case; each with the reason it is refused
		DENIED_PARAMS = {
			// OfferedProfiles decides the model; AiChatRequest reads params.model, and GeminiService puts it in the URL path
			model    : true,
			// the body is { model, messages }.append( params ): a client `messages` replaces the whole conversation, memory and system prompt included
			messages : true,
			// the same for Gemini, whose body is { contents }.append( params )
			contents : true,
			// ClaudeService sets `system` from the system messages only when there are some; with none, a client one would be the prompt
			system   : true,
			// AiModel merges params.tools into the agent's tools and resolves strings through the global registry, so a client could add any registered tool
			tools    : true
		};
	}

	/**
	 * @supplied What the client sent as `options`; anything but a struct is treated as nothing
	 *
	 * @return { value : the clean struct, dropped : [ names that were not accepted ] }
	 */
	static struct function ofOptions( any supplied = "" ) {
		var clean = {}
		var dropped = []
		if ( !isStruct( arguments.supplied ) ) {
			return { value : clean, dropped : dropped }
		}
		for ( var key in arguments.supplied ) {
			var name = lCase( key )
			if ( left( name, 1 ) != "_" && static.ALLOWED_OPTIONS.keyExists( name ) && static.ALLOWED_OPTIONS[ name ]( arguments.supplied[ key ] ) ) {
				clean[ name ] = arguments.supplied[ key ]
			} else {
				dropped.append( key )
			}
		}
		return { value : clean, dropped : dropped }
	}

	/**
	 * @supplied What the client sent as `params`; anything but a struct is treated as nothing
	 *
	 * @return { value : the clean struct (a copy), dropped : [ names that were not accepted, with the key they sat under ] }
	 */
	static struct function ofParams( any supplied = "" ) {
		var dropped = []
		if ( !isStruct( arguments.supplied ) ) {
			return { value : {}, dropped : dropped }
		}
		var clean = TurnOptions::scrub( arguments.supplied, "", dropped, 0 )
		for ( var key in clean.keyArray() ) {
			if ( static.DENIED_PARAMS.keyExists( lCase( key ) ) ) {
				clean.delete( key )
				dropped.append( key )
			}
		}
		return { value : clean, dropped : dropped }
	}

	/**
	 * A copy of a value without any `_` key, at every depth. Simple values pass as they are; anything that is not
	 * plain data (an object, a function) is dropped, since JSON never carries one.
	 */
	private static any function scrub( any value, required string path, required array dropped, required numeric depth ) {
		if ( arguments.depth > 20 ) {
			arguments.dropped.append( arguments.path )
			return nullValue()
		}
		if ( isStruct( arguments.value ) ) {
			var out = {}
			for ( var key in arguments.value ) {
				var where = len( arguments.path ) ? arguments.path & "." & key : key
				if ( left( key, 1 ) == "_" ) {
					arguments.dropped.append( where )
					continue
				}
				var inner = TurnOptions::scrub( arguments.value[ key ], where, arguments.dropped, arguments.depth + 1 )
				if ( !isNull( inner ) ) {
					out[ key ] = inner
				}
			}
			return out
		}
		if ( isArray( arguments.value ) ) {
			var list = []
			var i = 0
			for ( var item in arguments.value ) {
				i++
				var kept = TurnOptions::scrub( item, arguments.path & "[" & i & "]", arguments.dropped, arguments.depth + 1 )
				if ( !isNull( kept ) ) {
					list.append( kept )
				}
			}
			return list
		}
		return isSimpleValue( arguments.value ) ? arguments.value : nullValue()
	}

}
