/**
 * Decides who a request is, from what it carries: the shared secret (`agentApi.tokenEnvVar`) or a token made by
 * `bxAgents token create` (`agentApi.tokens`). It knows nothing of HTTP beyond the header values it is given,
 * so the route middleware, a spec and a gateway can all use it.
 *
 * A caller that proves nothing is not let in: a missing, wrong, expired or revoked token answers null.
 */
import bxModules.bxagents.models.api.Outcome;
import bxModules.bxagents.models.api.Caller;

class {

	/**
	 * @tokenEnvVar The NAME of the environment variable that holds the shared secret; blank for none
	 * @tokens True when issued tokens are accepted
	 * @accounts True when the web page's own sign-in (cbSecurity, from `users`) is accepted too
	 * @tokenService A TokenService; the app's shared chat database when omitted
	 */
	function init( string tokenEnvVar = "", boolean tokens = false, boolean accounts = false, any tokenService ) {
		variables.tokenEnvVar = trim( arguments.tokenEnvVar )
		variables.tokens = arguments.tokens
		variables.accounts = arguments.accounts
		variables.tokenService = arguments.tokenService ?: nullValue()
		return this
	}

	/**
	 * @headers The request's headers
	 * @source The surface the call came in on, when the request does not say
	 *
	 * @return The Caller, or null when the request proves nothing
	 */
	any function authenticate( required struct headers, string source = "api" ) {
		var given = arguments.headers[ "x-bxagents-token" ] ?: ""
		if ( !len( given ) ) {
			return nullValue()
		}
		var surface = sourceOf( arguments.headers, arguments.source )
		if ( len( variables.tokenEnvVar ) ) {
			var expected = getSystemSetting( variables.tokenEnvVar, "" )
			if ( len( expected ) && createObject( "java", "java.security.MessageDigest" ).isEqual( given.getBytes( "UTF-8" ), expected.getBytes( "UTF-8" ) ) ) {
				return new Caller( id = "admin", scope = "admin", source = surface )
			}
		}
		if ( variables.tokens ) {
			var who = issuedTokens().authenticate( given )
			if ( !who.isEmpty() ) {
				return new Caller( id = who.name, scope = who.scope, source = surface )
			}
		}
		return nullValue()
	}

	/**
	 * The route middleware: names the caller on the request, or answers 401 and stops the action.
	 *
	 * A token (the header) is checked first. A page that signed in with an account is let in too, but a browser
	 * sends its cookie to any site that asks, so a request that changes something and carries only the cookie must
	 * also carry the header x-bxagents-csrf (a page's own script can set it; another site's form cannot).
	 *
	 * The address and rate guards (agentApi.allowedIPs and rateLimit) are not here: they are cbSecurity middleware that
	 * runs before this (see Guards).
	 *
	 * @event The ColdBox request context
	 * @headers The request's headers; the real ones when omitted
	 *
	 * @return True when the request was refused (ColdBox then runs no more middleware for the route)
	 */
	boolean function guard( required any event, struct headers = getHTTPRequestData( false ).headers ) {
		var found = authenticate( arguments.headers )
		var viaCookie = false
		if ( isNull( found ) && variables.accounts ) {
			found = signedIn( arguments.event, arguments.headers )
			viaCookie = !isNull( found )
		}
		if ( isNull( found ) ) {
			return refuse( arguments.event, refusal() )
		}
		if ( viaCookie && !listFindNoCase( "GET,HEAD,OPTIONS", arguments.event.getHTTPMethod() ) && !len( arguments.headers[ "x-bxagents-csrf" ] ?: "" ) ) {
			return refuse( arguments.event, Outcome::failed( "csrf", "A page that is signed in must send the x-bxagents-csrf header with a request that changes something" ) )
		}
		arguments.event.setPrivateValue( "bxagentsCaller", found )
		return false
	}

	/**
	 * @account The signed-in account cbauth gives; the generated User says whether it is an admin
	 *
	 * @return True only when the account says so. An account object that cannot say is not an admin.
	 */
	private boolean function isAdminAccount( required any account ) {
		try {
			return arguments.account.isAdmin() == true
		} catch ( any e ) {
			return false
		}
	}

	/**
	 * @return The Caller of a page that is signed in with an account, or null
	 */
	private any function signedIn( required any event, required struct headers ) {
		try {
			var security = arguments.event.getController().getWireBox().getInstance( "cbSecurity@cbSecurity" )
			if ( security.isLoggedIn() ) {
				var account = security.getUser()
				return Caller::fromAccount( account.getId(), "", isAdminAccount( account ) ? "admin" : "chat" ).via( sourceOf( arguments.headers, "web" ) )
			}
		} catch ( any e ) {
			// no accounts in this app: not signed in
		}
		return nullValue()
	}

	/**
	 * Answers the refusal as JSON with the status its code means and stops the action.
	 *
	 * @return True, always: the request was refused
	 */
	private boolean function refuse( required any event, required any refusal ) {
		var edge = new ApiEdge()
		// noExecution() stops the action: returning true alone only ends the remaining middleware
		arguments.event.renderData( type = "json", statusCode = edge.statusFor( arguments.refusal ), data = edge.bodyFor( arguments.refusal ) ).noExecution()
		return true
	}

	/**
	 * @return What a caller who proved nothing is told: the Outcome the route middleware and the handler both answer with
	 */
	any function refusal() {
		return Outcome::failed( "unauthorized", "Missing or invalid x-bxagents-token header" )
	}

	/**
	 * The surface a client says it is (x-bxagents-source), a plain lower case name; the default when it says none.
	 */
	string function sourceOf( required struct headers, string fallback = "api" ) {
		var said = lCase( arguments.headers[ "x-bxagents-source" ] ?: "" )
		return reFind( "^[a-z0-9][a-z0-9_-]{0,31}$", said ) ? said : arguments.fallback
	}

	// the app's default datasource is the shared chat database
	private any function issuedTokens() {
		if ( isNull( variables.tokenService ) ) {
			variables.tokenService = new "models.store.TokenService@bxagents"( new "models.store.ChatStore@bxagents"( "" ) )
		}
		return variables.tokenService
	}

}
