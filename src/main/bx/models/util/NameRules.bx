/**
 * What a name of an agent, gateway, MCP server, schedule task or profile may look like: it starts with
 * a letter and then uses letters, digits, `-` and `_`.
 */
class {

	/**
	 * @name A candidate name
	 *
	 * @return True when it is a valid name
	 */
	static boolean function isValid( required string name ) {
		return reFind( "^[A-Za-z][A-Za-z0-9_-]*$", arguments.name ) > 0
	}

}
