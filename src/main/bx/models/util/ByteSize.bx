/**
 * A number of bytes the way a person reads it: 0 B, 512 B, 41 KB, 2.5 MB.
 */
class {

	/**
	 * @bytes A size in bytes
	 *
	 * @return Text such as "41 KB" or "2.5 MB"
	 */
	static string function format( required numeric bytes ) {
		var size = arguments.bytes
		var units = [ "B", "KB", "MB", "GB", "TB" ]
		var unit = 1
		while ( size >= 1024 && unit < units.len() ) {
			size = size / 1024
			unit++
		}
		var shown = unit == 1 || size >= 10 ? numberFormat( size, "0" ) : numberFormat( size, "0.0" )
		return shown & " " & units[ unit ]
	}

}
