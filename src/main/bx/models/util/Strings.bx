/**
 * Small string and path helpers the generators, validators and verbs all need, kept in one place so
 * a fix lands everywhere.
 */
class {

	/**
	 * @path A path
	 *
	 * @return The path with any trailing slash(es) stripped
	 */
	static string function normalizePath( required string path ) {
		return arguments.path.reReplace( "[\/]+$", "" )
	}

	/**
	 * @path A file or folder path, either slash
	 *
	 * @return The last segment, or an empty string for an empty path
	 */
	static string function lastSegment( required string path ) {
		return arguments.path.reReplace( "[\\/]+$", "" ).listLast( "/\" )
	}

	/**
	 * @value A raw string to embed inside a generated double-quoted BoxLang string literal
	 *
	 * @return value with `"` doubled and `#` doubled, so it round-trips as a literal, not an interpolation
	 */
	static string function bxLiteral( required string value ) {
		return arguments.value.replace( '"', '""', "all" ).replace( "##", "####", "all" )
	}

}
