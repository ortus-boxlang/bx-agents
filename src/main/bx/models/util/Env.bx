/**
 * A setting from the environment, read every time it is asked.
 *
 * `getSystemSetting()` answers from a per-key cache for the life of the process, misses included (measured: after
 * `System.setProperty( "X", "a" )` it answers "a"; after setting "b", clearing it, or setting it to "", it still answers "a",
 * and a key asked for before it existed keeps answering the default). A setting that a run or a test changes after the first
 * read has to come from here.
 *
 * A system property wins over an environment variable, as it does for `getSystemSetting()`.
 */
class {

	/**
	 * @name The variable or property name
	 * @default What to answer when neither is set (or both are empty)
	 *
	 * @return Its current value
	 */
	static string function get( required string name, string default = "" ) {
		var system = createObject( "java", "java.lang.System" )
		var found = system.getProperty( arguments.name )
		if ( !isNull( found ) && len( found ) ) {
			return found
		}
		found = system.getenv( arguments.name )
		return ( !isNull( found ) && len( found ) ) ? found : arguments.default
	}

}
