/**
 * Whether a person is at a terminal. Every verb that colors its output, draws a banner or asks questions
 * asks this one place, so a pipe, a file and CI all get the same answer.
 */
class {

	/**
	 * @return True when stdin and stdout are a terminal that can host a full-screen UI
	 */
	static boolean function isInteractive() {
		try {
			return createObject( "java", "ortus.boxlang.bxagents.tui.TuiScreen" ).isInteractive()
		} catch ( any e ) {
			return false
		}
	}

}
