/**
 * How the chat words what the project says about a model, for /info and /model. Says nothing for what
 * the project does not say.
 */
class {

	/**
	 * @facts { contextWindow, vision } from ModelFacts
	 *
	 * @return [ [ label, value ] ]
	 */
	array function of( required struct facts ) {
		var lines = []
		if ( arguments.facts.contextWindow > 0 ) {
			lines.append( [ "Context", numberFormat( arguments.facts.contextWindow ) & " tokens" ] )
		}
		if ( len( arguments.facts.vision ) ) {
			lines.append( [ "Images", arguments.facts.vision == "yes" ? "the model can see them" : "the model cannot see them" ] )
		}
		return lines
	}

}
