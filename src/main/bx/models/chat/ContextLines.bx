/**
 * How the chat words a ContextReport: the short form for the status bar and the page's header, and the lines of /context.
 */
class {

	/**
	 * @tokens A number of tokens
	 *
	 * @return "~850" or "~12.4k": an estimate, so with a tilde
	 */
	string function approx( required numeric tokens ) {
		if ( arguments.tokens < 1000 ) {
			return "~" & arguments.tokens
		}
		return "~" & numberFormat( arguments.tokens / 1000, "0.0" ) & "k"
	}

	/**
	 * @return The window as a short number: 128000 is "128k", 1000000 is "1M"
	 */
	string function window( required numeric tokens ) {
		if ( arguments.tokens >= 1000000 && arguments.tokens % 100000 == 0 ) {
			return ( arguments.tokens / 1000000 ) & "M"
		}
		return arguments.tokens >= 1000 ? numberFormat( round( arguments.tokens / 1000 ) ) & "k" : arguments.tokens & ""
	}

	/**
	 * @report A ContextReport.build() result
	 *
	 * @return "ctx ~12.4k" or "ctx ~12.4k / 128k 9%"
	 */
	string function status( required struct report ) {
		var text = "ctx " & approx( arguments.report.total )
		if ( arguments.report.contextWindow > 0 ) {
			text &= " / " & window( arguments.report.contextWindow ) & " " & arguments.report.percent & "%"
		}
		return text
	}

	/**
	 * @report A ContextReport.build() result
	 *
	 * @return A bar of ten cells, filled to the share of the window the context takes
	 */
	string function bar( required struct report ) {
		var filled = min( 10, round( arguments.report.percent / 10 ) )
		return "[" & repeatString( "##", filled ) & repeatString( "-", 10 - filled ) & "]"
	}

}
