/**
 * What the chat knows about a command. The built-in commands implement it, and so can anything a
 * module adds later: the registry asks only these questions.
 */
interface {

	/**
	 * @return The name without the prefix, lower case: "info"
	 */
	string function name();

	/**
	 * @return Other names that run it
	 */
	array function aliases();

	/**
	 * @return One line for the help and the slash menu
	 */
	string function hint();

	/**
	 * @return Where it runs: any of "tui", "web", "gateway"
	 */
	array function transports();

	/**
	 * @return Who may run it: "anyone", or "admin"
	 */
	string function permission();

	/**
	 * @context A CommandContext
	 * @args What follows the name
	 *
	 * @return A Reply
	 */
	any function run( required any context, required string args );

}
