/**
 * The built-in commands, in the order the help lists them. The one place that knows which they are.
 */
class {

	/**
	 * @return A CommandRegistry with every built-in command
	 */
	function standard() {
		var registry = new "models.chat.commands.CommandRegistry@bxagents"()
		for ( var name in [ "Help", "New", "Name", "Fork", "Tools", "Sessions", "Resume", "Clear", "Compact", "Model", "Ping", "Profile", "Default", "Info", "Remember", "Notes", "Copy", "Export", "Record", "Exit" ] ) {
			registry.register( new "models.chat.commands.builtin.#name#@bxagents"( registry ) )
		}
		return registry
	}

}
