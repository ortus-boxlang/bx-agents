/**
 * The built-in commands, in the order the help lists them. The one place that knows which they are.
 */
class {

	/**
	 * The commands a served agent answers with: the registry the app built at startup (the built-ins and
	 * what its extensions added, see ServedExtensions), or just the built-ins when the app has none.
	 *
	 * @return A CommandRegistry
	 */
	function forApplication() {
		try {
			if ( application.keyExists( "bxagentsCommands" ) ) {
				return application.bxagentsCommands
			}
		} catch ( any e ) {
			// no application scope here (a script, a test): the built-ins
		}
		return standard()
	}

	/**
	 * @return A CommandRegistry with every built-in command
	 */
	function standard() {
		var registry = new "models.chat.commands.CommandRegistry@bxagents"()
		for ( var name in [ "Help", "New", "Name", "Fork", "Tools", "Sessions", "Resume", "Clear", "Compact", "Context", "Stats", "Keys", "Prompt", "Model", "Ping", "Profile", "Default", "Info", "Remember", "Notes", "Copy", "Export", "Record", "Exit" ] ) {
			registry.register( new "models.chat.commands.builtin.#name#@bxagents"( registry ) )
		}
		return registry
	}

}
