/**
 * The built-in commands, in the order the help lists them. The one place that knows which they are.
 */
class {

	static {
		/**
		 * The built-in commands, in the order the help and the menus list them. Each name is a class in
		 * models/chat/commands/builtin whose name() is the command typed after the slash (Help is /help).
		 */
		BUILTINS = [
			"Help",
			"New",
			"Name",
			"Fork",
			"Tools",
			"Volumes",
			"Skills",
			"Routines",
			"Routine",
			"Sessions",
			"Agent",
			"Resume",
			"Clear",
			"Cls",
			"Settings",
			"Compact",
			"Context",
			"Stats",
			"Keys",
			"Prompt",
			"Model",
			"Ping",
			"Profile",
			"Default",
			"Info",
			"Remember",
			"Notes",
			"Logs",
			"Vault",
			"Connect",
			"Copy",
			"Export",
			"Record",
			"Exit"
		]
	}

	/**
	 * @return The class names of the built-in commands, in the order the help lists them (a copy: changing it changes nothing)
	 */
	array function builtins() {
		return static.BUILTINS.duplicate()
	}

	/**
	 * The commands a served agent answers with: the registry the app built at startup (the built-ins and
	 * what its extensions added, see ServedExtensions), or just the built-ins when the app has none.
	 *
	 * @return A CommandRegistry
	 */
	function forApplication() {
		try {
			if ( application.keyExists( "bxagentsCommands" ) ) {
				return application.bxagentsCommands
			}
		} catch ( any e ) {
			// no application scope here (a script, a test): the built-ins
		}
		return standard()
	}

	/**
	 * @return A CommandRegistry with every built-in command
	 */
	function standard() {
		var registry = new models.chat.commands.CommandRegistry@bxagents()
		for ( var name in static.BUILTINS ) {
			registry.register( new "models.chat.commands.builtin.#name#@bxagents"( registry ) )
		}
		return registry
	}

}
