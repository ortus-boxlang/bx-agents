/**
 * The defaults for a command: runs on every transport, for anyone, with no aliases. A command names
 * itself and says what it does; everything else here is the usual answer.
 */
class implements="models.chat.commands.ICommand@bxagents" {

	/**
	 * Constructor
	 */
	function init() {
		return this
	}

	/**
	 * @return The name of the command.
	 */
	string function name() {
		throw( type : "bxagents.command", message : "A command must name itself." )
	}

	/**
	 * @return The aliases for the command.
	 */
	array function aliases() {
		return []
	}

	/**
	 * @return A short hint for the command.
	 */
	string function hint() {
		return ""
	}

	/**
	 * @return What the command takes after its name, for the slash menu: "[n|id]" or "<title>". Empty when it takes nothing, which is
	 *         what lets Enter run it straight from the menu.
	 */
	string function usage() {
		return ""
	}

	/**
	 * @return The heading the slash menu lists it under: "Conversation", "Agent", "Model", "Screen" or "Memory"
	 */
	string function group() {
		return "Other"
	}

	/**
	 * @return The transports the command runs on.
	 */
	array function transports() {
		return [ "tui", "web", "gateway" ]
	}

	/**
	 * @return The permission required to run the command.
	 */
	string function permission() {
		return "anyone"
	}

	/**
	 * Executes the command.
	 *
	 * @param context The context in which the command is run.
	 * @param args The arguments passed to the command.
	 * @return The result of the command execution.
	 */
	any function run( required any context, required string args ) {
		throw( type : "bxagents.command", message : "The command [#name()#] does nothing yet." )
	}

}
