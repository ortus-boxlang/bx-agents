/**
 * The defaults for a command: runs on every transport, for anyone, with no aliases. A command names
 * itself and says what it does; everything else here is the usual answer.
 */
class implements="models.chat.commands.ICommand@bxagents" {

	function init() {
		return this
	}

	string function name() {
		throw( type : "bxagents.command", message : "A command must name itself." )
	}

	array function aliases() {
		return []
	}

	string function hint() {
		return ""
	}

	array function transports() {
		return [ "tui", "web", "gateway" ]
	}

	string function permission() {
		return "anyone"
	}

	any function run( required any context, required string args ) {
		throw( type : "bxagents.command", message : "The command [#name()#] does nothing yet." )
	}

}
