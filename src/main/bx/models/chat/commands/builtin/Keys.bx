/**
 * /keys: which keys do what. In the terminal chat it opens the shortcuts panel (every key as it is bound now: the defaults, plus the
 * person's own changes in ~/.bxagents/Agent.yml, narrowed by typing); on the web page, its fixed shortcuts. A lone ? in the message box asks
 * the same, in both.
 */
class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "keys"
	}

	string function usage() {
		return ""
	}

	string function group() {
		return "Screen"
	}

	string function hint() {
		return "which keys do what (or type ?)"
	}

	array function transports() {
		return [ "tui", "web" ]
	}

	any function run( required any context, required string args ) {
		var reply = arguments.context.reply()
		if ( !arguments.context.hasTerminal() ) {
			reply.header( "Keyboard Shortcuts" )
			reply.commandLine( "Enter", "Send the message" )
			reply.commandLine( "Shift+Enter", "New line in the message" )
			reply.commandLine( "/", "The commands; Tab completes, Up/Down choose, Esc closes" )
			reply.commandLine( "Stop", "The button stops the agent at its next step" )
			return reply
		}
		// the terminal chat opens the shortcuts panel: every key as bound now, narrowed by typing
		reply.screen( "keys" )
		return reply
	}

}
