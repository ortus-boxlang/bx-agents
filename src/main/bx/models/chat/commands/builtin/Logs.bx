/**
 * /logs: the agent's logs, in the terminal chat. `/logs` says which there are; `/logs <area>` shows the last lines, with
 * `--tail=N`, `--level=warn|error` and `--grep=text`. Over --connect it reads the server's logs, which takes an admin
 * token. For a live view, `bxAgents logs <area> --follow` or `bxAgents logs --ui`.
 */
import bxModules.bxagents.models.logs.Logger;

class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "logs"
	}

	string function hint() {
		return "the agent's logs: /logs, or /logs <" & Logger::areas().toList( "|" ) & "> [--tail=N] [--level=warn] [--grep=text]"
	}

	array function transports() {
		return [ "tui" ]
	}

	string function permission() {
		return "admin"
	}

	any function run( required any context, required string args ) {
		var reply = arguments.context.reply()
		var chat = arguments.context.chat()
		if ( !structKeyExists( chat, "logs" ) ) {
			return reply.warn( "This chat cannot read the logs. Try: bxAgents logs" )
		}
		var area = ""
		var tail = 30
		var level = ""
		var grep = ""
		for ( var word in listToArray( trim( arguments.args ), " " ) ) {
			if ( word.reFindNoCase( "^--tail=\d+$" ) ) {
				tail = int( listLast( word, "=" ) )
			} else if ( word.reFindNoCase( "^--level=(warn|error)$" ) ) {
				level = lCase( listLast( word, "=" ) )
			} else if ( word.reFindNoCase( "^--grep=" ) ) {
				grep = mid( word, 8, len( word ) )
			} else if ( !len( area ) && !word.startsWith( "--" ) ) {
				area = lCase( word )
			} else {
				return reply.warn( "Usage: " & hint().listRest( ":" ).trim() )
			}
		}
		var found = chat.logs( area, tail, level, grep )
		if ( !( found.ok ?: false ) ) {
			return reply.warn( found.reason ?: "The logs could not be read." )
		}
		if ( !len( area ) ) {
			if ( !( found.logs ?: [] ).len() ) {
				return reply.text( "No logs yet. They appear when the agent runs." )
			}
			reply.text( "Logs (/logs <name> to read one):" )
			for ( var log in found.logs ) {
				reply.text( "  " & left( log.area & repeatString( " ", 11 ), 11 ) & log.bytes & " bytes" )
			}
			return reply
		}
		var lines = found.lines ?: []
		if ( !lines.len() ) {
			return reply.text( "No lines in the #area# log" & ( len( level ) || len( grep ) ? " that match." : " yet." ) )
		}
		var view = new "models.cli.Logs@bxagents"()
		for ( var line in lines ) {
			reply.text( view.lineText( line ) )
		}
		return reply
	}

}
