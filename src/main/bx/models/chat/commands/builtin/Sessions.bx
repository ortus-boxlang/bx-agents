class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "sessions"
	}

	string function hint() {
		return "list your recent conversations: /sessions [text] [--agent=NAME]"
	}

	any function run( required any context, required string args ) {
		var reply = arguments.context.reply()
		var filters = {}
		var words = []
		for ( var word in listToArray( trim( arguments.args ), " " ) ) {
			if ( word.startsWith( "--agent=" ) ) {
				filters[ "agent" ] = mid( word, 9, len( word ) )
			} else {
				words.append( word )
			}
		}
		filters[ "q" ] = words.toList( " " )
		var recent = arguments.context.chat().sessions( 20, filters )
		if ( !recent.len() ) {
			return reply.text( structCount( filters ) && ( len( filters.q ) || len( filters.agent ?: "" ) ) ? "No conversations match." : "No conversations yet." )
		}
		var rows = []
		var number = 0
		for ( var row in recent ) {
			number++
			rows.append( [ number, left( row.title ?: "", 60 ), ( row.messageCount ?: 0 ) & " messages", dateTimeFormat( row.updatedAt, "yyyy-MM-dd HH:mm" ), left( row.id, 8 ) ] )
		}
		return reply
			.grid( [ { width : 3, align : "right" }, { width : 60, align : "left" }, { width : 0 }, { width : 0 }, { width : 0 } ], rows )
			.text( "Type /resume <number> to go back to one." )
	}

}
