class extends="models.chat.commands.BaseCommand@bxagents" {

	/** @return The name of the command: connect */
	string function name() {
		return "connect"
	}

	/** @return What the slash menu says the command does */
	string function hint() {
		return "connect services for the agent to use as you: /connect, /connect NAME, /connect NAME off, /connect NAME tools"
	}

	/**
	 * `/connect` lists the connectors and your state. `/connect NAME` connects one: the risk, its options, then your token
	 * in a hidden box (a token is never typed in the command). `/connect NAME off` disconnects, `/connect NAME tools`
	 * lists the tools by name and `tools off NAME`, `tools on NAME`, `tools off all`, `tools readonly` change what is on.
	 * The services written in Agent.yaml (mcpServers with oauth) are listed too and connected by name. No token is ever shown.
	 *
	 * @context The CommandContext
	 * @args What was typed after the name
	 */
	any function run( required any context, required string args ) {
		var reply = arguments.context.reply()
		var words = listToArray( trim( arguments.args ), " " )
		var flags = {}
		var plain = []
		for ( var word in words ) {
			if ( lCase( word ) == "--confirm" ) {
				flags.confirm = true
			} else if ( lCase( left( word, 12 ) ) == "--token-env=" && arguments.context.transport() == "tui" ) {
				// only at a terminal: from a chat platform or a web page it would read the server's environment for a stranger
				flags.tokenEnv = mid( word, 13, len( word ) )
			} else {
				plain.append( word )
			}
		}
		try {
			// a chat that does not know about connectors (an older server) has none to show
			var source = ""
			try {
				source = arguments.context.chat().connectors( arguments.context.isAdmin() )
			} catch ( any noConnectors ) {
				source = new "models.connectors.NoConnectorSource@bxagents"()
			}
			var console = new "models.connectors.ConnectorsConsole@bxagents"(
				source,
				new "models.connectors.ChatConsoleIo@bxagents"( arguments.context, reply ),
				arguments.context.chat().connections()
			)
			console.run( plain, flags )
		} catch ( any e ) {
			reply.warn( "Connect: " & e.message )
		}
		return reply
	}

}
