class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "tools"
	}

	string function hint() {
		return "list the agent's tools"
	}

	any function run( required any context, required string args ) {
		var tools = arguments.context.chat().tools()
		return arguments.context.reply().text( tools.len() ? "Tools: " & tools.toList( ", " ) : "No tool list is available in this mode." )
	}

}
