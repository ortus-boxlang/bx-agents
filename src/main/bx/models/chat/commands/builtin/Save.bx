class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "save"
	}

	string function hint() {
		return "save the conversation to a file: /save notes.md"
	}

	array function transports() {
		return [ "tui" ]
	}

	/**
	 * @args A file name, relative to the working directory or absolute; blank picks a dated one
	 */
	any function run( required any context, required string args ) {
		var reply = arguments.context.reply()
		var outcome = arguments.context.terminal().save( arguments.args )
		return outcome.ok ? reply.ok( "Saved to #outcome.path#" ) : reply.warn( outcome.reason )
	}

}
