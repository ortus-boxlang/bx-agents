class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "name"
	}

	string function usage() {
		return "<title>"
	}

	string function group() {
		return "Conversation"
	}

	string function hint() {
		return "name this conversation: /name Quarterly plan"
	}

	array function transports() {
		return [ "tui", "web" ]
	}

	any function run( required any context, required string args ) {
		var reply = arguments.context.reply()
		var outcome = arguments.context.chat().rename( arguments.args )
		if ( outcome.ok ) {
			reply.styled().muted( "Named:" ).text( " " ).accentBold( outcome.title ).print()
		} else {
			reply.warn( outcome.reason )
		}
		return reply
	}

}
