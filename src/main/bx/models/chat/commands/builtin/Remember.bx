class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "remember"
	}

	string function hint() {
		return "keep a note about you: /remember I prefer short answers"
	}

	any function run( required any context, required string args ) {
		return new "models.chat.commands.builtin.Notes@bxagents"().run( arguments.context, "add " & arguments.args )
	}

}
