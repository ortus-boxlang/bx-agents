/**
 * /volumes: the folders the agent's file tools may use, by name and mode. Never a folder on the machine, so it is
 * safe to show on every transport.
 */
class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "volumes"
	}

	string function usage() {
		return ""
	}

	string function group() {
		return "Agent"
	}

	string function hint() {
		return "list the folders the agent may read and write"
	}

	any function run( required any context, required string args ) {
		var reply = arguments.context.reply()
		var volumes = arguments.context.chat().volumes()
		if ( !volumes.len() ) {
			return reply.text( "No volume list is available in this mode." )
		}
		reply.header( "Volumes" )
		for ( var v in volumes ) {
			var modeLabel = v.mode == "rw" ? "read and write" : "read only"
			reply.styled()
				.accentBold( v.name )
				.text( repeatString( " ", max( 2, 14 - len( v.name ) ) ) )
				.segment( modeLabel, v.mode == "rw" ? "ok" : "warn" )
				.text( repeatString( " ", max( 2, 16 - len( modeLabel ) ) ) )
				.muted( v.description )
				.print()
		}
		return reply
	}

}
