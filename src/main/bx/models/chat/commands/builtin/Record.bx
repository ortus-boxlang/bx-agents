class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "record"
	}

	string function hint() {
		return "record the screen as a .cast file: /record [file], /record stop"
	}

	array function transports() {
		return [ "tui" ]
	}

	any function run( required any context, required string args ) {
		var outcome = arguments.context.terminal().record( arguments.args )
		return arguments.context.reply().text( outcome.text, outcome.style )
	}

}
