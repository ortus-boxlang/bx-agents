/**
 * /context: how big the context is right now and what it is made of. Worked out locally, no model is called.
 */
class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "context"
	}

	string function usage() {
		return ""
	}

	string function group() {
		return "Model"
	}

	string function hint() {
		return "how big the context is: system prompt, tools, notes, messages"
	}

	array function transports() {
		return [ "tui", "web" ]
	}

	any function run( required any context, required string args ) {
		var reply = arguments.context.reply()
		var report = arguments.context.chat().contextReport()
		// at the terminal, what waits for the next message (!command output, #function() results) counts too
		if ( arguments.context.hasTerminal() ) {
			report = arguments.context.terminal().counting( report )
		}
		var words = new "models.chat.ContextLines@bxagents"()
		reply.header( "Context" )
		for ( var p in report.parts ) {
			reply.styled().muted( left( p.label & repeatString( " ", 18 ), 18 ) ).accent( right( "       " & words.approx( p.tokens ), 7 ) ).text( "  " ).muted( p.detail ).print()
		}
		reply.styled().bold( left( "Total" & repeatString( " ", 18 ), 18 ) ).accentBold( right( "       " & words.approx( report.total ), 7 ) ).text( "  " ).muted( report.contextWindow > 0 ? "of #numberFormat( report.contextWindow )# tokens" : "" ).print()
		reply.blank()
		if ( report.contextWindow > 0 ) {
			reply.styled().accent( words.bar( report ) ).text( " " ).muted( "#report.percent#% of the window" ).print()
		} else {
			reply.indent( "The project does not say this model's context window. Add contextWindow to its profile, or to the top of Agent.yml, to see the share it takes." )
		}
		if ( ( report.messages ?: {} ).near ?: false ) {
			reply.warn( "This conversation has #report.messages.count# of the #report.messages.limit# messages its memory keeps. Past that the oldest are dropped as new ones come in; /compact summarizes them instead." )
		}
		if ( report.tools.len() ) {
			reply.styled().muted( "Largest tool definitions: " ).accent( report.tools.slice( 1, min( 5, report.tools.len() ) ).map( t => t.name & " " & words.approx( t.tokens ) ).toList( ", " ) ).print()
		}
		reply.indent( "Estimates (characters divided by four)." & ( report.mcpServers > 0 ? " The tools of #report.mcpServers# MCP server#report.mcpServers == 1 ? '' : 's'# are fetched when a run starts and are not counted." : "" ) )
		return reply
	}

}
