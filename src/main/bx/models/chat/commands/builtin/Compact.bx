class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "compact"
	}

	string function usage() {
		return ""
	}

	string function group() {
		return "Conversation"
	}

	string function hint() {
		return "shorten this conversation: older messages become a summary"
	}

	any function run( required any context, required string args ) {
		var reply = arguments.context.reply()
		var outcome = arguments.context.chat().compact()
		if ( !( outcome.available ?: false ) ) {
			return reply.warn( "This agent names no model, so there is nothing to summarize with. Give it a model, or set summaryProvider and summaryModel on its memory." )
		}
		if ( outcome.compacted ) {
			reply.styled().ok( "Compacted:" ).text( " " ).accent( "#outcome.before# messages" ).muted( " became " ).accent( "#outcome.after#" ).muted( "." & ( len( outcome.model ?: "" ) ? " Summarized with #outcome.model#." : "" ) ).print()
			return reply
		}
		return reply.indent( "Nothing to compact: #outcome.before# messages, already short." )
	}

}
