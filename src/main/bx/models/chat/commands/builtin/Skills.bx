/**
 * /skills: the skills the agent can load, and who wrote each: the project, or the agent itself. /skills <name> shows
 * one skill's text. Never a folder on the machine, so it is safe to show on every transport.
 */
class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "skills"
	}

	string function usage() {
		return "[name]"
	}

	string function group() {
		return "Agent"
	}

	string function hint() {
		return "list the skills the agent can load, or read one: /skills <name>"
	}

	any function run( required any context, required string args ) {
		var chat = arguments.context.chat()
		var reply = arguments.context.reply()
		var wanted = trim( arguments.args )
		if ( len( wanted ) ) {
			var skill = chat.skillText( wanted )
			if ( skill.isEmpty() ) {
				return reply.warn( "There is no skill called [#wanted#]. Type /skills to see them." )
			}
			reply.styled().accentBold( skill.name ).muted( " (" & skill.origin & ")" ).print()
			if ( len( skill.savedAt ?: "" ) ) {
				reply.indent( "saved " & skill.savedAt )
			}
			reply.blank()
			reply.text( skill.body )
			if ( skill.truncated ) {
				reply.warn( "(cut: the skill is #skill.size# characters long)" )
			}
			return reply
		}
		var skills = chat.skills()
		if ( !skills.len() ) {
			return reply.text( "The agent has no skills." )
		}
		reply.header( "Skills" )
		for ( var s in skills ) {
			reply.styled()
				.accentBold( s.name )
				.text( repeatString( " ", max( 2, 26 - len( s.name ) ) ) )
				.muted( s.origin )
				.text( "  " )
				.text( s.description )
				.print()
		}
		return reply.indent( "Read one with /skills <name>." )
	}

}
