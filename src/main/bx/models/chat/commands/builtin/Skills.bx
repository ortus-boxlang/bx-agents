/**
 * /skills: the skills the agent can load, and who wrote each: the project, or the agent itself. /skills <name> shows
 * one skill's text. Never a folder on the machine, so it is safe to show on every transport.
 */
class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "skills"
	}

	string function hint() {
		return "list the skills the agent can load, or read one: /skills <name>"
	}

	any function run( required any context, required string args ) {
		var chat = arguments.context.chat()
		var wanted = trim( arguments.args )
		if ( len( wanted ) ) {
			var skill = chat.skillText( wanted )
			if ( skill.isEmpty() ) {
				return arguments.context.reply().warn( "There is no skill called [#wanted#]. Type /skills to see them." )
			}
			var head = skill.name & " (" & skill.origin & ")" & ( len( skill.savedAt ?: "" ) ? ", saved " & skill.savedAt : "" )
			var cut = skill.truncated ? char( 10 ) & "(cut: the skill is #skill.size# characters long)" : ""
			return arguments.context.reply().text( head & char( 10 ) & char( 10 ) & skill.body & cut )
		}
		var skills = chat.skills()
		if ( !skills.len() ) {
			return arguments.context.reply().text( "The agent has no skills." )
		}
		var lines = skills.map( function( s ) {
			return left( s.name & repeatString( " ", 24 ), 24 ) & left( s.origin & repeatString( " ", 10 ), 10 ) & s.description
		} )
		return arguments.context.reply().text( "Skills:" & char( 10 ) & lines.toList( char( 10 ) ) & char( 10 ) & "Read one with /skills <name>." )
	}

}
