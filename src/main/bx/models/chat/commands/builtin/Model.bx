class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "model"
	}

	string function usage() {
		return ""
	}

	string function group() {
		return "Model"
	}

	string function hint() {
		return "show the model in use"
	}

	any function run( required any context, required string args ) {
		var chat = arguments.context.chat()
		var reply = arguments.context.reply()
		var info = chat.modelInfo()
		reply.header( "Model" )
		reply.labelValue( "Model", len( info.model ?: "" ) ? info.model : "not known" )
		if ( len( info.profile ?: "" ) ) {
			reply.labelValue( "Profile", info.profile )
		}
		for ( var line in new "models.chat.ModelFactsLines@bxagents"().of( chat.modelFacts() ) ) {
			reply.labelValue( line[ 1 ], line[ 2 ] )
		}
		if ( arguments.context.transport() == "tui" && chat.switchable().ok ) {
			reply.blank()
			reply.indent( "Type /profile to pick another, or /default to go back to the app's default." )
		}
		return reply
	}

}
