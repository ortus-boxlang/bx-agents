/**
 * `deploy` CLI verb - ships a built/packaged project to a real deployment
 * target via the pluggable `IDeploymentTarget` interface (M16).
 *
 * Two ways to invoke it:
 *
 *  1. `--name=<entry>` - dispatches to whatever target the named
 *     `deploy/<entry>.bx` (or `.json`) convention entry declares (`local`,
 *     `ssh`, `docker`, `digitalocean`, `ftp`, or `sftp`), resolved and
 *     validated via `DeploymentConfigResolver`.
 *  2. `--target=local --destination=...` (or no `--target` at all, which
 *     defaults to `local`) - the original flag-only form, kept working with
 *     no `deploy/` folder present so the simplest case never needs one.
 *     Only `local` supports this shorthand - every other target needs more
 *     configuration than a couple of flags can reasonably carry.
 */
class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "deploy",
			group : "OPERATE & SHIP",
			position : 7,
			description : "Deploy to a local or remote target",
			usage : "[options]",
			options : [
				{ name : "name", display : "--name=<name>", description : "Use the named deploy/ configuration.", takesValue : true },
				{ name : "target", display : "--target=<type>", description : "Deployment target. Default: local.", takesValue : true },
				{ name : "destination", display : "--destination=<path>", description : "Destination for an ad-hoc deployment.", takesValue : true }
			],
			examples : [ "deploy --name=production", "deploy --destination=/srv/my-agent" ],
			note : "Local and file-transfer targets use a packaged .bxa; Docker and DigitalOcean use the built application."
		}
	}

	static {
		TARGET_CLASSES = {
			"local"        : "models.deploy.targets.LocalTarget@bxagents",
			"ssh"          : "models.deploy.targets.SshTarget@bxagents",
			"docker"       : "models.deploy.targets.DockerTarget@bxagents",
			"digitalocean" : "models.deploy.targets.DigitalOceanTarget@bxagents",
			"ftp"          : "models.deploy.targets.FtpTarget@bxagents",
			"sftp"         : "models.deploy.targets.SftpTarget@bxagents"
		}
	}

	function handle() {
		var root = projectRoot()
		var name = trim( option( "name" ) )
		var target = ""
		var config = {}

		if ( len( name ) ) {
			var entry = new "models.deploy.DeploymentConfigResolver@bxagents"().getEntry( root, name )
			target = entry.target
			config = entry.config
		} else {
			target = len( option( "target" ) ) ? option( "target" ) : "local"
			if ( !static.TARGET_CLASSES.keyExists( target ) ) {
				throw(
					type    = "BxAgents.UnknownDeploymentTarget",
					message = "Unknown deployment target [#target#] - must be one of: #static.TARGET_CLASSES.keyArray().toList()#"
				)
			}
			if ( target != "local" ) {
				throw(
					type    = "BxAgents.MissingDeployEntry",
					message = "deploy target [#target#] requires a deploy/*.bx entry (`deploy --name=<entry>`) - only 'local' supports the flag-only form"
				)
			}
			var destination = trim( option( "destination" ) )
			if ( !len( destination ) ) {
				throw( type = "BxAgents.MissingDestination", message = "`deploy --target=local` requires --destination" )
			}
			config = { destination : destination }
		}

		var manifestPath = root & "/.build/manifest.json"
		var context = {
			projectRoot : root,
			buildDir    : root & "/.build",
			appDir      : root & "/.build/app",
			distDir     : root & "/dist",
			manifest    : fileExists( manifestPath ) ? jsonDeserialize( fileRead( manifestPath ) ) : {}
		}
		var result = new "#static.TARGET_CLASSES[ target ]#"().deploy( config, context )
		return exitWith( result.success ? 0 : 1, result.message, { result : result } )
	}

}
