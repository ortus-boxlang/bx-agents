/**
 * `deploy` CLI verb - ships a built/packaged project to a real deployment
 * target via the pluggable `IDeploymentTarget` interface (M16).
 *
 * Two ways to invoke it:
 *
 *  1. `--name=<entry>` - dispatches to whatever target the named
 *     `deploy/<entry>.bx` (or `.json`) convention entry declares (`local`,
 *     `ssh`, `docker`, `digitalocean`, `ftp`, or `sftp`), resolved and
 *     validated via `DeploymentConfigResolver`.
 *  2. `--target=local --destination=...` (or no `--target` at all, which
 *     defaults to `local`) - the original flag-only form, kept working with
 *     no `deploy/` folder present so the simplest case never needs one.
 *     Only `local` supports this shorthand - every other target needs more
 *     configuration than a couple of flags can reasonably carry.
 */
class {

	variables.TARGET_CLASSES = {
		"local"        : "models.deploy.targets.LocalTarget@bxagents",
		"ssh"          : "models.deploy.targets.SshTarget@bxagents",
		"docker"       : "models.deploy.targets.DockerTarget@bxagents",
		"digitalocean" : "models.deploy.targets.DigitalOceanTarget@bxagents",
		"ftp"          : "models.deploy.targets.FtpTarget@bxagents",
		"sftp"         : "models.deploy.targets.SftpTarget@bxagents"
	}

	/**
	 * @options { projectRoot (required), name (optional, a deploy/* entry), target (optional, defaults to "local"), destination (required for flag-only "local") }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`deploy` requires a project root" )
		}
		var root = projectRoot.reReplace( "[\/]+$", "" )

		var name = trim( arguments.options.name ?: "" )
		var target = ""
		var config = {}

		if ( len( name ) ) {
			var resolver = new "models.deploy.DeploymentConfigResolver@bxagents"()
			var entry = resolver.getEntry( root, name )
			target = entry.target
			config = entry.config
		} else {
			target = len( arguments.options.target ?: "" ) ? arguments.options.target : "local"

			if ( !variables.TARGET_CLASSES.keyExists( target ) ) {
				throw(
					type    = "BxAgents.UnknownDeploymentTarget",
					message = "Unknown deployment target [#target#] - must be one of: #variables.TARGET_CLASSES.keyArray().toList()#"
				)
			}

			if ( target != "local" ) {
				throw(
					type    = "BxAgents.MissingDeployEntry",
					message = "deploy target [#target#] requires a deploy/*.bx entry (`deploy --name=<entry>`) - only 'local' supports the flag-only form"
				)
			}

			var destination = trim( arguments.options.destination ?: "" )
			if ( !len( destination ) ) {
				throw( type = "BxAgents.MissingDestination", message = "`deploy --target=local` requires --destination" )
			}
			config = { destination : destination }
		}

		var manifestPath = root & "/.build/manifest.json"
		var context = {
			projectRoot : root,
			appDir      : root & "/.build/app",
			distDir     : root & "/dist",
			manifest    : fileExists( manifestPath ) ? jsonDeserialize( fileRead( manifestPath ) ) : {}
		}

		var targetInstance = new "#variables.TARGET_CLASSES[ target ]#"()
		var result = targetInstance.deploy( config, context )

		return {
			exitCode : result.success ? 0 : 1,
			message  : result.message,
			result   : result
		}
	}

}
