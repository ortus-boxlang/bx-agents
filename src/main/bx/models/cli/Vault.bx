/**
 * `vault` CLI verb - the secrets an agent uses at run time, sealed in the project's shared chat database
 * (`data/chat.db`, or the file named by BXAGENTS_DB).
 *
 *   bxAgents vault list [--scope=agent|user|all] [--user=NAME] [--json]
 *   bxAgents vault add --name=GMAIL_TOKEN [--scope=agent|user] [--user=NAME] [--description=TEXT] [--hosts=a.com,b.com] [--stdin]
 *   bxAgents vault edit --name=GMAIL_TOKEN [--scope=...] [--user=NAME] [--description=TEXT] [--hosts=...] [--value] [--stdin]
 *   bxAgents vault remove --name=GMAIL_TOKEN [--scope=...] [--user=NAME] [--yes]
 *   bxAgents vault status [--json]
 *   bxAgents vault audit [--limit=N] [--json]
 *   bxAgents vault key
 *
 * A value is never a flag: it would sit in the shell history and the process list. At a terminal you type it,
 * hidden; with --stdin it is read from the pipe (`op read ... | bxAgents vault add --name=X --stdin`). Nothing
 * here prints a value, and a value cannot be shown again after it is saved. The scope defaults to the agent's
 * (shared); --user=NAME makes it that person's own.
 */
import bxModules.bxagents.models.api.Caller;

class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "vault",
			group : "SECURITY & ACCESS",
			position : 4,
			description : "Manage sealed runtime secrets",
			usage : "<action> [options]",
			actions : [ { name : "list" }, { name : "add" }, { name : "edit" }, { name : "remove" }, { name : "status" }, { name : "audit" }, { name : "key" } ],
			options : [
				{ name : "name", display : "--name=<name>", description : "Secret to add, edit, or remove.", takesValue : true },
				{ name : "scope", display : "--scope=<agent|user|all>", description : "Which secrets to list.", takesValue : true },
				{ name : "user", display : "--user=<name>", description : "Owner of a user-scoped secret.", takesValue : true },
				{ name : "description", display : "--description=<text>", description : "What the secret is for.", takesValue : true },
				{ name : "hosts", display : "--hosts=<patterns>", description : "Allowed hosts, comma separated.", takesValue : true },
				{ name : "stdin", description : "Read the secret value from standard input." },
				{ name : "value", description : "Replace a secret's value while editing." },
				{ name : "yes", description : "Confirm removal." },
				{ name : "limit", display : "--limit=<number>", description : "Limit audit entries.", takesValue : true },
				{ name : "json", description : "Print results as JSON." }
			],
			examples : [ "vault list", "vault add --name=API_KEY", "vault status" ],
			note : "Secret values are entered hidden or piped with --stdin, never passed as flags.",
			subcommand : true
		}
	}

	function handleList() {
		var scope = lCase( trim( option( "scope", "all" ) ) )
		var rows = vaultService().listAll()
		if ( scope != "all" ) {
			rows = rows.filter( row => row.scope == scope )
		}
		var wanted = trim( option( "user" ) )
		if ( len( wanted ) ) {
			rows = rows.filter( row => row.scope == "agent" || row.owner == wanted )
		}
		return asJson( rows.map( row => publicRow( row ) ), () => listText( rows ) )
	}

	/**
	 * Save a new secret. The value is typed hidden or piped, never a flag.
	 */
	function handleAdd() {
		var name = requiredOption( "name", "BxAgents.MissingVaultOption", "`vault add` needs --name=<SECRET_NAME>, for example --name=GMAIL_TOKEN" )
		var target = targetOf()
		var value = readValue( "Value for #name#" )
		var made = vaultService().add( name, value, {
			scope       : target.scope,
			owner       : target.owner,
			description : option( "description" ),
			hosts       : option( "hosts", [] ),
			actor       : Caller::localId(),
			via         : "cli"
		} )
		return done( "Saved #target.scope# secret [#made.name#]#target.scope == 'user' ? ' for ' & target.owner : ''#. It is sealed and cannot be shown again." )
	}

	/**
	 * Change a secret: its description, its hosts and, when asked, its value. Only what is given changes.
	 */
	function handleEdit() {
		var name = requiredOption( "name", "BxAgents.MissingVaultOption", "`vault edit` needs --name=<SECRET_NAME>" )
		var target = targetOf()
		var changes = {}
		if ( variables.options.keyExists( "description" ) ) {
			changes[ "description" ] = option( "description" )
		}
		if ( variables.options.keyExists( "hosts" ) ) {
			changes[ "hosts" ] = option( "hosts" )
		}
		if ( isOptionSet( "stdin" ) || isOptionSet( "value" ) || !changes.count() ) {
			changes[ "value" ] = readValue( "New value for #name#" )
		}
		vaultService().update( name, changes, { scope : target.scope, owner : target.owner, actor : Caller::localId(), via : "cli" } )
		return done( "Updated #target.scope# secret [#name#]: #changes.keyArray().sort( 'text' ).toList( ', ' )#." )
	}

	/**
	 * Remove a secret, after asking unless --yes is given.
	 */
	function handleRemove() {
		var name = requiredOption( "name", "BxAgents.MissingVaultOption", "`vault remove` needs --name=<SECRET_NAME>" )
		var target = targetOf()
		if ( !isOptionSet( "yes" ) ) {
			var prompter = openPrompter()
			var sure = prompter.confirm( "Remove the #target.scope# secret #name#?", "Anything that uses it will stop working.", false )
			prompter.close()
			if ( !sure ) {
				return fail( "Nothing removed." )
			}
		}
		return vaultService().remove( name, { scope : target.scope, owner : target.owner, actor : Caller::localId(), via : "cli" } )
			? done( "Removed [#name#]." )
			: fail( "There is no #target.scope# secret named [#name#]. See `bxAgents vault list`." )
	}

	/**
	 * Say where the key comes from, how many secrets there are and whether any cannot be opened with this key.
	 */
	function handleStatus() {
		var state = vaultService().status()
		state[ "database" ] = chatStoreFile()
		if ( isOptionSet( "json" ) ) {
			return done( jsonSerialize( state ) )
		}
		var report = [
			"Secrets:  #state.secrets#",
			"Key:      #state.keySource == 'env' ? 'from BXAGENTS_VAULT_KEY' : ( state.keySource == 'file' ? 'a key file next to the database' : 'none yet (made when the first secret is saved)' )#",
			"Database: #chatStoreFile()#"
		]
		if ( state.keySource == "file" ) {
			report.append( "" )
			report.append( "The key file sits beside the data it protects: anyone who copies the data folder gets both." )
			report.append( "Set BXAGENTS_VAULT_KEY to a key you keep elsewhere (`bxAgents vault key` makes one)." )
		}
		if ( state.wrongKey > 0 ) {
			report.append( "" )
			report.append( "#state.wrongKey# secret(s) were sealed with another key and cannot be opened with this one." )
		}
		return exitWith( state.wrongKey > 0 ? 1 : 0, report.toList( char( 10 ) ) )
	}

	/**
	 * List the latest audit rows: who added, used, was refused and removed what. Never a value.
	 */
	function handleAudit() {
		var rows = vaultService().audit( isNumeric( option( "limit" ) ) ? option( "limit" ) : 50 )
		return asJson( rows, () => auditText( rows ) )
	}

	/**
	 * Make a new random key to put in BXAGENTS_VAULT_KEY. Does not touch the database.
	 */
	function handleKey() {
		var key = new "models.vault.VaultKey@bxagents"( projectRoot() ).generate()
		return done( "A new vault key. Keep it somewhere safe, and set it where the agent runs:#char( 10 )##char( 10 )#  BXAGENTS_VAULT_KEY=#key##char( 10 )##char( 10 )#It cannot be recovered if you lose it, and secrets sealed with another key will not open.", { key : key } )
	}

	// ----------------------------------------------------------------------------------

	/**
	 * @return The VaultService on this project's chat database, whose folder is created
	 */
	private any function vaultService() {
		var file = chatStoreFile()
		directoryCreate( getDirectoryFromPath( file ), true, true )
		return new "models.vault.VaultWiring@bxagents"().service( file )
	}

	/**
	 * The terminal, or the prompter a test hands in.
	 */
	private any function openPrompter() {
		var given = option( "prompter", "" )
		return isObject( given ) ? given : new "models.wizard.prompters.PrompterFactory@bxagents"().create( variables.options, "vault" )
	}

	private string function listText( required array rows ) {
		if ( !arguments.rows.len() ) {
			return "No secrets yet. Add one with `bxAgents vault add --name=GMAIL_TOKEN`."
		}
		var report = [ pad( "NAME", 26 ) & pad( "SCOPE", 8 ) & pad( "OWNER", 14 ) & pad( "HOSTS", 28 ) & pad( "LAST USED", 17 ) & "ABOUT" ]
		for ( var row in arguments.rows ) {
			report.append(
				pad( row.name, 26 ) & pad( row.scope, 8 ) & pad( len( row.owner ) ? row.owner : "-", 14 )
				& pad( row.hosts.len() ? row.hosts.toList( "," ) : "any", 28 )
				& pad( isDate( row.lastUsedAt ) ? dateTimeFormat( row.lastUsedAt, "yyyy-MM-dd HH:mm" ) : "never", 17 )
				& row.description
			)
		}
		return report.toList( char( 10 ) )
	}

	private string function auditText( required array rows ) {
		if ( !arguments.rows.len() ) {
			return "Nothing recorded yet."
		}
		var report = [ pad( "WHEN", 17 ) & pad( "ACTION", 9 ) & pad( "NAME", 24 ) & pad( "SCOPE", 8 ) & pad( "WHO", 14 ) & pad( "VIA", 22 ) & "RESULT" ]
		for ( var row in arguments.rows ) {
			report.append(
				pad( dateTimeFormat( row.at, "yyyy-MM-dd HH:mm" ), 17 ) & pad( row.action, 9 ) & pad( row.name, 24 ) & pad( row.scope, 8 )
				& pad( len( row.actor ) ? row.actor : "-", 14 ) & pad( len( row.via ) ? row.via : "-", 22 ) & ( row.ok == 1 ? "ok" : "refused" )
			)
		}
		return report.toList( char( 10 ) )
	}

	/**
	 * The value: piped in with --stdin, else typed hidden at a terminal. Never from a flag.
	 */
	private string function readValue( required string title ) {
		if ( variables.options.keyExists( "stdinText" ) ) {
			return trim( variables.options.stdinText )
		}
		if ( isOptionSet( "stdin" ) ) {
			var text = createObject( "java", "java.lang.String" ).init( createObject( "java", "java.lang.System" )[ "in" ].readAllBytes(), "UTF-8" )
			text = text.reReplace( "[\r\n]+$", "" )
			if ( !len( text ) ) {
				throw( type = "BxAgents.VaultEmptyValue", message = "--stdin read nothing. Pipe the value in." )
			}
			return text
		}
		var prompter = openPrompter()
		var typed = prompter.text( arguments.title, "It is hidden as you type and is never shown again.", "", true, "A secret needs a value." )
		prompter.close()
		return typed
	}

	/**
	 * @return { scope, owner }: the agent's by default, a person's with --user (or --scope=user for yourself)
	 */
	private struct function targetOf() {
		var user = trim( option( "user" ) )
		var scope = lCase( trim( option( "scope", len( user ) ? "user" : "agent" ) ) )
		if ( !listFindNoCase( "agent,user", scope ) ) {
			throw( type = "BxAgents.InvalidVaultScope", message = "--scope must be agent or user." )
		}
		if ( scope == "user" && !len( user ) ) {
			user = Caller::localId()
		}
		return { scope : scope, owner : scope == "user" ? user : "" }
	}

	/**
	 * A secret as the JSON output shows it: names and dates, never a value.
	 */
	private struct function publicRow( required struct row ) {
		return {
			name        : arguments.row.name,
			scope       : arguments.row.scope,
			owner       : arguments.row.owner,
			description : arguments.row.description,
			hosts       : arguments.row.hosts,
			createdAt   : stamp( arguments.row.createdAt ),
			updatedAt   : stamp( arguments.row.updatedAt ),
			lastUsedAt  : stamp( arguments.row.lastUsedAt )
		}
	}

	private string function stamp( any value ) {
		return isDate( arguments.value ?: "" ) ? dateTimeFormat( arguments.value, "yyyy-MM-dd HH:mm" ) : ""
	}

	/**
	 * A column: text that is longer than its width keeps all of its characters and gets one space after it, which
	 * padRight() would cut.
	 */
	private string function pad( required string text, required numeric width ) {
		return len( arguments.text ) >= arguments.width ? arguments.text & " " : padRight( arguments.text, arguments.width )
	}

}
