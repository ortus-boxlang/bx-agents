/**
 * `package` CLI verb - thin dispatcher over PackagerService (M12). Requires
 * a prior `build` (reads its .build/manifest.json) - refuses to run (and
 * produces no .bxa) if no build exists yet.
 */
class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "package",
			group : "OPERATE & SHIP",
			position : 6,
			description : "Package the application as a .bxa",
			usage : "[options]",
			options : [
				{ name : "version", display : "--version=<version>", description : "Version of the packaged application.", takesValue : true }
			],
			examples : [ "package --version=1.0.0" ],
			note : "Requires a prior build. Writes a portable .bxa archive and checksum into dist/."
		}
	}

	function handle() {
		var root = projectRoot()
		var manifestPath = root & "/.build/manifest.json"
		if ( !fileExists( manifestPath ) ) {
			throw(
				type    = "BxAgents.NotBuilt",
				message = "No build found at [#root#/.build] - run `build` first"
			)
		}

		var manifest = jsonDeserialize( fileRead( manifestPath ) )
		var version = len( option( "version" ) ) ? option( "version" ) : "1.0.0"
		var agentName = len( manifest.agent.name ?: "" ) ? manifest.agent.name : "bx-agent"

		// "@bxagents" suffix, not a bare "bxagents.models...." path - see BuildPipeline.bx's init() docblock for why.
		var result = new "models.build.PackagerService@bxagents"().package(
			projectRoot = root,
			buildDir    = root & "/.build",
			distDir     = root & "/dist",
			manifest    = manifest,
			baseName    = "#agentName#-#version#"
		)
		return done( "Packaged: #result.bxa#", { result : result } )
	}

}
