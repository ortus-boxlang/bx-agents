/**
 * `chat` CLI verb - an interactive REPL against a built project's agent,
 * using BoxLang's own `ortus.boxlang.runtime.cli.MiniConsole` for line
 * reading (history, raw-mode input) rather than hand-rolling stdin reads.
 *
 * Requires a prior `build`. Three modes, all driving the same REPL loop:
 *
 *   - DEFAULT (no flag): loads `GeneratedAgentFactory.bx` directly and calls
 *     `buildAgent()` once per session. Fast - no server, no ColdBox, no
 *     WireBox - and the same factory a `serve`-launched app uses, so the
 *     agent itself never diverges. What DOES differ is everything ColdBox
 *     brings: no scheduler, no interceptors, no gateway
 *     registry. For a plain "talk to my agent" loop that is the right
 *     trade; when it isn't, use `--server`.
 *
 *   - `--server`: boots a real, throwaway `boxlang-miniserver` on an
 *     ephemeral loopback port and drives the REPL over HTTP against the
 *     project's always-on `/__bxagents` route, tearing the server back down
 *     on exit. Full application semantics, because it IS the application.
 *
 *   - `--connect=<url>`: drives the same REPL against an ALREADY-running
 *     server (a `serve` in another terminal, or a deployment), starting
 *     nothing and stopping nothing.
 *
 * `--server` and `--connect` are mutually exclusive: one says "start a server
 * for me", the other "do not". Both use `support/AgentClient.bx`, which also
 * carries the `threadId` across turns so a session is a real conversation
 * rather than a series of unrelated first messages.
 *
 * `GeneratedAgentFactory.bx` itself loads the project's tools/ into bx-ai's
 * global tool registry (see ColdBoxAppGenerator.renderAgentFactory()'s
 * docblock for the real bug this fixed), so the default mode needs no special
 * handling for that here.
 */
import bxModules.bxagents.models.util.Terminal;

class {

	/**
	 * @options { projectRoot (required, absolute path) }
	 */
	/**
	 * @options { projectRoot (required, absolute path), server (optional boolean - boot a throwaway miniserver and chat over real HTTP), connect (optional - the base URL of an already-running server, e.g. "http://127.0.0.1:8080"), token (optional - the access token for a server that wants one; BXAGENTS_TOKEN in the environment does the same) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`chat` requires a project root" )
		}

		var root = projectRoot.reReplace( "[\/]+$", "" )

		var useServer  = arguments.options.server ?: false
		var connectUrl = trim( arguments.options.connect ?: "" )

		// One says "start a server", the other "talk to one that already
		// exists". Honoring either silently would mean ignoring what the
		// other one asked for.
		if ( useServer && len( connectUrl ) ) {
			throw(
				type    = "BxAgents.ConflictingChatTarget",
				message = "--server and --connect are mutually exclusive: --server boots its own throwaway server, --connect talks to one that is already running. Pick one."
			)
		}

		if ( len( connectUrl ) ) {
			return chatOverHttp( connectUrl, "", arguments.options )
		}

		requireBuild( root )

		if ( useServer ) {
			// `_client` replaces the real one, for tests
			var client = arguments.options._client ?: new "models.cli.support.AgentClient@bxagents"()
			var launched = client.startServer( root, arguments.options.port ?: nullValue() )
			// The throwaway server belongs to this chat: it goes down when the chat ends, however it ends.
			// (--connect never stops anything: that server is somebody else's.)
			try {
				return chatOverHttp( launched.baseUrl, "Started a throwaway server on #launched.baseUrl#", arguments.options )
			} finally {
				client.stopServer( launched.process ?: nullValue() )
			}
		}

		return chatInProcess( root, arguments.options )
	}

	/**
	 * Whether to draw the chat screen: at a terminal, unless --no-tui. The numbered
	 * line-by-line chat below it stays as the fallback for a pipe or a dumb terminal.
	 *
	 * @options The parsed CLI options
	 */
	private boolean function wantsScreen( required struct options ) {
		if ( arguments.options.keyExists( "_screen" ) ) {
			return true
		}
		if ( ( arguments.options.tui ?: true ) == false ) {
			return false
		}
		return Terminal::isInteractive()
	}

	/**
	 * Chats in the Pi-style screen: finished turns go to the terminal's scrollback, only the
	 * message box and the answer being written are redrawn.
	 *
	 * @session InProcessSession or HttpSession
	 * @options The parsed CLI options; a `_screen` entry replaces the real screen, for tests
	 *
	 * @return This verb's own { exitCode, message } result
	 */
	private struct function chatWithScreen( required any session, required struct options ) {
		var controller = new "models.cli.chat.ChatController@bxagents"( arguments.session )
		var screen = arguments.options._screen ?: createObject( "java", "ortus.boxlang.bxagents.tui.ChatScreen" ).open( controller.commands() )
		var saved = ""
		try {
			// --session=<number or id> opens that conversation, --continue the most recent one
			var resume = trim( arguments.options.session ?: "" )
			if ( !len( resume ) && ( arguments.options.continue ?: false ) ) {
				resume = "last"
			}
			controller.run( screen, arguments.options.record ?: false, resume )
		} finally {
			// close() finishes the recording, so ask for its file first
			saved = screen.isRecording() ? screen.recordingFile() : ""
			screen.close()
			arguments.session.close()
		}
		return {
			exitCode : 0,
			message  : "Chat session ended" & ( len( saved ) ? ". Recording saved to #saved#" : "" )
		}
	}

	/**
	 * Fails early and clearly when there is nothing built to chat with.
	 *
	 * Deliberately NOT applied to `--connect`: that mode talks to a server
	 * someone else is running, which may be a deployment on another machine
	 * entirely, so demanding a local `.build/` would be wrong.
	 *
	 * @root Absolute path to the project root, trailing slash stripped
	 *
	 * @throws BxAgents.NotBuilt When the project has no generated app
	 */
	private void function requireBuild( required string root ) {
		if ( !fileExists( arguments.root & "/.build/app/agent/GeneratedAgentFactory.bx" ) ) {
			throw(
				type    = "BxAgents.NotBuilt",
				message = "No build found at [#arguments.root#/.build] - run `build` first"
			)
		}
	}

	/**
	 * The default mode: load the generated factory directly and talk to the
	 * agent object in this process.
	 *
	 * @root Absolute path to the project root, trailing slash stripped
	 *
	 * @return This verb's own { exitCode, message } result
	 */
	private struct function chatInProcess( required string root, struct options = {} ) {
		var user = trim( arguments.options.user ?: "" )
		var agent = new "models.cli.support.BuiltAgent@bxagents"().load( arguments.root )

		if ( wantsScreen( arguments.options ) ) {
			return chatWithScreen( new "models.cli.chat.InProcessSession@bxagents"( agent, user, openSessions( arguments.root ) ), arguments.options )
		}

		// MiniConsole shells out to `stty` to set up raw terminal mode, so it
		// can only be constructed against a real interactive TTY - this is
		// intentionally the last line before the loop, so every failure mode
		// above (missing project root, no build) stays testable without one.
		var console = createObject( "java", "ortus.boxlang.runtime.cli.MiniConsole" ).init( "you> " )

		println( "Chatting with the agent - type 'exit' or 'quit' to leave." )

		var running = true
		while ( running ) {
			var input = console.readLine()
			if ( isNull( input ) ) {
				running = false
				continue
			}

			var trimmedInput = trim( input )
			if ( trimmedInput == "exit" || trimmedInput == "quit" ) {
				running = false
				continue
			}
			if ( !len( trimmedInput ) ) {
				continue
			}

			try {
				println( "agent> " & agent.run( trimmedInput, {}, { userId : len( user ) ? user : ( createObject( "java", "java.lang.System" ).getProperty( "user.name" ) ?: "default" ) } ) )
			} catch ( any e ) {
				println( "error> " & e.message )
			}
		}

		return {
			exitCode : 0,
			message  : "Chat session ended"
		}
	}

	/**
	 * The list of conversations in the project's chat database, shared with the web chat.
	 *
	 * @root The project root
	 *
	 * @return A SessionStore, or null when the database cannot be opened (the chat then keeps no list)
	 */
	private any function openSessions( required string root ) {
		try {
			var file = new "models.store.ChatStorePath@bxagents"().forProject( arguments.root )
			directoryCreate( getDirectoryFromPath( file ), true, true )
			var store = new "models.store.ChatStore@bxagents"( { driver : "sqlite", database : file } )
			store.migrate()
			return new "models.store.SessionStore@bxagents"( store )
		} catch ( any e ) {
			return nullValue()
		}
	}

	/**
	 * The `--server` / `--connect` mode: drive the same REPL over real HTTP
	 * against a project's always-on `/__bxagents` route.
	 *
	 * Carries the `threadId` the server hands back into every subsequent turn,
	 * so the session is one conversation. Without that each line would start a
	 * fresh thread and the agent would have no memory of the previous one -
	 * which is exactly what a REPL must not do.
	 *
	 * A per-turn error does NOT end the session (same as the in-process loop):
	 * one failed turn is worth reporting and moving past, not worth throwing
	 * away the conversation for. A server that never becomes ready at all is
	 * different, and surfaces from the first send().
	 *
	 * @baseUrl The server root to talk to
	 * @banner An extra line to print before the prompt (e.g. which server was started); blank prints nothing
	 *
	 * @return This verb's own { exitCode, message } result
	 */
	private struct function chatOverHttp( required string baseUrl, string banner = "", struct options = {} ) {
		var client = arguments.options._client ?: new "models.cli.support.AgentClient@bxagents"()
		var target = arguments.baseUrl.reReplace( "[\/]+$", "" )

		// a server that wants a token: --token=<token>, or BXAGENTS_TOKEN in the environment
		var token = trim( arguments.options.token ?: getSystemSetting( "BXAGENTS_TOKEN", "" ) )
		if ( len( token ) ) {
			client.withToken( token )
		}

		if ( wantsScreen( arguments.options ) ) {
			if ( len( trim( arguments.banner ) ) ) {
				println( arguments.banner )
			}
			return chatWithScreen( new "models.cli.chat.HttpSession@bxagents"( target, client ), arguments.options )
		}

		if ( len( trim( arguments.banner ) ) ) {
			println( arguments.banner )
		}

		// Constructed after everything that can fail without a terminal, for
		// the same reason as the in-process loop: MiniConsole needs a real TTY.
		var console = createObject( "java", "ortus.boxlang.runtime.cli.MiniConsole" ).init( "you> " )

		println( "Chatting with the agent at #target# - type 'exit' or 'quit' to leave." )

		var threadId = ""
		var running = true
		while ( running ) {
			var input = console.readLine()
			if ( isNull( input ) ) {
				running = false
				continue
			}

			var trimmedInput = trim( input )
			if ( trimmedInput == "exit" || trimmedInput == "quit" ) {
				running = false
				continue
			}
			if ( !len( trimmedInput ) ) {
				continue
			}

			try {
				var result = streamTurn( client, target, trimmedInput, threadId )
				threadId = result.threadId ?: threadId
			} catch ( any e ) {
				println( "error> " & e.message )
			}
		}

		return {
			exitCode : 0,
			message  : "Chat session ended"
		}
	}

	/**
	 * Runs one turn, streaming the reply into the terminal as it arrives.
	 *
	 * Streaming is what makes an HTTP chat feel like a REPL rather than a slow
	 * `invoke`: without it a long answer sits behind a blank prompt and then
	 * lands all at once. The deltas are printed with `print()` so they build up
	 * on one line, and the newline is written once the turn ends.
	 *
	 * Falls back to the non-streaming `/invoke` route if the stream cannot be
	 * opened. That is not defensive padding - a server old enough to lack a
	 * `/stream` sub-route, or a proxy that will not do `text/event-stream`,
	 * should still give someone a working chat rather than an error. An
	 * auth failure is deliberately NOT caught here: retrying a 401 without a
	 * token just fails again more slowly and hides the real cause.
	 *
	 * @client The shared AgentClient
	 * @target The server root to talk to
	 * @message The prompt for this turn
	 * @threadId The conversation so far; blank starts a new one
	 *
	 * @return The client's own { output, threadId, ... } result
	 */
	private struct function streamTurn(
		required any client,
		required string target,
		required string message,
		required string threadId
	) {
		print( "agent> " )

		var streamed = false
		try {
			var result = arguments.client.stream(
				baseUrl  : arguments.target,
				message  : arguments.message,
				threadId : arguments.threadId,
				onDelta  : ( delta ) => {
					streamed = true
					print( delta )
				}
			)
			println( "" )

			// A turn that stopped for a human decision produces no content at
			// all, which would otherwise look like the agent simply said
			// nothing. Say what actually happened, and where to answer it.
			if ( result.suspended ?: false ) {
				println( "       (paused for a human-in-the-loop decision - answer it at #arguments.target#/gateways/interactions/)" )
			}
			return result
		} catch ( any e ) {
			if ( e.type == "BxAgents.AgentApiUnauthorized" ) {
				rethrow
			}
			// Nothing was printed yet, so the fallback's own output still lands
			// under the same "agent> " prompt already on screen. If deltas HAD
			// started arriving, re-running the turn would double the visible
			// answer, so that case surfaces as an error instead.
			if ( streamed ) {
				println( "" )
				rethrow
			}
		}

		var fallback = arguments.client.send(
			baseUrl        : arguments.target,
			message        : arguments.message,
			timeoutSeconds : len( arguments.threadId ) ? 60 : 30,
			threadId       : arguments.threadId
		)
		println( fallback.output )
		return fallback
	}

}
