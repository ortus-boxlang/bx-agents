/**
 * `chat` CLI verb - an interactive REPL against a built project's agent,
 * using BoxLang's own `ortus.boxlang.runtime.cli.MiniConsole` for line
 * reading (history, raw-mode input) rather than hand-rolling stdin reads.
 *
 * Requires a prior `build`. Three modes, all driving the same REPL loop:
 *
 *   - DEFAULT (no flag): the CLI starts an isolated BoxLang process with the
 *     built app's runtime config and home, then loads `GeneratedAgentFactory.bx`
 *     directly and calls `buildAgent()` once per session. No server, ColdBox
 *     or WireBox; the factory is the same one a `serve`-launched app uses, so
 *     the agent itself never diverges. What DOES differ is everything ColdBox
 *     brings: no scheduler, no interceptors, no gateway registry. For a plain
 *     "talk to my agent" loop that is the right trade; when it isn't, use
 *     `--server`.
 *
 *   - `--server`: boots a real, throwaway `boxlang-miniserver` on an
 *     ephemeral loopback port and drives the REPL over HTTP against the
 *     project's always-on `/__bxagents` route, tearing the server back down
 *     on exit. Full application semantics, because it IS the application.
 *
 *   - `--connect=<url>`: drives the same REPL against an ALREADY-running
 *     server (a `serve` in another terminal, or a deployment), starting
 *     nothing and stopping nothing.
 *
 * `--server` and `--connect` are mutually exclusive: one says "start a server
 * for me", the other "do not". Both use `support/AgentClient.bx`, which also
 * carries the `threadId` across turns so a session is a real conversation
 * rather than a series of unrelated first messages.
 *
 * `GeneratedAgentFactory.bx` itself loads the project's tools/ into bx-ai's
 * global tool registry (see ColdBoxAppGenerator.renderAgentFactory()'s
 * docblock for the real bug this fixed), so the default mode needs no special
 * handling for that here.
 */
import bxModules.bxagents.models.api.Caller;
import bxModules.bxagents.models.connect.OAuthServers;

import bxModules.bxagents.models.util.Terminal;

class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "chat",
			group : "BUILD & RUN",
			position : 2,
			description : "Chat with an agent in your terminal",
			usage : "[options]",
			options : [
				{ name : "server", description : "Start a temporary server for the full application." },
				{ name : "connect", display : "--connect=<url>", description : "Chat with an already-running server.", takesValue : true },
				{ name : "token", display : "--token=<token>", description : "API access token for a protected server.", takesValue : true },
				{ name : "api-path", display : "--api-path=<path>", description : "Custom API path. Default: /__bxagents.", takesValue : true },
				{ name : "port", display : "--port=<number>", description : "Port for the temporary server.", takesValue : true },
				{ name : "agent", display : "--agent=<name>", description : "Chat with a named agent.", takesValue : true },
				{ name : "user", display : "--user=<name>", description : "Conversation owner. Default: local.", takesValue : true },
				{ name : "continue", description : "Resume the most recent conversation." },
				{ name : "session", display : "--session=<number-or-id>", description : "Resume a particular conversation.", takesValue : true },
				{ name : "record", display : "--record[=<file>]", description : "Record the terminal session." },
				{ name : "inline", display : "--inline / --fullscreen", description : "Choose the terminal layout." },
				{ name : "no-tui", description : "Use the plain line-by-line chat." }
			],
			examples : [ "chat", "chat --server", "chat --connect=http://127.0.0.1:8080" ],
			note : "Requires a prior build. Type / inside chat to discover slash commands."
		}
	}


	/**
	 * Runs the chat command, either in-process, over HTTP to a throwaway server, or connecting to an existing server.
	 * Reads: { server (optional boolean - boot a throwaway miniserver and chat over real HTTP), connect (optional - the base URL of an already-running server, e.g. "http://127.0.0.1:8080"), token (optional - the access token for a server that wants one; BXAGENTS_TOKEN in the environment does the same), api-path (optional - where the server serves its API when it is not the default) }
	 */
	function handle() {
		var options = variables.options
		var root = projectRoot()

		var useServer  = isOptionSet( "server" )
		var connectUrl = trim( option( "connect" ) )

		// One says "start a server", the other "talk to one that already
		// exists". Honoring either silently would mean ignoring what the
		// other one asked for.
		if ( useServer && len( connectUrl ) ) {
			throw(
				type    = "BxAgents.ConflictingChatTarget",
				message = "--server and --connect are mutually exclusive: --server boots its own throwaway server, --connect talks to one that is already running. Pick one."
			)
		}

		if ( len( connectUrl ) ) {
			return chatOverHttp( connectUrl, "", options )
		}

		requireBuild( root )

		if ( useServer ) {
			// `_client` replaces the real one, for tests
			var client = options._client ?: new "models.cli.support.AgentClient@bxagents"()
			var launched = client.startServer( root, options.port ?: nullValue() )
			// The throwaway server belongs to this chat: it goes down when the chat ends, however it ends.
			// (--connect never stops anything: that server is somebody else's.)
			try {
				return chatOverHttp( launched.baseUrl, "Started a throwaway server on #launched.baseUrl#", options )
			} finally {
				client.stopServer( launched.process ?: nullValue() )
			}
		}

		if ( options.keyExists( "_rawArgs" ) ) {
			var rawArgs = options._rawArgs
			options.delete( "_rawArgs" )
			if ( !isRuntimeChild() ) {
				return chatInBoxLangProcess( root, rawArgs, options )
			}
		}

		var startupSpinner = isRuntimeChild() && wantsScreen( options )
			? createObject( "java", "ortus.boxlang.bxagents.tui.StartupSpinner" ).start( "loading your agent" )
			: nullValue()
		if ( !isNull( startupSpinner ) ) {
			options._startupSpinner = startupSpinner
		}
		try {
			return chatInProcess( root, options )
		} finally {
			if ( !isNull( startupSpinner ) ) {
				startupSpinner.close()
			}
		}
	}

	/**
	 * Starts the local chat in a fresh BoxLang runtime so it can use the built
	 * app's config and home, rather than the runtime that loaded the CLI.
	 *
	 * @root Absolute path to the project root, trailing slash stripped
	 * @rawArgs Original chat argv, excluding the `chat` verb
	 * @options Parsed options, used for the module source override
	 *
	 * @return This verb's own { exitCode, message } result
	 */
	private struct function chatInBoxLangProcess( required string root, required array rawArgs, required struct options ) {
		// Determine the layout of the built project, including runtime and module directories.
		var layout = new "models.build.layout.BuildLayout@bxagents"().of( arguments.root )
		var runtimeConfig = layout.runtimeDir & "/boxlang.json"
		if ( !fileExists( runtimeConfig ) ) {
			throw(
				type    = "BxAgents.MissingRuntimeConfig",
				message = "The built BoxLang runtime config is missing at [#runtimeConfig#] - run `build` again"
			)
		}

		// Copy the bxagents module into the runtime's module directory to ensure it is available for the local chat.
		var copier = new "models.build.layout.ModuleCopier@bxagents"()
		copier.copy( copier.sourceDir( arguments.options.moduleDir ?: "" ), layout.runtimeDir )
		var installedCopies = directoryExists( layout.modulesDir ) ? directoryList( path = layout.modulesDir, recurse = false, type = "dir" ) : []
		if ( !installedCopies.len() ) {
			throw(
				type    = "BxAgents.NoModuleInBuild",
				message = "The build has no bxagents module in [#layout.modulesDir#], so local chat could not load. Run `build` with BX Agents installed as a module, or set BXAGENTS_MODULE_DIR to the built module folder."
			)
		}

		// Launch the local chat in a fresh BoxLang process with the built runtime and module layout.
		var launcher = createObject( "java", "ortus.boxlang.bxagents.build.BoxLangCliLauncher" )
		var executable = launcher.findExecutable()
		if ( isNull( executable ) ) {
			throw(
				type    = "BxAgents.BoxLangNotFound",
				message = "The `boxlang` executable was not found on PATH. Local chat needs it to start with this project's runtime config and home."
			)
		}

		// Prepare the arguments for the child BoxLang process, starting with the `chat` verb.
		var childArgs = createObject( "java", "java.util.ArrayList" ).init()
		childArgs.add( "chat" )
		for ( var rawArg in arguments.rawArgs ) {
			childArgs.add( toString( rawArg ) )
		}
		childArgs.add( "--projectRoot=" & arguments.root )

		// Launch the child BoxLang process with the prepared arguments and environment.
		var process = launcher.launch(
			executable,
			runtimeConfig,
			layout.runtimeDir,
			layout.buildDir,
			childArgs,
			createObject( "java", "java.util.HashMap" ).init(),
			true
		)
		try {
			return exitWith( process.waitFor(), "" )
		} catch ( any e ) {
			if ( process.isAlive() ) {
				process.destroyForcibly()
			}
			rethrow
		}
	}

	/**
	 * The marker is set only for the child process started by chat's CLI dispatch.
	 */
	private boolean function isRuntimeChild() {
		return getSystemSetting( "BXAGENTS_INTERNAL_CHAT_CHILD", "" ) == "1"
	}

	/**
	 * Whether to draw the chat screen: at a terminal, unless --no-tui. The numbered
	 * line-by-line chat below it stays as the fallback for a pipe or a dumb terminal.
	 *
	 * @options The parsed CLI options
	 */
	private boolean function wantsScreen( required struct options ) {
		if ( arguments.options.keyExists( "_screen" ) ) {
			return true
		}
		if ( ( arguments.options.tui ?: true ) == false ) {
			return false
		}
		return Terminal::isInteractive()
	}

	/**
	 * Chats in the Pi-style screen: finished turns go to the terminal's scrollback, only the
	 * message box and the answer being written are redrawn.
	 *
	 * @session InProcessSession or HttpSession
	 * @options The parsed CLI options; a `_screen` entry replaces the real screen, for tests
	 *
	 * @return This verb's own { exitCode, message } result
	 */
	private struct function chatWithScreen( required any session, required struct options ) {
		var startupSpinner = arguments.options.keyExists( "_startupSpinner" ) ? arguments.options._startupSpinner : nullValue()
		arguments.options.delete( "_startupSpinner" )

		// --agent=NAME talks to a sub-agent directly; an unknown name stops here, before the screen opens
		if ( len( trim( arguments.options.agent ?: "" ) ) ) {
			arguments.session.withAgent( trim( arguments.options.agent ) )
		}
		// the commands the chat has: the built-ins, then what the project's and the person's extensions add
		var commands = new "models.chat.commands.CommandCatalog@bxagents"().standard()
		var extensions = arguments.options._extensions ?: new "models.extensions.ExtensionService@bxagents"( projectRoot : trim( arguments.options.projectRoot ?: "" ), transport : "tui" )
		extensions.install( commands )
		// how the chat looks and behaves: the flags, the agent's own settings, yours, the project's, then the defaults
		var loader = new "models.tui.TuiSettingsLoader@bxagents"( projectRoot : len( trim( arguments.options.connect ?: "" ) ) ? "" : trim( arguments.options.projectRoot ?: "" ), flags : arguments.options )
		var tuiSettings = loader.load()
		var notices = extensions.problems()
		notices.append( tuiSettings.problems, true )
		var controller = new "models.cli.chat.ChatController@bxagents"( session : arguments.session, registry : commands ).withNotices( notices ).withProject( len( trim( arguments.options.connect ?: "" ) ) ? "" : trim( arguments.options.projectRoot ?: "" ) )
		if ( structKeyExists( extensions, "keys" ) ) {
			controller.withExtensions( extensions )
		}
		if ( structKeyExists( extensions, "events" ) ) {
			controller.withEvents( extensions.events() )
		}
		if ( !isNull( startupSpinner ) ) {
			startupSpinner.close()
		}
		var screen = arguments.options._screen ?: createObject( "java", "ortus.boxlang.bxagents.tui.ChatScreen" ).open( controller.commands(), tuiSettings.settings.bool( "fullscreen" ) )
		if ( !arguments.options.keyExists( "_screen" ) ) {
			// the tui: block of Agent.yml: the prompt style and widgets (a project without one gets the defaults)
			screen.useLook( tuiSettings.look )
			screen.useSettings( tuiSettings.settings, loader.agentFile(), loader.userFile() )
		}
		var saved = ""
		try {
			// --session=<number or id> opens that conversation, --continue the most recent one
			var resume = trim( arguments.options.session ?: "" )
			if ( !len( resume ) && ( arguments.options.continue ?: false ) ) {
				resume = "last"
			}
			controller.run( screen, arguments.options.record ?: false, resume )
		} finally {
			// close() finishes the recording, so ask for its file first
			saved = screen.isRecording() ? screen.recordingFile() : ""
			screen.close()
			arguments.session.close()
			extensions.unload()
		}
		return done( "Chat session ended" & ( len( saved ) ? ". Recording saved to #saved#" : "" ) )
	}

	/**
	 * Fails early and clearly when there is nothing built to chat with.
	 *
	 * Deliberately NOT applied to `--connect`: that mode talks to a server
	 * someone else is running, which may be a deployment on another machine
	 * entirely, so demanding a local `.build/` would be wrong.
	 *
	 * @root Absolute path to the project root, trailing slash stripped
	 *
	 * @throws BxAgents.NotBuilt When the project has no generated app
	 */
	private void function requireBuild( required string root ) {
		if ( !fileExists( arguments.root & "/.build/app/agent/GeneratedAgentFactory.bx" ) ) {
			throw(
				type    = "BxAgents.NotBuilt",
				message = "No build found at [#arguments.root#/.build] - run `build` first"
			)
		}
	}

	/**
	 * The default mode: load the generated factory directly and talk to the
	 * agent object in this process.
	 *
	 * @root Absolute path to the project root, trailing slash stripped
	 *
	 * @return This verb's own { exitCode, message } result
	 */
	private struct function chatInProcess( required string root, struct options = {} ) {
		var user = trim( arguments.options.user ?: "" )
		// the turn code reads `application`, which a CLI script does not have: start one (see ApplicationContext)
		new "models.cli.support.ApplicationContext@bxagents"().start( arguments.root )
		var agent = new "models.cli.support.BuiltAgent@bxagents"().load( arguments.root )

		if ( wantsScreen( arguments.options ) ) {
			return chatWithScreen( new "models.cli.chat.InProcessSession@bxagents"( agent, user, openSessions( arguments.root ), openConnections( arguments.root, user, agent ) ).withData( new "models.data.ProjectData@bxagents"().appDataOf( arguments.root ) ).withRoutines( new "models.routines.ProjectRoutines@bxagents"().boundFor( arguments.root, user ) ), arguments.options )
		}

		// the plain loop talks to a sub-agent through the same tree the screen uses
		if ( len( trim( arguments.options.agent ?: "" ) ) ) {
			var tree = new "models.api.AgentTree@bxagents"( agent )
			var chosen = tree.find( trim( arguments.options.agent ) )
			if ( isNull( chosen ) ) {
				var known = tree.names().toList( ", " )
				throw( type = "BxAgents.UnknownAgent", message = "There is no agent called [#trim( arguments.options.agent )#]. Ask for one of: #known#" )
			}
			agent = chosen
		}

		// MiniConsole shells out to `stty` to set up raw terminal mode, so it
		// can only be constructed against a real interactive TTY - this is
		// intentionally the last line before the loop, so every failure mode
		// above (missing project root, no build) stays testable without one.
		var console = createObject( "java", "ortus.boxlang.runtime.cli.MiniConsole" ).init( "you> " )

		println( "Chatting with the agent - type 'exit' or 'quit' to leave." )

		var running = true
		while ( running ) {
			var input = console.readLine()
			if ( isNull( input ) ) {
				running = false
				continue
			}

			var trimmedInput = trim( input )
			if ( trimmedInput == "exit" || trimmedInput == "quit" ) {
				running = false
				continue
			}
			if ( !len( trimmedInput ) ) {
				continue
			}

			try {
				println( "agent> " & agent.run( trimmedInput, {}, { userId : len( user ) ? user : Caller::localId() } ) )
			} catch ( any e ) {
				println( "error> " & e.message )
			}
		}

		return done( "Chat session ended" )
	}

	/**
	 * The project's MCP servers that ask people to sign in, for the chat's /connect.
	 *
	 * @root The project root
	 * @user Who is talking; the local user when blank
	 * @agent The agent that gets the tools of a server once somebody has signed in
	 *
	 * @return A LocalConnections, or null when no server asks people to sign in or the project cannot be read
	 */
	private any function openConnections( required string root, string user = "", any agent ) {
		try {
			var config = new "models.build.AgentConfigResolver@bxagents"().resolve( projectRoot = arguments.root )
			var entries = OAuthServers::of( config )
			if ( !entries.len() ) {
				return nullValue()
			}
			var file = new "models.store.ChatStorePath@bxagents"().forProject( arguments.root )
			directoryCreate( getDirectoryFromPath( file ), true, true )
			return new "models.cli.chat.LocalConnections@bxagents"( entries, new "models.vault.VaultWiring@bxagents"().pin( file ), len( arguments.user ) ? arguments.user : Caller::localId(), isNull( arguments.agent ) ? {} : { agent : arguments.agent } )
		} catch ( any e ) {
			return nullValue()
		}
	}

	/**
	 * The list of conversations in the project's chat database, shared with the web chat.
	 *
	 * @root The project root
	 *
	 * @return A SessionStore, or null when the database cannot be opened (the chat then keeps no list)
	 */
	private any function openSessions( required string root ) {
		try {
			var file = new "models.store.ChatStorePath@bxagents"().prepared( arguments.root )
			var store = new "models.store.ChatStore@bxagents"( { driver : "sqlite", database : file } )
			store.migrate()
			return new "models.store.SessionStore@bxagents"( store )
		} catch ( any e ) {
			return nullValue()
		}
	}

	/**
	 * The `--server` / `--connect` mode: drive the same REPL over real HTTP
	 * against a project's always-on `/__bxagents` route.
	 *
	 * Carries the `threadId` the server hands back into every subsequent turn,
	 * so the session is one conversation. Without that each line would start a
	 * fresh thread and the agent would have no memory of the previous one -
	 * which is exactly what a REPL must not do.
	 *
	 * A per-turn error does NOT end the session (same as the in-process loop):
	 * one failed turn is worth reporting and moving past, not worth throwing
	 * away the conversation for. A server that never becomes ready at all is
	 * different, and surfaces from the first send().
	 *
	 * @baseUrl The server root to talk to
	 * @banner An extra line to print before the prompt (e.g. which server was started); blank prints nothing
	 *
	 * @return This verb's own { exitCode, message } result
	 */
	private struct function chatOverHttp( required string baseUrl, string banner = "", struct options = {} ) {
		var client = arguments.options._client ?: new "models.cli.support.AgentClient@bxagents"()
		var target = arguments.baseUrl.reReplace( "[\/]+$", "" )

		// a server that wants a token: --token=<token>, or BXAGENTS_TOKEN in the environment
		var token = trim( arguments.options.token ?: getSystemSetting( "BXAGENTS_TOKEN", "" ) )
		if ( len( token ) ) {
			client.withToken( token )
		}
		// a server that serves its API somewhere else than the default (agentApi.path): --api-path=/where
		var apiPath = trim( arguments.options[ "api-path" ] ?: arguments.options.apiPath ?: "" )
		if ( len( apiPath ) ) {
			client.withPath( apiPath )
		}

		if ( wantsScreen( arguments.options ) ) {
			if ( len( trim( arguments.banner ) ) ) {
				println( arguments.banner )
			}
			return chatWithScreen( new "models.cli.chat.HttpSession@bxagents"( target, client ), arguments.options )
		}

		if ( len( trim( arguments.banner ) ) ) {
			println( arguments.banner )
		}
		if ( len( trim( arguments.options.agent ?: "" ) ) ) {
			throw( type = "BxAgents.AgentNeedsScreen", message = "--agent needs the full-screen chat over HTTP. Drop --no-tui, or run in a terminal." )
		}

		// Constructed after everything that can fail without a terminal, for
		// the same reason as the in-process loop: MiniConsole needs a real TTY.
		var console = createObject( "java", "ortus.boxlang.runtime.cli.MiniConsole" ).init( "you> " )

		println( "Chatting with the agent at #target# - type 'exit' or 'quit' to leave." )

		var threadId = ""
		var running = true
		while ( running ) {
			var input = console.readLine()
			if ( isNull( input ) ) {
				running = false
				continue
			}

			var trimmedInput = trim( input )
			if ( trimmedInput == "exit" || trimmedInput == "quit" ) {
				running = false
				continue
			}
			if ( !len( trimmedInput ) ) {
				continue
			}

			try {
				var result = streamTurn( client, target, trimmedInput, threadId )
				threadId = result.threadId ?: threadId
			} catch ( any e ) {
				println( "error> " & e.message )
			}
		}

		return done( "Chat session ended" )
	}

	/**
	 * Runs one turn, streaming the reply into the terminal as it arrives.
	 *
	 * Streaming is what makes an HTTP chat feel like a REPL rather than a slow
	 * `invoke`: without it a long answer sits behind a blank prompt and then
	 * lands all at once. The deltas are printed with `print()` so they build up
	 * on one line, and the newline is written once the turn ends.
	 *
	 * Falls back to the non-streaming `/invoke` route if the stream cannot be
	 * opened. That is not defensive padding - a server old enough to lack a
	 * `/stream` sub-route, or a proxy that will not do `text/event-stream`,
	 * should still give someone a working chat rather than an error. An
	 * auth failure is deliberately NOT caught here: retrying a 401 without a
	 * token just fails again more slowly and hides the real cause.
	 *
	 * @client The shared AgentClient
	 * @target The server root to talk to
	 * @message The prompt for this turn
	 * @threadId The conversation so far; blank starts a new one
	 *
	 * @return The client's own { output, threadId, ... } result
	 */
	private struct function streamTurn(
		required any client,
		required string target,
		required string message,
		required string threadId
	) {
		print( "agent> " )

		var streamed = false
		try {
			var result = arguments.client.stream(
				baseUrl  : arguments.target,
				message  : arguments.message,
				threadId : arguments.threadId,
				onDelta  : ( delta ) => {
					streamed = true
					print( delta )
				}
			)
			println( "" )

			// A turn that stopped for a human decision produces no content at
			// all, which would otherwise look like the agent simply said
			// nothing. Say what actually happened, and where to answer it.
			if ( result.suspended ?: false ) {
				println( "       (paused for a human-in-the-loop decision - answer it at #arguments.target#/gateways/interactions/)" )
			}
			return result
		} catch ( any e ) {
			if ( e.type == "BxAgents.AgentApiUnauthorized" ) {
				rethrow
			}
			// Nothing was printed yet, so the fallback's own output still lands
			// under the same "agent> " prompt already on screen. If deltas HAD
			// started arriving, re-running the turn would double the visible
			// answer, so that case surfaces as an error instead.
			if ( streamed ) {
				println( "" )
				rethrow
			}
		}

		var fallback = arguments.client.send(
			baseUrl        : arguments.target,
			message        : arguments.message,
			timeoutSeconds : len( arguments.threadId ) ? 60 : 30,
			threadId       : arguments.threadId
		)
		println( fallback.output )
		return fallback
	}

}
