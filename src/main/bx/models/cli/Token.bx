/**
 * `token` CLI verb - the access tokens of a deployed agent, kept in the project's shared chat database
 * (`data/chat.db`, or the file named by BXAGENTS_DB).
 *
 *   bxAgents token create --name=laptop [--scope=chat|admin] [--expires=90d]
 *   bxAgents token list [--json]
 *   bxAgents token revoke --name=laptop
 *
 * Run it where the agent's database is: on the server, or in the project before it is packed. A token is
 * shown once, when it is made; only a hash of it is stored. The agent accepts issued tokens when its
 * `agentApi` has `tokens: true`.
 */
class {

	/**
	 * @options { projectRoot (required), _positional (create, list or revoke), name, scope, expires, json }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`token` requires a project root" )
		}
		var action = lCase( trim( arguments.options._positional ?: "" ) )
		if ( !len( action ) || ![ "create", "list", "revoke" ].contains( action ) ) {
			throw( type = "BxAgents.UnknownTokenAction", message = "`token` needs one of: create, list, revoke - for example `bxAgents token create --name=laptop`." )
		}

		var file = new "models.store.ChatStorePath@bxagents"().forProject( projectRoot )
		directoryCreate( getDirectoryFromPath( file ), true, true )
		var store = new "models.store.ChatStore@bxagents"( { driver : "sqlite", database : file } )
		store.migrate()
		var tokens = new "models.store.TokenService@bxagents"( store )

		switch ( action ) {
			case "create":
				return create( tokens, arguments.options, file )
			case "list":
				return list( tokens, arguments.options )
			case "revoke":
				return revoke( tokens, arguments.options )
		}
	}

	// ----------------------------------------------------------------------------------

	private struct function create( required any tokens, required struct options, required string file ) {
		var name = trim( arguments.options.name ?: "" )
		if ( !len( name ) ) {
			throw( type = "BxAgents.MissingTokenName", message = "`token create` requires --name=<who it is for>, for example --name=laptop" )
		}
		var scope = lCase( trim( arguments.options.scope ?: "chat" ) )
		var made = arguments.tokens.create( name, scope, arguments.tokens.expiry( arguments.options.expires ?: "" ) )

		var lines = [
			"Token for [#made.name#] (#made.scope#, #isDate( made.expiresAt ) ? 'expires ' & dateFormat( made.expiresAt, 'yyyy-MM-dd' ) & ' ' & timeFormat( made.expiresAt, 'HH:mm' ) : 'never expires'#):",
			"",
			"  " & made.token,
			"",
			"Copy it now: it is not stored and cannot be shown again. A caller sends it in the x-bxagents-token header;",
			"the chat takes it as a flag or from the environment:",
			"  bxAgents chat --connect=<server url> --token=<the token>",
			"  BXAGENTS_TOKEN=<the token> bxAgents chat --connect=<server url>",
			"",
			"The agent accepts issued tokens when its agentApi has `tokens: true`. Database: #arguments.file#"
		]
		return { exitCode : 0, message : lines.toList( char( 10 ) ), token : made.token }
	}

	private struct function list( required any tokens, required struct options ) {
		var rows = arguments.tokens.list()
		if ( arguments.options.json ?: false ) {
			return { exitCode : 0, message : jsonSerialize( rows.map( row => {
				return { name : row.name, scope : row.scope, status : row.status, createdAt : stamp( row.createdAt ), lastUsedAt : stamp( row.lastUsedAt ?: "" ), expiresAt : stamp( row.expiresAt ?: "" ) }
			} ) ) }
		}
		if ( !rows.len() ) {
			return { exitCode : 0, message : "No tokens yet. Make one with `bxAgents token create --name=laptop`." }
		}
		var lines = [ pad( "NAME", 24 ) & pad( "SCOPE", 8 ) & pad( "STATUS", 9 ) & pad( "CREATED", 17 ) & pad( "LAST USED", 17 ) & "EXPIRES" ]
		for ( var row in rows ) {
			lines.append( pad( row.name, 24 ) & pad( row.scope, 8 ) & pad( row.status, 9 ) & pad( stamp( row.createdAt ), 17 ) & pad( len( stamp( row.lastUsedAt ?: "" ) ) ? stamp( row.lastUsedAt ) : "never", 17 ) & ( len( stamp( row.expiresAt ?: "" ) ) ? stamp( row.expiresAt ) : "never" ) )
		}
		return { exitCode : 0, message : lines.toList( char( 10 ) ) }
	}

	private struct function revoke( required any tokens, required struct options ) {
		var name = trim( arguments.options.name ?: "" )
		if ( !len( name ) ) {
			throw( type = "BxAgents.MissingTokenName", message = "`token revoke` requires --name=<the token's name>" )
		}
		if ( arguments.tokens.revoke( name ) ) {
			return { exitCode : 0, message : "Revoked [#name#]. It stops working at once." }
		}
		return { exitCode : 1, message : "There is no active token named [#name#]. See `bxAgents token list`." }
	}

	private string function stamp( any value ) {
		return isDate( arguments.value ?: "" ) ? dateTimeFormat( arguments.value, "yyyy-MM-dd HH:mm" ) : ""
	}

	private string function pad( required string text, required numeric width ) {
		return left( arguments.text & repeatString( " ", arguments.width ), arguments.width )
	}

}
