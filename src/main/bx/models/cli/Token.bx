/**
 * `token` CLI verb - the access tokens of a deployed agent, kept in the project's shared chat database
 * (`data/chat.db`, or the file named by BXAGENTS_DB).
 *
 *   bxAgents token create --name=laptop [--scope=chat|admin] [--expires=90d]
 *   bxAgents token list [--json]
 *   bxAgents token revoke --name=laptop
 *
 * Run it where the agent's database is: on the server, or in the project before it is packed. A token is
 * shown once, when it is made; only a hash of it is stored. The agent accepts issued tokens when its
 * `agentApi` has `tokens: true`.
 */
class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "token",
			group : "SECURITY & ACCESS",
			position : 2,
			description : "Manage API access tokens",
			usage : "<action> [options]",
			actions : [ { name : "create" }, { name : "list" }, { name : "revoke" } ],
			options : [
				{ name : "name", display : "--name=<name>", description : "Token to create or revoke.", takesValue : true },
				{ name : "scope", display : "--scope=<chat|admin>", description : "Access granted by the token.", takesValue : true },
				{ name : "expires", display : "--expires=<duration>", description : "Token lifetime, such as 90d.", takesValue : true },
				{ name : "json", description : "Print results as JSON." }
			],
			examples : [ "token create --name=laptop", "token list", "token revoke --name=laptop" ],
			subcommand : true
		}
	}

	function handleCreate() {
		var name = requiredOption( "name", "BxAgents.MissingTokenName", "`token create` requires --name=<who it is for>, for example --name=laptop" )
		var tokens = tokenService()
		var made = tokens.create( name, lCase( trim( option( "scope", "chat" ) ) ), tokens.expiry( option( "expires" ) ) )
		return lines( [
			"Token for [#made.name#] (#made.scope#, #isDate( made.expiresAt ) ? 'expires ' & dateFormat( made.expiresAt, 'yyyy-MM-dd' ) & ' ' & timeFormat( made.expiresAt, 'HH:mm' ) : 'never expires'#):",
			"",
			"  " & made.token,
			"",
			"Copy it now: it is not stored and cannot be shown again. A caller sends it in the x-bxagents-token header;",
			"the chat takes it as a flag or from the environment:",
			"  bxAgents chat --connect=<server url> --token=<the token>",
			"  BXAGENTS_TOKEN=<the token> bxAgents chat --connect=<server url>",
			"",
			"The agent accepts issued tokens when its agentApi has `tokens: true`. Database: #chatStoreFile()#"
		], { token : made.token } )
	}

	function handleList() {
		var rows = tokenService().list()
		var forJson = rows.map( row => {
			return { name : row.name, scope : row.scope, status : row.status, createdAt : stamp( row.createdAt ), lastUsedAt : stamp( row.lastUsedAt ?: "" ), expiresAt : stamp( row.expiresAt ?: "" ) }
		} )
		return asJson( forJson, () => listText( rows ) )
	}

	function handleRevoke() {
		var name = requiredOption( "name", "BxAgents.MissingTokenName", "`token revoke` requires --name=<the token's name>" )
		if ( tokenService().revoke( name ) ) {
			return done( "Revoked [#name#]. It stops working at once." )
		}
		return fail( "There is no active token named [#name#]. See `bxAgents token list`." )
	}

	/**
	 * @return The token service of this project's chat database
	 */
	private any function tokenService() {
		return new "models.store.TokenService@bxagents"( chatStore() )
	}

	private string function listText( required array rows ) {
		if ( !arguments.rows.len() ) {
			return "No tokens yet. Make one with `bxAgents token create --name=laptop`."
		}
		var report = [ padRight( "NAME", 24 ) & padRight( "SCOPE", 8 ) & padRight( "STATUS", 9 ) & padRight( "CREATED", 17 ) & padRight( "LAST USED", 17 ) & "EXPIRES" ]
		for ( var row in arguments.rows ) {
			report.append( padRight( row.name, 24 ) & padRight( row.scope, 8 ) & padRight( row.status, 9 ) & padRight( stamp( row.createdAt ), 17 ) & padRight( len( stamp( row.lastUsedAt ?: "" ) ) ? stamp( row.lastUsedAt ) : "never", 17 ) & ( len( stamp( row.expiresAt ?: "" ) ) ? stamp( row.expiresAt ) : "never" ) )
		}
		return report.toList( char( 10 ) )
	}

	private string function stamp( any value ) {
		return isDate( arguments.value ?: "" ) ? dateTimeFormat( arguments.value, "yyyy-MM-dd HH:mm" ) : ""
	}

}
