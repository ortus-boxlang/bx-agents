/**
 * `logs` CLI verb: the agent's log files, which there are and the last lines of one.
 *
 *   bxAgents logs                          which logs there are and how big
 *   bxAgents logs gateways                 the last 100 lines of the gateways log
 *   bxAgents logs gateways --tail=500 --level=warn --grep=telegram
 *   bxAgents logs api --json
 *   bxAgents logs gateways --follow        the last lines, then each new line as it is written (Ctrl+C stops)
 *   bxAgents logs --ui                     a full-screen viewer: a tab per log, level, search, live lines
 *   bxAgents logs gateways --follow --connect=https://agent.example.com --token=...   a deployed agent's log
 *
 * --connect reads a served agent over its API (GET /logs, and GET /logs/stream to follow), which takes an admin token.
 */
import bxModules.bxagents.models.util.ByteSize;
import bxModules.bxagents.models.logs.Logger;

class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "logs",
			group : "OPERATE & SHIP",
			position : 1,
			description : "Read, follow, or browse agent logs",
			usage : "[area] [options]",
			actions : [ { name : "agent" }, { name : "gateways" }, { name : "routines" }, { name : "heartbeat" }, { name : "api" } ],
			actionsHeading : "AREAS",
			options : [
				{ name : "tail", display : "--tail=<number>", description : "Lines to show. Default: 100, or 20 with --follow.", takesValue : true },
				{ name : "level", display : "--level=<level>", description : "Minimum severity, such as warn or error.", takesValue : true },
				{ name : "grep", display : "--grep=<text>", description : "Show only matching lines.", takesValue : true },
				{ name : "follow", description : "Keep printing new log lines." },
				{ name : "ui", description : "Open the full-screen log viewer." },
				{ name : "connect", display : "--connect=<url>", description : "Read logs from a served agent.", takesValue : true },
				{ name : "token", display : "--token=<token>", description : "Admin API token for a remote agent.", takesValue : true },
				{ name : "api-path", display : "--api-path=<path>", description : "Custom remote API path.", takesValue : true },
				{ name : "json", description : "Print results as JSON." }
			],
			examples : [ "logs", "logs gateways --follow", "logs --ui" ],
			note : "Without an area, lists the available log files.",
			subcommand : true,
			dispatch : false,
			projectRoot : false
		}
	}


	static {
		DEFAULT_TAIL = 100
		// how many lines the viewer keeps, and how often it looks for new ones (ms)
		VIEW_LINES   = 1000
		POLL_MS      = 1000
	}

	/**
	 * The area is the first word, which may be an array. A project is needed only to read local files, so the base does not check it:
	 * `--connect` reads a served agent. Test seams in the options: _out (prints a line), _polls (stops following after this many
	 * looks), _pollMs, _interactive, _screen, _client.
	 */
	function handle() {
		var area = areaTyped()
		var remote = len( trim( option( "connect" ) ) ) > 0

		if ( isOptionSet( "ui" ) ) {
			return viewer( area, remote ? nullValue() : localReader() )
		}
		if ( isOptionSet( "follow" ) ) {
			if ( !len( area ) ) {
				return fail( "Name the log to follow: bxAgents logs <#Logger::areas().toList( '|' )#> --follow" )
			}
			return follow( area, remote ? nullValue() : localReader() )
		}
		if ( remote ) {
			return remoteRead( area )
		}
		var home = logsHome()
		var reader = localReader()

		if ( !len( area ) ) {
			var found = reader.list()
			return asJson( { logs : found }, () => {
				if ( !found.len() ) {
					return "No logs yet in #home.folder( 'logs' )#. They appear when the agent runs."
				}
				var rows = [ "Logs in #home.folder( 'logs' )#:", "" ]
				for ( var log in found ) {
					rows.append( "  " & padRight( log.area, 11 ) & right( repeatString( " ", 9 ) & ByteSize::format( log.bytes ), 9 ) & "   " & dateTimeFormat( log.modified, "yyyy-MM-dd HH:mm" ) )
				}
				rows.append( "" )
				rows.append( "Read one with: bxAgents logs <area> [--tail=N] [--level=warn] [--grep=TEXT]" )
				return rows.toList( char( 10 ) )
			} )
		}

		var tail = option( "tail", static.DEFAULT_TAIL )
		if ( !isNumeric( tail ) || tail < 1 ) {
			return fail( "--tail must be a whole number of 1 or more." )
		}
		var result
		try {
			result = reader.tail( area, int( tail ), option( "level" ), option( "grep" ) )
		} catch ( "BxAgents.UnknownLog" e ) {
			return fail( e.message )
		}
		return asJson( result, () => {
			if ( !result.lines.len() ) {
				return "No lines in the #area# log" & ( len( option( "level" ) ) || len( option( "grep" ) ) ? " that match." : " yet." )
			}
			return result.lines.map( ( l ) => lineText( l ) ).toList( char( 10 ) )
		} )
	}

	/**
	 * @line { time, level, subject, message }
	 *
	 * @return The line as the terminal shows it
	 */
	string function lineText( required struct line ) {
		var l = arguments.line
		return ( len( l.time ?: "" ) ? l.time & "  " : "                         " ) & ucase( left( ( l.level ?: "info" ) & "     ", 5 ) ) & "  " & ( len( l.subject ?: "" ) ? "[" & l.subject & "] " : "" ) & ( l.message ?: "" )
	}

	/**
	 * The last lines of one log, then each new line as it is written, until Ctrl+C (or `_polls` looks, for tests).
	 * Local: the file is read every second. With --connect: GET /logs/stream, opened again when the server ends it.
	 */
	private struct function follow( required string area, any reader ) {
		var say = outputOf()
		var level = option( "level" )
		var q = option( "grep" )
		var tail = option( "tail", 20 )
		if ( !isNumeric( tail ) || tail < 1 ) {
			return fail( "--tail must be a whole number of 1 or more." )
		}
		var polls = option( "_polls", 0 )
		var looked = 0
		try {
			if ( isNull( arguments.reader ) ) {
				var client = remoteClient()
				for ( var l in client.logs( arguments.area, int( tail ), level, q ).lines ?: [] ) {
					say( lineText( l ) )
				}
				say( "(following #arguments.area# on #option( 'connect' )#; Ctrl+C stops)" )
				while ( !polls || looked < polls ) {
					looked++
					var following = arguments.area
					client.logsStream( following, ( name, data ) => {
						if ( name == "lines" ) {
							for ( var l in data.lines ?: [] ) {
								say( lineText( l ) )
							}
						} else if ( name == "reset" ) {
							say( "(the #following# log was rotated)" )
						}
					}, level, q )
				}
				return done()
			}
			// where the file ends before the tail is read, so no line written in between is missed
			var offset = arguments.reader.since( arguments.area, -1, level, q ).offset
			for ( var l in arguments.reader.tail( arguments.area, int( tail ), level, q ).lines ) {
				say( lineText( l ) )
			}
			say( "(following #arguments.area#; Ctrl+C stops)" )
			while ( !polls || looked < polls ) {
				looked++
				sleep( option( "_pollMs", static.POLL_MS ) )
				var found = arguments.reader.since( arguments.area, offset, level, q )
				offset = found.offset
				if ( found.reset ) {
					say( "(the #arguments.area# log was rotated)" )
				}
				for ( var l in found.lines ) {
					say( lineText( l ) )
				}
			}
			return done()
		} catch ( "BxAgents.UnknownLog" e ) {
			return fail( e.message )
		} catch ( any e ) {
			return fail( remoteProblem( e ) )
		}
	}

	/**
	 * `--ui`: the full-screen viewer (LogScreen). Without a real terminal it follows instead.
	 */
	private struct function viewer( required string area, any reader ) {
		var interactive = variables.options._interactive ?: createObject( "java", "ortus.boxlang.bxagents.tui.TuiScreen" ).isInteractive()
		if ( !interactive ) {
			outputOf()( "(--ui needs a terminal; following the log instead)" )
			return follow( len( arguments.area ) ? arguments.area : "agent", isNull( arguments.reader ) ? nullValue() : arguments.reader )
		}
		var screen = variables.options._screen ?: createObject( "java", "ortus.boxlang.bxagents.tui.LogScreen" ).open( Logger::areas(), len( arguments.area ) ? arguments.area : "agent" )
		// what the loop shares with load(): a closure that assigns a variable of this function makes its own
		var state = {
			remote : isNull( arguments.reader ),
			client : isNull( arguments.reader ) ? remoteClient() : "",
			reader : arguments.reader ?: "",
			offset : -1,
			cap    : static.VIEW_LINES,
			from   : option( "connect" )
		}
		var load = function() {
			try {
				if ( state.remote ) {
					screen.setLines( state.client.logs( screen.area(), state.cap, screen.level(), screen.query() ).lines ?: [] )
					screen.status( "every 2 s from " & state.from )
				} else {
					screen.setLines( state.reader.tail( screen.area(), state.cap, screen.level(), screen.query() ).lines )
					state.offset = state.reader.since( screen.area(), -1, screen.level(), screen.query() ).offset
					screen.status( "live" )
				}
			} catch ( any e ) {
				screen.setLines( [] )
				screen.status( remoteProblem( e ) )
			}
		}
		try {
			load()
			var last = getTickCount()
			while ( true ) {
				var act = screen.step( 200 )
				if ( act == "quit" ) {
					break
				}
				if ( act == "changed" ) {
					load()
					last = getTickCount()
					continue
				}
				if ( getTickCount() - last < ( state.remote ? 2000 : static.POLL_MS ) ) {
					continue
				}
				last = getTickCount()
				if ( state.remote ) {
					load()
					continue
				}
				var found = state.reader.since( screen.area(), state.offset, screen.level(), screen.query() )
				state.offset = found.offset
				if ( found.reset ) {
					load()
				} else if ( found.lines.len() ) {
					screen.append( found.lines, static.VIEW_LINES )
				}
			}
		} finally {
			screen.close()
		}
		return done()
	}

	/**
	 * Which logs there are, or the last lines of one, from a served agent (--connect).
	 */
	private struct function remoteRead( required string area ) {
		try {
			var client = remoteClient()
			var tail = option( "tail", static.DEFAULT_TAIL )
			var server = option( "connect" )
			if ( !len( arguments.area ) ) {
				var found = client.logs()
				return asJson( { logs : found.logs ?: [] }, () => {
					var rows = [ "Logs on #server#:", "" ]
					for ( var log in found.logs ?: [] ) {
						rows.append( "  " & padRight( log.area, 11 ) & right( repeatString( " ", 9 ) & ByteSize::format( log.bytes ), 9 ) )
					}
					return rows.toList( char( 10 ) )
				} )
			}
			var area = arguments.area
			var result = client.logs( area, isNumeric( tail ) ? int( tail ) : static.DEFAULT_TAIL, option( "level" ), option( "grep" ) )
			return asJson( result, () => {
				var lines = result.lines ?: []
				return lines.len() ? lines.map( ( l ) => lineText( l ) ).toList( char( 10 ) ) : "No lines in the #area# log."
			} )
		} catch ( any e ) {
			return fail( remoteProblem( e ) )
		}
	}

	/** @return An AgentApiClient for --connect, with --token (or BXAGENTS_TOKEN) and --api-path */
	private any function remoteClient() {
		if ( !isNull( variables.options._client ) ) {
			return variables.options._client
		}
		return new models.api.AgentApiClient@bxagents(
			url    = trim( option( "connect" ) ),
			token  = trim( option( "token", getSystemSetting( "BXAGENTS_TOKEN", "" ) ) ),
			path   = trim( option( "api-path", option( "apiPath" ) ) ),
			source = "cli"
		)
	}

	/** @return What went wrong, in words: a 403 means the token is not an admin's */
	private string function remoteProblem( required any error ) {
		var message = arguments.error.message ?: "The log could not be read."
		return message.find( "HTTP 403" ) ? "Only an admin may read the logs: use an admin token (--token or BXAGENTS_TOKEN)." : message
	}

	/** @return The log the user named: the first word, which is an array when the parser collected several */
	private string function areaTyped() {
		var typed = option( "_positional" )
		return lCase( trim( isArray( typed ) ? ( typed[ 1 ] ?: "" ) : typed ) )
	}

	/** @return The data home of the project, which is where the logs are */
	private any function logsHome() {
		var root = projectRoot()
		if ( !len( root ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`logs` requires a project root" )
		}
		return new models.data.ProjectData@bxagents().of( root ).home
	}

	/** @return The LogReader of the project's data home */
	private any function localReader() {
		return new models.logs.LogReader@bxagents( logsHome().folder( "logs" ) )
	}

	/** @return A function that prints one line: println, or the test's own */
	private any function outputOf() {
		if ( !isNull( variables.options._out ) ) {
			return variables.options._out
		}
		var system = createObject( "java", "java.lang.System" )
		// flushed line by line: through a pipe (--follow | grep) the output is otherwise held back until the program ends,
		// which a follow never does (measured: nothing reached the pipe in 40 seconds)
		return ( text ) => {
			println( text )
			system.out.flush()
		}
	}

}
