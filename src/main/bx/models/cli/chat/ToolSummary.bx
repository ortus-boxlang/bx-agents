/**
 * One line for the arguments of a tool call, for the chat screen's tool line.
 */
class {

	/**
	 * @args The arguments a tool was called with
	 *
	 * @return A short readable form, key=value pairs. Names starting with an underscore are bx-ai's
	 *         own plumbing (it passes the whole chat request along as `_chatRequest`), not something
	 *         the model asked for, so they are left out.
	 */
	string function of( required any args ) {
		if ( !isStruct( arguments.args ) || arguments.args.isEmpty() ) {
			return ""
		}
		var parts = []
		for ( var key in arguments.args ) {
			if ( left( key, 1 ) == "_" ) {
				continue
			}
			var value = arguments.args[ key ]
			parts.append( key & "=" & ( isSimpleValue( value ) ? value : jsonSerialize( value ) ) )
		}
		return parts.toList( " " )
	}

}
