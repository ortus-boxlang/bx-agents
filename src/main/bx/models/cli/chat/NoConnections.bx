/**
 * Stands in for the connections of a chat whose agent has no MCP server that asks people to sign in, or whose server
 * does not offer the connect routes.
 */
class {

	/** @return False: there is nothing to connect to */
	boolean function available() {
		return false
	}

	/** @return Why there is nothing to connect to */
	string function why() {
		return "No MCP server of this agent asks people to sign in. Add `oauth: true` to an mcpServers entry in Agent.yaml."
	}

}
