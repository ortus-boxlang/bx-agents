/**
 * A chat session against the agent object in this process: the same agent a `serve`d
 * app builds, driven with bx-ai's own streaming. It turns what the agent does into the
 * small events the chat screen understands:
 *
 *   { type : "delta", text }                the answer so far, a piece at a time
 *   { type : "reasoning", text }            the model's thinking, a piece at a time
 *   { type : "tool", id, name, summary, status : "running" | "ok", ms }
 *   { type : "notice", text }  { type : "error", text }
 *
 * Tool events are not part of the stream: bx-ai announces beforeAIToolExecute and
 * afterAIToolExecute for every tool call, and a global interceptor turns those into events.
 *
 * Esc cancels with bx-ai's own cancelRun(), which takes effect at the next checkpoint (before
 * the next model call or tool call), not in the middle of a token. A message typed while the
 * agent works is spliced into the run with steerRun().
 */
class {

	/**
	 * @agent The agent object from the project's GeneratedAgentFactory
	 * @userId Who is talking: the owner of the user notes and of the conversations. Defaults to the operating system user.
	 * @sessions A SessionStore: the list of conversations in the shared chat database. Without one the chat keeps no list.
	 */
	function init( required any agent, string userId = "", any sessions ) {
		variables.agent = arguments.agent
		variables.sessions = isNull( arguments.sessions ) ? nullValue() : arguments.sessions
		variables.conversationId = createUUID()
		variables.userId = len( trim( arguments.userId ) ) ? trim( arguments.userId ) : createObject( "java", "java.lang.System" ).getProperty( "user.name" ) ?: "default"
		variables.threadId = createUUID()
		variables.hooks = nullValue()
		variables.calls = {}
		variables.counter = 0
		variables.interceptor = BoxRegisterInterceptor(
			( data ) => onToolEvent( data ),
			[ "beforeAIToolExecute", "afterAIToolExecute" ]
		)
		return this
	}

	string function agentName() {
		return variables.agent.getConfig().name
	}

	string function modelName() {
		var model = variables.agent.getConfig().model ?: {}
		return isStruct( model ) ? ( model.model ?: model.provider ?: "" ) : toString( model )
	}

	string function mode() {
		return "in-process"
	}

	/**
	 * @return The names of the tools the agent has
	 */
	array function tools() {
		return variables.agent.listTools().map( tool => isSimpleValue( tool ) ? tool : ( tool.name ?: toString( tool ) ) )
	}

	/**
	 * @return The notes of this agent for the chat commands: LocalNotes, or NoNotes when the agent keeps none
	 */
	any function notes() {
		var provider = new "models.notes.NotesWiring@bxagents"().providerOf( variables.agent )
		if ( isNull( provider ) ) {
			return new "models.cli.chat.NoNotes@bxagents"()
		}
		return new "models.cli.chat.LocalNotes@bxagents"( provider, variables.userId, agentName() )
	}

	/**
	 * Starts a new conversation: the agent keeps its memory per thread.
	 */
	void function newThread() {
		variables.threadId = createUUID()
		variables.conversationId = createUUID()
	}

	/**
	 * @return The id of the conversation: the key of its messages in the agent's memory and of its row in the list
	 */
	string function conversationId() {
		return variables.conversationId
	}

	/**
	 * @return True when the chat keeps a list of conversations (a shared chat database is open)
	 */
	boolean function keepsSessions() {
		return !isNull( variables.sessions )
	}

	/**
	 * @return The user's recent conversations, most recent first: [ { id, title, messageCount, updatedAt } ]
	 */
	array function sessions( numeric limit = 20 ) {
		return keepsSessions() ? variables.sessions.list( variables.userId, arguments.limit ) : []
	}

	/**
	 * Switches to another of the user's conversations.
	 *
	 * @reference Its number in the list, its id or the start of its id; blank for the most recent
	 *
	 * @return { ok, id, title, history } or { ok : false, reason }
	 */
	struct function resumeSession( string reference = "" ) {
		if ( !keepsSessions() ) {
			return { ok : false, reason : "This chat keeps no list of conversations." }
		}
		var found = len( trim( arguments.reference ) ) ? variables.sessions.resolve( variables.userId, arguments.reference ) : variables.sessions.latest( variables.userId )
		if ( found.isEmpty() ) {
			return { ok : false, reason : len( trim( arguments.reference ) ) ? "There is no conversation [#arguments.reference#]. Type /sessions to see them." : "There are no earlier conversations." }
		}
		variables.conversationId = found.id
		variables.threadId = createUUID()
		return { ok : true, id : found.id, title : found.title ?: "", history : history() }
	}

	/**
	 * @return What was said in this conversation, from the agent's memory: [ { role : "you" | "agent", text } ]
	 */
	array function history() {
		return new "models.cli.chat.MemoryHistory@bxagents"().of( variables.agent.getMemoryMessages( variables.userId, variables.conversationId ) )
	}

	/**
	 * Forgets this conversation's messages (the agent's memory of it) and keeps the conversation.
	 */
	struct function clear() {
		variables.agent.getMemories().each( ( memory ) => memory.clear( variables.userId, variables.conversationId ) )
		if ( keepsSessions() ) {
			variables.sessions.resetCount( variables.userId, variables.conversationId )
		}
		return { ok : true }
	}

	/**
	 * Replaces the older messages with a summary and keeps the most recent few.
	 *
	 * @return { available, compacted, before, after }; available is false when the agent's memory has no summary model
	 */
	struct function compact() {
		var summarizes = variables.agent.getMemories().some( ( memory ) => len( memory.getSummaryProvider() ?: "" ) && len( memory.getSummaryModel() ?: "" ) )
		var before = variables.agent.getMemoryMessages( variables.userId, variables.conversationId ).len()
		if ( !summarizes ) {
			return { available : false, compacted : false, before : before, after : before }
		}
		variables.agent.getMemories().each( ( memory ) => memory.summarize( {}, variables.userId, variables.conversationId ) )
		var after = variables.agent.getMemoryMessages( variables.userId, variables.conversationId ).len()
		return { available : true, compacted : after < before, before : before, after : after }
	}

	/**
	 * @return [ [ label, value ] ] about this chat, in the order to show them
	 */
	array function info() {
		var lines = [
			[ "Agent", agentName() ],
			[ "Model", modelName() ],
			[ "Mode", mode() ],
			[ "Tools", tools().len() ],
			[ "User", variables.userId ],
			[ "Conversation", variables.conversationId ],
			[ "Messages", variables.agent.getMemoryMessages( variables.userId, variables.conversationId ).len() ]
		]
		var kept = notes()
		if ( kept.available() ) {
			var stats = kept.stats()
			lines.append( [ "Notes", "#stats.user.count# about you (#stats.user.used#/#stats.user.limit# characters), #stats.agent.count# about the agent (#stats.agent.used#/#stats.agent.limit#)" ] )
		}
		var file = trim( getSystemSetting( "BXAGENTS_DB", "" ) )
		if ( len( file ) ) {
			lines.append( [ "Database", file ] )
		}
		return lines
	}

	/**
	 * @text What the user said
	 * @hooks { push( event ), cancelRequested(), takeSteer() }
	 *
	 * @return { status : "done" | "suspended" | "cancelled" | "stopped", text, pending : [ { toolName, toolArgs } ] }
	 */
	struct function send( required string text, required struct hooks ) {
		var state = newState()
		variables.hooks = arguments.hooks
		try {
			variables.agent.stream( chunkHandler( state ), arguments.text, {}, { threadId : variables.threadId, userId : variables.userId, conversationId : variables.conversationId } )
		} finally {
			variables.hooks = nullValue()
		}
		recordTurn( arguments.text )
		return finish( state )
	}

	/**
	 * Continues a run that stopped for a human decision.
	 *
	 * @decision approve, reject, approve_session or approve_always
	 * @hooks See send()
	 */
	struct function resume( required string decision, required struct hooks ) {
		var state = newState()
		variables.hooks = arguments.hooks
		try {
			variables.agent.resumeStream( chunkHandler( state ), arguments.decision, variables.threadId )
		} finally {
			variables.hooks = nullValue()
		}
		return finish( state )
	}

	void function close() {
		BoxUnregisterInterceptor( variables.interceptor )
	}

	// ----------------------------------------------------------------------------------

	/**
	 * Notes the turn in the list of conversations. A list that cannot be written must not stop the chat.
	 */
	private void function recordTurn( required string text ) {
		if ( !keepsSessions() ) {
			return
		}
		try {
			variables.sessions.touch( variables.userId, variables.conversationId, arguments.text )
		} catch ( any e ) {
			// the chat goes on without a list
		}
	}

	private struct function newState() {
		return { text : "", cancelled : false, suspended : false, stopped : "", pending : [] }
	}

	private struct function finish( required struct state ) {
		var status = arguments.state.suspended ? "suspended" : ( arguments.state.cancelled ? "cancelled" : ( len( arguments.state.stopped ) ? "stopped" : "done" ) )
		return { status : status, text : arguments.state.text, pending : arguments.state.pending, reason : arguments.state.stopped }
	}

	/**
	 * Builds the function bx-ai calls for every streamed chunk.
	 */
	private function chunkHandler( required struct state ) {
		var run = arguments.state
		var threadId = variables.threadId
		var agent = variables.agent
		var screen = variables.hooks
		return ( chunk ) => {
			if ( screen.cancelRequested() && !run.cancelled ) {
				run.cancelled = true
				agent.cancelRun( threadId, "Stopped by the user." )
			}
			var steer = screen.takeSteer()
			if ( !isNull( steer ) ) {
				agent.steerRun( threadId, steer )
			}

			// a run that ends on a middleware decision (a human approval, a guard) arrives as a sentinel
			if ( isStruct( chunk ) && ( chunk.type ?: "" ) == "middleware_stop" ) {
				var result = chunk.result
				if ( result.isSuspended() ) {
					run.suspended = true
					run.pending = result.getData().pendingActions ?: []
				} else {
					run.stopped = result.getReason() ?: "The run was stopped."
				}
				return
			}

			if ( isStruct( chunk ) && isArray( chunk.choices ?: "" ) && chunk.choices.len() ) {
				var delta = chunk.choices[ 1 ].delta ?: {}
				if ( len( delta.reasoning ?: "" ) ) {
					screen.push( { type : "reasoning", text : delta.reasoning } )
				}
				if ( len( delta.content ?: "" ) ) {
					run.text &= delta.content
					screen.push( { type : "delta", text : delta.content } )
				}
			}
		}
	}

	/**
	 * Turns a bx-ai tool announcement into a chat event. Announced for every agent in the
	 * process, so it only reports while a turn of this session is running.
	 */
	private void function onToolEvent( required struct data ) {
		if ( isNull( variables.hooks ) ) {
			return
		}
		var name = arguments.data.name
		if ( arguments.data.keyExists( "results" ) ) {
			var open = variables.calls[ name ] ?: []
			var id = open.len() ? open.last() : name
			if ( open.len() ) {
				open.deleteAt( open.len() )
			}
			variables.hooks.push( { type : "tool", id : id, name : name, summary : new "models.cli.chat.ToolSummary@bxagents"().of( arguments.data.arguments ?: {} ), status : "ok", ms : arguments.data.executionTime ?: 0 } )
			return
		}
		variables.counter++
		var id = name & "##" & variables.counter
		variables.calls[ name ] = variables.calls[ name ] ?: []
		variables.calls[ name ].append( id )
		variables.hooks.push( { type : "tool", id : id, name : name, summary : new "models.cli.chat.ToolSummary@bxagents"().of( arguments.data.arguments ?: {} ), status : "running", ms : 0 } )
	}

}
