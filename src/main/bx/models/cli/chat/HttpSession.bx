/**
 * A chat session against a running server's always-on agent route: `chat --server` and
 * `chat --connect`. It sends the same events as InProcessSession, from the server's run-control
 * stream (`/__bxagents/events`):
 *
 *   { type : "delta", text }                the answer so far, a piece at a time
 *   { type : "reasoning", text }            the model's thinking, a piece at a time
 *   { type : "tool", id, name, summary, status : "running" | "ok", ms }
 *   { type : "notice", text }  { type : "error", text }
 *
 * Esc stops the run on the server (`/cancel`) and leaves the turn at once. A message typed while
 * the agent works is spliced into the run (`/steer`). A run that stops for a human decision
 * returns "suspended" with what it waits on, and `resume()` answers it (`/resume`), so approvals are
 * answered in this window like they are in-process.
 *
 * A server built by an older bxAgents has no run control. The session then falls back to the plain
 * text stream (`/stream`): the answer, nothing else, and a notice says so.
 */
class {

	/**
	 * @baseUrl The server root
	 * @client The AgentClient
	 */
	function init( required string baseUrl, any client ) {
		variables.baseUrl = arguments.baseUrl.reReplace( "[\/]+$", "" )
		variables.client = isNull( arguments.client ) ? new "models.cli.support.AgentClient@bxagents"() : arguments.client
		variables.threadId = ""
		variables.conversationId = createUUID()
		variables.about = nullValue()
		variables.profileName = ""
		variables.offeredProfiles = nullValue()
		variables.legacy = false
		variables.summary = new "models.cli.chat.ToolSummary@bxagents"()
		return this
	}

	/**
	 * @return The notes of the agent on the server: RemoteNotes, or NoNotes when it keeps none
	 */
	any function notes() {
		var remote = new "models.cli.chat.RemoteNotes@bxagents"( variables.baseUrl, variables.client )
		return remote.available() ? remote : new "models.cli.chat.NoNotes@bxagents"()
	}

	/**
	 * @return What the screen calls the user: the server knows who they are by their token
	 */
	string function userId() {
		return "you"
	}

	string function agentName() {
		return describe().name ?: "agent"
	}

	string function modelName() {
		var label = describe().model ?: ""
		return len( label ) ? label : variables.baseUrl
	}

	string function mode() {
		return "over http"
	}

	/**
	 * @return { model, profile, provider } as far as the server says
	 */
	struct function modelInfo() {
		var chosen = variables.profileName
		if ( !len( chosen ) ) {
			return { model : modelName(), profile : "", provider : "" }
		}
		var found = offered().filter( p => p.name == chosen )
		return { model : found.len() ? found[ 1 ].provider & ( len( found[ 1 ].model ?: "" ) ? "/" & found[ 1 ].model : "" ) : chosen, profile : chosen, provider : found.len() ? found[ 1 ].provider : "" }
	}

	/**
	 * @return { contextWindow, vision } of the model in use, as far as the server says: its own, or the profile chosen
	 */
	struct function modelFacts() {
		var chosen = variables.profileName
		var source = describe()
		if ( len( chosen ) ) {
			var found = offered().filter( p => p.name == chosen )
			source = found.len() ? found[ 1 ] : {}
		}
		return { contextWindow : val( source.contextWindow ?: 0 ), vision : source.vision ?: "" }
	}

	/**
	 * @return What is in the context right now, as the server worked it out (see ContextReport); an empty report when it cannot say
	 */
	struct function contextReport() {
		try {
			return variables.client.getJson( variables.baseUrl, "context", { conversationId : variables.conversationId } )
		} catch ( any e ) {
			return { parts : [], tools : [], mcpServers : 0, total : 0, contextWindow : 0, percent : 0 }
		}
	}

	/**
	 * Asks the server to test a model with one tiny question.
	 *
	 * @profile A profile the server offers; blank for the one in use
	 *
	 * @return { ok, model, ms, reply } or { ok : false, model, reason }
	 */
	struct function ping( string profile = "" ) {
		var target = len( trim( arguments.profile ) ) ? trim( arguments.profile ) : variables.profileName
		try {
			return variables.client.postJson( variables.baseUrl, "ping", { profile : target } )
		} catch ( any e ) {
			return { ok : false, model : len( target ) ? target : modelName(), reason : "The server could not be asked: " & e.message }
		}
	}

	/**
	 * A client may only use the profiles the server lists (agentApi.profiles), so there is nothing to
	 * switch to unless it lists some.
	 *
	 * @return { ok, reason }
	 */
	struct function switchable() {
		if ( offered().len() ) {
			return { ok : true, reason : "" }
		}
		return { ok : false, reason : "This server does not offer a choice of models. The app lists the profiles a client may use in agentApi.profiles (Agent.yaml)." }
	}

	/**
	 * @return [ { name, description, provider, model, hasApiKey, isDefault, isCurrent } ] the profiles the server offers
	 */
	array function profiles() {
		var chosen = variables.profileName
		return offered().map( p => {
			name        : p.name,
			description : p.description ?: "",
			provider    : p.provider ?: "",
			model       : p.model ?: "",
			hasApiKey   : true,
			isDefault   : p.isDefault ?: false,
			isCurrent   : p.name == chosen
		} )
	}

	/**
	 * Uses a profile the server offers for the messages that follow.
	 *
	 * @name A profile name
	 *
	 * @return { ok, profile, provider, model, hasApiKey } or { ok : false, reason }
	 */
	struct function useProfile( required string name ) {
		var can = switchable()
		if ( !can.ok ) {
			return { ok : false, reason : can.reason }
		}
		var found = offered().filter( p => p.name == name )
		if ( !found.len() ) {
			return { ok : false, reason : "The server does not offer a profile [#arguments.name#]. It offers: #offered().map( p => p.name ).toList( ', ' )#" }
		}
		variables.profileName = found[ 1 ].name
		return { ok : true, profile : found[ 1 ].name, provider : found[ 1 ].provider, model : found[ 1 ].provider & ( len( found[ 1 ].model ?: "" ) ? "/" & found[ 1 ].model : "" ), hasApiKey : true }
	}

	/**
	 * Goes back to the server's own model for the messages that follow.
	 */
	struct function useDefault() {
		var can = switchable()
		if ( !can.ok ) {
			return { ok : false, reason : can.reason }
		}
		variables.profileName = ""
		return { ok : true, profile : "default", provider : "", model : modelName(), hasApiKey : true }
	}

	/**
	 * @return The names of the tools the agent has, or an empty list when the server cannot say
	 */
	array function tools() {
		try {
			var answer = variables.client.getJson( variables.baseUrl, "tools" )
			return ( answer.tools ?: [] ).map( tool => isSimpleValue( tool ) ? tool : ( tool.name ?: toString( tool ) ) )
		} catch ( any e ) {
			return []
		}
	}

	void function newThread() {
		variables.threadId = ""
		variables.conversationId = createUUID()
	}

	string function conversationId() {
		return variables.conversationId
	}

	/**
	 * @return True when the server keeps a list of conversations
	 */
	boolean function keepsSessions() {
		sessions( 1 )
		return !( variables.sessionsMissing ?: false )
	}

	/**
	 * @return The caller's recent conversations on the server, most recent first; empty when it keeps none
	 */
	array function sessions( numeric limit = 20 ) {
		try {
			var answer = variables.client.getJson( variables.baseUrl, "sessions", { limit : arguments.limit } )
			variables.sessionsMissing = false
			return answer.sessions ?: []
		} catch ( any e ) {
			variables.sessionsMissing = true
			return []
		}
	}

	/**
	 * Switches to another of the caller's conversations on the server.
	 *
	 * @reference Its number in the list, its id or the start of its id; blank for the most recent
	 *
	 * @return { ok, id, title, history } or { ok : false, reason }
	 */
	struct function resumeSession( string reference = "" ) {
		var recent = sessions( 50 )
		if ( variables.sessionsMissing ?: false ) {
			return { ok : false, reason : "This server keeps no list of conversations." }
		}
		var ref = trim( arguments.reference )
		var found = {}
		if ( !len( ref ) ) {
			found = recent.len() ? recent[ 1 ] : {}
		} else if ( isNumeric( ref ) && ref >= 1 && ref <= recent.len() && len( ref ) < 4 ) {
			found = recent[ int( ref ) ]
		} else {
			var matches = recent.filter( row => row.id == ref || row.id.startsWith( ref ) )
			found = matches.len() == 1 ? matches[ 1 ] : {}
		}
		if ( found.isEmpty() ) {
			return { ok : false, reason : len( ref ) ? "There is no conversation [#ref#]. Type /sessions to see them." : "There are no earlier conversations." }
		}
		variables.conversationId = found.id
		variables.threadId = ""
		return { ok : true, id : found.id, title : found.title ?: "", history : history() }
	}

	/**
	 * @return The title in the server's list, "" when it has none yet
	 */
	string function conversationTitle() {
		return sessions( 50 ).filter( row => row.id == variables.conversationId ).map( row => row.title ?: "" ).first() ?: ""
	}

	/**
	 * @return { ok, title } or { ok : false, reason }
	 */
	struct function rename( required string title ) {
		try {
			return variables.client.postJson( variables.baseUrl, "sessions/rename", { conversationId : variables.conversationId, title : arguments.title } )
		} catch ( any e ) {
			return { ok : false, reason : "This server keeps no list of conversations, so there is nothing to name." }
		}
	}

	/**
	 * Copies the conversation on the server under a new name and moves to the copy.
	 *
	 * @return { ok, id, title, messages } or { ok : false, reason }
	 */
	struct function fork( string title = "" ) {
		try {
			var outcome = variables.client.postJson( variables.baseUrl, "sessions/fork", { conversationId : variables.conversationId, title : arguments.title } )
		} catch ( any e ) {
			return { ok : false, reason : "This server keeps no list of conversations, so there is nowhere to put a copy." }
		}
		if ( outcome.ok ?: false ) {
			variables.conversationId = outcome.id
			variables.threadId = ""
		}
		return outcome
	}

	/**
	 * @return What was said in this conversation: [ { role : "you" | "agent", text } ]; empty when the server cannot say
	 */
	array function history() {
		try {
			return variables.client.getJson( variables.baseUrl, "history", { conversationId : variables.conversationId } ).messages ?: []
		} catch ( any e ) {
			return []
		}
	}

	struct function clear() {
		try {
			return variables.client.postJson( variables.baseUrl, "clear", { conversationId : variables.conversationId } )
		} catch ( any e ) {
			// a conversation the server has not seen yet has nothing to clear
			return { ok : true }
		}
	}

	struct function compact() {
		try {
			return variables.client.postJson( variables.baseUrl, "compact", { conversationId : variables.conversationId } )
		} catch ( any e ) {
			return { available : false, compacted : false, before : 0, after : 0 }
		}
	}

	/**
	 * @return [ [ label, value ] ] about this chat, in the order to show them
	 */
	array function info() {
		var lines = [
			[ "Agent", agentName() ],
			[ "Model", modelName() ],
			[ "Mode", mode() ],
			[ "Server", variables.baseUrl ],
			[ "Tools", tools().len() ],
			[ "Conversation", variables.conversationId ]
		]
		var at = 2
		for ( var row in new "models.chat.ModelFactsLines@bxagents"().of( modelFacts() ) ) {
			at++
			lines.insertAt( at, row )
		}
		var kept = notes()
		if ( kept.available() ) {
			var stats = kept.stats()
			lines.append( [ "Notes", "#stats.user.count# about you (#stats.user.used#/#stats.user.limit# characters), #stats.agent.count# about the agent (#stats.agent.used#/#stats.agent.limit#)" ] )
		}
		return lines
	}

	/**
	 * @text What the user said
	 * @hooks { push( event ), cancelRequested(), takeSteer() }
	 * @images [ { path } ] image files that go with the message; sent to the server as base64
	 *
	 * @return { status : "done" | "suspended" | "cancelled" | "stopped", text, pending : [ { toolName, toolArgs } ], reason }
	 */
	struct function send( required string text, required struct hooks, array images = [] ) {
		if ( variables.legacy ) {
			return sendLegacy( arguments.text, arguments.hooks )
		}
		// the same limits and the same check of the model as on the server, so a refusal comes before a large upload
		var builder = new "models.chat.MessageBuilder@bxagents"()
		if ( arguments.images.len() ) {
			var checked = builder.build( arguments.text, arguments.images, modelFacts() )
			if ( !checked.ok ) {
				return { status : "stopped", text : "", pending : [], reason : checked.reason }
			}
		}
		try {
			var payload = { "input" : arguments.text, "threadId" : variables.threadId, "conversationId" : variables.conversationId }
			if ( arguments.images.len() ) {
				payload[ "attachments" ] = arguments.images.map( image => {
					"name"   : listLast( image.path.replace( "\", "/", "all" ), "/" ),
					"mime"   : builder.typeOf( image.path ),
					"data"   : toBase64( fileReadBinary( image.path ) )
				} )
			}
			if ( len( variables.profileName ) ) {
				payload[ "options" ] = { "profile" : variables.profileName }
			}
			return runTurn( "events", payload, arguments.hooks )
		} catch ( "BxAgents.AgentRouteMissing" e ) {
			variables.legacy = true
			arguments.hooks.push( { type : "notice", text : "This server has no run control (it was built by an older bxAgents): showing the answer only." } )
			return sendLegacy( arguments.text, arguments.hooks )
		}
	}

	/**
	 * Answers a run that stopped for a human decision and carries it on.
	 *
	 * @decision approve, approve_session or reject
	 * @hooks See send()
	 */
	struct function resume( required string decision, required struct hooks ) {
		return runTurn( "resume", { "threadId" : variables.threadId, "decision" : arguments.decision }, arguments.hooks )
	}

	void function close() {
	}

	// ----------------------------------------------------------------------------------

	/**
	 * What the server lists at GET profiles, read once. A server that lists none, or an older one with no such
	 * route, offers no choice.
	 */
	private array function offered() {
		if ( isNull( variables.offeredProfiles ) ) {
			try {
				variables.offeredProfiles = variables.client.getJson( variables.baseUrl, "profiles" ).profiles ?: []
			} catch ( any e ) {
				variables.offeredProfiles = []
			}
		}
		return variables.offeredProfiles
	}

	/**
	 * Reads one stretch of a run: the events become chat events, Esc cancels, typed text steers.
	 */
	private struct function runTurn( required string route, required struct payload, required struct hooks ) {
		var screen = arguments.hooks
		var session = this
		var client = variables.client
		var target = variables.baseUrl
		var summary = variables.summary
		var run = { cancelled : false, text : "", pending : [], suspended : false, error : "", threadId : variables.threadId }

		try {
			var result = client.events(
				baseUrl : target,
				route   : arguments.route,
				payload : arguments.payload,
				onEvent : ( event ) => {
					switch ( event.type ) {
						case "thread":
							run.threadId = event.threadId
							break
						case "delta":
							run.text &= event.text
							screen.push( { type : "delta", text : event.text } )
							break
						case "reasoning":
							screen.push( { type : "reasoning", text : event.text } )
							break
						case "tool":
							screen.push( { type : "tool", id : event.id, name : event.name, summary : summary.of( event.arguments ), status : event.status, ms : event.ms } )
							break
						case "suspended":
							run.suspended = true
							run.pending = event.pendingActions
							break
						case "error":
							screen.push( { type : "error", text : event.message } )
							run.error = event.message
							break
					}

					if ( screen.cancelRequested() && !run.cancelled ) {
						run.cancelled = true
						try {
							client.postJson( target, "cancel", { "threadId" : run.threadId, "reason" : "Stopped by the user." } )
						} catch ( any ignored ) {
							// the turn is left either way
						}
						throw( type = "BxAgents.ChatStopped", message = "Stopped by the user." )
					}
					var steer = screen.takeSteer()
					if ( !isNull( steer ) && len( run.threadId ) ) {
						try {
							client.postJson( target, "steer", { "threadId" : run.threadId, "input" : steer } )
						} catch ( any ignored ) {
							screen.push( { type : "notice", text : "The server did not take that message." } )
						}
					}
				}
			)
		} catch ( "BxAgents.ChatStopped" e ) {
			// the user walked away from the turn; the server was told to stop it
		}

		variables.threadId = len( run.threadId ) ? run.threadId : variables.threadId
		var status = run.suspended ? "suspended" : ( run.cancelled ? "cancelled" : "done" )
		return { status : status, text : run.text, pending : run.pending, reason : "" }
	}

	/**
	 * The plain text stream of a server without run control: the answer, nothing else.
	 */
	private struct function sendLegacy( required string text, required struct hooks ) {
		var screen = arguments.hooks
		var answer = ""
		var cancelled = false
		var result = {}
		try {
			result = variables.client.stream(
				baseUrl  : variables.baseUrl,
				message  : arguments.text,
				threadId : variables.threadId,
				onDelta  : ( delta ) => {
					if ( screen.cancelRequested() ) {
						throw( type = "BxAgents.ChatStopped", message = "Stopped by the user." )
					}
					answer &= delta
					screen.push( { type : "delta", text : delta } )
				}
			)
		} catch ( "BxAgents.ChatStopped" e ) {
			cancelled = true
		}
		variables.threadId = result.threadId ?: variables.threadId
		if ( cancelled ) {
			return { status : "cancelled", text : answer, pending : [], reason : "" }
		}
		if ( result.suspended ?: false ) {
			screen.push( { type : "notice", text : "Paused for a human decision. Answer it at #variables.baseUrl#/gateways/interactions/" } )
		}
		return { status : "done", text : answer, pending : [], reason : "" }
	}

	/**
	 * What the server says about the agent, asked once.
	 */
	private struct function describe() {
		if ( isNull( variables.about ) ) {
			try {
				variables.about = variables.client.getJson( variables.baseUrl, "agent" )
			} catch ( any e ) {
				variables.about = {}
			}
		}
		return variables.about
	}

}
