/**
 * Stands in for the vault of a chat that has no chat database to keep one in.
 */
class {

	/**
	 * @return False: there is no vault here
	 */
	boolean function available() {
		return false
	}

	/**
	 * @return Why there is no vault
	 */
	string function why() {
		return "This chat has no database to keep a vault in."
	}

}
