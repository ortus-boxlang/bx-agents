/**
 * What the terminal chat does on the user's machine, for the commands that need it: put text on the
 * clipboard, write the conversation to a file, record the screen. A command asks for the result and
 * says it in its reply; it never touches the screen or the disk itself.
 */
class {

	/**
	 * @screen The chat screen
	 * @transcript The Transcript of this chat
	 * @agentName Titles a recording
	 * @workingDirectory Where a relative file name is written
	 * @attachments The Attachments waiting for the next message
	 */
	function init( required any screen, required any transcript, required string agentName, required string workingDirectory, required any attachments ) {
		variables.attachments = arguments.attachments
		variables.screen = arguments.screen
		variables.transcript = arguments.transcript
		variables.agentName = arguments.agentName
		variables.workingDirectory = arguments.workingDirectory
		variables.reloader = nullValue()
		return this
	}

	/**
	 * @question What to ask
	 * @help A line of help, or blank
	 * @initial Text to start with
	 *
	 * @return The text, or null for esc
	 */
	any function ask( required string question, string help = "", string initial = "" ) {
		return variables.screen.ask( arguments.question, arguments.help, arguments.initial )
	}

	/**
	 * Asks for a secret in a box that shows bullets. What is typed is not drawn, kept or echoed.
	 *
	 * @question What to ask
	 * @help A line of help, or blank
	 *
	 * @return The text, or null for esc
	 */
	any function askSecret( required string question, string help = "" ) {
		return variables.screen.askSecret( arguments.question, arguments.help )
	}

	/**
	 * @question What to ask
	 * @choices Strings, or structs with value, label and hint
	 *
	 * @return The value picked, or null for esc
	 */
	any function choose( required string question, required array choices ) {
		return variables.screen.choose( arguments.question, [], arguments.choices )
	}

	/**
	 * @reloader A function() that reloads the extensions and returns what it found
	 */
	function onReload( required any reloader ) {
		variables.reloader = arguments.reloader
		return this
	}

	/**
	 * Reloads the extensions of this chat.
	 *
	 * @return { reloaded : true, report, problems }, or { reloaded : false } when this chat has no extensions to reload
	 */
	struct function reloadExtensions() {
		if ( isNull( variables.reloader ) ) {
			return { reloaded : false }
		}
		return variables.reloader()
	}

	/**
	 * @return The folder the chat runs in, which is the project's: where /stats enable writes
	 */
	string function projectRoot() {
		return variables.workingDirectory
	}

	/**
	 * @return The look of the message box now, and what can be chosen: { prompt, top, bottom, styles : [ { name, description } ], widgets : [ { name, description, example } ] }
	 */
	struct function promptLook() {
		return variables.screen.promptLook()
	}

	/**
	 * @name A prompt style
	 *
	 * @return An empty string when it is in use now, or what was wrong with the name
	 */
	string function usePromptStyle( required string name ) {
		return variables.screen.setPromptStyle( arguments.name )
	}

	/**
	 * @place top or bottom
	 * @names The widgets to show there, in order
	 *
	 * @return An empty string when they are in use now, or what was wrong
	 */
	string function useWidgets( required string place, required array names ) {
		return variables.screen.setWidgets( arguments.place, arguments.names )
	}

	/**
	 * @return [ { id, keys, does, place } ] the keys of the chat screen as they are now bound
	 */
	/**
	 * Says where the settings files are, so /settings can change any setting and not only how the chat looks.
	 *
	 * @agent The agent's own Agent.yml, or blank when there is no local project
	 * @global The person's Agent.yml for every agent
	 *
	 * @return this
	 */
	function withSettingsFiles( required string agent, required string global ) {
		variables.settingsFiles = { agent : arguments.agent, global : arguments.global }
		return this
	}

	/**
	 * @scope "agent" or "global"
	 *
	 * @return The path of that Agent.yml, blank when there is none to write
	 */
	string function settingsFile( string scope = "agent" ) {
		return ( variables.settingsFiles ?: {} )[ arguments.scope ] ?: ""
	}

	/**
	 * @return One struct per setting of the chat: name, value, source (the layer the value comes from), allowed and does
	 */
	array function settingsTable() {
		return variables.screen.settingsTable().map( r => { name : r.name, value : r.value, source : r.source, allowed : r.allowed, does : r.does } )
	}

	/**
	 * Changes a setting of the chat and saves it, for this agent or for every agent.
	 *
	 * @name The setting
	 * @value The new value
	 * @scope "agent" or "global"
	 *
	 * @return A sentence about what was saved and where
	 *
	 * @throws any When the setting or the value is not known, or there is no file to save to
	 */
	string function changeSetting( required string name, required string value, string scope = "agent" ) {
		return variables.screen.changeSetting( arguments.name, arguments.value, arguments.scope )
	}

	/**
	 * Takes a setting out of a settings file, so the layer below it applies again.
	 *
	 * @name The setting
	 * @scope "agent" or "global"
	 *
	 * @return A sentence about what happened
	 */
	string function resetSetting( required string name, string scope = "agent" ) {
		return variables.screen.resetSetting( arguments.name, arguments.scope )
	}

	array function keyRows() {
		return variables.screen.keyTable().map( r => { id : r.id, keys : r.keys, does : r.does, place : r.place } )
	}

	/**
	 * @return True when there was an answer to copy
	 */
	boolean function copyLast() {
		var last = variables.transcript.lastAnswer()
		if ( !len( last ) ) {
			return false
		}
		variables.screen.copy( last )
		return true
	}

	/**
	 * @report A ContextReport.build() result
	 *
	 * @return The report with what waits for the next message counted in
	 */
	struct function counting( required struct report ) {
		return variables.attachments.addTo( arguments.report )
	}

	/**
	 * @return What has been said in this chat: [ { role : "you" | "agent", text } ]
	 */
	array function messages() {
		return variables.transcript.entries()
	}

	/**
	 * Writes a file for /export.
	 *
	 * @name A file name, relative to the working directory or absolute
	 * @content What to write
	 *
	 * @return { ok : true, path } or { ok : false, reason }
	 */
	struct function writeFile( required string name, required string content ) {
		var absolute = absolutePath( arguments.name )
		try {
			fileWrite( absolute, arguments.content )
		} catch ( any e ) {
			return { ok : false, reason : "Could not write #absolute#: #e.message#" }
		}
		return { ok : true, path : absolute }
	}

	/**
	 * /record [file] starts, /record stop finishes.
	 *
	 * @return { style, text }: what to tell the user
	 */
	struct function record( required string rest ) {
		if ( arguments.rest.lcase() == "stop" ) {
			return stopRecording()
		}
		if ( variables.screen.isRecording() ) {
			return { style : "warn", text : "Already recording to #variables.screen.recordingFile()#. Type /record stop to finish." }
		}
		return startRecording( arguments.rest )
	}

	/**
	 * Starts recording the screen. A failure is told, not thrown: the chat carries on.
	 *
	 * @file A file name, or empty for a dated one in the working directory
	 *
	 * @return { style, text }
	 */
	struct function startRecording( required string file ) {
		var absolute = absolutePath( len( arguments.file ) ? arguments.file : "chat-#dateTimeFormat( now(), 'yyyyMMdd-HHmmss' )#.cast" )
		try {
			variables.screen.startRecording( absolute, "bxAgents chat: " & variables.agentName )
			return { style : "ok", text : "Recording to #absolute#. Type /record stop to finish." }
		} catch ( any e ) {
			return { style : "warn", text : "Could not start recording: #e.message#" }
		}
	}

	private struct function stopRecording() {
		if ( !variables.screen.isRecording() ) {
			return { style : "warn", text : "No recording is on." }
		}
		var problem = variables.screen.recordingError()
		var file = variables.screen.stopRecording()
		return { style : len( problem ) ? "warn" : "ok", text : len( problem ) ? "The recording stopped early (#problem#). What was captured is in #file#" : "Recording saved to #file#" }
	}

	/**
	 * @file A file name, absolute or relative to the working directory
	 *
	 * @return The absolute path
	 */
	private string function absolutePath( required string file ) {
		return ( arguments.file.startsWith( "/" ) || reFind( "^[A-Za-z]:[\/]", arguments.file ) ) ? arguments.file : variables.workingDirectory & "/" & arguments.file
	}

}
