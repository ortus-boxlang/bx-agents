/**
 * The loop behind `bxAgents chat`: read a message, run a turn, show what happened. It knows
 * nothing about terminals or about how the agent is reached; it talks to a screen (the
 * ChatScreen of the bxagents.tui package, or a stand-in in tests) and a session
 * (InProcessSession or HttpSession).
 *
 * The screen:  chooseKeys( title, lines, choices, keys, footer ), ask( title, help, initial ), readInput(), printUser( text ), print( style, text ), printMarkdown( text ),
 *              banner( agent, model, mode ), beginTurn(), push( event ), endTurn(),
 *              cancelRequested(), takeSteer(), choose( title, lines, choices ), copy( text ), close()
 * The session: agentName(), modelName(), mode(), tools(), newThread(), notes(), sessions(), resumeSession( ref ),
 *              clear(), compact(), info(), conversationId(),
 *              modelInfo(), switchable(), profiles(), useProfile( name ), useDefault()
 *              send( text, hooks ), resume( decision, hooks ), close()
 *              notes() is an object with available(), list( scope ), add( scope, text ), update( id, text ),
 *              remove( id ), stats()
 *
 * Commands start with a slash. They are not written here: each is a class of the command layer
 * (models.chat.commands) that answers with a Reply, and TerminalRenderer draws the Reply on the
 * screen. Everything else typed is a message to the agent.
 */
class {

	/**
	 * @session The session
	 * @workingDirectory Where /export writes a relative file name; defaults to the current directory
	 * @registry The CommandRegistry; the built-in commands when not given
	 */
	function init( required any session, string workingDirectory = "", any registry ) {
		variables.session = arguments.session
		variables.transcript = new "models.cli.chat.Transcript@bxagents"()
		variables.registry = isNull( arguments.registry ) ? new "models.chat.commands.CommandCatalog@bxagents"().standard() : arguments.registry
		variables.workingDirectory = len( arguments.workingDirectory ) ? arguments.workingDirectory : createObject( "java", "java.lang.System" ).getProperty( "user.dir" )
		variables.hooks = {
			push            : ( event ) => variables.screen.push( event ),
			cancelRequested : () => variables.screen.cancelRequested(),
			takeSteer       : () => variables.screen.takeSteer()
		}
		variables.screen = nullValue()
		return this
	}

	/**
	 * @return The commands, for the screen's slash menu
	 */
	array function commands() {
		return variables.registry.menu( "tui" )
	}

	/**
	 * @return [ { role : "you" | "agent", text } ] the conversation so far
	 */
	array function transcript() {
		return variables.transcript.entries()
	}

	/**
	 * Runs until the user leaves.
	 *
	 * @screen The chat screen
	 * @resume A conversation to open first: "last" for the most recent, or a number or id; blank starts a new one
	 * @record False for no recording; true or a file name to record from the first line (a relative name is
	 *         kept in the working directory, true picks one)
	 */
	void function run( required any screen, any record = false, string resume = "" ) {
		variables.screen = arguments.screen
		var port = new "models.cli.chat.TerminalPort@bxagents"( arguments.screen, variables.transcript, variables.session.agentName(), variables.workingDirectory )
		variables.context = new "models.chat.commands.CommandContext@bxagents"( variables.session, "tui", true, port )
		variables.renderer = new "models.cli.chat.TerminalRenderer@bxagents"( arguments.screen, variables.session, variables.transcript, ( line ) => command( line ) )
		if ( !isBoolean( arguments.record ) || arguments.record ) {
			var started = port.startRecording( isBoolean( arguments.record ) ? "" : arguments.record )
			variables.screen.print( started.style, started.text )
		}
		variables.screen.banner( variables.session.agentName(), variables.session.modelName(), variables.session.mode() )
		if ( len( arguments.resume ) ) {
			// "last" is the most recent conversation
			command( "/resume" & ( arguments.resume == "last" ? "" : " " & arguments.resume ) )
		}
		while ( true ) {
			var input = variables.screen.readInput()
			if ( isNull( input ) ) {
				break
			}
			var text = trim( input )
			if ( !len( text ) ) {
				continue
			}
			if ( text.startsWith( "/" ) ) {
				if ( !command( text ) ) {
					break
				}
				continue
			}
			turn( text )
		}
	}

	// ----------------------------------------------------------------------------------

	/**
	 * Runs a command line and shows its reply.
	 *
	 * @return False when the command asks to leave
	 */
	private boolean function command( required string text ) {
		return variables.renderer.show( variables.registry.run( arguments.text, variables.context ) )
	}

	/**
	 * Sends one message and shows the turn, then deals with a run that stopped for approval.
	 */
	private void function turn( required string text ) {
		variables.screen.printUser( arguments.text )
		variables.transcript.append( { role : "you", text : arguments.text } )

		var result = execute( () => variables.session.send( text, variables.hooks ) )
		while ( result.status == "suspended" ) {
			var decision = askApproval( result.pending )
			result = execute( () => variables.session.resume( decision, variables.hooks ) )
		}
		if ( len( result.text ?: "" ) ) {
			variables.transcript.append( { role : "agent", text : result.text } )
		}
		if ( result.status == "cancelled" ) {
			variables.screen.print( "warn", "Stopped." )
		} else if ( result.status == "stopped" ) {
			variables.screen.print( "warn", result.reason )
		}
	}

	/**
	 * Runs one stretch of the agent's work with the live area drawing it. An error ends the
	 * turn, not the chat: it is shown and the next message starts clean.
	 */
	private struct function execute( required function body ) {
		variables.screen.beginTurn()
		var result = { status : "error", text : "", pending : [] }
		try {
			result = arguments.body()
		} catch ( any e ) {
			variables.screen.push( { type : "error", text : e.message } )
		} finally {
			variables.screen.endTurn()
		}
		return result
	}

	/**
	 * Shows what the agent is waiting to do and asks. No answer counts as no.
	 *
	 * @pending [ { toolName, toolArgs } ]
	 */
	private string function askApproval( required array pending ) {
		var lines = []
		for ( var action in arguments.pending ) {
			var args = []
			for ( var key in ( action.toolArgs ?: {} ) ) {
				args.append( key & "=" & ( isSimpleValue( action.toolArgs[ key ] ) ? action.toolArgs[ key ] : jsonSerialize( action.toolArgs[ key ] ) ) )
			}
			lines.append( ( action.toolName ?: "a tool" ) & "  " & args.toList( " " ) )
		}
		var decision = variables.screen.choose(
			"The agent wants to run:",
			lines,
			[
				{ value : "approve", label : "Approve", hint : "this once" },
				{ value : "approve_session", label : "Approve for this conversation", hint : "do not ask again for these tools" },
				{ value : "reject", label : "Reject" }
			]
		)
		return isNull( decision ) ? "reject" : decision
	}

}
