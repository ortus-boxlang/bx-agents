/**
 * The loop behind `bxAgents chat`: read a message, run a turn, show what happened. It knows
 * nothing about terminals or about how the agent is reached; it talks to a screen (the
 * ChatScreen of the bxagents.tui package, or a stand-in in tests) and a session
 * (InProcessSession or HttpSession).
 *
 * The screen:  chooseKeys( title, lines, choices, keys, footer ), ask( title, help, initial ), readInput(), printUser( text ), print( style, text ), printMarkdown( text ),
 *              setStatus( text ), setImagesAllowed( allowed, reason ), takeImages(),
 *              banner( agent, model, mode ), beginTurn(), push( event ), endTurn(),
 *              cancelRequested(), takeSteer(), choose( title, lines, choices ), copy( text ), close()
 * The session: agentName(), modelName(), mode(), tools(), newThread(), notes(), sessions(), resumeSession( ref ),
 *              clear(), compact(), info(), conversationId(), contextReport(),
 *              modelInfo(), switchable(), profiles(), useProfile( name ), useDefault()
 *              send( text, hooks, images ), resume( decision, hooks ), close()
 *              notes() is an object with available(), list( scope ), add( scope, text ), update( id, text ),
 *              remove( id ), stats()
 *
 * Commands start with a slash. They are not written here: each is a class of the command layer
 * (models.chat.commands) that answers with a Reply, and TerminalRenderer draws the Reply on the
 * screen.
 *
 * Two more prefixes run something on the person's own machine, never on a server:
 *   !command    a shell command; its output is shown and goes with the next message (!!command: shown only)
 *   #function() one BoxLang built-in function call; its result likewise (##function(): shown only)
 * They are switched on or off in the person's ~/.bxagents/bxAgents.yml (see UserConfig).
 *
 * A message can mention files with @path: a text file goes with it as a block of its content, an image as an image
 * part (models.cli.chat.FileMentions). A picture pasted into the message box (the screen's takeImages()) goes the
 * same way. Everything else typed is a message to the agent.
 */
class {

	/**
	 * @session The session
	 * @workingDirectory Where /export writes a relative file name; defaults to the current directory
	 * @registry The CommandRegistry; the built-in commands when not given
	 * @userConfig The person's UserConfig; ~/.bxagents/bxAgents.yml when not given
	 */
	function init( required any session, string workingDirectory = "", any registry, any userConfig ) {
		variables.session = arguments.session
		variables.transcript = new "models.cli.chat.Transcript@bxagents"()
		variables.attachments = new "models.cli.chat.Attachments@bxagents"()
		variables.userConfig = isNull( arguments.userConfig ) ? new "models.cli.UserConfig@bxagents"() : arguments.userConfig
		variables.registry = isNull( arguments.registry ) ? new "models.chat.commands.CommandCatalog@bxagents"().standard() : arguments.registry
		variables.workingDirectory = len( arguments.workingDirectory ) ? arguments.workingDirectory : createObject( "java", "java.lang.System" ).getProperty( "user.dir" )
		variables.hooks = {
			push            : ( event ) => variables.screen.push( event ),
			cancelRequested : () => variables.screen.cancelRequested(),
			takeSteer       : () => variables.screen.takeSteer()
		}
		variables.screen = nullValue()
		return this
	}

	/**
	 * @return The commands, for the screen's slash menu
	 */
	array function commands() {
		return variables.registry.menu( "tui" )
	}

	/**
	 * @return [ { role : "you" | "agent", text } ] the conversation so far
	 */
	array function transcript() {
		return variables.transcript.entries()
	}

	/**
	 * Runs until the user leaves.
	 *
	 * @screen The chat screen
	 * @resume A conversation to open first: "last" for the most recent, or a number or id; blank starts a new one
	 * @record False for no recording; true or a file name to record from the first line (a relative name is
	 *         kept in the working directory, true picks one)
	 */
	void function run( required any screen, any record = false, string resume = "" ) {
		variables.screen = arguments.screen
		var port = new "models.cli.chat.TerminalPort@bxagents"( arguments.screen, variables.transcript, variables.session.agentName(), variables.workingDirectory, variables.attachments )
		for ( var problem in variables.userConfig.problems() ) {
			arguments.screen.print( "warn", problem )
		}
		for ( var problem in arguments.screen.bindKeys( variables.userConfig.keys() ) ) {
			arguments.screen.print( "warn", "#variables.userConfig.path()#: " & problem )
		}
		variables.context = new "models.chat.commands.CommandContext@bxagents"( variables.session, "tui", true, port )
		variables.renderer = new "models.cli.chat.TerminalRenderer@bxagents"( arguments.screen, variables.session, variables.transcript, ( line ) => command( line ) )
		if ( !isBoolean( arguments.record ) || arguments.record ) {
			var started = port.startRecording( isBoolean( arguments.record ) ? "" : arguments.record )
			variables.screen.print( started.style, started.text )
		}
		variables.screen.banner( variables.session.agentName(), variables.session.modelName(), variables.session.mode() )
		if ( len( arguments.resume ) ) {
			// "last" is the most recent conversation
			command( "/resume" & ( arguments.resume == "last" ? "" : " " & arguments.resume ) )
		}
		while ( true ) {
			refreshStatus()
			var input = variables.screen.readInput()
			if ( isNull( input ) ) {
				break
			}
			var text = trim( input )
			if ( !len( text ) ) {
				continue
			}
			// a lone question mark is the way to ask which keys do what
			if ( text == "?" ) {
				text = "/keys"
			}
			if ( text.startsWith( "/" ) ) {
				if ( !command( text ) ) {
					break
				}
				continue
			}
			if ( isShellLine( text ) ) {
				shellLine( text )
				continue
			}
			if ( isBifLine( text ) ) {
				bifLine( text )
				continue
			}
			turn( text )
		}
	}

	// ----------------------------------------------------------------------------------

	/**
	 * Tells the prompt's widgets what the chat knows: the agent, the profile or model, and the conversation's name.
	 * Whatever cannot be found is left out; a widget with nothing to say is not shown.
	 */
	private void function refreshFacts() {
		var facts = {}
		try {
			facts.agent = variables.session.agentName()
		} catch ( any e ) {
		}
		try {
			var info = variables.session.modelInfo()
			facts.profile = len( info.profile ?: "" ) ? info.profile : ( info.model ?: "" )
		} catch ( any e ) {
			try {
				facts.profile = variables.session.modelName()
			} catch ( any e2 ) {
			}
		}
		try {
			facts.session = variables.session.conversationTitle()
		} catch ( any e ) {
		}
		try {
			variables.screen.setFacts( facts )
		} catch ( any e ) {
		}
	}

	/**
	 * Puts the size of the context in the hint row under the message box, as it stands now. It changes with every
	 * message, /clear, /compact, /resume and note, so it is worked out before each prompt. A status bar is a
	 * convenience: when the size cannot be worked out the chat goes on without it.
	 */
	private void function refreshStatus() {
		refreshFacts()
		try {
			variables.screen.setStatus( new "models.chat.ContextLines@bxagents"().status( variables.attachments.addTo( variables.session.contextReport() ) ) )
		} catch ( any e ) {
			variables.screen.setStatus( "" )
		}
		// a picture is refused at the paste, with the reason, for a model known not to see them
		try {
			var blind = variables.session.modelFacts().vision == "no"
			variables.screen.setImagesAllowed( !blind, blind ? "The model in use cannot see images (vision: false for it), so the picture was not added." : "" )
		} catch ( any e ) {
			variables.screen.setImagesAllowed( true, "" )
		}
	}

	/**
	 * Runs a command line and shows its reply.
	 *
	 * @return False when the command asks to leave
	 */
	private boolean function command( required string text ) {
		return variables.renderer.show( variables.registry.run( arguments.text, variables.context ) )
	}

	// ----------------------------------------------------------------------------------
	// Running something on this machine: !command and #function()
	// ----------------------------------------------------------------------------------

	/**
	 * @return True for !command or !!command: the ! is followed at once by something to run, so "! hello" is a message
	 */
	private boolean function isShellLine( required string text ) {
		return reFind( "^!!?[^\s!]", arguments.text ) > 0
	}

	/**
	 * @return True for #name( ... ) or ##name( ... ): a hash and then a call. A message that merely starts with a hash, such as a Markdown heading, is a message.
	 */
	private boolean function isBifLine( required string text ) {
		var hash = "##"
		if ( !arguments.text.startsWith( hash ) ) {
			return false
		}
		var rest = arguments.text.startsWith( hash & hash ) ? mid( arguments.text, 3, len( arguments.text ) ) : mid( arguments.text, 2, len( arguments.text ) )
		return reFind( "^\s*[A-Za-z_][A-Za-z0-9_]*\s*\(", rest ) > 0
	}

	/**
	 * Runs a shell command and shows what it printed. Unless it was typed with !!, the output also waits for the
	 * next message and goes with it, so the agent can see what you saw.
	 */
	private void function shellLine( required string text ) {
		var screenOnly = arguments.text.startsWith( "!!" )
		var line = trim( mid( arguments.text, screenOnly ? 3 : 2, len( arguments.text ) ) )
		var allowed = variables.userConfig.chat().shell
		if ( allowed == false || allowed == "false" ) {
			variables.screen.print( "warn", "Shell commands are switched off in #variables.userConfig.path()# (chat: shell: false)." )
			return
		}
		var runner = new "models.cli.chat.ShellRunner@bxagents"( isBoolean( allowed ) ? "" : allowed, variables.workingDirectory )
		variables.screen.print( "accent", "$ " & line )
		var result = runner.run( line )
		var report = result.output & ( result.truncated ? char( 10 ) & "(the output was cut at #numberFormat( len( result.output ) )# characters)" : "" )
		report &= result.timedOut ? char( 10 ) & "(stopped: it ran longer than a minute)" : ( result.ok ? "" : char( 10 ) & "(exit code #result.exitCode#)" )
		showOutput( report, result.ok ? "muted" : "warn" )
		keepOrNot( screenOnly, "shell", line, report )
	}

	/**
	 * Runs one BoxLang built-in function call and shows what it returned; kept for the next message like !command.
	 */
	private void function bifLine( required string text ) {
		var hash = "##"
		var screenOnly = arguments.text.startsWith( hash & hash )
		var call = trim( mid( arguments.text, screenOnly ? 3 : 2, len( arguments.text ) ) )
		var allowed = variables.userConfig.chat().bifs
		if ( allowed == false || allowed == "false" ) {
			variables.screen.print( "warn", "Function calls are switched off in #variables.userConfig.path()# (chat: bifs: false)." )
			return
		}
		variables.screen.print( "accent", hash & " " & call )
		var outcome = new "models.cli.chat.BifCall@bxagents"( isArray( allowed ) ? allowed : true ).run( call )
		if ( !outcome.ok ) {
			variables.screen.print( "warn", outcome.reason )
			return
		}
		var shown = new "models.cli.chat.ValueText@bxagents"().of( outcome.value ?: nullValue() )
		showOutput( shown, "muted" )
		keepOrNot( screenOnly, "bif", call, shown )
	}

	private void function showOutput( required string text, required string style ) {
		var lines = len( arguments.text ) ? arguments.text.listToArray( char( 10 ), true ) : [ "(no output)" ]
		var most = 40
		for ( var i = 1; i <= min( most, lines.len() ); i++ ) {
			variables.screen.print( arguments.style, lines[ i ] )
		}
		if ( lines.len() > most ) {
			variables.screen.print( "muted", "... #lines.len() - most# more lines" )
		}
	}

	private void function keepOrNot( required boolean screenOnly, required string kind, required string label, required string text ) {
		if ( arguments.screenOnly ) {
			return
		}
		variables.attachments.add( arguments.kind, arguments.label, arguments.text )
		variables.screen.print( "muted", "Attached to your next message." )
	}

	/**
	 * Sends one message and shows the turn, then deals with a run that stopped for approval.
	 */
	private void function turn( required string text ) {
		variables.screen.printUser( arguments.text )
		variables.transcript.append( { role : "you", text : arguments.text } )

		// @path mentions: a text file goes along as a block, an image as an image part
		var mentioned = new "models.cli.chat.FileMentions@bxagents"( variables.workingDirectory ).read( arguments.text )
		for ( var problem in mentioned.problems ) {
			variables.screen.print( "warn", problem )
		}
		for ( var file in mentioned.files ) {
			variables.attachments.add( "file", file.name, file.content )
		}
		var images = mentioned.images
		for ( var pasted in variables.screen.takeImages() ) {
			images.append( { path : pasted } )
		}
		var attached = variables.attachments.count()
		var sent = variables.attachments.compose( arguments.text )
		if ( attached || images.len() ) {
			var what = []
			if ( attached ) { what.append( "#attached# attachment#attached == 1 ? '' : 's'#" ) }
			if ( images.len() ) { what.append( "#images.len()# image#images.len() == 1 ? '' : 's'#" ) }
			variables.screen.print( "muted", "Sent with " & what.toList( " and " ) & "." )
		}
		var result = execute( () => variables.session.send( sent, variables.hooks, images ) )
		while ( result.status == "suspended" ) {
			var decision = askApproval( result.pending )
			result = execute( () => variables.session.resume( decision, variables.hooks ) )
		}
		if ( len( result.text ?: "" ) ) {
			variables.transcript.append( { role : "agent", text : result.text } )
		}
		if ( result.status == "cancelled" ) {
			variables.screen.print( "warn", "Stopped." )
		} else if ( result.status == "stopped" ) {
			variables.screen.print( "warn", result.reason )
		}
	}

	/**
	 * Runs one stretch of the agent's work with the live area drawing it. An error ends the
	 * turn, not the chat: it is shown and the next message starts clean.
	 */
	private struct function execute( required function body ) {
		variables.screen.beginTurn()
		var result = { status : "error", text : "", pending : [] }
		try {
			result = arguments.body()
		} catch ( any e ) {
			variables.screen.push( { type : "error", text : e.message } )
		} finally {
			variables.screen.endTurn()
		}
		return result
	}

	/**
	 * Shows what the agent is waiting to do and asks. No answer counts as no.
	 *
	 * @pending [ { toolName, toolArgs } ]
	 */
	private string function askApproval( required array pending ) {
		var lines = []
		for ( var action in arguments.pending ) {
			var args = []
			for ( var key in ( action.toolArgs ?: {} ) ) {
				args.append( key & "=" & ( isSimpleValue( action.toolArgs[ key ] ) ? action.toolArgs[ key ] : jsonSerialize( action.toolArgs[ key ] ) ) )
			}
			lines.append( ( action.toolName ?: "a tool" ) & "  " & args.toList( " " ) )
		}
		var decision = variables.screen.choose(
			"The agent wants to run:",
			lines,
			[
				{ value : "approve", label : "Approve", hint : "this once" },
				{ value : "approve_session", label : "Approve for this conversation", hint : "do not ask again for these tools" },
				{ value : "reject", label : "Reject" }
			]
		)
		return isNull( decision ) ? "reject" : decision
	}

}
