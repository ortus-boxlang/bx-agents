/**
 * The loop behind `bxAgents chat`: read a message, run a turn, show what happened. It knows
 * nothing about terminals or about how the agent is reached; it talks to a screen (the
 * ChatScreen of the bxagents.tui package, or a stand-in in tests) and a session
 * (InProcessSession or HttpSession).
 *
 * The screen:  readInput(), printUser( text ), print( style, text ), printMarkdown( text ),
 *              banner( agent, model, mode ), beginTurn(), push( event ), endTurn(),
 *              cancelRequested(), takeSteer(), choose( title, lines, choices ), copy( text ), close()
 * The session: agentName(), modelName(), mode(), tools(), newThread(), notes(),
 *              send( text, hooks ), resume( decision, hooks ), close()
 *              notes() is an object with available(), list( scope ), add( scope, text ), update( id, text ),
 *              remove( id ), stats()
 *
 * Commands start with a slash. Everything else is a message to the agent.
 */
class {

	static {
		COMMANDS = [
			{ name : "/help", hint : "show these commands" },
			{ name : "/new", hint : "start a new conversation" },
			{ name : "/tools", hint : "list the agent's tools" },
			{ name : "/remember", hint : "keep a note about you: /remember I prefer short answers" },
			{ name : "/notes", hint : "your notes and the agent's: /notes, add [agent] <text>, edit <id> <text>, remove <id>, stats" },
			{ name : "/copy", hint : "copy the last answer to the clipboard" },
			{ name : "/save", hint : "save the conversation to a file: /save notes.md" },
			{ name : "/record", hint : "record the screen as a .cast file: /record [file], /record stop" },
			{ name : "/exit", hint : "leave the chat" }
		]
	}

	/**
	 * @session The session
	 * @workingDirectory Where /save writes a relative file name; defaults to the current directory
	 */
	function init( required any session, string workingDirectory = "" ) {
		variables.session = arguments.session
		variables.transcript = []
		variables.workingDirectory = len( arguments.workingDirectory ) ? arguments.workingDirectory : createObject( "java", "java.lang.System" ).getProperty( "user.dir" )
		variables.hooks = {
			push            : ( event ) => variables.screen.push( event ),
			cancelRequested : () => variables.screen.cancelRequested(),
			takeSteer       : () => variables.screen.takeSteer()
		}
		variables.screen = nullValue()
		return this
	}

	/**
	 * @return The commands, for the screen's slash menu
	 */
	array function commands() {
		return static.COMMANDS
	}

	/**
	 * @return [ { role : "you" | "agent", text } ] the conversation so far
	 */
	array function transcript() {
		return variables.transcript
	}

	/**
	 * Runs until the user leaves.
	 *
	 * @screen The chat screen
	 * @record False for no recording; true or a file name to record from the first line (a relative name is
	 *         kept in the working directory, true picks one)
	 */
	void function run( required any screen, any record = false ) {
		variables.screen = arguments.screen
		if ( !isBoolean( arguments.record ) || arguments.record ) {
			startRecording( isBoolean( arguments.record ) ? "" : arguments.record )
		}
		variables.screen.banner( variables.session.agentName(), variables.session.modelName(), variables.session.mode() )
		while ( true ) {
			var input = variables.screen.readInput()
			if ( isNull( input ) ) {
				break
			}
			var text = trim( input )
			if ( !len( text ) ) {
				continue
			}
			if ( text.startsWith( "/" ) ) {
				if ( !command( text ) ) {
					break
				}
				continue
			}
			turn( text )
		}
	}

	// ----------------------------------------------------------------------------------

	/**
	 * @return False when the command asks to leave
	 */
	private boolean function command( required string text ) {
		var name = listFirst( arguments.text, " " ).lcase()
		var rest = trim( arguments.text.mid( len( name ) + 1, len( arguments.text ) ) )
		switch ( name ) {
			case "/exit":
			case "/quit":
				return false
			case "/help":
				for ( var entry in static.COMMANDS ) {
					variables.screen.print( "muted", entry.name & "  " & entry.hint )
				}
				break
			case "/new":
				variables.session.newThread()
				variables.transcript = []
				variables.screen.print( "muted", "New conversation. The agent starts fresh." )
				break
			case "/tools":
				var tools = variables.session.tools()
				variables.screen.print( "muted", tools.len() ? "Tools: " & tools.toList( ", " ) : "No tool list is available in this mode." )
				break
			case "/remember":
				notes( "add " & rest )
				break
			case "/notes":
				notes( rest )
				break
			case "/copy":
				var last = lastAnswer()
				if ( len( last ) ) {
					variables.screen.copy( last )
					variables.screen.print( "ok", "Copied the last answer." )
				} else {
					variables.screen.print( "warn", "There is no answer to copy yet." )
				}
				break
			case "/save":
				save( rest )
				break
			case "/record":
				record( rest )
				break
			default:
				variables.screen.print( "warn", "Unknown command #name#. Type /help." )
		}
		return true
	}

	/**
	 * /notes with nothing lists both scopes; add, edit, remove and stats change or measure them.
	 *
	 * @rest What follows the command
	 */
	private void function notes( required string rest ) {
		var kept = variables.session.notes()
		if ( !kept.available() ) {
			variables.screen.print( "warn", kept.why() )
			return
		}
		var report = new "models.notes.NotesReport@bxagents"()
		var verb = lCase( listFirst( arguments.rest, " " ) )
		var after = trim( mid( arguments.rest, len( verb ) + 1, len( arguments.rest ) ) )
		try {
			switch ( verb ) {
				case "":
				case "list":
					var stats = kept.stats()
					for ( var line in report.listLines( "Your notes", kept.list( "user" ), stats.user ) ) {
						variables.screen.print( "muted", line )
					}
					for ( var line in report.listLines( "Agent notes", kept.list( "agent" ), stats.agent ) ) {
						variables.screen.print( "muted", line )
					}
					break
				case "stats":
					for ( var line in report.statsLines( kept.stats() ) ) {
						variables.screen.print( "muted", line )
					}
					break
				case "add":
					var scope = "user"
					if ( lCase( listFirst( after, " " ) ) == "agent" ) {
						scope = "agent"
						after = trim( mid( after, 6, len( after ) ) )
					}
					if ( !len( after ) ) {
						variables.screen.print( "warn", "Usage: /remember <text>, or /notes add [agent] <text>" )
						break
					}
					showOutcome( kept.add( scope, after ), "Noted." )
					break
				case "edit":
					var id = listFirst( after, " " )
					var text = trim( mid( after, len( id ) + 1, len( after ) ) )
					if ( !len( id ) || !len( text ) ) {
						variables.screen.print( "warn", "Usage: /notes edit <id> <new text>" )
						break
					}
					showOutcome( kept.update( id, text ), "Updated." )
					break
				case "remove":
				case "delete":
					if ( !len( after ) ) {
						variables.screen.print( "warn", "Usage: /notes remove <id>" )
						break
					}
					showOutcome( kept.remove( after ), "Removed." )
					break
				default:
					variables.screen.print( "warn", "Usage: /notes [list], add [agent] <text>, edit <id> <text>, remove <id>, stats" )
			}
		} catch ( any e ) {
			variables.screen.print( "warn", "Notes: " & e.message )
		}
	}

	private void function showOutcome( required struct outcome, required string done ) {
		if ( arguments.outcome.ok ?: false ) {
			variables.screen.print( "ok", arguments.done )
		} else {
			variables.screen.print( "warn", arguments.outcome.reason ?: "That did not work." )
		}
	}

	/**
	 * Sends one message and shows the turn, then deals with a run that stopped for approval.
	 */
	private void function turn( required string text ) {
		variables.screen.printUser( arguments.text )
		variables.transcript.append( { role : "you", text : arguments.text } )

		var result = execute( () => variables.session.send( text, variables.hooks ) )
		while ( result.status == "suspended" ) {
			var decision = askApproval( result.pending )
			result = execute( () => variables.session.resume( decision, variables.hooks ) )
		}
		if ( len( result.text ?: "" ) ) {
			variables.transcript.append( { role : "agent", text : result.text } )
		}
		if ( result.status == "cancelled" ) {
			variables.screen.print( "warn", "Stopped." )
		} else if ( result.status == "stopped" ) {
			variables.screen.print( "warn", result.reason )
		}
	}

	/**
	 * Runs one stretch of the agent's work with the live area drawing it. An error ends the
	 * turn, not the chat: it is shown and the next message starts clean.
	 */
	private struct function execute( required function body ) {
		variables.screen.beginTurn()
		var result = { status : "error", text : "", pending : [] }
		try {
			result = arguments.body()
		} catch ( any e ) {
			variables.screen.push( { type : "error", text : e.message } )
		} finally {
			variables.screen.endTurn()
		}
		return result
	}

	/**
	 * Shows what the agent is waiting to do and asks. No answer counts as no.
	 *
	 * @pending [ { toolName, toolArgs } ]
	 */
	private string function askApproval( required array pending ) {
		var lines = []
		for ( var action in arguments.pending ) {
			var args = []
			for ( var key in ( action.toolArgs ?: {} ) ) {
				args.append( key & "=" & ( isSimpleValue( action.toolArgs[ key ] ) ? action.toolArgs[ key ] : jsonSerialize( action.toolArgs[ key ] ) ) )
			}
			lines.append( ( action.toolName ?: "a tool" ) & "  " & args.toList( " " ) )
		}
		var decision = variables.screen.choose(
			"The agent wants to run:",
			lines,
			[
				{ value : "approve", label : "Approve", hint : "this once" },
				{ value : "approve_session", label : "Approve for this conversation", hint : "do not ask again for these tools" },
				{ value : "reject", label : "Reject" }
			]
		)
		return isNull( decision ) ? "reject" : decision
	}

	private string function lastAnswer() {
		for ( var i = variables.transcript.len(); i >= 1; i-- ) {
			if ( variables.transcript[ i ].role == "agent" ) {
				return variables.transcript[ i ].text
			}
		}
		return ""
	}

	/**
	 * @name A file name, relative to the working directory or absolute; blank picks a dated one
	 */
	private void function save( required string name ) {
		if ( !variables.transcript.len() ) {
			variables.screen.print( "warn", "Nothing to save yet." )
			return
		}
		var absolute = absolutePath( len( arguments.name ) ? arguments.name : "chat-#dateTimeFormat( now(), 'yyyyMMdd-HHmmss' )#.md" )
		var lines = []
		for ( var entry in variables.transcript ) {
			lines.append( "**" & ( entry.role == "you" ? "You" : "Agent" ) & "**" )
			lines.append( "" )
			lines.append( entry.text )
			lines.append( "" )
		}
		fileWrite( absolute, lines.toList( char( 10 ) ) )
		variables.screen.print( "ok", "Saved to #absolute#" )
	}

	/**
	 * @file A file name, absolute or relative to the working directory
	 *
	 * @return The absolute path
	 */
	private string function absolutePath( required string file ) {
		return ( arguments.file.startsWith( "/" ) || reFind( "^[A-Za-z]:[\/]", arguments.file ) ) ? arguments.file : variables.workingDirectory & "/" & arguments.file
	}

	/**
	 * /record [file] starts, /record stop finishes.
	 */
	private void function record( required string rest ) {
		if ( arguments.rest.lcase() == "stop" ) {
			stopRecording()
		} else if ( variables.screen.isRecording() ) {
			variables.screen.print( "warn", "Already recording to #variables.screen.recordingFile()#. Type /record stop to finish." )
		} else {
			startRecording( arguments.rest )
		}
	}

	/**
	 * Starts recording the screen and says where it goes. A failure is shown, not thrown: the chat carries on.
	 *
	 * @file A file name, or empty for a dated one in the working directory
	 */
	private void function startRecording( required string file ) {
		var absolute = absolutePath( len( arguments.file ) ? arguments.file : "chat-#dateTimeFormat( now(), 'yyyyMMdd-HHmmss' )#.cast" )
		try {
			variables.screen.startRecording( absolute, "bxAgents chat: " & variables.session.agentName() )
			variables.screen.print( "ok", "Recording to #absolute#. Type /record stop to finish." )
		} catch ( any e ) {
			variables.screen.print( "warn", "Could not start recording: #e.message#" )
		}
	}

	/**
	 * Finishes the recording and says where it was saved, or that it stopped early.
	 */
	private void function stopRecording() {
		if ( !variables.screen.isRecording() ) {
			variables.screen.print( "warn", "No recording is on." )
			return
		}
		var problem = variables.screen.recordingError()
		var file = variables.screen.stopRecording()
		variables.screen.print( len( problem ) ? "warn" : "ok", len( problem ) ? "The recording stopped early (#problem#). What was captured is in #file#" : "Recording saved to #file#" )
	}

}
