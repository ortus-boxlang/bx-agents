/**
 * `invoke` CLI verb - a single, non-interactive turn against a built
 * project's agent: submit one message, print the response, exit. Exists
 * because `chat` requires a real interactive TTY (`MiniConsole` shells out
 * to `stty` for raw mode) and so can never be scripted/piped/run in CI.
 *
 * Two modes:
 *  - Default (no `--server`): loads `GeneratedAgentFactory.bx` directly (no
 *    ColdBox container, no HTTP) and calls `agent.run()` once - the exact
 *    same in-process path `chat` uses, just without the REPL loop. No
 *    `serve`/gateway prerequisite at all.
 *  - `--server`: launches a REAL, throwaway `boxlang-miniserver` process
 *    (via `support/AgentClient.bx`, which delegates to `Serve.bx`'s own
 *    run() rather than duplicating its config-writing/launch logic), sends
 *    the message as a real HTTP request to the project's always-on
 *    `/__bxagents` agent route, then tears the server back down. This
 *    exercises the actual served path (ColdBox routing, interceptors,
 *    gateways) rather than the shortcut the default mode uses. It needs no
 *    `gateways/*` entry of any kind: the reserved route is emitted on every
 *    build (see RouterGenerator), so a freshly scaffolded project that
 *    exposes nothing publicly still works.
 *
 *    The exact request/response contract below (`POST {path}/invoke` with
 *    `{"input": "..."}`, a `{"output": "...", "success": true}` response)
 *    is ColdBox's own real `toAi()` route contract - confirmed directly
 *    against `coldbox-platform`'s `Router.cfc` source (`toAi()`'s `/invoke`
 *    sub-route: `return { "output" : result, "success" : true }`) and
 *    exercised for real by this project's own `runColdBoxIntegrationTests.bxs`.
 *
 *    Retrying the real request (rather than a separate synthetic health
 *    probe first) also absorbs a known, documented race for free: the
 *    FIRST-EVER request to a freshly booted `toAi()` route can transiently
 *    fail with a WireBox lazy-injection race before succeeding reliably on
 *    every request after (see `runColdBoxIntegrationTests.bxs`'s own
 *    docblock) - a bare fire-once request would occasionally fail for a
 *    reason outside this feature's control, the retry loop below just
 *    waits it out.
 */
class {

	/**
	 * @options { projectRoot (required, absolute path), message (required, the prompt to send), json (optional boolean - print a JSON envelope instead of plain text), server (optional boolean - launch a throwaway boxlang-miniserver and invoke over real HTTP instead of in-process), port (optional, only used with --server; defaults to a free ephemeral port) }
	 *
	 * @return { exitCode, message }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`invoke` requires a project root" )
		}

		var message = trim( arguments.options.message ?: "" )
		if ( !len( message ) ) {
			throw(
				type    = "BxAgents.MissingMessage",
				message = '`invoke` requires --message, e.g. --message="Hello there"'
			)
		}

		var root = projectRoot.reReplace( "[\/]+$", "" )
		var useServer = arguments.options.server ?: false

		var response = useServer
			? invokeViaServer( root, message, arguments.options )
			: invokeInProcess( root, message )

		var asJson = arguments.options.json ?: false

		return {
			exitCode : 0,
			message  : asJson ? jsonSerialize( { response : response } ) : toString( response )
		}
	}

	/**
	 * @root Absolute path to the project root, trailing slash stripped
	 * @message The prompt to send
	 *
	 * @return The agent's plain-string response
	 */
	private any function invokeInProcess( required string root, required string message ) {
		var factoryPath = arguments.root & "/.build/app/agent/GeneratedAgentFactory.bx"

		if ( !fileExists( factoryPath ) ) {
			throw(
				type    = "BxAgents.NotBuilt",
				message = "No build found at [#arguments.root#/.build] - run `build` first"
			)
		}

		var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()
		var factory = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" ).instantiate( factoryPath, context )
		var agent = factory.buildAgent()

		return agent.run( arguments.message )
	}

	/**
	 * Launches a throwaway `boxlang-miniserver`, POSTs the message to the
	 * project's always-on agent route, then always tears the server back down
	 * - even on failure.
	 *
	 * This used to refuse to run unless the project declared a `gateways/*`
	 * entry with `exposes: "agent"`, because that entry was the only thing
	 * that produced a `toAi()` route to POST to. RouterGenerator now emits a
	 * reserved `/__bxagents` route on EVERY build whatever `gateways/`
	 * declares, so there is always an address and that precondition is gone -
	 * `--server` works on a freshly scaffolded project that exposes nothing.
	 *
	 * @root Absolute path to the project root, trailing slash stripped
	 * @message The prompt to send
	 * @options This verb's own raw options struct - only `port` is read
	 *
	 * @return The agent's plain-string response (ColdBox toAi()'s "output" field)
	 */
	private any function invokeViaServer( required string root, required string message, required struct options ) {
		var client = new "models.cli.support.AgentClient@bxagents"()
		var launched = client.startServer( arguments.root, arguments.options.port ?: nullValue() )

		try {
			return client.send( baseUrl : launched.baseUrl, message : arguments.message, timeoutSeconds : 20 ).output
		} finally {
			client.stopServer( launched.process ?: nullValue() )
		}
	}

}
