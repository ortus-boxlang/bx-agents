/**
 * `invoke` CLI verb - a single, non-interactive turn against a built
 * project's agent: submit one message, print the response, exit. Exists
 * because `chat` requires a real interactive TTY (`MiniConsole` shells out
 * to `stty` for raw mode) and so can never be scripted/piped/run in CI.
 *
 * Two modes:
 *  - Default (no `--server`): loads `GeneratedAgentFactory.bx` directly (no
 *    ColdBox container, no HTTP) and calls `agent.run()` once - the exact
 *    same in-process path `chat` uses, just without the REPL loop. No
 *    `serve`/gateway prerequisite at all.
 *  - `--server`: launches a REAL, throwaway `boxlang-miniserver` process
 *    (reusing `Serve.bx`'s own run() - not duplicating its config-writing/
 *    launch logic), sends the message as a real HTTP request through the
 *    project's `toAi()`-exposed route, then tears the server back down.
 *    This exercises the actual served path (ColdBox routing, interceptors,
 *    gateways) rather than the shortcut `chat`/the default mode use -
 *    requires the project to declare a `gateways/*.bx` entry with
 *    `{ exposes: "agent", path: "..." }` (see docs/conventions/gateways.md),
 *    since that's what generates the HTTP route at all.
 *
 *    The exact request/response contract below (`POST {path}/invoke` with
 *    `{"input": "..."}`, a `{"output": "...", "success": true}` response)
 *    is ColdBox's own real `toAi()` route contract - confirmed directly
 *    against `coldbox-platform`'s `Router.cfc` source (`toAi()`'s `/invoke`
 *    sub-route: `return { "output" : result, "success" : true }`) and
 *    exercised for real by this project's own `runColdBoxIntegrationTests.bxs`.
 *
 *    Retrying the real request (rather than a separate synthetic health
 *    probe first) also absorbs a known, documented race for free: the
 *    FIRST-EVER request to a freshly booted `toAi()` route can transiently
 *    fail with a WireBox lazy-injection race before succeeding reliably on
 *    every request after (see `runColdBoxIntegrationTests.bxs`'s own
 *    docblock) - a bare fire-once request would occasionally fail for a
 *    reason outside this feature's control, the retry loop below just
 *    waits it out.
 */
class {

	/**
	 * @options { projectRoot (required, absolute path), message (required, the prompt to send), json (optional boolean - print a JSON envelope instead of plain text), server (optional boolean - launch a throwaway boxlang-miniserver and invoke over real HTTP instead of in-process), port (optional, only used with --server; defaults to a free ephemeral port) }
	 *
	 * @return { exitCode, message }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`invoke` requires a project root" )
		}

		var message = trim( arguments.options.message ?: "" )
		if ( !len( message ) ) {
			throw(
				type    = "BxAgents.MissingMessage",
				message = '`invoke` requires --message, e.g. --message="Hello there"'
			)
		}

		var root = projectRoot.reReplace( "[\/]+$", "" )
		var useServer = arguments.options.server ?: false

		var response = useServer
			? invokeViaServer( root, message, arguments.options )
			: invokeInProcess( root, message )

		var asJson = arguments.options.json ?: false

		return {
			exitCode : 0,
			message  : asJson ? jsonSerialize( { response : response } ) : toString( response )
		}
	}

	/**
	 * @root Absolute path to the project root, trailing slash stripped
	 * @message The prompt to send
	 *
	 * @return The agent's plain-string response
	 */
	private any function invokeInProcess( required string root, required string message ) {
		var factoryPath = arguments.root & "/.build/app/agent/GeneratedAgentFactory.bx"

		if ( !fileExists( factoryPath ) ) {
			throw(
				type    = "BxAgents.NotBuilt",
				message = "No build found at [#arguments.root#/.build] - run `build` first"
			)
		}

		var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()
		var factory = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" ).instantiate( factoryPath, context )
		var agent = factory.buildAgent()

		return agent.run( arguments.message )
	}

	/**
	 * Launches a throwaway `boxlang-miniserver` (via `Serve.bx`'s own run()),
	 * POSTs the message to the project's `toAi()`-exposed route, then always
	 * tears the server back down - even on failure.
	 *
	 * @root Absolute path to the project root, trailing slash stripped
	 * @message The prompt to send
	 * @options This verb's own raw options struct - only `port` is read
	 *
	 * @return The agent's plain-string response (ColdBox toAi()'s "output" field)
	 */
	private any function invokeViaServer( required string root, required string message, required struct options ) {
		var exposurePath = findAgentExposurePath( arguments.root )
		if ( !len( exposurePath ) ) {
			throw(
				type    = "BxAgents.NoAgentExposure",
				message = "--server requires a gateways/*.bx entry with { exposes: 'agent', path: '...' } - none was found. Omit --server to invoke in-process instead."
			)
		}

		var host = "127.0.0.1"
		var port = arguments.options.port ?: findFreePort()

		var serveResult = new "models.cli.Serve@bxagents"().run( { projectRoot : arguments.root, port : port, host : host } )
		var process = serveResult.process

		try {
			return postToAgent( "http://#host#:#port##exposurePath#/invoke", arguments.message, 20 )
		} finally {
			process.destroy()
			process.waitFor( 5, createObject( "java", "java.util.concurrent.TimeUnit" ).SECONDS )
			if ( process.isAlive() ) {
				process.destroyForcibly()
			}
		}
	}

	/**
	 * @root Absolute path to the project root, trailing slash stripped
	 *
	 * @return The first agent-exposure gateway's own route `path`, or "" if none exists
	 */
	private string function findAgentExposurePath( required string root ) {
		var discoverer = new "models.build.ProjectDiscoverer@bxagents"()
		var discovery = discoverer.discover( arguments.root )

		for ( var gw in ( discovery.gateways ?: [] ) ) {
			var config = readEntryConfig( gw.path )
			if ( !isNull( config ) && ( config.exposes ?: "" ) == "agent" ) {
				return trim( config.path ?: "" )
			}
		}

		return ""
	}

	/**
	 * Reads a discovered `gateways/*` entry's config: JSON files are
	 * deserialized directly, `.bx` files are dynamically loaded and their
	 * `configure()` invoked.
	 *
	 * @path Absolute path to the entry's `.bx`/`.json` file
	 *
	 * @return The entry's config struct, or null if it could not be read
	 */
	private any function readEntryConfig( required string path ) {
		try {
			if ( arguments.path.endsWith( ".json" ) ) {
				return jsonDeserialize( fileRead( arguments.path ) )
			}

			var context = createObject( "java", "ortus.boxlang.runtime.BoxRuntime" ).getInstance().getRuntimeContext()
			var instance = createObject( "java", "ortus.boxlang.bxagents.build.DynamicClassLoader" )
				.instantiate( arguments.path, context )
			return instance.configure()
		} catch ( any e ) {
			return null
		}
	}

	/**
	 * Retries the real POST until it succeeds or timeoutSeconds elapses -
	 * see the class docblock for why this doubles as the "wait for the
	 * server to be ready" step, rather than a separate synthetic health probe.
	 *
	 * @url Full URL to the toAi() `/invoke` sub-route, e.g. "http://127.0.0.1:PORT/api/chat/invoke"
	 * @message The prompt to send, wrapped as `{"input": message}`
	 * @timeoutSeconds Give up and throw after this many seconds
	 *
	 * @return The agent's plain-string response (the response's "output" field)
	 */
	private any function postToAgent( required string url, required string message, required numeric timeoutSeconds ) {
		var deadline = getTickCount() + ( arguments.timeoutSeconds * 1000 )
		var body = jsonSerialize( { input : arguments.message } )
		var lastError = ""

		while ( getTickCount() < deadline ) {
			try {
				bx:http url=arguments.url method="POST" result="httpResult" timeout=10 {
					bx:httpparam type="header" name="Content-Type" value="application/json";
					bx:httpparam type="body" value="#body#";
				}

				if ( httpResult.status_code == 200 ) {
					var parsed = jsonDeserialize( httpResult.fileContent )
					if ( parsed.success ?: false ) {
						return parsed.output ?: ""
					}
					lastError = parsed.error ?: httpResult.fileContent
				} else {
					lastError = "HTTP #httpResult.status_code#: #httpResult.fileContent#"
				}
			} catch ( any e ) {
				lastError = e.message
			}
			sleep( 500 )
		}

		throw(
			type    = "BxAgents.InvokeServerNeverReady",
			message = "The server at [#arguments.url#] never returned a successful response: #lastError#"
		)
	}

	/**
	 * @return A currently-unused TCP port on localhost
	 */
	private numeric function findFreePort() {
		var socket = createObject( "java", "java.net.ServerSocket" ).init( 0 )
		var port = socket.getLocalPort()
		socket.close()
		return port
	}

}
