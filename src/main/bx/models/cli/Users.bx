/**
 * `users` CLI verb - the sign-in accounts of the web page, as the project's shared chat database keeps them, and who
 * among them is an admin.
 *
 *   bxAgents users list [--json]
 *   bxAgents users admin --name=ada      make an account an admin
 *   bxAgents users member --name=ada     make an admin a regular account again
 *
 * The roster itself (who exists, their passwords) comes from the `users` of the web gateway, at every boot. This verb
 * only changes the admin flag, which the database keeps from then on. The last admin cannot be demoted.
 */
class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "users",
			group : "SECURITY & ACCESS",
			position : 1,
			description : "Manage web users and admin roles",
			usage : "<action> [options]",
			actions : [ { name : "list" }, { name : "admin" }, { name : "member" } ],
			options : [
				{ name : "name", display : "--name=<name>", description : "User whose role to change.", takesValue : true },
				{ name : "json", description : "Print users as JSON." }
			],
			examples : [ "users list", "users admin --name=ada" ],
			subcommand : true,
			actionExample : "users admin --name=ada"
		}
	}

	function handleList() {
		var rows = accounts().list()
		return asJson( rows, () => listText( rows ) )
	}

	function handleAdmin() {
		return changeRole( true )
	}

	function handleMember() {
		return changeRole( false )
	}

	/**
	 * @return The accounts of this project
	 */
	private any function accounts() {
		return new "models.store.AccountService@bxagents"( chatStore() )
	}

	private string function listText( required array rows ) {
		if ( !arguments.rows.len() ) {
			return "No accounts yet. They come from the `users` of the web gateway when the app starts."
		}
		var report = [ padRight( "USERNAME", 24 ) & padRight( "ROLE", 8 ) & padRight( "STATUS", 10 ) & "NAME" ]
		for ( var row in arguments.rows ) {
			report.append( padRight( row.username, 24 ) & padRight( row.admin ? "admin" : "member", 8 ) & padRight( row.active ? "active" : "inactive", 10 ) & row.displayName )
		}
		return report.toList( char( 10 ) )
	}

	private struct function changeRole( required boolean admin ) {
		var name = requiredOption( "name", "BxAgents.MissingAccountName", "`users #arguments.admin ? 'admin' : 'member'#` requires --name=<the username>" )
		try {
			accounts().setAdmin( name, arguments.admin )
		} catch ( any e ) {
			if ( e.type == "BxAgents.NoSuchAccount" || e.type == "BxAgents.LastAdmin" ) {
				return fail( e.message )
			}
			rethrow
		}
		return done( "[#name#] is now #arguments.admin ? 'an admin' : 'a member'#." )
	}

}
