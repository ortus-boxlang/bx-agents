/**
 * `connectors` CLI verb: the catalog of known connectors that ships with BX Agents, and the check a catalog pull
 * request has to pass. It reads files and prints; it never connects to anything.
 *
 *   bxAgents connectors                 list every connector
 *   bxAgents connectors show <id>       one connector in full
 *   bxAgents connectors check [--dir=DIR]   check the files, exit 1 when one is wrong
 *
 * Add `--json` to list or show for a script.
 */
class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "connectors",
			group : "CONNECT & EXTEND",
			position : 2,
			description : "Browse and check the connector catalog",
			usage : "[list|show <id>|check] [options]",
			options : [
				{ name : "dir", display : "--dir=<path>", description : "Check a custom connector catalog directory.", takesValue : true },
				{ name : "json", description : "Print catalog entries as JSON." }
			],
			examples : [ "connectors", "connectors show github", "connectors check" ],
			note : "Only reads the catalog; use connect to sign in.",
			subcommand : true,
			projectRoot : false
		}
	}


	static {
		SUBCOMMANDS = [ "list", "show", "check" ]
	}

	/**
	 * Reads the catalog, so it needs no project. The words are `_positionals`: [ subcommand, id ].
	 */
	function handle() {
		var words = option( "_positionals", [] )
		var command = words.len() ? words[ 1 ] : "list"
		if ( !static.SUBCOMMANDS.contains( command ) ) {
			throw( type = "BxAgents.UnknownConnectorsCommand", message = "Say what to do: bxAgents connectors [#static.SUBCOMMANDS.toList( '|' )#]" )
		}
		var catalog = new "models.connectors.ConnectorCatalog@bxagents"( trim( option( "dir" ) ) )

		switch ( command ) {
			case "show":
				return showEntry( catalog, words.slice( 2 ) )
			case "check":
				return check( catalog )
			default:
				return list( catalog )
		}
	}

	private struct function list( required any catalog ) {
		var knownCatalog = arguments.catalog
		var entries = knownCatalog.all()
		return asJson( entries, () => {
			var report = [ "ID           NAME                              HOW IN              RISK    VERIFIED" ]
			for ( var group in knownCatalog.grouped() ) {
				report.append( "" )
				report.append( group.category )
				for ( var entry in group.connectors ) {
					report.append(
						"  " & fitColumn( entry.id, 13 ) & fitColumn( entry.name, 34 ) & fitColumn( ways( entry ), 20 ) & fitColumn( entry.risk, 8 ) & entry.verifiedOn
					)
				}
			}
			report.append( "" )
			report.append( "#entries.len()# connectors. Nothing is active until a person connects one. bxAgents connectors show <id> says more." )
			return report.toList( char( 10 ) )
		} )
	}

	/**
	 * @catalog The ConnectorCatalog
	 * @words What came after `show`
	 */
	private struct function showEntry( required any catalog, required array words ) {
		if ( arguments.words.len() != 1 ) {
			throw( type = "BxAgents.MissingConnector", message = "Say which one: bxAgents connectors show <id>. The ids are: #arguments.catalog.ids().toList( ', ' )#" )
		}
		var entry = arguments.catalog.get( arguments.words[ 1 ] )
		if ( !entry.count() ) {
			throw( type = "BxAgents.UnknownConnector", message = "There is no connector [#arguments.words[ 1 ]#]. The ids are: #arguments.catalog.ids().toList( ', ' )#" )
		}
		return asJson( entry, () => {
			var report = [
				"#entry.name# (#entry.id#)",
				entry.summary,
				"",
				entry.transport == "http" ? "Address:  #entry.url#" : "Command:  #entry.command.toList( ' ' )#  (needs #entry.requires.program# on the PATH)",
				"Group:    #entry.category#",
				"Risk:     #entry.risk#. #entry.riskNote#",
				"Docs:     #entry.docs#",
				"Checked:  #entry.verifiedOn#",
				"",
				"How a person gets in:"
			]
			for ( var method in entry.auth ) {
				report.append( "  " & describeMethod( method, entry ) )
			}
			if ( entry.options.len() ) {
				report.append( "" )
				report.append( "Options:" )
				for ( var setting in entry.options ) {
					report.append( "  #setting.key# (#setting.type#, sent as #setting.target# #setting.name#" & ( len( toString( setting.default ) ) && setting.default != false ? ", default #setting.default#" : "" ) & ")  #setting.help#" )
				}
			}
			return report.toList( char( 10 ) )
		} )
	}

	/**
	 * @return exit code 0 when every file passes, 1 otherwise
	 */
	private struct function check( required any catalog ) {
		var result = arguments.catalog.check()
		if ( isOptionSet( "json" ) ) {
			return exitWith( result.ok ? 0 : 1, jsonSerialize( result ) )
		}
		if ( result.ok ) {
			return done( "#result.count# connectors checked, no problems. (#arguments.catalog.folder()#)" )
		}
		var report = []
		for ( var problem in result.errors ) {
			report.append( ( len( problem.file ) ? problem.file : "catalog" ) & ( len( problem.field ) ? " [#problem.field#]" : "" ) & ": " & problem.message )
		}
		report.append( "" )
		report.append( "#result.errors.len()# problem#result.errors.len() == 1 ? '' : 's'# found. #result.count# of the files pass." )
		return exitWith( 1, report.toList( char( 10 ) ) )
	}

	/**
	 * @entry One connector
	 *
	 * @return Its ways in, in words
	 */
	private string function ways( required struct entry ) {
		return arguments.entry.auth.map( method => method.type == "oauth" ? "sign in" : ( method.type == "bearer" ? "token" : "no sign in" ) ).toList( ", " )
	}

	/**
	 * @method One auth method of a connector
	 * @entry The connector it belongs to
	 *
	 * @return One line that says what it is
	 */
	private string function describeMethod( required struct method, required struct entry ) {
		switch ( arguments.method.type ) {
			case "oauth":
				var scopes = arguments.method.scopes ?: []
				var own = ( arguments.method.app ?: "" ) == "own"
				return "Sign in" & ( own ? " through an app of your own (an admin sets #arguments.method.envVars.clientId#" & ( arguments.method.envVars.keyExists( 'clientSecret' ) ? " and #arguments.method.envVars.clientSecret#" : "" ) & ")" : "" ) & ( scopes.len() ? " (asks for #scopes.toList( ', ' )#)" : "" ) & ". Each person signs in once and the agent acts as them." & ( own ? " #arguments.method.help#" : "" )
			case "bearer":
				var header = len( arguments.method.header ?: "" ) ? " Sent in the #arguments.method.header# header." : ""
				return "A token in #arguments.method.envVar#.#header# " & arguments.method.help
			default:
				return arguments.entry.transport == "http" ? "None. It is a public server: a person switches it on for themselves." : "None. It runs on the machine the agent runs on."
		}
	}

	/**
	 * A column that cuts a long text, so it never pushes the columns, which padRight() does without the dot.
	 */
	private string function fitColumn( required string text, required numeric width ) {
		var cut = len( arguments.text ) > arguments.width - 1 ? left( arguments.text, arguments.width - 2 ) & "." : arguments.text
		return cut & repeatString( " ", arguments.width - len( cut ) )
	}

}
