/**
 * `clean` CLI verb - recursively removes a project's `.build/` and `dist/`
 * output directories, without touching anything else (source conventions,
 * Agent.bx, etc. are never touched).
 */
class {

	/**
	 * @options { projectRoot (required, absolute path) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`clean` requires a project root" )
		}

		var root = projectRoot.reReplace( "[\/]+$", "" )
		var removed = []

		for ( var folder in [ ".build", "dist" ] ) {
			var path = root & "/" & folder
			if ( directoryExists( path ) ) {
				directoryDelete( path, true )
				removed.append( folder )
			}
		}

		return {
			exitCode : 0,
			message  : removed.len() ? "Removed: #removed.toList( ', ' )#" : "Nothing to clean"
		}
	}

}
