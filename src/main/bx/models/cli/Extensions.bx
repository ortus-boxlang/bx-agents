/**
 * `extensions` CLI verb: the extensions a project's chat would load, and installing more of them.
 *
 *   bxAgents extensions [--json]                     what the chat loads, where each came from and what it added
 *   bxAgents extensions list [--installed] [--json]  the same; with --installed, what `install` put in place and whether it is intact
 *   bxAgents extensions install <source> [--name=] [--system] [--force] [--yes]
 *   bxAgents extensions install                      restore what extensions.lock.json lists and the disk lacks
 *   bxAgents extensions update [name...] [--yes]     fetch what is not pinned again and replace what changed
 *   bxAgents extensions remove <name> [--system] [--force]
 *   bxAgents extensions link <folder-or-.bx> [--name=] [--force]   link one you are working on into ~/.bxagents/extensions
 *   bxAgents extensions unlink <name>                              take the link away, never what it points at
 *
 * A source is a folder, a .zip, a GitHub repository (owner/repo, owner/repo#ref or its URL), a .zip address or a
 * ForgeBox package (slug or slug@version); see ExtensionOrigin. They go in the project's extensions/ folder, or with
 * --system in ~/.bxagents/extensions for the terminal chat on this machine. An extension is code, so an install shows
 * what the package adds and asks before it places anything (--yes answers for you, and is needed without a terminal).
 *
 * The user layer (~/.bxagents/extensions) is included in what is listed: it is what the terminal chat on this machine loads.
 */
class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "extensions",
			group : "CONNECT & EXTEND",
			position : 4,
			description : "Install and manage CLI and chat extensions",
			usage : "[action] [source-or-name] [options]",
			actions : [ { name : "list" }, { name : "install" }, { name : "update" }, { name : "remove" }, { name : "link" }, { name : "unlink" } ],
			options : [
				{ name : "name", display : "--name=<name>", description : "Name for an installed or linked extension.", takesValue : true },
				{ name : "installed", description : "List installed extension packages." },
				{ name : "system", description : "Manage system-wide extension packages." },
				{ name : "force", description : "Allow replacement or removal when needed." },
				{ name : "yes", description : "Approve installation or update without prompting." },
				{ name : "json", description : "Print results as JSON." }
			],
			examples : [ "extensions", "extensions list --installed", "extensions link ./my-extension" ],
			note : "Sources can be a folder, ZIP, GitHub repository, URL, or ForgeBox slug.",
			subcommand : true,
			// the first word is an action, or else the folder of a project (how this verb used to be pointed at one)
			dispatch : false
		}
	}

	/**
	 * @options {
	 *   projectRoot (required), _positionals ([ subcommand, ... ]), json, installed, system, force, yes, name,
	 *   _interactive / _prompter / _fetcher / _userConfig (test seams)
	 * }
	 */
	function handle() {
		var folder = projectRoot()
		var words = option( "_positionals", [] )
		var actions = meta().actions.map( entry => entry.name )
		var action = words.len() ? lCase( words[ 1 ] ) : ""
		if ( len( action ) && !actions.contains( action ) ) {
			// `extensions <path>` is how this verb used to be pointed at a project
			if ( !directoryExists( words[ 1 ] ) ) {
				throw( type = "BxAgents.UnknownSubcommand", message = "Unknown subcommand [#action#]. Use: #actions.toList( ', ' )#, or none to see what is loaded." )
			}
			folder = words[ 1 ].reReplace( "[\\/]+$", "" )
			action = ""
		}
		switch ( action ) {
			case "install":
				return installExtensions( folder, words.slice( 2 ) )
			case "update":
				return updateExtensions( folder, words.slice( 2 ) )
			case "remove":
				return removeExtension( folder, words.slice( 2 ) )
			case "link":
				return linkExtension( words.slice( 2 ) )
			case "unlink":
				return unlinkExtension( words.slice( 2 ) )
			case "list":
				if ( isOptionSet( "installed" ) ) {
					return listInstalled( folder )
				}
		}
		return listLoaded( folder )
	}

	// ----------------------------------------------------------------------------------
	// What is loaded
	// ----------------------------------------------------------------------------------

	private struct function listLoaded( required string folder ) {
		var service = new "models.extensions.ExtensionService@bxagents"( projectRoot : arguments.folder )
		service.install( new "models.chat.commands.CommandCatalog@bxagents"().standard() )
		var report = service.report()
		try {
			return asJson( { extensions : report, problems : service.problems() }, () => loadedText( report, service.problems() ) )
		} finally {
			service.unload()
		}
	}

	private string function loadedText( required array report, required array problems ) {
		if ( !arguments.report.len() ) {
			return "No extensions. Add one as a file or folder in extensions/ (or ~/.bxagents/extensions for yourself)."
		}
		var text = []
		for ( var extension in arguments.report ) {
			text.append( "#extension.name# (#extension.layer#, #extension.state#)" & ( len( extension.description ) ? " - #extension.description#" : "" ) )
			if ( extension.commands.len() ) {
				text.append( "    commands:   #extension.commands.toList( ', ' )#" )
			}
			if ( extension.keys.len() ) {
				text.append( "    keys:       #extension.keys.toList( ', ' )#" )
			}
			if ( extension.status.len() ) {
				text.append( "    status:     #extension.status.toList( ', ' )#" )
			}
			if ( extension.prefixes.len() ) {
				text.append( "    prefixes:   #extension.prefixes.toList( ', ' )#" )
			}
			if ( extension.sources.len() ) {
				text.append( "    sources:    #extension.sources.map( n => '@' & n & ':' ).toList( ', ' )#" )
			}
			if ( extension.verbs.len() ) {
				text.append( "    verbs:      #extension.verbs.toList( ', ' )#" )
			}
			if ( extension.slots.len() ) {
				text.append( "    slots:      #extension.slots.toList( ', ' )#" )
			}
			if ( extension.web ) {
				text.append( "    web files:  web/" )
			}
			if ( extension.listens.len() ) {
				text.append( "    listens to: #extension.listens.toList( ', ' )#" )
			}
			if ( extension.schedulers.len() ) {
				text.append( "    schedulers: #extension.schedulers.toList( ', ' )#" )
			}
			for ( var problem in extension.problems ) {
				text.append( "    ! #problem#" )
			}
		}
		for ( var problem in arguments.problems ) {
			text.append( "! #problem#" )
		}
		return text.toList( char( 10 ) )
	}

	private struct function listInstalled( required string folder ) {
		var found = installerFor( arguments.folder ).installed()
		var links = isOptionSet( "system" ) ? linker().linked() : []
		return asJson( { installed : found, linked : links }, () => {
			var text = found.map( e => "#e.name# (#e.state#) - #e.source#" & ( len( e.resolved ) ? " #e.resolved#" : "" ) )
			text.append( links.map( l => "#l.name# (#l.state#) - #l.target#" ), true )
			return text.len() ? text.toList( char( 10 ) ) : "Nothing was installed with bxAgents extensions install."
		} )
	}

	// ----------------------------------------------------------------------------------
	// Installing
	// ----------------------------------------------------------------------------------

	private any function installerFor( required string folder ) {
		var scope = isOptionSet( "system" ) ? "system" : "project"
		var userConfig = option( "_userConfig", "" )
		if ( !isObject( userConfig ) ) {
			userConfig = new "models.cli.UserConfig@bxagents"()
		}
		var workingDirectory = getSystemSetting( "user.dir", arguments.folder )
		var fetcher = option( "_fetcher", "" )
		if ( isSimpleValue( fetcher ) && !len( fetcher ) ) {
			return new "models.extensions.ExtensionInstaller@bxagents"( projectRoot : arguments.folder, scope : scope, userConfig : userConfig, workingDirectory : workingDirectory )
		}
		return new "models.extensions.ExtensionInstaller@bxagents"( projectRoot : arguments.folder, scope : scope, userConfig : userConfig, fetcher : fetcher, workingDirectory : workingDirectory )
	}

	/**
	 * @return { confirm : function( preview ), close : function() }: asks at a terminal, says yes for --yes, and refuses without either
	 */
	private struct function asker() {
		var factory = new "models.wizard.prompters.PrompterFactory@bxagents"()
		var yes = isOptionSet( "yes" )
		var interactive = variables.options.keyExists( "_interactive" ) ? variables.options._interactive : factory.isTerminal()
		var prompter = ""
		if ( !yes && interactive ) {
			prompter = variables.options.keyExists( "_prompter" ) ? variables.options._prompter : factory.create( variables.options, "extensions" )
		}
		var shown = []
		return {
			shown   : shown,
			confirm : ( preview ) => {
				var text = previewLines( preview )
				if ( isObject( prompter ) ) {
					prompter.note( preview.update ? "Update #preview.name#" : "Install #preview.name#", text )
					return prompter.confirm( preview.update ? "Replace #preview.name# with this?" : "Install it?", "", false )
				}
				if ( !yes ) {
					throw( type = "BxAgents.ConfirmationNeeded", message = "An extension is code that runs when the chat starts, so this asks first, and there is no terminal to ask in. Look at what it adds below, and run it again with --yes if that is fine." & char( 10 ) & text.toList( char( 10 ) ) )
				}
				shown.append( text, true )
				return true
			},
			close   : () => {
				if ( isObject( prompter ) ) {
					prompter.close()
				}
			}
		}
	}

	private array function previewLines( required struct preview ) {
		var text = [
			( preview.update ? "Update " : "Install " ) & preview.name & " from " & preview.source & ( len( preview.resolved ) ? " (#preview.resolved#)" : "" ),
			"Into: #preview.into# (#preview.scope# scope)#preview.replaces ? ', replacing what is there' : ''#",
			"#preview.files# file#preview.files == 1 ? '' : 's'#, #numberFormat( preview.bytes / 1024, '0.0' )# KB"
		]
		if ( preview.adds.len() ) {
			text.append( "It adds:" )
			text.append( preview.adds.map( a => "  - " & a ), true )
		} else {
			text.append( "Nothing it adds could be read from its files (it may add things in code)." )
		}
		if ( preview.mentions.len() ) {
			text.append( "Its code mentions: #preview.mentions.toList( ', ' )# (a quick look at the text, not a review)." )
		}
		text.append( "An extension is code: it runs when the chat or the app starts." )
		return text
	}

	private struct function installExtensions( required string folder, required array words ) {
		var installer = installerFor( arguments.folder )
		if ( !arguments.words.len() ) {
			var restored = installer.restore()
			var report = restored.restored.map( n => "Restored #n#" )
			report.append( restored.failed.map( f => "Could not restore #f.name#: #f.reason#" ), true )
			if ( !report.len() ) {
				report = [ "Nothing to restore: everything in #getFileFromPath( installer.lockFile() )# is in place." ]
			}
			return exitWith( restored.failed.len() ? 1 : 0, report.toList( char( 10 ) ) )
		}
		var ask = asker()
		try {
			var result = installer.install( arguments.words[ 1 ], { name : option( "name" ), force : option( "force", false ), confirm : ask.confirm } )
		} finally {
			ask.close()
		}
		if ( !result.installed ) {
			return fail( "Cancelled. Nothing was installed." )
		}
		var preview = ask.shown.len() ? ask.shown.toList( char( 10 ) ) & char( 10 ) : ""
		return done( preview & "Installed #result.name# into #result.preview.into#. Use /reload in a chat, or start it again, to load it." )
	}

	private struct function updateExtensions( required string folder, required array words ) {
		var installer = installerFor( arguments.folder )
		var ask = asker()
		try {
			var results = installer.update( arguments.words, ask.confirm )
		} finally {
			ask.close()
		}
		if ( !results.len() ) {
			return done( "Nothing is installed." )
		}
		var report = results.map( r => r.name & ": " & r.outcome & ( len( r.reason ) ? " (#r.reason#)" : "" ) )
		return exitWith( results.filter( r => r.outcome == "failed" ).len() ? 1 : 0, report.toList( char( 10 ) ) )
	}

	private struct function removeExtension( required string folder, required array words ) {
		if ( !arguments.words.len() ) {
			throw( type = "BxAgents.MissingName", message = "Say which one: bxAgents extensions remove <name>" )
		}
		installerFor( arguments.folder ).remove( arguments.words[ 1 ], option( "force", false ) )
		return done( "Removed #arguments.words[ 1 ]#." )
	}

	// ----------------------------------------------------------------------------------
	// Linking, for the extension you are working on
	// ----------------------------------------------------------------------------------

	private any function linker() {
		var userConfig = option( "_userConfig", "" )
		return new "models.extensions.ExtensionLinker@bxagents"( userConfig : isObject( userConfig ) ? userConfig : new "models.cli.UserConfig@bxagents"() )
	}

	private struct function linkExtension( required array words ) {
		if ( !arguments.words.len() ) {
			throw( type = "BxAgents.MissingSource", message = "Say what to link: bxAgents extensions link <folder-or-.bx file>" )
		}
		var made = linker().link( arguments.words[ 1 ], option( "name" ), option( "force", false ) )
		return done( "Linked #made.name#: #made.link# -> #made.target#. It loads in the terminal chat on this machine; use /reload after an edit." )
	}

	private struct function unlinkExtension( required array words ) {
		if ( !arguments.words.len() ) {
			throw( type = "BxAgents.MissingName", message = "Say which one: bxAgents extensions unlink <name>" )
		}
		linker().unlink( arguments.words[ 1 ] )
		return done( "Unlinked #arguments.words[ 1 ]#. What it pointed at is untouched." )
	}

}
