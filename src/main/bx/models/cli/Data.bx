/**
 * `data` CLI verb: where the agent keeps everything, how big each part is, and the volumes it may use.
 *
 *   bxAgents data [--json]
 */
import bxModules.bxagents.models.util.ByteSize;

class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "data",
			group : "OPERATE & SHIP",
			position : 3,
			description : "Locate the data home and its volumes",
			usage : "[options]",
			options : [
				{ name : "json", description : "Print data-home details as JSON." }
			],
			examples : [ "data" ],
			reference : "data-backup-and-restore"
		}
	}

	function handle() {
		var found = new "models.data.ProjectData@bxagents"().of( projectRoot() )
		var info = found.home.describe()
		var volumes = found.volumes.listing()
		var forJson = duplicate( info )
		forJson[ "volumes" ] = volumes
		return asJson( forJson, () => describeText( info, volumes ) )
	}

	/**
	 * @info What the data home holds
	 * @volumes The volumes the agent can reach
	 *
	 * @return The report a person reads
	 */
	private string function describeText( required struct info, required array volumes ) {
		var report = [
			"Data home: #arguments.info.home#  (#sourceText( arguments.info.source )#)",
			"Database:  #arguments.info.database#",
			""
		]
		for ( var item in arguments.info.items ) {
			report.append( "  " & padRight( item.name, 10 ) & right( repeatString( " ", 9 ) & ByteSize::format( item.bytes ), 9 ) & "   #item.files# #item.files == 1 ? 'file' : 'files'#" )
		}
		report.append( "" )
		report.append( "Volumes:" )
		for ( var volume in arguments.volumes ) {
			report.append( "  " & padRight( volume.name, 12 ) & padRight( volume.mode == "rw" ? "read and write" : "read only", 16 ) & volume.description )
		}
		return report.toList( char( 10 ) )
	}

	private string function sourceText( required string source ) {
		switch ( arguments.source ) {
			case "environment":
				return "from BXAGENTS_HOME"
			case "setting":
				return "from data.home in Agent.yml"
			case "database":
				return "beside the database named by BXAGENTS_DB"
			case "project":
				return "data/ in the project, which already holds a chat.db"
			case "convention":
				return "the convention, ~/.bxagents/<agent name>"
			default:
				return "data/ in the project: the agent has no name, so give it one or set BXAGENTS_HOME or data.home"
		}
	}

}
