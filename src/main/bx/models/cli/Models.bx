/**
 * `models` CLI verb - the models a project can talk to, and whether they answer.
 *
 *   bxAgents models list [--json]
 *   bxAgents models test [--profile=NAME | --all] [--json]
 *
 * `list` shows the default model and every profile with what the project says about each (context window,
 * image support) and whether its API key is set. `test` sends each model one tiny question through bx-ai and
 * says whether it answered and how long it took, so a wrong key or model name shows before a chat does. It tests
 * the default model, one profile with --profile, or all of them with --all, and exits 1 when any does not answer.
 *
 * Both need a built project: the models are the ones the built app carries.
 */
import bxModules.bxagents.models.cli.support.CliTable;

class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "models",
			group : "MANAGE YOUR AGENT",
			position : 1,
			description : "List and test models",
			usage : "<action> [options]",
			actions : [ { name : "list" }, { name : "test" } ],
			options : [
				{ name : "profile", display : "--profile=<name>", description : "Test one named model profile.", takesValue : true },
				{ name : "all", description : "Test the default model and every profile." },
				{ name : "json", description : "Print results as JSON." }
			],
			examples : [ "models list", "models test --all" ],
			note : "Uses the last build. Testing models makes real provider calls.",
			subcommand : true
		}
	}

	function handleList() {
		var rows = known( loadConversation() )
		return asJson( rows, () => listText( rows ) )
	}

	function handleTest() {
		var chat = loadConversation()
		var rows = known( chat )
		var wanted = trim( option( "profile" ) )
		var chosen = rows
		if ( len( wanted ) ) {
			chosen = rows.filter( r => r.name == wanted )
			if ( !chosen.len() ) {
				throw( type = "BxAgents.UnknownProfile", message = "There is no profile [#wanted#]. Try `bxAgents models list`." )
			}
		} else if ( !isOptionSet( "all" ) ) {
			chosen = [ rows[ 1 ] ]
		}
		var results = []
		for ( var row in chosen ) {
			// the default model is tested through the agent's own, a profile through its name
			var outcome = chat.ping( row.name == "default" ? "" : row.name )
			results.append( { name : row.name, model : outcome.model, ok : outcome.ok, ms : outcome.ms ?: 0, detail : outcome.ok ? outcome.reply : outcome.reason } )
		}
		var exitCode = results.filter( r => !r.ok ).len() ? 1 : 0
		if ( isOptionSet( "json" ) ) {
			return exitWith( exitCode, jsonSerialize( results ) )
		}
		var data = results.map( r => [ r.name, r.model, r.ok ? "ok" : "FAILED", r.ok ? "#r.ms# ms" : r.detail ] )
		return exitWith( exitCode, CliTable::render( headers = [ "Profile", "Model", "Status", "Time" ], rows = data, alignRight = [ 4 ] ) )
	}

	/**
	 * @return The agent's conversation, loaded from its build
	 */
	private any function loadConversation() {
		var loader = new "models.cli.support.BuiltAgent@bxagents"()
		if ( !loader.isBuilt( projectRoot() ) ) {
			throw( type = "BxAgents.NotBuilt", message = "No build found at [#projectRoot()#/.build] - run `build` first" )
		}
		return new "models.chat.AgentConversation@bxagents"( loader.load( projectRoot() ), "cli" )
	}

	/**
	 * @return [ { name, model, contextWindow, vision, hasApiKey, isDefault } ]: the app's default model, then the profiles
	 */
	private array function known( required any chat ) {
		var facts = new "models.runtime.ModelFacts@bxagents"()
		var rows = [ {
			name          : "default",
			model         : arguments.chat.modelName(),
			contextWindow : facts.of( "" ).contextWindow,
			vision        : facts.of( "" ).vision,
			hasApiKey     : true,
			isDefault     : true
		} ]
		for ( var p in arguments.chat.profiles() ) {
			if ( p.name == "default" ) {
				continue
			}
			var about = facts.of( p.name )
			rows.append( {
				name          : p.name,
				model         : p.provider & ( len( p.model ) ? "/" & p.model : "" ),
				contextWindow : about.contextWindow,
				vision        : about.vision,
				hasApiKey     : p.hasApiKey,
				isDefault     : p.isDefault
			} )
		}
		return rows
	}

	private string function listText( required array rows ) {
		var data = arguments.rows.map( r => [ r.name, r.model, r.contextWindow ? numberFormat( r.contextWindow ) : "?", len( r.vision ) ? r.vision : "?", r.hasApiKey ? "set" : "MISSING" ] )
		return CliTable::render( headers = [ "Profile", "Model", "Context", "Images", "Key" ], rows = data, alignRight = [ 3, 4 ] )
	}

}
