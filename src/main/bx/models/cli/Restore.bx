/**
 * `restore` CLI verb: puts a backup back into the data home.
 *
 *   bxAgents restore FILE [--home=DIR] [--force]
 *
 * The database, `files/` and `skills/` are replaced; what was there is kept beside it as <name>.before-restore for one
 * restore. It stops if a server or chat looks to have the database open, unless --force is given.
 */
class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "restore",
			group : "OPERATE & SHIP",
			position : 5,
			description : "Restore a data-home backup",
			usage : "<file> [options]",
			options : [
				{ name : "home", display : "--home=<directory>", description : "Restore into a different data home.", takesValue : true },
				{ name : "force", description : "Allow replacing an existing data home." }
			],
			examples : [ "restore agent-backup.zip" ],
			note : "Existing data is kept as .before-restore.",
			reference : "data-backup-and-restore",
			subcommand : true
		}
	}

	function handle() {
		var file = firstArgument()
		if ( !len( file ) ) {
			throw( type = "BxAgents.MissingBackup", message = "`restore` needs the backup to put back, for example `bxAgents restore backups/backup-20261107-0914.zip`." )
		}
		var data = len( trim( option( "home" ) ) )
			? new "models.data.ProjectData@bxagents"().of( projectRoot(), trim( option( "home" ) ) )
			: new "models.data.ProjectData@bxagents"().of( projectRoot() )
		var restored = new "models.data.DataBackup@bxagents"( data.home ).restore( file, isOptionSet( "force" ) )
		var report = [ "Restored #restored.restored.toList( ', ' )# into #data.home.path()#" ]
		if ( restored.kept.len() ) {
			report.append( "Kept what was there as #restored.kept.toList( ', ' )#. The next restore replaces them." )
		}
		return lines( report )
	}

}
