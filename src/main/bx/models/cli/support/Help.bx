import bxModules.bxagents.models.util.Terminal;
import bxModules.bxagents.models.cli.BaseVerb;

/**
 * The CLI's grouped overview and focused command help. Wrap plain text before applying
 * the shared terminal palette so ANSI escapes never count toward the column width.
 */
class {

	/**
	 * @options Parsed CLI presentation flags, including color
	 * @width Explicit column count, or zero to read COLUMNS (default 80)
	 * @paint Optional (style, text) palette for deterministic rendering
	 * @return This renderer, using plain text outside an interactive terminal
	 */
	function init( struct options = {}, numeric width = 0, any paint ) {
		var columns = arguments.width > 0 ? arguments.width : getSystemSetting( "COLUMNS", "80" )
		variables.width = max( 24, min( 100, isNumeric( columns ) && columns > 0 ? int( columns ) : 80 ) )
		variables.paint = isNull( arguments.paint ) ? ( style, text ) => text : arguments.paint
		if ( isNull( arguments.paint ) && ( arguments.options.color ?: true ) && Terminal::isInteractive() ) {
			var theme = createObject( "java", "ortus.boxlang.bxagents.tui.Theme" ).detect()
			variables.paint = ( style, text ) => theme.paint( style, text )
		}
		return this
	}

	/**
	 * @definitions What each built-in verb says it is: its meta()
	 * @extensions Installed extension commands as {name, description} entries
	 * @return The grouped overview, examples, and global flags
	 */
	string function overview( required array definitions, array extensions = [] ) {
		var out = []
		paragraph( out, "Usage: bxAgents <command> [options]", "bold" )
		var nameWidth = arguments.definitions.reduce( ( width, definition ) => max( width, len( definition.name ) ), 0 )
		for ( var title in BaseVerb::GROUPS ) {
			var inGroup = arguments.definitions.filter( definition => definition.group == title ).sort( ( a, b ) => a.position - b.position )
			heading( out, title )
			rows( out, inGroup.map( definition => [ definition.name, definition.description ] ), nameWidth )
		}
		if ( arguments.extensions.len() ) {
			heading( out, "FROM EXTENSIONS" )
			rows( out, arguments.extensions.map( entry => [ entry.name, entry.description ] ) )
		}
		heading( out, "EXAMPLES" )
		for ( var example in [ "new my-agent", "build", "chat" ] ) {
			paragraph( out, "bxAgents " & example, "bold", 2 )
		}
		globalOptions( out )
		heading( out, "LEARN MORE" )
		paragraph( out, "bxAgents <command> --help", "bold", 2 )
		paragraph( out, "Also: bxAgents help <command>", "muted", 2 )
		paragraph( out, "https://bxagents.ai", "muted", 2 )
		return out.toList( char( 10 ) )
	}

	/**
	 * @definition What the verb says it is: its meta()
	 * @return Focused usage, options, examples, and reference link
	 */
	string function command( required struct definition ) {
		var entry = arguments.definition
		var out = []
		paragraph( out, "bxAgents " & entry.name, "bold" )
		paragraph( out, entry.description )
		heading( out, "USAGE" )
		paragraph( out, "bxAgents #entry.name# #entry.usage#", "bold", 2 )
		if ( entry.actions.len() ) {
			heading( out, entry.actionsHeading )
			paragraph( out, entry.actions.map( action => action.name ).toList( ", " ), "plain", 2 )
		}
		var shown = entry.options.filter( option => !option.hidden ).map( option => [ option.display, option.description ] )
		if ( shown.len() ) {
			heading( out, entry.optionsHeading )
			rows( out, shown )
		}
		if ( len( entry.note ) ) {
			out.append( "" )
			paragraph( out, entry.note, "plain", 2 )
		}
		heading( out, "EXAMPLES" )
		for ( var example in entry.examples ) {
			paragraph( out, "bxAgents " & example, "bold", 2 )
		}
		globalOptions( out, false )
		heading( out, "FULL REFERENCE" )
		paragraph( out, "https://bxagents.ai/cli-reference###entry.reference#", "muted", 2 )
		paragraph( out, "bxAgents --help lists all commands.", "muted", 2 )
		return out.toList( char( 10 ) )
	}

	/**
	 * @out Output lines to append to
	 * @overview Include --version, which is only handled before a command
	 */
	private void function globalOptions( required array out, boolean overview = true ) {
		heading( arguments.out, "GLOBAL OPTIONS" )
		var options = [
			[ "-h, --help", "Show help without running a command." ],
			[ "--projectRoot=<path>", "Use another project directory." ],
			[ "--no-color", "Disable color and bold styling." ],
			[ "--no-banner", "Hide the overview's logo." ]
		]
		if ( arguments.overview ) {
			options.prepend( [ "-v, --version", "Show the version; use before any command." ] )
		}
		rows( arguments.out, options )
		paragraph( arguments.out, "Pass values as --flag=value, not --flag value.", "muted", 2 )
	}

	/**
	 * @out Output lines to append to
	 * @title Section heading to emphasize in bold brand cyan
	 */
	private void function heading( required array out, required string title ) {
		arguments.out.append( "" )
		arguments.out.append( variables.paint( "bold", variables.paint( "accent", arguments.title ) ) )
	}

	/**
	 * @out Output lines to append to
	 * @entries Pairs of emphasized labels and muted descriptions
	 * @nameWidth Shared label width, or zero to measure this section
	 */
	private void function rows( required array out, required array entries, numeric nameWidth = 0 ) {
		var widest = arguments.nameWidth > 0 ? arguments.nameWidth : arguments.entries.reduce( ( w, entry ) => max( w, len( entry[ 1 ] ) ), 0 )
		var column = min( widest + 4, int( variables.width / 2 ) )
		for ( var entry in arguments.entries ) {
			if ( len( entry[ 1 ] ) + 4 > column ) {
				paragraph( arguments.out, entry[ 1 ], "bold", 2 )
				paragraph( arguments.out, entry[ 2 ], "muted", 4 )
				continue
			}
			var description = wrap( entry[ 2 ], variables.width - column, true ).listToArray( char( 10 ) & char( 13 ) )
			arguments.out.append( "  " & variables.paint( "bold", entry[ 1 ] ) & repeatString( " ", column - len( entry[ 1 ] ) - 2 ) & variables.paint( "muted", description[ 1 ] ) )
			for ( var i = 2; i <= description.len(); i++ ) {
				arguments.out.append( repeatString( " ", column ) & variables.paint( "muted", description[ i ] ) )
			}
		}
	}

	/**
	 * @out Output lines to append to
	 * @text Plain text to wrap before painting
	 * @style Shared palette style
	 * @indent Hanging indentation in columns
	 */
	private void function paragraph( required array out, required string text, string style = "plain", numeric indent = 0 ) {
		for ( var line in wrap( arguments.text, variables.width - arguments.indent, true ).listToArray( char( 10 ) & char( 13 ) ) ) {
			arguments.out.append( repeatString( " ", arguments.indent ) & variables.paint( arguments.style, line ) )
		}
	}

}
