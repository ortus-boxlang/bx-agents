import bxModules.bxagents.models.util.Terminal;

/**
 * The CLI's grouped overview and focused command help. Wrap plain text before applying
 * the shared terminal palette so ANSI escapes never count toward the column width.
 */
class {

	static {
		GROUPS = [
			{ title : "GET STARTED", commands : [ "new", "add", "doctor", "inspect" ] },
			{ title : "BUILD & RUN", commands : [ "build", "chat", "invoke", "serve", "test", "clean" ] },
			{ title : "MANAGE YOUR AGENT", commands : [ "models", "sessions", "notes", "routines" ] },
			{ title : "CONNECT & EXTEND", commands : [ "connect", "connectors", "skills", "extensions" ] },
			{ title : "SECURITY & ACCESS", commands : [ "users", "token", "embed", "vault", "hash-password" ] },
			{ title : "OPERATE & SHIP", commands : [ "logs", "stats", "data", "backup", "restore", "package", "deploy" ] }
		]
		COMMANDS = {
			"new" : {
				usage : "<directory> [options]",
				options : [
					[ "--model=<provider/model>", "Model to use; omit to open the wizard." ],
					[ "--template=<name>", "Starter template. Default: minimal." ],
					[ "--name=<name>", "Agent name. Defaults to the directory name." ],
					[ "--description=<text>", "What the agent does." ],
					[ "--repo=<owner/repo>", "Start from a GitHub repository." ],
					[ "--forgebox=<slug>", "Start from a ForgeBox package." ],
					[ "--class", "Use Agent.bx instead of Agent.yml." ],
					[ "--skipInstall", "Skip fetching TestBox with CommandBox." ],
					[ "--no-tui", "Use plain terminal prompts." ]
				],
				examples : [ "new my-agent", "new my-agent --model=mock/mock-model" ]
			},
			"add" : {
				usage : "[kind] [name] [options]",
				actions : "tool, skill, gateway, subagent, schedule, mcp, interceptor, profile, provider, capability, extension",
				options : [
					[ "--agent=<name>", "Add to a subagent rather than the root agent." ],
					[ "--dry-run", "Preview files without writing them." ],
					[ "--force", "Allow replacing an existing file." ],
					[ "--yes", "Use defaults without prompting." ]
				],
				examples : [ "add", "add tool Greeter --dry-run", "add gateway web" ],
				note : "Each kind has its own settings; see the full reference below."
			},
