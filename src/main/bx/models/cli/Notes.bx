/**
 * `notes` CLI verb - the notes of an agent, kept in the project's shared chat database
 * (`data/chat.db`, or the file named by BXAGENTS_DB).
 *
 *   bxAgents notes list [--scope=user|agent] [--user=NAME] [--json]
 *   bxAgents notes add --text="Prefers short answers" [--scope=user|agent] [--user=NAME]
 *   bxAgents notes edit --id=<id> --text="new text" [--scope=...] [--user=NAME]
 *   bxAgents notes remove --id=<id> [--scope=...] [--user=NAME]
 *   bxAgents notes clear [--scope=user|agent] [--user=NAME]   removes every note of the scope
 *   bxAgents notes stats [--user=NAME] [--json]
 *   bxAgents notes export [--file=notes.json]
 *   bxAgents notes import --file=notes.json
 *
 * The scope defaults to the notes about the user, the user to the operating system user. The notes of the
 * agent belong to the agent's name in Agent.yml. Limits come from the agent's `notes` block.
 */
import bxModules.bxagents.models.api.Caller;

class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "notes",
			group : "MANAGE YOUR AGENT",
			position : 3,
			description : "Manage saved notes",
			usage : "<action> [options]",
			actions : [ { name : "list" }, { name : "add" }, { name : "edit" }, { name : "remove" }, { name : "clear" }, { name : "stats" }, { name : "export" }, { name : "import" } ],
			options : [
				{ name : "text", display : "--text=<text>", description : "Note text for add or edit.", takesValue : true },
				{ name : "id", display : "--id=<id>", description : "Note to edit or remove.", takesValue : true },
				{ name : "scope", display : "--scope=<user|agent>", description : "Which notes to manage.", takesValue : true },
				{ name : "user", display : "--user=<name>", description : "User whose notes to manage.", takesValue : true },
				{ name : "file", display : "--file=<path>", description : "File to export or import.", takesValue : true },
				{ name : "json", description : "Print results as JSON." }
			],
			examples : [ "notes list", "notes export --file=notes.json" ],
			subcommand : true
		}
	}

	function handleList() {
		var context = setup()
		var wanted = trim( option( "scope", "" ) )
		var scopes = len( wanted ) ? [ lCase( wanted ) ] : [ "user", "agent" ]
		var shown = {}
		var report = []
		for ( var scope in scopes ) {
			var owner = scope == "agent" ? context.agentName : context.user
			shown[ scope ] = { owner : owner, notes : context.provider.list( scope, owner ), stats : context.provider.stats( scope, owner ) }
			report.append( context.report.listLines( scope == "agent" ? "Agent notes (#owner#)" : "Notes about #owner#", shown[ scope ].notes, shown[ scope ].stats ), true )
		}
		return asJson( shown, report.toList( char( 10 ) ) )
	}

	function handleStats() {
		var context = setup()
		var all = { provider : "sqlite", user : context.provider.stats( "user", context.user ), agent : context.provider.stats( "agent", context.agentName ) }
		return asJson( all, () => context.report.statsLines( all ).toList( char( 10 ) ) )
	}

	function handleAdd() {
		var context = setup()
		var text = trim( option( "text" ) )
		if ( !len( text ) ) {
			throw( type = "BxAgents.MissingNoteText", message = "`notes add` needs --text=<the note>" )
		}
		return outcome( context.provider.add( context.scope, context.owner, text, "cli" ), "Noted (#context.scope#)." )
	}

	function handleEdit() {
		var context = setup()
		var id = trim( option( "id" ) )
		var newText = trim( option( "text" ) )
		if ( !len( id ) || !len( newText ) ) {
			throw( type = "BxAgents.MissingNoteText", message = "`notes edit` needs --id=<id> and --text=<the new text>" )
		}
		return outcome( context.provider.replace( context.scope, context.owner, id, newText ), "Updated." )
	}

	function handleRemove() {
		var context = setup()
		var id = trim( option( "id" ) )
		if ( !len( id ) ) {
			throw( type = "BxAgents.MissingNoteId", message = "`notes remove` needs --id=<id> (see `bxAgents notes list`)." )
		}
		return context.provider.remove( context.scope, context.owner, id )
			? done( "Removed." )
			: fail( "There is no #context.scope# note with id [#id#]." )
	}

	function handleClear() {
		var context = setup()
		var removed = 0
		for ( var held in context.provider.list( context.scope, context.owner ) ) {
			if ( context.provider.remove( context.scope, context.owner, held.id ) ) {
				removed++
			}
		}
		return done( "Cleared #removed# #context.scope# note#removed == 1 ? '' : 's'#." )
	}

	function handleExport() {
		var context = setup()
		var data = {
			"user"  : { "owner" : context.user, "notes" : context.provider.list( "user", context.user ).map( n => n.text ) },
			"agent" : { "owner" : context.agentName, "notes" : context.provider.list( "agent", context.agentName ).map( n => n.text ) }
		}
		var json = jsonSerialize( data )
		var target = trim( option( "file" ) )
		if ( !len( target ) ) {
			return done( json )
		}
		fileWrite( target, json )
		return done( "Exported #data.user.notes.len()# user and #data.agent.notes.len()# agent notes to #target#" )
	}

	/**
	 * Adds the notes of an export. A note that is already there is skipped, and a note that does not fit the limit is reported.
	 */
	function handleImport() {
		var context = setup()
		var source = trim( option( "file" ) )
		if ( !len( source ) || !fileExists( source ) ) {
			throw( type = "BxAgents.MissingNotesFile", message = "`notes import` needs --file=<an export made by `notes export`>" )
		}
		var data = jsonDeserialize( fileRead( source ) )
		var added = 0
		var refused = []
		for ( var scope in [ "user", "agent" ] ) {
			var owner = scope == "agent" ? context.agentName : context.user
			for ( var text in ( ( data[ scope ] ?: {} ).notes ?: [] ) ) {
				var result = context.provider.add( scope, owner, text, "import" )
				if ( result.ok ?: false ) {
					added++
				} else {
					refused.append( "#scope#: #left( text, 40 )# (#result.reason ?: 'refused'#)" )
				}
			}
		}
		return exitWith( refused.len() ? 1 : 0, ( [ "Imported #added# note#added == 1 ? '' : 's'#." ].append( refused, true ) ).toList( char( 10 ) ) )
	}

	// ----------------------------------------------------------------------------------

	/**
	 * What every action needs: the notes of this project, who they are about and the scope asked for.
	 */
	private struct function setup() {
		var config = notesConfig()
		var provider = new "models.notes.SqliteNotesProvider@bxagents"( chatStore(), { user : ( config.user ?: {} ).limit ?: 1400, agent : ( config.agent ?: {} ).limit ?: 2200 } )
		var user = len( trim( option( "user" ) ) ) ? trim( option( "user" ) ) : Caller::localId()
		var agentName = configuredAgentName()
		var scope = lCase( trim( option( "scope", "user" ) ) )
		if ( !listFindNoCase( "user,agent", scope ) ) {
			throw( type = "BxAgents.InvalidNotesScope", message = "--scope must be user or agent." )
		}
		return {
			provider  : provider,
			user      : user,
			agentName : agentName,
			scope     : scope,
			owner     : scope == "agent" ? agentName : user,
			report    : new "models.notes.NotesReport@bxagents"()
		}
	}

	private struct function outcome( required struct result, required string message ) {
		return ( arguments.result.ok ?: false )
			? done( arguments.message )
			: fail( arguments.result.reason ?: "That did not work." )
	}

	/**
	 * @return The `notes` block of the project's Agent.yml, empty when there is none
	 */
	private struct function notesConfig() {
		try {
			var agent = new "models.build.AgentYamlLoader@bxagents"().load( projectRoot() & "/Agent.yml" ).config
			return isStruct( agent.notes ?: "" ) ? agent.notes : {}
		} catch ( any e ) {
			return {}
		}
	}

	private string function configuredAgentName() {
		try {
			var agent = new "models.build.AgentYamlLoader@bxagents"().load( projectRoot() & "/Agent.yml" ).config
			return agent.name ?: listLast( projectRoot(), "/" )
		} catch ( any e ) {
			return listLast( projectRoot(), "/" )
		}
	}

}
