/**
 * `build` CLI verb - thin dispatcher over BuildPipeline (M12).
 */
class {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "build",
			group : "BUILD & RUN",
			position : 1,
			description : "Build the application",
			usage : "[options]",
			options : [
				{ name : "environment", display : "--environment=<name>", description : "Apply the named environment override.", takesValue : true },
				{ name : "verbose", description : "Show build phases as they run." },
				{ name : "generatorVersion", display : "--generatorVersion=<version>", description : "Override the generator version in the manifest.", takesValue : true }
			],
			examples : [ "build", "build --environment=production" ],
			note : "Writes the application into .build/. Rebuild after changing project source."
		}
	}


	/**
	 * @options { projectRoot (required, absolute path), environment, generatorVersion, verbose, moduleDir (the module folder to copy into .build/runtime/modules, or "none"; default BXAGENTS_MODULE_DIR, else the installed module) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`build` requires a project root" )
		}

		// --verbose prints each build phase (and what it found/generated - the
		// discovered counts, the WireBox-registered agent names, etc.) live as
		// the build runs, via BuildPipeline's own onProgress callback - useful
		// for debugging a slow or unexpectedly-behaving build. Silent (the
		// callback's own no-op default) otherwise, so this costs nothing when
		// not asked for.
		var verbose = arguments.options.verbose ?: false
		var onProgress = verbose
			? function( required string message ) { println( arguments.message ) }
			: function( required string message ) {}

		// "@bxagents" suffix, not a bare "bxagents.models...." path - see
		// BuildPipeline.bx's init() docblock for why.
		var pipeline = new "models.build.BuildPipeline@bxagents"( arguments.options.generatorVersion ?: "dev" )
		if ( len( arguments.options.moduleDir ?: "" ) ) {
			pipeline.setModuleSource( arguments.options.moduleDir )
		}
		var result = pipeline.build( projectRoot, arguments.options.environment ?: "", onProgress )

		var lines = [ "Build succeeded: #result.appDir#" ]
		for ( var warning in result.warnings ) {
			lines.append( "  ! #warning#" )
		}

		return {
			exitCode : 0,
			message  : lines.toList( char( 10 ) ),
			result   : result
		}
	}

}
