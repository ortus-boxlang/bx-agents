/**
 * `sessions` CLI verb - the conversations in the project's shared chat database (`data/chat.db`, or the file
 * named by BXAGENTS_DB), the same list `chat` and the web page show.
 *
 *   bxAgents sessions list [--user=NAME] [--agent=NAME] [--q=TEXT] [--json]
 *   bxAgents sessions clear --session=<number or id> | --all [--agent=NAME]   forgets the messages, keeps the conversations
 *   bxAgents sessions rename --session=<number or id> --name="New name" [--user=NAME]
 *   bxAgents sessions fork --session=<number or id> [--name="Other approach"] [--user=NAME]
 *   bxAgents sessions delete --session=<number or id> [--user=NAME]
 *   bxAgents sessions export --session=<number or id> [--file=chat.json] [--md] [--force] [--user=NAME]
 *   bxAgents sessions import --file=chat.json [--name="New name"] [--user=NAME]
 *
 * The user defaults to the operating system user. A conversation is picked by its number in `list`, or by its id
 * or the start of it. The messages of a conversation live in the agent's memory, so `fork` (which copies them), `export`,
 * `import` and the clearing part of `delete` need a built project and only reach messages a memory that outlives the
 * process keeps (file, jdbc); `list`, `rename` and the list part of `delete` only touch the database.
 *
 * `export` writes one conversation to a JSON file (or a Markdown transcript with --md) and never overwrites a file
 * without --force. `import` reads such a file and adds it to the user's list as a new conversation: it never replaces
 * one, and a file it does not recognise is refused before anything is written.
 */
import bxModules.bxagents.models.api.Caller;

class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "sessions",
			group : "MANAGE YOUR AGENT",
			position : 2,
			description : "Manage conversations and transcripts",
			usage : "<action> [options]",
			actions : [ { name : "list" }, { name : "rename" }, { name : "fork" }, { name : "delete" }, { name : "clear" }, { name : "export" }, { name : "import" } ],
			options : [
				{ name : "session", display : "--session=<number-or-id>", description : "Conversation to act on.", takesValue : true },
				{ name : "name", display : "--name=<name>", description : "New conversation title.", takesValue : true },
				{ name : "user", display : "--user=<name>", description : "Conversation owner. Default: local.", takesValue : true },
				{ name : "file", display : "--file=<path>", description : "Transcript file to export or import.", takesValue : true },
				{ name : "md", description : "Export a Markdown transcript instead of JSON." },
				{ name : "force", description : "Allow replacing an export file." },
				{ name : "json", description : "Print results as JSON." },
				{ name : "agent", takesValue : true, hidden : true },
				{ name : "q", takesValue : true, hidden : true }
			],
			examples : [ "sessions list", "sessions export --session=1 --file=chat.json" ],
			subcommand : true
		}
	}

	function handleList() {
		var context = setup()
		var rows = context.sessions.search( context.user, { limit : 50, agent : trim( option( "agent" ) ), q : trim( option( "q" ) ) } ).rows
		return asJson( rows, () => listText( rows, context.user ) )
	}

	function handleRename() {
		var context = setup()
		return withSession( context, found => {
			var name = trim( option( "name" ) )
			if ( !len( name ) ) {
				throw( type = "BxAgents.MissingSessionName", message = "`sessions rename` needs --name=<the new name>" )
			}
			context.sessions.rename( context.user, found.id, context.sessions.titleOf( name ) )
			return done( "Renamed to [#context.sessions.titleOf( name )#]." )
		} )
	}

	/**
	 * Copies a conversation's messages, which needs the agent: a built project.
	 */
	function handleFork() {
		var context = setup()
		return withSession( context, found => {
			var loader = new "models.cli.support.BuiltAgent@bxagents"()
			if ( !loader.isBuilt( projectRoot() ) ) {
				return fail( "`sessions fork` copies the messages, which the agent holds: run `bxAgents build` first." )
			}
			var conversation = new "models.chat.AgentConversation@bxagents"( loader.load( projectRoot() ), context.user, context.sessions, found.id )
			var outcome = conversation.fork( trim( option( "name" ) ) )
			return outcome.ok
				? done( "Forked as [#outcome.title#] (#left( outcome.id, 8 )#): #outcome.messages# messages copied." )
				: fail( outcome.reason )
		} )
	}

	/**
	 * Removes a conversation from the list and, when the project is built, forgets its messages too.
	 */
	function handleDelete() {
		var context = setup()
		return withSession( context, found => {
			var loader = new "models.cli.support.BuiltAgent@bxagents"()
			var cleared = loader.isBuilt( projectRoot() )
			if ( cleared ) {
				// the row and the messages the agent still holds are removed together, in Conversations
				new "models.api.Conversations@bxagents"( loader.load( projectRoot() ), context.sessions ).delete( actingUser( context.user ), found.id )
			} else {
				context.sessions.delete( context.user, found.id )
			}
			return done( "Deleted [#found.title ?: ''#]." & ( cleared ? "" : " The project is not built, so any messages a file or jdbc memory kept for it were left." ) )
		} )
	}

	/**
	 * Forgets the messages and keeps the conversations, which needs the agent: a built project. With --all it is every
	 * conversation (of one agent, with --agent); whoever is at the terminal owns this machine's database, so it is the admin's call.
	 */
	function handleClear() {
		var context = setup()
		if ( isOptionSet( "all" ) ) {
			return clearAll( context )
		}
		return withSession( context, found => {
			var loader = new "models.cli.support.BuiltAgent@bxagents"()
			if ( !loader.isBuilt( projectRoot() ) ) {
				return fail( "`sessions clear` forgets the messages, which the agent holds: run `bxAgents build` first." )
			}
			var outcome = new "models.api.Conversations@bxagents"( loader.load( projectRoot() ), context.sessions ).clearMemory( actingUser( context.user ), found.id )
			return outcome.succeeded()
				? done( "Cleared the messages of [#found.title ?: ''#] (#outcome.data().messages# messages). The conversation stays in the list." )
				: fail( outcome.reason() )
		} )
	}

	/**
	 * Writes one conversation to a file, which needs the agent: a built project.
	 */
	function handleExport() {
		var context = setup()
		return withSession( context, found => {
			var loader = new "models.cli.support.BuiltAgent@bxagents"()
			if ( !loader.isBuilt( projectRoot() ) ) {
				return fail( "`sessions export` reads the messages, which the agent holds: run `bxAgents build` first." )
			}
			var conversation = new "models.chat.AgentConversation@bxagents"( loader.load( projectRoot() ), context.user, context.sessions, found.id )
			var outcome = conversation.exportSession()
			if ( !outcome.ok ) {
				return fail( outcome.reason )
			}
			var format = new "models.store.SessionFile@bxagents"()
			var markdown = isOptionSet( "md" )
			var file = trim( option( "file" ) )
			if ( !len( file ) ) {
				file = format.slug( found.title ?: "" ) & ( markdown ? ".md" : ".json" )
			}
			file = absolutePath( file )
			if ( fileExists( file ) && !isOptionSet( "force" ) ) {
				return fail( "[#file#] already exists. Pick another with --file, or add --force to replace it." )
			}
			directoryCreate( getDirectoryFromPath( file ), true, true )
			fileWrite( file, markdown ? format.markdown( outcome.data ) : jsonSerialize( outcome.data ) )
			return done( "Exported #outcome.data.messages.len()# messages to #file#. The file holds the whole conversation, so keep it where you would keep the conversation." )
		} )
	}

	/**
	 * Adds an exported conversation as a new one, which needs the agent: a built project.
	 */
	function handleImport() {
		var context = setup()
		var file = trim( option( "file" ) )
		if ( !len( file ) ) {
			throw( type = "BxAgents.MissingSessionFile", message = "`sessions import` needs --file=<an exported conversation>." )
		}
		file = absolutePath( file )
		if ( !fileExists( file ) ) {
			return fail( "There is no file [#file#]." )
		}
		var data = ""
		try {
			data = new "models.store.SessionFile@bxagents"().parse( fileRead( file ) )
		} catch ( "BxAgents.InvalidSessionFile" e ) {
			return fail( e.message )
		}
		var loader = new "models.cli.support.BuiltAgent@bxagents"()
		if ( !loader.isBuilt( projectRoot() ) ) {
			return fail( "`sessions import` puts the messages in the agent's memory: run `bxAgents build` first." )
		}
		var conversation = new "models.chat.AgentConversation@bxagents"( loader.load( projectRoot() ), context.user, context.sessions )
		var outcome = conversation.importSession( data, trim( option( "name" ) ) )
		if ( !outcome.ok ) {
			return fail( outcome.reason )
		}
		var note = len( data.agent ?: "" ) && data.agent != conversation.agentName() ? " It was exported from the agent [#data.agent#], and this one is [#conversation.agentName()#]." : ""
		return done( "Imported as [#outcome.title#] (#left( outcome.id, 8 )#): #outcome.messages# messages.#note#" )
	}

	// ----------------------------------------------------------------------------------

	/**
	 * What every action needs: the conversations of this project and whose they are.
	 */
	private struct function setup() {
		return {
			sessions : new "models.store.SessionStore@bxagents"( chatStore() ),
			user     : len( trim( option( "user" ) ) ) ? trim( option( "user" ) ) : Caller::localId()
		}
	}

	/**
	 * Picks the conversation named by --session and hands it to the action.
	 *
	 * @context What setup() gave
	 * @work The action, a function that takes the conversation
	 */
	private struct function withSession( required struct context, required function work ) {
		var reference = trim( option( "session" ) )
		if ( !len( reference ) ) {
			throw( type = "BxAgents.MissingSession", message = "`sessions #lCase( firstArgument() )#` needs --session=<number or id> (see `bxAgents sessions list`)." )
		}
		var found = arguments.context.sessions.resolve( arguments.context.user, reference )
		if ( found.isEmpty() ) {
			return fail( "There is no conversation [#reference#] for #arguments.context.user#. Try `bxAgents sessions list`." )
		}
		return arguments.work( found )
	}

	private string function listText( required array rows, required string user ) {
		if ( !arguments.rows.len() ) {
			return "No conversations yet for #arguments.user#."
		}
		var report = []
		var number = 0
		for ( var row in arguments.rows ) {
			number++
			report.append( right( "  " & number, 3 ) & "  " & left( row.title ?: "", 60 ) & "  " & ( row.messageCount ?: 0 ) & " messages  " & dateTimeFormat( row.updatedAt, "yyyy-MM-dd HH:mm" ) & "  " & left( row.id, 8 ) )
		}
		return report.toList( char( 10 ) )
	}

	private string function absolutePath( required string file ) {
		return arguments.file.reFind( "^([A-Za-z]:)?[\\/]" ) ? arguments.file : projectRoot() & "/" & arguments.file
	}

	private struct function clearAll( required struct context ) {
		var loader = new "models.cli.support.BuiltAgent@bxagents"()
		if ( !loader.isBuilt( projectRoot() ) ) {
			return fail( "`sessions clear` forgets the messages, which the agent holds: run `bxAgents build` first." )
		}
		var agent = loader.load( projectRoot() )
		var agentName = trim( option( "agent" ) )
		if ( len( agentName ) && isNull( new "models.api.AgentTree@bxagents"( agent ).find( agentName ) ) ) {
			return fail( "There is no agent called [#agentName#]." )
		}
		var outcome = new "models.api.Conversations@bxagents"( agent, arguments.context.sessions ).clearMemory( caller = actingUser( arguments.context.user, true ), all = true, agent = agentName )
		return outcome.succeeded()
			? done( "Cleared #outcome.data().messages# messages in #outcome.data().conversations# conversation#outcome.data().conversations == 1 ? '' : 's'#. The conversations stay in the list." )
			: fail( outcome.reason() )
	}

	private any function actingUser( required string user, boolean admin = false ) {
		return new "models.api.Caller@bxagents"( id = arguments.user, name = arguments.user, scope = arguments.admin ? "admin" : "chat", source = "terminal" )
	}

}
