/**
 * `skills` CLI verb - skills from the registry (skills.boxlang.io by default), the way
 * `coldbox ai skills` does it:
 *
 *   skills find <words>             search the registry
 *   skills install <owner/repo/skill>...   install into .agents/skills/ and record it in the lock
 *   skills install                  restore what the lock lists and the disk lacks
 *   skills list                     what is installed, and whether it is intact
 *   skills update [name...]         fetch newer versions
 *   skills remove <name>
 *
 * Installed skills are kept out of source control; .agents/skills.lock.json is what is
 * committed, and `build` restores from it. A skill of your own goes in skills/ (see
 * `add skill`). See SkillStore for the layout and RegistryClient for the service.
 */
class {

	static {
		SUBCOMMANDS = [ "find", "install", "list", "update", "remove" ]
	}

	/**
	 * @options {
	 *   projectRoot (absolute path),
	 *   _positionals ([ subcommand, ... ]),
	 *   limit (find: how many), registry (the registry address), json (list/find: JSON), dry-run (update),
	 *   _transport (test seam - a function ( method, url, params ) returning { status, body })
	 * }
	 *
	 * @return { exitCode, message }
	 */
	struct function run( struct options = {} ) {
		var args = arguments.options._positionals ?: []
		if ( !args.len() || !static.SUBCOMMANDS.contains( args[ 1 ] ) ) {
			throw( type = "BxAgents.UnknownSkillsCommand", message = "Say what to do: bxAgents skills <#static.SUBCOMMANDS.toList( '|' )#> ..." )
		}
		var command = args[ 1 ]
		var rest = args.slice( 2 )
		var client = new "models.skills.RegistryClient@bxagents"( arguments.options.registry ?: "", arguments.options._transport ?: "" )

		if ( command == "find" ) {
			return doFind( client, rest, arguments.options )
		}

		var root = trim( arguments.options.projectRoot ?: "" )
		if ( !len( root ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`skills #command#` requires a project root" )
		}
		if ( !new "models.build.AgentDefinitionLocator@bxagents"().exists( root ) ) {
			throw( type = "BxAgents.NotAnAgentProject", message = "No Agent.yaml or Agent.bx found at [#root#] - run `skills` inside a BX Agents project, or pass --projectRoot" )
		}
		var installer = new "models.skills.SkillInstaller@bxagents"( client )

		switch ( command ) {
			case "install":
				return rest.len() ? doInstall( installer, root, rest ) : doRestore( installer, root )
			case "list":
				return doList( installer, root, arguments.options )
			case "update":
				return doUpdate( installer, root, rest, arguments.options[ "dry-run" ] ?: false )
			default:
				if ( rest.len() != 1 ) {
					throw( type = "BxAgents.MissingSkillName", message = "Say which skill to remove: bxAgents skills remove <name>" )
				}
				installer.remove( root, rest[ 1 ] )
				return { exitCode : 0, message : "- Removed #rest[ 1 ]#" }
		}
	}

	// --------------------------------------------------------------------------

	private struct function doFind( required any client, required array words, required struct options ) {
		if ( !arguments.words.len() ) {
			throw( type = "BxAgents.MissingSearch", message = "Say what to look for: bxAgents skills find <words>" )
		}
		var limit = int( val( arguments.options.limit ?: 10 ) )
		var hits = arguments.client.search( arguments.words.toList( " " ), max( 1, limit ) )
		if ( arguments.options.json ?: false ) {
			return { exitCode : 0, message : jsonSerialize( hits ) }
		}
		if ( !hits.len() ) {
			return { exitCode : 0, message : "Nothing found for [#arguments.words.toList( ' ' )#] in #arguments.client.url()#." }
		}
		var out = []
		for ( var hit in hits ) {
			out.append( hit.name & "  " & hit.owner & "/" & hit.repo & "/" & hit.slug )
			out.append( "  " & shorten( hit.description, 110 ) )
			out.append( "  audit: " & ( len( hit.audit ) ? hit.audit : "unknown" ) & ", " & hit.installs & " installs" )
			out.append( "" )
		}
		out.append( "Install one: bxAgents skills install <owner/repo/skill>" )
		return { exitCode : 0, message : out.toList( char( 10 ) ) }
	}

	private struct function doInstall( required any installer, required string root, required array refs ) {
		var done = arguments.installer.install( arguments.root, arguments.refs )
		var out = []
		for ( var d in done ) {
			var flag = d.audit == "trusted" ? "" : "  ! audit: " & ( len( d.audit ) ? d.audit : "unknown" )
			out.append( ( d.change == "installed" ? "+ Installed " : ( d.change == "updated" ? "~ Updated   " : "= Unchanged " ) ) & d.name & flag )
			out.append( "    .agents/skills/#d.name#/SKILL.md" )
		}
		out.append( "" )
		out.append( "Skills are instructions your agent will follow. Read what you install before you ship it." )
		out.append( "Commit .agents/skills.lock.json; the skills themselves are restored at build time." )
		return { exitCode : 0, message : out.toList( char( 10 ) ) }
	}

	private struct function doRestore( required any installer, required string root ) {
		var restored = arguments.installer.restore( arguments.root )
		if ( !restored.len() ) {
			return { exitCode : 0, message : "Everything in .agents/skills.lock.json is installed." }
		}
		var out = []
		for ( var r in restored ) {
			out.append( "+ Restored " & r.name & ( r.moved ? "  ! the registry's copy differs from the locked one; run: bxAgents skills update #r.name#" : "" ) )
		}
		return { exitCode : 0, message : out.toList( char( 10 ) ) }
	}

	private struct function doList( required any installer, required string root, required struct options ) {
		var rows = arguments.installer.installed( arguments.root )
		if ( arguments.options.json ?: false ) {
			return { exitCode : 0, message : jsonSerialize( rows ) }
		}
		if ( !rows.len() ) {
			return { exitCode : 0, message : "No skills installed from the registry. Find one: bxAgents skills find <words>" }
		}
		var width = 0
		for ( var r in rows ) {
			width = max( width, len( r.name ) )
		}
		var notes = { ok : "", missing : "  not installed; bxAgents skills install restores it", modified : "  edited since it was installed" }
		var out = rows.map( r => r.name & repeatString( " ", width - len( r.name ) + 2 ) & r.source & "/" & r.skill & notes[ r.state ] )
		return { exitCode : 0, message : out.toList( char( 10 ) ) }
	}

	private struct function doUpdate( required any installer, required string root, required array names, required boolean dryRun ) {
		var rows = arguments.installer.update( arguments.root, arguments.names, arguments.dryRun )
		if ( !rows.len() ) {
			return { exitCode : 0, message : "No skills installed from the registry." }
		}
		var out = []
		var failed = false
		for ( var r in rows ) {
			switch ( r.change ) {
				case "updated":
					out.append( ( arguments.dryRun ? "~ Would update " : "~ Updated " ) & r.name & "  " & left( r.from, 7 ) & " -> " & left( r.to, 7 ) )
					break
				case "modified":
					out.append( "! Skipped " & r.name & ": " & r.reason )
					break
				case "failed":
					failed = true
					out.append( "x Failed " & r.name & ": " & r.reason )
					break
				default:
					out.append( "= Up to date " & r.name )
			}
		}
		return { exitCode : failed ? 1 : 0, message : out.toList( char( 10 ) ) }
	}

	private string function shorten( required string text, required numeric max ) {
		var flat = arguments.text.reReplace( "\s+", " ", "all" ).trim()
		return len( flat ) > arguments.max ? left( flat, arguments.max - 3 ) & "..." : flat
	}

}
