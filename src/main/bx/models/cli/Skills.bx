/**
 * `skills` CLI verb - skills from the registry (skills.boxlang.io by default), the way
 * `coldbox ai skills` does it:
 *
 *   skills find <words>             search the registry
 *   skills install <owner/repo/skill>...   install into .agents/skills/ and record it in the lock
 *   skills install                  restore what the lock lists and the disk lacks
 *   skills list                     what is installed, and whether it is intact
 *   skills update [name...]         fetch newer versions
 *   skills remove <name>
 *
 * Installed skills are kept out of source control; .agents/skills.lock.json is what is
 * committed, and `build` restores from it. A skill of your own goes in skills/ (see
 * `add skill`). See SkillStore for the layout and RegistryClient for the service.
 */
import bxModules.bxagents.models.util.NameRules;

class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "skills",
			group : "CONNECT & EXTEND",
			position : 3,
			description : "Find and install skills from the registry",
			usage : "<action> [name-or-source] [options]",
			actions : [ { name : "find" }, { name : "install" }, { name : "list" }, { name : "show" }, { name : "update" }, { name : "remove" } ],
			options : [
				{ name : "registry", display : "--registry=<url>", description : "Use another skill registry.", takesValue : true },
				{ name : "limit", display : "--limit=<number>", description : "Limit search results.", takesValue : true },
				{ name : "dry-run", description : "Preview changes without applying them." },
				{ name : "json", description : "Print results as JSON." }
			],
			examples : [ "skills find release", "skills list", "skills install" ],
			note : "install without a source restores the skills listed in the project's lock file.",
			subcommand : true,
			// the words after the verb are an action and its arguments, and `find` works outside a project
			dispatch : false,
			projectRoot : false
		}
	}

	/**
	 * @options {
	 *   projectRoot (absolute path),
	 *   _positionals ([ subcommand, ... ]),
	 *   limit (find: how many), registry (the registry address), json (list/find: JSON), dry-run (update),
	 *   _transport (test seam - a function ( method, url, params ) returning { status, body })
	 * }
	 */
	function handle() {
		var words = option( "_positionals", [] )
		var commands = meta().actions.map( entry => entry.name )
		if ( !words.len() || !commands.contains( words[ 1 ] ) ) {
			throw( type = "BxAgents.UnknownSkillsCommand", message = "Say what to do: bxAgents skills <#commands.toList( '|' )#> ..." )
		}
		var command = words[ 1 ]
		var rest = words.slice( 2 )
		var client = new "models.skills.RegistryClient@bxagents"( option( "registry" ), option( "_transport" ) )

		if ( command == "find" ) {
			return findSkills( client, rest )
		}

		var root = projectRoot()
		if ( !len( root ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`skills #command#` requires a project root" )
		}
		if ( !new "models.build.AgentDefinitionLocator@bxagents"().exists( root ) ) {
			throw( type = "BxAgents.NotAnAgentProject", message = "No Agent.yml or Agent.bx found at [#root#] - run `skills` inside a BX Agents project, or pass --projectRoot" )
		}
		var installer = new "models.skills.SkillInstaller@bxagents"( client )

		switch ( command ) {
			case "install":
				return rest.len() ? installSkills( installer, root, rest ) : restoreSkills( installer, root )
			case "list":
				return listInstalled( installer, root )
			case "show":
				return showSkill( root, rest )
			case "update":
				return updateSkills( installer, root, rest )
			default:
				if ( rest.len() != 1 ) {
					throw( type = "BxAgents.MissingSkillName", message = "Say which skill to remove: bxAgents skills remove <name>" )
				}
				installer.remove( root, rest[ 1 ] )
				return done( "- Removed #rest[ 1 ]#" )
		}
	}

	// --------------------------------------------------------------------------

	private struct function findSkills( required any client, required array words ) {
		if ( !arguments.words.len() ) {
			throw( type = "BxAgents.MissingSearch", message = "Say what to look for: bxAgents skills find <words>" )
		}
		var query = arguments.words.toList( " " )
		var client = arguments.client
		var hits = client.search( query, max( 1, int( val( option( "limit", 10 ) ) ) ) )
		return asJson( hits, () => findText( hits, query, client.url() ) )
	}

	private string function findText( required array hits, required string query, required string registry ) {
		if ( !arguments.hits.len() ) {
			return "Nothing found for [#arguments.query#] in #arguments.registry#."
		}
		var report = []
		for ( var hit in arguments.hits ) {
			report.append( hit.name & "  " & hit.owner & "/" & hit.repo & "/" & hit.slug )
			report.append( "  " & shorten( hit.description, 110 ) )
			report.append( "  audit: " & ( len( hit.audit ) ? hit.audit : "unknown" ) & ", " & hit.installs & " installs" )
			report.append( "" )
		}
		report.append( "Install one: bxAgents skills install <owner/repo/skill>" )
		return report.toList( char( 10 ) )
	}

	private struct function installSkills( required any installer, required string root, required array refs ) {
		var report = []
		for ( var installed in arguments.installer.install( arguments.root, arguments.refs ) ) {
			var flag = installed.audit == "trusted" ? "" : "  ! audit: " & ( len( installed.audit ) ? installed.audit : "unknown" )
			report.append( ( installed.change == "installed" ? "+ Installed " : ( installed.change == "updated" ? "~ Updated   " : "= Unchanged " ) ) & installed.name & flag )
			report.append( "    .agents/skills/#installed.name#/SKILL.md" )
		}
		report.append( "" )
		report.append( "Skills are instructions your agent will follow. Read what you install before you ship it." )
		report.append( "Commit .agents/skills.lock.json; the skills themselves are restored at build time." )
		return lines( report )
	}

	/**
	 * Prints one skill's SKILL.md, from the project (skills/), the registry installs (.agents/skills/) or the ones the
	 * agent saved in its data home, in that order. Never prints a folder: a skill is read by name.
	 */
	private struct function showSkill( required string root, required array rest ) {
		if ( arguments.rest.len() != 1 ) {
			throw( type = "BxAgents.MissingSkillName", message = "Say which skill to read: bxAgents skills show <name>" )
		}
		var name = trim( arguments.rest[ 1 ] )
		if ( !NameRules::isSafeFolder( name, 64 ) ) {
			return fail( "[#name#] is not a skill name. Names are letters, digits, . _ and -." )
		}
		var places = [ { origin : "project", folder : arguments.root & "/skills" }, { origin : "installed", folder : arguments.root & "/.agents/skills" } ]
		try {
			places.append( { origin : "agent", folder : new "models.data.ProjectData@bxagents"().appDataOf( arguments.root ).home() & "/skills" } )
		} catch ( any e ) {
			// no data home to look in (the project is not built): the first two are all there is
		}
		for ( var place in places ) {
			var file = place.folder & "/" & name & "/SKILL.md"
			if ( fileExists( file ) ) {
				return done( name & " (" & place.origin & ")" & char( 10 ) & char( 10 ) & fileRead( file, "UTF-8" ) )
			}
		}
		return fail( "There is no skill called [#name#]. Try `bxAgents skills list`, or /skills in a chat for every skill the agent has." )
	}

	private struct function restoreSkills( required any installer, required string root ) {
		var restored = arguments.installer.restore( arguments.root )
		if ( !restored.len() ) {
			return done( "Everything in .agents/skills.lock.json is installed." )
		}
		return lines( restored.map( r => "+ Restored " & r.name & ( r.moved ? "  ! the registry's copy differs from the locked one; run: bxAgents skills update #r.name#" : "" ) ) )
	}

	private struct function listInstalled( required any installer, required string root ) {
		var rows = arguments.installer.installed( arguments.root )
		return asJson( rows, () => installedText( rows ) )
	}

	private string function installedText( required array rows ) {
		if ( !arguments.rows.len() ) {
			return "No skills installed from the registry. Find one: bxAgents skills find <words>"
		}
		var width = 0
		for ( var row in arguments.rows ) {
			width = max( width, len( row.name ) )
		}
		var notes = { ok : "", missing : "  not installed; bxAgents skills install restores it", modified : "  edited since it was installed" }
		return arguments.rows.map( row => padRight( row.name, width + 2 ) & row.source & "/" & row.skill & notes[ row.state ] ).toList( char( 10 ) )
	}

	private struct function updateSkills( required any installer, required string root, required array names ) {
		var dryRun = isOptionSet( "dry-run" )
		var rows = arguments.installer.update( arguments.root, arguments.names, dryRun )
		if ( !rows.len() ) {
			return done( "No skills installed from the registry." )
		}
		var report = []
		var failed = false
		for ( var row in rows ) {
			switch ( row.change ) {
				case "updated":
					report.append( ( dryRun ? "~ Would update " : "~ Updated " ) & row.name & "  " & left( row.from, 7 ) & " -> " & left( row.to, 7 ) )
					break
				case "modified":
					report.append( "! Skipped " & row.name & ": " & row.reason )
					break
				case "failed":
					failed = true
					report.append( "x Failed " & row.name & ": " & row.reason )
					break
				default:
					report.append( "= Up to date " & row.name )
			}
		}
		return exitWith( failed ? 1 : 0, report.toList( char( 10 ) ) )
	}

	private string function shorten( required string text, required numeric max ) {
		var flat = arguments.text.reReplace( "\s+", " ", "all" ).trim()
		return len( flat ) > arguments.max ? left( flat, arguments.max - 3 ) & "..." : flat
	}

}
