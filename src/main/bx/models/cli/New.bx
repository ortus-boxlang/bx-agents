/**
 * `new` CLI verb - creates a new BX Agents project one of three mutually
 * exclusive ways: CLI-agnostic in every case (takes an already-parsed
 * options struct - see ModuleConfig.bx's dispatch() - never touches raw
 * argv or the current working directory itself).
 *
 * 1. `--template=<name>` (default `minimal` when no source flag is given at
 *    all) - scaffolds one of ProjectScaffolder's 8 built-in starters.
 *    `--model` is REQUIRED in this mode.
 * 2. `--repo=<owner/repo|url>` - clones an existing GitHub repo via
 *    RepoCloner (a bundled JGit dependency, no `git` binary required).
 *    `--model` is NOT required - the cloned project defines its own.
 * 3. `--forgebox=<slug>` - installs a ForgeBox package via ForgeBoxInstaller
 *    (a native BoxLang HTTP client, no `box` CLI required). `--model` is NOT
 *    required either.
 *
 * `--template` cannot be combined with `--repo`/`--forgebox`, and `--repo`/
 * `--forgebox` cannot be combined with each other - each names a different
 * project SOURCE, so exactly one applies.
 *
 * Also runs `box install` in the scaffolded project root (ProjectScaffolder
 * always writes a `box.json` there declaring a `testbox` devDependency that
 * installs into `lib/testbox`) so `bxAgents test` works immediately on a fresh
 * project, without the user having to separately `box install` themselves first. This is a best-effort convenience step, not a build
 * requirement: if `box` isn't on PATH or the install fails, `new` still
 * reports success (the project files themselves were written just fine) -
 * it just tells the user to run the install manually. Only ever attempted
 * for the `--template` path: a cloned/installed project may have no
 * `box.json` at all, or a completely different one - running `box
 * install` there would be guessing at someone else's project layout, not
 * "best-effort convenience."
 *
 * With no `--model` and no `--repo`/`--forgebox`, at a terminal, `new` runs the wizard
 * (models/wizard/NewWizard.bx): a full-screen set of questions about what the agent
 * should do, ending in the same project the flags below would build. `--no-wizard` turns
 * it off, `--wizard` asks for it even with a model, and `--yes` takes every answer from
 * the flags and the defaults. A `--model` means a script is calling, as it always had to,
 * so it does not start the wizard on its own. Without a terminal the wizard falls back to
 * numbered questions, or `--model` is required as before.
 *
 * The agent is defined by an `Agent.yaml` by default. `--class` scaffolds a
 * class-based `Agent.bx` instead, for projects that need code in the agent
 * definition (hooks, dynamic instructions, tools registered in code); it also
 * applies to every subagent a template scaffolds. Only applies to `--template`.
 *
 * `--skipInstall` opts out of this step entirely (no attempt, no message) -
 * for CI/tests that need `new` to stay fast and network-independent, the
 * same reason `eve add`'s own registry install has a `--skip-install` flag.
 * It's a silent no-op (not an error) when passed alongside `--repo`/
 * `--forgebox`, since the step never runs there anyway.
 */
class {

	/**
	 * @options { wizard (optional boolean, false = never ask, true = ask even with a model), yes (optional boolean - never ask), tui (optional boolean, false = numbered questions instead of the full-screen UI), with/search/files/files-dir/memory/mcp/channels/web-auth/guard/deploy/registry/app/region/host/user/remote-path/destination (optional - see ProjectPlan.fromFlags), projectRoot (required, absolute path), name, model (required only with --template/no source flag), description, template (optional, one of ProjectScaffolder.TEMPLATES - default "minimal"), class (optional boolean - write a class-based Agent.bx instead of the default Agent.yaml; only applies to --template), repo (optional - clone this GitHub repo instead of scaffolding), forgebox (optional - install this ForgeBox slug instead of scaffolding), skipInstall (optional boolean - skip the tests/ `box install` convenience step; only applies to --template) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`new` requires a target directory" )
		}

		var repo = trim( arguments.options.repo ?: "" )
		var forgebox = trim( arguments.options.forgebox ?: "" )
		var templateGiven = len( trim( arguments.options.template ?: "" ) ) > 0

		if ( len( repo ) && len( forgebox ) ) {
			throw( type = "BxAgents.ConflictingProjectSource", message = "--repo and --forgebox are mutually exclusive - pick one" )
		}
		if ( ( len( repo ) || len( forgebox ) ) && templateGiven ) {
			throw( type = "BxAgents.ConflictingProjectSource", message = "--template cannot be combined with --repo/--forgebox" )
		}

		var sourceWarning = ""
		if ( len( repo ) || len( forgebox ) ) {
			if ( len( trim( arguments.options.name ?: "" ) ) || len( trim( arguments.options.description ?: "" ) ) ) {
				sourceWarning = char( 10 ) & "Note: --name/--description are ignored with --repo/--forgebox - the cloned/installed project defines its own."
			}
		}

		var message = ""
		var installTests = false

		if ( len( repo ) ) {
			// "@bxagents" suffix, not a bare "bxagents.models...." path - see
			// BuildPipeline.bx's init() docblock for why.
			var cloner = new "models.build.RepoCloner@bxagents"()
			var cloneResult = cloner.clone( repo, projectRoot )
			message = "Cloned [#repo#] into #cloneResult.projectRoot#"
		} else if ( len( forgebox ) ) {
			var installer = new "models.build.ForgeBoxInstaller@bxagents"()
			var installResult = installer.install( forgebox, projectRoot )
			message = "Installed ForgeBox package [#forgebox#] into #installResult.projectRoot#"
		} else {
			var planner = new "models.wizard.ProjectPlan@bxagents"()
			var plan = {}
			var prompter = ""
			var rebuildCommand = ""

			if ( shouldAskQuestions( arguments.options ) ) {
				if ( arguments.options[ "class" ] ?: false ) {
					throw( type = "BxAgents.FeaturesNeedYaml", message = "--class cannot be combined with the wizard: its choices are written to Agent.yaml. Pass --no-wizard to scaffold a class-based Agent.bx." )
				}
				prompter = arguments.options._prompter ?: newPrompter( arguments.options )
				try {
					var asked = new "models.wizard.NewWizard@bxagents"( prompter ).run(
						arguments.options,
						lastSegment( projectRoot ),
						arguments.options._positional ?: ""
					)
					plan = asked.plan
					rebuildCommand = asked.command
				} catch ( BxAgents.WizardCancelled e ) {
					prompter.close()
					return { exitCode : 1, message : e.message }
				} catch ( any e ) {
					prompter.close()
					rethrow
				}
				prompter.close()
			} else {
				if ( !len( trim( arguments.options.model ?: "" ) ) ) {
					throw( type = "BxAgents.MissingModel", message = "`new` requires --model, e.g. --model=openai/gpt-5. Run it in a terminal without --model to be asked instead." )
				}
				plan = planner.fromFlags( arguments.options )
			}

			if ( !len( plan.name ) ) {
				plan.name = lastSegment( projectRoot )
				if ( !len( plan.name ) ) {
					plan.name = "bx-agent"
				}
			}

			var features = planner.toFeatures( plan, false )
			if ( features.count() || isObject( prompter ) ) {
				features = planner.toFeatures( plan, true )
			}
			var scaffolder = new "models.build.ProjectScaffolder@bxagents"()
			var scaffoldResult = scaffolder.scaffold( projectRoot, plan.name, plan.model, plan.description, plan.template, arguments.options[ "class" ] ?: false, features )
			message = "Created new BX Agents project [#plan.name#] at #scaffoldResult.projectRoot#"
			installTests = true

			if ( features.count() || isObject( prompter ) ) {
				var installNote = ""
				if ( !( arguments.options.skipInstall ?: false ) ) {
					installNote = installDependencies( projectRoot )
					installTests = false
				}
				var colorize = isObject( prompter ) ? ( style, text ) => prompter.paint( style, text ) : ( style, text ) => text
				return {
					exitCode : 0,
					message  : new "models.wizard.NextSteps@bxagents"().render( plan, features, scaffoldResult.projectRoot, installNote, colorize, arguments.options._positional ?: "", rebuildCommand )
				}
			}
		}

		message &= sourceWarning

		if ( installTests && !( arguments.options.skipInstall ?: false ) ) {
			message &= char( 10 ) & installDependencies( projectRoot )
		}

		return {
			exitCode : 0,
			message  : message
		}
	}

	/**
	 * Whether `new` asks questions: at a terminal when nothing says otherwise.
	 *
	 * @options The parsed CLI options
	 *
	 * @return True when the wizard should run
	 */
	private boolean function shouldAskQuestions( required struct options ) {
		if ( ( arguments.options.wizard ?: true ) == false || ( arguments.options.yes ?: false ) == true ) {
			return false
		}
		if ( arguments.options.wizard ?: false ) {
			return true
		}
		return !len( trim( arguments.options.model ?: "" ) ) && ( arguments.options._interactive ?: isTerminal() )
	}

	/**
	 * @return True when stdin and stdout are a terminal that can host questions
	 */
	private boolean function isTerminal() {
		return new "models.wizard.prompters.PrompterFactory@bxagents"().isTerminal()
	}

	/**
	 * The full-screen prompter at a capable terminal, numbered questions otherwise.
	 *
	 * @options The parsed CLI options
	 */
	private any function newPrompter( required struct options ) {
		return new "models.wizard.prompters.PrompterFactory@bxagents"().create( arguments.options )
	}

	/**
	 * @path A filesystem path
	 *
	 * @return Its last segment, or empty
	 */
	private string function lastSegment( required string path ) {
		var segments = listToArray( arguments.path.reReplace( "[\/]+$", "" ), "/\" )
		return segments.len() ? segments[ segments.len() ] : ""
	}

	/**
	 * Runs `box install` in the scaffolded project root, where ProjectScaffolder always writes a
	 * `box.json` (a `testbox` devDependency, installed into `lib/testbox`). Never throws -
	 * a failed/missing `box` degrades to a clear instruction to install
	 * manually, since the scaffolded project itself is already complete
	 * without it.
	 *
	 * @projectRoot Absolute path to the newly scaffolded project root
	 *
	 * @return A one-line status message to append to `new`'s own success message
	 */
	private string function installDependencies( required string projectRoot ) {
		var manualInstruction = "Run `box install` in the project root yourself to install testbox before running `bxAgents test`."

		try {
			var builder = createObject( "java", "java.lang.ProcessBuilder" ).init( [ "box", "install" ] )
			builder.directory( createObject( "java", "java.io.File" ).init( arguments.projectRoot ) )
			builder.redirectErrorStream( true )
			var process = builder.start()
			var output = createObject( "java", "java.lang.String" ).init( process.getInputStream().readAllBytes() )
			process.waitFor()

			if ( process.exitValue() != 0 ) {
				return "Warning: `box install` exited with code #process.exitValue()# - #manualInstruction#"
			}
			return "Installed box.json dependencies (testbox) via `box install`."
		} catch ( any e ) {
			return "Warning: could not run `box install` (#e.message#) - #manualInstruction#"
		}
	}

}
