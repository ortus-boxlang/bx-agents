/**
 * `hash-password` CLI verb - turns a plaintext password into the `passwordHash`
 * value a `webui` entry's `users` block accepts.
 *
 * This exists so `passwordHash` is actually usable. Without it the only way to
 * get one would be to run the generated app's own hasher by hand, and people
 * would reach for committing a plaintext password instead - which the validator
 * rejects, but only after they had already written it down.
 *
 * The hash is safe to commit: it is one-way, and salted per call, so hashing
 * the same password twice gives two different (both valid) values.
 *
 * Kept deliberately identical to the hasher WebUiGenerator emits. If one
 * changes, the other has to change with it - a hash produced here that the app
 * could not verify would be a genuinely baffling failure.
 */
class {

	static {
		final ITERATIONS = 210000
		final ALGORITHM  = "PBKDF2WithHmacSHA256"
		final KEY_LENGTH = 256
		final PREFIX     = "pbkdf2"
	}

	/**
	 * @options { password (required) }
	 */
	struct function run( struct options = {} ) {
		var password = arguments.options.password ?: ""

		if ( !len( password ) ) {
			throw(
				type    = "BxAgents.MissingPassword",
				message = "`hash-password` requires --password=<plaintext>"
			)
		}

		var salt = generateSecretKey( "AES", 128 )
		var derived = generatePBKDFKey( static.ALGORITHM, password, salt, static.ITERATIONS, static.KEY_LENGTH )
		var hashed = static.PREFIX & "$" & static.ITERATIONS & "$" & salt & "$" & derived

		return {
			exitCode : 0,
			message  : hashed
		}
	}

}
