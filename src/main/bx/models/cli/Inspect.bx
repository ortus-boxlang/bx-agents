/**
 * `inspect` CLI verb - a report of how a project's agent is composed: the agents and
 * subagents with their models, tools, skills and MCP servers, what the project is
 * exposed through, its schedule, the environment variables it needs and whether they
 * are set, and whether it validates.
 *
 * It reads the project's source, like `doctor`, so it works on a project that has
 * never been built. Nothing is generated or written, except the Markdown file when
 * `--md=<file>` names one. See ProjectReport for what is in the report.
 */
import bxModules.bxagents.models.util.Terminal;

class {

	/**
	 * @options {
	 *   projectRoot (required, absolute path),
	 *   json        (optional boolean - print the whole report as JSON),
	 *   md          (optional - true prints Markdown, a file name writes it there),
	 *   section     (optional - comma-separated section names to show),
	 *   environment (optional - resolve the agent for this environment),
	 *   color       (optional boolean - false for no color),
	 *   ascii       (optional boolean - avoid box-drawing characters),
	 *   _paint      (test seam - a function ( style, text ) replacing the palette),
	 *   _width      (test seam - the width to draw at)
	 * }
	 *
	 * @return { exitCode, message, report }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`inspect` requires a project root" )
		}

		var builder = new "models.report.ProjectReport@bxagents"()
		var sections = builder.parseSections( arguments.options.section ?: "" )
		var report = builder.build( projectRoot, arguments.options.environment ?: "" )

		if ( arguments.options.json ?: false ) {
			return { exitCode : 0, message : jsonSerialize( report ), report : report }
		}

		var md = arguments.options.md ?: false
		if ( isSimpleValue( md ) && len( md ) && md != "false" ) {
			var markdown = new "models.report.ReportMarkdownRenderer@bxagents"().render( report, sections )
			if ( md == "true" ) {
				return { exitCode : 0, message : markdown, report : report }
			}
			var target = reFind( "^([A-Za-z]:)?[/\\]", md ) ? md : projectRoot & "/" & md
			fileWrite( target, markdown )
			return { exitCode : 0, message : "Wrote #target#", report : report }
		}

		var text = new "models.report.ReportTextRenderer@bxagents"(
			paint : arguments.options._paint ?: palette( arguments.options ),
			width : arguments.options._width ?: terminalWidth(),
			ascii : arguments.options.ascii ?: ( getSystemSetting( "TERM", "" ) == "dumb" )
		).render( report, sections )

		return { exitCode : 0, message : text, report : report }
	}

	/**
	 * Color only at an interactive terminal, and never against `NO_COLOR`, `TERM=dumb`
	 * or `--no-color`, so a pipe or a log file gets plain text.
	 *
	 * @options The verb's options
	 *
	 * @return A function ( style, text ) that applies the palette, or one that does not
	 */
	private function palette( required struct options ) {
		var plain = ( style, text ) => text
		if ( !( arguments.options.color ?: true ) ) {
			return plain
		}
		try {
			if ( !Terminal::isInteractive() ) {
				return plain
			}
			var theme = createObject( "java", "ortus.boxlang.bxagents.tui.Theme" ).detect()
			return ( style, text ) => theme.paint( style, text )
		} catch ( any e ) {
			return plain
		}
	}

	/**
	 * @return The terminal width from `COLUMNS` when the shell exports it, else 80
	 */
	private numeric function terminalWidth() {
		var columns = getSystemSetting( "COLUMNS", "" )
		return isNumeric( columns ) ? int( columns ) : 80
	}

}
