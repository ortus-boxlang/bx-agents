/**
 * `inspect` CLI verb - a report of how a project's agent is composed: the agents and
 * subagents with their models, tools, skills and MCP servers, what the project is
 * exposed through, its schedule, the environment variables it needs and whether they
 * are set, and whether it validates.
 *
 * It reads the project's source, like `doctor`, so it works on a project that has
 * never been built. Nothing is generated or written, except the Markdown file when
 * `--md=<file>` names one. See ProjectReport for what is in the report.
 */
import bxModules.bxagents.models.util.Terminal;

class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "inspect",
			group : "GET STARTED",
			position : 4,
			description : "Explore the agent's tools and configuration",
			usage : "[options]",
			options : [
				{ name : "section", display : "--section=<names>", description : "Show selected sections, comma separated.", takesValue : true },
				{ name : "environment", display : "--environment=<name>", description : "Inspect an environment override.", takesValue : true },
				{ name : "json", description : "Print the full report as JSON." },
				{ name : "md", display : "--md[=<file>]", description : "Print Markdown, or write it to a file." },
				{ name : "ascii", description : "Use plain characters instead of symbols." }
			],
			examples : [ "inspect", "inspect --section=tools,env" ],
			note : "Reads project source; no build is needed."
		}
	}

	function handle() {
		var builder = new "models.report.ProjectReport@bxagents"()
		var sections = builder.parseSections( option( "section" ) )
		var report = builder.build( projectRoot(), option( "environment" ) )

		if ( isOptionSet( "json" ) ) {
			return done( jsonSerialize( report ), { report : report } )
		}

		var markdownOption = option( "md", false )
		if ( isSimpleValue( markdownOption ) && len( markdownOption ) && markdownOption != "false" ) {
			var markdown = new "models.report.ReportMarkdownRenderer@bxagents"().render( report, sections )
			if ( markdownOption == "true" ) {
				return done( markdown, { report : report } )
			}
			var target = reFind( "^([A-Za-z]:)?[/\\]", markdownOption ) ? markdownOption : projectRoot() & "/" & markdownOption
			fileWrite( target, markdown )
			return done( "Wrote #target#", { report : report } )
		}

		var text = new "models.report.ReportTextRenderer@bxagents"(
			paint : option( "_paint", palette() ),
			width : option( "_width", terminalWidth() ),
			ascii : option( "ascii", getSystemSetting( "TERM", "" ) == "dumb" )
		).render( report, sections )
		return done( text, { report : report } )
	}

	/**
	 * Color only at an interactive terminal, and never against `NO_COLOR`, `TERM=dumb`
	 * or `--no-color`, so a pipe or a log file gets plain text.
	 *
	 * @return A function ( style, text ) that applies the palette, or one that does not
	 */
	private function palette() {
		var plain = ( style, text ) => text
		if ( !option( "color", true ) ) {
			return plain
		}
		try {
			if ( !Terminal::isInteractive() ) {
				return plain
			}
			var theme = createObject( "java", "ortus.boxlang.bxagents.tui.Theme" ).detect()
			return ( style, text ) => theme.paint( style, text )
		} catch ( any e ) {
			return plain
		}
	}

	/**
	 * @return The terminal width from `COLUMNS` when the shell exports it, else 80
	 */
	private numeric function terminalWidth() {
		var columns = getSystemSetting( "COLUMNS", "" )
		return isNumeric( columns ) ? int( columns ) : 80
	}

}
