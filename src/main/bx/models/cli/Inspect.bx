/**
 * `inspect` CLI verb - reads and pretty-prints an existing `.build/manifest.json`
 * without rebuilding. Requires a prior `build`.
 */
class {

	/**
	 * @options { projectRoot (required, absolute path), json (optional boolean - print the raw manifest as JSON instead of the human-readable summary) }
	 */
	struct function run( struct options = {} ) {
		var projectRoot = trim( arguments.options.projectRoot ?: "" )
		if ( !len( projectRoot ) ) {
			throw( type = "BxAgents.MissingProjectRoot", message = "`inspect` requires a project root" )
		}

		var root = projectRoot.reReplace( "[\/]+$", "" )
		var manifestPath = root & "/.build/manifest.json"

		if ( !fileExists( manifestPath ) ) {
			throw(
				type    = "BxAgents.NotBuilt",
				message = "No build found at [#root#/.build] - run `build` first"
			)
		}

		var manifest = jsonDeserialize( fileRead( manifestPath ) )
		var asJson = arguments.options.json ?: false

		return {
			exitCode : 0,
			message  : asJson ? jsonSerialize( manifest ) : formatManifest( manifest ),
			manifest : manifest
		}
	}

	/**
	 * @manifest The built project's manifest.json, deserialized
	 *
	 * @return A human-readable, pretty-printed summary of the manifest
	 */
	private string function formatManifest( required struct manifest ) {
		var agent = arguments.manifest.agent ?: {}
		var generator = arguments.manifest.generator ?: {}
		var files = arguments.manifest.files ?: []

		var lines = [
			"Agent:        #agent.name ?: ''#",
			"Model:        #agent.model ?: ''#",
			"Environment:  #agent.environment ?: ''#",
			"Manifest ver: #arguments.manifest.manifestVersion ?: ''#",
			"Generator:    #generator.name ?: ''# #generator.version ?: ''#",
			"Files:        #files.len()#"
		]
		return lines.toList( char( 10 ) )
	}

}
