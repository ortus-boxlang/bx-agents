/**
 * `connect` CLI verb - sign in to the MCP servers of a project that ask each person to sign in (an `mcpServers`
 * entry with an `oauth` key in Agent.yml).
 *
 *   bxAgents connect                      lists the connectors and the servers, and whether you are connected
 *   bxAgents connect github               connects a connector: the risk, then your token in a hidden box
 *   bxAgents connect github --token-env=GITHUB_TOKEN --confirm   the same without a box, for a script (--stdin pipes it in)
 *   bxAgents connect github tools off delete_file    and: tools, tools on NAME, tools off all, tools readonly, off, options key=value
 *   bxAgents connect mail                 signs in to the server named mail
 *   bxAgents connect mail --remove        forgets your sign in to it
 *   bxAgents connect mail --port=8765     uses that port for the return address (register http://127.0.0.1:8765/callback)
 *   bxAgents connect mail --no-open       prints the address and does not open a browser
 *   [--user=NAME] [--timeout=SECONDS] [--json]
 *
 * The sign in happens in your browser. This command opens a short-lived listener on 127.0.0.1 to catch the redirect,
 * so the provider sends you back to this terminal, then closes it. Your tokens are sealed in the project's chat
 * database with the vault key and are used when the agent runs as the same person (`local` unless --user says another).
 * To sign in to a served agent instead, use the Connections panel of its web page or `chat --connect`'s /connect.
 */
import bxModules.bxagents.models.api.Caller;
import bxModules.bxagents.models.connect.OAuthServers;
import bxModules.bxagents.models.connectors.ConnectorSettings;

class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "connect",
			group : "CONNECT & EXTEND",
			position : 1,
			description : "Connect services and sign in to MCP servers",
			usage : "[id] [tools|off|options] [options]",
			options : [
				{ name : "token-env", display : "--token-env=<NAME>", description : "Environment variable holding a connector token.", takesValue : true },
				{ name : "stdin", description : "Read a token from standard input." },
				{ name : "confirm", description : "Approve the connector's stated capabilities." },
				{ name : "remove", description : "Forget a saved sign-in." },
				{ name : "port", display : "--port=<number>", description : "Local OAuth callback port; otherwise a free port.", takesValue : true },
				{ name : "no-open", description : "Print the sign-in URL without opening a browser." },
				{ name : "timeout", display : "--timeout=<seconds>", description : "Sign-in wait time. Default: 300.", takesValue : true },
				{ name : "user", display : "--user=<name>", description : "Whose connection to use. Default: local.", takesValue : true },
				{ name : "json", description : "Print connection status as JSON." }
			],
			examples : [ "connect", "connect github --token-env=GITHUB_TOKEN --confirm" ],
			note : "Without an id, lists available services and connection status. Secrets are sealed in the chat database.",
			subcommand : true
		}
	}


	/**
	 * Test seams in the options: `_receive( redirectUri, authorizationUrl )` gives { code, state, iss } instead of the browser, and
	 * `_clientFactory` replaces bx-ai.
	 */
	function handle() {
		var name = firstArgument()
		var subject = len( trim( option( "user" ) ) ) ? trim( option( "user" ) ) : Caller::localId()

		var config = new "models.build.AgentConfigResolver@bxagents"().resolve( projectRoot = projectRoot() )
		var entries = OAuthServers::of( config )
		var offered = ConnectorSettings::resolve( config ).available.len() > 0
		if ( !entries.len() && !offered ) {
			return fail( "This project offers no connectors (`connectors: none`) and no mcpServers entry has an `oauth` key, so there is nothing to connect to. Add one to Agent.yml, for example `oauth: true`." )
		}

		var file = chatStoreFile()
		directoryCreate( getDirectoryFromPath( file ), true, true )
		var wiring = new "models.vault.VaultWiring@bxagents"().pin( file )
		// the connectors and everything typed after the first word go through the console, unless the first word is a service written in Agent.yml
		if ( offered && !entries.some( e => e.name == name ) ) {
			return new "models.connectors.ConnectTerminal@bxagents"().run( variables.options, config, subject, wiring, entries )
		}
		var settings = { wiring : wiring }
		if ( isClosure( option( "_clientFactory" ) ) ) {
			settings[ "clientFactory" ] = option( "_clientFactory" )
		}

		if ( !len( name ) ) {
			return list( new "models.connect.ConnectionService@bxagents"( entries, settings ), subject )
		}
		if ( isOptionSet( "remove" ) ) {
			return remove( new "models.connect.ConnectionService@bxagents"( entries, settings ), name, subject )
		}
		return connect( entries, settings, name, subject )
	}

	// ----------------------------------------------------------------------------------

	/**
	 * Shows the servers and whether the person is connected.
	 */
	private struct function list( required any service, required string subject ) {
		var rows = arguments.service.list( arguments.subject )
		var subject = arguments.subject
		return asJson( { "user" : subject, "servers" : rows }, () => {
			var report = [ "Sign ins of #subject#:" ]
			for ( var row in rows ) {
				report.append( "  " & pad( row.name, 18 ) & pad( row.connected ? "connected" : "not connected", 16 ) & row.url )
			}
			var missing = rows.filter( row => !row.connected )
			if ( missing.len() ) {
				report.append( "" )
				report.append( "Connect with `bxAgents connect #missing[ 1 ].name#`." )
			}
			return report.toList( char( 10 ) )
		} )
	}

	/**
	 * Forgets the person's sign in to one server.
	 */
	private struct function remove( required any service, required string name, required string subject ) {
		try {
			arguments.service.disconnect( arguments.name, arguments.subject )
		} catch ( "BxAgents.UnknownConnection" e ) {
			return fail( e.message )
		}
		return done( "Disconnected #arguments.subject# from #arguments.name#." )
	}

	/**
	 * Signs in: starts, waits for the browser to come back, finishes.
	 */
	private struct function connect( required array entries, required struct settings, required string name, required string subject ) {
		var seconds = isNumeric( option( "timeout" ) ) ? int( option( "timeout" ) ) : 300
		var receive = option( "_receive" )
		var port = isNumeric( option( "port" ) ) ? int( option( "port" ) ) : 0
		var listener = ""
		var redirectUri = "http://127.0.0.1:" & port & "/callback"
		try {
			if ( !isClosure( receive ) ) {
				var page = new "models.connect.CallbackPage@bxagents"()
				listener = createObject( "java", "ortus.boxlang.bxagents.util.LoopbackCallback" ).start(
					port,
					"/callback",
					page.connected( arguments.name ),
					page.refused( "The provider did not send you back with a code." )
				)
				redirectUri = listener.redirectUri()
			}
			var settings = duplicate( arguments.settings )
			settings[ "redirectUri" ] = redirectUri
			var service = new "models.connect.ConnectionService@bxagents"( arguments.entries, settings )

			var started = service.start( arguments.name, arguments.subject )
			var query = {}
			if ( isClosure( receive ) ) {
				query = receive( redirectUri, started.authorizationUrl )
			} else {
				println( "Open this address and sign in to #arguments.name#:" )
				println( started.authorizationUrl )
				if ( !isOptionSet( "noOpen" ) ) {
					new "models.connect.BrowserLauncher@bxagents"().open( started.authorizationUrl )
				}
				println( "Waiting up to #seconds# seconds for the browser to come back to #redirectUri# ..." )
				query = toStruct( listener.await( seconds ) )
			}
			if ( len( query.error ?: "" ) ) {
				return fail( "Not connected: #query.error_description ?: query.error#" )
			}
			var completed = service.complete( query.code ?: "", query.state ?: "", query.iss ?: "" )
			return done( "Connected #completed.subject# to #completed.name#." )
		} catch ( "BxAgents.UnknownConnection" e ) {
			return fail( e.message )
		} catch ( "BxAgents.MissingVaultSecret" e ) {
			return fail( e.message )
		} catch ( "java.util.concurrent.TimeoutException" e ) {
			return fail( "Nobody came back within #seconds# seconds. Run `bxAgents connect #arguments.name#` again." )
		} catch ( any e ) {
			if ( left( e.type, 8 ) == "MCPOAuth" ) {
				return fail( e.message )
			}
			rethrow
		} finally {
			if ( isObject( listener ) ) {
				listener.close()
			}
		}
	}

	/**
	 * @map A Java map of strings
	 *
	 * @return The same pairs as a struct
	 */
	private struct function toStruct( required any map ) {
		var out = {}
		for ( var key in arguments.map.keySet() ) {
			out[ key ] = arguments.map.get( key )
		}
		return out
	}

	/**
	 * A column: text that is longer than its width keeps all of its characters and gets one space after it, which
	 * padRight() would cut.
	 */
	private string function pad( required string text, required numeric width ) {
		return len( arguments.text ) >= arguments.width ? arguments.text & " " : padRight( arguments.text, arguments.width )
	}

}
