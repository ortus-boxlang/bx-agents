/**
 * `routines` CLI verb: the scheduled routines of a project on this machine, as the local operator (admin scope, so --all sees every owner's).
 *
 *   bxAgents routines list [--all] [--json]
 *   bxAgents routines show <name>
 *   bxAgents routines add --name=<name> --schedule="0 9 * * 1-5" --prompt="..." [--destination=routine|gateway:<name>] [--chat=<id>]
 *   bxAgents routines edit <name> [--schedule=...] [--prompt=...] [--destination=...] [--chat=...]
 *   bxAgents routines pause|resume|run <name>
 *   bxAgents routines delete <name> [--yes]
 *   bxAgents routines reports <name>
 *   bxAgents routines report <name> <file>
 *   bxAgents routines clean <name> [--older-than=30d | --all] [--yes]
 *
 * A routine runs only in a served app: its heartbeat starts what is due. `run` makes a routine due, and says so. `clean` only shows what it
 * would remove unless --yes is given; `delete` asks for --yes too, and keeps the routine's reports.
 */
class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "routines",
			group : "MANAGE YOUR AGENT",
			position : 4,
			description : "Manage scheduled work and reports",
			usage : "<action> [name] [options]",
			actions : [ { name : "list" }, { name : "show" }, { name : "add" }, { name : "edit" }, { name : "pause" }, { name : "resume" }, { name : "run" }, { name : "delete" }, { name : "reports" }, { name : "report" }, { name : "clean" } ],
			options : [
				{ name : "name", display : "--name=<name>", description : "Name of a new routine.", takesValue : true },
				{ name : "schedule", display : "--schedule=<cron-or-interval>", description : "When the routine runs.", takesValue : true },
				{ name : "prompt", display : "--prompt=<text>", description : "Message to send to the agent.", takesValue : true },
				{ name : "destination", display : "--destination=<target>", description : "routine or gateway:<name>.", takesValue : true },
				{ name : "chat", display : "--chat=<id>", description : "Gateway chat to deliver to.", takesValue : true },
				{ name : "older-than", display : "--older-than=<age>", description : "Report age for clean, such as 30d.", takesValue : true },
				{ name : "all", description : "List every owner's routines, or clean all reports." },
				{ name : "yes", description : "Confirm deleting a routine or cleaning reports." },
				{ name : "json", description : "Print results as JSON." }
			],
			examples : [ "routines list", "routines show daily", "routines clean daily --older-than=30d" ],
			note : "Requires routines.enabled: true. clean previews removals unless --yes is given.",
			subcommand : true,
			// the first word is in _positionals with the routine's name and file, and the project root is only needed
			// when no manager was handed in
			dispatch : false,
			projectRoot : false
		}
	}

	/**
	 * @options { _positionals ([ action, name, file ]), all, json, yes, name, schedule, prompt, destination, chat, older-than,
	 *            _manager (test seam: a RoutineManager) }
	 */
	function handle() {
		var words = option( "_positionals", [] )
		var actions = meta().actions.map( entry => entry.name )
		if ( !words.len() || !actions.contains( lCase( words[ 1 ] ) ) ) {
			throw( type = "BxAgents.UnknownRoutinesCommand", message = "Say what to do: bxAgents routines <#actions.toList( '|' )#> ..." )
		}
		var action = lCase( words[ 1 ] )
		var rest = words.slice( 2 )
		var manager = managerOfProject()
		if ( !isObject( manager ) ) {
			return fail( "Routines are not turned on for this project. Add `routines: { enabled: true }` to Agent.yml." )
		}
		var who = new "models.api.Caller@bxagents"( id = "local", scope = "admin", source = "terminal" )
		var ref = trim( rest.len() ? rest[ 1 ] : option( "name" ) )
		if ( !len( ref ) && ![ "list", "add" ].contains( action ) ) {
			throw( type = "BxAgents.MissingRoutineName", message = "Say which routine: bxAgents routines #action# <name>" )
		}

		switch ( action ) {
			case "list":
				return listing( manager.list( who, isOptionSet( "all" ) ) )
			case "show":
				return showing( manager.get( who, ref ) )
			case "add":
				return changed( manager.create( who, option( "name" ), option( "schedule" ), option( "prompt" ), option( "destination" ), option( "chat" ) ), "Made" )
			case "edit":
				var fields = {}
				for ( var key in [ "schedule", "prompt", "destination", "chat" ] ) {
					if ( variables.options.keyExists( key ) ) {
						fields[ key ] = variables.options[ key ]
					}
				}
				return changed( manager.update( who, ref, fields ), "Changed" )
			case "pause":
				return changed( manager.pause( who, ref ), "Paused" )
			case "resume":
				return changed( manager.resume( who, ref ), "Resumed" )
			case "run":
				var outcome = changed( manager.run( who, ref ), "Marked due" )
				if ( outcome.exitCode == 0 ) {
					outcome.message &= char( 10 ) & "It starts at the next minute of a served app, not from this command."
				}
				return outcome
			case "delete":
				if ( !isOptionSet( "yes" ) ) {
					return fail( "This removes the routine and keeps its reports. Add --yes to go ahead: bxAgents routines delete #ref# --yes" )
				}
				return changed( manager.delete( who, ref ), "Deleted" )
			case "reports":
				return reportsOf( manager.reports( who, ref ) )
			case "report":
				var file = rest.len() > 1 ? rest[ 2 ] : ""
				if ( !len( file ) ) {
					throw( type = "BxAgents.MissingReportFile", message = "Say which file: bxAgents routines report #ref# <file>" )
				}
				var read = manager.report( who, ref, file )
				return read.succeeded() ? done( read.data().text & ( read.data().cut ? char( 10 ) & "(cut: the file is longer)" : "" ) ) : failed( read )
			default:
				return cleaning( manager, who, ref )
		}
	}

	// ----------------------------------------------------------------------------------

	/**
	 * @return The manager handed in by a test, else the one of the project's routines; null when they are not turned on
	 */
	private any function managerOfProject() {
		var given = option( "_manager", "" )
		if ( isObject( given ) ) {
			return given
		}
		var root = projectRoot()
		if ( !len( root ) || !new "models.build.AgentDefinitionLocator@bxagents"().exists( root ) ) {
			throw( type = "BxAgents.NotAnAgentProject", message = "No Agent.yml or Agent.bx found at [#root#] - run `routines` inside a BX Agents project, or pass --projectRoot" )
		}
		return new "models.routines.ProjectRoutines@bxagents"().managerFor( root )
	}

	private struct function listing( required any found ) {
		if ( !arguments.found.succeeded() ) {
			return failed( arguments.found )
		}
		var rows = arguments.found.data().routines
		return asJson( rows, () => listText( rows ) )
	}

	private string function listText( required array rows ) {
		if ( !arguments.rows.len() ) {
			return "No routines yet. Ask the agent to schedule one, or use: bxAgents routines add --name=... --schedule=... --prompt=..."
		}
		var withOwner = isOptionSet( "all" )
		return arguments.rows.map( r => ( withOwner ? padRight( r.ownerId, 14 ) : "" ) & padRight( r.name, 22 ) & padRight( r.scheduleText, 26 ) & padRight( r.statusText, 22 ) & ( len( r.nextRunText ) ? "next " & r.nextRunText : "no next run" ) ).toList( char( 10 ) )
	}

	private struct function showing( required any found ) {
		if ( !arguments.found.succeeded() ) {
			return failed( arguments.found )
		}
		var r = arguments.found.data().routine
		var report = [
			"Name:      " & r.name,
			"Schedule:  " & r.scheduleText & " (" & r.schedule & ")",
			"Status:    " & r.statusText,
			"Next run:  " & ( len( r.nextRunText ) ? r.nextRunText : "none" ),
			"Last run:  " & ( len( r.lastRunText ) ? r.lastRunText & ", " & r.lastStatus : "never" ),
			"Answers:   " & ( r.destination == "routine" ? "its own conversation (" & r.conversationId & ")" : r.destination & " " & r.destinationChat )
		]
		if ( len( r.lastError ) ) {
			report.append( "Last error: " & r.lastError )
		}
		report.append( "" )
		report.append( r.prompt ?: r.promptPreview )
		return lines( report )
	}

	private struct function changed( required any outcome, required string verb ) {
		if ( !arguments.outcome.succeeded() ) {
			return failed( arguments.outcome )
		}
		var r = arguments.outcome.data().routine ?: {}
		return done( arguments.verb & " routine" & ( r.keyExists( "name" ) ? " " & r.name : "" ) & "." & ( len( r.nextRunText ?: "" ) ? " Next run " & r.nextRunText & "." : "" ) )
	}

	private struct function reportsOf( required any found ) {
		if ( !arguments.found.succeeded() ) {
			return failed( arguments.found )
		}
		var files = arguments.found.data().files
		if ( !files.len() ) {
			return done( "No reports saved yet." )
		}
		return done( files.map( f => padRight( f.file, 40 ) & padRight( f.bytes & " bytes", 14 ) & dateTimeFormat( f.savedAt, "yyyy-MM-dd HH:mm" ) ).toList( char( 10 ) ) )
	}

	private struct function cleaning( required any manager, required any who, required string ref ) {
		var all = isOptionSet( "all" )
		var days = 0
		if ( !all ) {
			var olderThan = option( "older-than" )
			var match = reFindNoCase( "^(\d+)d?$", trim( olderThan ), 1, true )
			if ( match.pos.len() < 2 || match.pos[ 2 ] == 0 ) {
				throw( type = "BxAgents.MissingCleanRule", message = "Say which reports: --older-than=30d, or --all" )
			}
			days = int( mid( olderThan, match.pos[ 2 ], match.len[ 2 ] ) )
		}
		var apply = isOptionSet( "yes" )
		var cleaned = arguments.manager.cleanReports( arguments.who, arguments.ref, days, all, apply )
		if ( !cleaned.succeeded() ) {
			return failed( cleaned )
		}
		var removed = cleaned.data()
		if ( !removed.count ) {
			return done( "Nothing to clean." )
		}
		return done( apply
			? "Removed #removed.count# report(s), #removed.bytes# bytes."
			: "Would remove #removed.count# report(s), #removed.bytes# bytes: " & removed.files.map( f => f.file ).toList( ", " ) & char( 10 ) & "Add --yes to remove them." )
	}

	private struct function failed( required any outcome ) {
		return fail( arguments.outcome.reason() )
	}

}
