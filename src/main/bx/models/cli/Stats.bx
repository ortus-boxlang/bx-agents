/**
 * `stats` CLI verb - what the project's model calls used, from the record the app keeps in the shared chat database
 * (`data/chat.db`, or the file named by BXAGENTS_DB).
 *
 *   bxAgents stats [--days=30] [--by=model|provider|day|user] [--user=NAME] [--json]
 *   bxAgents stats --enable
 *
 * Recording is off unless Agent.yml says `usage: true`. When it is off the verb says how to turn it on, and
 * `--enable` writes that line for you (then rebuild for it to take effect). It never needs a built project: it only
 * reads the database. Only calls whose provider reported usage are counted.
 */
class extends="BaseVerb" {

	/**
	 * What this verb is: read by the dispatcher, the help, the completions and the reference page.
	 */
	struct function meta() {
		return {
			name : "stats",
			group : "OPERATE & SHIP",
			position : 2,
			description : "View model calls and token usage",
			usage : "[options]",
			options : [
				{ name : "days", display : "--days=<number>", description : "How many days to report. Default: 30.", takesValue : true },
				{ name : "by", display : "--by=<group>", description : "Group by model, provider, day, or user.", takesValue : true },
				{ name : "user", display : "--user=<name>", description : "Limit the report to one user.", takesValue : true },
				{ name : "enable", description : "Enable usage recording in Agent.yml." },
				{ name : "json", description : "Print the report as JSON." }
			],
			examples : [ "stats", "stats --by=provider --days=7" ],
			note : "Recording is off by default. After --enable, rebuild and restart the served app."
		}
	}

	function handle() {
		var usageSwitch = new "models.usage.UsageSwitch@bxagents"()

		if ( isOptionSet( "enable" ) ) {
			var switched = usageSwitch.enable( projectRoot() )
			return exitWith( switched.ok ? 0 : 1, switched.message )
		}

		var days = val( option( "days", 30 ) )
		if ( days < 1 || days > 3650 ) {
			throw( type = "BxAgents.InvalidStatsDays", message = "`--days` needs a number from 1 to 3650." )
		}
		var on = usageSwitch.isOn( projectRoot() )
		var by = option( "by", "model" )
		var report = new "models.usage.UsageStore@bxagents"( "" ).emptyReport( days, by )
		if ( fileExists( chatStoreFile() ) ) {
			var store = new "models.store.ChatStore@bxagents"( { driver : "sqlite", database : chatStoreFile() } )
			store.migrate()
			report = new "models.usage.UsageStore@bxagents"( store ).report( days, by, option( "user" ) )
		}

		if ( !isOptionSet( "json" ) && !on && !report.calls ) {
			return done( usageSwitch.howToEnable( true ) & char( 10 ) & "Run `bxAgents stats --enable` to turn it on." )
		}
		return asJson( { enabled : on, report : report }, () => new "models.usage.UsageLines@bxagents"().render( report, on ) )
	}

}
