/**
 * The list of conversations in the shared chat database: one row per conversation, owned by a user. The web chat's
 * sidebar and the terminal chat's /sessions read the same rows.
 *
 * It holds the index only (title, how many messages, when). The messages themselves live in the agent's memory,
 * keyed by ( userId, conversationId ), which is why a conversation survives a restart only when the agent's
 * memory does.
 *
 * Every read and write is scoped by the user: a conversation id comes from the client, so guessing one must not
 * be enough to read or rename somebody else's.
 */
class {

	static {
		TITLE_LENGTH = 60
		MAX_LIMIT    = 100
	}

	/**
	 * @store A ChatStore
	 */
	function init( required any store ) {
		variables.store = arguments.store
		return this
	}

	/**
	 * Records activity on a conversation, creating its row the first time.
	 *
	 * @userId Whose conversation
	 * @conversationId The conversation
	 * @firstMessage What the user said; the first one becomes the title
	 * @messageDelta Added to the message count (a turn is two: the question and the answer)
	 * @source Where it started (`web`, `terminal`, `api`, a gateway's platform); kept from the first call, never changed after
	 * @agent The agent it started with (blank is the main agent); kept from the first call, never changed after
	 *
	 * @return False when the id exists and belongs to someone else
	 */
	boolean function touch( required string userId, required string conversationId, string firstMessage = "", numeric messageDelta = 2, string source = "", string agent = "" ) {
		var owner = variables.store.rows( "SELECT userId, title, messageCount FROM conversations WHERE id = :id", { id : arguments.conversationId } )
		if ( owner.len() ) {
			if ( owner[ 1 ].userId != arguments.userId ) {
				return false
			}
			variables.store.exec(
				"UPDATE conversations SET updatedAt = :now, messageCount = :count, title = :title WHERE id = :id AND userId = :userId",
				{
					now    : { value : now(), cfsqltype : "timestamp" },
					count  : val( owner[ 1 ].messageCount ?: 0 ) + arguments.messageDelta,
					title  : len( owner[ 1 ].title ?: "" ) ? owner[ 1 ].title : titleOf( arguments.firstMessage ),
					id     : arguments.conversationId,
					userId : arguments.userId
				}
			)
			return true
		}
		variables.store.exec(
			"INSERT INTO conversations ( id, userId, title, messageCount, source, agent, createdAt, updatedAt ) VALUES ( :id, :userId, :title, :count, :source, :agent, :now, :now )",
			{
				id     : arguments.conversationId,
				userId : arguments.userId,
				title  : titleOf( arguments.firstMessage ),
				count  : arguments.messageDelta,
				source : arguments.source,
				agent  : arguments.agent,
				now    : { value : now(), cfsqltype : "timestamp" }
			}
		)
		return true
	}

	/**
	 * Every conversation on the server, whoever owns it, most recent first. For an admin's overview only: every other
	 * read here is scoped to one user.
	 *
	 * @source Only the conversations that started there; all when blank
	 *
	 * @return [ { id, userId, title, messageCount, source, createdAt, updatedAt } ]
	 */
	array function listAll( numeric limit = 50, string source = "" ) {
		var params = {}
		var only = ""
		if ( len( arguments.source ) ) {
			only = " WHERE source = :source"
			params[ "source" ] = arguments.source
		}
		return variables.store.rows(
			"SELECT id, userId, title, messageCount, source, agent, createdAt, updatedAt FROM conversations#only# ORDER BY updatedAt DESC, rowid DESC LIMIT #int( arguments.limit )#",
			params
		)
	}

	/**
	 * A page of conversations, filtered, with the count of everything that matches (so a client can page).
	 *
	 * @userId Whose; blank for everyone's (an admin's overview)
	 * @filters { limit?, offset?, q? (title contains), source?, agent? (a name, or an array of names), mainAgent? (the main agent's name, which a blank stored agent stands for), since? and before? (dates, on updatedAt) }
	 *
	 * @return { rows : [ { id, userId, title, messageCount, source, agent, createdAt, updatedAt } ], total, limit, offset }
	 */
	struct function search( string userId = "", struct filters = {} ) {
		var limit = max( 1, min( int( val( arguments.filters.limit ?: 25 ) ), static.MAX_LIMIT ) )
		var offset = max( 0, int( val( arguments.filters.offset ?: 0 ) ) )
		var params = {}
		var where = whereOf( arguments.userId, arguments.filters, "", params )
		var total = variables.store.rows( "SELECT COUNT(*) AS n FROM conversations#where#", params )
		var rows = variables.store.rows(
			"SELECT id, userId, title, messageCount, source, agent, createdAt, updatedAt FROM conversations#where# ORDER BY updatedAt DESC, rowid DESC LIMIT #limit# OFFSET #offset#",
			params
		)
		return { "rows" : rows, "total" : val( total[ 1 ].n ?: 0 ), "limit" : limit, "offset" : offset }
	}

	/**
	 * How many conversations there are per source and per agent. Each facet is counted with every filter except its
	 * own, so choosing a source still shows how many each other source would give.
	 *
	 * @return { source : { web : 120 }, agent : { "" : 3, researcher : 4 } }
	 */
	struct function facets( string userId = "", struct filters = {} ) {
		var out = {}
		for ( var column in [ "source", "agent" ] ) {
			var params = {}
			var where = whereOf( arguments.userId, arguments.filters, column, params )
			var counted = {}
			for ( var row in variables.store.rows( "SELECT #column# AS k, COUNT(*) AS n FROM conversations#where# GROUP BY #column#", params ) ) {
				counted[ row.k ?: "" ] = val( row.n )
			}
			out[ column ] = counted
		}
		return out
	}

	/**
	 * The WHERE clause of a filtered read, with its parameters added to `params`.
	 *
	 * @skip A filter to leave out (a facet is counted without its own)
	 */
	private string function whereOf( required string userId, required struct filters, required string skip, required struct params ) {
		var parts = []
		if ( len( arguments.userId ) ) {
			parts.append( "userId = :userId" )
			arguments.params[ "userId" ] = arguments.userId
		}
		var q = trim( arguments.filters.q ?: "" )
		if ( len( q ) ) {
			parts.append( "INSTR( LOWER( title ), :q ) > 0" )
			arguments.params[ "q" ] = lCase( q )
		}
		var source = trim( arguments.filters.source ?: "" )
		if ( len( source ) && arguments.skip != "source" ) {
			parts.append( "source = :source" )
			arguments.params[ "source" ] = source
		}
		var agents = arguments.filters.agent ?: ""
		agents = isArray( agents ) ? agents : ( len( trim( agents ) ) ? [ trim( agents ) ] : [] )
		// the main agent's conversations are stored with a blank agent, so asking for it by name also finds those
		if ( agents.len() && len( arguments.filters.mainAgent ?: "" ) && agents.contains( arguments.filters.mainAgent ) && !agents.contains( "" ) ) {
			agents.append( "" )
		}
		if ( agents.len() && arguments.skip != "agent" ) {
			var marks = []
			var at = 0
			for ( var name in agents ) {
				at++
				marks.append( ":agent#at#" )
				arguments.params[ "agent#at#" ] = name
			}
			parts.append( "agent IN ( #marks.toList()# )" )
		}
		for ( var edge in [ { key : "since", op : ">=" }, { key : "before", op : "<" } ] ) {
			var stamp = trim( arguments.filters[ edge.key ] ?: "" )
			if ( len( stamp ) && isDate( stamp ) ) {
				parts.append( "updatedAt #edge.op# :#edge.key#" )
				arguments.params[ edge.key ] = { value : parseDateTime( stamp ), cfsqltype : "timestamp" }
			}
		}
		return parts.len() ? " WHERE " & parts.toList( " AND " ) : ""
	}

	/**
	 * @source Only the conversations that started there (`web`, `terminal`, `api`, a gateway's platform); all when blank
	 *
	 * @return The user's conversations, most recent first: [ { id, title, messageCount, source, createdAt, updatedAt } ]
	 */
	array function list( required string userId, numeric limit = 20, string source = "" ) {
		var params = { userId : arguments.userId }
		var only = ""
		if ( len( arguments.source ) ) {
			only = " AND source = :source"
			params[ "source" ] = arguments.source
		}
		return variables.store.rows(
			"SELECT id, title, messageCount, source, agent, createdAt, updatedAt FROM conversations WHERE userId = :userId#only# ORDER BY updatedAt DESC, rowid DESC LIMIT #int( arguments.limit )#",
			params
		)
	}

	/**
	 * @return The conversation, or an empty struct when it does not exist or is not the user's
	 */
	struct function byId( required string userId, required string conversationId ) {
		var found = variables.store.rows(
			"SELECT id, title, messageCount, source, agent, createdAt, updatedAt FROM conversations WHERE id = :id AND userId = :userId",
			{ id : arguments.conversationId, userId : arguments.userId }
		)
		return found.len() ? found[ 1 ] : {}
	}

	/**
	 * The conversation to open for "continue": the user's most recent one.
	 *
	 * @return The conversation, or an empty struct when there is none
	 */
	struct function latest( required string userId ) {
		var found = list( arguments.userId, 1 )
		return found.len() ? found[ 1 ] : {}
	}

	/**
	 * Finds a conversation by what a person typed: its number in the list ( "2" ), or its id or the start of it.
	 *
	 * @reference "2", "a1b2c3", or a whole id
	 *
	 * @return The conversation, or an empty struct when nothing (or more than one) matches
	 */
	struct function resolve( required string userId, required string reference ) {
		var ref = trim( arguments.reference )
		if ( !len( ref ) ) {
			return {}
		}
		var recent = list( arguments.userId, 50 )
		if ( isNumeric( ref ) && ref >= 1 && ref <= recent.len() && len( ref ) < 4 ) {
			return recent[ int( ref ) ]
		}
		var matches = recent.filter( row => row.id == ref || row.id.startsWith( ref ) )
		return matches.len() == 1 ? matches[ 1 ] : {}
	}

	boolean function rename( required string userId, required string conversationId, required string title ) {
		if ( byId( arguments.userId, arguments.conversationId ).isEmpty() ) {
			return false
		}
		variables.store.exec(
			"UPDATE conversations SET title = :title, updatedAt = :now WHERE id = :id AND userId = :userId",
			{ title : arguments.title, now : { value : now(), cfsqltype : "timestamp" }, id : arguments.conversationId, userId : arguments.userId }
		)
		return true
	}

	boolean function delete( required string userId, required string conversationId ) {
		if ( byId( arguments.userId, arguments.conversationId ).isEmpty() ) {
			return false
		}
		variables.store.exec( "DELETE FROM conversations WHERE id = :id AND userId = :userId", { id : arguments.conversationId, userId : arguments.userId } )
		return true
	}

	/**
	 * Sets the count to what the conversation's memory holds. The count is not kept by adding to it: a memory keeps
	 * at most `maxMessages` of them and `/compact` shrinks it, so a running total would drift from what is there.
	 * Conversations works the number out and calls this.
	 *
	 * @userId Whose conversation
	 * @conversationId The conversation
	 * @count How many messages the memory holds for it
	 */
	void function setCount( required string userId, required string conversationId, required numeric count ) {
		variables.store.exec(
			"UPDATE conversations SET messageCount = :count, updatedAt = :now WHERE id = :id AND userId = :userId",
			{ count : int( arguments.count ), now : { value : now(), cfsqltype : "timestamp" }, id : arguments.conversationId, userId : arguments.userId }
		)
	}

	/**
	 * Sets the count to zero after the conversation's messages were cleared, so lists do not advertise history
	 * that is gone.
	 */
	void function resetCount( required string userId, required string conversationId ) {
		setCount( arguments.userId, arguments.conversationId, 0 )
	}

	/**
	 * A title is a label, not a preview: one line, cut at 60 characters.
	 */
	string function titleOf( required string message ) {
		var flat = reReplace( trim( arguments.message ), "[[:space:]]+", " ", "all" )
		return len( flat ) > static.TITLE_LENGTH ? left( flat, static.TITLE_LENGTH - 3 ) & "..." : flat
	}

}
