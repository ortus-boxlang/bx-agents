/**
 * `add model` - a named model configuration under `models/`: `researcher.yaml`,
 * `coder.json`, one provider, one model and the settings that go with them, which any
 * agent can then use by writing `model: researcher`. See models/build/NamedModels for the
 * keys.
 *
 * The API key is never typed here. By default the provider's usual environment variable
 * is used (OPENAI_API_KEY, ...); name another with --env when two models of one provider
 * need different keys, and only the variable's name is written down.
 */
class {

	struct function info() {
		return { name : "model", summary : "A named model configuration (models/<name>.yaml)" }
	}

	/**
	 * @answers An Answers
	 * @ctx The add context
	 *
	 * @return { name, description, provider, model, env, temperature, maxTokens, format, providerInfo }
	 */
	struct function ask( required any answers, required struct ctx ) {
		var a = arguments.answers
		var catalog = new "models.wizard.WizardCatalog@bxagents"()
		var parser = new "models.build.ModelSlugParser@bxagents"()
		var taken = ( arguments.ctx.project.report.models ?: [] ).map( m => m.name )

		var name = a.text(
			key      = "name",
			title    = "Name",
			help     = "What agents write after model:, e.g. researcher or coder.",
			required = true,
			validate = ( value ) => nameProblem( value, taken, parser )
		)
		var description = a.text( key = "description", title = "What is it for? (optional)", default = "" )

		// the providers the wizard knows well first, then every other one bx-ai has
		var choices = catalog.providers().map( p => { value : p.id, label : p.name, hint : p.hint } )
		var listed = choices.map( c => c.value )
		for ( var other in parser.coreProviders() ) {
			if ( !listed.contains( other ) ) {
				choices.append( { value : other, label : other, hint : other == "mock" ? "for tests: scripted answers, no network" : "" } )
			}
		}
		var provider = a.select( key = "provider", title = "Which provider?", choices = choices, default = "openai" )
		if ( !parser.isKnownProvider( provider ) ) {
			throw( type = "BxAgents.InvalidAnswer", message = "--provider: [#provider#] is not a provider. Use one of: #parser.coreProviders().toList( ', ' )#" )
		}
		var info = catalog.provider( provider )

		var model = a.text(
			key     = "model",
			title   = "Which model? (optional)",
			help    = "e.g. gpt-5-mini. Empty uses the provider's own default.",
			default = ""
		)

		var env = ""
		if ( len( info.envVar ?: "" ) ) {
			env = a.text(
				key      = "env",
				title    = "A different environment variable for its key? (optional)",
				help     = "Empty uses #info.envVar#. Name another when two models of this provider need different keys.",
				default  = "",
				validate = ( value ) => !len( value ) || reFind( "^[A-Z][A-Z0-9_]*$", value ) ? "" : "Capital letters, digits and underscores, e.g. RESEARCH_KEY."
			)
			if ( env == info.envVar ) {
				env = ""
			}
		}

		var temperature = a.text(
			key      = "temperature",
			title    = "Temperature? (optional)",
			help     = "How adventurous the answers are. Empty uses the provider's default.",
			default  = "",
			validate = ( value ) => !len( value ) || ( isNumeric( value ) && value >= 0 && value <= 2 ) ? "" : "A number from 0 to 2."
		)
		var maxTokens = a.text(
			key      = "max-tokens",
			title    = "Longest answer, in tokens? (optional)",
			default  = "",
			validate = ( value ) => !len( value ) || reFind( "^[1-9][0-9]*$", value ) ? "" : "A whole number."
		)
		var format = a.select( key = "format", title = "File format?", choices = [ "yaml", "json" ], default = "yaml" )

		return {
			name         : name,
			description  : description,
			provider     : provider,
			model        : model,
			env          : env,
			temperature  : temperature,
			maxTokens    : maxTokens,
			format       : format,
			providerInfo : info
		}
	}

	/**
	 * @answers The answers from ask()
	 * @ctx The add context
	 * @changes A ChangeSet
	 */
	void function plan( required struct answers, required struct ctx, required any changes ) {
		var a = arguments.answers
		var entry = {}
		if ( len( a.description ) ) {
			entry.description = a.description
		}
		entry.provider = a.provider
		if ( len( a.model ) ) {
			entry.model = a.model
		}
		if ( len( a.env ) ) {
			entry.apiKeyEnvVar = a.env
		}
		var params = {}
		if ( len( a.temperature ) ) {
			params.temperature = val( a.temperature )
		}
		if ( len( a.maxTokens ) ) {
			params.max_tokens = int( a.maxTokens )
		}
		if ( params.count() ) {
			entry.params = params
		}

		var order = [ "description", "provider", "model", "apiKeyEnvVar", "params" ]
		var path = "models/" & a.name & "." & a.format
		if ( a.format == "json" ) {
			var writer = new "models.wizard.FeatureWriter@bxagents"()
			arguments.changes.file( path, writer.prettyJson( entry ) & char( 10 ) )
		} else {
			var lines = new "models.wizard.YamlWriter@bxagents"().lines( entry, 0, order )
			arguments.changes.file( path, lines.toList( char( 10 ) ) & char( 10 ) )
		}

		var keyVar = len( a.env ) ? a.env : ( a.providerInfo.envVar ?: "" )
		if ( len( keyVar ) ) {
			var note = len( a.providerInfo.keyUrl ?: "" ) ? "## #a.providerInfo.name# API key. Get one at #a.providerInfo.keyUrl##char( 10 )#" : ""
			arguments.changes.append( ".env", char( 10 ) & note & keyVar & "=" & char( 10 ), keyVar & "=" )
		}
	}

	/**
	 * @return [ text ] what is left to do
	 */
	array function next( required struct answers, required struct ctx ) {
		var a = arguments.answers
		var out = [ "Use it in an agent's Agent.yaml: model: #a.name#" ]
		var keyVar = len( a.env ) ? a.env : ( a.providerInfo.envVar ?: "" )
		if ( len( keyVar ) ) {
			out.append( "Set #keyVar# in .env." )
		}
		if ( len( a.providerInfo.setup ?: "" ) ) {
			out.append( a.providerInfo.setup )
		}
		out.append( "Check it with: bxAgents inspect --section=models" )
		return out
	}

	// --------------------------------------------------------------------------

	private string function nameProblem( required string value, required array taken, required any parser ) {
		if ( !reFind( "^[A-Za-z][A-Za-z0-9_-]*$", arguments.value ) ) {
			return "[#arguments.value#] must start with a letter and use only letters, digits, - and _."
		}
		if ( arguments.parser.isKnownProvider( arguments.value ) ) {
			return "[#arguments.value#] is the name of a provider, so model: #arguments.value# would mean the provider itself. Pick another name."
		}
		if ( arguments.taken.findNoCase( arguments.value ) ) {
			return "A model named #arguments.value# already exists."
		}
		return ""
	}

}
