/**
 * `add schedule` - adds a scheduler to `schedules/` that sends an agent a message on a schedule. Three
 * questions matter: when it runs, what it asks the agent and which agent. Overlapping runs are always
 * prevented, so that is not asked.
 *
 * Every schedule is its own BoxLang scheduler file, `schedules/<Name>.bx` (see SchedulerGenerator), so adding
 * one never edits another file: an existing file of that name is a conflict, and `--force` replaces it.
 */
import bxModules.bxagents.models.util.NameRules;

class {

	struct function info() {
		return { name : "schedule", summary : "Run an agent on a schedule (a scheduler file in schedules/)" }
	}

	/**
	 * @answers An Answers
	 * @ctx The add context
	 *
	 * @return { name, when : { kind, call, summary }, prompt, agent, binding }
	 */
	struct function ask( required any answers, required struct ctx ) {
		var a = arguments.answers
		var when = new "models.add.ScheduleWhen@bxagents"()

		var phrase = ""
		if ( a.interactive() && !a.given( "when" ) ) {
			phrase = askWhen( a, when )
		} else {
			phrase = a.text(
				key      = "when",
				title    = "When should it run?",
				help     = "e.g. every 15 minutes, daily 09:00, weekdays 08:30, weekly mon 09:00, monthly 1 09:00, or a cron expression like 0 9 * * 1-5",
				required = true,
				validate = ( value ) => whenProblem( when, value )
			)
		}
		var parsed = when.parse( phrase )

		var taken = arguments.ctx.project.taskNames
		var name = a.text(
			key      = "name",
			title    = "Task name",
			help     = "How it shows up in the scheduler and its logs.",
			default  = slug( parsed.summary ),
			validate = ( value ) => nameProblem( value, taken )
		)

		var prompt = a.text(
			key      = "prompt",
			title    = "What should the agent do each time?",
			help     = "The message it is sent, e.g. Summarize today's findings.",
			required = true
		)

		var agent = "."
		var choices = [ { value : ".", label : "The root agent", hint : arguments.ctx.project.agentNames[ "." ] } ]
		for ( var sub in arguments.ctx.project.subagents ) {
			choices.append( { value : sub, label : sub, hint : arguments.ctx.project.agentNames[ sub ] ?: sub } )
		}
		if ( choices.len() > 1 ) {
			agent = a.select( key = "agent", title = "Which agent runs it?", choices = choices, default = "." )
		} else if ( ( arguments.ctx.options.agent ?: "." ) != "." ) {
			throw( type = "BxAgents.InvalidAnswer", message = "--agent: this project has no subagents" )
		}

		return {
			name    : name,
			when    : parsed,
			prompt  : prompt,
			agent   : agent,
			binding : arguments.ctx.project.agentNames[ agent ]
		}
	}

	/**
	 * Builds the phrase from a few questions, so nobody has to remember it.
	 *
	 * @a An Answers that can ask
	 * @when A ScheduleWhen
	 *
	 * @return A phrase ScheduleWhen.parse() accepts
	 */
	private string function askWhen( required any a, required any when ) {
		var ans = arguments.a
		var when = arguments.when
		var kind = ans.select( key = "_kind", title = "How often?", choices = when.kinds(), default = "daily" )
		var time = ( key ) => ans.text(
			key      = key,
			title    = "At what time?",
			help     = "24 hour HH:mm, e.g. 09:00 or 17:30.",
			default  = "09:00",
			validate = ( value ) => reFind( "^([01]?[0-9]|2[0-3]):[0-5][0-9]$", value ) ? "" : "Use a 24 hour time like 09:00."
		)

		switch ( kind ) {
			case "every":
				var n = ans.text(
					key = "_n", title = "How many?", default = "15",
					validate = ( value ) => reFind( "^[1-9][0-9]*$", value ) ? "" : "A whole number, 1 or more."
				)
				var unit = ans.select( key = "_unit", title = "Of what?", choices = [ "minutes", "hours", "days" ], default = "minutes" )
				return "every #n# #unit#"
			case "hourly":
				var minute = ans.text(
					key = "_minute", title = "At which minute past the hour?", help = "0 is on the hour.", default = "0",
					validate = ( value ) => reFind( "^[0-9]{1,2}$", value ) && int( value ) <= 59 ? "" : "A minute from 0 to 59."
				)
				return minute == "0" ? "hourly" : "hourly :#minute#"
			case "weekly":
				var day = ans.select(
					key = "_day", title = "On which day?", default = "mon",
					choices = [
						{ value : "mon", label : "Monday" }, { value : "tue", label : "Tuesday" }, { value : "wed", label : "Wednesday" },
						{ value : "thu", label : "Thursday" }, { value : "fri", label : "Friday" }, { value : "sat", label : "Saturday" },
						{ value : "sun", label : "Sunday" }
					]
				)
				return "weekly #day# #time( '_time' )#"
			case "monthly":
				var dom = ans.text(
					key = "_dom", title = "On which day of the month?", help = "1 to 28.", default = "1",
					validate = ( value ) => reFind( "^[0-9]{1,2}$", value ) && int( value ) >= 1 && int( value ) <= 28 ? "" : "A day from 1 to 28."
				)
				return "monthly #dom# #time( '_time' )#"
			case "cron":
				return ans.text(
					key = "_cron", title = "Cron expression", help = "minute hour day-of-month month day-of-week, e.g. 0 9 * * 1-5. A sixth field in front adds seconds.",
					required = true,
					validate = ( value ) => whenProblem( when, value )
				)
			default:
				return "#kind# #time( '_time' )#"
		}
	}

	/**
	 * @answers The answers from ask()
	 * @ctx The add context
	 * @changes A ChangeSet
	 */
	void function plan( required struct answers, required struct ctx, required any changes ) {
		arguments.changes.file( "schedules/" & fileName( arguments.answers.name ) & ".bx", renderScheduler( arguments.answers ) )
	}

	/**
	 * @return [ text ] what is left to do
	 */
	array function next( required struct answers, required struct ctx ) {
		var runs = arguments.answers.agent == "." ? "the root agent" : "the agent named #arguments.answers.binding#"
		return [
			"It runs #arguments.answers.when.summary# while the app is served: bxAgents build, then bxAgents serve.",
			"It sends #runs# a message, so that agent's name must stay as it is.",
			"Check it with: bxAgents inspect --section=schedule"
		]
	}

	// --------------------------------------------------------------------------

	/**
	 * @name The task name, e.g. daily-digest
	 *
	 * @return The scheduler's file name without extension, e.g. DailyDigest: it becomes the class name
	 */
	private string function fileName( required string name ) {
		return arguments.name.listToArray( "-_" ).map( part => ucase( left( part, 1 ) ) & mid( part, 2, len( part ) ) ).toList( "" )
	}

	private string function renderScheduler( required struct answers ) {
		var tab = char( 9 )
		// the root agent is the default agent; any other is asked for by the name it declares
		var target = arguments.answers.agent == "." ? "run(" : 'agent( "' & literal( arguments.answers.binding ) & '" ).run('
		return [
			"class {",
			"",
			tab & "function configure() {",
			tab & tab & 'task( "' & literal( arguments.answers.name ) & '" )',
			tab & tab & tab & arguments.answers.when.call,
			tab & tab & tab & ".call( () => " & target & ' "' & literal( arguments.answers.prompt ) & '" ) )',
			tab & tab & tab & ".withNoOverlaps()",
			tab & "}",
			"",
			"}",
			""
		].toList( char( 10 ) )
	}

	/**
	 * A BoxLang string: quotes are doubled and a hash sign would start interpolation.
	 */
	private string function literal( required string text ) {
		return arguments.text
			.replace( char( 10 ), " ", "all" )
			.replace( '"', '""', "all" )
			.replace( char( 35 ), char( 35 ) & char( 35 ), "all" )
	}

	private string function slug( required string text ) {
		return arguments.text.lcase().reReplace( "[^a-z0-9]+", "-", "all" ).reReplace( "^-+|-+$", "", "all" )
	}

	private string function whenProblem( required any when, required string value ) {
		try {
			arguments.when.parse( arguments.value )
			return ""
		} catch ( BxAgents.InvalidSchedule e ) {
			return e.message
		}
	}

	private string function nameProblem( required string value, required array taken ) {
		if ( !NameRules::isValid( arguments.value ) ) {
			return "[#arguments.value#] must start with a letter and use only letters, digits, - and _."
		}
		if ( arguments.taken.findNoCase( arguments.value ) ) {
			return "A task named #arguments.value# already exists in schedules/."
		}
		return ""
	}

}
