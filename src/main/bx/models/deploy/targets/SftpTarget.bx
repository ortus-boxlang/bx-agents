/**
 * Ships the newest packaged `.bxa` to a remote server over SFTP, via the
 * real `bx:ftp` component (`bx-ftp` module - see `BaseFtpTarget.bx`, which
 * holds the actual shared implementation) - password or SSH key
 * authentication, matching bx-ftp's own real SFTP support.
 *
 * @config { host (required), username (required), passwordEnvVar OR key (one required), remotePath (required), port, passphraseEnvVar, fingerprint, timeout }
 */
class implements="models.deploy.IDeploymentTarget@bxagents" {

	struct function deploy( required struct config, required struct context ) {
		return new "models.deploy.targets.BaseFtpTarget@bxagents"()
			.performDeploy( arguments.config, arguments.context, true )
	}

}
