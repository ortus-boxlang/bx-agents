/**
 * Ships the newest packaged `.bxa` to a remote server over plain FTP, via
 * the real `bx:ftp` component (`bx-ftp` module - see `BaseFtpTarget.bx`,
 * which holds the actual shared implementation).
 *
 * @config { host (required), username (required), passwordEnvVar (required), remotePath (required), port, passive, proxyServer, timeout }
 */
class implements="models.deploy.IDeploymentTarget@bxagents" {

	/**
	 * @config This target's own resolved `deploy/*` entry (see the class docblock's `@config` shape)
	 * @context { projectRoot, appDir, distDir, manifest } - only `distDir` is used, to locate the newest `.bxa`
	 *
	 * @return { success, message, details: { host, remoteFile, bxa } }
	 */
	struct function deploy( required struct config, required struct context ) {
		return new "models.deploy.targets.BaseFtpTarget@bxagents"()
			.performDeploy( arguments.config, arguments.context, false )
	}

}
