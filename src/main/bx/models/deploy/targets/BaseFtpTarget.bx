/**
 * Shared logic for the `ftp` and `sftp` deploy targets (M16) - both call
 * the same real `bx:ftp` component provided by the `bx-ftp` BoxLang module
 * (moduleName `ftp`, a genuine runtime dependency of this project now,
 * declared in `ext.boxlangModules` - not vendored, the same relationship
 * this project already has with `bx-ai`), differing only in the `secure`
 * flag passed to it (`false` = plain FTP, `true` = SFTP) and which extra
 * authentication/connection options each protocol supports.
 *
 * `bx:ftp`'s own declared `port` attribute defaults to 21 REGARDLESS of
 * `secure` (confirmed via bx-ftp's real source, `FTP.java`/`BaseFTPConnection.java` -
 * there is no automatic 21-vs-22 switching), so `buildConnectAttributes()`
 * supplies its OWN protocol-aware port default (21 for ftp, 22 for sftp)
 * whenever a project doesn't set one explicitly.
 *
 * `passwordEnvVar`/`passphraseEnvVar` name environment variables holding the
 * real secret - NEVER the secret value itself - resolved live at deploy time
 * via `getSystemSetting()`, matching this project's "secrets stay external"
 * rule (a real, previously unfixed bug had these read as raw plaintext
 * values straight out of `deploy/*.bx` config, which could end up committed
 * to version control - see docs/known-limitations.md). Both may only name a
 * variable in the deploy-scoped `BXAGENTS_` namespace (see
 * `resolveSecretEnvVar()`), so a `deploy/*` entry - which is plain data a
 * reviewer reads as inert config - can never point an arbitrary `host` at an
 * unrelated environment secret. `key` stays a plain config field since it's
 * already a PATH to a key file the caller manages themselves, never key
 * material - the same convention `ssh`'s `identityFile` uses.
 *
 * Ships the newest packaged `.bxa` (via `DistArtifactLocator`, same as
 * `local`/`ssh`) to `remotePath` - a remote DIRECTORY, not a full file path;
 * the uploaded file keeps its own name, mirroring how `ssh`'s `scp` target
 * works - using a throwaway, uniquely-named connection that's always closed
 * in a `finally` block, even on failure.
 *
 * Any `IOException` `bx:ftp` throws (connection refused, auth failure, a
 * negative FTP/SFTP reply) is caught and re-thrown as a clear
 * `BxAgents.DeployFailed` - confirmed via bx-ftp's own source that EVERY
 * action throws on failure rather than ever returning a graceful
 * `succeeded: false` result, so there is no soft-failure path that also
 * needs checking after a call succeeds without throwing (the `succeeded`
 * check below is defense-in-depth only, matching bx-ftp's own documented
 * usage pattern).
 */
class {

	/**
	 * @config The `ftp`/`sftp` target's own resolved `deploy/*` entry
	 * @context { projectRoot, appDir, distDir, manifest } - only `distDir` is used, to locate the newest `.bxa`
	 * @secure false = ftp, true = sftp
	 *
	 * @return { success, message, details: { host, remoteFile, bxa } }
	 */
	struct function performDeploy( required struct config, required struct context, required boolean secure ) {
		var protocol = arguments.secure ? "sftp" : "ftp"
		var host = trim( arguments.config.host ?: "" )
		var username = trim( arguments.config.username ?: "" )
		var remotePath = trim( arguments.config.remotePath ?: "" )
		var passwordEnvVar = trim( arguments.config.passwordEnvVar ?: "" )
		var key = trim( arguments.config.key ?: "" )

		if ( !len( host ) || !len( username ) || !len( remotePath ) ) {
			throw(
				type    = "BxAgents.InvalidDeployConfig",
				message = "deploy target '#protocol#' requires 'host', 'username', and 'remotePath'"
			)
		}
		if ( !arguments.secure && !len( passwordEnvVar ) ) {
			throw( type = "BxAgents.InvalidDeployConfig", message = "deploy target 'ftp' requires a 'passwordEnvVar'" )
		}
		if ( arguments.secure && !len( passwordEnvVar ) && !len( key ) ) {
			throw( type = "BxAgents.InvalidDeployConfig", message = "deploy target 'sftp' requires a 'passwordEnvVar' or a 'key'" )
		}

		var newest = new "models.deploy.DistArtifactLocator@bxagents"().newestBxa( arguments.context.distDir )
		var bxaName = getFileFromPath( newest )
		var remoteFile = buildRemoteFile( remotePath, bxaName )
		var connectionName = "bxagentsDeploy" & createUUID().replace( "-", "", "all" )
		var connectAttrs = buildConnectAttributes( arguments.config, connectionName, arguments.secure )
		var opened = false

		try {
			bx:ftp action="open" attributeCollection="#connectAttrs#";
			opened = true

			var putResult = ""
			bx:ftp action="putfile" connection="#connectionName#" localFile="#newest#" remoteFile="#remoteFile#" result="putResult";

			if ( !( putResult.succeeded ?: false ) ) {
				throw(
					type    = "BxAgents.DeployFailed",
					message = "#protocol# upload to #host# failed: #putResult.statusText ?: ( putResult.errorText ?: '' )#"
				)
			}
		} catch ( any e ) {
			if ( e.type == "BxAgents.DeployFailed" ) {
				rethrow;
			}
			throw(
				type    = "BxAgents.DeployFailed",
				message = "#protocol# deploy to #host# failed: #e.message#"
			)
		} finally {
			if ( opened ) {
				try {
					bx:ftp action="close" connection="#connectionName#";
				} catch ( any ignore ) {
					// best-effort cleanup - the upload's own outcome already
					// determined success/failure above
				}
			}
		}

		return {
			success : true,
			message : "Deployed #bxaName# to #protocol#://#host#/#remoteFile#",
			details : { host : host, remoteFile : remoteFile, bxa : bxaName }
		}
	}

	/**
	 * @remotePath The config's remote DIRECTORY (not a full file path)
	 * @bxaName The `.bxa` filename being uploaded, which keeps its own name remotely
	 *
	 * @return The full remote file path to upload to
	 */
	string function buildRemoteFile( required string remotePath, required string bxaName ) {
		return arguments.remotePath.reReplace( "[\/]+$", "" ) & "/" & arguments.bxaName
	}

	/**
	 * Pure - builds the attribute struct passed to `bx:ftp action="open" attributeCollection="..."`.
	 * `passwordEnvVar`/`passphraseEnvVar` are resolved into real secret
	 * values here (via `resolveSecretEnvVar()`, which refuses any variable
	 * outside the deploy-scoped `BXAGENTS_` namespace) - every other field
	 * renders straight through from `config`.
	 *
	 * @config The `ftp`/`sftp` target's own resolved `deploy/*` entry
	 * @connectionName A unique name for this `bx:ftp` connection, so concurrent deploys never collide
	 * @secure false = ftp, true = sftp
	 *
	 * @return The attribute struct for `bx:ftp action="open" attributeCollection="..."`
	 */
	struct function buildConnectAttributes( required struct config, required string connectionName, required boolean secure ) {
		var attrs = {
			connection : arguments.connectionName,
			server     : arguments.config.host,
			port       : arguments.config.port ?: ( arguments.secure ? 22 : 21 ),
			username   : arguments.config.username,
			timeout    : arguments.config.timeout ?: 30,
			secure     : arguments.secure
		}

		var passwordEnvVar = trim( arguments.config.passwordEnvVar ?: "" )
		if ( len( passwordEnvVar ) ) {
			attrs.password = resolveSecretEnvVar( "passwordEnvVar", passwordEnvVar )
		}

		if ( arguments.secure ) {
			if ( len( arguments.config.key ?: "" ) ) {
				attrs.key = arguments.config.key
			}
			var passphraseEnvVar = trim( arguments.config.passphraseEnvVar ?: "" )
			if ( len( passphraseEnvVar ) ) {
				attrs.passphrase = resolveSecretEnvVar( "passphraseEnvVar", passphraseEnvVar )
			}
			if ( len( arguments.config.fingerprint ?: "" ) ) {
				attrs.fingerprint = arguments.config.fingerprint
			}
		} else {
			attrs.passive = arguments.config.passive ?: true
			if ( len( arguments.config.proxyServer ?: "" ) ) {
				attrs.proxyServer = arguments.config.proxyServer
			}
		}

		return attrs
	}

	/**
	 * Resolves ONE deploy secret out of the process environment, refusing any
	 * variable name outside the deploy-scoped `BXAGENTS_` namespace.
	 *
	 * A `deploy/*` entry is DATA, not code - a pure-JSON file reads as inert
	 * config in review - yet `host` and `passwordEnvVar` together decide which
	 * secret leaves this machine and where it goes. Without this check, an
	 * entry naming an unrelated variable (`ANTHROPIC_API_KEY`, `GITHUB_TOKEN`,
	 * ...) would hand that secret to an arbitrary `host` as an FTP password -
	 * in the CLEAR for `secure : false`. Constraining the NAME is what keeps a
	 * deploy entry unable to reach any secret that wasn't provisioned for
	 * deploying, so the blast radius of a malicious (or simply mistaken)
	 * `deploy/*` entry is the deploy credentials themselves and nothing else.
	 * The same rule applies to every secret this target resolves
	 * (`passwordEnvVar` AND `passphraseEnvVar`) - `key`/`fingerprint` stay
	 * unchecked, since neither is secret material (a path and a public host
	 * key fingerprint).
	 *
	 * @configField The `deploy/*` field the name came from, quoted back in the error
	 * @envVarName The environment variable NAME the config supplied - never a value
	 *
	 * @return The environment variable's value, or "" when it isn't set - throwing
	 *         `BxAgents.InvalidDeployConfig` instead when the name is out of namespace
	 */
	string function resolveSecretEnvVar( required string configField, required string envVarName ) {
		if ( !reFind( "^BXAGENTS_[A-Z0-9_]+$", arguments.envVarName ) ) {
			throw(
				type    = "BxAgents.InvalidDeployConfig",
				message = "deploy config '#arguments.configField#' names the environment variable [#arguments.envVarName#], which is outside the deploy-scoped namespace. A deploy entry may only resolve variables named BXAGENTS_<NAME> (uppercase letters, digits and underscores only), e.g. 'BXAGENTS_FTP_PASSWORD' - so a deploy config can never reach an unrelated secret in the environment. Export the deploy credential under a BXAGENTS_-prefixed name and point '#arguments.configField#' at that."
			)
		}

		return getSystemSetting( arguments.envVarName, "" )
	}

}
