import bxModules.bxagents.models.connectors.ConnectorEndpoint;
import bxModules.bxagents.models.connectors.ConnectorSettings;

/**
 * Builds what the connectors need once for the running application and hands the same parts to everything that asks: the
 * agent API, the terminal and the gateways. One set of per person MCP clients, one record of who connected what.
 *
 * The parts are kept in the `application` scope under one key, so a request never makes its own. A part that reads
 * the vault or the chat database is made from the app's own store.
 */
class {

	/**
	 * The parts, made on first use.
	 *
	 * @agent The AiAgent that gets the connectors' tools
	 * @policy { mode, toolWarning, available, excluded, shadowed } as the build resolved it
	 * @options { apiPath : where the agent API is served, store : a ChatStore (default: the app's), vault : a VaultService, programExists, clientFactory }
	 *
	 * @return { policy, settings, vault, oauth, service, clients, tools, runtime }
	 */
	struct function stackOf( required any agent, required struct policy, struct options = {} ) {
		if ( !application.keyExists( "bxagentsConnectors" ) ) {
			lock name = "bxagents-connector-stack" timeout = 30 type = "exclusive" {
				if ( !application.keyExists( "bxagentsConnectors" ) ) {
					application[ "bxagentsConnectors" ] = build( arguments.agent, arguments.policy, arguments.options )
				}
			}
		}
		return application.bxagentsConnectors
	}

	/**
	 * Forgets the parts, closing the clients. For a restart of the application and for tests.
	 */
	void function reset() {
		if ( application.keyExists( "bxagentsConnectors" ) ) {
			try {
				application.bxagentsConnectors.clients.close()
			} catch ( any e ) {
				// nothing to close
			}
			application.delete( "bxagentsConnectors" )
		}
	}

	/**
	 * Gives the agent what it needs to offer connectors: the filter that keeps a person's tools to the ones they may
	 * use, and the connectors somebody had connected before a restart. Nothing is contacted for a connector nobody has
	 * connected.
	 *
	 * @agent The AiAgent
	 * @config The agent's config as far as the `connectors:` key goes ({} offers every connector)
	 * @options As stackOf()
	 *
	 * @return The agent
	 */
	any function attach( required any agent, struct config = {}, struct options = {} ) {
		var policy = ConnectorSettings::resolve( arguments.config )
		if ( !policy.available.len() ) {
			return arguments.agent
		}
		var stack = stackOf( arguments.agent, policy, arguments.options )
		arguments.agent.withMiddleware( new "models.connectors.ConnectorToolMiddleware@bxagents"( stack.service, stack.tools ) )
		try {
			stack.runtime.restore()
		} catch ( any e ) {
			writeLog( text = "Could not attach the connectors somebody had connected: #e.message#", type = "error", log = "ai" )
		}
		return arguments.agent
	}

	// ----------------------------------------------------------------------------------

	/**
	 * @agent The AiAgent
	 * @policy The resolved policy
	 * @options As stackOf()
	 *
	 * @return The parts
	 */
	private struct function build( required any agent, required struct policy, required struct options ) {
		var store = arguments.options.store ?: new "models.store.ChatStore@bxagents"( "" )
		var vault = arguments.options.vault ?: new "models.vault.VaultWiring@bxagents"().serviceFor( store )
		var settings = new "models.connectors.ConnectorSettingsStore@bxagents"( store )
		var oauth = new "models.connect.ConnectionService@bxagents"(
			ConnectorEndpoint::oauthEntries( arguments.policy.available ?: [] ),
			{ apiPath : arguments.options.apiPath ?: "/__bxagents", agent : arguments.agent }
		)
		var signedIn = ( id, person ) => oauth.list( person ).some( s => s.name == id && s.connected )
		var deps = { vault : vault, signedIn : signedIn }
		if ( arguments.options.keyExists( "programExists" ) ) {
			deps.programExists = arguments.options.programExists
		}
		var service = new "models.connectors.ConnectorService@bxagents"( arguments.policy, settings, deps )
		var holder = {}
		var theAgent = arguments.agent
		var clients = new "models.connectors.ConnectorClients@bxagents"(
			( id, person ) => tokenOf( vault, service, id, person ),
			1800,
			{ endpointFor : ( id, person ) => holder.tools.endpointFor( id, person ), toolGate : ( id, person, tool ) => holder.tools.gate( id, person, tool ) }
		)
		holder.tools = new "models.connectors.ConnectorTools@bxagents"( service, settings, clients, { ownTools : () => ( theAgent.getConfig().toolCount ?: 0 ) } )
		var runtime = new "models.connectors.ConnectorRuntime@bxagents"(
			arguments.agent, service, clients,
			{ settings : settings, vault : vault, oauthRefresh : () => oauth.refresh() }
		)
		return { policy : arguments.policy, settings : settings, vault : vault, oauth : oauth, service : service, clients : clients, tools : holder.tools, runtime : runtime }
	}

	/**
	 * A person's own token for a connector, locked to the connector's host. Empty when they have none.
	 *
	 * @vault A VaultService
	 * @service The ConnectorService
	 * @id The connector
	 * @person The person
	 *
	 * @return The token, or an empty string
	 */
	private string function tokenOf( required any vault, required any service, required string id, required string person ) {
		var entry = arguments.service.entryOf( arguments.id )
		var method = ( entry.auth ?: [] ).filter( m => m.type == "bearer" )
		if ( !method.len() || ( entry.transport ?: "" ) != "http" ) {
			return ""
		}
		var host = reReplace( entry.url, "^https?://([^/:]+).*$", "\1" )
		try {
			return arguments.vault.resolve( method[ 1 ].envVar, { user : arguments.person, host : host, via : "connectors" } )
		} catch ( any e ) {
			return ""
		}
	}

}
