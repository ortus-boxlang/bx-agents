/**
 * Stands in for ConnectorRuntime in a command that does not run the agent: a connection is saved, and the agent attaches it
 * when it starts (ConnectorRuntime.restore()). Nothing is started here.
 */
class {

	/**
	 * @return False: nothing is attached by this command
	 */
	boolean function attach( required string id, required string person ) {
		return false
	}

	/**
	 * @id The connector
	 *
	 * @return False: nothing runs here, so there is nothing to start or stop
	 */
	boolean function sync( required string id ) {
		return false
	}

	/**
	 * @return Nothing cleaned: the agent is not running here, so it cleans what a disconnect marked when it starts
	 */
	struct function purgeAnswers( required string id, required string person ) {
		return { purged : 0, pending : 0 }
	}

	/**
	 * @return None
	 */
	array function attached() {
		return []
	}

	/**
	 * @return The tools of a connector that is not attached
	 *
	 * @throws BxAgents.NotConnected always: the tools are listed by the running agent
	 */
	array function toolsOf( required string id ) {
		throw( type = "BxAgents.NotConnected", message = "The tools of [#arguments.id#] are listed by the running agent. Open the chat (`bxAgents chat`) and type: connect #arguments.id# tools" )
	}

	/**
	 * Nothing to close.
	 */
	void function close() {
	}

}
