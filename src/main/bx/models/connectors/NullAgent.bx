/**
 * An agent that is not running, for a command that works with the connectors of a project without starting it (`bxAgents
 * connect`). It has no tools and keeps none: what a person connects is read by the real agent when it starts.
 */
class {

	/**
	 * @return This: a server is not attached to an agent that is not running
	 */
	any function withMCPServer( required any mcpServer, struct config = {} ) {
		return this
	}

	/**
	 * @return This
	 */
	any function withMiddleware( required any middleware ) {
		return this
	}

	/**
	 * @return No servers
	 */
	array function listMCPServers() {
		return []
	}

	/**
	 * @return No settings
	 */
	struct function getConfig() {
		return {}
	}

}
