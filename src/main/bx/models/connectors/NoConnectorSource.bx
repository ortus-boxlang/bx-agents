/**
 * Stands in for the connectors of a chat whose agent offers none, or whose server does not have the routes.
 */
class {

	/**
	 * @return False: there is nothing to connect to
	 */
	boolean function available() {
		return false
	}

	/**
	 * @return Why there is nothing to connect to
	 */
	string function why() {
		return "No connector is offered and no MCP server of this agent asks people to sign in. Offer connectors under `connectors:` in Agent.yaml, or add `oauth: true` to an mcpServers entry."
	}

}
