/**
 * The extensions of a served agent (`bxAgents serve`, a deployed app), started once when the app starts.
 *
 *   - loads the extensions the build copied into the app (`<app>/extensions`), with the settings
 *     Agent.yaml gave them (`<app>/config/extensions.json`). The person's own folder is never read here:
 *     a server does not look in a developer's home.
 *   - puts the commands, the built-ins and the extensions', in `application.bxagentsCommands`, which the
 *     web page, the HTTP command route and the chat platforms answer with (CommandCatalog.forApplication)
 *   - registers each extension's schedulers with ColdBox's scheduler service and starts them, so a
 *     schedule an extension brings runs inside the served app like the project's own `schedules/`
 *
 * The extension's merged settings are in the ColdBox setting `bxAgentsExtensionSettings`, under the
 * extension's name, before its scheduler's `configure()` runs.
 */
class {

	/**
	 * @appDir The generated app's folder
	 */
	function init( required string appDir ) {
		variables.appDir = arguments.appDir.reReplace( "[\\/]+$", "" )
		variables.service = nullValue()
		return this
	}

	/**
	 * @controller ColdBox's controller (application.cbController); the schedulers are registered with it
	 *
	 * @return this
	 */
	function start( required any controller ) {
		var commands = new "models.chat.commands.CommandCatalog@bxagents"().standard()
		variables.service = new "models.extensions.ExtensionService@bxagents"(
			projectRoot     : "",
			userConfig      : new "models.cli.UserConfig@bxagents"( variables.appDir & "/config/no-user-config.yml" ),
			transport       : "web",
			projectSettings : settings(),
			projectFolder   : variables.appDir & "/extensions"
		)
		variables.service.install( commands )
		application.bxagentsCommands = commands
		application.bxagentsExtensions = variables.service
		for ( var problem in variables.service.problems() ) {
			arguments.controller.getLogBox().getLogger( this ).warn( problem )
		}
		startSchedulers( arguments.controller )
		return this
	}

	/**
	 * Unloads the extensions (`onUnload()` of each) and stops their schedulers.
	 */
	function stop( any controller ) {
		if ( !isNull( arguments.controller ) ) {
			for ( var name in variables.schedulerNames ?: [] ) {
				arguments.controller.getSchedulerService().removeScheduler( name )
			}
		}
		if ( !isNull( variables.service ) ) {
			variables.service.unload()
		}
		return this
	}

	/**
	 * @return The ExtensionService, once started
	 */
	any function service() {
		return variables.service
	}

	// ----------------------------------------------------------------------------------

	/**
	 * @return The `extensions:` block the build wrote (an empty struct when there is none)
	 */
	private struct function settings() {
		var file = variables.appDir & "/config/extensions.json"
		if ( !fileExists( file ) ) {
			return {}
		}
		var parsed = jsonDeserialize( fileRead( file ) )
		return isStruct( parsed ) ? parsed : {}
	}

	private void function startSchedulers( required any controller ) {
		variables.schedulerNames = []
		var schedulers = variables.service.registry().schedulers()
		if ( !schedulers.len() ) {
			return
		}
		var byExtension = {}
		for ( var extension in variables.service.registry().extensions() ) {
			if ( extension.isLoaded() ) {
				byExtension[ extension.name() ] = extension.settings()
			}
		}
		arguments.controller.setSetting( "bxAgentsExtensionSettings", byExtension )
		var service = arguments.controller.getSchedulerService()
		for ( var scheduler in schedulers ) {
			var name = "extension-#scheduler.extension#-#scheduler.name#"
			try {
				var loaded = service.loadScheduler( name, invocationPath( scheduler.path ) )
				startScheduler( loaded )
				variables.schedulerNames.append( name )
			} catch ( any e ) {
				arguments.controller.getLogBox().getLogger( this ).error( "The scheduler #scheduler.name# of the extension #scheduler.extension# did not start: #e.message#" )
			}
		}
	}

	/**
	 * Starts one scheduler. A scheduler loaded this way inherits ColdBox's base class virtually, and its
	 * `startup()` can finish its work and then fail the return type of the base method (seen on a real
	 * boot: the tasks were scheduled and the scheduler reported "has started" before the cast threw), so
	 * what counts is whether it started.
	 */
	private void function startScheduler( required any scheduler ) {
		try {
			arguments.scheduler.startup()
		} catch ( any e ) {
			if ( !arguments.scheduler.hasStarted() ) {
				rethrow
			}
		}
	}

	/**
	 * `<app>/extensions/standup/schedulers/Reminder.bx` is `extensions.standup.schedulers.Reminder` to WireBox
	 */
	private string function invocationPath( required string file ) {
		var relative = replace( arguments.file, "\", "/", "all" ).replace( replace( variables.appDir, "\", "/", "all" ) & "/", "" )
		return relative.reReplace( "\.bx$", "" ).replace( "/", ".", "all" )
	}

}
