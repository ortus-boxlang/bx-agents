/**
 * Puts the extensions of a chat in place: decides where to look, reads what the people said about them,
 * and loads them into the commands the chat already has. One call for the terminal chat, the served
 * agent and a chat platform, so each is a line long and none knows how layers or settings work.
 *
 *   extensions = new ExtensionService( projectRoot : root ).install( commands )
 *
 * Where it looks, weakest first:
 *   modules   `extensions/` of every installed BoxLang module that has one
 *   user      `~/.bxagents/extensions` (next to the person's bxAgents.yml). Only the terminal chat: a served
 *             agent or a chat platform never reads a developer's home folder.
 *   project   `<project>/extensions`
 *
 * What the people said: the `extensions:` block of the person's `bxAgents.yml` and, over it, the project's
 * `Agent.yaml` (see ExtensionSettings). Whatever is wrong in either (an extension that will not load, a
 * file that is not YAML) is returned by `problems()`; it never stops the chat from starting.
 */
class {

	/**
	 * @projectRoot The project's folder; blank for none
	 * @userConfig The person's UserConfig; ~/.bxagents/bxAgents.yml when not given
	 * @transport "tui", "web" or "gateway"; only "tui" reads the user layer
	 * @moduleFolders The `extensions/` folders of installed modules; found from the runtime when not given
	 * @projectSettings The project's `extensions:` block; read from Agent.yaml when not given
	 * @projectFolder The project layer's folder; `<projectRoot>/extensions` when not given. A served app keeps its copy elsewhere.
	 */
	function init( string projectRoot = "", any userConfig, string transport = "tui", array moduleFolders, struct projectSettings, string projectFolder = "" ) {
		variables.projectFolder = len( arguments.projectFolder ) ? arguments.projectFolder.reReplace( "[\\/]+$", "" ) : ( len( arguments.projectRoot ) ? arguments.projectRoot.reReplace( "[\\/]+$", "" ) & "/extensions" : "" )
		variables.projectRoot = arguments.projectRoot.reReplace( "[\\/]+$", "" )
		variables.userConfig = isNull( arguments.userConfig ) ? new "models.cli.UserConfig@bxagents"() : arguments.userConfig
		variables.transport = arguments.transport
		variables.moduleFolders = isNull( arguments.moduleFolders ) ? installedModuleFolders() : arguments.moduleFolders
		variables.projectSettings = isNull( arguments.projectSettings ) ? nullValue() : arguments.projectSettings
		variables.registry = nullValue()
		variables.problems = []
		return this
	}

	/**
	 * Loads the extensions and adds their commands to the registry.
	 *
	 * @commands The CommandRegistry the chat uses
	 *
	 * @return this
	 */
	function install( required any commands ) {
		var settings = new "models.extensions.ExtensionSettings@bxagents"().combine( [ variables.userConfig.extensions(), projectBlock() ] )
		variables.registry = new "models.extensions.ExtensionRegistry@bxagents"( arguments.commands, settings )
		for ( var folder in variables.moduleFolders ) {
			variables.registry.addLayer( "modules", folder )
		}
		if ( variables.transport == "tui" ) {
			variables.registry.addLayer( "user", getDirectoryFromPath( variables.userConfig.path() ) & "extensions" )
		}
		if ( len( variables.projectFolder ) ) {
			variables.registry.addLayer( "project", variables.projectFolder )
		}
		variables.registry.load()
		arguments.commands.replace( new "models.extensions.ExtensionsCommand@bxagents"( this ) )
		return this
	}

	/**
	 * Takes the extensions out again: `onUnload()` of each, and their commands out of the registry.
	 */
	function unload() {
		if ( !isNull( variables.registry ) ) {
			variables.registry.unload()
		}
		return this
	}

	/**
	 * @return The ExtensionEvents, once install() has run: the chat announces its events through it
	 */
	any function events() {
		return variables.registry.events()
	}

	/**
	 * @return The ExtensionRegistry, once install() has run
	 */
	any function registry() {
		return variables.registry
	}

	/**
	 * @return The keys extensions bind, as the screen takes them: [ { id, does, keys } ]
	 */
	array function keys() {
		return isNull( variables.registry ) ? [] : variables.registry.keys().map( k => k.describe() )
	}

	/**
	 * The prefixes and sources of the loaded extensions, with the person's choices applied.
	 *
	 * @return An ExtensionComposer
	 */
	any function composer() {
		if ( isNull( variables.registry ) ) {
			return new "models.extensions.ExtensionComposer@bxagents"()
		}
		return new "models.extensions.ExtensionComposer@bxagents"( variables.registry.prefixes(), variables.registry.sources(), variables.userConfig.prefixes(), variables.userConfig.sources() )
	}

	/**
	 * Runs the action of a key an extension bound.
	 *
	 * @id The key's id, such as "release:deploy"
	 * @context The CommandContext
	 * @commands The CommandRegistry
	 *
	 * @return A Reply, or null when no extension has that id
	 */
	any function pressed( required string id, required any context, required any commands ) {
		for ( var key in isNull( variables.registry ) ? [] : variables.registry.keys() ) {
			if ( key.id() == arguments.id ) {
				return key.run( arguments.context, arguments.commands )
			}
		}
	}

	/**
	 * @context The CommandContext
	 *
	 * @return [ { name, text } ] for every status item that has something to show
	 */
	array function statusItems( required any context ) {
		var shown = []
		for ( var status in isNull( variables.registry ) ? [] : variables.registry.statuses() ) {
			var text = status.text( arguments.context )
			if ( len( text ) ) {
				shown.append( { name : status.name(), text : text } )
			}
		}
		return shown
	}

	/**
	 * @return The status items on one line, such as "main · build ok"
	 */
	string function statusLine( required any context ) {
		return statusItems( arguments.context ).map( i => i.text ).toList( " · " )
	}

	/**
	 * @return The plain facts about each extension (see Extension.describe)
	 */
	array function report() {
		return isNull( variables.registry ) ? [] : variables.registry.report()
	}

	/**
	 * @return Sentences about what is wrong: a settings file that cannot be read, and each extension that did not load
	 */
	array function problems() {
		var all = variables.problems.append( variables.userConfig.problems(), true )
		if ( !isNull( variables.registry ) ) {
			all.append( variables.registry.events().problems(), true )
		}
		for ( var extension in report() ) {
			if ( extension.state == "failed" ) {
				all.append( "Extension [#extension.name#] did not load: #extension.problems.toList( ' ' )#" )
			}
		}
		return all
	}

	// ----------------------------------------------------------------------------------

	private struct function projectBlock() {
		if ( !isNull( variables.projectSettings ) ) {
			return variables.projectSettings
		}
		if ( !len( variables.projectRoot ) || !new "models.build.AgentDefinitionLocator@bxagents"().exists( variables.projectRoot ) ) {
			return {}
		}
		try {
			var config = new "models.build.AgentConfigResolver@bxagents"().resolve( variables.projectRoot )
			return isStruct( config.extensions ?: "" ) ? config.extensions : {}
		} catch ( any e ) {
			variables.problems.append( "Could not read the project's extensions settings: #e.message#" )
			return {}
		}
	}

	/**
	 * The `extensions/` folder of every installed BoxLang module that has one.
	 */
	private array function installedModuleFolders() {
		var folders = []
		try {
			for ( var name in getModuleList().keyArray() ) {
				var path = getModuleInfo( name ).path ?: ""
				if ( len( path ) && directoryExists( path & "/extensions" ) ) {
					folders.append( path & "/extensions" )
				}
			}
		} catch ( any e ) {
			// no module service to ask: there are no module extensions then
		}
		return folders
	}

}
