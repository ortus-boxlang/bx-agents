/**
 * Adapts a SlackGateway instance to `java.net.http.WebSocket.Listener` by
 * directly implementing the interface - `implements="java:..."` compiles
 * this class as a real JVM implementer of `WebSocket.Listener`, confirmed
 * empirically by handing an instance straight to
 * `HttpClient.newWebSocketBuilder().buildAsync( uri, listener )` with no
 * proxy/casting error (only the expected `java.net.ConnectException` once
 * the real network boundary was reached). Since the JVM class only overrides
 * the methods actually declared here, `onBinary`/`onPing`/`onPong` fall
 * through to the JDK interface's own `default` implementations automatically
 * - no `createDynamicProxy()` indirection needed.
 *
 * Because `onOpen()`/`onText()` ARE overridden here, THIS class is
 * responsible for the `webSocket.request(1)` calls the JDK's own defaults
 * would otherwise make - `java.net.http.WebSocket` uses a Reactive-Streams-
 * style backpressure model where each `request(n)` permits exactly n more
 * `onText`/`onBinary` deliveries. Forgetting either call silently stalls
 * the connection after the very first frame (confirmed via `javap` against
 * the JDK's own `WebSocket.Listener` interface - `onOpen`'s and every other
 * default method's real implementation calls `webSocket.request(1)`).
 *
 * Wired up as:
 *   listener = new SlackSocketListener( this )
 *   ws       = httpClient.newWebSocketBuilder().buildAsync( uri, listener ).get()
 */
class implements="java:java.net.http.WebSocket$Listener" {

	property name="gateway";
	property name="buffer";

	/**
	 * @gateway The SlackGateway instance to forward every callback to
	 */
	function init( required any gateway ) {
		variables.gateway = arguments.gateway
		variables.buffer  = createObject( "java", "java.lang.StringBuilder" ).init()
		return this
	}

	/**
	 * WebSocket.Listener.onOpen() override - immediately requests the first
	 * frame (see class-level docblock on why this class must do so itself),
	 * then forwards the open event to the gateway.
	 *
	 * @webSocket The websocket that just opened
	 */
	function onOpen( required any webSocket ) {
		arguments.webSocket.request( 1 )
		variables.gateway.handleSocketOpen( arguments.webSocket )
	}

	/**
	 * WebSocket.Listener.onText() override - requests the next part, accumulates
	 * it, and forwards the COMPLETE message to the gateway only once `last` is
	 * true.
	 *
	 * The buffering is not optional: the JDK's `WebSocket.Listener` contract
	 * delivers a text message in as many parts as it likes (`last` is false on
	 * every part but the final one), independently of how the server framed it.
	 * Forwarding each part straight to the gateway means a large Socket Mode
	 * frame reaches `jsonDeserialize()` truncated, throws, and is swallowed by
	 * that method's own catch - so the event is silently dropped AND its
	 * envelope never acked, which Slack then retries.
	 *
	 * @webSocket The websocket the part arrived on
	 * @data This part's text payload (a CharSequence)
	 * @last Whether this part completes the current message
	 *
	 * @return null - already handled synchronously, no CompletionStage to await
	 */
	function onText( required any webSocket, required any data, required boolean last ) {
		arguments.webSocket.request( 1 )
		variables.buffer.append( arguments.data.toString() )

		if ( arguments.last ) {
			var complete = variables.buffer.toString()
			variables.buffer.setLength( 0 )
			variables.gateway.handleSocketText( arguments.webSocket, complete )
		}

		return null
	}

	/**
	 * WebSocket.Listener.onClose() override - forwards the close event to the
	 * gateway, which decides whether to reconnect.
	 *
	 * @webSocket The websocket that closed
	 * @statusCode The close status code
	 * @reason The close reason
	 *
	 * @return null - already handled synchronously, no CompletionStage to await
	 */
	function onClose( required any webSocket, required numeric statusCode, required string reason ) {
		variables.gateway.handleSocketClose( arguments.statusCode, arguments.reason )
		return null
	}

	/**
	 * WebSocket.Listener.onError() override - forwards the error to the
	 * gateway.
	 *
	 * @webSocket The websocket that errored
	 * @error The underlying Throwable
	 */
	function onError( required any webSocket, required any error ) {
		variables.gateway.handleSocketError( arguments.error )
	}

}
