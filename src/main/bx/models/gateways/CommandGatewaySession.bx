/**
 * bx-ai's GatewaySession with commands in front of the agent. A message that is a command the
 * session offers (/info, /help, ...) is answered by the command layer and never reaches the model;
 * everything else goes to the agent exactly as before, so a slash that is not one of ours, in a chat
 * where people type slashes, is still just a message.
 *
 * Commands are on by default and limited to a safe set that needs no conversation of its own. The
 * agent block of a project can narrow it or widen it:
 *
 *   gatewaySession:
 *     commands:
 *       enabled: true
 *       prefix: "/"
 *       prefixes: { slack: "!" }       # a different prefix for one gateway, by its name
 *       conversation: true             # also /new, /clear, /compact, /sessions and /resume
 *       allow: [ help, info, tools, notes, remember, model ]
 *       admins: [ "12345" ]            # gateway user ids that may run admin commands
 */
import bxModules.bxai.models.gateway.IGateway;
import bxModules.bxai.models.gateway.contracts.GatewayMessage;
import bxModules.bxai.models.gateway.contracts.GatewayEvent;

class extends="bxModules.bxai.models.gateway.GatewaySession" {

	static {
		SAFE_COMMANDS = [ "help", "info", "tools", "model", "ping", "notes", "remember" ]
		// they act on the chat's one shared conversation, so they are opt-in (commands.conversation: true)
		CONVERSATION_COMMANDS = [ "new", "clear", "compact", "sessions", "resume" ]
	}

	/**
	 * @commands { enabled, prefix, prefixes, conversation, allow, admins, registry, sessions }, all optional
	 *
	 * The other arguments are GatewaySession's own.
	 */
	function init( required any agent, required any gateways, string policy = "queue", numeric maxQueueDepth = 50, any checkpointer, struct commands = {} ) {
		var own = { agent : arguments.agent, gateways : arguments.gateways, policy : arguments.policy, maxQueueDepth : arguments.maxQueueDepth }
		if ( !isNull( arguments.checkpointer ) ) {
			own.checkpointer = arguments.checkpointer
		}
		super.init( argumentCollection = own )

		variables.commandsOn = arguments.commands.enabled ?: true
		variables.prefix = arguments.commands.prefix ?: "/"
		variables.prefixes = arguments.commands.prefixes ?: {}
		variables.admins = arguments.commands.admins ?: []
		// a registry can be handed in whole (a module's own commands); otherwise the built-ins, narrowed to the allowed ones
		variables.registry = arguments.commands.registry ?: new "models.chat.commands.CommandCatalog@bxagents"().standard().only( arguments.commands.allow ?: ( ( arguments.commands.conversation ?: false ) ? static.SAFE_COMMANDS.merge( static.CONVERSATION_COMMANDS ) : static.SAFE_COMMANDS ) )
		// the conversations each person has had here, for /sessions and /resume; a store can be handed in
		variables.sessions = arguments.commands.sessions ?: new "models.gateways.MemorySessions@bxagents"()
		// where each chat is now: /new and /resume move it to another thread
		variables.threads = new "models.gateways.ChatThreads@bxagents"()
		variables.service = new "models.chat.commands.CommandService@bxagents"( agent : arguments.agent, sessions : variables.sessions, registry : variables.registry )
		// the choices last offered to each person in each chat, so "2" can answer a numbered list
		variables.pendingChoices = {}
		return this
	}

	/**
	 * @return The commands this session answers, [ { name, hint } ]
	 */
	array function commandMenu() {
		return variables.registry.menu( "gateway", true )
	}

	/**
	 * Hands the command menu to each gateway that can show one to its users (Telegram's "/" list), once.
	 * A gateway that cannot, or that fails, is skipped: a missing menu must never stop the bot answering.
	 *
	 * @return The names of the gateways that took the menu
	 */
	array function publishMenus() {
		var taken = []
		if ( !variables.commandsOn ) {
			return taken
		}
		var menu = commandMenu()
		for ( var name in variables.gateways ) {
			var gateway = variables.gateways[ name ]
			if ( !structKeyExists( gateway, "publishCommands" ) ) {
				continue
			}
			try {
				if ( gateway.publishCommands( menu ) ) {
					taken.append( name )
				}
			} catch ( any e ) {
				// the menu is a courtesy
			}
		}
		variables.menusPublished = true
		return taken
	}

	any function handleInbound( required GatewayMessage message, required IGateway sourceGateway ) {
		if ( variables.commandsOn && !( variables.menusPublished ?: false ) ) {
			publishMenus()
		}
		if ( variables.commandsOn && arguments.message.getType() == "message" ) {
			arguments.message = answerNumberedChoice( arguments.message )
			var line = new "models.chat.commands.CommandLine@bxagents"( arguments.message.getText(), prefixFor( arguments.message.getContext() ) )
			if ( line.isCommand() && !isNull( variables.registry.lookup( line.name() ) ) ) {
				answer( arguments.message, arguments.sourceGateway, line )
				return nullValue()
			}
		}
		var done = super.handleInbound( arguments.message, arguments.sourceGateway )
		if ( variables.commandsOn && arguments.message.getType() == "message" ) {
			// keep the conversation on the list, so /sessions shows it
			variables.sessions.touch(
				len( arguments.message.getContext().getUserID() ) ? arguments.message.getContext().getUserID() : "gateway",
				resolveThreadId( arguments.message, arguments.sourceGateway ),
				arguments.message.getText()
			)
		}
		return done
	}

	/**
	 * The thread a message belongs to: the one its chat was moved to by /new or /resume, else the platform's own.
	 */
	string function resolveThreadId( required GatewayMessage message, required IGateway sourceGateway ) {
		var moved = variables.threads.current( chatKey( arguments.message.getContext() ) )
		return len( moved ) ? moved : super.resolveThreadId( arguments.message, arguments.sourceGateway )
	}

	// ----------------------------------------------------------------------------------

	private string function chatKey( required any context ) {
		return arguments.context.getGateway() & "|" & arguments.context.getConversationID() & "|" & arguments.context.getThreadID()
	}

	/**
	 * A reply of just a number, right after a numbered list of choices, picks that choice: "2" becomes the
	 * command line behind the second option. This is how platforms with no buttons (SMS, Telegram, Signal)
	 * answer a "pick one". Anything else typed forgets the list, so a stray "2" much later is just a message.
	 *
	 * @message The inbound message
	 *
	 * @return The same message, or one whose text is the command line of the option picked
	 */
	private any function answerNumberedChoice( required GatewayMessage message ) {
		var key = choiceKey( arguments.message.getContext() )
		var options = variables.pendingChoices[ key ] ?: []
		variables.pendingChoices.delete( key )
		var typed = trim( arguments.message.getText() )
		if ( options.len() && reFind( "^[0-9]{1,3}$", typed ) && val( typed ) >= 1 && val( typed ) <= options.len() ) {
			return new GatewayMessage(
				text   : options[ val( typed ) ].line,
				context: arguments.message.getContext(),
				raw    : arguments.message.getRaw()
			)
		}
		return arguments.message
	}

	/**
	 * @context The message's context
	 *
	 * @return The command prefix for the gateway the message came from: its own, or the session's
	 */
	private string function prefixFor( required any context ) {
		return variables.prefixes[ arguments.context.getGateway() ] ?: variables.prefix
	}

	private string function choiceKey( required any context ) {
		return arguments.context.getGateway() & "|" & arguments.context.getConversationID() & "|" & arguments.context.getUserID()
	}

	/**
	 * Runs the command and sends its answer back through the gateway the message came from. A command that
	 * fails is told to the person, not thrown into the gateway's thread.
	 */
	private void function answer( required GatewayMessage message, required IGateway sourceGateway, required any line ) {
		var context = arguments.message.getContext()
		var who = len( context.getUserID() ) ? context.getUserID() : "gateway"
		var text = ""
		try {
			var reply = variables.service.execute(
				who,
				resolveThreadId( arguments.message, arguments.sourceGateway ),
				// the command layer always reads the slash
				"/" & arguments.line.name() & " " & arguments.line.args(),
				"gateway",
				variables.admins.containsNoCase( who )
			)
			var choose = reply.blocks.filter( b => b.type == "choose" )
			if ( choose.len() ) {
				// a gateway with buttons shows the first pick-one as buttons; the rest is text
				if ( sendAsButtons( arguments.sourceGateway, choose[ 1 ], context ) ) {
					reply.blocks = reply.blocks.filter( b => b.type != "choose" )
				} else {
					variables.pendingChoices[ choiceKey( context ) ] = choose[ 1 ].options
				}
			}
			// a command that moved the chat to another conversation (/new, /resume) takes its next messages there
			if ( len( reply.conversationId ?: "" ) && reply.conversationId != resolveThreadId( arguments.message, arguments.sourceGateway ) ) {
				variables.threads.use( chatKey( context ), reply.conversationId )
			}
			text = new "models.chat.commands.PlainRenderer@bxagents"().render( reply )
			if ( reply.blocks.filter( b => b.type == "choose" ).len() ) {
				text &= char( 10 ) & "Reply with a number to pick one."
			}
		} catch ( any e ) {
			text = "That command did not work: " & e.message
		}
		if ( !len( text ) ) {
			return
		}
		arguments.sourceGateway.deliver(
			new GatewayEvent( type : GatewayEvent.TYPES.RESPONSE_COMPLETED, data : { content : text }, context : context ),
			context
		)
	}

	/**
	 * @gateway The gateway the message came from
	 * @choose A "choose" block of a reply: { title, options: [ { label, hint, line } ] }
	 * @context Who to send to
	 *
	 * @return True when the gateway showed the choice natively (buttons, a list); false when it cannot
	 */
	private boolean function sendAsButtons( required any gateway, required struct choose, required any context ) {
		if ( !structKeyExists( arguments.gateway, "deliverChoices" ) ) {
			return false
		}
		try {
			return arguments.gateway.deliverChoices( arguments.choose.title ?: "", arguments.choose.options, arguments.context )
		} catch ( any e ) {
			return false
		}
	}

}
