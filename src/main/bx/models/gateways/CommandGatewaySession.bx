/**
 * bx-ai's GatewaySession with commands in front of the agent. A message that is a command the
 * session offers (/info, /help, ...) is answered by the command layer and never reaches the model;
 * everything else goes to the agent exactly as before, so a slash that is not one of ours, in a chat
 * where people type slashes, is still just a message.
 *
 * Commands are on by default and limited to a safe set that needs no conversation of its own. The
 * agent block of a project can narrow it or widen it:
 *
 *   gatewaySession:
 *     commands:
 *       enabled: true
 *       prefix: "/"
 *       prefixes: { slack: "!" }       # a different prefix for one gateway, by its name
 *       conversation: true             # also /new, /clear, /compact, /sessions and /resume
 *       allow: [ help, info, tools, notes, remember, model ]
 *       admins: [ "12345" ]            # gateway user ids that may run admin commands
 *
 * Each person's chats are their own: the agent is given the person (`slack:U123`, the platform and the user id
 * there) and the thread, so memory, notes and the conversation list are kept apart, and the conversations are in
 * the same list the web page and the terminal show, marked with the platform they started on.
 */
import bxModules.bxai.models.gateway.IGateway;
import bxModules.bxai.models.gateway.contracts.GatewayMessage;
import bxModules.bxai.models.gateway.contracts.GatewayEvent;

class extends="bxModules.bxai.models.gateway.GatewaySession" {

	static {
		// connect acts for the person who sends it and changes nothing shared: it gives them a link to sign in to a service
		SAFE_COMMANDS = [ "help", "info", "tools", "model", "ping", "notes", "remember", "connect" ]
		// they act on the chat's one shared conversation, so they are opt-in (commands.conversation: true)
		CONVERSATION_COMMANDS = [ "new", "clear", "compact", "sessions", "resume" ]
	}

	/**
	 * @commands { enabled, prefix, prefixes, conversation, allow, admins, registry, sessions }, all optional
	 *
	 * The other arguments are GatewaySession's own.
	 */
	function init( required any agent, required any gateways, string policy = "queue", numeric maxQueueDepth = 50, any checkpointer, struct commands = {}, boolean attachments = true, any intake, any store ) {
		var own = { agent : arguments.agent, gateways : arguments.gateways, policy : arguments.policy, maxQueueDepth : arguments.maxQueueDepth }
		if ( !isNull( arguments.checkpointer ) ) {
			own.checkpointer = arguments.checkpointer
		}
		super.init( argumentCollection = own )

		variables.attachmentsOn = arguments.attachments
		variables.intake = isNull( arguments.intake ) ? new "models.gateways.support.AttachmentIntake@bxagents"() : arguments.intake
		variables.commandsOn = arguments.commands.enabled ?: true
		variables.prefix = arguments.commands.prefix ?: "/"
		variables.prefixes = arguments.commands.prefixes ?: {}
		variables.admins = arguments.commands.admins ?: []
		// a registry can be handed in whole (a module's own commands); otherwise the app's commands (the built-ins and its extensions'), narrowed to the allowed ones
		variables.registry = arguments.commands.registry ?: new "models.chat.commands.CommandCatalog@bxagents"().forApplication().only( arguments.commands.allow ?: ( ( arguments.commands.conversation ?: false ) ? static.SAFE_COMMANDS.merge( static.CONVERSATION_COMMANDS ) : static.SAFE_COMMANDS ) )
		// the conversations, for /sessions and /resume: the shared chat database, the same list the web page and the terminal show
		variables.sessions = arguments.commands.sessions ?: new "models.store.SessionStore@bxagents"( isNull( arguments.store ) ? new "models.store.ChatStore@bxagents"( "" ) : arguments.store )
		// where each chat is now: /new and /resume move it to another thread
		variables.threads = new "models.gateways.ChatThreads@bxagents"()
		// the chats this app has heard from, so a routine can write to one later (see GatewayChats)
		variables.chats = new "models.gateways.GatewayChats@bxagents"( isNull( arguments.store ) ? new "models.store.ChatStore@bxagents"( "" ) : arguments.store )
		variables.service = new "models.chat.commands.CommandService@bxagents"( agent : arguments.agent, sessions : variables.sessions, registry : variables.registry )
		// the choices last offered to each person in each chat, so "2" can answer a numbered list
		variables.pendingChoices = {}
		return this
	}

	/**
	 * @return The commands this session answers, [ { name, hint } ]
	 */
	array function commandMenu() {
		return variables.registry.menu( "gateway", true )
	}

	/**
	 * Hands the command menu to each gateway that can show one to its users (Telegram's "/" list), once.
	 * A gateway that cannot, or that fails, is skipped: a missing menu must never stop the bot answering.
	 *
	 * @return The names of the gateways that took the menu
	 */
	array function publishMenus() {
		var taken = []
		if ( !variables.commandsOn ) {
			return taken
		}
		var menu = commandMenu()
		for ( var name in variables.gateways ) {
			var gateway = variables.gateways[ name ]
			if ( !structKeyExists( gateway, "publishCommands" ) ) {
				continue
			}
			try {
				if ( gateway.publishCommands( menu ) ) {
					taken.append( name )
				}
			} catch ( any e ) {
				// the menu is a courtesy
			}
		}
		variables.menusPublished = true
		return taken
	}

	any function handleInbound( required GatewayMessage message, required IGateway sourceGateway ) {
		if ( arguments.message.getType() == "message" ) {
			variables.chats.seen( arguments.message.getContext() )
		}
		if ( variables.commandsOn && !( variables.menusPublished ?: false ) ) {
			publishMenus()
		}
		if ( variables.commandsOn && arguments.message.getType() == "message" ) {
			arguments.message = answerNumberedChoice( arguments.message )
			var line = new "models.chat.commands.CommandLine@bxagents"( arguments.message.getText(), prefixFor( arguments.message.getContext() ) )
			if ( line.isCommand() && !isNull( variables.registry.lookup( line.name() ) ) ) {
				answer( arguments.message, arguments.sourceGateway, line )
				return nullValue()
			}
		}
		if ( variables.attachmentsOn && arguments.message.getType() == "message" ) {
			var taken = takeAttachments( arguments.message, arguments.sourceGateway )
			if ( taken.stop ) {
				return nullValue()
			}
			arguments.message = taken.message
		}
		var done = super.handleInbound( arguments.message, arguments.sourceGateway )
		if ( variables.commandsOn && arguments.message.getType() == "message" ) {
			// keep the conversation on the list, so /sessions shows it
			variables.sessions.touch(
				personOf( arguments.message.getContext() ),
				resolveConversationId( arguments.message, arguments.sourceGateway ),
				isSimpleValue( arguments.message.getText() ) ? arguments.message.getText() : "",
				2,
				arguments.message.getContext().getGateway()
			)
		}
		return done
	}

	/**
	 * Reads the files that came with a message, when its gateway can say what they are (attachmentsOf()), and
	 * turns them into what the agent is given: pictures as image parts, text files in the message, the rest
	 * named and left out. What was left out, and why, is told to the person. A message that was only a file
	 * nothing could use stops here, since there is nothing to ask the agent.
	 *
	 * @return { message : the message to go on with, stop : true when it was answered here }
	 */
	private struct function takeAttachments( required GatewayMessage message, required IGateway sourceGateway ) {
		var unchanged = { message : arguments.message, stop : false }
		if ( !structKeyExists( arguments.sourceGateway, "attachmentsOf" ) ) {
			return unchanged
		}
		var files = []
		try {
			files = arguments.sourceGateway.attachmentsOf( arguments.message )
		} catch ( any e ) {
			return unchanged
		}
		if ( !files.len() ) {
			return unchanged
		}
		var facts = {}
		try {
			facts = new "models.runtime.ModelFacts@bxagents"().of( variables.agent.getConfig().profile ?: "" )
		} catch ( any e ) {
			// the model's abilities are not known; the builder lets the image through then
		}
		var taken = variables.intake.intake( arguments.message.getText(), files, facts )
		if ( !taken.ok ) {
			tell( arguments.message, arguments.sourceGateway, taken.reason )
			return { message : arguments.message, stop : true }
		}
		if ( taken.notes.len() ) {
			tell( arguments.message, arguments.sourceGateway, taken.notes.toList( char( 10 ) ) )
		}
		if ( !taken.images && !taken.files && !len( trim( arguments.message.getText() ) ) ) {
			return { message : arguments.message, stop : true }
		}
		return { message : new "models.gateways.support.MultipartMessage@bxagents"( arguments.message, taken.input ), stop : false }
	}

	private void function tell( required GatewayMessage message, required IGateway sourceGateway, required string text ) {
		arguments.sourceGateway.deliver(
			new GatewayEvent( type : GatewayEvent.TYPES.RESPONSE_COMPLETED, data : { text : arguments.text, content : arguments.text }, context : arguments.message.getContext() ),
			arguments.message.getContext()
		)
	}

	/**
	 * The conversation a message belongs to, which is what the agent's memory and the conversation list are keyed by:
	 * the one its chat was moved to by /new or /resume, else the chat (with its platform thread, when it has one),
	 * namespaced by the gateway. The thread id of bx-ai's resolveThreadId() is left alone: it names a run.
	 */
	string function resolveConversationId( required GatewayMessage message, required IGateway sourceGateway ) {
		var moved = variables.threads.current( chatKey( arguments.message.getContext() ) )
		if ( len( moved ) ) {
			return moved
		}
		var context = arguments.message.getContext()
		var chat = arguments.sourceGateway.getName() & ":" & context.getConversationID()
		return len( context.getThreadID() ) ? chat & ":" & context.getThreadID() : chat
	}

	// ----------------------------------------------------------------------------------

	/**
	 * bx-ai's own turn, with one difference: the agent is told whose conversation it is. bx-ai runs a turn with only
	 * the thread id, which puts every chat on every platform in one memory bucket; the agent's memory is keyed by
	 * ( user, conversation ), so each turn here names both, and the conversation list can find the messages again.
	 * Everything else is bx-ai's, line for line. Delete this when bx-ai keys its turns itself
	 * (https://github.com/ortus-boxlang/bx-ai/pull/332): its turnOptions() then calls the resolveConversationId() above.
	 */
	private void function dispatchTurnSync( required GatewayMessage message, required IGateway sourceGateway, required string threadId ) {
		var context           = arguments.message.getContext()
		var supportsStreaming = arguments.sourceGateway.supports( "streaming" )
		var accumulated       = ""

		if ( supportsStreaming ) {
			deliverStreamEvent( arguments.sourceGateway, context, GatewayEvent.TYPES.RESPONSE_STARTED, "" )
		}

		variables.agent.stream(
			( chunk ) => {
				var text = extractChunkText( chunk )
				if ( len( text ) ) {
					accumulated &= text
					if ( supportsStreaming ) {
						deliverStreamEvent( arguments.sourceGateway, context, GatewayEvent.TYPES.RESPONSE_DELTA, text )
					}
				}
			},
			arguments.message.getText(),
			{},
			{ threadId : arguments.threadId, userId : personOf( context ), conversationId : resolveConversationId( arguments.message, arguments.sourceGateway ) }
		)

		if ( supportsStreaming ) {
			deliverStreamEvent( arguments.sourceGateway, context, GatewayEvent.TYPES.RESPONSE_COMPLETED, accumulated )
		} else {
			arguments.sourceGateway.deliver(
				new GatewayEvent( type : GatewayEvent.TYPES.RESPONSE_COMPLETED, data : { text : accumulated, content : accumulated }, context : context ),
				context
			)
		}
	}

	/**
	 * @return Who a message is from, as the conversation list, the notes and the agent's memory know them: the platform and the user there, `slack:U123`
	 */
	private string function personOf( required any context ) {
		var user = len( arguments.context.getUserID() ) ? arguments.context.getUserID() : arguments.context.getConversationID()
		return arguments.context.getGateway() & ":" & user
	}

	private string function chatKey( required any context ) {
		return arguments.context.getGateway() & "|" & arguments.context.getConversationID() & "|" & arguments.context.getThreadID()
	}

	/**
	 * A reply of just a number, right after a numbered list of choices, picks that choice: "2" becomes the
	 * command line behind the second option. This is how platforms with no buttons (SMS, Telegram, Signal)
	 * answer a "pick one". Anything else typed forgets the list, so a stray "2" much later is just a message.
	 *
	 * @message The inbound message
	 *
	 * @return The same message, or one whose text is the command line of the option picked
	 */
	private any function answerNumberedChoice( required GatewayMessage message ) {
		var key = choiceKey( arguments.message.getContext() )
		var options = variables.pendingChoices[ key ] ?: []
		variables.pendingChoices.delete( key )
		var typed = trim( arguments.message.getText() )
		if ( options.len() && reFind( "^[0-9]{1,3}$", typed ) && val( typed ) >= 1 && val( typed ) <= options.len() ) {
			return new GatewayMessage(
				text   : options[ val( typed ) ].line,
				context: arguments.message.getContext(),
				raw    : arguments.message.getRaw()
			)
		}
		return arguments.message
	}

	/**
	 * @context The message's context
	 *
	 * @return The command prefix for the gateway the message came from: its own, or the session's
	 */
	private string function prefixFor( required any context ) {
		return variables.prefixes[ arguments.context.getGateway() ] ?: variables.prefix
	}

	private string function choiceKey( required any context ) {
		return arguments.context.getGateway() & "|" & arguments.context.getConversationID() & "|" & arguments.context.getUserID()
	}

	/**
	 * Runs the command and sends its answer back through the gateway the message came from. A command that
	 * fails is told to the person, not thrown into the gateway's thread.
	 */
	private void function answer( required GatewayMessage message, required IGateway sourceGateway, required any line ) {
		var context = arguments.message.getContext()
		var who = personOf( context )
		var text = ""
		try {
			var reply = variables.service.execute(
				who,
				resolveConversationId( arguments.message, arguments.sourceGateway ),
				// the command layer always reads the slash
				"/" & arguments.line.name() & " " & arguments.line.args(),
				"gateway",
				variables.admins.containsNoCase( context.getUserID() )
			)
			var choose = reply.blocks.filter( b => b.type == "choose" )
			if ( choose.len() ) {
				// a gateway with buttons shows the first pick-one as buttons; the rest is text
				if ( sendAsButtons( arguments.sourceGateway, choose[ 1 ], context ) ) {
					reply.blocks = reply.blocks.filter( b => b.type != "choose" )
				} else {
					variables.pendingChoices[ choiceKey( context ) ] = choose[ 1 ].options
				}
			}
			// a command that moved the chat to another conversation (/new, /resume) takes its next messages there
			if ( len( reply.conversationId ?: "" ) && reply.conversationId != resolveConversationId( arguments.message, arguments.sourceGateway ) ) {
				variables.threads.use( chatKey( context ), reply.conversationId )
			}
			text = new "models.chat.commands.PlainRenderer@bxagents"().render( reply )
			if ( reply.blocks.filter( b => b.type == "choose" ).len() ) {
				text &= char( 10 ) & "Reply with a number to pick one."
			}
		} catch ( any e ) {
			text = "That command did not work: " & e.message
		}
		if ( !len( text ) ) {
			return
		}
		arguments.sourceGateway.deliver(
			new GatewayEvent( type : GatewayEvent.TYPES.RESPONSE_COMPLETED, data : { text : text, content : text }, context : context ),
			context
		)
	}

	/**
	 * @gateway The gateway the message came from
	 * @choose A "choose" block of a reply: { title, options: [ { label, hint, line } ] }
	 * @context Who to send to
	 *
	 * @return True when the gateway showed the choice natively (buttons, a list); false when it cannot
	 */
	private boolean function sendAsButtons( required any gateway, required struct choose, required any context ) {
		if ( !structKeyExists( arguments.gateway, "deliverChoices" ) ) {
			return false
		}
		try {
			return arguments.gateway.deliverChoices( arguments.choose.title ?: "", arguments.choose.options, arguments.context )
		} catch ( any e ) {
			return false
		}
	}

}
