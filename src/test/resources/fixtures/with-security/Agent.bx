class {

	function configure() {
		return {
			name     : "with-security-agent",
			model    : "openai/gpt-5",
			security : {
				inputSanitizer : true,
				outputGuard    : { blockPatterns : [ "ssn", "creditCard" ] }
			}
		};
	}

	function production() {
		return {
			model : "openai/gpt-5-mini"
		};
	}

}
