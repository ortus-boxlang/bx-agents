class extends="bxModules.bxai.models.runnables.AiAgent" {
	function init() {
		super.init( name: "FromClass", instructions: "from the class", model: aiModel( provider: "mock" ) )
		return this
	}
	function configure() {
		return {
			name        : "FromConfig",
			description : "declared outside the class",
			model       : "mock/mock-model"
		};
	}
}
