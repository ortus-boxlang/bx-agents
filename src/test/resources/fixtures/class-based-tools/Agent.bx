class extends="bxModules.bxai.models.runnables.AiAgent" {
	function init() {
		super.init(
			name        : "ClassTools",
			description : "set in code",
			instructions: "instructions from the class",
			model       : aiModel( provider: "mock" )
		)
		return this
	}

	function configure() {
		return {
			tools : [ "now@bxai" ]
		};
	}
}
