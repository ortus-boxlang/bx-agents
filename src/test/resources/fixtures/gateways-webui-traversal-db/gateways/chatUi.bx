class {

	function configure() {
		return {
			exposes  : "webui",
			path     : "/chat",
			database : {
				// Relative, so it passes the absolute-path check - and still
				// walks straight out of the app directory, which is exactly
				// what that check exists to prevent.
				path : "../../var/lib/acme/chat.db"
			}
		};
	}

}
