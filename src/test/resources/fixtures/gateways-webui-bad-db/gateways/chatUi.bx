class {

	function configure() {
		return {
			exposes  : "webui",
			path     : "/chat",
			database : {
				// Not a legal datasource name, an absolute path that would escape
				// the packaged app, and a key that does not exist
				datasource : "acme-chat db",
				path       : "/var/lib/acme/chat.db",
				journalMode: "wal"
			}
		};
	}

}
