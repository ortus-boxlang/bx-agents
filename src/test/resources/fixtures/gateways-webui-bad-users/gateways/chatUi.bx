class {

	function configure() {
		return {
			exposes : "webui",
			path    : "/chat",
			users   : [
				// A committed plaintext password - must be rejected, not ignored
				{ username: "ada", password: "hunter2" },
				// No way to supply a password at all
				{ username: "grace" },
				// Both sources set, so which wins would be ambiguous
				{ username: "alan", passwordEnvVar: "ALAN_PW", passwordHash: "pbkdf2$1$a$b" },
				// Duplicate of the first username
				{ username: "ada", passwordEnvVar: "ADA_PW" },
				// Not this project's hash format
				{ username: "linus", passwordHash: "$2a$12$bcryptstylehash" }
			]
		};
	}

}
