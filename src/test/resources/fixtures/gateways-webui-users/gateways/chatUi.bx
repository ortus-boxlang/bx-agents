class {

	function configure() {
		return {
			exposes : "webui",
			path    : "/chat",
			title   : "Acme Support",
			users   : [
				// The env var NAME, never the password itself
				{ username: "ada",   passwordEnvVar: "ACME_ADA_PASSWORD", displayName: "Ada Lovelace" },
				// An already-hashed value is safe to commit - it cannot be reversed
				{
					username     : "grace",
					passwordHash : "pbkdf2$210000$c2FsdHNhbHRzYWx0c2E==$ZmFrZWhhc2hmYWtlaGFzaGZha2VoYXNo",
					displayName  : "Grace Hopper"
				}
			]
		};
	}

}
