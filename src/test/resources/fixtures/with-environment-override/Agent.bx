class {

	function configure() {
		return {
			name        : "override-agent",
			description : "An agent with an environment override",
			model       : "openai/gpt-5",
			tags        : [ "base1", "base2" ]
		};
	}

	function production() {
		return {
			model : "openai/gpt-5-mini",
			tags  : [ "prod1" ]
		};
	}

}
