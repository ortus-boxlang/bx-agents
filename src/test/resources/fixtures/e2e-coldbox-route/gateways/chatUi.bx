/**
 * A real webui exposure, so the ColdBox integration boot exercises the
 * generated ChatUi handler, models/ChatDb.bx and its SQLite store for real -
 * over HTTP, against a genuinely booted app - rather than only asserting on
 * generated source text.
 *
 * No apiKeyEnvVar on purpose: the gate has its own dedicated specs, and
 * requiring a key here would only add a header to every assertion below.
 */
class {

	function configure() {
		return {
			exposes : "webui",
			path    : "/chat",
			title   : "E2E Chat",
			database: {
				datasource: "bxagentse2e",
				path      : "./data/e2e-chat.db"
			}
		};
	}

}
