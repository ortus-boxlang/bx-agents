class {

	function configure() {
		return {
			exposes      : "webui",
			path         : "/chat",
			title        : "Acme & Co <Support>",
			subtitle     : "Orders and returns",
			icon         : "@",
			welcome      : "Hi there!" & char( 10 ) & 'Ask "anything".',
			placeholder  : "Ask away...",
			footer       : "Generated answers may be wrong.",
			showReasoning: true,
			showToolCalls: false,
			theme        : {
				accent  : "0f766e",
				radius  : "10px",
				font    : "Inter, system-ui, sans-serif",
				dark    : { accent : "rgb(45, 212, 191)" }
			}
		};
	}

}
