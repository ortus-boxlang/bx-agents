/**
 * Root application context for local BoxLang CLI script execution (e.g. the
 * TestBox BoxLang CLI runner under testbox/system/runners/). Provides the
 * same mappings as tests/Application.bx so `new bxagents.models.build.X()`
 * resolves regardless of which subdirectory the runner script itself lives in.
 */
class {

	this.name				= "bxagents-root";
	this.sessionManagement	= false;
	this.setClientCookies	= false;

	this.mappings[ "/bxagents" ]	= expandPath( "./src/main/bx" );
	this.mappings[ "/tests" ]		= expandPath( "./tests" );
	this.mappings[ "/testbox" ]	= expandPath( "./testbox" );
	this.mappings[ "/fixtures" ]	= expandPath( "./src/test/resources/fixtures" );

}
