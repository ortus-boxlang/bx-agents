/**
 * Orchestrates the ColdBox-dependent integration specs
 * (tests/specs/integration/coldbox/**): pre-builds the fixture these specs
 * boot against, copies the TestBox runner alongside it, launches a real
 * boxlang-miniserver pointed DIRECTLY at the built app (not at tests/ - the
 * spec deliberately runs inside the request the app's own real
 * Application.bx/Bootstrap already boots, reading `application.cbController`
 * directly, rather than spinning up a second ColdBox instance via
 * BaseTestCase's VirtualApp - see the spec file's own docblock for why),
 * hits the runner over a real HTTP request (ColdBox's own RoutingService
 * needs a genuine `cgi` scope even to load the router at startup - confirmed
 * this session; CLI mode has none), parses the JSON TestBox report it
 * returns, and fails the build on any failure/error.
 *
 * MUST run from the repo root (same reason as runTests.bxs - BoxLang's own
 * Application.bx auto-discovery must not re-root relative to this script's
 * own directory).
 *
 * Usage: java -cp <boxlang.jar>:<compiled classes> ortus.boxlang.runtime.BoxRunner \
 *          --bx-config boxlang.json runColdBoxIntegrationTests.bxs
 */

repoRoot   = expandPath( "/" )
appDir     = repoRoot & "tests/.coldbox-app"
configPath = repoRoot & "boxlang.json"
port       = 39280

// ------------------------------------------------------------------
// 1. Pre-build the fixture the spec boots against, then copy the runner
//    page into the SAME directory so it's served by the app's own real
//    Application.bx (not a separate test harness webroot).
// ------------------------------------------------------------------
if ( directoryExists( appDir ) ) {
	directoryDelete( appDir, true )
}
directoryCreate( appDir, true )
directoryCopy( expandPath( "/fixtures" ) & "/e2e-coldbox-route", appDir, true )

pipeline = new bxagents.models.build.BuildPipeline( "coldbox-integration-test" )
buildResult = pipeline.build( appDir )
println( "+ Built fixture at: " & buildResult.appDir )

fileCopy( repoRoot & "tests/runner-coldbox.bxm", buildResult.appDir & "/runner-coldbox.bxm" )

// ------------------------------------------------------------------
// 1b. ColdBox and its modules (qb, cbsecurity, cbauth, ...) come from the
//     module's own bundled lib/, copied into the app by `build` - exactly the
//     path a real project takes. Nothing is installed or copied here; this
//     only fails early and clearly if the bundle did not arrive, instead of
//     leaving WireBox to explain it later.
// ------------------------------------------------------------------
for ( bundled in [ "coldbox", "modules/qb", "modules/cbsecurity", "modules/cbauth" ] ) {
	if ( !directoryExists( buildResult.appDir & "/" & bundled ) ) {
		throw(
			type    = "BxAgents.BundledLibMissing",
			message = "The built app has no [" & bundled & "] - the module's bundled lib/ was not copied in. Run `./gradlew shadowJar` (which stages lib/ via installLibs) first."
		)
	}
}
println( "+ Bundled ColdBox libs present in the built app" )

// ------------------------------------------------------------------
// 2. Launch a real boxlang-miniserver, pointed directly at the built app,
//    reusing this project's own boxlang.json for its mappings (/coldbox,
//    /tests, /testbox, etc. - the runner still needs to resolve
//    `testbox.system.TestBox` and `tests.specs.integration.coldbox.*`).
// ------------------------------------------------------------------
libsDir = expandPath( "/libs" )
jarPath = ""
for ( entry in directoryList( libsDir, false, "name", "boxlang-miniserver-*.jar" ) ) {
	jarPath = libsDir & "/" & entry
}
if ( !len( jarPath ) ) {
	println( "! Skipping ColdBox integration tests: boxlang-miniserver jar not found - run `./gradlew downloadMiniServer` first" )
	cliExit( 0 )
}

// rewrites MUST be on: /api/chat/invoke isn't a real file, and ColdBox's own
// routing only ever gets a chance to see it via the rewrite-to-index.bxm
// fallback (confirmed empirically this session - with rewrites off, MiniServer
// 404s that path itself before ColdBox's Application.bx/Router ever run). A
// real existing file like runner-coldbox.bxm is still served directly.
miniServerConfigPath = repoRoot & "tests/.coldbox-app-miniserver.json"
fileWrite( miniServerConfigPath, jsonSerialize( {
	port            : port,
	host            : "127.0.0.1",
	webRoot         : buildResult.appDir,
	configPath      : configPath,
	rewrites        : true,
	rewriteFileName : "index.bxm",
	healthCheck     : true
} ) )

process = createObject( "java", "ortus.boxlang.bxagents.build.MiniServerLauncher" ).launch( jarPath, miniServerConfigPath, false )

try {
	// ------------------------------------------------------------------
	// 3. Poll until the runner responds with real JSON (a 200) - not just
	//    any response (this sandbox's proxy can answer a not-yet-listening
	//    port with a transient 502 - confirmed earlier this session).
	// ------------------------------------------------------------------
	// ------------------------------------------------------------------
	// 2b. Probe a REAL app route before the TestBox runner.
	//
	// Diagnosis, first and foremost: if the runner page later fails or times
	// out, this says whether the server was serving anything at all, which a
	// bare "never responded" cannot.
	//
	// Be honest about how much it proves, because it was overstated here
	// before: the generated health() action renders a literal
	// { status: "ok", success: true } and touches nothing else. So a 200
	// proves ColdBox booted and routing reaches the generated ChatUi handler
	// over real HTTP - and NOT that WireBox, ChatDb or SQLite work. That
	// distinction is not academic: a run in CI returned 200 here while
	// models/ChatDb.bx could not even compile. The specs below are what
	// actually cover the store.
	// ------------------------------------------------------------------
	healthUrl     = "http://127.0.0.1:#port#/chat/api/health"
	probeDeadline = getTickCount() + 60000
	probeStatus   = 0
	probeDetail   = "no response"

	while ( getTickCount() < probeDeadline ) {
		try {
			bx:http url=healthUrl method="GET" result="probeResult" timeout=10 {}
			probeStatus = probeResult.status_code ?: 0
			probeDetail = left( trim( probeResult.fileContent ?: "" ), 240 )
			if ( probeStatus == 200 ) {
				break
			}
		} catch ( any e ) {
			probeDetail = e.message
		}
		sleep( 1000 )
	}
	println( "+ App probe GET /chat/api/health -> status=#probeStatus#" )
	println( "  body: #probeDetail#" )

	// Now that it is proven to work, treat it as real coverage rather than
	// commentary: a non-200 here means the generated app cannot serve its own
	// web UI, which is a failure worth stopping for - and a far clearer one
	// than the runner timing out later with no explanation.
	if ( probeStatus != 200 ) {
		throw(
			type    = "BxAgents.WebUiProbeFailed",
			message = "The generated app did not serve GET /chat/api/health (status #probeStatus#): #probeDetail#"
		)
	}

	// ------------------------------------------------------------------
	// 3. Run the specs. ONE request, no retry loop.
	//
	// This used to poll the runner once a second until a 90s deadline, which
	// was wrong twice over. The health probe above has already proven the
	// server is up and serving real ColdBox routes, so there is nothing left
	// for a retry to wait for. And the runner page is not idempotent or cheap
	// - it boots TestBox and runs every integration spec - so retrying it
	// stacks concurrent full test runs onto a MiniServer worker pool that has
	// only a handful of threads, which is a way to CAUSE a hang, not to
	// recover from one. It also destroyed the only evidence: each attempt
	// re-truncated runner-progress.txt, so the markers the first (hung)
	// attempt wrote were wiped by the attempts that followed, and the
	// diagnostics printed an empty file.
	//
	// The marker file is cleared here, once, instead - the page only ever
	// appends to it.
	// ------------------------------------------------------------------
	runnerUrl    = "http://127.0.0.1:#port#/runner-coldbox.bxm"
	progressPath = buildResult.appDir & "/runner-progress.txt"
	report       = ""
	lastError    = ""

	fileWrite( progressPath, "" )

	try {
		bx:http url=runnerUrl method="GET" result="httpResult" timeout=300 {}
		if ( httpResult.status_code == 200 && len( trim( httpResult.fileContent ) ) ) {
			report = httpResult.fileContent
		} else {
			// Built up in steps: nested double quotes inside a #...#
			// interpolation inside a double-quoted string is a parse hazard
			// this project has already been bitten by.
			errorBody = left( trim( httpResult.fileContent ?: '' ), 2000 )
			lastError = "HTTP #httpResult.status_code#: #errorBody#"
		}
	} catch ( any e ) {
		lastError = e.message
	}

	if ( !len( report ) ) {
		// The page never returned, so the only evidence of how far it got is
		// the marker file it writes as it goes - see tests/runner-coldbox.bxm.
		// No `var` - this is the TOP LEVEL of a .bxs script, where there is no
		// `local` scope to declare into. `var` here throws
		// "Scope [local] is not available in this context", which is exactly
		// how this diagnostic block failed on its first run: it crashed before
		// printing the markers it exists to print.
		println( "" )
		println( "--- runner progress markers ---" )
		try {
			println( fileExists( progressPath ) ? trim( fileRead( progressPath ) ) : "(no progress file - the page never even started)" )
		} catch ( any diagError ) {
			// Diagnostics must never replace the failure they are describing
			println( "(could not read progress file: #diagError.message#)" )
		}
		println( "-------------------------------" )
		throw( type = "BxAgents.ColdBoxRunnerNeverStarted", message = "tests/runner-coldbox.bxm never responded: #lastError#" )
	}

	results = jsonDeserialize( report )
	totalFail = results.totalFail + results.totalError

	println( "" )
	println( "ColdBox Integration - Bundles: " & results.totalBundles & " | Suites: " & results.totalSuites & " | Specs: " & results.totalSpecs )
	println( "Pass: " & results.totalPass & " | Fail: " & results.totalFail & " | Error: " & results.totalError & " | Skipped: " & results.totalSkipped )

	if ( totalFail > 0 ) {
		for ( bundleStat in results.bundleStats ) {
			for ( suiteStat in ( bundleStat.suiteStats ?: [] ) ) {
				for ( specStat in ( suiteStat.specStats ?: [] ) ) {
					if ( specStat.status == "Failed" || specStat.status == "Error" ) {
						failDetail = specStat.failMessage ?: ( specStat.error.message ?: "" )
						println( "  [#specStat.status#] #bundleStat.name# > #suiteStat.name# > #specStat.name#: #failDetail#" )
					}
				}
			}
		}
	}

	if ( totalFail > 0 ) {
		throw(
			type    = "BxAgents.ColdBoxIntegrationTestsFailed",
			message = "#totalFail# ColdBox integration spec(s) failed or errored"
		)
	}

	// ------------------------------------------------------------------
	// 4. The real end-to-end proof: a genuine HTTP request against the
	//    toAi()-registered route, reaching the generated agent for real.
	//    Done separately (NOT from inside the runner's own request - a
	//    request made from inside an already-running request, against this
	//    same single miniserver instance, risks deadlocking its worker
	//    thread pool, confirmed empirically this session).
	//
	//    This ONLY works reliably once WireBox has built the "GeneratedAgent"
	//    singleton at least once via some OTHER path first (which the specs
	//    above already did) - confirmed empirically this session that the
	//    FIRST-EVER request to a toAi() route on a freshly booted app can
	//    transiently fail with "Function [getInstance] not found" (a
	//    ColdBox/WireBox lazy-injection race on the Router's own
	//    `getInstance` delegate - not anything BX Agents' generated code
	//    controls), but succeeds reliably on every subsequent request. Real
	//    deployments should treat this the same way: a warm-up request (a
	//    health check, first real user hit, etc.) before relying on toAi()
	//    routes under load.
	// ------------------------------------------------------------------
	bx:http url="http://127.0.0.1:#port#/api/chat/invoke" method="POST" result="routeResult" timeout=30 {
		bx:httpparam type="header" name="Content-Type" value="application/json";
		bx:httpparam type="body" value='{"input":"Hello there!"}';
	}
	if ( routeResult.status_code != 200 || !routeResult.fileContent.findNoCase( '"success":true' ) ) {
		throw(
			type    = "BxAgents.ToAiRouteDispatchFailed",
			message = "Expected a successful toAi()/invoke response (HTTP 200, success:true) - got HTTP #routeResult.status_code#: #routeResult.fileContent#"
		)
	}
	println( "+ Confirmed: a real HTTP request through toAi()'s /invoke route reaches the generated agent: " & routeResult.fileContent )

	// ------------------------------------------------------------------
	// 4b. The RESERVED agent route answers, over real HTTP.
	//
	// /__bxagents is emitted unconditionally by RouterGenerator, whatever
	// gateways/ declares - it is this module's own service entrance, so
	// `chat --server` and `invoke --server` always have an address even in
	// a project that exposes nothing publicly. The fixture above happens to
	// ALSO declare a /api/chat exposure; this asserts the reserved route is
	// there ALONGSIDE it, on its own, not as a rename of it.
	//
	// Same warm-up caveat as #4 above applies, and is already satisfied by
	// the time this runs.
	// ------------------------------------------------------------------
	bx:http url="http://127.0.0.1:#port#/__bxagents/invoke" method="POST" result="reservedResult" timeout=30 {
		bx:httpparam type="header" name="Content-Type" value="application/json";
		bx:httpparam type="body" value='{"input":"Hello there!"}';
	}
	if ( reservedResult.status_code != 200 || !reservedResult.fileContent.findNoCase( '"success":true' ) ) {
		throw(
			type    = "BxAgents.ReservedAgentRouteDispatchFailed",
			message = "Expected the always-on /__bxagents/invoke route to answer (HTTP 200, success:true) - got HTTP #reservedResult.status_code#: #reservedResult.fileContent#"
		)
	}
	println( "+ Confirmed: the always-on /__bxagents/invoke route reaches the generated agent: " & reservedResult.fileContent )

	// ------------------------------------------------------------------
	// 4c. The agent STREAMS over SSE, incrementally.
	//
	// Exercised through AgentClient itself - the same code `chat --server`
	// and `chat --connect` run - rather than by curling the route, so this
	// covers the whole native path: ColdBox's `toAi()` emitting through the
	// `SSE()` BIF, and `http().sse( true ).onChunk()` parsing it.
	//
	// What this really guards is a CONFIG dependency that is invisible in the
	// code: SSE frames are terminated by a blank line, and the web runtime's
	// whitespace compression - ON by default - collapses consecutive newlines
	// and eats those terminators. With it on, this body carried zero `\n\n`
	// and the native client reported `totalEvents: 0`. `boxlang.json` here and
	// `Serve.bx` for real projects both set `whitespaceCompressionEnabled` to
	// false; if either regresses, this assertion is what catches it.
	//
	// The delta COUNT is the point. Reassembled output alone would pass just
	// as well if the whole body were buffered and parsed at the end, which is
	// exactly the failure this feature exists to avoid.
	// ------------------------------------------------------------------
	streamClient = new bxagents.models.cli.support.AgentClient()
	streamDeltas = []
	streamResult = streamClient.stream(
		baseUrl : "http://127.0.0.1:#port#",
		message : "Hello there!",
		onDelta : ( delta ) => { streamDeltas.append( delta ) }
	)

	if ( !streamDeltas.len() ) {
		throw(
			type    = "BxAgents.AgentStreamNoDeltas",
			message = "Streaming /__bxagents/stream produced no deltas at all. The usual cause is whitespaceCompressionEnabled being back on for this runtime, which collapses the blank lines that terminate SSE frames - check boxlang.json and Serve.bx."
		)
	}
	if ( streamResult.output != "Mock response" ) {
		throw(
			type    = "BxAgents.AgentStreamWrongOutput",
			message = "Streaming reassembled [#streamResult.output#] rather than the mock provider's ""Mock response"" - the deltas are not being joined correctly."
		)
	}
	if ( !len( streamResult.threadId ?: "" ) ) {
		throw(
			type    = "BxAgents.AgentStreamNoThreadId",
			message = "Streaming returned no threadId - the leading `thread` frame was not read, so a chat session could not continue a conversation."
		)
	}
	println( "+ Confirmed: /__bxagents/stream streams #streamDeltas.len()# delta(s) that reassemble to [#streamResult.output#], with a threadId" )

	// ------------------------------------------------------------------
	// 4d. Run control beside toAi on the reserved route: handlers/AgentApi.bx.
	//
	// /events is /stream plus `tool` and `suspended` frames (the mock model
	// calls no tool, so here it proves the frames the chat client depends on:
	// thread first, chunks, done last). The others answer their input checks.
	// ------------------------------------------------------------------
	bx:http url="http://127.0.0.1:#port#/__bxagents/tools" method="GET" result="rcTools" timeout=30 {}
	if ( rcTools.status_code != 200 || !rcTools.fileContent.findNoCase( '"success":true' ) ) {
		throw(
			type    = "BxAgents.RunControlToolsFailed",
			message = "GET /__bxagents/tools did not answer (HTTP #rcTools.status_code#): #left( rcTools.fileContent ?: '', 400 )#"
		)
	}

	bx:http url="http://127.0.0.1:#port#/__bxagents/agent" method="GET" result="rcAbout" timeout=30 {}
	if ( rcAbout.status_code != 200 || !rcAbout.fileContent.findNoCase( '"name"' ) || !rcAbout.fileContent.findNoCase( '"capabilities"' ) ) {
		throw(
			type    = "BxAgents.RunControlAgentFailed",
			message = "GET /__bxagents/agent did not describe the agent (HTTP #rcAbout.status_code#): #left( rcAbout.fileContent ?: '', 400 )#"
		)
	}

	bx:http url="http://127.0.0.1:#port#/__bxagents/events" method="POST" result="rcEvents" timeout=60 {
		bx:httpparam type="header" name="Content-Type" value="application/json";
		bx:httpparam type="header" name="Accept" value="text/event-stream";
		bx:httpparam type="body" value='{"input":"Hello there!"}';
	}
	rcBody = rcEvents.fileContent ?: ""
	rcNames = reMatch( "(?m)^event: ([a-z]+)", rcBody ).map( line => line.replace( "event: ", "" ) )
	if ( rcEvents.status_code != 200 || rcNames.isEmpty() || rcNames.first() != "thread" || rcNames.last() != "done" || !rcNames.contains( "chunk" ) ) {
		throw(
			type    = "BxAgents.RunControlEventsFailed",
			message = "POST /__bxagents/events should stream thread, chunk(s), done (HTTP #rcEvents.status_code#, events: #rcNames.toList()#): #left( rcBody, 400 )#"
		)
	}

	for ( rcCheck in [
		{ verb : "POST", path : "/__bxagents/cancel", body : "{}" },
		{ verb : "POST", path : "/__bxagents/steer", body : "{}" },
		{ verb : "POST", path : "/__bxagents/resume", body : "{}" },
		{ verb : "GET", path : "/__bxagents/pending", body : "" }
	] ) {
		bx:http url="http://127.0.0.1:#port##rcCheck.path#" method=rcCheck.verb result="rcAnswer" timeout=30 {
			bx:httpparam type="header" name="Content-Type" value="application/json";
			if ( len( rcCheck.body ) ) {
				bx:httpparam type="body" value=rcCheck.body;
			}
		}
		if ( rcAnswer.status_code != 400 || !rcAnswer.fileContent.findNoCase( "required" ) ) {
			throw(
				type    = "BxAgents.RunControlInputCheckFailed",
				message = "#rcCheck.verb# #rcCheck.path# without its input should answer 400 ""... is required"" (HTTP #rcAnswer.status_code#): #left( rcAnswer.fileContent ?: '', 300 )#"
			)
		}
	}

	bx:http url="http://127.0.0.1:#port#/__bxagents/pending?threadId=no-such-thread" method="GET" result="rcPending" timeout=30 {}
	if ( rcPending.status_code != 200 || !rcPending.fileContent.findNoCase( '"pending":false' ) ) {
		throw(
			type    = "BxAgents.RunControlPendingFailed",
			message = "GET /__bxagents/pending for an unknown thread should say nothing is pending (HTTP #rcPending.status_code#): #left( rcPending.fileContent ?: '', 300 )#"
		)
	}
	println( "+ Confirmed: run control answers on /__bxagents - events streams [#rcNames.toList()#], and cancel, steer, resume and pending check their input" )

	// ------------------------------------------------------------------
	// 5. An open web UI is ONE shared workspace, over real HTTP.
	//
	// /chat declares no accounts, so everything in it is shared on purpose:
	// whoever can reach the UI sees every conversation and preference in it.
	// Two SEPARATE HTTP calls - different sessions, no shared cookie - must
	// therefore see the same data.
	//
	// This has to run out here rather than in the TestBox specs: those all
	// execute inside ONE request to the runner page, and the whole point is
	// two independent callers.
	// ------------------------------------------------------------------
	bx:http url="http://127.0.0.1:#port#/chat/api/preferences/set" method="POST" result="prefSet" timeout=30 {
		bx:httpparam type="header" name="Content-Type" value="application/json";
		bx:httpparam type="body" value='{"key":"theme","value":"dark"}';
	}
	// Assert the BODY, not just the status: with rewrites on, a route that does
	// not match can still come back 200 carrying the SPA shell.
	if ( prefSet.status_code != 200 || !prefSet.fileContent.findNoCase( '"saved":true' ) ) {
		throw(
			type    = "BxAgents.SharedWorkspaceWriteFailed",
			message = "Could not write a preference to the open web UI (HTTP #prefSet.status_code#): #left( prefSet.fileContent ?: '', 500 )#"
		)
	}

	bx:http url="http://127.0.0.1:#port#/chat/api/preferences" method="GET" result="prefRead" timeout=30 {}
	if ( prefRead.status_code != 200 || !prefRead.fileContent.findNoCase( "dark" ) ) {
		throw(
			type    = "BxAgents.SharedWorkspaceNotShared",
			message = "A second, independent caller did not see the open UI's shared preference - an accountless web UI is supposed to be ONE workspace."
				& " write -> HTTP #prefSet.status_code# #left( prefSet.fileContent ?: '', 300 )#"
				& " | read -> HTTP #prefRead.status_code# #left( prefRead.fileContent ?: '', 300 )#"
		)
	}

	println( "+ Confirmed: an accountless web UI is one shared workspace across independent callers" )

	// ------------------------------------------------------------------
	// 5b. The bx-ai Gateway surface is mounted for a NON-http gateway.
	//
	// The fixture's only channel-adapter entry is `mock` - deliberately not
	// `http`. The mount used to be gated on `type: "http"` specifically, which
	// left every push-only project (Telegram, Slack, Discord, ...) without the
	// /interactions routes that are how a human answers a pending approval.
	//
	// Asserted over real HTTP rather than on generated source, because the
	// generated text being right is not the same as the routes answering:
	// this same check is what caught bx-ai 3.4.0 missing the four methods
	// ColdBox's toAiGateway() dispatches to (readInteraction/submitDecision/
	// processInbound/processHandshake), which 500'd every one of them.
	// ------------------------------------------------------------------
	bx:http url="http://127.0.0.1:#port#/gateways/info" method="GET" result="gwInfo" timeout=30 {}
	if ( gwInfo.status_code != 200 || !gwInfo.fileContent.findNoCase( "interactions" ) ) {
		throw(
			type    = "BxAgents.GatewaySurfaceNotMounted",
			message = "GET /gateways/info did not describe the gateway surface on a non-http project (HTTP #gwInfo.status_code#): #left( gwInfo.fileContent ?: '', 400 )#"
		)
	}
	println( "+ Confirmed: the bx-ai Gateway surface is mounted for a non-http (mock) gateway" )

	// A 404 with a REAL JSON body is the pass here: it proves the route reached
	// bx-ai's own processor and got a considered answer. A 500 would mean the
	// terminator dispatched to a method the pinned bx-ai does not have.
	bx:http url="http://127.0.0.1:#port#/gateways/interactions/not-a-real-request-id" method="GET" result="hitlGet" timeout=30 {}
	if ( hitlGet.status_code != 404 || !hitlGet.fileContent.findNoCase( "Interaction not found" ) ) {
		throw(
			type    = "BxAgents.HumanInteractionRouteBroken",
			message = "GET /gateways/interactions/:requestID did not answer from bx-ai's processor (expected HTTP 404 + ""Interaction not found"", got #hitlGet.status_code#): #left( hitlGet.fileContent ?: '', 400 )#"
		)
	}

	bx:http url="http://127.0.0.1:#port#/gateways/interactions/not-a-real-request-id/decisions" method="POST" result="hitlPost" timeout=30 {
		bx:httpparam type="header" name="Content-Type" value="application/json";
		bx:httpparam type="body" value='{"decision":"approve"}';
	}
	if ( hitlPost.status_code != 404 || !hitlPost.fileContent.findNoCase( "Interaction not found" ) ) {
		throw(
			type    = "BxAgents.HumanInteractionRouteBroken",
			message = "POST /gateways/interactions/:requestID/decisions did not answer from bx-ai's processor (expected HTTP 404 + ""Interaction not found"", got #hitlPost.status_code#): #left( hitlPost.fileContent ?: '', 400 )#"
		)
	}
	println( "+ Confirmed: both human-in-the-loop approval routes answer from bx-ai's own processor" )
} finally {
	process.destroy()
	process.waitFor( 5, createObject( "java", "java.util.concurrent.TimeUnit" ).SECONDS )
	if ( process.isAlive() ) {
		process.destroyForcibly()
	}
	if ( fileExists( miniServerConfigPath ) ) {
		fileDelete( miniServerConfigPath )
	}
}

// ------------------------------------------------------------------
// 6. The agentApi.tokenEnvVar gate, over real HTTP, on its own app.
//
// This needs a SECOND app because the gate is all-or-nothing for a given
// build: the fixture above deliberately has no token so #4b can prove the
// route is open by default, and this one deliberately has one. A second
// miniserver on its own port is cheaper and far clearer than trying to make
// one app be both.
//
// Worth booting for: the generated condition closure is the only place in
// this module where a wrong ColdBox signature would fail SILENTLY in the
// permissive direction. RoutingService invokes it as
// `condition( requestString )` - ONE argument - not with the
// `( route, params, event )` shape Router.cfc's own docblocks show, so a
// closure written to the documented signature would blow up on an `event`
// that is never passed. Only a real request through a real router proves
// which is right, which is exactly what this does.
// ------------------------------------------------------------------
tokenAppDir = repoRoot & "tests/.coldbox-app-token"
tokenPort   = port + 1
expectedToken = getSystemSetting( "BXAGENTS_E2E_TOKEN", "" )

if ( !len( expectedToken ) ) {
	// The gate reads the env var from the MINISERVER process, which inherits
	// this process's environment - so if it is not set here it cannot be set
	// there, and a "403/404 as expected" result would prove nothing at all.
	// build.gradle's testColdBoxIntegration task sets it; say so plainly
	// rather than passing vacuously.
	println( "! Skipping the agentApi token-gate check: BXAGENTS_E2E_TOKEN is not set in this process's environment" )
} else {
	if ( directoryExists( tokenAppDir ) ) {
		directoryDelete( tokenAppDir, true )
	}
	directoryCreate( tokenAppDir, true )
	directoryCopy( expandPath( "/fixtures" ) & "/e2e-agent-api-token", tokenAppDir, true )

	tokenBuild = new bxagents.models.build.BuildPipeline( "coldbox-integration-test" ).build( tokenAppDir )
	println( "+ Built token-gated fixture at: " & tokenBuild.appDir )

	tokenConfigPath = repoRoot & "tests/.coldbox-app-token-miniserver.json"
	fileWrite( tokenConfigPath, jsonSerialize( {
		port            : tokenPort,
		host            : "127.0.0.1",
		webRoot         : tokenBuild.appDir,
		configPath      : configPath,
		rewrites        : true,
		rewriteFileName : "index.bxm",
		healthCheck     : true
	} ) )

	tokenProcess = createObject( "java", "ortus.boxlang.bxagents.build.MiniServerLauncher" ).launch( jarPath, tokenConfigPath, false )

	try {
		tokenUrl = "http://127.0.0.1:#tokenPort#/__bxagents/invoke"
		body     = '{"input":"Hello there!"}'

		// Warm-up/readiness: poll WITH the right token until the route
		// answers. This doubles as the positive case - a 200 here is the
		// gate passing - and as the same singleton warm-up #4 documents.
		deadline    = getTickCount() + 90000
		allowed     = {}
		allowDetail = "no response"
		while ( getTickCount() < deadline ) {
			try {
				bx:http url=tokenUrl method="POST" result="allowed" timeout=15 {
					bx:httpparam type="header" name="Content-Type" value="application/json";
					bx:httpparam type="header" name="x-bxagents-token" value=expectedToken;
					bx:httpparam type="body" value=body;
				}
				allowDetail = left( trim( allowed.fileContent ?: "" ), 240 )
				if ( ( allowed.status_code ?: 0 ) == 200 && allowDetail.findNoCase( '"success":true' ) ) {
					break
				}
			} catch ( any e ) {
				allowDetail = e.message
			}
			sleep( 1000 )
		}

		if ( ( allowed.status_code ?: 0 ) != 200 || !allowDetail.findNoCase( '"success":true' ) ) {
			throw(
				type    = "BxAgents.AgentApiTokenGateRejectedValidToken",
				message = "A request carrying the correct x-bxagents-token was not served (HTTP #allowed.status_code ?: 0#): #allowDetail#"
			)
		}
		println( "+ Confirmed: the agentApi token gate ADMITS a request carrying the right x-bxagents-token" )

		// The run-control routes are gated by their handler, with the same variable and header
		bx:http url="http://127.0.0.1:#tokenPort#/__bxagents/tools" method="GET" result="rcAllowed" timeout=30 {
			bx:httpparam type="header" name="x-bxagents-token" value=expectedToken;
		}
		if ( rcAllowed.status_code != 200 || !rcAllowed.fileContent.findNoCase( '"success":true' ) ) {
			throw(
				type    = "BxAgents.RunControlRejectedValidToken",
				message = "GET /__bxagents/tools with the right token was not served (HTTP #rcAllowed.status_code#): #left( rcAllowed.fileContent ?: '', 300 )#"
			)
		}
		for ( rcPath in [ "/__bxagents/tools", "/__bxagents/pending?threadId=x" ] ) {
			for ( rcToken in [ "", expectedToken & "-wrong" ] ) {
				bx:http url="http://127.0.0.1:#tokenPort##rcPath#" method="GET" result="rcDenied" timeout=30 {
					bx:httpparam type="header" name="x-bxagents-token" value=rcToken;
				}
				if ( rcDenied.status_code != 401 ) {
					throw(
						type    = "BxAgents.RunControlTokenGateFailedOpen",
						message = "GET #rcPath# with #len( rcToken ) ? 'a wrong' : 'no'# token should be a 401, got HTTP #rcDenied.status_code#: #left( rcDenied.fileContent ?: '', 300 )#"
					)
				}
			}
		}
		bx:http url="http://127.0.0.1:#tokenPort#/__bxagents/events" method="POST" result="rcDeniedEvents" timeout=30 {
			bx:httpparam type="header" name="Content-Type" value="application/json";
			bx:httpparam type="body" value='{"input":"hi"}';
		}
		if ( rcDeniedEvents.status_code != 401 ) {
			throw(
				type    = "BxAgents.RunControlTokenGateFailedOpen",
				message = "POST /__bxagents/events with no token should be a 401, got HTTP #rcDeniedEvents.status_code#: #left( rcDeniedEvents.fileContent ?: '', 300 )#"
			)
		}
		println( "+ Confirmed: the run-control routes sit behind the same token gate (401 without or with a wrong token)" )

		// Negative cases. A failing withCondition makes ColdBox skip the
		// route entirely, so the caller gets a 404 - deliberately not a 403,
		// which would confirm the endpoint exists.
		for ( attempt in [
			{ label : "no x-bxagents-token header at all", token : "" },
			{ label : "a wrong x-bxagents-token",          token : expectedToken & "-wrong" }
		] ) {
			bx:http url=tokenUrl method="POST" result="denied" timeout=30 {
				bx:httpparam type="header" name="Content-Type" value="application/json";
				bx:httpparam type="header" name="x-bxagents-token" value=attempt.token;
				bx:httpparam type="body" value=body;
			}
			// Assert on the BODY too: with rewrites on, an unmatched route can
			// still come back 200 carrying whatever the fallback renders, so
			// status alone would not prove the agent was never reached.
			if ( ( denied.status_code ?: 0 ) == 200 && ( denied.fileContent ?: "" ).findNoCase( '"success":true' ) ) {
				throw(
					type    = "BxAgents.AgentApiTokenGateFailedOpen",
					message = "The token gate ADMITTED a request with #attempt.label# - it must fail closed."
						& " HTTP #denied.status_code#: #left( denied.fileContent ?: '', 300 )#"
				)
			}
			// Not merely "didn't succeed" - a DELIBERATE 401. Anything else
			// means the refusal fell through to ColdBox's default main.index
			// event, which a generated app never defines, and the caller is
			// getting a 500 error page instead of an answer. That is what the
			// first working version of this actually did, so it is asserted
			// rather than assumed.
			if ( ( denied.status_code ?: 0 ) != 401 ) {
				throw(
					type    = "BxAgents.AgentApiTokenGateWrongRefusal",
					message = "The token gate refused #attempt.label# with HTTP #denied.status_code ?: 0#, not a deliberate 401"
						& " - a refused request is falling through instead of hitting the generated 401 route."
						& " Body: #left( denied.fileContent ?: '', 300 )#"
				)
			}
			println( "+ Confirmed: the agentApi token gate REFUSES #attempt.label# with a deliberate 401" )
		}
	} finally {
		tokenProcess.destroy()
		tokenProcess.waitFor( 5, createObject( "java", "java.util.concurrent.TimeUnit" ).SECONDS )
		if ( tokenProcess.isAlive() ) {
			tokenProcess.destroyForcibly()
		}
		if ( fileExists( tokenConfigPath ) ) {
			fileDelete( tokenConfigPath )
		}
	}
}

// ------------------------------------------------------------------
// 7. Issued access tokens (agentApi.tokens), over real HTTP, on a third app.
//
// The tokens are made the way an operator makes them: in the app's own chat database, with the
// module's TokenService, before the server starts. The server then has to find them through the
// app's default datasource, accept the right one on every route (the toAi routes and the
// run-control routes), refuse a wrong one, an expired one and a revoked one, and fail closed
// when there is no header at all.
// ------------------------------------------------------------------
issuedAppDir = repoRoot & "tests/.coldbox-app-issued"
issuedPort   = port + 2
if ( directoryExists( issuedAppDir ) ) {
	directoryDelete( issuedAppDir, true )
}
directoryCreate( issuedAppDir, true )
directoryCopy( expandPath( "/fixtures" ) & "/e2e-agent-api-tokens", issuedAppDir, true )

issuedBuild = new bxagents.models.build.BuildPipeline( "coldbox-integration-test" ).build( issuedAppDir )
println( "+ Built issued-tokens fixture at: " & issuedBuild.appDir )

// what an operator does: tokens in the database the app will open
issuedStore = new bxagents.models.store.ChatStore( { driver : "sqlite", database : issuedBuild.appDir & "/data/chat.db" } )
directoryCreate( issuedBuild.appDir & "/data", true, true )
issuedStore.migrate()
issuedTokens = new bxagents.models.store.TokenService( issuedStore )
goodToken = issuedTokens.create( "laptop" ).token
adminToken = issuedTokens.create( "boss", "admin" ).token
expiredToken = issuedTokens.create( "stale", "chat", dateAdd( "n", -5, now() ) ).token
revokedToken = issuedTokens.create( "gone" ).token
issuedTokens.revoke( "gone" )

issuedConfigPath = repoRoot & "tests/.coldbox-app-issued-miniserver.json"
fileWrite( issuedConfigPath, jsonSerialize( {
	port            : issuedPort,
	host            : "127.0.0.1",
	webRoot         : issuedBuild.appDir,
	configPath      : configPath,
	rewrites        : true,
	rewriteFileName : "index.bxm",
	healthCheck     : true
} ) )
issuedProcess = createObject( "java", "ortus.boxlang.bxagents.build.MiniServerLauncher" ).launch( jarPath, issuedConfigPath, false )

try {
	issuedBase = "http://127.0.0.1:#issuedPort#/__bxagents"

	// readiness: poll with a good token until the run-control route answers
	issuedDeadline = getTickCount() + 90000
	issuedReady = {}
	while ( getTickCount() < issuedDeadline ) {
		try {
			bx:http url="#issuedBase#/tools" method="GET" result="issuedReady" timeout=15 {
				bx:httpparam type="header" name="x-bxagents-token" value=goodToken;
			}
			if ( ( issuedReady.status_code ?: 0 ) == 200 ) {
				break
			}
		} catch ( any e ) {
			// still starting
		}
		sleep( 1000 )
	}
	if ( ( issuedReady.status_code ?: 0 ) != 200 ) {
		throw(
			type    = "BxAgents.IssuedTokenRejectedValidToken",
			message = "A valid issued token was not accepted on /__bxagents/tools (HTTP #issuedReady.status_code ?: 0#): #left( issuedReady.fileContent ?: '', 300 )#"
		)
	}

	// a good token works on the toAi route, the run-control routes and with the admin scope
	for ( issuedOk in [
		{ label : "chat token on /invoke", token : goodToken, verb : "POST", path : "/invoke", body : '{"input":"hi"}', expect : '"success":true' },
		{ label : "admin token on /invoke", token : adminToken, verb : "POST", path : "/invoke", body : '{"input":"hi"}', expect : '"success":true' },
		{ label : "chat token on /agent", token : goodToken, verb : "GET", path : "/agent", body : "", expect : '"name"' }
	] ) {
		bx:http url="#issuedBase##issuedOk.path#" method=issuedOk.verb result="issuedAnswer" timeout=60 {
			bx:httpparam type="header" name="Content-Type" value="application/json";
			bx:httpparam type="header" name="x-bxagents-token" value=issuedOk.token;
			if ( len( issuedOk.body ) ) {
				bx:httpparam type="body" value=issuedOk.body;
			}
		}
		if ( issuedAnswer.status_code != 200 || !issuedAnswer.fileContent.findNoCase( issuedOk.expect ) ) {
			throw(
				type    = "BxAgents.IssuedTokenRejectedValidToken",
				message = "#issuedOk.label# was not served (HTTP #issuedAnswer.status_code#): #left( issuedAnswer.fileContent ?: '', 300 )#"
			)
		}
	}
	println( "+ Confirmed: issued tokens are accepted on the toAi route and the run-control routes" )

	// everything else is a deliberate 401, on both kinds of route
	for ( issuedNo in [
		{ label : "no token", token : "" },
		{ label : "a made-up token", token : "bxa_" & repeatString( "A", 43 ) },
		{ label : "an expired token", token : expiredToken },
		{ label : "a revoked token", token : revokedToken },
		{ label : "a token without the prefix", token : "laptop" }
	] ) {
		for ( issuedRoute in [ { verb : "POST", path : "/invoke", body : '{"input":"hi"}' }, { verb : "GET", path : "/tools", body : "" } ] ) {
			bx:http url="#issuedBase##issuedRoute.path#" method=issuedRoute.verb result="issuedDenied" timeout=30 {
				bx:httpparam type="header" name="Content-Type" value="application/json";
				if ( len( issuedNo.token ) ) {
					bx:httpparam type="header" name="x-bxagents-token" value=issuedNo.token;
				}
				if ( len( issuedRoute.body ) ) {
					bx:httpparam type="body" value=issuedRoute.body;
				}
			}
			if ( issuedDenied.status_code != 401 ) {
				throw(
					type    = "BxAgents.IssuedTokenGateFailedOpen",
					message = "#issuedRoute.verb# #issuedRoute.path# with #issuedNo.label# should be a 401, got HTTP #issuedDenied.status_code#: #left( issuedDenied.fileContent ?: '', 300 )#"
				)
			}
		}
	}
	println( "+ Confirmed: no token, a made-up, an expired and a revoked token are all refused with a 401" )

	// notes: a person keeps their own, any caller adds to the agent's, only an admin removes from it
	function issuedCall( required string verb, required string path, required string token, string body = "" ) {
		bx:http url="#issuedBase##arguments.path#" method=arguments.verb result="issuedNoteAnswer" timeout=30 {
			bx:httpparam type="header" name="Content-Type" value="application/json";
			bx:httpparam type="header" name="x-bxagents-token" value=arguments.token;
			if ( len( arguments.body ) ) {
				bx:httpparam type="body" value=arguments.body;
			}
		}
		return { status : issuedNoteAnswer.status_code, body : issuedNoteAnswer.fileContent ?: "" }
	}
	issuedMine = issuedCall( "POST", "/notes", goodToken, '{"scope":"user","text":"Likes tea"}' )
	issuedShared = issuedCall( "POST", "/notes", goodToken, '{"scope":"agent","text":"The repo uses Gradle"}' )
	if ( issuedMine.status != 200 || issuedShared.status != 200 ) {
		throw( type = "BxAgents.NotesNotServed", message = "Adding notes failed (HTTP #issuedMine.status# and #issuedShared.status#): #left( issuedMine.body, 200 )# #left( issuedShared.body, 200 )#" )
	}
	issuedList = jsonDeserialize( issuedCall( "GET", "/notes", goodToken ).body )
	if ( issuedList.user.owner != "laptop" || issuedList.user.notes.len() != 1 || issuedList.agent.notes.len() != 1 ) {
		throw( type = "BxAgents.NotesNotScoped", message = "The notes are not kept per caller: #jsonSerialize( issuedList )#" )
	}
	// someone else does not see the user notes of laptop, but sees the agent's
	issuedOthers = jsonDeserialize( issuedCall( "GET", "/notes", adminToken ).body )
	if ( issuedOthers.user.notes.len() != 0 || issuedOthers.agent.notes.len() != 1 ) {
		throw( type = "BxAgents.NotesNotScoped", message = "Another caller sees the wrong notes: #jsonSerialize( issuedOthers )#" )
	}
	issuedAgentNote = issuedList.agent.notes[ 1 ].id
	issuedForbidden = issuedCall( "POST", "/notes/remove", goodToken, '{"scope":"agent","id":"#issuedAgentNote#"}' )
	if ( issuedForbidden.status != 403 ) {
		throw( type = "BxAgents.NotesRemovalNotGated", message = "A chat token removed an agent note (HTTP #issuedForbidden.status#): #left( issuedForbidden.body, 200 )#" )
	}
	issuedRemoved = issuedCall( "POST", "/notes/remove", adminToken, '{"scope":"agent","id":"#issuedAgentNote#"}' )
	if ( issuedRemoved.status != 200 ) {
		throw( type = "BxAgents.NotesRemovalFailed", message = "An admin token could not remove an agent note (HTTP #issuedRemoved.status#): #left( issuedRemoved.body, 200 )#" )
	}
	if ( issuedCall( "GET", "/notes", "" ).status != 401 ) {
		throw( type = "BxAgents.NotesGateFailedOpen", message = "The notes route answered without a token" )
	}
	println( "+ Confirmed: notes are per caller, any caller adds, only an admin removes from the agent, no token is a 401" )

	// revoking takes effect on the next request, without a restart
	issuedTokens.revoke( "laptop" )
	bx:http url="#issuedBase#/tools" method="GET" result="issuedAfterRevoke" timeout=30 {
		bx:httpparam type="header" name="x-bxagents-token" value=goodToken;
	}
	if ( issuedAfterRevoke.status_code != 401 ) {
		throw(
			type    = "BxAgents.IssuedTokenRevokeIgnored",
			message = "A token revoked after the server started was still accepted (HTTP #issuedAfterRevoke.status_code#)"
		)
	}
	println( "+ Confirmed: revoking a token takes effect on the running server" )
} finally {
	issuedProcess.destroy()
	issuedProcess.waitFor( 5, createObject( "java", "java.util.concurrent.TimeUnit" ).SECONDS )
	if ( issuedProcess.isAlive() ) {
		issuedProcess.destroyForcibly()
	}
	if ( fileExists( issuedConfigPath ) ) {
		fileDelete( issuedConfigPath )
	}
}
