{
	"name": "bxagents-ui",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"type": "module",
	"description": "The BX Agents web app: development and tests",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "vite build",
		"stack": "node scripts/stack.mjs",
		"e2e": "playwright test",
		"e2e:headed": "playwright test --headed",
		"e2e:shapes": "playwright test -c playwright.shapes.config.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:scss": "stylelint \"resources/assets/scss/**/*.scss\"",
		"lint:scss:fix": "stylelint \"resources/assets/scss/**/*.scss\" --fix",
		"lint:md": "markdownlint -c ../.markdownlint.json \"../docs/**/*.md\" ../changelog.md ../readme.md \"*.md\" --ignore \"../docs/blog/**\"",
		"test": "vitest run",
		"media": "node scripts/media.mjs",
		"docs:shots": "node scripts/docs-shots.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.63.0",
		"coldbox-vite-plugin": "^4.0.1",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"jsdom": "^29.1.1",
		"markdownlint-cli": "^0.45.0",
		"sass": "^1.108.2",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"vite": "^6.4.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@alpinejs/focus": "^3.17.5",
		"@alpinejs/persist": "^3.17.5",
		"alpinejs": "^3.17.5",
		"dompurify": "^3.4.18",
		"highlight.js": "^11.10.0",
		"marked": "^18.2.1"
	}
}
