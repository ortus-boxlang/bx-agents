class {

	/**
	 * @return The web gateway of this shape: the web app at /support with its own title, icon and accent, and no accounts
	 */
	function configure() {
		return {
			exposes  : "webui",
			path     : "/support",
			title    : "Support",
			subtitle : "Open, no accounts",
			icon     : "phosphor:lightning",
			theme    : { accent : "0f766e" },
			welcome  : "Ask the support agent."
		};
	}

}
