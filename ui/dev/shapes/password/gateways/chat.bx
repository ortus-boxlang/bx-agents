class {

	/**
	 * @return The web gateway of this shape: the web app at /chat with no accounts, behind the API password in SHAPE_API_KEY
	 */
	function configure() {
		return {
			exposes      : "webui",
			path         : "/chat",
			title        : "Password",
			apiKeyEnvVar : "SHAPE_API_KEY"
		};
	}

}
