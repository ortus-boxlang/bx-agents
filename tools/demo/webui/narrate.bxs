/**
 * Speaks every scene of scenes.json with bx-audio (Piper, offline once the voice is installed) and writes
 *   <out>/<id>.wav   the line, leveled for a voice-over
 *   <out>/<id>.json  { id, seconds, cues : [ { start, end, text } ] }
 * so the capture can hold each scene for as long as its line takes.
 *
 *   boxlang narrate.bxs --out=out --voice=joe
 */
opts = server.cli.parsed.options
outDir = opts.out ?: "out"
voice = opts.voice ?: "joe"
directoryCreate( outDir, true, true )
scenes = jsonDeserialize( fileRead( getDirectoryFromPath( getCurrentTemplatePath() ) & "scenes.json" ) )

function leveled( c ) {
	var info = audioInfo( c, true )
	var gainDb = -17 - 20 * log10( max( info.rms, 0.0001 ) )
	var peakDb = 20 * log10( max( info.peak, 0.0001 ) )
	return audioGain( c, min( gainDb, -1 - peakDb ) )
}

for ( scene in scenes ) {
	spoken = audioSpeakCues( text = scene.text, voice = voice, speed = 0.97, pauses = { sentence : 0.45, clause : 0.18, paragraph : 0.8 } )
	clip = audioChannels( audioResample( leveled( audioReverb( audio = audioCompress( audioFilter( spoken.audio, "highpass", 80, 0.7071 ), -22, 3, 12, 120 ), room = 0.15, damp = 0.6, mix = 0.05 ) ), 44100 ), 2 )
	audioSave( clip, outDir & "/" & scene.id & ".wav", 24 )
	fileWrite( outDir & "/" & scene.id & ".json", jsonSerialize( { id : scene.id, seconds : clip.getDurationSeconds(), cues : spoken.cues } ) )
	println( scene.id & ": " & numberFormat( clip.getDurationSeconds(), "0.0" ) & " s" )
}
