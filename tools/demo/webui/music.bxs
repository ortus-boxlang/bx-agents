/**
 * The walkthrough's music, in the style of the bx-audio trailer cue (saw pads, a kick, a riser, a boom) but faster and fuller:
 * 124 BPM, Am F C G, a bass in eighths, offbeat hats, claps on 2 and 4 and a plucked arpeggio, with a riser into the last bar.
 *
 *   boxlang music.bxs --out=out/music.wav --bars=50
 */
settings = { out : "out/music.wav", bars : 50, bpm : 124 }
settings.append( server.cli.parsed.options )
sr = 44100
bpm = settings.bpm * 1.0
beat = 60 / bpm
bar = beat * 4
step = beat / 2
bars = int( settings.bars )

chords = [
	{ bass : 33, notes : [ 57, 60, 64, 69 ] },
	{ bass : 29, notes : [ 53, 57, 60, 65 ] },
	{ bass : 36, notes : [ 55, 60, 64, 67 ] },
	{ bass : 31, notes : [ 55, 59, 62, 67 ] }
]

function padFor( chord ) {
	var saws = []
	for ( var note in chord.notes ) {
		saws.append( audioOsc( shape = "saw", freq = audioFreq( note - 0.15 ), seconds = bar + 1.0, sampleRate = sr, harmonics = 12 ) )
		saws.append( audioOsc( shape = "saw", freq = audioFreq( note + 0.15 ), seconds = bar + 1.0, sampleRate = sr, harmonics = 12 ) )
	}
	return audioGain( audioFilter( audioEnvelope( audioMix( saws ), 0.4, 3 ), "lowpass", 2400, 0.8 ), -12 )
}

bassCache = {}
function bassNote( note ) {
	if ( !bassCache.keyExists( note ) ) {
		var tone = audioFilter( audioOsc( "saw", audioFreq( note ), 0.3, sr, 24 ), "lowpass", 600, 2 )
		var weight = audioGain( audioOsc( "sine", audioFreq( note - 12 ), 0.3 ), -3 )
		bassCache[ note ] = audioEnvelope( audioMix( [ tone, weight ] ), 0.004, 0.14 )
	}
	return bassCache[ note ]
}

pluckCache = {}
function pluck( note ) {
	if ( !pluckCache.keyExists( note ) ) {
		pluckCache[ note ] = audioEnvelope( audioFilter( audioOsc( "saw", audioFreq( note ), 0.35, sr, 14 ), "lowpass", 3200, 1.2 ), 0.002, 0.16 )
	}
	return pluckCache[ note ]
}

kick = audioDrum( type = "kick", pitch = 1.0, decay = 0.8, level = 1.0 )
clap = audioDrum( type = "clap", seed = 11, decay = 0.8, level = 0.7 )
hat = audioDrum( type = "hat", seed = 13, level = 0.4 )
openHat = audioDrum( type = "openhat", seed = 12, decay = 0.4, level = 0.5 )
boom = audioDrum( type = "kick", pitch = 0.5, decay = 3, level = 1 )
riser = audioFade( audioFilter( audioNoise( seconds = bar * 2, sampleRate = sr, color = "white" ), "highpass", 1200, 0.9 ), bar * 1.8, 0.05, "smooth" )

t = audioTimeline( bpm = bpm, beatsPerBar = 4, sampleRate = sr, channels = 2 )
for ( b = 0; b < bars; b++ ) {
	chord = chords[ ( b mod 4 ) + 1 ]
	at = b * bar
	last = b >= bars - 1
	audioAdd( timeline = t, sound = padFor( chord ), at = at, track = "pads", gainDb = -2 )
	if ( b >= 2 && !last ) {
		for ( k = 0; k < 4; k++ ) {
			audioAdd( timeline = t, sound = kick, at = at + k * beat, track = "drums", gainDb = -5 )
		}
		for ( h = 0; h < 4; h++ ) {
			audioAdd( timeline = t, sound = hat, at = at + h * beat + step, track = "drums", gainDb = -11 )
		}
	}
	if ( b >= 4 && !last ) {
		audioAdd( timeline = t, sound = clap, at = at + beat, track = "drums", gainDb = -9 )
		audioAdd( timeline = t, sound = clap, at = at + 3 * beat, track = "drums", gainDb = -9 )
		audioAdd( timeline = t, sound = openHat, at = at + 3.5 * beat, track = "drums", gainDb = -13 )
		for ( s = 0; s < 8; s++ ) {
			audioAdd( timeline = t, sound = bassNote( chord.bass ), at = at + s * step, track = "bass", gainDb = -7 )
		}
		arp = [ 0, 1, 2, 3, 2, 1, 2, 3 ]
		for ( s = 0; s < 8; s++ ) {
			audioAdd( timeline = t, sound = pluck( chord.notes[ arp[ s + 1 ] + 1 ] + 12 ), at = at + s * step, track = "lead", gainDb = -14, pan = ( s mod 2 == 0 ? -0.3 : 0.3 ) )
		}
	}
}
audioAdd( timeline = t, sound = riser, at = ( bars - 2 ) * bar, track = "fx", gainDb = -20 )
audioAdd( timeline = t, sound = boom, at = ( bars - 1 ) * bar, track = "drums", gainDb = -2 )
audioSave( audioRender( timeline = t, tail = 1.5 ), settings.out )
println( "wrote " & settings.out )
