/**
 * Checks the course (docs/course/) and replays its commands against the scripted model.
 *
 *   boxlang tools/course/check-course.bxs [--static] [--lesson=<stem>] [--from=<stem>]
 *           [--emit-checkpoints] [--keep] [--work=<dir>] [--bxagents="<command>"] [--network] [--list]
 *
 *   (no flag)           the static checks, then the replay of every lesson in manifest order
 *   --static            the static checks only (no processes, a few seconds)
 *   --lesson=<stem>     replay one lesson, starting from the checkpoint of the lesson before it
 *   --from=<stem>       replay from that lesson to the end, the same way
 *   --emit-checkpoints  write tools/course/kit/checkpoints/ from what the lessons produce (review the diff, commit it)
 *   --keep              keep the temporary workspace (printed at the end)
 *   --bxagents          the command that runs bxAgents when the machine has no `bxAgents` on the PATH (default: boxlang module:bxagents)
 *   --network           also run the steps marked `course: network` (they need the internet)
 *   --list              print the lessons in the order of the manifest, with their file stems
 *
 * The replay needs ports 8080 (the scripted model) and 8791 (the web app) free, and a BoxLang whose
 * BOXLANG_HOME holds the built bxagents module. See tools/course/README.md.
 *
 * Exit code 0 when everything passed, 1 otherwise.
 */
repoRoot = reReplace( getDirectoryFromPath( getCurrentTemplatePath() ), "tools/course/?$", "" )
opts = server.cli.parsed.options
checker = new CourseChecker( repoRoot )

if ( opts.list ?: false ) {
	i = 0
	for ( s in checker.stems() ) {
		println( "#numberFormat( ++i, '00' )#  #s#" )
	}
	java.lang.System::exit( 0 )
}

problems = checker.staticChecks()
if ( problems.len() ) {
	println( "Static checks: #problems.len()# problem(s)" )
	problems.each( ( p ) => println( "  - " & p ) )
} else {
	println( "Static checks: ok (#checker.stems().len()# lessons)" )
}

failures = []

function runReplay( required any checker, required struct opts ) {
	try {
		var work = opts.work ?: ( getTempDirectory() & "/course-run" )
		var result = checker.replay( {
			work     : work,
			bxagents : opts.bxagents ?: "",
			from     : opts.from ?: "",
			only     : opts.lesson ?: "",
			emit     : opts[ "emit-checkpoints" ] ?: false,
			keep     : opts.keep ?: false,
			network  : opts.network ?: false,
			timeout  : opts.timeout ?: 300
		} )
		println( "Replay: #result.ran# step(s), #result.failures.len()# failure(s)" )
		result.failures.each( ( f ) => println( "  - " & f ) )
		if ( opts.keep ?: false ) {
			println( "Workspace kept in #work#" )
		}
		return result.failures
	} catch ( any e ) {
		println( "Replay stopped: " & e.message )
		return [ e.message ]
	}
}

if ( !( opts.static ?: false ) ) {
	failures = runReplay( checker, opts )
}

java.lang.System::exit( problems.len() || failures.len() ? 1 : 0 )
