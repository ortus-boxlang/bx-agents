# Tab completion for bxAgents, for PowerShell 5.1 and 7+.
# Generated by tools/generate-completions.bxs from the verb tables in ModuleConfig.bx, do not edit.
# Load it from your profile ($PROFILE):
#   . "<module folder>\completions\bxAgents.ps1"

Register-ArgumentCompleter -Native -CommandName 'bxAgents', 'bxagents' -ScriptBlock {
	param( $wordToComplete, $commandAst, $cursorPosition )

	$verbs = @{
@@VERBS@@
	}
	$options = @{
@@OPTIONS@@
	}
	$globals = @( '--help', '-h', '--version', '-v' )

	# the words typed before the one under the cursor (the command name is the first); an empty word is not in the AST
	$typed = @( $commandAst.CommandElements | ForEach-Object { $_.ToString() } )
	if ( $wordToComplete -ne '' ) {
		$typed = @( $typed | Select-Object -SkipLast 1 )
	}

	function New-BxAgentsResult( [string] $Text, [string] $Tip ) {
		if ( -not $Tip ) { $Tip = $Text }
		[System.Management.Automation.CompletionResult]::new( $Text, $Text, 'ParameterValue', $Tip )
	}

	function Get-BxAgentsDirectories( [string] $Prefix ) {
		foreach ( $item in @( Get-ChildItem -Directory -Path "$Prefix*" -ErrorAction SilentlyContinue ) ) {
			$path = ( Resolve-Path -LiteralPath $item.FullName -Relative ) + [System.IO.Path]::DirectorySeparatorChar
			if ( $path -match '\s' ) { $path = "'$path'" }
			$path
		}
	}

	# bxAgents <verb>
	if ( $typed.Count -le 1 ) {
		if ( $wordToComplete -like '-*' ) {
			foreach ( $g in $globals ) {
				if ( $g -like "$wordToComplete*" ) { New-BxAgentsResult $g }
			}
		} else {
			foreach ( $name in ( @( $verbs.Keys ) | Sort-Object ) ) {
				if ( $name -like "$wordToComplete*" ) { New-BxAgentsResult $name $verbs[ $name ] }
			}
		}
		return
	}

	$verb = $typed[ 1 ]
	$verbOptions = if ( $options.ContainsKey( $verb ) ) { @( $options[ $verb ] ) } else { @() }

	# --flag=<value>
	if ( $wordToComplete -match '^(--[^=]+)=(.*)$' ) {
		$flag = $Matches[ 1 ]
		$part = $Matches[ 2 ]
		$option = $verbOptions | Where-Object { "--$( $_.Name )" -eq $flag } | Select-Object -First 1
		if ( $option -and $option.Choices.Count ) {
			foreach ( $choice in $option.Choices ) {
				if ( $choice -like "$part*" ) { New-BxAgentsResult "$flag=$choice" $choice }
			}
		} elseif ( $option -and $option.Dir ) {
			foreach ( $path in @( Get-BxAgentsDirectories $part ) ) {
				New-BxAgentsResult "$flag=$path" $path
			}
		}
		return
	}

	# --flag
	if ( $wordToComplete -like '-*' ) {
		foreach ( $option in $verbOptions ) {
			$text = if ( $option.Value ) { "--$( $option.Name )=" } else { "--$( $option.Name )" }
			if ( $text -like "$wordToComplete*" ) { New-BxAgentsResult $text }
		}
		foreach ( $g in $globals ) {
			if ( $g -like "$wordToComplete*" ) { New-BxAgentsResult $g }
		}
		return
	}

	# the argument that follows the verb
	switch ( $options[ "${verb}:positional" ] ) {
		'dir' {
			foreach ( $path in @( Get-BxAgentsDirectories $wordToComplete ) ) {
				New-BxAgentsResult $path
			}
		}
		'verbs' {
			foreach ( $name in ( @( $verbs.Keys ) | Sort-Object ) ) {
				if ( $name -like "$wordToComplete*" ) { New-BxAgentsResult $name $verbs[ $name ] }
			}
		}
	}
}
