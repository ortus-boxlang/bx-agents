# Tab completion for bxAgents, for bash (and zsh, through bashcompinit).
# Generated by tools/generate-completions.bxs from the verb tables in ModuleConfig.bx, do not edit.
# install-bx-module installs it from the "completions" setting in box.json. Without the installer, load it with:
#   source <module folder>/completions/bxAgents.bash

_bxagents_complete() {
	local line="${COMP_LINE:0:COMP_POINT}"
	local -a words
	read -ra words <<< "$line"
	if [[ "$line" =~ [[:space:]]$ ]]; then
		words+=("")
	fi
	local count=${#words[@]}
	local cur="${words[count-1]}"
	local verbs="@@VERBS@@"
	local globals="--help -h --version -v"
	COMPREPLY=()

	# bxAgents <verb>
	if (( count <= 2 )); then
		if [[ "$cur" == -* ]]; then
			COMPREPLY=($(compgen -W "$globals" -- "$cur"))
		else
			COMPREPLY=($(compgen -W "$verbs" -- "$cur"))
		fi
		return 0
	fi

	local verb="${words[1]}"

	# --flag=<value>: bash replaces only what follows the "="
	if [[ "$cur" == --*=* ]]; then
		local flag="${cur%%=*}" part="${cur#*=}"
		case "$verb $flag" in
@@VALUE_CASES@@
		esac
		return 0
	fi

	if [[ "$cur" == -* ]]; then
		local flags=""
		case "$verb" in
@@FLAG_CASES@@
		esac
		COMPREPLY=($(compgen -W "$flags $globals" -- "$cur"))
		if (( ${#COMPREPLY[@]} == 1 )) && [[ "${COMPREPLY[0]}" == *= ]]; then
			compopt -o nospace 2>/dev/null
		fi
		return 0
	fi

	case "$verb" in
@@POSITIONAL_CASES@@
	esac
	return 0
}

complete -F _bxagents_complete bxAgents bxagents
