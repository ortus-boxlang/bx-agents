class {

	function configure() {
		return {
			type              : "email",
			imapHostEnvVar    : "IMAP_HOST",       // e.g. "imap.gmail.com"
			imapUsernameEnvVar: "IMAP_USERNAME",
			imapPasswordEnvVar: "IMAP_PASSWORD",   // an app password, not your real account password, for most providers
			fromAddressEnvVar : "EMAIL_FROM_ADDRESS"
			// imapPort: 993, pollIntervalSeconds: 60   // optional overrides - these are the defaults
		};
	}

}
