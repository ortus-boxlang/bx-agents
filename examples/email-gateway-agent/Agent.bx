class extends="bxModules.bxai.models.runnables.AiAgent" {

	function init() {
		super.init(
			name        : "email-gateway-agent",
			description : "An agent reachable over email via gateways/, polling IMAP and replying over SMTP.",
			model       : aiModel( provider: "mock", params: { model: "mock-model" } )
		)
		return this
	}

}
