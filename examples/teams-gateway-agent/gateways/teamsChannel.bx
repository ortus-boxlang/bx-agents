class {

	function configure() {
		return {
			type              : "teams",
			appIdEnvVar       : "TEAMS_APP_ID",       // the bot's Application (client) ID, from the Azure/Bot Framework portal
			appPasswordEnvVar : "TEAMS_APP_PASSWORD"  // a client secret for that same app registration
			// tenantId: "botframework.com"   // optional override - defaults to "botframework.com" (multi-tenant)
		};
	}

}
