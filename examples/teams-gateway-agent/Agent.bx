class extends="bxModules.bxai.models.runnables.AiAgent" {

	function init() {
		super.init(
			name        : "teams-gateway-agent",
			description : "An agent reachable over Microsoft Teams via gateways/, using the Bot Framework.",
			model       : aiModel( provider: "mock", params: { model: "mock-model" } )
		)
		return this
	}

}
