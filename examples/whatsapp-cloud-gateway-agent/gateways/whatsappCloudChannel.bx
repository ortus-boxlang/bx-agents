class {

	function configure() {
		return {
			type               : "whatsapp-cloud",
			accessTokenEnvVar  : "WHATSAPP_ACCESS_TOKEN",     // permanent or long-lived System User token, Cloud API scope
			phoneNumberIdEnvVar: "WHATSAPP_PHONE_NUMBER_ID",  // from the Meta App Dashboard's WhatsApp > API Setup page
			appSecretEnvVar    : "WHATSAPP_APP_SECRET",       // verifies X-Hub-Signature-256 on inbound webhooks
			verifyTokenEnvVar  : "WHATSAPP_VERIFY_TOKEN"      // a string YOU choose - Meta echoes it back during the GET verify handshake
			// apiVersion: "v21.0"   // optional override - defaults to "v21.0"
		};
	}

}
