/**
 * A CLASS-BASED Agent.bx: it extends bx-ai's AiAgent, so it IS the agent.
 *
 * The build instantiates this class rather than rebuilding an agent from a
 * config struct - so anything you set here is what actually runs. There is no
 * configure() at all, and no instructions.md next to this file: both are
 * optional for a class-based agent.
 *
 * Contrast examples/minimal-agent/Agent.bx, which is a DESCRIPTOR: a plain
 * class whose configure() returns config the build renders an aiAgent() call
 * from. Both shapes are supported, and they can be mixed in one project - a
 * class-based root can have descriptor subagents and vice versa.
 */
class extends="bxModules.bxai.models.runnables.AiAgent" {

	function init() {
		super.init(
			name        : "class-based-agent",
			description : "An agent that configures itself in code rather than in a config struct.",
			instructions: "You are a friendly assistant. When someone tells you their name, use the `sayHello` tool to greet them.",
			model       : aiModel( provider: "mock", params: { model: "mock-model" } )
		)
		return this
	}

}
