class extends="bxModules.bxai.models.runnables.AiAgent" {

	function init() {
		super.init(
			name        : "twilio-gateway-agent",
			description : "An agent reachable over SMS via gateways/, using Twilio's Messages API webhook.",
			model       : aiModel( provider: "mock", params: { model: "mock-model" } )
		)
		return this
	}

}
