class extends="bxModules.bxai.models.runnables.AiAgent" {

	function init() {
		super.init(
			name        : "discord-gateway-agent",
			description : "An agent reachable as a real Discord bot via gateways/, over the Gateway API.",
			model       : aiModel( provider: "mock", params: { model: "mock-model" } )
		)
		return this
	}

}
