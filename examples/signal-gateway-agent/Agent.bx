class extends="bxModules.bxai.models.runnables.AiAgent" {

	function init() {
		super.init(
			name        : "signal-gateway-agent",
			description : "An agent reachable over Signal via gateways/, against a local signal-cli daemon.",
			model       : aiModel( provider: "mock", params: { model: "mock-model" } )
		)
		return this
	}

}
