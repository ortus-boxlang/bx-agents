class {

	function configure() {
		return {
			type         : "signal",
			accountEnvVar: "SIGNAL_ACCOUNT",       // the signal-cli-registered phone number this gateway sends/receives as, E.164
			httpUrl      : "http://127.0.0.1:8081" // where the signal-cli daemon listens - overridden here since this app's own server uses 8080 by default, see README.md
		};
	}

}
