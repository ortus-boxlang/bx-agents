class extends="bxModules.bxai.models.runnables.AiAgent" {

	function init() {
		super.init(
			name        : "http-gateway-agent",
			description : "An agent exposed over HTTP via gateways/ + toAi().",
			model       : aiModel( provider: "mock", params: { model: "mock-model" } )
		)
		return this
	}

}
