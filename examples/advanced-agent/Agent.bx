class extends="bxModules.bxai.models.runnables.AiAgent" {

	function init() {
		super.init(
			name        : "advanced-agent",
			description : "A research team lead with tools, skills, MCP hosting, and a nightly digest schedule.",
			model       : aiModel( provider: "mock", params: { model: "mock-model" } )
		)
		return this
	}

	// Declared here so it wins over the placeholder model set in init() above: the agent uses
	// the `fast` profile, a named provider + model + params that bx-ai resolves (see profiles
	// in docs/conventions/profiles.md). subAgents is the `subagents/` FOLDER-name list to
	// wire at build time, distinct from super.init()'s own `subAgents` argument
	// (already-built instances).
	function configure() {
		return {
			profiles  : {
				fast : { description : "A small, quick model for routine work", provider : "mock", model : "mock-model" }
			},
			profile   : "fast",
			subAgents : [ "researcher", "writer" ]
		};
	}

}
