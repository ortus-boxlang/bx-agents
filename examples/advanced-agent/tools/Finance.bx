class {

	@AITool( "Get the latest stock quote for a ticker symbol." )
	function getStockQuote( ticker ) {
		return "#arguments.ticker#: $123.45 (+1.2%)";
	}

	@AITool( "Convert an amount from one currency to another." )
	function convertCurrency( amount, fromCurrency, toCurrency ) {
		return "#arguments.amount# #arguments.fromCurrency# = #arguments.amount * 1.08# #arguments.toCurrency#";
	}

}
