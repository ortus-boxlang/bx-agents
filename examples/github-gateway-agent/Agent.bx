class extends="bxModules.bxai.models.runnables.AiAgent" {

	function init() {
		super.init(
			name        : "github-gateway-agent",
			description : "An agent reachable via @mentions on GitHub issues/PRs, using a webhook.",
			model       : aiModel( provider: "mock", params: { model: "mock-model" } )
		)
		return this
	}

}
