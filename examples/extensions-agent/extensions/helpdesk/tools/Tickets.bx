/**
 * Tools an extension carries. The app reads this folder where it is (`extensions/helpdesk/tools/`) and gives the
 * tools to the agent, as if they were in the project's own `tools/`. A tool of the project's with the same name wins.
 * `extensions.disable: [ "helpdesk:Tickets" ]` leaves this file out.
 */
class {

	@AITool( "Look up the status of a support ticket by its id, such as TCK-1." )
	function ticketStatus( ticketId ) {
		return "#uCase( arguments.ticketId )#: open, waiting for the customer";
	}

}
