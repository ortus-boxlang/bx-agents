/**
 * /standup: shows the standup questions. A command in commands/ is a class like the built-in ones;
 * it extends BaseCommand and says what it is. `settings` and `log` are injected into it.
 */
class extends="models.chat.commands.BaseCommand@bxagents" {

	string function name() {
		return "standup"
	}

	string function hint() {
		return "show today's standup questions"
	}

	any function run( required any context, required string args ) {
		return arguments.context.reply().keyValues( [
			[ "Channel", settings.channel ],
			[ "Time", settings.at ],
			[ "Questions", settings.prompt ]
		] )
	}

}
