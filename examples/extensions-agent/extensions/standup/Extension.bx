/**
 * A folder extension: an Extension.bx that reads like a ModuleConfig, plus the convention folders
 * an agent project has. This one brings a command (commands/) and a scheduler (schedulers/).
 * The scheduler runs when the agent is served; the command works wherever the chat does.
 */
class {

	this.title = "Standup";
	this.author = "Ortus Solutions, Corp";
	this.version = "1.0.0";
	this.description = "A daily standup reminder and a /standup command";

	function configure() {
		variables.settings = {
			channel : "standup",
			at      : "09:00",
			prompt  : "What did you do yesterday, what will you do today, and is anything blocking you?"
		}
	}

}
