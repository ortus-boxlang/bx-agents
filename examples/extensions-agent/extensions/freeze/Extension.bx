/**
 * Stops commands from running, for a while. It shows the other way to listen: `interceptors` in configure(),
 * as a module config has, names classes in the extension's folder (interceptors/), each with its own
 * properties. The class listens with methods named after the events.
 */
class {

	this.title = "Freeze";
	this.description = "Stops the commands listed in its settings";

	function configure() {
		// commands to stop; none until someone lists them under extensions: freeze: frozen:
		variables.settings = { frozen : [], reason : "That command is frozen for now." }

		variables.interceptors = [
			{ class : "interceptors.Freezer", properties : { announce : true } }
		]
	}

}
