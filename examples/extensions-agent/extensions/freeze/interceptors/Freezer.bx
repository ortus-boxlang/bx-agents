/**
 * Listens before every command. `settings` and `log` are injected like in any class of an extension, and
 * `properties` is what the interceptors entry in configure() gave it.
 */
class {

	function onChatCommandBefore( data ) {
		if ( settings.frozen.containsNoCase( data.name ) ) {
			if ( properties.announce ) {
				log.info( "stopped /#data.name#" )
			}
			data.cancel( settings.reason )
		}
	}

}
